#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если ЭтоНовый() Тогда
		// Автора назначает сервер независимо от значения, переданного формой или внешним кодом.
		Автор = Пользователи.ТекущийПользователь();
	ИначеЕсли Автор <> ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Автор") Тогда
		ВызватьИсключение НСтр("ru = 'Автора версии политик изменять нельзя.'");
	КонецЕсли;
	// Действующую и архивную версии не правят: откат - новый черновик (план, 4.12).
	Если Не ЭтоНовый() И Не ДополнительныеСвойства.Свойство("ИИА_Активация")
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Статус") <> "Черновик" Тогда
		ВызватьИсключение НСтр("ru = 'Действующую и архивную версии политик изменять нельзя. Создайте новый черновик.'");
	КонецЕсли;
	Если ЭтоНовый() И Не ЗначениеЗаполнено(Статус) Тогда
		Статус = "Черновик";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
