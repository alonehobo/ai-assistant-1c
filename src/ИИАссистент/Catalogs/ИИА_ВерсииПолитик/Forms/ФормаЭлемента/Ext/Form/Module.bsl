#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.Ссылка.Пустая() Тогда
		Объект.Статус = "Черновик";
		Объект.Автор = Пользователи.ТекущийПользователь();
		Объект.Создана = ТекущаяДатаСеанса();
		Объект.Наименование = СтрШаблон(НСтр("ru = 'Политики от %1'"), Формат(ТекущаяДатаСеанса(), "ДЛФ=DT"));
		Объект.Снимок = ИИА_Политики.СнимокТекущихПолитик();
	КонецЕсли;
	НастроитьДоступность();

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	НастроитьДоступность();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СнятьСнимок(Команда)

	СнятьСнимокНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура Сравнить(Команда)

	СравнитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СухойПрогон(Команда)

	РезультатПрогона = СухойПрогонНаСервере(Объект.Снимок);

КонецПроцедуры

&НаКлиенте
Процедура Активировать(Команда)

	Если Модифицированность Или Объект.Ссылка.Пустая() Тогда
		Записать();
	КонецЕсли;
	АктивироватьНаСервере();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Версия политик активирована'"));

КонецПроцедуры

&НаКлиенте
Процедура СоздатьЧерновик(Команда)

	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	ПоказатьЗначение(, СоздатьЧерновикНаСервере(Объект.Ссылка));

КонецПроцедуры

&НаКлиенте
Процедура ЭкспортСнимка(Команда)

	Текст = Новый ТекстовыйДокумент;
	Текст.УстановитьТекст(ЭкспортНаСервере(Объект.Ссылка, Объект.Снимок));
	Текст.Показать(СтрШаблон(НСтр("ru = 'Снимок политик «%1» (JSON)'"), Объект.Наименование));

КонецПроцедуры

&НаКлиенте
Процедура ИмпортСнимка(Команда)

	ПоказатьВводСтроки(Новый ОписаниеОповещения("ИмпортЗавершение", ЭтотОбъект), "",
		НСтр("ru = 'Вставьте снимок политик (JSON)'"), 0, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ИмпортЗавершение(Текст, ДополнительныеПараметры) Экспорт

	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;
	ПоказатьЗначение(, ИмпортНаСервере(Текст));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ЭкспортНаСервере(Ссылка, Снимок)

	ИИА_Политики.ЗаписатьЖурналНастройки("Экспорт", Строка(Ссылка));
	Возврат Снимок;

КонецФункции

&НаСервереБезКонтекста
Функция ИмпортНаСервере(Текст)

	Возврат ИИА_Политики.ИмпортироватьЧерновик(Текст);

КонецФункции

&НаСервере
Процедура НастроитьДоступность()

	ЭтоЧерновик = Объект.Статус = "Черновик" Или Объект.Ссылка.Пустая();
	ТолькоПросмотр = Не ЭтоЧерновик;
	Элементы.СнятьСнимок.Доступность = ЭтоЧерновик;
	Элементы.Сравнить.Доступность = ЭтоЧерновик;
	Элементы.Активировать.Доступность = ЭтоЧерновик;

КонецПроцедуры

&НаСервере
Процедура СнятьСнимокНаСервере()

	Объект.Снимок = ИИА_Политики.СнимокТекущихПолитик();
	СравнитьНаСервере();
	Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Процедура СравнитьНаСервере()

	Объект.Изменения.Очистить();
	Для Каждого Изменение Из ИИА_Политики.ИзмененияОтносительноДействующей(Объект.Снимок) Цикл
		Строка = Объект.Изменения.Добавить();
		Строка.Вид = Изменение.Вид;
		Строка.Описание = Изменение.Описание;
	КонецЦикла;
	Если Объект.Изменения.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Отличий от действующей версии нет.'"));
	КонецЕсли;
	Модифицированность = Истина;

КонецПроцедуры

&НаСервереБезКонтекста
Функция СухойПрогонНаСервере(Снимок)

	Возврат ИИА_Политики.СухойПрогон(Снимок, 7);

КонецФункции

&НаСервере
Процедура АктивироватьНаСервере()

	ИИА_Политики.Активировать(Объект.Ссылка);
	ЗначениеВРеквизитФормы(Объект.Ссылка.ПолучитьОбъект(), "Объект");
	НастроитьДоступность();

КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьЧерновикНаСервере(Основание)

	Возврат ИИА_Политики.СоздатьЧерновик(Основание);

КонецФункции

#КонецОбласти
