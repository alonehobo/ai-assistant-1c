#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Диалог пишет сам ассистент; администратор переписку только просматривает.
	ТолькоПросмотр = Истина;
	КонтекстТекст = ПредставлениеКонтекста(Объект.Контекст);
	Элементы.Контекст.Видимость = Не ПустаяСтрока(Объект.Контекст);
	Элементы.ФормаЖурналДиалога.Видимость = ПравоДоступа("Просмотр", Метаданные.РегистрыСведений.ИИА_ЖурналВызовов);
	ПросмотрДиалога = ИИА_Обслуживание.HTMLДиалога(Объект.Ссылка);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура КонтекстНажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если Не ПустаяСтрока(Объект.Контекст) Тогда
		ПерейтиПоНавигационнойСсылке(Объект.Контекст);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЖурналДиалога(Команда)

	ОткрытьФорму("РегистрСведений.ИИА_ЖурналВызовов.ФормаСписка",
		Новый Структура("Отбор", Новый Структура("Диалог", Объект.Ссылка)), ЭтотОбъект, Объект.Ссылка);

КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)

	ОбновитьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьНаСервере()

	Прочитать();
	ПросмотрДиалога = ИИА_Обслуживание.HTMLДиалога(Объект.Ссылка);

КонецПроцедуры

// Вид объекта, из которого открыт чат, по навигационной ссылке (e1cib/data/<Объект>?ref=...).
&НаСервереБезКонтекста
Функция ПредставлениеКонтекста(Ссылка)

	Если ПустаяСтрока(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	ПолноеИмя = СтрЗаменить(Ссылка, "e1cib/data/", "");
	Позиция = СтрНайти(ПолноеИмя, "?");
	Если Позиция > 0 Тогда
		ПолноеИмя = Лев(ПолноеИмя, Позиция - 1);
	КонецЕсли;
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат НСтр("ru = 'Открыть объект'");
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = '%1 (открыть)'"), ОбъектМетаданных.Представление());

КонецФункции

#КонецОбласти
