#Если Сервер Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	// Протокол следует из провайдера; вручную его выбирают только для провайдера «Другой».
	Если ЗначениеЗаполнено(Провайдер) И Провайдер <> Перечисления.ИИА_ПровайдерыМоделей.Другой Тогда
		Протокол = ИИА_LLM.НастройкиПровайдера(Провайдер).Протокол;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Попытка
		ИИА_LLM.ПараметрыЗапросаИзСтроки(ПараметрыЗапроса);
	Исключение
		ОбщегоНазначения.СообщитьПользователю(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
			ЭтотОбъект, "ПараметрыЗапроса", , Отказ);
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
