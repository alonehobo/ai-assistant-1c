// Подключение к языковой модели. Ключ API не хранится в реквизитах: после записи элемента он уходит
// в безопасное хранилище БСП (владелец - ссылка подключения), в форму возвращается только признак.
// Поля режима рассуждений, лимитов и маршрутизации переводятся в тело запроса по провайдеру, см. ИИА_LLM.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Параметры.Ключ) Тогда
		Объект.Используется = Истина;
		Объект.ТаймаутСекунд = 180;
		Объект.Порядок = 1;
		СостояниеКлюча = НСтр("ru = 'не задан'");
	КонецЕсли;
	НастроитьЭлементыПоПровайдеру();

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	ОбновитьСостояниеКлюча(ТекущийОбъект.Ссылка);

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	Если ЗначениеЗаполнено(КлючAPI) Тогда
		ИИА_ЧатВызовСервера.СохранитьКлючПодключения(ТекущийОбъект.Ссылка, КлючAPI);
		КлючAPI = "";
	КонецЕсли;
	ОбновитьСостояниеКлюча(ТекущийОбъект.Ссылка);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Асинх Процедура ПровайдерПриИзменении(Элемент)

	ПровайдерПриИзмененииНаСервере();
	Если ЭтоACP() Тогда
		Ждать ЗапуститьМостАсинх();
	КонецЕсли;

КонецПроцедуры

// Для ACP список - агенты, установленные на этом компьютере (их отдаёт мост).
&НаКлиенте
Асинх Процедура МодельНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Список = Новый СписокЗначений;
	Если ЭтоACP() Тогда
		Мост = Ждать ЗапуститьМостАсинх();
		Если Мост = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Для Каждого Агент Из Мост.Агенты Цикл
			Список.Добавить(Агент.Значение, Агент.Представление, Агент.Значение = Объект.Модель);
		КонецЦикла;
	Иначе
		Результат = МоделиПровайдера(Объект.Ссылка, Объект.Протокол, Объект.АдресAPI, КлючAPI,
			Объект.ОбластьДоступа, Объект.Прокси);
		Если Не ПустаяСтрока(Результат.Ошибка) Тогда
			ПоказатьПредупреждение(, Результат.Ошибка);
			Возврат;
		КонецЕсли;
		Для Каждого Модель Из Результат.Модели Цикл
			Список.Добавить(Модель, , Модель = Объект.Модель);
		КонецЦикла;
	КонецЕсли;
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("МодельВыборЗавершение", ЭтотОбъект), Список, Элемент,
		Список.НайтиПоЗначению(Объект.Модель));

КонецПроцедуры

&НаКлиенте
Процедура РассужденияПриИзменении(Элемент)

	НастроитьДоступностьПолей(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ЗадатьТемпературуПриИзменении(Элемент)

	Если Объект.ЗадатьТемпературу И Объект.Температура = 0 Тогда
		Объект.Температура = 0.1;
	КонецЕсли;
	НастроитьДоступностьПолей(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура ПроверитьПодключение(Команда)

	Если ЭтоACP() Тогда
		Мост = Ждать ЗапуститьМостАсинх();
		Если Мост = Неопределено Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Если Модифицированность Или Объект.Ссылка.Пустая() Тогда
		Если Не Записать() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	ПоказатьПредупреждение(, ПроверитьПодключениеНаСервере(Объект.Ссылка));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура МодельВыборЗавершение(Выбранный, ДополнительныеПараметры) Экспорт

	Если Выбранный <> Неопределено И Объект.Модель <> Выбранный.Значение Тогда
		Объект.Модель = Выбранный.Значение;
		Если ПустаяСтрока(Объект.Наименование) Тогда
			Объект.Наименование = Выбранный.Значение;
		КонецЕсли;
		Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ЭтоACP()

	Возврат Объект.Протокол = ПредопределенноеЗначение("Перечисление.ИИА_ПротоколыAPI.ACP");

КонецФункции

// Запускает мост на этом компьютере и подставляет его токен в ключ: вводить ключ вручную не нужно.
//
// Возвращаемое значение:
//  Обещание - Структура, см. ИИА_МостACPКлиент.ЗапуститьМостАсинх; Неопределено - ошибка показана.
//
&НаКлиенте
Асинх Функция ЗапуститьМостАсинх()

	ПоказатьОповещениеПользователя(НСтр("ru = 'Запуск агентов на этом компьютере'"));
	Мост = Ждать ИИА_МостACPКлиент.ЗапуститьМостАсинх(Объект.АдресAPI);
	Если Не ПустаяСтрока(Мост.Токен) И КлючAPI <> Мост.Токен Тогда
		КлючAPI = Мост.Токен;
		Модифицированность = Истина;
		СостояниеКлюча = НСтр("ru = 'ключ моста подставлен, сохранится при записи'");
	КонецЕсли;
	Если Не ПустаяСтрока(Мост.Ошибка) Тогда
		ПоказатьПредупреждение(, Мост.Ошибка);
		Возврат Неопределено;
	КонецЕсли;
	Возврат Мост;

КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьПодключениеНаСервере(Знач Подключение)

	Возврат ИИА_ЧатВызовСервера.ПроверитьПодключение(Подключение);

КонецФункции

&НаСервереБезКонтекста
Функция МоделиПровайдера(Знач Подключение, Знач Протокол, Знач Адрес, Знач Ключ, Знач ОбластьДоступа, Знач РежимПрокси)

	Возврат ИИА_ЧатВызовСервера.МоделиПровайдера(Подключение, Протокол, Адрес, Ключ, ОбластьДоступа, РежимПрокси);

КонецФункции

// Новый провайдер подставляет свой адрес, если прежний адрес пуст или был адресом другого провайдера,
// и значения полей, которые этот провайдер ожидает.
&НаСервере
Процедура ПровайдерПриИзмененииНаСервере()

	Настройки = ИИА_LLM.НастройкиПровайдера(Объект.Провайдер);
	Если ПустаяСтрока(Объект.АдресAPI) Или ИИА_LLM.ЭтоАдресПровайдераПоУмолчанию(Объект.АдресAPI) Тогда
		Объект.АдресAPI = Настройки.Адрес;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.Провайдер) Тогда
		Объект.Протокол = Настройки.Протокол;
	КонецЕсли;
	Объект.ЗадатьТемпературу = Настройки.Температура;
	Если Объект.ЗадатьТемпературу И Объект.Температура = 0 Тогда
		Объект.Температура = 0.1;
	КонецЕсли;
	Если Объект.Провайдер = Перечисления.ИИА_ПровайдерыМоделей.GigaChat И ПустаяСтрока(Объект.ОбластьДоступа) Тогда
		Объект.ОбластьДоступа = "GIGACHAT_API_PERS";
	КонецЕсли;
	НастроитьЭлементыПоПровайдеру();

КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыПоПровайдеру()

	Настройки = ИИА_LLM.НастройкиПровайдера(Объект.Провайдер);
	ЭтоACP = Объект.Протокол = Перечисления.ИИА_ПротоколыAPI.ACP;
	// Протокол выбирают вручную для провайдера, которого нет в списке, и для OpenAI (Responses или chat/completions).
	Элементы.Протокол.Видимость = Не ЗначениеЗаполнено(Объект.Провайдер)
		Или Объект.Провайдер = Перечисления.ИИА_ПровайдерыМоделей.Другой
		Или Объект.Провайдер = Перечисления.ИИА_ПровайдерыМоделей.OpenAI;
	Элементы.ГруппаРассуждения.Видимость = Не ЭтоACP;
	Элементы.ГруппаАгрегатор.Видимость = Настройки.Агрегатор;
	Элементы.ГруппаДополнительно.Видимость = Не ЭтоACP;
	Элементы.Модель.ПодсказкаВвода = Настройки.ПримерМодели;
	Элементы.КлючAPI.ПодсказкаВвода = Настройки.ПодсказкаКлюча;
	Элементы.ОбластьДоступа.Видимость = Объект.Протокол = Перечисления.ИИА_ПротоколыAPI.GigaChat;
	Элементы.Рассуждения.Видимость = Настройки.Рассуждения;
	Элементы.Рассуждения.Подсказка = Настройки.ПодсказкаРассуждений;
	Элементы.Рассуждения.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСнизу;
	Элементы.БюджетРассуждений.Видимость = Настройки.Бюджет;
	НастроитьДоступностьПолей(ЭтотОбъект);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьДоступностьПолей(Форма)

	Объект = Форма.Объект;
	Форма.Элементы.Температура.Доступность = Объект.ЗадатьТемпературу;
	Форма.Элементы.БюджетРассуждений.Доступность = Объект.Рассуждения
		<> ПредопределенноеЗначение("Перечисление.ИИА_РежимыРассуждений.Выключены");

КонецПроцедуры

&НаСервере
Процедура ОбновитьСостояниеКлюча(Подключение)

	Сохранен = ИИА_ЧатВызовСервера.КлючПодключенияЗаполнен(Подключение);
	ЭтоACP = Объект.Протокол = Перечисления.ИИА_ПротоколыAPI.ACP;
	Если Сохранен Тогда
		СостояниеКлюча = НСтр("ru = 'ключ сохранён'");
	ИначеЕсли ЭтоACP Тогда
		СостояниеКлюча = НСтр("ru = 'подставится при проверке подключения'");
	Иначе
		СостояниеКлюча = НСтр("ru = 'ключ не задан'");
	КонецЕсли;
	Элементы.СостояниеКлюча.ЦветТекста = ?(Сохранен Или ЭтоACP, ЦветаСтиля.ИИА_ЦветТекстаУспех,
		ЦветаСтиля.ИИА_ЦветТекстаПредупреждение);

КонецПроцедуры

#КонецОбласти
