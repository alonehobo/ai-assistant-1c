#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	ПроверитьСчета(Отказ);
	ПроверитьЗаписьДанных(Отказ);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьСчета(Отказ)

	// Счета: один счёт - одна строка; разрешённый счёт внутри базового запрета (69, 70, 71, 73) не открывается.
	СтрокиСчетов = Новый Соответствие;
	Разрешенные = Новый Массив;
	Для Каждого СтрокаСчета Из Счета Цикл
		Если Не ЗначениеЗаполнено(СтрокаСчета.Счет) Тогда
			Продолжить;
		КонецЕсли;
		Поле = СтрШаблон("Счета[%1].Счет", Формат(СтрокаСчета.НомерСтроки - 1, "ЧН=0; ЧГ="));
		Первая = СтрокиСчетов.Получить(СтрокаСчета.Счет);
		Если Первая = Неопределено Тогда
			СтрокиСчетов.Вставить(СтрокаСчета.Счет, СтрокаСчета);
		ИначеЕсли Первая.Разрешен = СтрокаСчета.Разрешен Тогда
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Счёт %1 указан повторно (строка %2).'"),
				СтрокаСчета.Счет, Первая.НомерСтроки), ЭтотОбъект, Поле, , Отказ);
		Иначе
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Счёт %1 одновременно разрешён и запрещён (строка %2).'"),
				СтрокаСчета.Счет, Первая.НомерСтроки), ЭтотОбъект, Поле, , Отказ);
		КонецЕсли;
		Если СтрокаСчета.Разрешен Тогда
			Разрешенные.Добавить(СтрокаСчета.Счет);
		КонецЕсли;
	КонецЦикла;
	Если Разрешенные.Количество() = 0 Или Не ИИА_БухгалтерскийДоступ.ПланСчетовДоступен() Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Счета.Ссылка КАК Счет
	|ИЗ
	|	ПланСчетов.Хозрасчетный КАК Счета
	|ГДЕ
	|	Счета.Ссылка В (&Разрешенные)
	|	И Счета.Ссылка В ИЕРАРХИИ (&Базовые)");
	Запрос.УстановитьПараметр("Разрешенные", Разрешенные);
	Запрос.УстановитьПараметр("Базовые", ИИА_БухгалтерскийДоступ.БазовыеЗапрещенныеСчета());
	Запрос.Текст = ИИА_БухгалтерскийДоступ.ТекстЗапросаПоПлану(Запрос.Текст);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Предупреждение, не ошибка: запись не блокируется, счёт ассистенту всё равно недоступен.
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон(
			НСтр("ru = 'Счёт %1 закрыт для ассистента всегда (расчёты с персоналом): разрешение не действует.'"),
			Выборка.Счет), ЭтотОбъект, "Счета");
	КонецЦикла;

КонецПроцедуры

// Разрешения «Запись данных»: вид - документ или справочник вне запрета периметра, без повторов, операции по виду,
// реквизиты существуют, не закрыты периметром и не маскируются (см. ИИА_Действия.ОшибкиРазрешенияЗаписи).
Процедура ПроверитьЗаписьДанных(Отказ)

	Виды = Новый Соответствие;
	Для Каждого СтрокаЗаписи Из ЗаписьДанных Цикл
		Поле = СтрШаблон("ЗаписьДанных[%1].ПолноеИмя", Формат(СтрокаЗаписи.НомерСтроки - 1, "ЧН=0; ЧГ="));
		Ключ = ВРег(СокрЛП(СтрокаЗаписи.ПолноеИмя));
		Если Виды.Получить(Ключ) <> Неопределено Тогда
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Вид %1 указан повторно (строка %2).'"),
				СтрокаЗаписи.ПолноеИмя, Виды.Получить(Ключ)), ЭтотОбъект, Поле, , Отказ);
			Продолжить;
		КонецЕсли;
		Виды.Вставить(Ключ, СтрокаЗаписи.НомерСтроки);
		Для Каждого Ошибка Из ИИА_Действия.ОшибкиРазрешенияЗаписи(СтрокаЗаписи.ПолноеИмя, СтрокаЗаписи.Проведение,
			СтрокаЗаписи.ОтменаПроведения, СтрокаЗаписи.Реквизиты) Цикл
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Запись данных, строка %1: %2'"),
				СтрокаЗаписи.НомерСтроки, Ошибка), ЭтотОбъект, Поле, , Отказ);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
