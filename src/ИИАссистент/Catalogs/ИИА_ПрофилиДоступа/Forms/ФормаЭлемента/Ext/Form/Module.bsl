// Профиль доступа ИИ-ассистента: дерево объектов (вид -> объект) и поля выбранного объекта.
// Состояние «доступно» хранится в реквизите Состояние: строка на каждый объект и строки на поля
// с явным правилом. При записи профиль получает явное правило на каждый объект, поэтому
// режим по умолчанию действует только на объекты, появившиеся позже (например, после обновления).

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Элементы.ИнструментыИмя.СписокВыбора.Очистить();
	Для Каждого Элемент Из ИИА_Инструменты.ИнструментыДляВыбора() Цикл
		Элементы.ИнструментыИмя.СписокВыбора.Добавить(Элемент.Значение, Элемент.Представление);
	КонецЦикла;
	Элементы.ИнструментыИмя.РежимВыбораИзСписка = Истина;
	Элементы.ИнструментыИмя.КнопкаВыпадающегоСписка = Истина;

	ТипСчета = ИИА_БухгалтерскийДоступ.ТипСчета();
	Если ТипСчета = Неопределено Тогда
		Элементы.СтраницаСчета.Видимость = Ложь;
	Иначе
		Элементы.СчетаСчет.ОграничениеТипа = ТипСчета;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Параметры.Ключ) Тогда
		Объект.ПоУмолчаниюРазрешено = Ложь;
		ИнициализироватьНастройку();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	ИнициализироватьНастройку();

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	ЗапрещенныеПериметром = ИИА_Периметр.ОписаниеПериметра().ЗапрещенныеОбъекты;
	ДоступностьОбъектов = Новый Соответствие;
	Для Каждого Строка Из Состояние Цикл
		Если ЭтоИмяОбъекта(Строка.ПолноеИмя) Тогда
			ДоступностьОбъектов.Вставить(Строка.ПолноеИмя, Строка.Доступно);
		КонецЕсли;
	КонецЦикла;

	ТекущийОбъект.Правила.Очистить();
	Для Каждого Строка Из Состояние Цикл
		Если ЭтоИмяОбъекта(Строка.ПолноеИмя) Тогда
			Если ЗапрещенныеПериметром.Получить(ВРег(Строка.ПолноеИмя)) <> Неопределено Тогда
				Продолжить; // закрыто кодом этапа, правило профиля не нужно
			КонецЕсли;
			Правило = ТекущийОбъект.Правила.Добавить();
			Правило.ПолноеИмя = Строка.ПолноеИмя;
			Правило.Разрешено = Строка.Доступно;
		Иначе
			// Поле: правило нужно, только если отличается от доступности объекта.
			ДоступенОбъект = ДоступностьОбъектов.Получить(ИмяОбъектаПоля(Строка.ПолноеИмя));
			Если ДоступенОбъект = Неопределено Или ДоступенОбъект <> Строка.Доступно Тогда
				Правило = ТекущийОбъект.Правила.Добавить();
				Правило.ПолноеИмя = Строка.ПолноеИмя;
				Правило.Разрешено = Строка.Доступно;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПоискПриИзменении(Элемент)

	ПостроитьДерево();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоОбъектов

&НаКлиенте
Процедура ДеревоОбъектовПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ОбновитьПоляТекущегоОбъекта", 0.2, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ДеревоОбъектовДоступноПриИзменении(Элемент)

	Строка = Элементы.ДеревоОбъектов.ТекущиеДанные;
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Строка.ЭтоГруппа Тогда
		Для Каждого Подчиненная Из Строка.ПолучитьЭлементы() Цикл
			Если Не Подчиненная.ВнеПериметра Тогда
				Подчиненная.Доступно = Строка.Доступно;
				УстановитьСостояние(Подчиненная.ПолноеИмя, Строка.Доступно);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли Строка.ВнеПериметра Тогда
		Строка.Доступно = Ложь;
		ПоказатьПредупреждение(, НСтр("ru = 'Объект вне периметра этапа: профиль не может его открыть.'"));
		Возврат;
	Иначе
		УстановитьСостояние(Строка.ПолноеИмя, Строка.Доступно);
		ОбновитьОтметкуГруппы(Строка.ПолучитьРодителя());
	КонецЕсли;
	ТекущийОбъект = "";
	ОбновитьПоляТекущегоОбъекта();
	Модифицированность = Истина;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПоляОбъекта

&НаКлиенте
Процедура ПоляОбъектаДоступноПриИзменении(Элемент)

	Строка = Элементы.ПоляОбъекта.ТекущиеДанные;
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Строка.ВнеПериметра Тогда
		Строка.Доступно = Ложь;
		ПоказатьПредупреждение(, НСтр("ru = 'Поле вне периметра этапа: профиль не может его открыть.'"));
		Возврат;
	КонецЕсли;
	УстановитьСостояние(Строка.ПолноеИмя, Строка.Доступно);
	Модифицированность = Истина;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура РазрешитьВсе(Команда)

	УстановитьВсеНаСервере(Истина);

КонецПроцедуры

&НаКлиенте
Процедура ЗапретитьВсе(Команда)

	УстановитьВсеНаСервере(Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ИнициализироватьНастройку()

	Правила = Новый Соответствие;
	Для Каждого Правило Из Объект.Правила Цикл
		Правила.Вставить(ВРег(Правило.ПолноеИмя), Правило.Разрешено);
	КонецЦикла;

	Состояние.Очистить();
	Для Каждого Вид Из ИИА_ПрофилиДоступа.ОбъектыДляНастройки() Цикл
		Для Каждого ОписаниеОбъекта Из Вид.Объекты Цикл
			Доступно = Правила.Получить(ВРег(ОписаниеОбъекта.ПолноеИмя));
			Если Доступно = Неопределено Тогда
				Доступно = Объект.ПоУмолчаниюРазрешено;
			КонецЕсли;
			Строка = Состояние.Добавить();
			Строка.ПолноеИмя = ОписаниеОбъекта.ПолноеИмя;
			Строка.Доступно = Доступно И Не ОписаниеОбъекта.ВнеПериметра;
		КонецЦикла;
	КонецЦикла;
	// Явные правила полей.
	Для Каждого Правило Из Объект.Правила Цикл
		Если Не ЭтоИмяОбъекта(Правило.ПолноеИмя) Тогда
			Строка = Состояние.Добавить();
			Строка.ПолноеИмя = Правило.ПолноеИмя;
			Строка.Доступно = Правило.Разрешено;
		КонецЕсли;
	КонецЦикла;

	ПостроитьДерево();

КонецПроцедуры

&НаСервере
Процедура ПостроитьДерево()

	КартаДоступности = Новый Соответствие;
	Для Каждого Строка Из Состояние Цикл
		КартаДоступности.Вставить(Строка.ПолноеИмя, Строка.Доступно);
	КонецЦикла;
	Шаблон = НРег(СокрЛП(Поиск));

	Дерево = РеквизитФормыВЗначение("ДеревоОбъектов");
	Дерево.Строки.Очистить();
	Для Каждого Вид Из ИИА_ПрофилиДоступа.ОбъектыДляНастройки() Цикл
		Группа = Неопределено;
		ВсеДоступны = Истина;
		Для Каждого ОписаниеОбъекта Из Вид.Объекты Цикл
			Если ЗначениеЗаполнено(Шаблон) И СтрНайти(НРег(ОписаниеОбъекта.ПолноеИмя), Шаблон) = 0
				И СтрНайти(НРег(ОписаниеОбъекта.Представление), Шаблон) = 0 Тогда
				Продолжить;
			КонецЕсли;
			// При поиске найденные объекты выводятся плоским списком, без групп по видам.
			Если ЗначениеЗаполнено(Шаблон) Тогда
				Строка = Дерево.Строки.Добавить();
			Иначе
				Если Группа = Неопределено Тогда
					Группа = Дерево.Строки.Добавить();
					Группа.ЭтоГруппа = Истина;
					Группа.Представление = Вид.Представление;
				КонецЕсли;
				Строка = Группа.Строки.Добавить();
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(Строка, ОписаниеОбъекта);
			Строка.Представление = СтрШаблон("%1 (%2)", ОписаниеОбъекта.Представление, ОписаниеОбъекта.ПолноеИмя);
			Строка.Доступно = КартаДоступности.Получить(ОписаниеОбъекта.ПолноеИмя) = Истина;
			Если Не ОписаниеОбъекта.ВнеПериметра И Не Строка.Доступно Тогда
				ВсеДоступны = Ложь;
			КонецЕсли;
		КонецЦикла;
		Если Группа <> Неопределено Тогда
			Группа.Доступно = ВсеДоступны;
		КонецЕсли;
	КонецЦикла;
	ЗначениеВРеквизитФормы(Дерево, "ДеревоОбъектов");
	ПоляОбъекта.Очистить();
	ТекущийОбъект = "";

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПоляТекущегоОбъекта()

	Строка = Элементы.ДеревоОбъектов.ТекущиеДанные;
	Если Строка = Неопределено Или Строка.ЭтоГруппа Тогда
		Если ПоляОбъекта.Количество() > 0 Тогда
			ПоляОбъекта.Очистить();
		КонецЕсли;
		ТекущийОбъект = "";
		Возврат;
	КонецЕсли;
	Если Строка.ПолноеИмя = ТекущийОбъект Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьПоляНаСервере(Строка.ПолноеИмя);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоляНаСервере(ПолноеИмяОбъекта)

	ТекущийОбъект = ПолноеИмяОбъекта;
	ПоляОбъекта.Очистить();
	КартаДоступности = Новый Соответствие;
	Для Каждого Строка Из Состояние Цикл
		КартаДоступности.Вставить(Строка.ПолноеИмя, Строка.Доступно);
	КонецЦикла;
	ДоступенОбъект = КартаДоступности.Получить(ПолноеИмяОбъекта) = Истина;
	Для Каждого ОписаниеПоля Из ИИА_ПрофилиДоступа.ПоляДляНастройки(ПолноеИмяОбъекта) Цикл
		Строка = ПоляОбъекта.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, ОписаниеПоля);
		// Поле табличной части без своего правила следует правилу табличной части.
		Доступно = КартаДоступности.Получить(ОписаниеПоля.ПолноеИмя);
		Если Доступно = Неопределено Тогда
			Части = СтрРазделить(ОписаниеПоля.ПолноеИмя, ".");
			Если Части.Количество() = 4 Тогда
				Доступно = КартаДоступности.Получить(Части[0] + "." + Части[1] + "." + Части[2]);
			КонецЕсли;
		КонецЕсли;
		Строка.Доступно = ?(Доступно = Неопределено, ДоступенОбъект, Доступно) И Не ОписаниеПоля.ВнеПериметра;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьСостояние(ПолноеИмя, Доступно)

	Найденные = Состояние.НайтиСтроки(Новый Структура("ПолноеИмя", ПолноеИмя));
	Если Найденные.Количество() = 0 Тогда
		Строка = Состояние.Добавить();
		Строка.ПолноеИмя = ПолноеИмя;
	Иначе
		Строка = Найденные[0];
	КонецЕсли;
	Строка.Доступно = Доступно;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтметкуГруппы(Группа)

	Если Группа = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ВсеДоступны = Истина;
	Для Каждого Строка Из Группа.ПолучитьЭлементы() Цикл
		Если Не Строка.ВнеПериметра И Не Строка.Доступно Тогда
			ВсеДоступны = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Группа.Доступно = ВсеДоступны;

КонецПроцедуры

&НаСервере
Процедура УстановитьВсеНаСервере(Доступно)

	ЗапрещенныеПериметром = ИИА_Периметр.ОписаниеПериметра().ЗапрещенныеОбъекты;
	Удалить = Новый Массив;
	Для Каждого Строка Из Состояние Цикл
		Если ЭтоИмяОбъекта(Строка.ПолноеИмя) Тогда
			Строка.Доступно = Доступно И ЗапрещенныеПериметром.Получить(ВРег(Строка.ПолноеИмя)) = Неопределено;
		Иначе
			Удалить.Добавить(Строка); // поля снова следуют своим объектам
		КонецЕсли;
	КонецЦикла;
	Для Каждого Строка Из Удалить Цикл
		Состояние.Удалить(Строка);
	КонецЦикла;
	Модифицированность = Истина;
	ПостроитьДерево();

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоИмяОбъекта(ПолноеИмя)

	Возврат СтрРазделить(ПолноеИмя, ".").Количество() = 2;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИмяОбъектаПоля(ПолноеИмя)

	Части = СтрРазделить(ПолноеИмя, ".");
	Возврат Части[0] + "." + Части[1];

КонецФункции

#КонецОбласти
