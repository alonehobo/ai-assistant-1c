#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Элементы.Правила.Заголовок = СтрСоединить(ИИА_КартаДоступа.ПравилаДоступа(), Символы.ПС);
	Элементы.ПояснениеСчетов.Заголовок = НСтр("ru = 'Счета 69, 70, 71 и 73 (расчёты с персоналом) закрыты всегда со всеми субсчетами. Остальные счета модель видит только в бухгалтерских отчётах ассистента и только если их разрешает профиль доступа пользователя; запрещённый счёт сильнее разрешённого.'");
	Элементы.СтраницаСчета.Видимость = ИИА_БухгалтерскийДоступ.ПланСчетовДоступен();
	Элементы.ПояснениеВерсий.Видимость =ИИА_Политики.ПолитикиЧерезВерсии();
	МожноИзменять = ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ИИА_КлассификацияДанных);
	Элементы.ИзменитьКласс.Доступность = МожноИзменять;
	Элементы.ВернутьАвтоматический.Доступность = МожноИзменять;
	Элементы.Обновить.Доступность = МожноИзменять;
	Элементы.Маскирование.ТолькоПросмотр = Не ИИА_Маскирование.МожноИзменятьНастройки();
	ЗаполнитьТаблицы();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборОбъектовПриИзменении(Элемент)

	ПрименитьОтбор();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОбъекты

&НаКлиенте
Процедура ОбъектыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если Элементы.ИзменитьКласс.Доступность Тогда
		ИзменитьКласс(Неопределено);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СчетаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Счета.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(ТекущиеДанные.Счет) Тогда
		ПоказатьЗначение(, ТекущиеДанные.Счет);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура МоделиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Модели.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПоказатьЗначение(, ТекущиеДанные.Подключение);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыМаскирование

&НаКлиенте
Процедура МаскированиеПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)

	ТекущиеДанные = Элементы.Маскирование.ТекущиеДанные;
	Если ОтменаРедактирования Или ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Ошибка = ЗаписатьНастройкуМаскирования(ТекущиеДанные.ПолноеИмя, ТекущиеДанные.Префикс, ТекущиеДанные.Поля,
		ТекущиеДанные.Используется, ТекущиеДанные.ПрежнееПолноеИмя);
	Если Не ПустаяСтрока(Ошибка) Тогда
		ПоказатьПредупреждение(, Ошибка);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура МаскированиеПередУдалением(Элемент, Отказ)

	Отказ = Истина;
	ТекущиеДанные = Элементы.Маскирование.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(ТекущиеДанные.ПрежнееПолноеИмя) Тогда
		Маскирование.Удалить(ТекущиеДанные);
		Возврат;
	КонецЕсли;
	ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОбУдаленииМаскирования", ЭтотОбъект,
		ТекущиеДанные.ПрежнееПолноеИмя), СтрШаблон(НСтр("ru = 'Перестать маскировать %1 для внешней модели?'"),
		ТекущиеДанные.Представление), РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ИзменитьКласс(Команда)

	ТекущиеДанные = Элементы.Объекты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПараметрыФормы = Новый Структура("Ключ", КлючЗаписи(ТекущиеДанные.ПолноеИмя));
	ОткрытьФорму("РегистрСведений.ИИА_КлассификацияДанных.ФормаЗаписи", ПараметрыФормы, ЭтотОбъект, , , ,
		Новый ОписаниеОповещения("ПослеИзмененияКласса", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура ВернутьАвтоматический(Команда)

	ТекущиеДанные = Элементы.Объекты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекущиеДанные.Источник = ИсточникАвтоматически() Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Класс этой строки уже определяется автоматически.'"));
		Возврат;
	КонецЕсли;
	ВернутьАвтоматическийНаСервере(ТекущиеДанные.ПолноеИмя);

КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)

	Итог = ОбновитьНаСервере();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Классификация обновлена'"), , Итог);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьТаблицы()

	Объекты.Очистить();
	Для Каждого Описание Из ИИА_КартаДоступа.ОбъектыДоступа() Цикл
		НоваяСтрока = Объекты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Описание);
		НоваяСтрока.Закрыт = Не ПустаяСтрока(Описание.Периметр);
	КонецЦикла;
	Периметр.Загрузить(ИИА_КартаДоступа.ПериметрДоступа());
	Счета.Загрузить(ИИА_КартаДоступа.СчетаДоступа());
	Модели.Загрузить(ИИА_КартаДоступа.МоделиДоступа());
	ЗаполнитьМаскирование();
	Элементы.СтраницаОбъекты.Заголовок = СтрШаблон(НСтр("ru = 'Объекты и классы (%1)'"), Объекты.Количество());
	Элементы.СтраницаПериметр.Заголовок = СтрШаблон(НСтр("ru = 'Закрыто всегда (%1)'"), Периметр.Количество());

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицыНаСервере()

	ЗаполнитьТаблицы();

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьОтбор()

	Отбор = Новый Структура;
	Если ЗначениеЗаполнено(ОтборКласс) Тогда
		Отбор.Вставить("Класс", ОтборКласс);
	КонецЕсли;
	Если ЗначениеЗаполнено(ОтборИсточник) Тогда
		Отбор.Вставить("Источник", ОтборИсточник);
	КонецЕсли;
	Если ТолькоЗакрытые Тогда
		Отбор.Вставить("Закрыт", Истина);
	КонецЕсли;
	Элементы.Объекты.ОтборСтрок = ?(Отбор.Количество() = 0, Неопределено, Новый ФиксированнаяСтруктура(Отбор));

КонецПроцедуры

&НаСервереБезКонтекста
Функция КлючЗаписи(ПолноеИмя)

	Возврат РегистрыСведений.ИИА_КлассификацияДанных.СоздатьКлючЗаписи(Новый Структура("ПолноеИмя", ПолноеИмя));

КонецФункции

&НаКлиенте
Процедура ПослеИзмененияКласса(Результат, ДополнительныеПараметры) Экспорт

	ЗаполнитьТаблицыНаСервере();
	ПрименитьОтбор();

КонецПроцедуры

&НаСервере
Процедура ВернутьАвтоматическийНаСервере(ПолноеИмя)

	Если Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ИИА_КлассификацияДанных) Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для изменения классификации данных.'");
	КонецЕсли;
	ИИА_КлассыДанных.ВернутьАвтоматическийКласс(ПолноеИмя);
	ЗаполнитьТаблицы();

КонецПроцедуры

&НаСервере
Функция ОбновитьНаСервере()

	Если Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ИИА_КлассификацияДанных) Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для изменения классификации данных.'");
	КонецЕсли;
	Итог = ИИА_КлассыДанных.СинхронизироватьАвтоматическуюКлассификацию();
	ЗаполнитьТаблицы();
	Возврат СтрШаблон(НСтр("ru = 'Добавлено: %1, изменено: %2, удалено: %3.'"), Итог.Добавлено, Итог.Изменено, Итог.Удалено);

КонецФункции

&НаСервере
Процедура ЗаполнитьМаскирование()

	Маскирование.Очистить();
	Для Каждого Строка Из ИИА_Маскирование.СтрокиНастроекДляФормы() Цикл
		НоваяСтрока = Маскирование.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.ПрежнееПолноеИмя = Строка.ПолноеИмя;
	КонецЦикла;
	Описание = ИИА_Маскирование.ОписаниеДляМодели();
	Пояснение = НСтр("ru = 'Если пользователю может отвечать внешняя модель (Т3), ссылки справочников списка передаются ей псевдонимами («Контрагент №5»), наименования в тексте заменяются, перечисленные реквизиты (через запятую) модели не выдаются. ИНН организаций маскируется всегда при действии маскирования. Пользователь видит настоящие значения. Модели Т1/Т2 видят наименования.'");
	Если ИИА_Политики.ПолитикиЧерезВерсии() Тогда
		Пояснение = Пояснение + Символы.ПС
			+ НСтр("ru = 'Включён режим версий политик: показан список действующей версии, изменения - через черновик версии.'");
	КонецЕсли;
	Пояснение = Пояснение + Символы.ПС + ?(Описание.active,
		НСтр("ru = 'Для вас маскирование действует.'"), НСтр("ru = 'Для вас маскирование сейчас не действует.'"));
	Элементы.ПояснениеМаскирования.Заголовок = Пояснение;

КонецПроцедуры

&НаСервере
Функция ЗаписатьНастройкуМаскирования(Знач ПолноеИмя, Знач Префикс, Знач Поля, Знач Используется, Знач ПрежнееПолноеИмя)

	Ошибка = "";
	// Ошибка проверки настройки (префикс, поля, права) не журналируется: её текст показывается пользователю.
	Попытка
		ИИА_Маскирование.ЗаписатьНастройку(ПолноеИмя, Префикс, Поля, Используется, ПрежнееПолноеИмя);
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	ЗаполнитьМаскирование();
	Возврат Ошибка;

КонецФункции

&НаКлиенте
Процедура ПослеВопросаОбУдаленииМаскирования(Ответ, ПолноеИмя) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		УдалитьНастройкуМаскирования(ПолноеИмя);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УдалитьНастройкуМаскирования(Знач ПолноеИмя)

	ИИА_Маскирование.УдалитьНастройку(ПолноеИмя);
	ЗаполнитьМаскирование();

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ИсточникАвтоматически()

	Возврат НСтр("ru = 'Автоматически'");

КонецФункции

#КонецОбласти
