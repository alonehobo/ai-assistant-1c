#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ТекущийШаг = 1;
	ЗаполнитьПоставляемыеДанныеНаСервере();

	Подключение = ИИА_МастерНастройки.ПодключениеПоУмолчанию();
	ЗаполнитьПоПодключению();

	Назначенные = ИИА_МастерНастройки.ПользователиАссистента();
	ОшибкаПрофилей = Назначенные.Ошибка;
	Для Каждого Назначение Из Назначенные.Пользователи Цикл
		ЗаполнитьЗначенияСвойств(Пользователи.Добавить(), Назначение);
	КонецЦикла;
	Если Пользователи.Количество() = 0 Тогда
		НоваяСтрока = Пользователи.Добавить();
		НоваяСтрока.Пользователь = Назначенные.ТекущийПользователь;
		НоваяСтрока.Администратор = Истина;
	КонецЕсли;

	Настройки = ИИА_ЧатВызовСервера.ПрочитатьНастройки();
	// Мастер запускают, чтобы включить ассистента.
	Использовать = Истина;
	ЛимитХодов = Настройки.ЛимитХодов;
	РазрешитьИзображения = Настройки.РазрешитьИзображения;
	ПрофильПоУмолчанию = Настройки.ПрофильПоУмолчанию;

	ОбновитьШаг(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПолеПодключениеПриИзменении(Элемент)

	КлючAPI = "";
	СостояниеПроверкиМодели = "";
	ЗаполнитьПоПодключению();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Назад(Команда)

	ТекущийШаг = Макс(1, ТекущийШаг - 1);
	ОбновитьШаг(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура Далее(Команда)

	Если ТекущийШаг = ПоследнийШаг() Тогда
		Закрыть(Истина);
		Возврат;
	КонецЕсли;
	Если Не ВыполнитьШагНаСервере() Тогда
		Возврат;
	КонецЕсли;
	ТекущийШаг = ТекущийШаг + 1;
	ОбновитьШаг(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПовторно(Команда)

	ЗаполнитьПоставляемыеДанныеНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьМодель(Команда)

	Если Не ЗначениеЗаполнено(Подключение) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Выберите провайдера.'"), , "Подключение");
		Возврат;
	КонецЕсли;
	СостояниеПроверкиМодели = ПроверитьМодельНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПодключение(Команда)

	Если Не ЗначениеЗаполнено(Подключение) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Выберите провайдера.'"), , "Подключение");
		Возврат;
	КонецЕсли;
	ОткрытьФорму("Справочник.ИИА_ПодключенияМоделей.ФормаОбъекта", Новый Структура("Ключ", Подключение), ЭтотОбъект, , , ,
		Новый ОписаниеОповещения("ОткрытьПодключениеЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОткрытьПодключениеЗавершение(Результат, ДополнительныеПараметры) Экспорт

	ЗаполнитьПоПодключению();

КонецПроцедуры

&НаСервере
Функция ПроверитьМодельНаСервере()

	Если Не ЗаписатьПодключениеНаСервере(Ложь) Тогда
		Возврат НСтр("ru = 'Подключение не записано.'");
	КонецЕсли;
	Возврат ИИА_МастерНастройки.ПроверитьПодключение(Подключение);

КонецФункции

&НаСервере
Процедура ЗаполнитьПоставляемыеДанныеНаСервере()

	Результат = ИИА_МастерНастройки.ЗаполнитьПоставляемыеДанные();
	ДанныеЗаполнены = Результат.Успех;
	СостояниеДанных = Результат.Текст;
	Элементы.ПолеСостояниеДанных.ЦветТекста = ?(ДанныеЗаполнены, Новый Цвет, ЦветаСтиля.ПоясняющийОшибкуТекст);
	Если Не ЗначениеЗаполнено(Подключение) Тогда
		Подключение = ИИА_МастерНастройки.ПодключениеПоУмолчанию();
		ЗаполнитьПоПодключению();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоПодключению()

	Если Не ЗначениеЗаполнено(Подключение) Тогда
		Модель = "";
		ОписаниеПодключения = "";
		Элементы.ПолеКлючAPI.ПодсказкаВвода = "";
		Возврат;
	КонецЕсли;
	Описание = ИИА_МастерНастройки.ОписаниеПодключения(Подключение);
	Модель = Описание.Модель;
	ОписаниеПодключения = СтрШаблон(НСтр("ru = 'Адрес: %1. Уровень доверия: %2.'"), Описание.АдресAPI, Описание.Доверие);
	Предупреждение = ИИА_КлассыДанных.ПредупреждениеДоверия(Описание.Доверие, Описание.АдресAPI);
	Если Не ПустаяСтрока(Предупреждение) Тогда
		ОписаниеПодключения = ОписаниеПодключения + Символы.ПС + Предупреждение;
	КонецЕсли;
	Если Не ПустаяСтрока(Описание.Комментарий) Тогда
		ОписаниеПодключения = ОписаниеПодключения + Символы.ПС + Описание.Комментарий;
	КонецЕсли;
	Элементы.ПолеКлючAPI.ПодсказкаВвода = ?(Описание.КлючСохранен, НСтр("ru = 'сохранён; пусто - не менять'"), "");

КонецПроцедуры

// Ложь - шаг не выполнен, причина сообщена пользователю.
&НаСервере
Функция ВыполнитьШагНаСервере()

	Страница = Элементы.Страницы.ТекущаяСтраница;
	Если Страница = Элементы.СтраницаДанные Тогда
		Выполнен = ПроверитьПоставляемыеДанные();
	ИначеЕсли Страница = Элементы.СтраницаМодель Тогда
		Выполнен = ВключитьПодключение();
	ИначеЕсли Страница = Элементы.СтраницаПользователи Тогда
		Выполнен = ВыдатьПрофилиНаСервере();
	ИначеЕсли Страница = Элементы.СтраницаВключение Тогда
		Выполнен = ЗаписатьНастройкиНаСервере();
	Иначе
		Выполнен = Истина;
	КонецЕсли;
	Возврат Выполнен;

КонецФункции

&НаСервере
Функция ПроверитьПоставляемыеДанные()

	Если Не ДанныеЗаполнены Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Поставляемые данные не заполнены. Устраните причину и нажмите «Заполнить повторно».'"));
	КонецЕсли;
	Возврат ДанныеЗаполнены;

КонецФункции

&НаСервере
Функция ВключитьПодключение()

	Если Не ЗначениеЗаполнено(Подключение) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Выберите провайдера.'"), , "Подключение");
		Возврат Ложь;
	КонецЕсли;
	Если ПустаяСтрока(Модель) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Укажите модель.'"), , "Модель");
		Возврат Ложь;
	КонецЕсли;
	Возврат ЗаписатьПодключениеНаСервере(Истина);

КонецФункции

&НаСервере
Функция ЗаписатьНастройкиНаСервере()

	Попытка
		ИИА_ЧатВызовСервера.ЗаписатьНастройки(Использовать, ЛимитХодов, РазрешитьИзображения, ПрофильПоУмолчанию);
	Исключение
		ОбщегоНазначения.СообщитьПользователю(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	Итог = ТекстИтога();
	Возврат Истина;

КонецФункции

&НаСервере
Функция ЗаписатьПодключениеНаСервере(Включить)

	Попытка
		ИИА_МастерНастройки.ЗаписатьПодключение(Подключение, Модель, КлючAPI, Включить);
	Исключение
		ОбщегоНазначения.СообщитьПользователю(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	КлючAPI = "";
	ЗаполнитьПоПодключению();
	Возврат Истина;

КонецФункции

&НаСервере
Функция ВыдатьПрофилиНаСервере()

	// Без поставляемых профилей шаг пропускается: профили можно выдать позже, причина видна на странице.
	Если Не ПустаяСтрока(ОшибкаПрофилей) Тогда
		Возврат Истина;
	КонецЕсли;
	Назначения = Новый Массив;
	Для Каждого СтрокаТаблицы Из Пользователи Цикл
		Назначение = Новый Структура("Пользователь, Администратор", СтрокаТаблицы.Пользователь, СтрокаТаблицы.Администратор);
		Назначения.Добавить(Назначение);
	КонецЦикла;
	Попытка
		ИИА_МастерНастройки.ВыдатьПрофили(Назначения);
	Исключение
		ОбщегоНазначения.СообщитьПользователю(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;

КонецФункции

&НаСервере
Функция ТекстИтога()

	Строки = Новый Массив;
	Строки.Добавить(СостояниеДанных);
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Подключение к модели: %1, модель %2.'"), Подключение, Модель));
	Если ПустаяСтрока(ОшибкаПрофилей) Тогда
		Шаблон = НСтр("ru = 'Профили групп доступа ассистента выданы пользователям: %1.'");
		Строки.Добавить(СтрШаблон(Шаблон, Пользователи.Количество()));
	Иначе
		Строки.Добавить(ОшибкаПрофилей);
	КонецЕсли;
	Строки.Добавить(?(Использовать, НСтр("ru = 'Ассистент включён.'"), НСтр("ru = 'Ассистент выключен.'")));
	Строки.Добавить(НСтр("ru = 'Права вступают в силу при следующем входе пользователей в программу.'"));
	Строки.Добавить(НСтр("ru = 'Тонкая настройка - в «Настройках ИИ-ассистента».'"));
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьШаг(Форма)

	Страницы = Форма.Элементы.Страницы.ПодчиненныеЭлементы;
	Страница = Страницы[Форма.ТекущийШаг - 1];
	Форма.Элементы.Страницы.ТекущаяСтраница = Страница;
	Форма.Элементы.ДекорацияШаг.Заголовок = СтрШаблон(НСтр("ru = 'Шаг %1 из %2. %3'"),
		Форма.ТекущийШаг, Страницы.Количество(), Страница.Заголовок);
	Форма.Элементы.ФормаНазад.Доступность = Форма.ТекущийШаг > 1 И Форма.ТекущийШаг < Страницы.Количество();
	Форма.Элементы.ФормаДалее.Заголовок = ?(Форма.ТекущийШаг = Страницы.Количество(),
		НСтр("ru = 'Готово'"), НСтр("ru = 'Далее >'"));

КонецПроцедуры

&НаКлиенте
Функция ПоследнийШаг()

	Возврат Элементы.Страницы.ПодчиненныеЭлементы.Количество();

КонецФункции

#КонецОбласти
