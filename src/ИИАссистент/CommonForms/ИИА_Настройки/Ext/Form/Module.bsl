	КонецЕсли;
	СостояниеПоискаКода = НСтр("ru = 'Поиск... Первый проход по большой выгрузке может занять до минуты.'");
	Если РасположениеКаталога = "Клиент" Тогда
		ПроверитьПоискКодаНаКлиентеАсинх();
	Иначе
		ПодключитьОбработчикОжидания("ВыполнитьПроверкуПоискаКода", ИнтервалОтрисовкиСостояния(), Истина);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Записывает настройки. После включения или выключения ассистента сбрасывается кэш сеанса: подключаемые команды
// БСП кэшируются на сеанс, и «Спросить ИИ» иначе осталась бы в формах в прежнем состоянии. Другие сеансы
// увидят изменение после истечения своего кэша или при новом входе.
&НаКлиенте
Функция ЗаписатьНастройки()

	Если Не ЗаписатьНаСервере() Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ИспользованиеИзменено = Истина Тогда
		ИспользованиеИзменено = Ложь;
		ОбновитьПовторноИспользуемыеЗначения();
	КонецЕсли;
	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура ОткрытьМастерНастройки()

	ОткрытьФорму("ОбщаяФорма.ИИА_МастерНастройки", , ЭтотОбъект, , , ,
		Новый ОписаниеОповещения("МастерНастройкиЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура МастерНастройкиЗавершение(Результат, ДополнительныеПараметры) Экспорт

	ОбновитьПослеМастераНаСервере();

КонецПроцедуры

&НаСервере
Процедура ОбновитьПослеМастераНаСервере()

	ЗаполнитьРеквизиты();
	ТребуетсяНастройка = ИИА_МастерНастройки.ТребуетсяНастройка();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизиты()

	Настройки = ИИА_ЧатВызовСервера.ПрочитатьНастройки();
	Использовать = Настройки.Использовать;
	ОбновитьВидимостьНастроек(ЭтотОбъект);
	ЛимитХодов = Настройки.ЛимитХодов;
	РазрешитьИзображения = Настройки.РазрешитьИзображения;
	РазрешитьФайлы = Настройки.РазрешитьФайлы;
	ПрофильПоУмолчанию = Настройки.ПрофильПоУмолчанию;
	КаталогИсходников = Настройки.КаталогИсходников;
	АдресRLM = ?(ПустаяСтрока(Настройки.АдресRLM), "http://127.0.0.1:9000/mcp", Настройки.АдресRLM);
	ПутьКИсходникам = Настройки.ПутьКИсходникам;
	ИсходникиНаКлиенте = Настройки.ИсходникиНаКлиенте;
	РасположениеКаталога = ?(ИсходникиНаКлиенте, "Клиент", "Сервер");
	СостояниеПоискаКода = ?(ПустаяСтрока(ПутьКИсходникам), НСтр("ru = 'Не настроено.'"), "");
	// Настроен один способ: по нему и выбор. Если не настроен ни один, предлагается компонента.
	СпособПоискаКода = ?(ПустаяСтрока(ПутьКИсходникам) И Не ПустаяСтрока(КаталогИсходников),
		СпособПоискаRLM(), СпособПоискаКомпонентой());
	ПоказатьСтраницуСпособаПоиска(ЭтотОбъект);
	СрокХраненияДней = Настройки.СрокХраненияДней;
	МаксимумОдновременныхХодов = Настройки.МаксимумОдновременныхХодов;
	МаксимумШаговХода = Настройки.МаксимумШаговХода;
	МаксимумМинутХода = Настройки.МаксимумМинутХода;
	ОбщийМостОтчетов = Настройки.ОбщийМостОтчетов;
	ПолитикиЧерезВерсии = Настройки.ПолитикиЧерезВерсии;
	ДовериеВнешнегоКанала = Настройки.ДовериеВнешнегоКанала;
	СостояниеКлючаJWT = ?(Настройки.КлючПодписиJWTЗаполнен, НСтр("ru = 'задан'"), НСтр("ru = 'не задан'"));
	СостояниеИндекса = ?(ПустаяСтрока(КаталогИсходников), НСтр("ru = 'Не настроено.'"), "");
	ОписаниеКачества = ИИА_ЧатВызовСервера.ОписаниеКачества();
	ДиагностикаДоступа = НСтр("ru = 'Покажет, какой профиль и какие модели действуют для пользователя.
		|Проверяются сохранённые настройки, модель не вызывается.'");
	РежимПрокси = Настройки.РежимПрокси;
	АдресПрокси = Настройки.АдресПрокси;
	ПользовательПрокси = Настройки.ПользовательПрокси;
	ПарольПроксиСохранен = Настройки.ПарольПроксиЗаполнен;
	ОбновитьВидимостьПрокси(ЭтотОбъект);
	ОбновитьСостояниеПрокси();

КонецПроцедуры

// Пауза перед долгим серверным вызовом, чтобы платформа успела показать текст состояния.
&НаКлиенте
Функция ИнтервалОтрисовкиСостояния()

	ДесятаяСекунды = 0.1;
	Возврат ДесятаяСекунды;

КонецФункции

