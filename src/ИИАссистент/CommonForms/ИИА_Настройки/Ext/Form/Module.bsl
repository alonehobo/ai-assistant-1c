#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Настройки = ИИА_ЧатВызовСервера.ПрочитатьНастройки();
	Использовать = Настройки.Использовать;
	ЛимитХодов = Настройки.ЛимитХодов;
	РазрешитьИзображения = Настройки.РазрешитьИзображения;
	РазрешитьФайлы = Настройки.РазрешитьФайлы;
	ПрофильПоУмолчанию = Настройки.ПрофильПоУмолчанию;
	КаталогИсходников = Настройки.КаталогИсходников;
	АдресRLM = ?(ПустаяСтрока(Настройки.АдресRLM), "http://127.0.0.1:9000/mcp", Настройки.АдресRLM);
	СрокХраненияДней = Настройки.СрокХраненияДней;
	МаксимумОдновременныхХодов = Настройки.МаксимумОдновременныхХодов;
	ОбщийМостОтчетов = Настройки.ОбщийМостОтчетов;
	ПолитикиЧерезВерсии = Настройки.ПолитикиЧерезВерсии;
	ДовериеВнешнегоКанала = Настройки.ДовериеВнешнегоКанала;
	СостояниеКлючаJWT = ?(Настройки.КлючПодписиJWTЗаполнен, НСтр("ru = 'задан'"), НСтр("ru = 'не задан'"));
	СостояниеИндекса = ?(ПустаяСтрока(КаталогИсходников), НСтр("ru = 'Не настроено.'"), "");
	ОписаниеКачества = ИИА_ЧатВызовСервера.ОписаниеКачества();
	ДиагностикаДоступа = НСтр("ru = 'Покажет, какой профиль и какие модели действуют для пользователя. Проверяются сохранённые настройки, модель не вызывается.'");
	РежимПрокси = Настройки.РежимПрокси;
	АдресПрокси = Настройки.АдресПрокси;
	ПользовательПрокси = Настройки.ПользовательПрокси;
	ПарольПроксиСохранен = Настройки.ПарольПроксиЗаполнен;
	ОбновитьВидимостьПрокси(ЭтотОбъект);

	// Сводка в заголовках свёрнутых разделов: что настроено, не раскрывая раздел.
	Элементы.ГруппаКод.ЗаголовокСвернутогоОтображения = СтрШаблон(НСтр("ru = 'Исходный код: %1'"),
		?(ПустаяСтрока(КаталогИсходников), НСтр("ru = 'не настроен'"), НСтр("ru = 'настроен'")));
	Элементы.ГруппаДанные.ЗаголовокСвернутогоОтображения = СтрШаблон(НСтр("ru = 'Данные и политики: согласование версий %1'"),
		?(ПолитикиЧерезВерсии, НСтр("ru = 'включено'"), НСтр("ru = 'выключено'")));
	Элементы.ГруппаВнешнийДоступ.ЗаголовокСвернутогоОтображения = СтрШаблон(НСтр("ru = 'Внешний доступ (HTTP API): ключ подписи %1'"),
		СостояниеКлючаJWT);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПодключениеДляПроверкиПриИзменении(Элемент)

	СостояниеПроверкиМодели = "";

КонецПроцедуры

&НаКлиенте
Процедура ПользовательДляПроверкиПриИзменении(Элемент)

	ДиагностикаДоступа = "";

КонецПроцедуры

&НаКлиенте
Процедура ПолеРежимПроксиПриИзменении(Элемент)

	ОбновитьВидимостьПрокси(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)

	Если ЗаписатьНаСервере() Тогда
		Закрыть();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЧат(Команда)

	Если ЗаписатьНаСервере() Тогда
		ОткрытьФорму("ОбщаяФорма.ИИА_Чат", , ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодключение(Команда)

	Если ПустаяСтрока(КаталогИсходников) Или ПустаяСтрока(АдресRLM) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите адрес сервиса rlm-tools-bsl и имя проекта из реестра rlm.'"));
		Возврат;
	КонецЕсли;
	СостояниеИндекса = НСтр("ru = 'Подключение... Первое открытие проекта может занять до минуты.'");
	ПодключитьОбработчикОжидания("ВыполнитьПроверкуПодключения", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ТестовыйЗапросRLM(Команда)

	Если ПустаяСтрока(КаталогИсходников) Или ПустаяСтрока(АдресRLM) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите адрес сервиса rlm-tools-bsl и имя проекта из реестра rlm.'"));
		Возврат;
	КонецЕсли;
	СостояниеИндекса = НСтр("ru = 'Тестовый запрос к rlm-tools-bsl... Первое открытие проекта может занять до минуты.'");
	ПодключитьОбработчикОжидания("ВыполнитьТестовыйЗапросRLM", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьМодель(Команда)

	Если Не ЗначениеЗаполнено(ПодключениеДляПроверки) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите подключение. Провайдер получит только тестовое сообщение, без данных базы.'"));
		Возврат;
	КонецЕсли;
	СостояниеПроверкиМодели = ПроверитьМодельНаСервере(ПодключениеДляПроверки);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьДоступ(Команда)

	ДиагностикаДоступа = ПроверитьДоступНаСервере(ПользовательДляПроверки);

КонецПроцедуры

&НаКлиенте
Процедура ПодключенияМоделей(Команда)

	ОткрытьФорму("Справочник.ИИА_ПодключенияМоделей.ФормаСписка", , ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПрофилиДоступа(Команда)

	ОткрытьФорму("Справочник.ИИА_ПрофилиДоступа.ФормаСписка", , ЭтотОбъект);

КонецПроцедуры

