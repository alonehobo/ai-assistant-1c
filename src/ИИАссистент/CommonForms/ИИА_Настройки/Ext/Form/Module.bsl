КонецПроцедуры

&НаКлиенте
Процедура ПрогнатьЭталон(Команда)

	ЗапуститьОценкуНаСервере();
	ОписаниеКачества = НСтр("ru = 'Прогон эталонных вопросов запущен в фоне (несколько минут). Итог появится здесь при следующем открытии настроек.'");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыполнитьПроверкуПодключения()

	ПроверитьПодключениеНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьТестовыйЗапросRLM()

	ТестовыйЗапросRLMНаСервере();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьМодельНаСервере(Подключение)

	Возврат ИИА_ЧатВызовСервера.ПроверитьПодключение(Подключение);

КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьДоступНаСервере(Пользователь)

	Результат = ИИА_ЧатВызовСервера.ДиагностикаДоступа(Пользователь);
	Возврат Результат.Текст;

КонецФункции

// Ложь - настройки не записаны, причина сообщена пользователю у поля.
&НаСервере
Функция ЗаписатьНаСервере()

	Если Не ПроектRLMКорректен() Тогда
		Возврат Ложь;
	КонецЕсли;
	Если РежимПрокси = Перечисления.ИИА_РежимыПрокси.СвойПрокси
		И ПустаяСтрока(ИИА_HTTPКлиент.РазобратьАдресПрокси(АдресПрокси).Сервер) Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Укажите адрес своего прокси в виде «сервер:порт», например 127.0.0.1:10809.'"), , "АдресПрокси");
		Возврат Ложь;
	КонецЕсли;
	ИИА_ЧатВызовСервера.ЗаписатьНастройки(Использовать, ЛимитХодов, РазрешитьИзображения, ПрофильПоУмолчанию);
	ИИА_ЧатВызовСервера.ЗаписатьНастройкиИсходников(КаталогИсходников, АдресRLM);
	Дополнительно = Новый Структура("СрокХраненияДней, ОбщийМостОтчетов, ПолитикиЧерезВерсии, ДовериеВнешнегоКанала, КлючПодписиJWT, МаксимумОдновременныхХодов",
		СрокХраненияДней, ОбщийМостОтчетов, ПолитикиЧерезВерсии, ДовериеВнешнегоКанала, КлючПодписиJWT, МаксимумОдновременныхХодов);
	Дополнительно.Вставить("РазрешитьФайлы", РазрешитьФайлы);
	Дополнительно.Вставить("РежимПрокси", РежимПрокси);
	Дополнительно.Вставить("АдресПрокси", АдресПрокси);
	Дополнительно.Вставить("ПользовательПрокси", ПользовательПрокси);
	Дополнительно.Вставить("ПарольПрокси", ПарольПрокси);
	ИИА_ЧатВызовСервера.ЗаписатьДополнительныеНастройки(Дополнительно);
	КлючПодписиJWT = "";
	Если Не ПустаяСтрока(ПарольПрокси) Тогда
		ПарольПроксиСохранен = Истина;
	КонецЕсли;
	ПарольПрокси = "";
	ОбновитьВидимостьПрокси(ЭтотОбъект);
	Возврат Истина;

КонецФункции

// Проект rlm задаётся именем из реестра rlm; путь к выгрузке исследование не принимает.
&НаСервере
Функция ПроектRLMКорректен()

	Если Не ИИА_ИсходныйКод.ПроектЗаданПутем(СокрЛП(КаталогИсходников)) Тогда
		Возврат Истина;
	КонецЕсли;
	ОбщегоНазначения.СообщитьПользователю(ИИА_ИсходныйКод.ТекстОшибкиПроектаПутем(), , "КаталогИсходников");
	СостояниеИндекса = ИИА_ИсходныйКод.ТекстОшибкиПроектаПутем();
	ОформитьСостояние(Элементы.ПолеСостояниеИндекса, Ложь);
	Возврат Ложь;

КонецФункции

&НаСервере
Процедура ПроверитьПодключениеНаСервере()

	Если Не ПроектRLMКорректен() Тогда
		Возврат;
	КонецЕсли;
	ИИА_ЧатВызовСервера.ЗаписатьНастройкиИсходников(КаталогИсходников, АдресRLM);
	Результат = ИИА_ЧатВызовСервера.ПроверитьПодключениеКИсходникам();
	СостояниеИндекса = Результат.Текст;
	ОформитьСостояние(Элементы.ПолеСостояниеИндекса, Результат.Успех);

КонецПроцедуры

&НаСервере
Процедура ТестовыйЗапросRLMНаСервере()

	Если Не ПроектRLMКорректен() Тогда
		Возврат;
	КонецЕсли;
	ИИА_ЧатВызовСервера.ЗаписатьНастройкиИсходников(КаталогИсходников, АдресRLM);
	Результат = ИИА_ЧатВызовСервера.ВыполнитьТестовыйЗапросКИсходникам();
	СостояниеИндекса = Результат.Текст;
	ОформитьСостояние(Элементы.ПолеСостояниеИндекса, Результат.Успех);

КонецПроцедуры

// Адрес, пользователь и пароль нужны только для своего прокси ассистента. Пароль в форму не читается.
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьВидимостьПрокси(Форма)

	Элементы = Форма.Элементы;
	Элементы.ГруппаСвойПрокси.Видимость =
		Форма.РежимПрокси = ПредопределенноеЗначение("Перечисление.ИИА_РежимыПрокси.СвойПрокси");
	Элементы.ПолеПарольПрокси.ПодсказкаВвода = ?(Форма.ПарольПроксиСохранен,
		НСтр("ru = 'сохранён'"), НСтр("ru = 'не задан'"));

КонецПроцедуры

// Результат проверки: зелёный при успехе, оранжевый при ошибке (цвета стиля расширения).
&НаСервере
Процедура ОформитьСостояние(Элемент, Успех)

	Элемент.ЦветТекста = ?(Успех, ЦветаСтиля.ИИА_ЦветТекстаУспех, ЦветаСтиля.ИИА_ЦветТекстаПредупреждение);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПерестроитьКаталогНаСервере()

	ИИА_ЧатВызовСервера.ПерестроитьКаталогМетаданных();

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗапуститьОценкуНаСервере()

	ИИА_ЧатВызовСервера.ЗапуститьОценкуКачества();

КонецПроцедуры

#КонецОбласти
