КонецПроцедуры

&НаКлиенте
Асинх Процедура ПроверитьПоискКодаНаКлиентеАсинх()

	Итог = Ждать ИИА_ЧатКлиент.ПроверитьПоискКодаАсинх(ПутьКИсходникам, ЗапросПроверкиПоискаКода());
	ПоказатьИтогПроверкиПоискаКода(Итог.Ответ, Итог.Версия, Итог.Миллисекунд);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗапросПроверкиПоискаКода()

	Возврат ИИА_ЧатВызовСервера.ЗапросПроверкиПоискаКода();

КонецФункции

&НаСервере
Процедура ПоказатьИтогПроверкиПоискаКода(Знач Ответ, Знач Версия, Знач Миллисекунд)

	Результат = ИИА_ЧатВызовСервера.ИтогПроверкиПоискаКода(Ответ, Версия, Миллисекунд);
	Если Не Результат.Успех И Не СтрНачинаетсяС(СокрЛ(Ответ), "{") Тогда
		Результат.Текст = Ответ; // причина от клиента: компонента не установилась или не подключилась
	КонецЕсли;
	СостояниеПоискаКода = Результат.Текст;
	ОформитьСостояние(Элементы.ПолеСостояниеПоискаКода, Результат.Успех);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьМодельНаСервере(Знач Подключение)

	Возврат ИИА_ЧатВызовСервера.ПроверитьПодключение(Подключение);

КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьДоступНаСервере(Знач Пользователь)

	Результат = ИИА_ЧатВызовСервера.ДиагностикаДоступа(Пользователь);
	Возврат Результат.Текст;

КонецФункции

// Ложь - настройки не записаны, причина сообщена пользователю у поля.
&НаСервере
Функция ЗаписатьНаСервере()

	Если СпособПоискаКода = СпособПоискаRLM() И Не ПроектИсходниковКорректен() Тогда
		Возврат Ложь;
	КонецЕсли;
	Если РежимПрокси = Перечисления.ИИА_РежимыПрокси.СвойПрокси
		И ПустаяСтрока(ИИА_HTTPКлиент.РазобратьАдресПрокси(АдресПрокси).Сервер) Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Укажите адрес своего прокси в виде «сервер:порт», например 127.0.0.1:10809.'"), , "АдресПрокси");
		Возврат Ложь;
	КонецЕсли;
	// Ассистент ищет только выбранным способом: настройки другого очищаются (у каждого способа признак
	// включения - заполненный каталог или проект).
	Если СпособПоискаКода = СпособПоискаRLM() Тогда
		ПутьКИсходникам = "";
		СостояниеПоискаКода = НСтр("ru = 'Не настроено.'");
	Иначе
		КаталогИсходников = "";
		СостояниеИндекса = НСтр("ru = 'Не настроено.'");
	КонецЕсли;
	ИИА_ЧатВызовСервера.ЗаписатьНастройки(Использовать, ЛимитХодов, РазрешитьИзображения, ПрофильПоУмолчанию);
	ИИА_ЧатВызовСервера.ЗаписатьНастройкиИсходников(КаталогИсходников, АдресRLM);
	ИИА_ЧатВызовСервера.ЗаписатьНастройкиПоискаКода(ПутьКИсходникам, РасположениеКаталога = "Клиент");
	Дополнительно = Новый Структура;
	Дополнительно.Вставить("СрокХраненияДней", СрокХраненияДней);
	Дополнительно.Вставить("ОбщийМостОтчетов", ОбщийМостОтчетов);
	Дополнительно.Вставить("ПолитикиЧерезВерсии", ПолитикиЧерезВерсии);
	Дополнительно.Вставить("ДовериеВнешнегоКанала", ДовериеВнешнегоКанала);
	Дополнительно.Вставить("КлючПодписиJWT", КлючПодписиJWT);
	Дополнительно.Вставить("МаксимумОдновременныхХодов", МаксимумОдновременныхХодов);
	Дополнительно.Вставить("МаксимумШаговХода", МаксимумШаговХода);
	Дополнительно.Вставить("МаксимумМинутХода", МаксимумМинутХода);
	Дополнительно.Вставить("РазрешитьФайлы", РазрешитьФайлы);
	Дополнительно.Вставить("РежимПрокси", РежимПрокси);
	Дополнительно.Вставить("АдресПрокси", АдресПрокси);
	Дополнительно.Вставить("ПользовательПрокси", ПользовательПрокси);
	Дополнительно.Вставить("ПарольПрокси", ПарольПрокси);
	ИИА_ЧатВызовСервера.ЗаписатьДополнительныеНастройки(Дополнительно);
	КлючПодписиJWT = "";
	Если Не ПустаяСтрока(ПарольПрокси) Тогда
		ПарольПроксиСохранен = Истина;
	КонецЕсли;
	ПарольПрокси = "";
	ОбновитьВидимостьПрокси(ЭтотОбъект);
	Возврат Истина;

КонецФункции

// Проект rlm задаётся именем из реестра rlm; путь к выгрузке исследование не принимает.
&НаСервере
Функция ПроектИсходниковКорректен()

	Если Не ИИА_ИсходныйКод.ПроектЗаданПутем(СокрЛП(КаталогИсходников)) Тогда
		Возврат Истина;
	КонецЕсли;
	ОбщегоНазначения.СообщитьПользователю(ИИА_ИсходныйКод.ТекстОшибкиПроектаПутем(), , "КаталогИсходников");
	СостояниеИндекса = ИИА_ИсходныйКод.ТекстОшибкиПроектаПутем();
	ОформитьСостояние(Элементы.ПолеСостояниеИндекса, Ложь);
	Возврат Ложь;

КонецФункции

&НаСервере
Процедура ПроверитьПодключениеНаСервере()

	Если Не ПроектИсходниковКорректен() Тогда
		Возврат;
	КонецЕсли;
	ИИА_ЧатВызовСервера.ЗаписатьНастройкиИсходников(КаталогИсходников, АдресRLM);
	Результат = ИИА_ЧатВызовСервера.ПроверитьПодключениеКИсходникам();
	СостояниеИндекса = Результат.Текст;
	ОформитьСостояние(Элементы.ПолеСостояниеИндекса, Результат.Успех);

КонецПроцедуры

&НаСервере
Процедура ТестовыйЗапросКИсходникамНаСервере()

	Если Не ПроектИсходниковКорректен() Тогда
		Возврат;
	КонецЕсли;
	ИИА_ЧатВызовСервера.ЗаписатьНастройкиИсходников(КаталогИсходников, АдресRLM);
	Результат = ИИА_ЧатВызовСервера.ВыполнитьТестовыйЗапросКИсходникам();
	СостояниеИндекса = Результат.Текст;
