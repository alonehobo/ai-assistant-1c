#КонецОбласти

#Область ОписаниеВозможностей

&НаСервереБезКонтекста
Функция ПакетВозможностейНаСервере()

	Возврат ИИА_ЧатВызовСервера.БазовыйПакетВозможностейЧата();

КонецФункции

// Начинает одну загрузку подсказок без блокировки ввода и окна ожидания.
&НаКлиенте
Процедура ЗагрузитьВозможностиВФоне()

	Если Не ЭтотОбъект.СтраницаГотова Или БазовыеВозможности = Неопределено
		Или ВозможностиТребуютЗагрузки <> Истина Тогда
		Возврат;
	КонецЕсли;
	Если ЕстьАктивныйХод И ОбщегоНазначенияКлиент.ИнформационнаяБазаФайловая() Тогда
		// В файловой базе фоновые задания выполняются по одному: подсказки загрузятся после ответа (см. ОпроситьХод).
		ПоказатьПодсказкуНаСтранице(НСтр("ru = 'Подсказки появятся после ответа ассистента.'"));
		Возврат;
	КонецЕсли;
	ВозможностиТребуютЗагрузки = Ложь;
	ИнвалидироватьВозможностиЧата();
	ЭтотОбъект.ВозможностиЧатаJSON = БазовыеВозможности;
	ПередатьНаСтраницу(БазовыеВозможности);
	ИдентификаторЗапросаВозможностей = Строка(Новый УникальныйИдентификатор());
	ОперацияВозможностей = ЗапуститьВозможностиНаСервере(ИдентификаторЗапросаВозможностей);
	Если ОперацияВозможностей = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ОперацияВозможностей,
		Новый ОписаниеОповещения("ВозможностиЧатаЗавершение", ЭтотОбъект, ИдентификаторЗапросаВозможностей),
		ПараметрыОжидания);

КонецПроцедуры

// Принимает результат только для открытого экземпляра и текущего запроса; повторов при ошибке нет.
// Параметры:
//  Результат - Структура, Неопределено - результат ожидания БСП.
//  Идентификатор - Строка - UUID запроса, переданный в оповещение.
&НаКлиенте
Процедура ВозможностиЧатаЗавершение(Результат, Идентификатор) Экспорт

	Если Результат = Неопределено Или Результат.Статус <> "Выполнено" Тогда
		Если Идентификатор = ИдентификаторЗапросаВозможностей Тогда
			ИдентификаторЗапросаВозможностей = "";
			ОперацияВозможностей = Неопределено;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если Идентификатор <> ИдентификаторЗапросаВозможностей Или Не ЭтотОбъект.Открыта() Тогда
		ОчиститьРезультатВозможностейНаСервере(Результат.АдресРезультата);
		Возврат;
	КонецЕсли;
	Пакет = ВозможностиИзХранилищаНаСервере(Результат.АдресРезультата, Идентификатор);
	Если Идентификатор <> ИдентификаторЗапросаВозможностей Или Не ЭтотОбъект.Открыта() Тогда
		Возврат;
	КонецЕсли;
	ИдентификаторЗапросаВозможностей = "";
	ОперацияВозможностей = Неопределено;
	ЭтотОбъект.ВозможностиЧатаJSON = Пакет;
	ПередатьНаСтраницу(Пакет);

КонецПроцедуры

&НаКлиенте
Процедура ИнвалидироватьВозможностиЧата()

	ИдентификаторЗапросаВозможностей = "";
	ПрежняяОперация = ОперацияВозможностей;
	ОперацияВозможностей = Неопределено;
	Если ПрежняяОперация <> Неопределено И ЗначениеЗаполнено(ПрежняяОперация.ИдентификаторЗадания) Тогда
		ОтменитьВозможностиНаСервере(ПрежняяОперация.ИдентификаторЗадания);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗапуститьВозможностиНаСервере(Знач Идентификатор)

	Попытка
		Если Не ИИА_ЧатВызовСервера.НачальныеПодсказкиДоступны() Тогда
			Возврат Неопределено;
		КонецЕсли;
		Запрос = Новый Структура("Идентификатор, Метка", Идентификатор, ИИА_ЧатВызовСервера.МеткаВозможностейЧата());
		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
		ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'ИИ-ассистент: возможности чата'");
		ПараметрыВыполнения.ЗапуститьВФоне = Истина;
		ПараметрыВыполнения.ОжидатьЗавершение = 0;
		Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
			"ИИА_ЧатВызовСервера.ПодготовитьВозможностиЧата", Запрос);
	Исключение
		ЗаписьЖурналаРегистрации("ИИАссистент.ВозможностиЧата", УровеньЖурналаРегистрации.Ошибка, , ,
			"CHAT_CAPABILITIES_START_ERROR");
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

&НаСервереБезКонтекста
Функция ВозможностиИзХранилищаНаСервере(Знач Адрес, Знач Идентификатор)

	Подготовленные = ПолучитьИзВременногоХранилища(Адрес);
	УдалитьИзВременногоХранилища(Адрес);
	Попытка
		Метка = ИИА_ЧатВызовСервера.МеткаВозможностейЧата();
		Возврат ИИА_ЧатВызовСервера.ПринятьВозможностиЧата(Подготовленные, Идентификатор, Метка,
			ИИА_ЧатВызовСервера.НачальныеПодсказкиДоступны());
	Исключение
		ЗаписьЖурналаРегистрации("ИИАссистент.ВозможностиЧата", УровеньЖурналаРегистрации.Ошибка, , ,
			"CHAT_CAPABILITIES_RECEIVE_ERROR");
		Возврат ИИА_ЧатВызовСервера.БазовыйПакетВозможностейЧата();
	КонецПопытки;

КонецФункции

&НаСервереБезКонтекста
Процедура ОчиститьРезультатВозможностейНаСервере(Знач Адрес)

	УдалитьИзВременногоХранилища(Адрес);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтменитьВозможностиНаСервере(Знач Идентификатор)

	Попытка
		ДлительныеОперации.ОтменитьВыполнениеЗадания(Идентификатор);
	Исключение
		ЗаписьЖурналаРегистрации("ИИАссистент.ВозможностиЧата", УровеньЖурналаРегистрации.Предупреждение, , ,
			"CHAT_CAPABILITIES_CANCEL_ERROR");
	КонецПопытки;

КонецПроцедуры
#КонецОбласти
