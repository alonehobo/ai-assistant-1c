КонецФункции

&НаСервереБезКонтекста
Функция ПакетСообщения(Знач Роль, Знач Текст, Знач Предупреждение, Знач Таблицы, Знач Ссылки = Неопределено,
	Знач ДатаСообщения = Неопределено)

	Пакет = Новый Структура("type, role, text, warning, tables, objects, reports, charts, time",
		"append", Роль, Текст, Предупреждение, Новый Массив, Новый Массив, Новый Массив, Новый Массив,
		ВремяСообщения(?(ДатаСообщения = Неопределено, ТекущаяДатаСеанса(), ДатаСообщения)));
	Если Ссылки <> Неопределено Тогда
		Для Каждого Объект Из Ссылки.Объекты Цикл
			Если Объект.id <> Неопределено Тогда
				Пакет.objects.Добавить(Объект);
			КонецЕсли;
		КонецЦикла;
		// Синонимы объектов метаданных хода страница связывает со списками, как представления объектов.
		Для Каждого Объект Из ?(Ссылки.Свойство("Метаданные"), Ссылки.Метаданные, Новый Массив) Цикл
			Пакет.objects.Добавить(Объект);
		КонецЦикла;
		Пакет.reports = Ссылки.Отчеты;
	КонецЕсли;
	Если Таблицы <> Неопределено Тогда
		Для Каждого Таблица Из Таблицы Цикл
			// Индексы объектов хода -> идентификаторы ссылок диалога.
			Ячейки = Новый Массив;
			Если Ссылки <> Неопределено И Таблица.Свойство("ОбъектыЯчеек") Тогда
				Для Каждого ИндексыСтроки Из Таблица.ОбъектыЯчеек Цикл
					СтрокаСсылок = Новый Массив;
					Для Каждого Индекс Из ИндексыСтроки Цикл
						СтрокаСсылок.Добавить(?(Индекс = Неопределено, Неопределено, Ссылки.Объекты[Индекс].id));
					КонецЦикла;
					Ячейки.Добавить(СтрокаСсылок);
				КонецЦикла;
			КонецЕсли;
			// id - таблица в реестре ссылок для «Открыть в Excel».
			НомерТаблицы = Пакет.tables.Количество();
			Пакет.tables.Добавить(Новый Структура("title, columns, rows, links, id",
				Таблица.Заголовок, Таблица.Колонки, Таблица.Строки, Ячейки,
				?(Ссылки <> Неопределено И НомерТаблицы < Ссылки.Таблицы.Количество(), Ссылки.Таблицы[НомерТаблицы],
				Неопределено)));
		КонецЦикла;
	КонецЕсли;
	Возврат ОбщегоНазначения.ЗначениеВJSON(Пакет);

КонецФункции

// Время реплики для чата: за сегодня - только время, за другой день - дата и время.
&НаСервереБезКонтекста
Функция ВремяСообщения(ДатаСообщения)

	Если Не ЗначениеЗаполнено(ДатаСообщения) Тогда
		Возврат "";
	КонецЕсли;
	Если НачалоДня(ДатаСообщения) = НачалоДня(ТекущаяДатаСеанса()) Тогда
		Возврат Формат(ДатаСообщения, "ДФ=ЧЧ:мм");
	КонецЕсли;
	Возврат Формат(ДатаСообщения, "ДФ='дд.ММ.гггг ЧЧ:мм'");

КонецФункции

// Сохраняет объекты, отчёты, таблицы, источники-списки, черновики, формы и сохранённые варианты хода в реестре
// ссылок диалога. На страницу уходят только идентификаторы и тексты; навигационные ссылки, настройки отчётов и
// данные таблиц остаются в форме.
//
// Возвращаемое значение:
//  Структура - Объекты (id, text), Отчеты (id, title, details), Черновики, Изменения (карточки, см. КарточкаИзменения),
//              Формы, Таблицы (id по порядку таблиц хода),
//              Источники (n - номер сноски, 0 - «Также использовано»; kind, text, note, id - Неопределено, если
//              источник недоступен), Варианты (id, title, created), СсылкиТекста, Метаданные,
//              ФайлыОтвета (карточки файлов ответа make_file).
&НаСервере
Функция ЗарегистрироватьСсылкиХода(ХодАгента)

	Результат = Новый Структура("Объекты, Отчеты, Черновики, Изменения, Формы, Таблицы, Источники, Варианты, СсылкиТекста, Метаданные, ФайлыОтвета",
		Новый Массив, Новый Массив, Новый Массив, Новый Массив, Новый Массив, Новый Массив, Новый Массив, Новый Массив,
		Новый Массив, Новый Массив, Новый Массив);
	Реестр = ОбщегоНазначения.JSONВЗначение(СсылкиДиалога);
	Если ТипЗнч(Реестр) <> Тип("Массив") Тогда
		Реестр = Новый Массив;
	КонецЕсли;
	Для Каждого Объект Из ИИА_ФоновыйХод.СвойствоХода(ХодАгента, "Объекты") Цикл
		// Недоступный объект остаётся текстом: идентификатора в реестре у него нет.
		Если ПустаяСтрока(Объект.Ссылка) Тогда
			Результат.Объекты.Добавить(Новый Структура("id, text", Неопределено, Объект.Текст));
			Продолжить;
		КонецЕсли;
		Реестр.Добавить(Новый Структура("kind, link", "object", Объект.Ссылка));
		Результат.Объекты.Добавить(Новый Структура("id, text", Реестр.ВГраница(), Объект.Текст));
	КонецЦикла;
	Для Каждого Отчет Из ИИА_ФоновыйХод.СвойствоХода(ХодАгента, "Отчеты") Цикл
		Запись = Новый Структура("kind", "report");
		Для Каждого Свойство Из Отчет Цикл
			Запись.Вставить(Свойство.Ключ, Свойство.Значение);
		КонецЦикла;
		Реестр.Добавить(Запись);
		Результат.Отчеты.Добавить(Новый Структура("id, title, details", Реестр.ВГраница(), Отчет.Заголовок,
			ПодробностиОтчета(Отчет)));
	КонецЦикла;
	Для Каждого Таблица Из ИИА_ФоновыйХод.СвойствоХода(ХодАгента, "Таблицы") Цикл
		Реестр.Добавить(Новый Структура("kind, title, columns, rows", "table", Таблица.Заголовок, Таблица.Колонки,
			Таблица.Строки));
		Результат.Таблицы.Добавить(Реестр.ВГраница());
	КонецЦикла;
	Для Каждого Действие Из ИИА_ФоновыйХод.СвойствоХода(ХодАгента, "Действия") Цикл
		Если ИИА_ФоновыйХод.ЗначениеСвойства(Действие, "Вид") = "change" Тогда
			Карточка = КарточкаИзмененияДляСтраницы(Действие.Идентификатор, Реестр);
			Если Карточка <> Неопределено Тогда
				Результат.Изменения.Добавить(Карточка);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Реестр.Добавить(Новый Структура("kind, action", "draft", Действие.Идентификатор));
		Результат.Черновики.Добавить(Новый Структура("id, title, lines, warning", Реестр.ВГраница(),
			Действие.Заголовок, Действие.Строки, Действие.Предупреждение));
	КонецЦикла;
	Результат.Формы = ЗарегистрироватьФормы(ИИА_ФоновыйХод.СвойствоХода(ХодАгента, "Формы"), Реестр);
	Для Каждого Настроенный Из ИИА_ФоновыйХод.СвойствоХода(ХодАгента, "НастроенныеВарианты") Цикл
		Вариант = ИИА_ФоновыйХод.ЗначениеСвойства(Настроенный, "Вариант");
		Если ТипЗнч(Вариант) <> Тип("Строка") Тогда
			Продолжить;
		КонецЕсли;
		Реестр.Добавить(Новый Структура("kind, Вид, Вариант, ИмяОтчета, Заголовок", "report", "saved_variant", Вариант,
			Строка(ИИА_ФоновыйХод.ЗначениеСвойства(Настроенный, "ИмяОтчета")), Строка(ИИА_ФоновыйХод.ЗначениеСвойства(Настроенный, "Заголовок"))));
		Результат.Варианты.Добавить(Новый Структура("id, title, created", Реестр.ВГраница(),
			Строка(ИИА_ФоновыйХод.ЗначениеСвойства(Настроенный, "Заголовок")), ИИА_ФоновыйХод.ЗначениеСвойства(Настроенный, "Создан") = Истина));
	КонецЦикла;
	// Файлы ответа: в реестре - только номер сохранённой реплики и id файла, рецепт читается из вложений реплики
	// при сборке (ИИА_Файлы.РецептФайлаОтвета). Несохранённый ответ карточек файлов не получает.
	НомерОтвета = ИИА_ФоновыйХод.ЗначениеСвойства(ХодАгента, "НомерСообщения");
	НомерОтвета = ?(ТипЗнч(НомерОтвета) = Тип("Число"), НомерОтвета, 0);
	Для Каждого Рецепт Из ?(НомерОтвета > 0, ИИА_ФоновыйХод.СвойствоХода(ХодАгента, "ФайлыОтвета"), Новый Массив) Цикл
		Реестр.Добавить(Новый Структура("kind, message, file", "answer_file", НомерОтвета,
			Строка(ИИА_ФоновыйХод.ЗначениеСвойства(Рецепт, "id"))));
		Карточка = ИИА_Файлы.ОписаниеКарточки(Рецепт);
		Карточка.Вставить("id", Реестр.ВГраница());
		Карточка.Вставить("file", Строка(ИИА_ФоновыйХод.ЗначениеСвойства(Рецепт, "id")));
		Результат.ФайлыОтвета.Добавить(Карточка);
	КонецЦикла;
	Результат.Источники = ИсточникиДляСтраницы(ХодАгента, Результат, Реестр);
	ЗарегистрироватьСсылкиТекста(ХодАгента, Результат, Реестр);
	СсылкиДиалога = ОбщегоНазначения.ЗначениеВJSON(Реестр);
	Возврат Результат;

КонецФункции

// Ссылки текста ответа [текст](#k) и синонимы объектов метаданных хода в реестре ссылок диалога.
// Ссылки.СсылкиТекста - элемент k - 1: id (Неопределено - ссылка недоступна, показывается текст), kind.
// Ссылки.Метаданные - id, text: синонимы, которые страница делает ссылками на списки без разметки модели.
// Доступ к спискам проверяется при регистрации и повторно при открытии.
&НаСервереБезКонтекста
Процедура ЗарегистрироватьСсылкиТекста(ХодАгента, Ссылки, Реестр)

	Объекты = ИИА_ФоновыйХод.СвойствоХода(ХодАгента, "Объекты");
	Списки = Новый Соответствие;
	Для Каждого Ссылка Из ИИА_ФоновыйХод.СвойствоХода(ХодАгента, "СсылкиТекста") Цикл
		Вид = Строка(ИИА_ФоновыйХод.ЗначениеСвойства(Ссылка, "kind"));
		Индекс = ИИА_ФоновыйХод.ЗначениеСвойства(Ссылка, "ref");
		ЕстьОбъект = ТипЗнч(Индекс) = Тип("Число") И Индекс >= 0 И Индекс < Ссылки.Объекты.Количество();
		Если Вид = "object" И ЕстьОбъект Тогда
			Идентификатор = Ссылки.Объекты[Индекс].id;
		ИначеЕсли Вид = "metadata" Тогда
			Идентификатор = ИдентификаторСписка(Строка(ИИА_ФоновыйХод.ЗначениеСвойства(Ссылка, "name")), Списки, Реестр);
		ИначеЕсли Вид = "attribute"
			И Не ПустаяСтрока(ИИА_ЧатВызовСервера.СсылкаСпискаИсточника(ИИА_ФоновыйХод.ЗначениеСвойства(Ссылка, "name"))) Тогда
			Реестр.Добавить(Новый Структура("kind, table, field, link", "attribute", Строка(ИИА_ФоновыйХод.ЗначениеСвойства(Ссылка, "name")),
				Строка(ИИА_ФоновыйХод.ЗначениеСвойства(Ссылка, "field")), ?(ЕстьОбъект, Строка(Объекты[Индекс].Ссылка), "")));
			Идентификатор = Реестр.ВГраница();
		Иначе
			Идентификатор = Неопределено; // цель недоступна: страница покажет подпись текстом
		КонецЕсли;
		Ссылки.СсылкиТекста.Добавить(Новый Структура("id, kind", Идентификатор, Вид));
	КонецЦикла;
	Для Каждого Запись Из ИИА_ФоновыйХод.СвойствоХода(ХодАгента, "МетаданныеХода") Цикл
		Идентификатор = ИдентификаторСписка(Строка(ИИА_ФоновыйХод.ЗначениеСвойства(Запись, "name")), Списки, Реестр);
		Если Идентификатор <> Неопределено Тогда
			Ссылки.Метаданные.Добавить(Новый Структура("id, text", Идентификатор, Строка(ИИА_ФоновыйХод.ЗначениеСвойства(Запись, "text"))));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Идентификатор списка объекта метаданных в реестре (один на ответ); Неопределено - список недоступен.
&НаСервереБезКонтекста
Функция ИдентификаторСписка(ПолноеИмя, Списки, Реестр)

	Если Списки[ПолноеИмя] <> Неопределено Тогда
		Возврат Списки[ПолноеИмя];
	КонецЕсли;
	Если ПустаяСтрока(ИИА_ЧатВызовСервера.СсылкаСпискаИсточника(ПолноеИмя)) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Реестр.Добавить(Новый Структура("kind, table", "list", ПолноеИмя));
	Списки.Вставить(ПолноеИмя, Реестр.ВГраница());
	Возврат Реестр.ВГраница();

КонецФункции

// Источники ответа для страницы: сначала процитированные в порядке сносок [k], затем «Также использовано».
// Подпись и ссылка объекта и отчёта берутся из уже зарегистрированных (перепроверенных) Объекты и Отчеты; список
// таблицы-источника открывается, только если он в периметре и есть право просмотра.
&НаСервере
Функция ИсточникиДляСтраницы(ХодАгента, Ссылки, Реестр)

	ПоКлючу = Новый Соответствие;
	Для Каждого Источник Из ИИА_ФоновыйХод.СвойствоХода(ХодАгента, "Источники") Цикл
		ПоКлючу.Вставить(ИИА_ФоновыйХод.ЗначениеСвойства(Источник, "key"), Источник);
	КонецЦикла;
	Порядок = Новый Массив;
	Для Каждого Ключ Из ИИА_ФоновыйХод.СвойствоХода(ХодАгента, "Цитаты") Цикл
		Порядок.Добавить(Ключ);
	КонецЦикла;
	Для Каждого Источник Из ИИА_ФоновыйХод.СвойствоХода(ХодАгента, "Источники") Цикл
		Если Порядок.Найти(ИИА_ФоновыйХод.ЗначениеСвойства(Источник, "key")) = Неопределено Тогда
			Порядок.Добавить(ИИА_ФоновыйХод.ЗначениеСвойства(Источник, "key"));
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Массив;
	Цитат = ИИА_ФоновыйХод.СвойствоХода(ХодАгента, "Цитаты").Количество();
	Для Индекс = 0 По Порядок.ВГраница() Цикл
		Источник = ПоКлючу.Получить(Порядок[Индекс]);
		Если Источник = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Вид = ИИА_ФоновыйХод.ЗначениеСвойства(Источник, "kind");
		Номер = ИИА_ФоновыйХод.ЗначениеСвойства(Источник, "ref");
		Описание = Новый Структура("n, kind, text, note, id", ?(Индекс < Цитат, Индекс + 1, 0), Вид, "", "", Неопределено);
		Если Вид = "object" И ТипЗнч(Номер) = Тип("Число") И Номер >= 0 И Номер < Ссылки.Объекты.Количество() Тогда
			Описание.text = Ссылки.Объекты[Номер].text;
			Описание.id = Ссылки.Объекты[Номер].id;
		ИначеЕсли Вид = "report" И ТипЗнч(Номер) = Тип("Число") И Номер >= 0 И Номер < Ссылки.Отчеты.Количество() Тогда
			Описание.text = Ссылки.Отчеты[Номер].title;
			Описание.id = Ссылки.Отчеты[Номер].id;
			НеПрименено = ИИА_ФоновыйХод.ЗначениеСвойства(Реестр[Описание.id], "НеПрименено");
			Если ТипЗнч(НеПрименено) = Тип("Массив") И НеПрименено.Количество() > 0 Тогда
				Описание.note = ПодробностиОтчета(Реестр[Описание.id]);
			КонецЕсли;
		ИначеЕсли Вид = "list" Тогда
			Описание.text = Строка(ИИА_ФоновыйХод.ЗначениеСвойства(Источник, "text"));
			ПолноеИмя = Строка(ИИА_ФоновыйХод.ЗначениеСвойства(Источник, "table"));
			Если Не ПустаяСтрока(ИИА_ЧатВызовСервера.СсылкаСпискаИсточника(ПолноеИмя)) Тогда
				Реестр.Добавить(Новый Структура("kind, table", "list", ПолноеИмя));
				Описание.id = Реестр.ВГраница();
			КонецЕсли;
		Иначе
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Описание);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пояснение к ссылке на отчёт: период и то, что из настроек ассистента в ссылку не перенесено.
//  Отчет - Структура, Соответствие - запись отчёта хода (см. ИИА_Инструменты, свойство Отчет).
&НаСервереБезКонтекста
Функция ПодробностиОтчета(Отчет)

	Подробности = НСтр("ru = 'Источник: '") + Строка(ИИА_ФоновыйХод.ЗначениеСвойства(Отчет, "Заголовок"));
	НачалоПериода = ИИА_ФоновыйХод.ЗначениеСвойства(Отчет, "НачалоПериода");
	КонецПериода = ИИА_ФоновыйХод.ЗначениеСвойства(Отчет, "КонецПериода");
	Если ТипЗнч(НачалоПериода) = Тип("Дата") И ТипЗнч(КонецПериода) = Тип("Дата") Тогда
		Подробности = Подробности + СтрШаблон(НСтр("ru = '. Период: %1 - %2'"),
			Формат(НачалоПериода, "ДФ=dd.MM.yyyy"), Формат(КонецПериода, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	НеПрименено = ИИА_ФоновыйХод.ЗначениеСвойства(Отчет, "НеПрименено");
	Если ТипЗнч(НеПрименено) = Тип("Массив") И НеПрименено.Количество() > 0 Тогда
		Подробности = Подробности + СтрШаблон(НСтр("ru = '. Не применено: %1. Попросите ассистента сохранить настройку отчёта - он создаст ваш личный вариант.'"),
			СтрСоединить(НеПрименено, ", "));
	ИначеЕсли ТипЗнч(НеПрименено) = Тип("Массив") Или ИИА_ФоновыйХод.ЗначениеСвойства(Отчет, "Вид") = "saved_variant" Тогда
		Подробности = Подробности + НСтр("ru = '. Отчёт откроется с теми же настройками.'");
	Иначе
		Подробности = Подробности + НСтр("ru = '. Период, организацию и отборы можно проверить в штатном отчёте.'");
	КонецЕсли;
	Возврат Подробности;

КонецФункции

// Карточка черновика: открыть (подтверждение пользователем) или отклонить. Модель подтвердить не может.
&НаКлиенте
Процедура ОбработатьЧерновик(Идентификатор, Открыть)

	Описание = ОбработатьЧерновикНаСервере(Идентификатор, Открыть);
	ПередатьНаСтраницу(ПакетСтатусаНаСервере(Описание.Сообщение));
	Если Описание.Успех И Открыть Тогда
		ОткрытьФорму(Описание.ИмяФормы, Описание.ПараметрыФормы, , Новый УникальныйИдентификатор);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ОбработатьЧерновикНаСервере(Знач Идентификатор, Знач Открыть)

	Результат = Новый Структура("Успех, Сообщение, ИмяФормы, ПараметрыФормы", Ложь, "", "", Неопределено);
	Реестр = ОбщегоНазначения.JSONВЗначение(СсылкиДиалога);
	Индекс = -1;
	// Не номер карточки (подделанная ссылка страницы) - команда игнорируется.
	Если ПустаяСтрока(Идентификатор) Или Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Идентификатор) Тогда
		Возврат Результат;
	КонецЕсли;
	Индекс = Число(Идентификатор);
	Если ТипЗнч(Реестр) <> Тип("Массив") Или Индекс < 0 Или Индекс > Реестр.ВГраница()
		Или Реестр[Индекс].Получить("kind") <> "draft" Тогда
		Возврат Результат;
	КонецЕсли;
	ИдентификаторДействия = Строка(Реестр[Индекс].Получить("action"));
	Если Не Открыть Тогда
		ИИА_ЧатВызовСервера.ОтклонитьЧерновик(ИдентификаторДействия);
		Результат.Сообщение = НСтр("ru = 'Черновик отклонён.'");
		Возврат Результат;
	КонецЕсли;
	Подтверждение = ИИА_ЧатВызовСервера.ПодтвердитьЧерновик(ИдентификаторДействия);
	Если Не Подтверждение.Успех Тогда
		Результат.Сообщение = Подтверждение.Ошибка;
		Возврат Результат;
	КонецЕсли;
	Результат.Успех = Истина;
	Результат.Сообщение = НСтр("ru = 'Черновик открыт: проверьте и запишите документ.'");
	Результат.ИмяФормы = Подтверждение.ИмяФормы;
	Результат.ПараметрыФормы = Подтверждение.ПараметрыФормы;
	Возврат Результат;

КонецФункции

// Карточка изменения: «Выполнить» (запись выполняет пользователь) или «Отклонить». Модель выполнить не может.
&НаКлиенте
Процедура ОбработатьИзменение(Идентификатор, ЭтоВыполнение)

	Пакеты = ОбработатьИзменениеНаСервере(Идентификатор, ЭтоВыполнение);
	Для Каждого Пакет Из Пакеты Цикл
		ПередатьНаСтраницу(Пакет);
	КонецЦикла;

КонецПроцедуры

// Один серверный вызов: выполнение или отклонение предложения и обновлённая карточка со статусом.
//
// Возвращаемое значение:
//  Массив из Строка - пакеты статуса и карточки.
&НаСервере
Функция ОбработатьИзменениеНаСервере(Знач Идентификатор, Знач ЭтоВыполнение)

	Пакеты = Новый Массив;
	Реестр = ОбщегоНазначения.JSONВЗначение(СсылкиДиалога);
	Индекс = -1;
	// Не номер карточки (подделанная ссылка страницы) - команда игнорируется.
	Если ПустаяСтрока(Идентификатор) Или Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Идентификатор) Тогда
		Возврат Пакеты;
	КонецЕсли;
	Индекс = Число(Идентификатор);
	Если ТипЗнч(Реестр) <> Тип("Массив") Или Индекс < 0 Или Индекс > Реестр.ВГраница()
		Или Реестр[Индекс].Получить("kind") <> "change" Тогда
		Возврат Пакеты;
	КонецЕсли;
	ИдентификаторДействия = Строка(Реестр[Индекс].Получить("action"));
	Если ЭтоВыполнение Тогда
		Итог = ИИА_ЧатВызовСервера.ВыполнитьИзменение(ИдентификаторДействия);
		ТекстСтатуса = ?(Итог.Успех, НСтр("ru = 'Изменение записано.'"), Итог.Ошибка);
	Иначе
		Итог = ИИА_ЧатВызовСервера.ОтклонитьИзменение(ИдентификаторДействия);
		ТекстСтатуса = ?(Итог.Успех, НСтр("ru = 'Изменение отклонено.'"), Итог.Ошибка);
	КонецЕсли;
	Пакеты.Добавить(ПакетСтатуса(ТекстСтатуса));
	Карточка = ИИА_ЧатВызовСервера.КарточкаИзменения(ИдентификаторДействия, Диалог);
	Если Карточка <> Неопределено Тогда
		Карточка.Вставить("id", Индекс);
		Карточка.Вставить("objectId", Реестр[Индекс].Получить("object"));
		Карточка.Удалить("link");
		Если Не Итог.Успех И Карточка.status = "Ожидает" Тогда
			// Отказ без смены статуса (объект открыт в форме): причина видна в карточке, «Выполнить» можно повторить.
			Карточка.result = Итог.Ошибка;
		КонецЕсли;
		Пакеты.Добавить(ОбщегоНазначения.ЗначениеВJSON(Новый Структура("type, card", "change", Карточка)));
	Иначе
		// Предложение недоступно (удалено, чужое): кнопки карточки снимаются, причина - в статусе карточки.
		Пакеты.Добавить(ОбщегоНазначения.ЗначениеВJSON(Новый Структура("type, card", "change",
			Новый Структура("id, gone, result", Индекс, Истина, ?(ПустаяСтрока(Итог.Ошибка),
			НСтр("ru = 'Предложение недоступно.'"), Итог.Ошибка)))));
	КонецЕсли;
	Возврат Пакеты;

КонецФункции

// Регистрирует предложение изменения и его объект в реестре ссылок диалога; карточка строится из записи
// предложения с текущим статусом (значения раскрыты для пользователя). Неопределено - предложение недоступно.
&НаСервере
Функция КарточкаИзмененияДляСтраницы(ИдентификаторДействия, Реестр)

	Карточка = ИИА_ЧатВызовСервера.КарточкаИзменения(ИдентификаторДействия, Диалог);
	Если Карточка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИндексОбъекта = Неопределено;
	Если Не ПустаяСтрока(Карточка.link) Тогда
		Реестр.Добавить(Новый Структура("kind, link", "object", Карточка.link));
		ИндексОбъекта = Реестр.ВГраница();
	КонецЕсли;
	Реестр.Добавить(Новый Структура("kind, action, object", "change", ИдентификаторДействия, ИндексОбъекта));
	Карточка.Вставить("id", Реестр.ВГраница());
	Карточка.Вставить("objectId", ИндексОбъекта);
	Карточка.Удалить("link");
	Возврат Карточка;

КонецФункции

// Кнопки «Показать в форме»: открывают настоящую форму, переключают вкладки и отмечают шаги инструкции
// номером, цветом, подсказкой под элементом и сообщениями со ссылкой на поле. Оформление живёт только в этом окне.
//  Режим - "new" - новый объект, "pick" - объект, выбранный из списка, "cur" или пусто - объект из ответа (если есть).
&НаКлиенте
Процедура ПоказатьНаФорме(Идентификатор, Режим)

	Описание = ОписаниеПоказаНаФормеНаСервере(Идентификатор);
	Если Описание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Режим = "new" Тогда
		Описание.ПараметрыФормы.Удалить("Ключ");
	ИначеЕсли Режим = "pick" И Не ПустаяСтрока(Описание.ИмяФормыВыбора) Тогда
		ОткрытьФорму(Описание.ИмяФормыВыбора, Новый Структура("РежимВыбора", Истина), ЭтотОбъект, , , ,
			Новый ОписаниеОповещения("ПоказатьНаФормеПослеВыбора", ЭтотОбъект, Описание),
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		Возврат;
	КонецЕсли;
	ПодготовитьИОткрытьФорму(Описание);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьНаФормеПослеВыбора(Значение, Описание) Экспорт

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;
	Описание.ПараметрыФормы.Вставить("Ключ", Значение);
	ПодготовитьИОткрытьФорму(Описание);

КонецПроцедуры

&НаКлиенте
Процедура ПодготовитьИОткрытьФорму(Описание)

	ОткрытьИОтметитьФорму(Описание);

КонецПроцедуры

&НаКлиенте
Функция ЭлементИнструкции(Форма, Шаг)

	Элемент = Форма.Элементы.Найти(Шаг.element);
	Если ТипЗнч(Элемент) <> Тип("ГруппаФормы") Тогда
		Возврат Элемент;
	КонецЕсли;
	Если Элемент.Вид <> ВидГруппыФормы.КоманднаяПанель И Элемент.Вид <> ВидГруппыФормы.ГруппаКнопок Тогда
		Возврат Элемент;
	КонецЕсли;
	Кнопки = Новый Массив;
	НайтиКнопкиИнструкции(Элемент, НРег(СокрЛП(СтрЗаменить(Шаг.title, "&", ""))), Кнопки);
	Возврат ?(Кнопки.Количество() = 1, Кнопки[0], Неопределено);

КонецФункции

&НаКлиенте
Процедура НайтиКнопкиИнструкции(Группа, Заголовок, Кнопки)

	Для Каждого Элемент Из Группа.ПодчиненныеЭлементы Цикл
		Если ТипЗнч(Элемент) = Тип("КнопкаФормы") И Не ПустаяСтрока(Заголовок) Тогда
			Если НРег(СокрЛП(СтрЗаменить(Элемент.Заголовок, "&", ""))) = Заголовок Тогда
				Кнопки.Добавить(Элемент);
			КонецЕсли;
		ИначеЕсли ТипЗнч(Элемент) = Тип("ГруппаФормы") Тогда
			НайтиКнопкиИнструкции(Элемент, Заголовок, Кнопки);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Путь к данным для перехода из сообщения шага по открытой форме: поле или таблица шага, таблица кнопки её
// командной панели, первое поле или таблица внутри группы и вкладки.
// Возвращаемое значение:
//  Структура - Поле, ПутьТаблицы (см. ПолеСообщенияИнструкции).
&НаКлиенте
Функция ПривязкаСообщенияШага(Форма, Элемент)

	Привязка = Новый Структура("Поле, ПутьТаблицы", "", "");
	ЭлементДанных = ЭлементДанныхШага(Форма, Элемент);
	Если ЭлементДанных = Неопределено Тогда
		Возврат Привязка;
	КонецЕсли;
	Привязка.Поле = ПутьДанныхЭлемента(Форма, ЭлементДанных);
	Привязка.ПутьТаблицы = "";
	Если ТипЗнч(ЭлементДанных) = Тип("ПолеФормы") Тогда
		Таблица = ТаблицаЭлемента(ЭлементДанных);
		Если Таблица <> Неопределено Тогда
			Привязка.ПутьТаблицы = ПутьДанныхЭлемента(Форма, Таблица);
		КонецЕсли;
	КонецЕсли;
	Возврат Привязка;

КонецФункции

&НаКлиенте
Функция ЭлементДанныхШага(Форма, Элемент)

	Если (ТипЗнч(Элемент) = Тип("ПолеФормы") Или ТипЗнч(Элемент) = Тип("ТаблицаФормы"))
		И Не ПустаяСтрока(ПутьДанныхЭлемента(Форма, Элемент)) Тогда
		Возврат Элемент;
	КонецЕсли;
	Таблица = ТаблицаЭлемента(Элемент);
	Если Таблица <> Неопределено Тогда
		Возврат ?(ПустаяСтрока(ПутьДанныхЭлемента(Форма, Таблица)), Неопределено, Таблица);
	КонецЕсли;
	Если ТипЗнч(Элемент) = Тип("ГруппаФормы") И Элемент.Вид <> ВидГруппыФормы.КоманднаяПанель
		И Элемент.Вид <> ВидГруппыФормы.ГруппаКнопок И Элемент.Вид <> ВидГруппыФормы.Подменю Тогда
		Возврат ПервыйЭлементДанных(Форма, Элемент);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

&НаКлиенте
Функция ПервыйЭлементДанных(Форма, Группа)

	Для Каждого Подчиненный Из Группа.ПодчиненныеЭлементы Цикл
		Если Не Подчиненный.Видимость Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Подчиненный) = Тип("ПолеФормы") Или ТипЗнч(Подчиненный) = Тип("ТаблицаФормы") Тогда
			Если Не ПустаяСтрока(ПутьДанныхЭлемента(Форма, Подчиненный)) Тогда
				Возврат Подчиненный;
			КонецЕсли;
		ИначеЕсли ТипЗнч(Подчиненный) = Тип("ГруппаФормы") Тогда
			Найденный = ПервыйЭлементДанных(Форма, Подчиненный);
			Если Найденный <> Неопределено Тогда
				Возврат Найденный;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Таблица, в которой лежит элемент (колонка или кнопка её командной панели).
&НаКлиенте
Функция ТаблицаЭлемента(Элемент)

	Текущий = Элемент;
	Пока Истина Цикл
		Попытка
			Текущий = Текущий.Родитель;
		// У элемента нет родителя или он недоступен на клиенте: таблицы нет.
		Исключение // BSLLS:MissingCodeTryCatchEx-off
			Возврат Неопределено;
		КонецПопытки;
		Если ТипЗнч(Текущий) = Тип("ТаблицаФормы") Тогда
			Возврат Текущий;
		ИначеЕсли ТипЗнч(Текущий) <> Тип("ГруппаФормы") И ТипЗнч(Текущий) <> Тип("ПолеФормы") Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	// Цикл завершается только возвратом; явный возврат - для полноты путей функции.
	Возврат Неопределено;

КонецФункции

// Путь к данным поля или таблицы открытой формы. Тонкий клиент не отдаёт ПутьКДанным («Свойство недоступно»):
// тогда путь подбирается по имени элемента (Реквизит, ТЧ, ТЧРеквизит) и проверяется по данным формы.
&НаКлиенте
Функция ПутьДанныхЭлемента(Форма, Элемент)

	Попытка
		Возврат Строка(Элемент.ПутьКДанным);
	// Тонкий клиент не отдаёт ПутьКДанным: путь подбирается ниже.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Путь = "";
	КонецПопытки;
	Если ТипЗнч(Элемент) = Тип("ТаблицаФормы") Тогда
		Возврат ПутьДанныхПоИмени(Форма, Элемент.Имя);
	ИначеЕсли ТипЗнч(Элемент) <> Тип("ПолеФормы") Тогда
		Возврат Путь;
	КонецЕсли;
	Таблица = ТаблицаЭлемента(Элемент);
	Если Таблица = Неопределено Тогда
		Возврат ПутьДанныхПоИмени(Форма, Элемент.Имя);
	КонецЕсли;
	ПутьТаблицы = ПутьДанныхЭлемента(Форма, Таблица);
	Если ПустаяСтрока(ПутьТаблицы) Или СтрДлина(Элемент.Имя) <= СтрДлина(Таблица.Имя)
		Или Не СтрНачинаетсяС(Элемент.Имя, Таблица.Имя) Тогда
		Возврат Путь;
	КонецЕсли;
	Возврат ПутьТаблицы + "." + Сред(Элемент.Имя, СтрДлина(Таблица.Имя) + 1);

КонецФункции

&НаКлиенте
Функция ПутьДанныхПоИмени(Форма, Имя)

	Для Каждого Путь Из СтрРазделить("Объект." + Имя + "," + Имя, ",") Цикл
		Если ЕстьДанныеФормы(Форма, Путь) Тогда
			Возврат Путь;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

&НаКлиенте
Функция ЕстьДанныеФормы(Форма, Путь)

	Данные = Форма;
	Попытка
		Для Каждого ЧастьПути Из СтрРазделить(Путь, ".") Цикл
			Данные = Данные[ЧастьПути];
		КонецЦикла;
	// Реквизита с таким именем у формы нет.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;

КонецФункции

&НаКлиенте
Функция ПолеСообщенияИнструкции(Форма, Шаг)

	Если ПустаяСтрока(Шаг.ПутьТаблицы) Тогда
		Возврат Шаг.Поле;
	КонецЕсли;
	Если Не СтрНачинаетсяС(Шаг.Поле, Шаг.ПутьТаблицы + ".") Тогда
		Возврат Шаг.ПутьТаблицы;
	КонецЕсли;
	ДанныеТаблицы = Форма;
	Для Каждого ЧастьПути Из СтрРазделить(Шаг.ПутьТаблицы, ".") Цикл
		ДанныеТаблицы = ДанныеТаблицы[ЧастьПути];
	КонецЦикла;
	Если ТипЗнч(ДанныеТаблицы) = Тип("ДанныеФормыДерево") Тогда
		Если ДанныеТаблицы.Строки.Количество() = 0 Тогда
			Возврат Шаг.ПутьТаблицы;
		КонецЕсли;
		ПутьСтроки = Шаг.ПутьТаблицы + ".Строки[0]";
	ИначеЕсли ТипЗнч(ДанныеТаблицы) = Тип("ДанныеФормыКоллекция") Тогда
		Если ДанныеТаблицы.Количество() = 0 Тогда
			Возврат Шаг.ПутьТаблицы;
		КонецЕсли;
		ПутьСтроки = Шаг.ПутьТаблицы + "[0]";
	Иначе
		Возврат Шаг.ПутьТаблицы;
	КонецЕсли;
	Возврат ПутьСтроки + Сред(Шаг.Поле, СтрДлина(Шаг.ПутьТаблицы) + 1);

КонецФункции

&НаКлиенте
Процедура ОткрытьИОтметитьФорму(Описание)

	Попытка

		// Отдельное окно не закрывает чат; положение и размер окна платформа запоминает сама.
		Форма = ОткрытьФорму(Описание.ИмяФормы, Описание.ПараметрыФормы, , Новый УникальныйИдентификатор,
			ВариантОткрытияОкна.ОтдельноеОкно);
	// Причина показывается пользователю на странице чата.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		ПередатьНаСтраницу(ПакетСтатусаНаСервере(НСтр("ru = 'Форму открыть не удалось: возможно, нет прав.'")));
		Возврат;
	КонецПопытки;
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Форма.Активизировать();
	ПервыйШагНайден = Ложь;
	ЗаголовкиПодменю = Новый Соответствие; // имя отмеченного подменю -> заголовок до отметки
	Для Индекс = 0 По Описание.Шаги.ВГраница() Цикл
		Шаг = Описание.Шаги[Индекс];
		Номер = Формат(Индекс + 1, "ЧГ=") + ".";
		Элемент = ЭлементИнструкции(Форма, Шаг);
		ПутьМеню = "";
		Если Элемент <> Неопределено Тогда
			// Вкладка и фокус - только у первого найденного шага: иначе откроется вкладка последнего шага.
			Если Не ПервыйШагНайден Тогда
				ПервыйШагНайден = Истина;
				ПоказатьСтраницыЭлемента(Элемент);
				УстановитьФокусНаЭлемент(Форма, Элемент);
			КонецЕсли;
			// Подменю, отмеченное своим шагом, не получает номер второй раз от кнопок внутри.
			Если ТипЗнч(Элемент) = Тип("ГруппаФормы") И Элемент.Вид = ВидГруппыФормы.Подменю
				И ЗаголовкиПодменю.Получить(Элемент.Имя) = Неопределено Тогда
				ЗаголовкиПодменю.Вставить(Элемент.Имя, СтрЗаменить(Элемент.Заголовок, "&", ""));
				ОтметитьЭлемент(Элемент, Номер, Шаг);
			ИначеЕсли ТипЗнч(Элемент) <> Тип("ГруппаФормы") Или Элемент.Вид <> ВидГруппыФормы.Подменю Тогда
				ОтметитьЭлемент(Элемент, Номер, Шаг);
			КонецЕсли;
			// Кнопка в подменю видна только в раскрытом меню: номер шага получает и само подменю.
			Для Каждого Подменю Из ПодменюЭлемента(Элемент) Цикл
				ЗаголовокПодменю = ЗаголовкиПодменю.Получить(Подменю.Имя);
				Если ЗаголовокПодменю = Неопределено Тогда
					ЗаголовокПодменю = СтрЗаменить(Подменю.Заголовок, "&", "");
					ЗаголовкиПодменю.Вставить(Подменю.Имя, ЗаголовокПодменю);
					ОтметитьЭлемент(Подменю, Номер, Шаг);
				КонецЕсли;
				ПутьМеню = ПутьМеню + ?(ПустаяСтрока(ЗаголовокПодменю), "", ЗаголовокПодменю + " → ");
			КонецЦикла;
		КонецЕсли;
		// Адресат задан явно; полный путь относится к реквизитам именно этой формы.
		Сообщение = Новый СообщениеПользователю;
		Сообщение.ИдентификаторНазначения = Форма.УникальныйИдентификатор;
		Сообщение.Поле = ?(Элемент = Неопределено, "", ПолеСообщенияИнструкции(Форма, ПривязкаСообщенияШага(Форма, Элемент)));
		Сообщение.Текст = Номер + " " + ПутьМеню + Шаг.title + ?(ПустаяСтрока(Шаг.hint), "", " - " + Шаг.hint);
		Сообщение.Сообщить();
	КонецЦикла;

КонецПроцедуры

// Фокус на элементе шага, чтобы форма прокрутилась к нему (колонка таблицы - через текущий элемент таблицы).
// Кнопки и группы фокус не принимают.
&НаКлиенте
Функция УстановитьФокусНаЭлемент(Форма, Элемент)

	Попытка
		Родитель = Элемент.Родитель;
		Пока ТипЗнч(Родитель) = Тип("ГруппаФормы") Цикл
			Родитель = Родитель.Родитель;
		КонецЦикла;
		Если ТипЗнч(Элемент) = Тип("ПолеФормы") И ТипЗнч(Родитель) = Тип("ТаблицаФормы") Тогда
			Родитель.ТекущийЭлемент = Элемент;
			Форма.ТекущийЭлемент = Родитель;
		ИначеЕсли ТипЗнч(Элемент) = Тип("ПолеФормы") Или ТипЗнч(Элемент) = Тип("ТаблицаФормы") Тогда
			Форма.ТекущийЭлемент = Элемент;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	// Элемент нельзя сделать текущим на клиенте: отметка без активизации.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;

КонецФункции

// Подменю, в которых лежит элемент, от внешнего к внутреннему.
&НаКлиенте
Функция ПодменюЭлемента(Элемент)

	Подменю = Новый Массив;
	Текущий = Элемент;
	Пока Истина Цикл
		Попытка
			Текущий = Текущий.Родитель;
		// У элемента нет родителя или он недоступен на клиенте: обход завершён.
		Исключение // BSLLS:MissingCodeTryCatchEx-off
			Прервать;
		КонецПопытки;
		Если ТипЗнч(Текущий) <> Тип("ГруппаФормы") Тогда
			Прервать;
		КонецЕсли;
		Если Текущий.Вид = ВидГруппыФормы.Подменю Тогда
			Подменю.Вставить(0, Текущий);
		КонецЕсли;
	КонецЦикла;
	Возврат Подменю;

КонецФункции

// Делает видимыми страницы, на которых лежит элемент (переключает родительские вкладки).
&НаКлиенте
Процедура ПоказатьСтраницыЭлемента(Элемент)

	Текущий = Элемент;
	Пока Текущий <> Неопределено Цикл
		Родитель = Неопределено;
		Попытка
			Родитель = Текущий.Родитель;
		// У элемента нет родителя или он недоступен на клиенте: обход завершён.
		Исключение // BSLLS:MissingCodeTryCatchEx-off
			Прервать;
		КонецПопытки;
		Если ТипЗнч(Текущий) = Тип("ГруппаФормы") И ТипЗнч(Родитель) = Тип("ГруппаФормы") Тогда
			Попытка
				Если Родитель.Вид = ВидГруппыФормы.Страницы Тогда
					Родитель.ТекущаяСтраница = Текущий;
				КонецЕсли;
			// У части групп вида нет.
			Исключение // BSLLS:MissingCodeTryCatchEx-off
				// Страница не переключается.
			КонецПопытки;
		КонецЕсли;
		Если ТипЗнч(Родитель) <> Тип("ГруппаФормы") И ТипЗнч(Родитель) <> Тип("ТаблицаФормы") Тогда
			Прервать;
		КонецЕсли;
		Текущий = Родитель;
	КонецЦикла;

КонецПроцедуры

// Отметка шага на форме по виду элемента. Повторное нажатие не добавляет номер второй раз.
//  Вкладки и группы - номер и красный жирный заголовок, без заливки (иначе заливается вся область);
//  кнопки и поля - номер, жёлтый фон, жирный шрифт, подсказка под элементом;
//  таблицы - видимый заголовок с номером, красная рамка и подсказка под таблицей.
// Свойства, которые платформа не даёт менять у вида элемента, пропускаются.
&НаКлиенте
Процедура ОтметитьЭлемент(Элемент, Номер, Шаг)

	Если ТипЗнч(Элемент) = Тип("ГруппаФормы")
		И (Элемент.Вид = ВидГруппыФормы.КоманднаяПанель Или Элемент.Вид = ВидГруппыФормы.ГруппаКнопок) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ЗаголовокЭлемента = Элемент.Заголовок;
	// У элемента нет заголовка или он недоступен на клиенте.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		ЗаголовокЭлемента = "";
	КонецПопытки;
	Если СтрНачинаетсяС(ЗаголовокЭлемента, Номер) Тогда
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(ЗаголовокЭлемента) Тогда
		ЗаголовокЭлемента = Шаг.title;
	КонецЕсли;
	УстановитьСвойствоОтметки(Элемент, "Заголовок", Номер + " " + ЗаголовокЭлемента);
	ЭтоГруппа = ТипЗнч(Элемент) = Тип("ГруппаФормы");
	ЭтоТаблица = ТипЗнч(Элемент) = Тип("ТаблицаФормы");
	Если ЭтоГруппа И Элемент.Вид = ВидГруппыФормы.Подменю Тогда
		// Подменю выглядит кнопкой - отмечается как кнопка, подсказка шага остаётся у кнопки внутри меню.
		УстановитьСвойствоОтметки(Элемент, "ЦветФона", WebЦвета.Желтый);
		УстановитьСвойствоОтметки(Элемент, "ЦветТекста", WebЦвета.Красный);
		УстановитьСвойствоОтметки(Элемент, "Шрифт", Новый Шрифт(, , Истина));
		УстановитьСвойствоОтметки(Элемент, "Отображение", ОтображениеКнопки.КартинкаИТекст);
		Возврат;
	ИначеЕсли ЭтоГруппа Тогда
		УстановитьСвойствоОтметки(Элемент, "ЦветТекстаЗаголовка", WebЦвета.Красный);
		УстановитьСвойствоОтметки(Элемент, "ШрифтЗаголовка", Новый Шрифт(, , Истина));
		Возврат;
	КонецЕсли;
	Если ЭтоТаблица Тогда
		УстановитьСвойствоОтметки(Элемент, "ПоложениеЗаголовка", ПоложениеЗаголовкаЭлементаФормы.Верх);
		УстановитьСвойствоОтметки(Элемент, "ЦветРамки", WebЦвета.Красный);
	Иначе
		УстановитьСвойствоОтметки(Элемент, "ЦветФона", WebЦвета.Желтый);
		УстановитьСвойствоОтметки(Элемент, "Шрифт", Новый Шрифт(, , Истина));
	КонецЕсли;
	Если ТипЗнч(Элемент) = Тип("КнопкаФормы") Тогда
		УстановитьСвойствоОтметки(Элемент, "ЦветТекста", WebЦвета.Красный);
	Иначе
		УстановитьСвойствоОтметки(Элемент, "ЦветТекстаЗаголовка", WebЦвета.Красный);
	КонецЕсли;
	УстановитьСвойствоОтметки(Элемент, "ШрифтЗаголовка", Новый Шрифт(, , Истина));
	Если Не ПустаяСтрока(Шаг.hint) Тогда
		УстановитьСвойствоОтметки(Элемент, "Подсказка", Номер + " " + Шаг.hint);
		УстановитьСвойствоОтметки(Элемент, "ОтображениеПодсказки", ОтображениеПодсказки.ОтображатьСнизу);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьСвойствоОтметки(Элемент, Свойство, Значение)

	Попытка
		Элемент[Свойство] = Значение;
	// Свойство недоступно для этого вида элемента на клиенте - отметка без него.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат;
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция ОписаниеПоказаНаФормеНаСервере(Знач Идентификатор)

	Реестр = ОбщегоНазначения.JSONВЗначение(СсылкиДиалога);
	Если ПустаяСтрока(Идентификатор) Или Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Идентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Индекс = Число(Идентификатор);
	Если ТипЗнч(Реестр) <> Тип("Массив") Или Индекс < 0 Или Индекс > Реестр.ВГраница()
		Или Реестр[Индекс].Получить("kind") <> "form" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запись = Реестр[Индекс];
	ПараметрыФормы = Новый Структура;
	ДанныеXML = Строка(Запись.Получить("data"));
	Если Не ПустаяСтрока(ДанныеXML) Тогда
		Попытка
			ПараметрыФормы.Вставить("Ключ", ОбщегоНазначения.ЗначениеИзСтрокиXML(ДанныеXML));
		// Повреждённый ключ записи: форма открывается без ключа.
		Исключение // BSLLS:MissingCodeTryCatchEx-off
			ПараметрыФормы = Новый Структура;
		КонецПопытки;
	КонецЕсли;
	Шаги = Новый Массив;
	СписокШагов = Запись.Получить("steps");
	Если ТипЗнч(СписокШагов) = Тип("Массив") Тогда
		Для Каждого Шаг Из СписокШагов Цикл
			Шаги.Добавить(Новый Структура("element, title, hint", Строка(Шаг.Получить("element")),
				Строка(Шаг.Получить("title")), Строка(Шаг.Получить("hint"))));
		КонецЦикла;
	КонецЕсли;
	Если Шаги.Количество() = 0 И Не ПустаяСтрока(Строка(Запись.Получить("element"))) Тогда
		Шаги.Добавить(Новый Структура("element, title, hint", Строка(Запись.Получить("element")), "", ""));
	КонецЕсли;
	ПолноеИмяФормы = Строка(Запись.Получить("form"));
	Возврат Новый Структура("ИмяФормы, ПараметрыФормы, Шаги, ИмяФормыВыбора", ПолноеИмяФормы, ПараметрыФормы, Шаги,
		ИмяФормыВыбораОбъекта(ПолноеИмяФормы));

КонецФункции

// Форма выбора объекта, которому принадлежит форма (для кнопки «Выбрать из списка»); пусто - не ссылочный объект.
&НаСервереБезКонтекста
Функция ИмяФормыВыбораОбъекта(ПолноеИмяФормы)

	Части = СтрРазделить(ПолноеИмяФормы, ".", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Части[0] + "." + Части[1]);
	Если ОбъектМетаданных = Неопределено Или Не ОбщегоНазначения.ЭтоОбъектСсылочногоТипа(ОбъектМетаданных)
		Или Не ПравоДоступа("Просмотр", ОбъектМетаданных) Тогда
		Возврат "";
	КонецЕсли;
	Возврат ОбъектМетаданных.ПолноеИмя() + ".ФормаВыбора";

КонецФункции

// Файл ответа (make_file): сборка по рецепту на сервере и «Сохранить» или «Открыть» средствами БСП.
&НаКлиенте
Процедура ОбработатьФайлОтвета(Идентификатор, Открыть)

	Файл = ФайлОтветаНаСервере(ЦелоеКоманды(Идентификатор));
	Если ПустаяСтрока(Файл.Адрес) Тогда
		ПередатьНаСтраницу(ПакетСтатусаНаСервере(Файл.Ошибка));
		Возврат;
	КонецЕсли;
	Если Открыть Тогда
		ФайловаяСистемаКлиент.ОткрытьФайл(Файл.Адрес, , Файл.ИмяФайла);
	Иначе
		ФайловаяСистемаКлиент.СохранитьФайл(Неопределено, Файл.Адрес, Файл.ИмяФайла);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ФайлОтветаНаСервере(Знач Идентификатор)

	Реестр = ОбщегоНазначения.JSONВЗначение(СсылкиДиалога);
	Если ТипЗнч(Реестр) <> Тип("Массив") Или Идентификатор < 0 Или Идентификатор > Реестр.ВГраница()
		Или Реестр[Идентификатор].Получить("kind") <> "answer_file" Тогда
		Возврат Новый Структура("Адрес, ИмяФайла, Ошибка", "", "", НСтр("ru = 'Файл не найден в ответе.'"));
	КонецЕсли;
	Найденный = ИИА_Файлы.РецептФайлаОтвета(Диалог, Реестр[Идентификатор].Получить("message"),
		Реестр[Идентификатор].Получить("file"));
	Если Найденный = Неопределено Тогда
		Возврат Новый Структура("Адрес, ИмяФайла, Ошибка", "", "", НСтр("ru = 'Файл не найден в ответе.'"));
	КонецЕсли;
	Возврат ИИА_Файлы.СобратьФайлОтвета(Найденный.Рецепт, Диалог, УникальныйИдентификатор, Найденный.КлассДанных);

КонецФункции

// «Файл из базы»: присоединённые файлы объекта-контекста и объектов из ссылок в поле ввода, выбор отметкой.
// Выбранные файлы регистрируются в реестре ссылок (kind base_file), страница получает только id, имя и размер.
&НаКлиенте
Асинх Процедура ВыбратьФайлыБазы()

	ТекстВвода = "";
	Попытка
		Запрос = Элементы.ЧатHTML.Документ.getElementById("iia-request");
		ТекстВвода = Строка(Запрос.getAttribute("data-bfile-text"));
		Запрос.removeAttribute("data-bfile-text");
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		// Страница недоступна: файлы предлагаются только по объекту-контексту.
		ТекстВвода = "";
	КонецПопытки;
	Список = ФайлыБазыНаСервере(ТекстВвода);
	Если Список.Количество() = 0 Тогда
		ПоказатьПодсказкуНаСтранице(НСтр("ru = 'У объекта нет присоединённых файлов, доступных ассистенту.'"));
		Возврат;
	КонецЕсли;
	Отмеченные = Ждать Список.ОтметитьЭлементыАсинх(НСтр("ru = 'Файлы из базы'"));
	Если Отмеченные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Ссылки = Новый Массив;
	Для Каждого Элемент Из Отмеченные Цикл
		Если Элемент.Пометка Тогда
			Ссылки.Добавить(Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Пакет Из ЗарегистрироватьФайлыБазыНаСервере(Ссылки) Цикл
		Попытка
			Элементы.ЧатHTML.Документ.defaultView.iiaAddBaseFile(Пакет.id, Пакет.name, Пакет.size);
		Исключение
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не удалось передать файл в чат.'"));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ФайлыБазыНаСервере(Знач ТекстВвода)

	Владельцы = Новый Массив;
	Если Не ПустаяСтрока(КонтекстXML) Тогда
		Владельцы.Добавить(ОбщегоНазначения.ЗначениеИзСтрокиXML(КонтекстXML));
	КонецЕсли;
	Если СтрНайти(ТекстВвода, "e1cib/data/") > 0 Тогда
		Для Каждого Объект Из ИИА_Инструменты.РазобратьНавигационныеСсылки(Лев(ТекстВвода, 8000)).Объекты Цикл
			Если Объект.Значение <> Неопределено И Владельцы.Найти(Объект.Значение) = Неопределено
				И Не ИИА_Файлы.ЭтоПрисоединенныйФайл(Объект.Значение) Тогда
				Владельцы.Добавить(Объект.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Список = Новый СписокЗначений;
	Для Каждого Файл Из ИИА_Файлы.ФайлыОбъектов(Владельцы) Цикл
		Список.Добавить(ПолучитьНавигационнуюСсылку(Файл.Ссылка), СтрШаблон("%1 (%2 КБ) - %3", Файл.Имя,
			Формат(Окр(Файл.Размер / 1024), "ЧН=0; ЧГ="), Файл.Владелец));
	КонецЦикла;
	Возврат Список;

КонецФункции

// Регистрирует выбранные файлы базы (повторно проверяя доступ) и возвращает описания для страницы.
&НаСервере
Функция ЗарегистрироватьФайлыБазыНаСервере(Знач Ссылки)

	Результат = Новый Массив;
	Реестр = ОбщегоНазначения.JSONВЗначение(СсылкиДиалога);
	Если ТипЗнч(Реестр) <> Тип("Массив") Тогда
		Реестр = Новый Массив;
	КонецЕсли;
	Для Каждого НавигационнаяСсылка Из Ссылки Цикл
		Ссылка = ИИА_Инструменты.СсылкаПоНавигационнойСсылке(НавигационнаяСсылка);
		Если Ссылка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Владельцы = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВладелецФайла(Ссылка));
		Для Каждого Файл Из ИИА_Файлы.ФайлыОбъектов(Владельцы) Цикл
			Если Файл.Ссылка = Ссылка Тогда
				// Повторный выбор того же файла получает прежний id реестра: страница отсеивает повтор по id.
				Индекс = ИндексФайлаБазыВРеестре(Реестр, НавигационнаяСсылка);
				Если Индекс < 0 Тогда
					Реестр.Добавить(Новый Структура("kind, link", "base_file", НавигационнаяСсылка));
					Индекс = Реестр.ВГраница();
				КонецЕсли;
				Результат.Добавить(Новый Структура("id, name, size", Индекс, Файл.Имя, Файл.Размер));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	СсылкиДиалога = ОбщегоНазначения.ЗначениеВJSON(Реестр);
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ИндексФайлаБазыВРеестре(Реестр, НавигационнаяСсылка)

	Для Индекс = 0 По Реестр.ВГраница() Цикл
		Запись = Реестр[Индекс];
		Если ТипЗнч(Запись) = Тип("Соответствие") И Запись.Получить("kind") = "base_file"
			И Запись.Получить("link") = НавигационнаяСсылка Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;
	Возврат -1;

КонецФункции

&НаСервереБезКонтекста
Функция ВладелецФайла(Ссылка)

	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ВладелецФайла", Истина);

КонецФункции

// Файл вопроса из истории диалога: сохраняется на диск пользователя.
&НаКлиенте
Процедура СохранитьФайлДиалога(Идентификатор)

	Описание = ФайлДиалогаНаСервере(Идентификатор);
	Если Описание = Неопределено Тогда
		ПередатьНаСтраницу(ПакетСтатусаНаСервере(НСтр("ru = 'Файл не сохранён в истории диалога.'")));
		Возврат;
	КонецЕсли;
	ФайловаяСистемаКлиент.СохранитьФайл(Неопределено, Описание.Адрес, Описание.Имя);

КонецПроцедуры

&НаСервере
Функция ФайлДиалогаНаСервере(Знач Идентификатор)

	Реестр = ОбщегоНазначения.JSONВЗначение(СсылкиДиалога);
	Если ПустаяСтрока(Идентификатор) Или Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Идентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Индекс = Число(Идентификатор);
	Если ТипЗнч(Реестр) <> Тип("Массив") Или Индекс < 0 Или Индекс > Реестр.ВГраница()
		Или Реестр[Индекс].Получить("kind") <> "file" Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИндексФайла = Реестр[Индекс].Получить("index");
	Файлы = ИИА_ЧатВызовСервера.ФайлыСообщения(Диалог, Реестр[Индекс].Получить("message"));
	Если ТипЗнч(ИндексФайла) <> Тип("Число") Или ИндексФайла < 0 Или ИндексФайла > Файлы.ВГраница() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Файл = Файлы[ИндексФайла];
	Возврат Новый Структура("Адрес, Имя", ПоместитьВоВременноеХранилище(Файл.ДвоичныеДанные, УникальныйИдентификатор),
		Файл.Имя);

КонецФункции

&НаКлиенте
Процедура ОткрытьСсылкуДиалога(Идентификатор)

	Описание = ОписаниеОткрытияНаСервере(Идентификатор);
	Если Описание.Вид = "" Тогда
		Если Не ПустаяСтрока(Описание.Причина) Тогда
			ПередатьНаСтраницу(ПакетСтатусаНаСервере(Описание.Причина));
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если Описание.Вид = "object" Или Описание.Вид = "list" Тогда
		ПерейтиПоНавигационнойСсылке(Описание.Ссылка);
	ИначеЕсли Описание.Вид = "attribute" Тогда
		ОткрытьРеквизитНаФорме(Описание);
	ИначеЕсли Описание.Вид = "saved_variant" Тогда
		ВариантыОтчетовКлиент.ОткрытьФормуОтчета(ЭтотОбъект, Описание.Вариант, Описание.ПараметрыФормы);
	Иначе
		ОткрытьФорму(Описание.ИмяФормы, Описание.ПараметрыФормы, , Новый УникальныйИдентификатор);
		Если Не ПустаяСтрока(Описание.НеПрименено) Тогда
			ПередатьНаСтраницу(ПакетСтатусаНаСервере(СтрШаблон(
				НСтр("ru = 'Не применено: %1. Попросите ассистента сохранить настройку отчёта.'"), Описание.НеПрименено)));
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Как открыть запись реестра ссылок диалога. Доступ к отчёту и списку перепроверяется при каждом открытии.
//
// Возвращаемое значение:
//  Структура - Вид ("object", "list" - Ссылка; "report" - ИмяФормы, ПараметрыФормы, НеПрименено; "saved_variant" -
//              Вариант, ПараметрыФормы; пусто - не открывается, Причина - почему).
&НаСервере
Функция ОписаниеОткрытияНаСервере(Знач Идентификатор)

	Результат = Новый Структура("Вид, Причина", "", "");
	Реестр = ОбщегоНазначения.JSONВЗначение(СсылкиДиалога);
	Индекс = 0;
	Если ПустаяСтрока(Идентификатор) Или Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Идентификатор) Тогда
		Возврат Результат;
	КонецЕсли;
	Индекс = Число(Идентификатор);
	Если ТипЗнч(Реестр) <> Тип("Массив") Или Индекс < 0 Или Индекс > Реестр.ВГраница() Тогда
		Возврат Результат;
	КонецЕсли;
	Запись = Реестр[Индекс];
	Вид = Запись.Получить("kind");
	Если Вид = "object" Тогда
		Ссылка = Строка(Запись.Получить("link"));
		Если СтрНачинаетсяС(Ссылка, "e1cib/data/") Тогда
			Возврат Новый Структура("Вид, Ссылка", Вид, Ссылка);
		КонецЕсли;
	ИначеЕсли Вид = "list" Тогда
		Ссылка = ИИА_ЧатВызовСервера.СсылкаСпискаИсточника(Запись.Получить("table"), Результат.Причина);
		Если Не ПустаяСтрока(Ссылка) Тогда
			Возврат Новый Структура("Вид, Ссылка", Вид, Ссылка);
		КонецЕсли;
	ИначеЕсли Вид = "report" Тогда
		Описание = ИИА_ЧатВызовСервера.ОписаниеОткрытияОтчета(Запись, Результат.Причина);
		Если Описание <> Неопределено Тогда
			Возврат Описание;
		КонецЕсли;
	ИначеЕсли Вид = "attribute" Тогда
		Описание = ОписаниеОткрытияРеквизита(Запись, Результат.Причина);
		Если Описание <> Неопределено Тогда
			Возврат Описание;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Как показать реквизит из ссылки ответа: форма объекта и поле. Доступ перепроверяется.
//
// Возвращаемое значение:
//  Структура - Вид ("attribute"), ИмяФормы, ПараметрыФормы (Ключ - если объект известен), Поле (Реквизит, ТЧ.Реквизит),
//              ИмяФормыВыбора (пусто - выбрать объект нельзя); Неопределено - реквизит недоступен, Причина - почему.
&НаСервереБезКонтекста
Функция ОписаниеОткрытияРеквизита(Запись, Причина)

	ПолноеИмя = Строка(Запись.Получить("table"));
	Поле = Строка(Запись.Получить("field"));
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Или ПустаяСтрока(Поле)
		Или ПустаяСтрока(ИИА_ЧатВызовСервера.СсылкаСпискаИсточника(ПолноеИмя, Причина))
		Или Не ОбщегоНазначения.ЭтоОбъектСсылочногоТипа(ОбъектМетаданных)
		Или ИИА_Периметр.ПолеЗапрещено(ПолноеИмя, Поле, Причина) Тогда
		Если ПустаяСтрока(Причина) Тогда
			Причина = НСтр("ru = 'Реквизит больше недоступен.'");
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	ПараметрыФормы = Новый Структура;
	Ссылка = ИИА_Инструменты.СсылкаПоНавигационнойСсылке(Строка(Запись.Получить("link")));
	Если ЗначениеЗаполнено(Ссылка) И ТипЗнч(Ссылка) = Тип(СтрЗаменить(ПолноеИмя, ".", "Ссылка.")) Тогда
		ПараметрыФормы.Вставить("Ключ", Ссылка);
	КонецЕсли;
	Возврат Новый Структура("Вид, ИмяФормы, ПараметрыФормы, Поле, ИмяФормыВыбора", "attribute",
		ОбъектМетаданных.ПолноеИмя() + ".ФормаОбъекта", ПараметрыФормы, Поле,
		ОбъектМетаданных.ПолноеИмя() + ".ФормаВыбора");

КонецФункции

// Ссылка ответа на реквизит: форма объекта с активным полем. Объект не известен - сначала выбор из списка.
&НаКлиенте
Процедура ОткрытьРеквизитНаФорме(Описание)

	Если Описание.ПараметрыФормы.Свойство("Ключ") Тогда
		ОткрытьФормуСПолем(Описание);
		Возврат;
	КонецЕсли;
	ОткрытьФорму(Описание.ИмяФормыВыбора, Новый Структура("РежимВыбора", Истина), ЭтотОбъект, , , ,
		Новый ОписаниеОповещения("ОткрытьРеквизитПослеВыбора", ЭтотОбъект, Описание),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРеквизитПослеВыбора(Значение, Описание) Экспорт

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;
	Описание.ПараметрыФормы.Вставить("Ключ", Значение);
	ОткрытьФормуСПолем(Описание);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуСПолем(Описание)

	Попытка
		Форма = ОткрытьФорму(Описание.ИмяФормы, Описание.ПараметрыФормы, , Новый УникальныйИдентификатор,
			ВариантОткрытияОкна.ОтдельноеОкно);
	// Причина отказа (права, удалённый объект) показывается пользователю в чате.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		ПередатьНаСтраницу(ПакетСтатусаНаСервере(НСтр("ru = 'Форму открыть не удалось: возможно, нет прав.'")));
		Возврат;
	КонецПопытки;
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Форма.Активизировать();
	Элемент = ЭлементПоля(Форма, Описание.Поле);
	Если Элемент = Неопределено Тогда
		ПередатьНаСтраницу(ПакетСтатусаНаСервере(НСтр("ru = 'Это поле на форме не выведено.'")));
		Возврат;
	КонецЕсли;
	ПоказатьСтраницыЭлемента(Элемент);
	УстановитьФокусНаЭлемент(Форма, Элемент);

КонецПроцедуры

// Поле формы реквизита по имени элемента: ПутьКДанным в тонком клиенте недоступен. Типовые формы называют поле
// как реквизит (Артикул), колонку табличной части - ТЧРеквизит (ТоварыКоличество); иначе - поле с тем же окончанием.
&НаКлиенте
Функция ЭлементПоля(Форма, Поле)

	Части = СтрРазделить(Поле, ".");
	Реквизит = Части[Части.ВГраница()];
	Элемент = Форма.Элементы.Найти(СтрСоединить(Части, ""));
	Если Элемент = Неопределено Тогда
		Элемент = Форма.Элементы.Найти(Реквизит);
	КонецЕсли;
	Если ТипЗнч(Элемент) = Тип("ПолеФормы") Тогда
		Возврат Элемент;
	КонецЕсли;
	Для Каждого Элемент Из Форма.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ПолеФормы") И СтрЗаканчиваетсяНа(НРег(Элемент.Имя), НРег(Реквизит)) Тогда
			Возврат Элемент;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

&НаСервере
Функция ИсторияКакМассив()

	Возврат ИИА_Обслуживание.ИсторияИзJSON(ИсторияДиалога);

КонецФункции

// ВместоПоследнего - заменить последний ответ ассистента (перегенерация, продолжение).
&НаСервере
Процедура ДобавитьВИсторию(Роль, Текст, КлассДанных, ВместоПоследнего = Ложь)

	Записи = ОбщегоНазначения.JSONВЗначение(ИсторияДиалога);
	Если ТипЗнч(Записи) <> Тип("Массив") Тогда
		Записи = Новый Массив;
	КонецЕсли;
	Если ВместоПоследнего И Записи.Количество() > 0 И Записи[Записи.ВГраница()].Получить("role") = Роль Тогда
		Записи.Удалить(Записи.ВГраница());
	КонецЕсли;
	Записи.Добавить(Новый Структура("role, text, class", Роль, Текст,
		ИИА_КлассыДанных.ПодтвержденныйКласс(КлассДанных)));
	ИсторияДиалога = ОбщегоНазначения.ЗначениеВJSON(Записи);

КонецПроцедуры

// Ctrl+V на странице, когда картинку из буфера окно 1С странице не передало: пометка data-paste.
&НаКлиенте
Процедура ОбработатьЗапросВставки()

	Попытка
		Запрос = Элементы.ЧатHTML.Документ.getElementById("iia-request");
		Если Строка(Запрос.getAttribute("data-paste")) <> "1" Тогда
			Возврат; // уже обработано (нажатием ссылки или проверкой по таймеру)
		КонецЕсли;
		Запрос.removeAttribute("data-paste");
	// Страница ещё не готова: вставка обработается следующей проверкой.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат;
	КонецПопытки;
	ВставитьСкриншотИзБуфера(Истина);

КонецПроцедуры

// Кнопка буфера обмена у поля ввода: картинка из буфера средствами платформы.
// Тихо - вызов по Ctrl+V: в буфере может быть текст, тогда подсказку не показываем.
&НаКлиенте
Асинх Процедура ВставитьСкриншотИзБуфера(Тихо = Ложь)

	Если Не СредстваБуфераОбмена.ИспользованиеДоступно() Тогда
		ПоказатьПодсказкуНаСтранице(НСтр("ru = 'Буфер обмена недоступен в этом клиенте - перетащите файл картинки в чат.'"));
		Возврат;
	КонецЕсли;
	Попытка
		Данные = Ждать СредстваБуфераОбмена.ПолучитьДанныеАсинх(СтандартныйФорматДанныхБуфераОбмена.Картинка);
	// Буфер обмена не прочитан: обрабатывается ниже как отсутствие картинки.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Данные = Неопределено;
	КонецПопытки;
	Если ТипЗнч(Данные) = Тип("Картинка") Тогда
		ПередатьКартинкуНаСтраницу(Данные);
	ИначеЕсли ТипЗнч(Данные) = Тип("ДвоичныеДанные") Тогда
		ПередатьКартинкуНаСтраницу(Новый Картинка(Данные));
	ИначеЕсли Не Тихо Тогда
		ПоказатьПодсказкуНаСтранице(НСтр("ru = 'В буфере обмена нет картинки. Сделайте снимок (Win+Shift+S) и нажмите кнопку ещё раз.'"));
	КонецЕсли;

КонецПроцедуры

// Скрепка у поля ввода: выбор файлов. Текстовые файлы и Excel - если файлы разрешены (уходят модели текстом,
// флажок модели не нужен); PDF - если ещё и модель принимает документы; картинки - если модель принимает изображения.
&НаКлиенте
Асинх Процедура ВыбратьФайлы()

	МожноКартинки = РазрешеныИзображения И ЕстьМодельДляИзображений;
	МожноPDF = РазрешеныФайлы И ЕстьМодельДляДокументов;
	Если Не МожноКартинки И Не РазрешеныФайлы Тогда
		ПоказатьПодсказкуНаСтранице(НСтр("ru = 'Файлы и картинки в вопросах недоступны: их отключил администратор или выбранная модель их не принимает.'"));
		Возврат;
	КонецЕсли;
	МаскаКартинок = "*.png;*.jpg;*.jpeg;*.gif;*.bmp;*.webp";
	МаскаДокументов = "*.txt;*.md;*.csv;*.json;*.xml;*.log;*.xlsx;*.xls" + ?(МожноPDF, ";*.pdf", "");
	Фильтры = Новый Массив;
	Если МожноКартинки И РазрешеныФайлы Тогда
		Фильтры.Добавить(НСтр("ru = 'Картинки и документы'") + "|" + МаскаКартинок + ";" + МаскаДокументов);
	КонецЕсли;
	Если РазрешеныФайлы Тогда
		Фильтры.Добавить(?(МожноPDF, НСтр("ru = 'Документы (PDF, текст, Excel)'"), НСтр("ru = 'Документы (текст, Excel)'"))
			+ "|" + МаскаДокументов);
	КонецЕсли;
	Если МожноКартинки Тогда
		Фильтры.Добавить(НСтр("ru = 'Картинки'") + "|" + МаскаКартинок);
	КонецЕсли;
	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = ?(РазрешеныФайлы, НСтр("ru = 'Выберите файлы'"), НСтр("ru = 'Выберите картинки'"));
	ПараметрыДиалога.Фильтр = СтрСоединить(Фильтры, "|");
	ПараметрыДиалога.МножественныйВыбор = Истина;
	Попытка
		Помещенные = Ждать ПоместитьФайлыНаСерверАсинх(, , ПараметрыДиалога, УникальныйИдентификатор);
	// Причина показывается пользователю на странице чата.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		ПоказатьПодсказкуНаСтранице(НСтр("ru = 'Не удалось загрузить файл. Перетащите картинку в чат.'"));
		Возврат;
	КонецПопытки;
	Если ТипЗнч(Помещенные) <> Тип("Массив") Тогда
		Возврат; // выбор отменён
	КонецЕсли;

	Файлы = Новый Массив;
	Для Каждого Описание Из Помещенные Цикл
		Если Не Описание.ПомещениеФайлаОтменено Тогда
			Файлы.Добавить(Новый Структура("Адрес, Имя, Расширение", Описание.Адрес, Описание.СсылкаНаФайл.Имя,
				Описание.СсылкаНаФайл.Расширение));
		КонецЕсли;
	КонецЦикла;
	Для Каждого Файл Из ФайлыНаСервере(Файлы, МожноКартинки, РазрешеныФайлы, МожноPDF) Цикл
		Если Файл.Вид = "image" Тогда
			ПередатьАдресКартинкиНаСтраницу(Файл.Адрес);
		ИначеЕсли Файл.Вид = "doc" Тогда
			ПередатьДокументНаСтраницу(Файл.Имя, Файл.Адрес);
		Иначе
			ПоказатьПодсказкуНаСтранице(Файл.Адрес);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Выбранные файлы из временного хранилища как data URL: Вид "image", "doc" или "error" (Адрес - текст ошибки).
&НаСервереБезКонтекста
Функция ФайлыНаСервере(Знач Файлы, Знач МожноКартинки, Знач МожноТекст, Знач МожноPDF)

	ТипыДокументов = Новый Соответствие;
	ТипыДокументов.Вставить("pdf", "application/pdf");
	ТипыДокументов.Вставить("xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
	ТипыДокументов.Вставить("xls", "application/vnd.ms-excel");
	Результат = Новый Массив;
	Картинки = Новый Массив;
	Для Каждого Файл Из Файлы Цикл
		Расширение = НРег(СтрЗаменить(Файл.Расширение, ".", ""));
		Если МожноТекст И ИИА_Файлы.ТекстовыеРасширения().Найти(Расширение) <> Неопределено
			Или МожноPDF И Расширение = "pdf" Тогда
			Данные = ПолучитьИзВременногоХранилища(Файл.Адрес);
			УдалитьИзВременногоХранилища(Файл.Адрес);
			Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
				Продолжить;
			ИначеЕсли Данные.Размер() > ИИА_Файлы.МаксимумРазмераФайла() Тогда
				Результат.Добавить(Новый Структура("Вид, Имя, Адрес", "error", Файл.Имя,
					СтрШаблон(НСтр("ru = 'Файл «%1» больше 10 МБ - не приложен.'"), Файл.Имя)));
				Продолжить;
			КонецЕсли;
			ТипФайла = ТипыДокументов.Получить(Расширение);
			Результат.Добавить(Новый Структура("Вид, Имя, Адрес", "doc", Файл.Имя,
				АдресКартинки(?(ТипФайла = Неопределено, "text/plain", ТипФайла), Данные)));
		ИначеЕсли МожноКартинки Тогда
			Картинки.Добавить(Файл);
		Иначе
			УдалитьИзВременногоХранилища(Файл.Адрес);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Адрес Из КартинкиФайловНаСервере(Картинки) Цикл
		Результат.Добавить(Новый Структура("Вид, Имя, Адрес", "image", "", Адрес));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Картинки из временного хранилища как data URL; файлы не-картинки пропускаются.
&НаСервереБезКонтекста
Функция КартинкиФайловНаСервере(Файлы)

	ТипыКартинок = Новый Соответствие;
	ТипыКартинок.Вставить("png", "image/png");
	ТипыКартинок.Вставить("jpg", "image/jpeg");
	ТипыКартинок.Вставить("jpeg", "image/jpeg");
	ТипыКартинок.Вставить("gif", "image/gif");
	ТипыКартинок.Вставить("bmp", "image/bmp");
	ТипыКартинок.Вставить("webp", "image/webp");

	Результат = Новый Массив;
	Для Каждого Файл Из Файлы Цикл
		Данные = ПолучитьИзВременногоХранилища(Файл.Адрес);
		УдалитьИзВременногоХранилища(Файл.Адрес);
		ТипКартинки = ТипыКартинок.Получить(НРег(СтрЗаменить(Файл.Расширение, ".", "")));
		Если ТипКартинки = Неопределено Или ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(АдресКартинки(ТипКартинки, Данные));
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция АдресКартинки(ТипКартинки, ДвоичныеДанные)

	Возврат "data:" + ТипКартинки + ";base64,"
		+ СтрЗаменить(СтрЗаменить(Base64Строка(ДвоичныеДанные), Символы.ВК, ""), Символы.ПС, "");

КонецФункции

&НаКлиенте
Процедура ПередатьАдресКартинкиНаСтраницу(Адрес)

	Попытка
		Элементы.ЧатHTML.Документ.defaultView.iiaAddImage(Адрес);
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не удалось передать картинку в чат.'"));
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПередатьДокументНаСтраницу(Имя, Адрес)

	Попытка
		Элементы.ЧатHTML.Документ.defaultView.iiaAddDoc(Имя, Адрес);
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не удалось передать файл в чат.'"));
	КонецПопытки;

КонецПроцедуры

// Выбор модели в списке над полем ввода: страница ставит пометку data-model и нажимает #iia/model
// (если нажатие до 1С не дойдёт, пометку подберёт периодическая проверка формы).
&НаКлиенте
Процедура ОбработатьВыборМодели()

	Попытка
		Запрос = Элементы.ЧатHTML.Документ.getElementById("iia-request");
		Если Не Запрос.hasAttribute("data-model") Тогда
			Возврат;
		КонецЕсли;
		Идентификатор = Строка(Запрос.getAttribute("data-model"));
		Запрос.removeAttribute("data-model");
	// Страница ещё не готова: выбор модели обработается следующей проверкой.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат;
	КонецПопытки;
	ИнвалидироватьВозможностиЧата();
	ПередатьНаСтраницу(ВыбратьМодельНаСервере(Идентификатор));
	ВозможностиТребуютЗагрузки = Истина;
	ЗагрузитьВозможностиВФоне();

КонецПроцедуры

&НаСервере
Функция ВыбратьМодельНаСервере(Знач Идентификатор)

	ИИА_ЧатВызовСервера.ВыбратьМодель(Идентификатор);
	НастройкиВводаJSON = ПакетНастроекВвода();
	Возврат НастройкиВводаJSON;

КонецФункции

// Настройки поля ввода для страницы: модели для выбора и что можно приложить к сообщению.
&НаСервере
Функция ПакетНастроекВвода()

	ЕстьМодельДляИзображений = РазрешеныИзображения И ИИА_ЧатВызовСервера.ЕстьМодельДляИзображений();
	ЕстьМодельДляДокументов = ИИА_ЧатВызовСервера.ЕстьМодельДляДокументов();
	Модели = ИИА_ЧатВызовСервера.МоделиЧата();
	// docs - PDF (нужна модель с документами); textDocs - текстовые файлы и Excel (уходят текстом любой модели);
	// baseFiles - кнопка «Файл из базы» (подсистема БСП «Работа с файлами»), context - чат открыт из объекта.
	РазрешеныФайлы = ИИА_Файлы.ФайлыРазрешены();
	Пакет = Новый Структура("type, maxImages, images, imageModel, docs, maxDocs, models, model, sidebar", "config",
		МаксимумИзображений, РазрешеныИзображения, ЕстьМодельДляИзображений, РазрешеныФайлы И ЕстьМодельДляДокументов,
		ИИА_Файлы.МаксимумФайлов(), Модели.Модели, Модели.Выбрана,
		ИИА_ЧатВызовСервера.ПанельИсторииОткрыта());
	Пакет.Вставить("textDocs", РазрешеныФайлы);
	Пакет.Вставить("baseFiles", РазрешеныФайлы И ИИА_Файлы.ФайлыБазыДоступны());
	Пакет.Вставить("context", Не ПустаяСтрока(КонтекстXML));
	Возврат ОбщегоНазначения.ЗначениеВJSON(Пакет);

КонецФункции

&НаКлиенте
Процедура ПередатьКартинкуНаСтраницу(Картинка)

	ДвоичныеДанные = Картинка.ПолучитьДвоичныеДанные();
	Если ДвоичныеДанные = Неопределено Или ДвоичныеДанные.Размер() = 0 Тогда
		ПоказатьПодсказкуНаСтранице(НСтр("ru = 'Не удалось прочитать картинку из буфера обмена.'"));
		Возврат;
	КонецЕсли;
	Формат = Картинка.Формат();
	Если Формат = ФорматКартинки.JPEG Тогда
		ТипКартинки = "image/jpeg";
	ИначеЕсли Формат = ФорматКартинки.BMP Тогда
		ТипКартинки = "image/bmp";
	ИначеЕсли Формат = ФорматКартинки.GIF Тогда
		ТипКартинки = "image/gif";
	Иначе
		ТипКартинки = "image/png";
	КонецЕсли;
	ПередатьАдресКартинкиНаСтраницу(АдресКартинки(ТипКартинки, ДвоичныеДанные));

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПодсказкуНаСтранице(Текст)

	Попытка
		Элементы.ЧатHTML.Документ.defaultView.iiaHint(Текст);
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю(Текст);
	КонецПопытки;

КонецПроцедуры

