#Область ОписаниеПеременных

&НаКлиенте
Перем ОчередьПакетов; // Массив из Строка - пакеты для страницы, пока она не загрузилась.

&НаКлиенте
Перем ИдентификаторЗапросаВозможностей; // UUID текущей загрузки; пусто после отмены или приёма.
&НаКлиенте
Перем ОперацияВозможностей; // Единственная собственная операция БСП для подсказок.
&НаКлиенте
Перем БазовыеВозможности; // Общий capabilities-пакет без подтверждённых примеров.
&НаКлиенте
Перем ВозможностиТребуютЗагрузки; // Явная перезагрузка; снимается до запуска, не восстанавливается при ошибке.
&НаКлиенте
Перем СтруктурыФорм; // Соответствие - полное имя формы -> структура для form_layout (ИИА_ЧатКлиент.СтруктураФормы),
                     // построенная за время работы чата: повторно форма не создаётся.
&НаКлиенте
Перем ОпросПодключен; // Булево - обработчик опроса хода (ОпроситьХод) подключён.
&НаКлиенте
Перем АктивныйХодПользователя; // Строка - идентификатор активного хода пользователя по последнему опросу.
&НаКлиенте
Перем МоментСтопа; // Число - момент нажатия «Стоп» (мс, UTC); 0 - остановка не запрошена. Через 10 с - отмена задания.
&НаКлиенте
Перем ТестовыеФайлы; // Массив из Структура - name, url: файлы тестового ввода (/C ИИАТест), уходят с «Отправить».
#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЧатHTML = ИИА_ЧатВызовСервера.ТекстСтраницыЧата();
	ИсторияДиалога = "[]";
	СсылкиДиалога = "[]";
	РазрешеныИзображения = ИИА_ЧатВызовСервера.ИзображенияРазрешены();
	РазрешеныФайлы = ИИА_Файлы.ФайлыРазрешены();
	МаксимумИзображений = ИИА_ЧатВызовСервера.МаксимумИзображений();
	НастройкиВводаJSON = ПакетНастроекВвода();
	ВозможностиЧатаJSON = ПакетВозможностейНаСервере();
	ПакетДиалоговJSON = ПакетДиалогов("");
	Элементы.ФормаТокенAPI.Видимость = ИИА_ЧатВызовСервера.ВнешнийДоступРазрешен();

	// Открытие из объекта (подключаемая команда «Спросить ИИ»): объект - контекст диалога.
	Контекст = Неопределено;
	Параметры.Свойство("Контекст", Контекст);
	УстановитьКонтекст(Контекст);

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Ввод средствами 1С нужен только автотестам (TestClient не работает с HTML-страницей): клиент
	// запускается с параметром /C ИИАТест.
	Элементы.ГруппаТестовыйВвод.Видимость = ТестовыйРежим();
	БазовыеВозможности = ЭтотОбъект.ВозможностиЧатаJSON;
	ВозможностиТребуютЗагрузки = Истина;
	ПередатьНаСтраницу(НастройкиВводаJSON);
	ПередатьНаСтраницу(ВозможностиЧатаJSON);
	ПередатьНаСтраницу(ПакетДиалоговJSON);
	Если Не ПустаяСтрока(КонтекстТекст) Тогда
		ПередатьНаСтраницу(ПакетКонтекста(КонтекстТекст));
	ИначеЕсли Не ПустаяСтрока(ОшибкаКонтекста) Тогда
		ПередатьНаСтраницу(ПакетСообщения("error", ОшибкаКонтекста, "", Неопределено));
	КонецЕсли;

	ЗагрузитьВозможностиВФоне();
	// Агенты на этом компьютере: мост поднимается, пока пользователь пишет вопрос.
	ИИА_МостACPКлиент.ЗапуститьМостыЧатаАсинх();
	// Ход мог идти без окна: живой ход, ждущие сообщения и готовые ответы показываются при открытии.
	ОпроситьХод();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	ВозможностиТребуютЗагрузки = Ложь;
	ИнвалидироватьВозможностиЧата();

	// Закрытие окна ход не останавливает: ход продолжается без клиента и сам сохраняет ответ в диалог.
	Если ЕстьАктивныйХод И Не ЗавершениеРаботы Тогда
		ОтсоединитьОкноНаСервере();
	КонецЕсли;

КонецПроцедуры

// Ctrl+V с картинкой окно 1С обрабатывает само и до HTML-поля её не передаёт - забираем картинку здесь.
&НаКлиенте
Процедура ПриВставкеИзБуфераОбмена(Значение, СтандартнаяОбработка)

	Если ТипЗнч(Значение) = Тип("Картинка") Тогда
		СтандартнаяОбработка = Ложь;
		ПередатьКартинкуНаСтраницу(Значение);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЧатHTMLДокументСформирован(Элемент)

	СтраницаГотова = Истина;
	ПодключитьОбработчикОжидания("ПроверитьИсходящееСообщение", 1); // повторяющийся обработчик - не чаще раза в секунду
	Если ОчередьПакетов <> Неопределено Тогда
		Для Каждого Пакет Из ОчередьПакетов Цикл
			ПередатьНаСтраницу(Пакет);
		КонецЦикла;
		ОчередьПакетов = Неопределено;
	КонецЕсли;

	ЗагрузитьВозможностиВФоне();

КонецПроцедуры

// Мост JS -> 1С: только ссылки вида #iia/<команда>/... из белого списка. Любая другая навигация блокируется.
&НаКлиенте
Процедура ЧатHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Href = "";
	Попытка
		Href = Строка(ДанныеСобытия.Href);
	// У события нет адреса ссылки: навигация не выполняется.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Href = "";
	КонецПопытки;
	Если ПустаяСтрока(Href) Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	ВыполнитьКомандуСтраницы(Href);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Диспетчер команд страницы: только ссылки вида #iia/<команда>/... из белого списка, идентификаторы - целые
// неотрицательные числа. Любая другая навигация и неизвестные команды игнорируются. Общий для нажатий на странице
// и тестовой команды формы.
&НаКлиенте
Процедура ВыполнитьКомандуСтраницы(Href)

	Позиция = СтрНайти(Href, "#iia/");
	Если Позиция = 0 Тогда
		Возврат; // внешние ссылки не открываем
	КонецЕсли;

	Части = СтрРазделить(Сред(Href, Позиция + 5), "/", Ложь);
	Если Части.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Аргумент = ?(Части.Количество() >= 2, Части[1], "");
	Если Части.Количество() < 2 Или Не ВыполненаКомандаСАргументом(Части) Тогда
		ВыполнитьКомандуБезАргумента(Части[0], Аргумент);
	КонецЕсли;
	// copy и сворачивание панели обрабатываются на странице; остальные команды игнорируются.

КонецПроцедуры

// Команды страницы с идентификатором: #iia/<команда>/<аргумент>[/<третья часть>]. Ложь - команда не из их числа.
&НаКлиенте
Функция ВыполненаКомандаСАргументом(Части)

	Команда = Части[0];
	Аргумент = Части[1];
	Третья = ?(Части.Количество() >= 3, Части[2], Неопределено);
	Если Команда = "feedback" Тогда
		ЗаписатьОтзывНаСервере(?(Аргумент = "up", "up", "down"), ?(Третья = Неопределено, 0, ЦелоеКоманды(Третья)));
		ПередатьНаСтраницу(ПакетСтатусаНаСервере(НСтр("ru = 'Спасибо, отзыв записан.'")));
	ИначеЕсли Команда = "regen" Или Команда = "continue" Тогда
		ЗаменитьОтвет(ЦелоеКоманды(Аргумент), Команда = "continue");
	ИначеЕсли Команда = "excel" Тогда
		ОткрытьФайлExcel(ФайлExcelНаСервере(ЦелоеКоманды(Аргумент)));
	ИначеЕсли Команда = "hist" И Третья <> Неопределено Тогда
		ВыполнитьДействиеИстории(Аргумент, ЦелоеКоманды(Третья));
	ИначеЕсли Команда = "open" Тогда
		ОткрытьСсылкуДиалога(Аргумент);
	ИначеЕсли Команда = "download" Тогда
		СохранитьФайлДиалога(Аргумент);
	ИначеЕсли Команда = "afile" И Третья <> Неопределено Тогда
		ОбработатьФайлОтвета(Аргумент, Третья = "open");
	ИначеЕсли Команда = "draft" И Третья <> Неопределено Тогда
		ОбработатьЧерновик(Аргумент, Третья = "open");
	ИначеЕсли Команда = "change" И (Третья = "exec" Или Третья = "reject") Тогда
		ОбработатьИзменение(Аргумент, Третья = "exec");
	ИначеЕсли Команда = "live" Тогда
		ПоказатьНаФорме(Аргумент, ?(Третья = Неопределено, "", Третья));
	ИначеЕсли (Команда = "unqueue" Или Команда = "sendqueued")
		И СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(Аргумент) Тогда
		ВыполнитьКомандуОчереди(Команда, Аргумент);
	Иначе
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура ВыполнитьКомандуБезАргумента(Команда, Аргумент)

	Если Команда = "cmd" Тогда
		ОбработатьКомандуДанных();
	ИначеЕсли Команда = "test" И Аргумент = "packets" И ТестовыйРежим() Тогда
		Для Каждого Пакет Из ЭталонныеПакеты() Цикл
			ПередатьНаСтраницу(Пакет);
		КонецЦикла;
	ИначеЕсли Команда = "send" Тогда
		ОтправитьСообщениеСтраницы();
	ИначеЕсли Команда = "new" Тогда
		НовыйДиалог(Неопределено);
	ИначеЕсли Команда = "stop" Тогда
		ОстановитьХод();
	ИначеЕсли Команда = "paste" Тогда
		Если Аргумент = "auto" Тогда
			ОбработатьЗапросВставки();
		Иначе
			ВставитьСкриншотИзБуфера();
		КонецЕсли;
	ИначеЕсли Команда = "file" Тогда
		ВыбратьФайлы();
	ИначеЕсли Команда = "bfile" Тогда
		ВыбратьФайлыБазы();
	ИначеЕсли Команда = "model" Тогда
		ОбработатьВыборМодели();
	КонецЕсли;

КонецПроцедуры

// Целое неотрицательное из части команды страницы; -1 - не целое.
&НаКлиенте
Функция ЦелоеКоманды(Текст)

	Если ПустаяСтрока(Текст) Или СтрДлина(Текст) > 9 Или Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Текст) Тогда
		Возврат -1;
	КонецЕсли;
	Возврат Число(Текст);

КонецФункции

&НаКлиенте
Функция ТестовыйРежим()

	Возврат СтрНайти(ПараметрЗапуска, "ИИАТест") > 0;

КонецФункции

// Сообщение со страницы: JS кладёт JSON {text, images} в скрытое поле iia-outbox перед переходом по #iia/send.
&НаКлиенте
Процедура ОтправитьСообщениеСтраницы()

	ДанныеСообщения = "";
	Попытка
		Почта = Элементы.ЧатHTML.Документ.getElementById("iia-outbox");
		Если Строка(Почта.getAttribute("data-pending")) <> "1" Тогда
			Возврат; // уже забрано (нажатием или проверкой по таймеру)
		КонецЕсли;
		Почта.setAttribute("data-pending", "0");
		ДанныеСообщения = Строка(Почта.value);
	// Страница ещё не готова: сообщение не забирается.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		ДанныеСообщения = "";
	КонецПопытки;
	ОтправитьДанныеСообщения(ДанныеСообщения);

КонецПроцедуры

// Проверка исходящего сообщения страницы: Enter в HTML-поле не всегда доходит до 1С событием ПриНажатии.
&НаКлиенте
Процедура ПроверитьИсходящееСообщение() Экспорт

	Если Не СтраницаГотова Тогда
		Возврат;
	КонецЕсли;
	// Во время хода сообщение не блокируется: оно встаёт в очередь (см. ЗапуститьХодНаСервере).
	ОтправитьСообщениеСтраницы();
	ОбработатьЗапросВставки();
	ОбработатьВыборМодели();
	ОбработатьКомандуДанных();
	// Запрос страницы на библиотеку (например, mermaid для схем) - передаём текст библиотеки один раз.
	Попытка
		Запрос = Элементы.ЧатHTML.Документ.getElementById("iia-request");
		ИмяБиблиотеки = Строка(Запрос.getAttribute("data-lib"));
	// Страница ещё не готова: запрос библиотеки обработает следующая проверка.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат;
	КонецПопытки;
	Если ИмяБиблиотеки = "mermaid" Тогда
		Запрос.removeAttribute("data-lib");
		Элементы.ЧатHTML.Документ.defaultView.iiaLoadLib(ИмяБиблиотеки, ТекстБиблиотекиНаСервере(ИмяБиблиотеки));
	КонецЕсли;

КонецПроцедуры

// Временный ввод средствами 1С: TestClient не умеет нажимать внутри HTML-поля.
&НаКлиенте
Процедура Отправить(Команда)

	Если ПустаяСтрока(Вопрос) Тогда
		Возврат;
	КонецЕсли;
	Файлы = ?(ТестовыеФайлы = Неопределено, Новый Массив, ТестовыеФайлы);
	Если ОтправитьДанныеСообщения(СообщениеВJSON(Вопрос, Файлы)) Тогда
		Вопрос = "";
		ТестовыеФайлы = Новый Массив;
	КонецЕсли;

КонецПроцедуры

// Ввод для автотестов: «Показать на форме» для последней формы из ответов (кнопки страницы TestClient не нажимает).
&НаКлиенте
Процедура ПоказатьНаФормеТест(Команда)

	Индекс = ПоследняяФормаДиалога();
	Если Индекс < 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'В ответах нет формы для показа.'"));
		Возврат;
	КонецЕсли;
	ПоказатьНаФорме(Формат(Индекс, "ЧН=0; ЧГ="), "");

КонецПроцедуры

// Ввод для автотестов: команда страницы (#iia/... или JSON data-cmd) из поля КомандаСтраницыТест.
&НаКлиенте
Процедура ВыполнитьКомандуСтраницыТест(Команда)

	Текст = СокрЛП(КомандаСтраницыТест);
	Если СтрНачинаетсяС(Текст, "file:") И ТестовыйРежим() Тогда
		ДобавитьТестовыйФайл(Сред(Текст, 6));
	ИначеЕсли СтрНачинаетсяС(Текст, "{") Тогда
		ВыполнитьКомандуДанных(Текст);
	Иначе
		ВыполнитьКомандуСтраницы(Текст);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПоследняяФормаДиалога()

	Реестр = ОбщегоНазначения.JSONВЗначение(СсылкиДиалога);
	Если ТипЗнч(Реестр) <> Тип("Массив") Тогда
		Возврат -1;
	КонецЕсли;
	Для Индекс = -Реестр.ВГраница() По 0 Цикл
		Если Реестр[-Индекс].Получить("kind") = "form" Тогда
			Возврат -Индекс;
		КонецЕсли;
	КонецЦикла;
	Возврат -1;

КонецФункции

&НаКлиенте
Процедура Стоп(Команда)

	ОстановитьХод();

КонецПроцедуры

&НаСервереБезКонтекста
Функция СообщениеВJSON(Знач Текст, Знач Файлы = Неопределено)

	Возврат ОбщегоНазначения.ЗначениеВJSON(Новый Структура("text, images, docs", Текст, Новый Массив,
		?(Файлы = Неопределено, Новый Массив, Файлы)));

КонецФункции

// Есть ли в сообщении страницы приложения (изображения, файлы, файлы базы) - без чтения самих файлов.
&НаСервереБезКонтекста
Функция ЕстьВложенияСтраницы(Знач ДанныеСообщения)

	Попытка
		Данные = ОбщегоНазначения.JSONВЗначение(ДанныеСообщения);
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		// Некорректный JSON отклонит РазобратьСообщениеСтраницы с понятной ошибкой.
		Возврат Ложь;
	КонецПопытки;
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Ключ Из СтрРазделить("images,docs,bfiles", ",") Цикл
		Значение = Данные.Получить(Ключ);
		Если ТипЗнч(Значение) = Тип("Массив") И Значение.Количество() > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Тестовый ввод файла (TestClient не управляет системным диалогом выбора файла): «file:<имя>:<base64>» в поле
// КомандаСтраницыТест. Файл уходит со следующим «Отправить» тем же путём, что файл со скрепки.
&НаКлиенте
Процедура ДобавитьТестовыйФайл(Знач Описание)

	Позиция = СтрНайти(Описание, ":");
	Если Позиция < 2 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Формат: file:<имя>:<base64>.'"));
		Возврат;
	КонецЕсли;
	Если ТестовыеФайлы = Неопределено Тогда
		ТестовыеФайлы = Новый Массив;
	КонецЕсли;
	ТестовыеФайлы.Добавить(Новый Структура("name, url", Лев(Описание, Позиция - 1),
		"data:application/octet-stream;base64," + Сред(Описание, Позиция + 1)));
	ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Тестовый файл добавлен: %1.'"),
		Лев(Описание, Позиция - 1)));

КонецПроцедуры

&НаКлиенте
Функция ОтправитьДанныеСообщения(ДанныеСообщения)

	Если ПустаяСтрока(ДанныеСообщения) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат НачатьОжиданиеХода(ЗапуститьХодНаСервере(ДанныеСообщения, СтруктурыФормХода()));

КонецФункции

// Перегенерация последнего ответа или продолжение оборванного: ход без новой реплики пользователя, старый ответ
// заменяется только после успешного нового (см. ИИА_ФоновыйХод.ЗавершитьХодДиалога).
&НаКлиенте
Процедура ЗаменитьОтвет(НомерОтвета, ЭтоПродолжение)

	Если ЕстьАктивныйХод Тогда
		ПередатьНаСтраницу(ПакетСтатусаНаСервере(НСтр("ru = 'Дождитесь ответа или нажмите Стоп.'")));
		Возврат;
	КонецЕсли;
	Если НомерОтвета > 0 Тогда
		НачатьОжиданиеХода(ЗапуститьЗаменуОтветаНаСервере(НомерОтвета, ЭтоПродолжение, СтруктурыФормХода()));
	КонецЕсли;

КонецПроцедуры

// Показывает пакеты запуска; ход запущен или сообщение встало в очередь - начинается опрос хода.
&НаКлиенте
Функция НачатьОжиданиеХода(Запуск)

	Для Каждого Пакет Из Запуск.Пакеты Цикл
		ПередатьНаСтраницу(Пакет);
	КонецЦикла;
	Если Не Запуск.Запущено Тогда
		Возврат Ложь;
	КонецЕсли;

	ОбновитьДоступность();
	ПодключитьОпросХода();
	Возврат Истина;

КонецФункции

// Первая фаза «Стоп» - флаг остановки хода; если ход не остановится за 10 с, опрос отменит его задание.
&НаКлиенте
Процедура ОстановитьХод()

	Если Не ЕстьАктивныйХод Или ПустаяСтрока(АктивныйХодПользователя) Тогда
		Возврат;
	КонецЕсли;
	ОтменитьХодНаСервере(АктивныйХодПользователя, Ложь);
	МоментСтопа = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ПередатьНаСтраницу(ПакетСтатусаНаСервере(НСтр("ru = 'Останавливаю'")));
	ПодключитьОпросХода();

КонецПроцедуры

// Новый диалог: идущий ход не останавливается и сохранит ответ в свой диалог.
&НаКлиенте
Процедура НовыйДиалог(Команда)

	ПередатьНаСтраницу("{""type"":""clear""}");
	ИнвалидироватьВозможностиЧата();
	Для Каждого Пакет Из НачатьНовыйДиалогНаСервере() Цикл
		ПередатьНаСтраницу(Пакет);
	КонецЦикла;

	ВозможностиТребуютЗагрузки = Истина;
	ЗагрузитьВозможностиВФоне();
	ОпроситьХод();

КонецПроцедуры

&НаСервере
Функция НачатьНовыйДиалогНаСервере()

	ИсторияДиалога = "[]";
	СсылкиДиалога = "[]";
	Диалог = Неопределено;
	ПоследнийХод = "";
	СброситьПоказХода(0);
	// Новый диалог - снова об объекте, из которого открыт чат: восстановленный диалог мог сменить контекст.
	Контекст = Неопределено;
	Параметры.Свойство("Контекст", Контекст);
	УстановитьКонтекст(Контекст);
	Пакеты = Новый Массив;
	Пакеты.Добавить(ПакетВозможностейНаСервере());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Пакеты, ПакетыКонтекста());
	Пакеты.Добавить(ПакетДиалогов());
	Возврат Пакеты;

КонецФункции

// Объект, из которого открыт чат или восстановленный диалог: контекст ходов и заголовок окна.
&НаСервере
Процедура УстановитьКонтекст(Контекст)

	КонтекстXML = "";
	КонтекстТекст = "";
	ОшибкаКонтекста = "";
	Заголовок = НСтр("ru = 'ИИ-ассистент'");
	Если Не ЗначениеЗаполнено(Контекст) Тогда
		Возврат;
	КонецЕсли;
	Представление = ИИА_ЧатВызовСервера.ПредставлениеКонтекста(Контекст);
	Если Представление.Успех Тогда
		КонтекстXML = ОбщегоНазначения.ЗначениеВСтрокуXML(Контекст);
		КонтекстТекст = Представление.Текст;
		Заголовок = СтрШаблон(НСтр("ru = 'ИИ-ассистент: %1'"), Представление.Текст);
	Иначе
		ОшибкаКонтекста = Представление.Текст;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПакетыКонтекста()

	Пакеты = Новый Массив;
	Если Не ПустаяСтрока(КонтекстТекст) Тогда
		Пакеты.Добавить(ПакетКонтекста(КонтекстТекст));
	ИначеЕсли Не ПустаяСтрока(ОшибкаКонтекста) Тогда
		Пакеты.Добавить(ПакетСообщения("error", ОшибкаКонтекста, "", Неопределено));
	КонецЕсли;
	Возврат Пакеты;

КонецФункции

&НаКлиенте
Процедура ИсторияДиалогов(Команда)

	// Панель истории живёт на странице: кнопка только показывает или скрывает её.
	Если Не СтраницаГотова Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Элементы.ЧатHTML.Документ.defaultView.iiaToggleSidebar();
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Страница чата не поддерживается этим клиентом. Обновите платформу или используйте тонкий клиент.'"));
	КонецПопытки;

КонецПроцедуры

// Действие панели истории: open, pin, unpin, delete; Номер - индекс диалога в реестре панели.
// Идущий ход открытию другого диалога не мешает: он продолжается и сохраняет ответ в свой диалог. Удалить диалог,
// в котором идёт ход или ждут сообщения, нельзя.
&НаКлиенте
Процедура ВыполнитьДействиеИстории(Действие, Номер)

	Если Номер < 0 Тогда
		Возврат;
	КонецЕсли;
	Если Действие = "open" Тогда
		ИнвалидироватьВозможностиЧата();
		Пакеты = ОткрытьДиалогПанелиНаСервере(Номер);
		Если Пакеты.Количество() > 0 Тогда
			ПередатьНаСтраницу("{""type"":""clear""}");
		КонецЕсли;
	ИначеЕсли Действие = "pin" Или Действие = "unpin" Или Действие = "delete" Тогда
		Изменение = ИзменитьДиалогПанелиНаСервере(Действие, Номер);
		Если Изменение.ТекущийУдален Тогда
			НовыйДиалог(Неопределено);
			Возврат;
		КонецЕсли;
		Пакеты = Изменение.Пакеты;
	Иначе
		Возврат;
	КонецЕсли;
	Для Каждого Пакет Из Пакеты Цикл
		ПередатьНаСтраницу(Пакет);
	КонецЦикла;

	Если Действие = "open" И Пакеты.Количество() > 0 Тогда
		ВозможностиТребуютЗагрузки = Истина;
		ЗагрузитьВозможностиВФоне();
		// Живой ход и ждущие сообщения открытого диалога.
		ОпроситьХод();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ОткрытьДиалогПанелиНаСервере(Знач Номер)

	Пакеты = Новый Массив;
	ВыбранныйДиалог = ДиалогПанели(Номер);
	Если ВыбранныйДиалог = Неопределено Тогда
		Возврат Пакеты;
	КонецЕсли;
	Пакеты.Добавить(ПакетВозможностейНаСервере());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Пакеты, ЗагрузитьДиалогНаСервере(ВыбранныйДиалог));
	Пакеты.Добавить(ПакетДиалогов());
	Возврат Пакеты;

КонецФункции

&НаСервере
Функция ИзменитьДиалогПанелиНаСервере(Знач Действие, Знач Номер)

	Результат = Новый Структура("Пакеты, ТекущийУдален", Новый Массив, Ложь);
	ВыбранныйДиалог = ДиалогПанели(Номер);
	Если ВыбранныйДиалог = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Если Действие = "delete" Тогда
		Если ИИА_ФоновыйХод.ДиалогЗанят(ВыбранныйДиалог) Тогда
			Результат.Пакеты.Добавить(ПакетСтатуса(
				НСтр("ru = 'Диалог нельзя удалить: в нём идёт ответ или ждут сообщения. Дождитесь ответа или нажмите Стоп.'")));
			Возврат Результат;
		КонецЕсли;
		Результат.ТекущийУдален = ИИА_Обслуживание.УдалитьДиалог(ВыбранныйДиалог) И ВыбранныйДиалог = Диалог;
	Иначе
		ИИА_Обслуживание.ЗакрепитьДиалог(ВыбранныйДиалог, Действие = "pin");
	КонецЕсли;
	Результат.Пакеты.Добавить(ПакетДиалогов());
	Возврат Результат;

КонецФункции

// Пакет dialogs панели истории. Реестр панели (ДиалогиПанели): последний поиск и УИД диалогов по индексам -
// на страницу уходят только индексы.
//  Отбор - Строка, Неопределено - текст поиска; Неопределено - последний поиск панели.
&НаСервере
Функция ПакетДиалогов(Знач Отбор = Неопределено)

	Если Отбор = Неопределено Тогда
		Отбор = Строка(СостояниеПанели().Получить("query"));
	КонецЕсли;
	Идентификаторы = Новый Массив;
	Строки = Новый Массив;
	ИсторияПанели = ИИА_Обслуживание.ДиалогиДляПанели(Отбор);
	Для Каждого Описание Из ИсторияПанели Цикл
		Идентификаторы.Добавить(Строка(Описание.Ссылка.УникальныйИдентификатор()));
		Строки.Добавить(Новый Структура("id, title, time, pinned, current", Идентификаторы.ВГраница(),
			Описание.Наименование, ВремяСообщения(Описание.Изменен), Описание.Закреплен, Описание.Ссылка = Диалог));
	КонецЦикла;
	ДиалогиПанели = ОбщегоНазначения.ЗначениеВJSON(Новый Структура("query, ids", Отбор, Идентификаторы));
	Пакет = Новый Структура("type, items, query", "dialogs", Строки, Отбор);
	ПодсказкиДоступны = ?(ПустаяСтрока(Отбор),
		ИИА_ЧатВызовСервера.НачальныеПодсказкиРазрешены(ИсторияПанели.Количество()),
		ИИА_ЧатВызовСервера.НачальныеПодсказкиДоступны());
	// Фиксированный префикс собственного протокола: клиенту не нужен разбор всей истории.
	Возврат "{""onboardingAllowed"":" + ?(ПодсказкиДоступны, "true", "false") + ","
		+ Сред(ОбщегоНазначения.ЗначениеВJSON(ИИА_Маскирование.ДляПользователя(Пакет, , Ложь)), 2);

КонецФункции

&НаСервере
Функция СостояниеПанели()

	Состояние = Неопределено;
	Если Не ПустаяСтрока(ДиалогиПанели) Тогда
		Состояние = ОбщегоНазначения.JSONВЗначение(ДиалогиПанели);
	КонецЕсли;
	Возврат ?(ТипЗнч(Состояние) = Тип("Соответствие"), Состояние, Новый Соответствие);

КонецФункции

// Диалог панели истории по индексу реестра; Неопределено - индекс вне реестра.
&НаСервере
Функция ДиалогПанели(Номер)

	Идентификаторы = СостояниеПанели().Получить("ids");
	Если ТипЗнч(Идентификаторы) <> Тип("Массив") Или Номер < 0 Или Номер > Идентификаторы.ВГраница()
		Или Не СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(Строка(Идентификаторы[Номер])) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Справочники.ИИА_Диалоги.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификаторы[Номер]));

КонецФункции

// Команда страницы с данными (канал data-cmd): строка JSON берётся из атрибута и сразу снимается.
// Обрабатывается и во время хода: rename, search, excel и pref текущий диалог не меняют.
&НаКлиенте
Процедура ОбработатьКомандуДанных()

	Попытка
		Запрос = Элементы.ЧатHTML.Документ.getElementById("iia-request");
		Если Не Запрос.hasAttribute("data-cmd") Тогда
			Возврат;
		КонецЕсли;
		ДанныеКоманды = Строка(Запрос.getAttribute("data-cmd"));
		Запрос.removeAttribute("data-cmd");
	// Страница ещё не готова: команда данных не выполняется.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат;
	КонецПопытки;
	ВыполнитьКомандуДанных(ДанныеКоманды);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандуДанных(ДанныеКоманды)

	Результат = КомандаДанныхНаСервере(ДанныеКоманды);
	Для Каждого Пакет Из Результат.Пакеты Цикл
		ПередатьНаСтраницу(Пакет);
	КонецЦикла;
	Если Результат.Файл <> Неопределено Тогда
		ОткрытьФайлExcel(Результат.Файл);
	КонецЕсли;

КонецПроцедуры

// Команда data-cmd после проверки схемы на сервере (ИИА_ЧатВызовСервера.КомандаСтраницы); не прошедшая
// проверку команда игнорируется.
&НаСервере
Функция КомандаДанныхНаСервере(Знач ДанныеКоманды)

	Результат = Новый Структура("Пакеты, Файл", Новый Массив, Неопределено);
	Команда = ИИА_ЧатВызовСервера.КомандаСтраницы(ДанныеКоманды);
	Если Команда = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Если Команда.cmd = "rename" Тогда
		ВыбранныйДиалог = ДиалогПанели(Команда.id);
		Если ВыбранныйДиалог <> Неопределено И ИИА_Обслуживание.ПереименоватьДиалог(ВыбранныйДиалог, Команда.title) Тогда
			Результат.Пакеты.Добавить(ПакетДиалогов());
		Иначе
			Результат.Пакеты.Добавить(ПакетСтатуса(НСтр("ru = 'Диалог не переименован: название пустое или диалог недоступен.'")));
		КонецЕсли;
	ИначеЕсли Команда.cmd = "search" Тогда
		Результат.Пакеты.Добавить(ПакетДиалогов(СокрЛП(Команда.text)));
	ИначеЕсли Команда.cmd = "pref" Тогда
		ИИА_ЧатВызовСервера.СохранитьСостояниеПанели(Команда.sidebar);
	ИначеЕсли Команда.cmd = "excel" Тогда
		Результат.Файл = ИИА_ЧатВызовСервера.ФайлExcelТаблицы(Новый Структура("Заголовок, Колонки, Строки, ИзТекста",
			Команда.title, Команда.columns, Команда.rows, Истина), УникальныйИдентификатор);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Файл Excel таблицы данных ответа по идентификатору реестра ссылок диалога.
&НаСервере
Функция ФайлExcelНаСервере(Знач Идентификатор)

	Реестр = ОбщегоНазначения.JSONВЗначение(СсылкиДиалога);
	Если ТипЗнч(Реестр) <> Тип("Массив") Или Идентификатор < 0 Или Идентификатор > Реестр.ВГраница()
		Или Реестр[Идентификатор].Получить("kind") <> "table" Тогда
		Возврат Новый Структура("Адрес, ИмяФайла, Ошибка", "", "", НСтр("ru = 'Таблица не найдена в ответе.'"));
	КонецЕсли;
	Запись = Реестр[Идентификатор];
	Колонки = Запись.Получить("columns");
	Строки = Запись.Получить("rows");
	ИмяТаблицы = Строка(Запись.Получить("title"));
	// Без заголовка - начало вопроса (псевдонимы раскрывает ФайлExcelТаблицы).
	Для Каждого Реплика Из ?(ПустаяСтрока(ИмяТаблицы), ИсторияКакМассив(), Новый Массив) Цикл
		ИмяТаблицы = ?(Реплика.Роль = "user", Лев(Строка(Реплика.Текст), 80), ИмяТаблицы);
	КонецЦикла;
	Возврат ИИА_ЧатВызовСервера.ФайлExcelТаблицы(Новый Структура("Заголовок, Колонки, Строки, ИзТекста",
		ИмяТаблицы, ?(ТипЗнч(Колонки) = Тип("Массив"), Колонки, Новый Массив),
		?(ТипЗнч(Строки) = Тип("Массив"), Строки, Новый Массив), Ложь), УникальныйИдентификатор);

КонецФункции

// Открывает xlsx приложением по ассоциации (БСП сохраняет файл во временный каталог клиента).
//  Файл - Структура - Адрес, ИмяФайла, Ошибка (см. ИИА_ЧатВызовСервера.ФайлExcelТаблицы).
&НаКлиенте
Процедура ОткрытьФайлExcel(Файл)

	Если ПустаяСтрока(Файл.Адрес) Тогда
		ПередатьНаСтраницу(ПакетСтатусаНаСервере(Файл.Ошибка));
		Возврат;
	КонецЕсли;
	ФайловаяСистемаКлиент.ОткрытьФайл(Файл.Адрес, , Файл.ИмяФайла);

КонецПроцедуры

&НаКлиенте
Процедура ТокенAPI(Команда)

	Текст = Новый ТекстовыйДокумент;
	Текст.УстановитьТекст(ТокенAPIНаСервере());
	Текст.Показать(НСтр("ru = 'JWT для внешнего доступа (действует 15 минут, не передавайте другим)'"));

КонецПроцедуры

&НаСервереБезКонтекста
Функция ТокенAPIНаСервере()

	Возврат ИИА_ЧатВызовСервера.ВыпуститьТокенВнешнегоДоступа();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Опрос хода по регистру ИИА_СостоянияХодов (обработчик ожидания, раз в секунду, пока есть активный ход или
// ждущие сообщения): шаги и статус хода показанного диалога, итог, ждущие сообщения, пауза ради структуры формы,
// вторая фаза «Стоп».
&НаКлиенте
Процедура ОпроситьХод() Экспорт

	ОпросПодключен = Ложь;
	Опрос = ОпроситьХодНаСервере();
	Для Каждого Пакет Из Опрос.Пакеты Цикл
		ПередатьНаСтраницу(Пакет);
	КонецЦикла;
	АктивныйХодПользователя = Опрос.АктивныйХод;

	Если Опрос.Пауза <> Неопределено Тогда
		ПродолжитьПаузу(Опрос.Пауза);
	КонецЕсли;

	Если Не ЕстьАктивныйХод Тогда
		МоментСтопа = 0;
	ИначеЕсли ТипЗнч(МоментСтопа) = Тип("Число") И МоментСтопа > 0
		И ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментСтопа >= 10000 Тогда
		// Флаг не сработал за 10 с (ход ждёт ответа модели): задание отменяется, частичный ответ сохранит восстановление.
		МоментСтопа = 0;
		ОтменитьХодНаСервере(АктивныйХодПользователя, Истина);
	КонецЕсли;
	ОбновитьДоступность();

	// Отчёт и объекты, которые ассистент открыл по просьбе пользователя, - один раз, при получении итога.
	Для Каждого Идентификатор Из Опрос.Открыть Цикл
		ОткрытьСсылкуДиалога(Формат(Идентификатор, "ЧН=0; ЧГ="));
	КонецЦикла;
	Если Не ЕстьАктивныйХод И ВозможностиТребуютЗагрузки = Истина Тогда
		ЗагрузитьВозможностиВФоне();
	КонецЕсли;
	Если Опрос.Продолжать Тогда
		ПодключитьОпросХода();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПодключитьОпросХода()

	Если ОпросПодключен = Истина Тогда
		Возврат;
	КонецЕсли;
	ОпросПодключен = Истина;
	ПодключитьОбработчикОжидания("ОпроситьХод", 1, Истина); // не чаще раза в секунду

КонецПроцедуры

// Ход встал на паузу ради структуры формы: форма создаётся здесь, на клиенте (на сервере ПолучитьФорму недоступна),
// структура уходит в продолжение хода и запоминается до закрытия чата. Продолжить ход может любое окно чата
// пользователя: повторное продолжение того же хода сервер отклоняет.
&НаКлиенте
Процедура ПродолжитьПаузу(Пауза)

	// Пауза.Форма - ключ структуры: полное имя формы или «имя#УИД объекта», если форма нужна с данными объекта
	// (Пауза.КлючОбъекта); кэш окна - по этому составному ключу.
	Структуры = СтруктурыФормХода();
	Структура = Структуры.Получить(Пауза.Форма);
	Если Структура = Неопределено Тогда
		Разделитель = СтрНайти(Пауза.Форма, "#");
		ФормаПаузы = ?(Разделитель = 0, Пауза.Форма, Лев(Пауза.Форма, Разделитель - 1));
		// Ошибка сбора структуры не обрывает ход: модель получит причину вместо структуры.
		Попытка
			Структура = ИИА_ЧатКлиент.СтруктураФормы(ФормаПаузы, Пауза.КлючОбъекта);
		// Причина передаётся модели вместо структуры.
		Исключение // BSLLS:MissingCodeTryCatchEx-off
			Структура = НСтр("ru = 'Структуру формы не удалось получить: '") + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		Структуры.Вставить(Пауза.Форма, Структура);
	КонецЕсли;
	ПродолжитьПаузуНаСервере(Пауза.ИдентификаторХода, Структура);
	ПодключитьОпросХода();

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПродолжитьПаузуНаСервере(Знач ИдентификаторХода, Знач Структура)

	ИИА_ЧатВызовСервера.ПродолжитьПаузуХода(ИдентификаторХода, Структура);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтсоединитьОкноНаСервере()

	ИИА_ЧатВызовСервера.ОтсоединитьОкноЧата();

КонецПроцедуры

&НаКлиенте
Функция СтруктурыФормХода()

	Если СтруктурыФорм = Неопределено Тогда
		СтруктурыФорм = Новый Соответствие;
	КонецЕсли;
	Возврат СтруктурыФорм;

КонецФункции

// Страница (таймер, «Стоп») и кнопки автотестов - по активному ходу пользователя. Отправка не блокируется:
// во время хода сообщение встаёт в очередь.
&НаКлиенте
Процедура ОбновитьДоступность()

	ПередатьНаСтраницу("{""type"":""busy"",""value"":" + ?(ЕстьАктивныйХод, "true", "false") + "}");
	Элементы.КнопкаСтоп.Доступность = ЕстьАктивныйХод;

КонецПроцедуры

// Мост 1С -> JS: единственная функция страницы iiaReceive, пакет - JSON-строка.
&НаКлиенте
Процедура ПередатьНаСтраницу(Пакет)

	Если СтрНачинаетсяС(Пакет, "{""onboardingAllowed"":false,") Тогда
		ВозможностиТребуютЗагрузки = Ложь;
		ИнвалидироватьВозможностиЧата();
		Если БазовыеВозможности <> Неопределено Тогда
			ЭтотОбъект.ВозможностиЧатаJSON = БазовыеВозможности;
			ПередатьНаСтраницу(БазовыеВозможности);
		КонецЕсли;
	КонецЕсли;

	Если Не СтраницаГотова Тогда
		Если ОчередьПакетов = Неопределено Тогда
			ОчередьПакетов = Новый Массив;
		КонецЕсли;
		ОчередьПакетов.Добавить(Пакет);
		Возврат;
	КонецЕсли;

	Попытка
		Элементы.ЧатHTML.Документ.defaultView.iiaReceive(Пакет);
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Страница чата не поддерживается этим клиентом. Обновите платформу или используйте тонкий клиент.'"));
	КонецПопытки;

КонецПроцедуры

// Сообщение со страницы: при идущем ходе встаёт в очередь (ИИА_ФоновыйХод.ПоставитьВОчередь), иначе сохраняется
// репликой и запускает ход чата. Файлы во время хода не принимаются: в очереди файлов нет.
//
// Возвращаемое значение:
//  Структура - Запущено (Булево - ход запущен или сообщение в очереди: нужен опрос), Пакеты (Массив из Строка).
&НаСервере
Функция ЗапуститьХодНаСервере(Знач ДанныеСообщения, Знач СтруктурыФормКлиента)

	Результат = Новый Структура("Запущено, Пакеты", Ложь, Новый Массив);

	// Во время хода файлы не принимаются: проверка до разбора, чтобы не читать файлы (и файлы базы) зря.
	Если ЕстьВложенияСтраницы(ДанныеСообщения) И ИИА_ФоновыйХод.ЕстьАктивныйХод() Тогда
		Результат.Пакеты.Добавить(ОбщегоНазначения.ЗначениеВJSON(Новый Структура("type, text, hint", "restore-input", "",
			НСтр("ru = 'Файлы можно приложить после ответа ассистента.'"))));
		Возврат Результат;
	КонецЕсли;
	Сообщение = ИИА_ЧатВызовСервера.РазобратьСообщениеСтраницы(ДанныеСообщения, ОбщегоНазначения.JSONВЗначение(СсылкиДиалога));
	Если Не ПустаяСтрока(Сообщение.Ошибка) Тогда
		Результат.Пакеты.Добавить(ПакетСтатуса(Сообщение.Ошибка));
		Возврат Результат;
	КонецЕсли;
	Текст = Сообщение.Текст;
	ЕстьФайлы = Сообщение.Изображения.Количество() > 0 Или Сообщение.Документы.Количество() > 0;
	Если ПустаяСтрока(Текст) И Не ЕстьФайлы Тогда
		Возврат Результат;
	КонецЕсли;
	Если ЕстьФайлы И ИИА_ФоновыйХод.ЕстьАктивныйХод() Тогда
		// Только подсказка без текста: страница ещё не очистила поле ввода (accepted не отправлен), текст и файлы
		// остаются в нём; пакет лишь снимает ожидание отправки.
		Результат.Пакеты.Добавить(ОбщегоНазначения.ЗначениеВJSON(Новый Структура("type, text, hint", "restore-input", "",
			НСтр("ru = 'Файлы можно приложить после ответа ассистента.'"))));
		Возврат Результат;
	КонецЕсли;
	Результат.Пакеты.Добавить("{""type"":""accepted""}");

	// Навигационные ссылки на объекты базы: в вопросе - представления доступных объектов. До проверки ПДн
	// ссылки заменены маркерами: идентификатор ссылки детектор секретов скрыл бы.
	РазборСсылок = ИИА_Инструменты.РазобратьНавигационныеСсылки(Текст);
	Проверка = ИИА_ЗащитаОтИнъекций.ПроверитьСообщениеПользователя(РазборСсылок.Текст);
	ТекстВопроса = ИИА_Инструменты.ПодставитьОбъектыСсылок(Проверка.Текст, РазборСсылок);
	ОбъектыВопроса = Новый Массив;
	ОбъектыОчереди = Новый Массив;
	КлассВопроса = 1;
	ФайлыБазыСсылками = ИИА_Файлы.ФайлыРазрешены();
	Для Каждого Объект Из РазборСсылок.Объекты Цикл
		// Ссылка на присоединённый файл приложена файлом (см. РазобратьСообщениеСтраницы), а не объектом.
		Если Объект.Значение <> Неопределено
			И Не (ФайлыБазыСсылками И ИИА_Файлы.ЭтоПрисоединенныйФайл(Объект.Значение)) Тогда
			ОбъектыВопроса.Добавить(Объект.Значение);
			КлассВопроса = Макс(КлассВопроса, Объект.Класс);
			ОбъектыОчереди.Добавить(Новый Структура("Текст, Ссылка, Класс", Объект.Текст, Объект.Ссылка, Объект.Класс));
		КонецЕсли;
	КонецЦикла;
	Контекст = ?(ПустаяСтрока(КонтекстXML), Неопределено, ОбщегоНазначения.ЗначениеИзСтрокиXML(КонтекстXML));
	НовыйДиалогСоздан = Не ЗначениеЗаполнено(Диалог);
	Если НовыйДиалогСоздан Тогда
		// У ждущего сообщения и у состояния хода должен быть диалог.
		Диалог = ИИА_Обслуживание.СоздатьДиалог(ТекстВопроса, Контекст);
	КонецЕсли;

	Если Не ЕстьФайлы Тогда
		// Отложенные сообщения диалога уходят вместе с новым одним ходом.
		ВместеСОтложенными = ИИА_ФоновыйХод.ЕстьОтложенные(Диалог);
		Постановка = ИИА_ФоновыйХод.ПоставитьВОчередь(Диалог, ТекстВопроса, ОбъектыОчереди, КлассВопроса,
			ВместеСОтложенными);
		Если ВместеСОтложенными Тогда
			Результат.Запущено = Истина;
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат.Пакеты, ЗапуститьОчередьНаСервере(СтруктурыФормКлиента));
			ДобавитьПакетДиалогов(Результат.Пакеты, НовыйДиалогСоздан);
			Возврат Результат;
		ИначеЕсли Не Постановка.ЗапускатьСразу Тогда
			Результат.Запущено = Истина;
			Результат.Пакеты.Добавить(ПакетОжидающего(Постановка.Идентификатор, ТекстВопроса, "waiting", ""));
			ЗапомнитьОжидающее(Постановка.Идентификатор, "waiting");
			ДобавитьПакетДиалогов(Результат.Пакеты, НовыйДиалогСоздан);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	// В истории, журнале и вложениях - имена файлов после текстового слоя; файлы базы - ссылкой, класс владельца.
	ИменаФайлов = Новый Массив;
	ФайлыБазы = Новый Массив;
	Для Каждого Документ Из Сообщение.Документы Цикл
		ИменаФайлов.Добавить(Документ.Имя);
		Если Документ.Источник = "base" Тогда
			ФайлыБазы.Добавить(Новый Структура("name, link", Документ.Имя, Документ.Ссылка));
			КлассВопроса = Макс(КлассВопроса, Документ.Класс);
		КонецЕсли;
	КонецЦикла;
	// Изображения и исходные файлы хранятся с репликой; в фоновое задание документы уходят без исходников.
	ФайлыВопроса = ФайлыВопросаДляХранения(Сообщение);
	// ФайлыСохранены попадает во вложения реплики: вложения и файлы пишутся при одном условии профиля.
	ВложенияВопроса = Новый Структура("Объекты, Документы, Изображений, ФайлыСохранены, ФайлыБазы", РазборСсылок.Объекты,
		ИменаФайлов, Сообщение.Изображения.Количество(), ФайлыВопроса.Количество() > 0, ФайлыБазы);
	ТекстДляИстории = ТекстВопроса + ?(Сообщение.Изображения.Количество() = 0, "",
		СтрШаблон(НСтр("ru = ' [приложено изображений: %1]'"), Сообщение.Изображения.Количество()))
		+ ИИА_Файлы.ПометкаФайлов(Сообщение.Документы);
	// История модели - сохранённые реплики диалога до этого вопроса.
	История = ИИА_ФоновыйХод.ИсторияДиалогаДляМодели(Диалог);
	// Текст показа без пометок о вложениях хранится, только когда он отличается от текста для модели.
	НомерСообщения = 0;
	ФайлыСохранены = Ложь;
	Диалог = ИИА_ЧатВызовСервера.СохранитьСообщение(Диалог, "user", ТекстДляИстории, "", Контекст, КлассВопроса,
		ИИА_ФоновыйХод.ВложенияСообщения(ВложенияВопроса, ?(ТекстДляИстории = ТекстВопроса, Неопределено, ТекстВопроса)),
		ФайлыВопроса, НомерСообщения, ФайлыСохранены);
	// Найденное детекторами скрыто в тексте вопроса выше; вопрос уходит модели без этих значений.
	Запуск = ИИА_ЧатВызовСервера.ЗапуститьХод(История, ТекстВопроса, УникальныйИдентификатор, Контекст,
		Сообщение.Изображения, Диалог, Сообщение.Документы, ОбъектыВопроса, , СтруктурыФормКлиента, "chat");
	Если Не Запуск.Запущено Тогда
		// Вопрос без хода в истории не остаётся: повторная отправка не копит реплики и копии файлов.
		Если ИИА_ЧатВызовСервера.УдалитьСообщение(Диалог, НомерСообщения) Тогда
			Диалог = Неопределено;
			НовыйДиалогСоздан = Ложь;
		КонецЕсли;
		ФайлыСохранены = Ложь;
		// Ход начался между проверкой очереди и запуском: сообщение без файлов встаёт в очередь.
		Если Запуск.КодОшибки = "TURN_BUSY" И Не ЕстьФайлы И ЗначениеЗаполнено(Диалог) Тогда
			Постановка = ИИА_ФоновыйХод.ПоставитьВОчередь(Диалог, ТекстВопроса, ОбъектыОчереди, КлассВопроса);
			Если Не Постановка.ЗапускатьСразу Тогда
				Результат.Запущено = Истина;
				Результат.Пакеты.Добавить(ПакетОжидающего(Постановка.Идентификатор, ТекстВопроса, "waiting", ""));
				ЗапомнитьОжидающее(Постановка.Идентификатор, "waiting");
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	// Значки файлов - ссылки на скачивание, только когда файлы действительно сохранены с репликой.
	ПакетВопроса = ОбщегоНазначения.JSONВЗначение(ПакетВопросаПользователя(ВложенияВопроса, ТекстВопроса, ,
		?(ФайлыСохранены, НомерСообщения, 0)));
	ПакетВопроса.Вставить("shots", Сообщение.Изображения.Количество() > 0);
	Результат.Пакеты.Добавить(ОбщегоНазначения.ЗначениеВJSON(ПакетВопроса));
	Если Не Запуск.Запущено Тогда
		Результат.Пакеты.Добавить(ПакетСообщения("error", Запуск.Ошибка, "", Неопределено));
		Возврат Результат;
	КонецЕсли;

	СброситьПоказХода(НомерСообщения);
	ИдентификаторХода = Запуск.ИдентификаторХода;
	ЕстьАктивныйХод = Истина;
	// В историю диалога изображения не попадают - только пометка.
	ДобавитьВИсторию("user", ТекстДляИстории, КлассВопроса);
	Результат.Пакеты.Добавить(ПакетСтатуса(НСтр("ru = 'Ассистент думает...'")));
	ДобавитьПакетДиалогов(Результат.Пакеты, НовыйДиалогСоздан);
	Результат.Запущено = Истина;
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ДобавитьПакетДиалогов(Пакеты, НовыйДиалогСоздан)

	Если НовыйДиалогСоздан Тогда
		Пакеты.Добавить(ПакетДиалогов());
	КонецЕсли;

КонецПроцедуры

// Запускает ход по очереди показанного диалога (отложенные и ждущие сообщения одним сообщением).
&НаСервере
Функция ЗапуститьОчередьНаСервере(СтруктурыФормКлиента)

	Пакеты = Новый Массив;
	Запуск = ИИА_ФоновыйХод.ЗапуститьОчередьДиалога(Диалог, УникальныйИдентификатор, СтруктурыФормКлиента);
	Если Запуск.Запущено Тогда
		ЕстьАктивныйХод = Истина;
		Пакеты.Добавить(ПакетСтатуса(НСтр("ru = 'Ассистент думает...'")));
	ИначеЕсли Не ПустаяСтрока(Запуск.Ошибка) Тогда
		Пакеты.Добавить(ПакетСтатуса(Запуск.Ошибка));
	КонецЕсли;
	// Отправленные сообщения исчезнут из ждущих, их реплику и ход покажет опрос.
	Возврат Пакеты;

КонецФункции

// Пакет ждущего сообщения для страницы: пузырь «Ожидание очереди» с «Отменить» (и «Отправить» для отложенного).
&НаСервере
Функция ПакетОжидающего(Идентификатор, Текст, Статус, Причина)

	Возврат ОбщегоНазначения.ЗначениеВJSON(Новый Структура("type, id, text, held, reason", "queued", Идентификатор,
		ИИА_Маскирование.ДляПользователя(Текст, Диалог), Статус = "held",
		ИИА_Маскирование.ДляПользователя(Причина, Диалог)));

КонецФункции

// Показанные на странице ждущие сообщения: идентификатор -> статус (waiting, held).
&НаСервере
Функция ПоказанныеОжидающиеСообщения()

	Показанные = Неопределено;
	Если Не ПустаяСтрока(ПоказанныеОжидающие) Тогда
		Попытка
			Показанные = ОбщегоНазначения.JSONВЗначение(ПоказанныеОжидающие);
		Исключение
			// Повреждённый реестр показа начинается заново: пузыри ждущих покажутся повторно.
			ЗаписьЖурналаРегистрации("ИИАссистент.Чат", УровеньЖурналаРегистрации.Предупреждение, , ,
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Показанные = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Возврат ?(ТипЗнч(Показанные) = Тип("Соответствие"), Показанные, Новый Соответствие);

КонецФункции

&НаСервере
Процедура ЗапомнитьОжидающее(Идентификатор, Статус)

	Показанные = ПоказанныеОжидающиеСообщения();
	Если Статус = Неопределено Тогда
		Показанные.Удалить(Идентификатор);
	Иначе
		Показанные.Вставить(Идентификатор, Статус);
	КонецЕсли;
	ПоказанныеОжидающие = ОбщегоНазначения.ЗначениеВJSON(Показанные);

КонецПроцедуры

// Сбрасывает показ хода для нового показанного диалога; ПоследнееСообщение - последняя показанная реплика.
&НаСервере
Процедура СброситьПоказХода(Последнее)

	ИдентификаторХода = "";
	ПоказаноШагов = 0;
	ПоказанныеОжидающие = "";
	ПоследнееСообщение = Последнее;

КонецПроцедуры

// Опрос состояния хода (см. ИИА_ФоновыйХод.СостояниеДиалога) и пакеты для страницы.
//
// Возвращаемое значение:
//  Структура:
//   * Пакеты - Массив из Строка
//   * АктивныйХод - Строка
//   * Пауза - Структура, Неопределено - ИдентификаторХода, Форма, КлючОбъекта.
//   * Открыть - Массив из Число - идентификаторы реестра ссылок для автооткрытия.
//   * Продолжать - Булево - продолжать опрос.
&НаСервере
Функция ОпроситьХодНаСервере()

	Результат = Новый Структура("Пакеты, АктивныйХод, Пауза, Открыть, Продолжать", Новый Массив, "", Неопределено,
		Новый Массив, Ложь);
	Состояние = ИИА_ФоновыйХод.СостояниеДиалога(Диалог, ИдентификаторХода, ПоказаноШагов);
	ЕстьАктивныйХод = Состояние.ЕстьАктивныйХод;
	Результат.АктивныйХод = Состояние.АктивныйХод;
	Результат.Пауза = Состояние.Пауза;
	Результат.Продолжать = Состояние.ЕстьАктивныйХод Или Состояние.ЕстьЖдущие;
	Пакеты = Результат.Пакеты;

	// Ждущие сообщения: новые - пузырями, исчезнувшие - отправлены (их реплику покажет перечитывание) или отменены.
	Перечитать = ОбновитьОжидающие(Состояние.Ожидающие, Пакеты);

	Ход = Состояние.Ход;
	Итог = Неопределено;
	Если Ход <> Неопределено Тогда
		Если Ход.ИдентификаторХода <> ИдентификаторХода Тогда
			Если Не ПустаяСтрока(ИдентификаторХода) Тогда
				Пакеты.Добавить("{""type"":""progress"",""done"":true}");
			КонецЕсли;
			ИдентификаторХода = Ход.ИдентификаторХода;
			ПоказаноШагов = 0;
			Перечитать = Истина; // ход очереди: его вопрос уже сохранён репликой
		КонецЕсли;
		// Живой «Ход работы»: псевдонимы в подробностях шагов раскрываются для показа.
		Для Каждого Шаг Из Ход.Шаги Цикл
			Пакеты.Добавить(ОбщегоНазначения.ЗначениеВJSON(ИИА_Маскирование.ДляПользователя(
				Новый Структура("type, step", "progress", Шаг), Диалог)));
		КонецЦикла;
		ПоказаноШагов = Макс(ПоказаноШагов, Ход.ВсегоШагов);
		Если Ход.ИтогГотов Тогда
			Итог = Ход;
		ИначеЕсли Ход.ЗапросОстановки Тогда
			Пакеты.Добавить(ПакетСтатуса(НСтр("ru = 'Останавливаю'")));
		Иначе
			Пакеты.Добавить(ПакетСтатуса(?(ПустаяСтрока(Ход.ПоследнийСтатус), НСтр("ru = 'Ассистент думает...'"),
				ИИА_Маскирование.ДляПользователя(Ход.ПоследнийСтатус, Диалог))));
		КонецЕсли;
	ИначеЕсли Не ПустаяСтрока(ИдентификаторХода) Тогда
		// Итог хода забрало другое окно: ответ уже в диалоге.
		Пакеты.Добавить(ПакетСтатуса(""));
		Пакеты.Добавить("{""type"":""progress"",""done"":true}");
		ИдентификаторХода = "";
		ПоказаноШагов = 0;
		Перечитать = Истина;
	ИначеЕсли Не ПустаяСтрока(Состояние.ДиалогДругогоХода) Тогда
		Пакеты.Добавить(ПакетСтатуса(СтрШаблон(НСтр("ru = 'Ассистент отвечает в диалоге «%1»'"),
			Состояние.ДиалогДругогоХода)));
	КонецЕсли;

	Если Итог <> Неопределено Тогда
		ПоказатьИтог(Итог, Результат);
	ИначеЕсли Перечитать Тогда
		ДописатьНовыеРеплики(Пакеты, 0, 0);
	КонецЕсли;

	// Ответы, готовые в других диалогах: однократное уведомление и обновлённая панель истории. Итог не забирается:
	// его покажет (с автооткрытием) окно, в котором открыт тот диалог.
	Уведомленные = СтрРазделить(УведомленныеИтоги, ",", Ложь);
	ЕстьНовые = Ложь;
	Для Каждого Готовый Из Состояние.ГотовыеДругих Цикл
		Если Уведомленные.Найти(Готовый.ИдентификаторХода) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Уведомленные.Добавить(Готовый.ИдентификаторХода);
		ЕстьНовые = Истина;
		Пакеты.Добавить(ПакетСтатуса(?(ПустаяСтрока(Готовый.Ошибка),
			СтрШаблон(НСтр("ru = 'Ответ в диалоге «%1» готов: откройте его в истории.'"), Готовый.Наименование),
			СтрШаблон(НСтр("ru = 'Ответ в диалоге «%1» не получен: %2'"), Готовый.Наименование,
				ИИА_Маскирование.ДляПользователя(Готовый.Ошибка, Диалог)))));
	КонецЦикла;
	Если ЕстьНовые Тогда
		Пакеты.Добавить(ПакетДиалогов());
		Пока Уведомленные.Количество() > 50 Цикл
			Уведомленные.Удалить(0);
		КонецЦикла;
		УведомленныеИтоги = СтрСоединить(Уведомленные, ",");
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Сравнивает ждущие сообщения диалога с показанными. Возвращает Истина, если сообщения ушли из очереди.
&НаСервере
Функция ОбновитьОжидающие(Ожидающие, Пакеты)

	Показанные = ПоказанныеОжидающиеСообщения();
	Текущие = Новый Соответствие;
	Для Каждого Ожидающее Из Ожидающие Цикл
		Текущие.Вставить(Ожидающее.Идентификатор, Ожидающее.Статус);
		Было = Показанные.Получить(Ожидающее.Идентификатор);
		Если Было = Неопределено Тогда
			Пакеты.Добавить(ПакетОжидающего(Ожидающее.Идентификатор, Ожидающее.Текст, Ожидающее.Статус, Ожидающее.Причина));
		ИначеЕсли Было <> Ожидающее.Статус Тогда
			Пакеты.Добавить(ОбщегоНазначения.ЗначениеВJSON(Новый Структура("type, id, held, reason", "queue-held",
				Ожидающее.Идентификатор, Ожидающее.Статус = "held",
				ИИА_Маскирование.ДляПользователя(Ожидающее.Причина, Диалог))));
		КонецЕсли;
	КонецЦикла;
	Ушли = Ложь;
	Для Каждого Показанное Из Показанные Цикл
		Если Текущие.Получить(Показанное.Ключ) = Неопределено Тогда
			Пакеты.Добавить(ОбщегоНазначения.ЗначениеВJSON(Новый Структура("type, id", "unqueued", Показанное.Ключ)));
			Ушли = Истина;
		КонецЕсли;
	КонецЦикла;
	ПоказанныеОжидающие = ?(Текущие.Количество() = 0, "", ОбщегоНазначения.ЗначениеВJSON(Текущие));
	Возврат Ушли;

КонецФункции

// Итог хода показанного диалога: ответ - перечитыванием реплик диалога (замена - пакетом replace), ошибка без
// ответа - сообщением; итог забирается (автооткрытие и смена модели - один раз).
&НаСервере
Процедура ПоказатьИтог(Ход, Результат)

	Пакеты = Результат.Пакеты;
	Пакеты.Добавить(ПакетСтатуса(""));
	Пакеты.Добавить("{""type"":""progress"",""done"":true}");
	ОткрытьJSON = ИИА_ФоновыйХод.ЗабратьИтог(Ход.ИдентификаторХода);
	Замена = ?(Ход.НомерОтвета > 0 И Ход.НомерОтвета = Ход.НомерЗаменяемогоОтвета, Ход.НомерОтвета, 0);
	СсылкиОтвета = ДописатьНовыеРеплики(Пакеты, Замена, Ход.НомерОтвета);
	Если Ход.НомерОтвета = 0 И Не ПустаяСтрока(Ход.Ошибка) Тогда
		Пакеты.Добавить(ПакетСообщения("error", ИИА_Маскирование.ДляПользователя(Ход.Ошибка, Диалог), "", Неопределено));
	КонецЕсли;
	ИдентификаторХода = "";
	ПоказаноШагов = 0;
	Пакеты.Добавить(ПакетДиалогов());
	Если ПустаяСтрока(ОткрытьJSON) Тогда
		Возврат;
	КонецЕсли;
	Открыть = ОбщегоНазначения.JSONВЗначение(ОткрытьJSON);
	Если ТипЗнч(Открыть) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;
	Модель = Открыть.Получить("model");
	Если ТипЗнч(Модель) = Тип("Строка") И Не ПустаяСтрока(Модель) Тогда
		// Модель сменилась (ЗаменаМодели хода): список моделей - по текущему выбору.
		НастройкиВводаJSON = ПакетНастроекВвода();
		Пакеты.Добавить(НастройкиВводаJSON);
		Пакеты.Добавить(ПакетСтатуса(СтрШаблон(НСтр("ru = 'Выбранная модель не ответила, теперь выбрана %1.'"), Модель)));
	КонецЕсли;
	Если СсылкиОтвета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Отчет = Открыть.Получить("report");
	Если ТипЗнч(Отчет) = Тип("Число") И Отчет >= 0 И Отчет <= СсылкиОтвета.Отчеты.ВГраница() Тогда
		Результат.Открыть.Добавить(СсылкиОтвета.Отчеты[Отчет].id);
	КонецЕсли;
	Объекты = Открыть.Получить("objects");
	Для Каждого Индекс Из ?(ТипЗнч(Объекты) = Тип("Массив"), Объекты, Новый Массив) Цикл
		Если ТипЗнч(Индекс) = Тип("Число") И Индекс >= 0 И Индекс <= СсылкиОтвета.Объекты.ВГраница()
			И СсылкиОтвета.Объекты[Индекс].id <> Неопределено Тогда
			Результат.Открыть.Добавить(СсылкиОтвета.Объекты[Индекс].id);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Дописывает на страницу реплики диалога после последней показанной (ход сохранил вопрос очереди или ответ);
// реплика НомерЗамены заменяет показанную (перегенерация, продолжение). История модели перечитывается.
// Возвращает ссылки реплики НомерОтвета (см. ЗарегистрироватьСсылкиХода) или Неопределено.
&НаСервере
Функция ДописатьНовыеРеплики(Пакеты, НомерЗамены, НомерОтвета)

	СсылкиОтвета = Неопределено;
	Если Не ЗначениеЗаполнено(Диалог) Тогда
		Возврат СсылкиОтвета;
	КонецЕсли;
	Сообщения = ИИА_ЧатВызовСервера.СообщенияДиалога(Диалог);
	Новые = Новый Массив;
	НавигационныеСсылки = Новый Массив;
	Для Каждого Сообщение Из Сообщения Цикл
		Если Сообщение.НомерСообщения > ПоследнееСообщение Или Сообщение.НомерСообщения = НомерЗамены Тогда
			Ход = ИИА_ФоновыйХод.ХодИзВложений(Сообщение.Вложения);
			Для Каждого Объект Из Ход.Объекты Цикл
				НавигационныеСсылки.Добавить(Объект.Ссылка);
			КонецЦикла;
			Новые.Добавить(Новый Структура("Сообщение, Ход", Сообщение, Ход));
		КонецЕсли;
	КонецЦикла;
	Если Новые.Количество() = 0 Тогда
		Возврат СсылкиОтвета;
	КонецЕсли;
	Доступ = ИИА_Инструменты.ДоступныеНавигационныеСсылки(НавигационныеСсылки);
	ПоследнийНомер = Сообщения[Сообщения.ВГраница()].НомерСообщения;
	Для Каждого Новая Из Новые Цикл
		Если Новая.Сообщение.НомерСообщения = НомерЗамены Тогда
			Пакеты.Добавить(ОбщегоНазначения.ЗначениеВJSON(Новый Структура("type, msg", "replace", НомерЗамены)));
		КонецЕсли;
		Показ = ПакетРеплики(Новая.Сообщение, Новая.Ход, Доступ, Новая.Сообщение.НомерСообщения = ПоследнийНомер);
		Пакеты.Добавить(Показ.Пакет);
		Если Новая.Сообщение.НомерСообщения = НомерОтвета Тогда
			СсылкиОтвета = Показ.Ссылки;
		КонецЕсли;
		Если Новая.Сообщение.Роль = "assistant" Тогда
			ПоследнийХод = Новая.Сообщение.ИдентификаторХода;
		КонецЕсли;
		ПоследнееСообщение = Макс(ПоследнееСообщение, Новая.Сообщение.НомерСообщения);
	КонецЦикла;
	ИсторияДиалога = ИИА_ФоновыйХод.ИсторияДиалогаJSON(Диалог);
	Возврат СсылкиОтвета;

КонецФункции

// Пакет сохранённой реплики для страницы (общий для загрузки диалога и показа итога хода).
//  Доступ - Соответствие - навигационная ссылка -> Истина, если объект доступен.
//  Последний - Булево - последняя реплика диалога: у ответа кнопки «Перегенерировать» и «Продолжить».
// Возвращаемое значение:
//  Структура - Пакет (Строка), Ссылки (см. ЗарегистрироватьСсылкиХода; Неопределено у вопроса).
&НаСервере
Функция ПакетРеплики(Сообщение, Ход, Доступ, Последний)

	Для Каждого Объект Из Ход.Объекты Цикл
		Если Доступ.Получить(Объект.Ссылка) <> Истина Тогда
			Объект.Ссылка = "";
		КонецЕсли;
	КонецЦикла;
	Если Сообщение.Роль = "assistant" Тогда
		Ход.Текст = Сообщение.Текст;
		Ход.Вставить("НомерСообщения", Сообщение.НомерСообщения);
		Возврат ПакетОтветаХода(Ход, Сообщение.ДатаСообщения, Последний);
	КонецЕсли;
	Изображения = ?(Ход.Изображений = 0, Новый Массив, ИзображенияСообщения(Сообщение.НомерСообщения));
	Если Ход.Текст = Неопределено Тогда
		ТекстПоказа = Сообщение.Текст;
	Иначе
		// Изображения, которые не сохранились (хранение отключено профилем), остаются пометкой.
		ТекстПоказа = Ход.Текст + ?(Ход.Изображений = Изображения.Количество(), "",
			СтрШаблон(НСтр("ru = ' [приложено изображений: %1]'"), Ход.Изображений));
	КонецЕсли;
	// Реплики, сохранённые без файлов (в том числе до их хранения), показывают значки файлов без скачивания.
	Возврат Новый Структура("Пакет, Ссылки", ПакетВопросаПользователя(Ход, ТекстПоказа, Сообщение.ДатаСообщения,
		?(Ход.ФайлыСохранены, Сообщение.НомерСообщения, 0), Изображения), Неопределено);

КонецФункции

// Команды пузыря ждущего сообщения: unqueue - отменить (текст возвращается в поле ввода), sendqueued - отправить
// отложенное сообщение.
&НаКлиенте
Процедура ВыполнитьКомандуОчереди(Команда, Идентификатор)

	Если Команда = "unqueue" Тогда
		Пакеты = ОтменитьОжидающееНаСервере(Идентификатор);
	Иначе
		Пакеты = ОтправитьОжидающееНаСервере(Идентификатор, СтруктурыФормХода());
	КонецЕсли;
	Для Каждого Пакет Из Пакеты Цикл
		ПередатьНаСтраницу(Пакет);
	КонецЦикла;
	ОбновитьДоступность();
	ПодключитьОпросХода();

КонецПроцедуры

&НаСервере
Функция ОтменитьОжидающееНаСервере(Знач Идентификатор)

	Пакеты = Новый Массив;
	Текст = ИИА_ФоновыйХод.ОтменитьОжидающее(Идентификатор);
	Если Текст = Неопределено Тогда
		Пакеты.Добавить(ПакетСтатуса(НСтр("ru = 'Сообщение уже отправляется: отменить его нельзя.'")));
		Возврат Пакеты;
	КонецЕсли;
	ЗапомнитьОжидающее(Идентификатор, Неопределено);
	Пакеты.Добавить(ОбщегоНазначения.ЗначениеВJSON(Новый Структура("type, id", "unqueued", Идентификатор)));
	Пакеты.Добавить(ОбщегоНазначения.ЗначениеВJSON(Новый Структура("type, text", "restore-input", Текст)));
	Возврат Пакеты;

КонецФункции

&НаСервере
Функция ОтправитьОжидающееНаСервере(Знач Идентификатор, Знач СтруктурыФормКлиента)

	Пакеты = Новый Массив;
	// Диалог сверяется до изменения очереди: сообщение другого диалога не переводится в ожидание без хода.
	Если Не ЗначениеЗаполнено(Диалог) Или ИИА_ФоновыйХод.ОтправитьОжидающее(Идентификатор, Диалог) = Неопределено Тогда
		Возврат Пакеты;
	КонецЕсли;
	Если ИИА_ФоновыйХод.ЕстьАктивныйХод() Тогда
		// Сообщения снова ждут: их отправит идущий ход.
		Пакеты.Добавить(ПакетСтатуса(НСтр("ru = 'Сообщения будут отправлены после текущего ответа.'")));
		Возврат Пакеты;
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Пакеты, ЗапуститьОчередьНаСервере(СтруктурыФормКлиента));
	Возврат Пакеты;

КонецФункции

// Ввод для автотестов: отменяет ждущее сообщение показанного диалога с номером НомерОжидающегоТест (с 1).
&НаКлиенте
Процедура ОтменитьОжидающееТест(Команда)

	Идентификатор = ОжидающееПоНомеруНаСервере(НомерОжидающегоТест);
	Если ПустаяСтрока(Идентификатор) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Ждущего сообщения с таким номером нет.'"));
		Возврат;
	КонецЕсли;
	ВыполнитьКомандуОчереди("unqueue", Идентификатор);

КонецПроцедуры

&НаСервере
Функция ОжидающееПоНомеруНаСервере(Знач Номер)

	Ожидающие = ?(ЗначениеЗаполнено(Диалог), ИИА_ФоновыйХод.ОжидающиеДиалога(Диалог), Новый Массив);
	Возврат ?(Номер >= 1 И Номер <= Ожидающие.Количество(), Ожидающие[Номер - 1].Идентификатор, "");

КонецФункции

// Перегенерация последнего ответа (тот же вопрос, история без заменяемого ответа) или продолжение оборванного
// (частичный ответ и выполненные шаги - модели). Реплика пользователя заново не сохраняется; ответ заменяет
// само задание хода (см. ИИА_ФоновыйХод.ЗавершитьХодДиалога).
&НаСервере
Функция ЗапуститьЗаменуОтветаНаСервере(Знач НомерОтвета, Знач ЭтоПродолжение, Знач СтруктурыФормКлиента)

	Результат = Новый Структура("Запущено, Пакеты", Ложь, Новый Массив);
	Если ИИА_ФоновыйХод.ЕстьАктивныйХод() Тогда
		Результат.Пакеты.Добавить(ПакетСтатуса(НСтр("ru = 'Дождитесь ответа или нажмите Стоп.'")));
		Возврат Результат;
	КонецЕсли;
	Контекст = ?(ПустаяСтрока(КонтекстXML), Неопределено, ОбщегоНазначения.ЗначениеИзСтрокиXML(КонтекстXML));
	ПараметрыЧата = Новый Структура("НомерЗаменяемогоОтвета, ЭтоПродолжение", НомерОтвета, ЭтоПродолжение);
	Если ЭтоПродолжение Тогда
		Ответ = ИИА_ФоновыйХод.ПоследнийОтветДиалога(Диалог, НомерОтвета);
		Ход = ?(Ответ = Неопределено, Неопределено, ИИА_ФоновыйХод.ХодИзВложений(Ответ.Вложения));
		Если Ход = Неопределено Или ПустаяСтрока(Ход.Обрыв) Тогда
			Результат.Пакеты.Добавить(ПакетСтатуса(НСтр("ru = 'Продолжить можно только последний оборванный ответ диалога.'")));
			Возврат Результат;
		КонецЕсли;
		// Частичный ответ в историю модели добавляет ЗапуститьХод.
		Продолжение = Новый Структура("Текст, Шаги, Источников, КлассДанных", Ответ.Текст, Ход.Шаги,
			Ход.Источники.Количество(), Ответ.КлассДанных);
		ИсторияМодели = ИсторияДоОтвета(Ложь);
		Запуск = ИИА_ЧатВызовСервера.ЗапуститьХод(ИсторияМодели, "", УникальныйИдентификатор, Контекст, Неопределено,
			Диалог, Неопределено, Неопределено, Продолжение, СтруктурыФормКлиента, "chat", ПараметрыЧата);
		Статус = НСтр("ru = 'Продолжаю ответ...'");
	Иначе
		ВопросПерегенерации = ИИА_ЧатВызовСервера.ВопросДляПерегенерации(Диалог, НомерОтвета);
		Если ВопросПерегенерации = Неопределено Тогда
			Результат.Пакеты.Добавить(ПакетСтатуса(НСтр("ru = 'Перегенерировать можно только последний ответ диалога.'")));
			Возврат Результат;
		КонецЕсли;
		Запуск = ИИА_ЧатВызовСервера.ЗапуститьХод(ИсторияДоОтвета(Истина), ВопросПерегенерации.Текст,
			УникальныйИдентификатор, Контекст, ВопросПерегенерации.Изображения, Диалог, ВопросПерегенерации.Документы,
			ВопросПерегенерации.ОбъектыВопроса, , СтруктурыФормКлиента, "chat", ПараметрыЧата);
		Статус = НСтр("ru = 'Перегенерирую ответ'") + ?(ПустаяСтрока(ВопросПерегенерации.Предупреждение), "",
			" (" + ВопросПерегенерации.Предупреждение + ")");
	КонецЕсли;
	Если Не Запуск.Запущено Тогда
		Результат.Пакеты.Добавить(ПакетСтатуса(Запуск.Ошибка));
		Возврат Результат;
	КонецЕсли;

	ИдентификаторХода = Запуск.ИдентификаторХода;
	ПоказаноШагов = 0;
	ЕстьАктивныйХод = Истина;
	Результат.Пакеты.Добавить(ПакетСтатуса(Статус));
	Результат.Запущено = Истина;
	Возврат Результат;

КонецФункции

// История для модели без последнего ответа ассистента (и без вопроса к нему - для перегенерации).
&НаСервере
Функция ИсторияДоОтвета(БезВопроса)

	Записи = ОбщегоНазначения.JSONВЗначение(ИсторияДиалога);
	Если ТипЗнч(Записи) <> Тип("Массив") Тогда
		Записи = Новый Массив;
	КонецЕсли;
	Если Записи.Количество() > 0 И Записи[Записи.ВГраница()].Получить("role") = "assistant" Тогда
		Записи.Удалить(Записи.ВГраница());
	КонецЕсли;
	Если БезВопроса И Записи.Количество() > 0 И Записи[Записи.ВГраница()].Получить("role") = "user" Тогда
		Записи.Удалить(Записи.ВГраница());
	КонецЕсли;
	Возврат ИИА_Обслуживание.ИсторияИзJSON(ОбщегоНазначения.ЗначениеВJSON(Записи));

КонецФункции

// Остановка хода чата (см. ИИА_ЧатВызовСервера.ОтменитьХод): Принудительно - вторая фаза, отмена задания.
&НаСервереБезКонтекста
Процедура ОтменитьХодНаСервере(Знач ИдентификаторХода, Знач Принудительно)

	ИИА_ЧатВызовСервера.ОтменитьХод(ИдентификаторХода, Принудительно);

КонецПроцедуры

// Отзыв о реплике ассистента НомерОтвета; 0 - реплика не сохранена, отзыв о последнем ходе.
&НаСервере
Процедура ЗаписатьОтзывНаСервере(Знач Оценка, Знач НомерОтвета)

	ИдентификаторХода = ПоследнийХод;
	Если НомерОтвета > 0 И ЗначениеЗаполнено(Диалог) Тогда
		Для Каждого Сообщение Из ИИА_ЧатВызовСервера.СообщенияДиалога(Диалог) Цикл
			Если Сообщение.НомерСообщения = НомерОтвета И Сообщение.Роль = "assistant" Тогда
				ИдентификаторХода = Сообщение.ИдентификаторХода;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	ИИА_ЧатВызовСервера.ЗаписатьОтзыв(Оценка, Диалог, ИдентификаторХода);

КонецПроцедуры

// Восстанавливает диалог таким, каким он был: реплики, ссылки на объекты, отчёты, таблицы, графики, черновики,
// кнопки «Показать в форме», ход работы, источники, сохранённые варианты, изображения и файлы вопросов и объект,
// из которого был открыт чат. Доступ к объектам перепроверяется: недоступный теперь объект остаётся текстом.
// «Перегенерировать» и «Продолжить» - только у последнего ответа. Живой ход и ждущие сообщения диалога покажет
// следующий опрос (см. ОпроситьХодНаСервере).
&НаСервере
Функция ЗагрузитьДиалогНаСервере(ВыбранныйДиалог)

	Пакеты = Новый Массив;
	Сообщения = ИИА_ЧатВызовСервера.СообщенияДиалога(ВыбранныйДиалог);
	Если Сообщения.Количество() = 0 И Не ИИА_ФоновыйХод.ДиалогЗанят(ВыбранныйДиалог) Тогда
		Возврат Пакеты;
	КонецЕсли;
	Ходы = Новый Массив;
	НавигационныеСсылки = Новый Массив;
	Для Каждого Сообщение Из Сообщения Цикл
		Ход = ИИА_ФоновыйХод.ХодИзВложений(Сообщение.Вложения);
		Для Каждого Объект Из Ход.Объекты Цикл
			НавигационныеСсылки.Добавить(Объект.Ссылка);
		КонецЦикла;
		Ходы.Добавить(Ход);
	КонецЦикла;
	Доступ = ИИА_Инструменты.ДоступныеНавигационныеСсылки(НавигационныеСсылки);

	Диалог = ВыбранныйДиалог;
	ПоследнийХод = "";
	СсылкиДиалога = "[]";
	СброситьПоказХода(?(Сообщения.Количество() = 0, 0, Сообщения[Сообщения.ВГраница()].НомерСообщения));
	УстановитьКонтекст(ИИА_ЧатВызовСервера.КонтекстДиалога(ВыбранныйДиалог));
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Пакеты, ПакетыКонтекста());
	Для Индекс = 0 По Сообщения.ВГраница() Цикл
		Пакеты.Добавить(ПакетРеплики(Сообщения[Индекс], Ходы[Индекс], Доступ, Индекс = Сообщения.ВГраница()).Пакет);
		Если Сообщения[Индекс].Роль = "assistant" Тогда
			ПоследнийХод = Сообщения[Индекс].ИдентификаторХода;
		КонецЕсли;
	КонецЦикла;
	ИсторияДиалога = ИИА_ФоновыйХод.ИсторияДиалогаJSON(ВыбранныйДиалог);
	// Пустая страница диалога, в котором ждут сообщения: показ начнёт опрос.
	Если Пакеты.Количество() = 0 Тогда
		Пакеты.Добавить(ПакетСтатуса(""));
	КонецЕсли;
	Возврат Пакеты;

КонецФункции

// Пакет вопроса пользователя для страницы; объекты из навигационных ссылок и сохранённые файлы регистрируются
// в реестре ссылок.
//  Ход - Структура - Объекты, Документы, Изображений (см. ВложенияСообщения).
//  НомерСообщения - Число - сохранённая реплика, 0 - файлы не сохранены и не скачиваются.
//  Изображения - Массив из Строка - data URL изображений восстановленной реплики.
&НаСервере
Функция ПакетВопросаПользователя(Ход, Текст, ДатаСообщения = Неопределено, НомерСообщения = 0, Изображения = Неопределено)

	Ссылки = ЗарегистрироватьСсылкиХода(Ход);
	Пакет = ОбщегоНазначения.JSONВЗначение(ПакетСообщения("user", Текст, "", Неопределено, Ссылки, ДатаСообщения));
	Пакет.Вставить("docs", Ход.Документы);
	// Файлы в хранилище реплики идут после изображений.
	// Файлы из базы (последние в списке) хранятся ссылкой: значок без скачивания.
	Если НомерСообщения > 0 Тогда
		Реестр = ОбщегоНазначения.JSONВЗначение(СсылкиДиалога);
		Идентификаторы = Новый Массив;
		Сохранено = Ход.Документы.Количество() - ИИА_ФоновыйХод.СвойствоХода(Ход, "ФайлыБазы").Количество();
		Для Индекс = 0 По Сохранено - 1 Цикл
			Реестр.Добавить(Новый Структура("kind, message, index", "file", НомерСообщения, Ход.Изображений + Индекс));
			Идентификаторы.Добавить(Реестр.ВГраница());
		КонецЦикла;
		СсылкиДиалога = ОбщегоНазначения.ЗначениеВJSON(Реестр);
		Пакет.Вставить("files", Идентификаторы);
	КонецЕсли;
	Пакет = ИИА_Маскирование.ДляПользователя(Пакет, Диалог);
	Если Изображения <> Неопределено Тогда
		Пакет.Вставить("images", Изображения);
	КонецЕсли;
	Возврат ОбщегоНазначения.ЗначениеВJSON(Пакет);

КонецФункции

// Изображения и исходные файлы вопроса для хранения с репликой (см. ИИА_Обслуживание.СохранитьСообщение):
// сначала изображения, затем документы. У документов исходник убирается - фоновому заданию он не нужен.
&НаСервереБезКонтекста
Функция ФайлыВопросаДляХранения(Сообщение)

	Файлы = Новый Массив;
	Для Каждого Изображение Из Сообщение.Изображения Цикл
		Позиция = СтрНайти(Изображение, ";base64,");
		ТипMIME = Сред(Изображение, 6, Позиция - 6);
		Файлы.Добавить(Новый Структура("Имя, Вид, ТипMIME, ДвоичныеДанные",
			СтрШаблон(НСтр("ru = 'Изображение %1.%2'"), Файлы.Количество() + 1, ?(ТипMIME = "image/png", "png", "jpg")),
			"image", ТипMIME, Base64Значение(Сред(Изображение, Позиция + 8))));
	КонецЦикла;
	// Исходное имя хранится только с файлом автора; файлы базы хранятся ссылкой во вложениях.
	Для Каждого Документ Из Сообщение.Документы Цикл
		Если ТипЗнч(Документ.ДвоичныеДанные) = Тип("ДвоичныеДанные") Тогда
			Файлы.Добавить(Новый Структура("Имя, Вид, ТипMIME, ДвоичныеДанные", Документ.ИмяПоказа, "file", "",
				Документ.ДвоичныеДанные));
		КонецЕсли;
		Документ.ДвоичныеДанные = Неопределено;
	КонецЦикла;
	Возврат Файлы;

КонецФункции

// Изображения сохранённой реплики как data URL для страницы.
&НаСервере
Функция ИзображенияСообщения(НомерСообщения)

	Результат = Новый Массив;
	Для Каждого Файл Из ИИА_ЧатВызовСервера.ФайлыСообщения(Диалог, НомерСообщения) Цикл
		Если Файл.Вид = "image" Тогда
			Base64 = СтрЗаменить(СтрЗаменить(Base64Строка(Файл.ДвоичныеДанные), Символы.ВК, ""), Символы.ПС, "");
			Результат.Добавить("data:" + Файл.ТипMIME + ";base64," + Base64);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пакет ответа ассистента для страницы; объекты, отчёты, таблицы, источники, черновики, формы и сохранённые
// варианты хода регистрируются в реестре ссылок.
//  Ход - см. ИИА_Агент.ВыполнитьХод или ХодИзВложений, дополнительно Предупреждение - Строка, Цитаты - Массив,
//        НомерСообщения - Число (0 - реплика не сохранена).
//  Последний - Булево - последний ответ диалога: кнопки «Перегенерировать» и «Продолжить».
//
// Возвращаемое значение:
//  Структура - Пакет - Строка, Ссылки - см. ЗарегистрироватьСсылкиХода.
&НаСервере
Функция ПакетОтветаХода(Ход, ДатаСообщения = Неопределено, Последний = Ложь)

	Ссылки = ЗарегистрироватьСсылкиХода(Ход);
	ПакетОтвета = ОбщегоНазначения.JSONВЗначение(ПакетСообщения("assistant", Ход.Текст, Ход.Предупреждение,
		Ход.Таблицы, Ссылки, ДатаСообщения));
	Если Ход.Свойство("Графики") Тогда
		ПакетОтвета.Вставить("charts", Ход.Графики);
	КонецЕсли;
	ПакетОтвета.Вставить("drafts", Ссылки.Черновики);
	ПакетОтвета.Вставить("changes", Ссылки.Изменения);
	ПакетОтвета.Вставить("forms", Ссылки.Формы);
	НомерСообщения = ИИА_ФоновыйХод.ЗначениеСвойства(Ход, "НомерСообщения");
	НомерСообщения = ?(ТипЗнч(НомерСообщения) = Тип("Число"), НомерСообщения, 0);
	Обрыв = ИИА_ФоновыйХод.ЗначениеСвойства(Ход, "Обрыв");
	Обрыв = ?(ТипЗнч(Обрыв) = Тип("Строка"), Обрыв, "");
	ПакетОтвета.Вставить("msg", НомерСообщения);
	ПакетОтвета.Вставить("steps", ИИА_ФоновыйХод.СвойствоХода(Ход, "Шаги"));
	ПакетОтвета.Вставить("sources", Ссылки.Источники);
	ПакетОтвета.Вставить("links", Ссылки.СсылкиТекста);
	ПакетОтвета.Вставить("configs", Ссылки.Варианты);
	ПакетОтвета.Вставить("afiles", Ссылки.ФайлыОтвета);
	ПакетОтвета.Вставить("stop", Обрыв);
	ПакетОтвета.Вставить("canRegenerate", Последний И НомерСообщения > 0);
	ПакетОтвета.Вставить("canContinue", Последний И НомерСообщения > 0 И Не ПустаяСтрока(Обрыв));
	// Модель работает с псевдонимами; пользователю показываем имена (с учётом прав) и номер объекта в диалоге.
	// В историю модели и в сохранённый диалог текст уходит замаскированным.
	ПакетОтвета = ИИА_Маскирование.ДляПользователя(ПакетОтвета, Диалог);
	Возврат Новый Структура("Пакет, Ссылки", ОбщегоНазначения.ЗначениеВJSON(ПакетОтвета), Ссылки);

КонецФункции

// Регистрирует формы в реестре ссылок диалога и возвращает описания кнопок для страницы.
&НаСервереБезКонтекста
Функция ЗарегистрироватьФормы(Формы, Реестр)

	Кнопки = Новый Массив;
	Для Каждого Форма Из Формы Цикл
		Реестр.Добавить(Новый Структура("kind, form, element, data, steps", "form", Форма.ПолноеИмяФормы, Форма.Элемент,
			Форма.ДанныеXML, Форма.Шаги));
		Кнопки.Добавить(Новый Структура("id, title, pick, current", Реестр.ВГраница(), Форма.Заголовок,
			Не ПустаяСтрока(ИмяФормыВыбораОбъекта(Форма.ПолноеИмяФормы)),
			Не ПустаяСтрока(Форма.ДанныеXML)));
	КонецЦикла;
	Возврат Кнопки;

КонецФункции

&НаСервереБезКонтекста
Функция ПакетСтатусаНаСервере(Знач Текст)

	Возврат ПакетСтатуса(Текст);

КонецФункции

