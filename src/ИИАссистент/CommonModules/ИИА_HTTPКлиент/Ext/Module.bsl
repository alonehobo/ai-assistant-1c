#Область ПрограммныйИнтерфейс

// Возвращает HTTP-ответ на отправку окончательного JSON без повторной сериализации.
// Параметры:
//  Адрес - Строка - настроенный HTTP/HTTPS endpoint.
//  ТелоJSON - Строка - предварительно проверенное вызывающим кодом тело.
//  Заголовки - Соответствие - заголовки, в том числе авторизация.
//  Таймаут - Число - общий бюджет вызова в секундах, больше нуля.
//  ПовторПри429 - Булево - один повтор после 429 без указания времени ожидания.
//  РежимПрокси - ПеречислениеСсылка.ИИА_РежимыПрокси - режим подключения; пустой - общая настройка ассистента.
// Возвращаемое значение:
//  Структура - КодСостояния (Число), Заголовки (Соответствие), Тело (Строка).
Функция Post(Адрес, ТелоJSON, Заголовки, Таймаут, ПовторПри429 = Ложь, РежимПрокси = Неопределено) Экспорт

	Возврат ВыполнитьЗапрос("POST", Адрес, ТелоJSON, Заголовки, Таймаут, ПовторПри429, РежимПрокси);

КонецФункции

// Возвращает HTTP-ответ на чтение ресурса, без автоматических повторов.
// Параметры:
//  Адрес - Строка - настроенный HTTP/HTTPS endpoint.
//  Заголовки - Соответствие - заголовки запроса.
//  Таймаут - Число - общий бюджет вызова в секундах, больше нуля.
//  РежимПрокси - ПеречислениеСсылка.ИИА_РежимыПрокси - режим подключения; пустой - общая настройка ассистента.
// Возвращаемое значение:
//  Структура - КодСостояния (Число), Заголовки (Соответствие), Тело (Строка).
Функция Get(Адрес, Заголовки, Таймаут, РежимПрокси = Неопределено) Экспорт

	Возврат ВыполнитьЗапрос("GET", Адрес, "", Заголовки, Таймаут, Ложь, РежимПрокси);

КонецФункции

// Возвращает прокси для запроса к модели. Адреса этого сервера (мост ACP, локальные модели) - без прокси.
// Параметры:
//  Адрес - Строка - HTTP/HTTPS endpoint.
//  РежимПрокси - ПеречислениеСсылка.ИИА_РежимыПрокси - режим подключения; пустой - общая настройка
//    ассистента (константа ИИА_РежимПрокси), пустая настройка - как в настройках 1С.
// Возвращаемое значение:
//  ИнтернетПрокси, Неопределено - Неопределено: системные настройки прокси сервера 1С.
Функция ПроксиДляАдреса(Адрес, РежимПрокси = Неопределено) Экспорт

	Режимы = Перечисления.ИИА_РежимыПрокси;
	Если ЭтоЛокальныйАдрес(Адрес) Тогда
		Возврат Новый ИнтернетПрокси(Ложь);
	КонецЕсли;
	Режим = РежимПрокси;
	Если Не ЗначениеЗаполнено(Режим) Тогда
		УстановитьПривилегированныйРежим(Истина);
		Режим = Константы.ИИА_РежимПрокси.Получить();
	КонецЕсли;
	Если Режим = Режимы.Напрямую Тогда
		Возврат Новый ИнтернетПрокси(Ложь);
	ИначеЕсли Режим = Режимы.СвойПрокси Тогда
		Возврат СвойПрокси();
	Иначе
		Возврат ПолучениеФайловИзИнтернета.ПолучитьПрокси(Адрес);
	КонецЕсли;

КонецФункции

// Возвращает сервер и порт из адреса прокси ассистента.
// Параметры:
//  АдресПрокси - Строка - «сервер:порт», допускается схема http://.
// Возвращаемое значение:
//  Структура - Сервер (Строка), Порт (Число); пустой Сервер - адрес не задан или неверен.
Функция РазобратьАдресПрокси(Знач АдресПрокси) Экспорт

	Результат = Новый Структура("Сервер, Порт", "", 0);
	АдресПрокси = СокрЛП(АдресПрокси);
	Разделитель = СтрНайти(АдресПрокси, "://");
	Если Разделитель > 0 Тогда
		АдресПрокси = Сред(АдресПрокси, Разделитель + 3);
	КонецЕсли;
	Пока СтрЗаканчиваетсяНа(АдресПрокси, "/") Цикл
		АдресПрокси = Лев(АдресПрокси, СтрДлина(АдресПрокси) - 1);
	КонецЦикла;
	Двоеточие = СтрНайти(АдресПрокси, ":", НаправлениеПоиска.СКонца);
	Если Двоеточие < 2 Или СтрНайти(АдресПрокси, "@") > 0 Или СтрНайти(АдресПрокси, "/") > 0 Тогда
		Возврат Результат;
	КонецЕсли;
	ТекстПорта = Сред(АдресПрокси, Двоеточие + 1);
	Если ПустаяСтрока(ТекстПорта) Или Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ТекстПорта) Тогда
		Возврат Результат;
	КонецЕсли;
	Порт = Число(ТекстПорта);
	Если Порт < 1 Или Порт > 65535 Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.Сервер = Лев(АдресПрокси, Двоеточие - 1);
	Результат.Порт = Порт;
	Возврат Результат;

КонецФункции

// Записывает учётные данные прокси ассистента в безопасное хранилище. Вызывающий код проверяет права администратора.
// Параметры:
//  Пользователь - Строка - пустой - прокси без авторизации.
//  Пароль - Строка - Неопределено - сохранённый пароль не меняется.
Процедура СохранитьУчетныеДанныеПрокси(Пользователь, Пароль = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Сохраненные = УчетныеДанныеПрокси();
	ПарольДляЗаписи = ?(Пароль = Неопределено, Сохраненные.Пароль, Пароль);
	Если ПустаяСтрока(Пользователь) Тогда
		ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(ВладелецУчетныхДанныхПрокси());
	Иначе
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ВладелецУчетныхДанныхПрокси(),
			Новый Структура("Пользователь, Пароль", СокрЛП(Пользователь), ПарольДляЗаписи), "УчетныеДанные");
	КонецЕсли;

КонецПроцедуры

// Возвращает пользователя прокси ассистента и признак сохранённого пароля (сам пароль не возвращается).
// Возвращаемое значение:
//  Структура - Пользователь (Строка), ПарольЗаполнен (Булево).
Функция ОписаниеУчетныхДанныхПрокси() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Данные = УчетныеДанныеПрокси();
	Возврат Новый Структура("Пользователь, ПарольЗаполнен", Данные.Пользователь, Не ПустаяСтрока(Данные.Пароль));

КонецФункции

// Возвращает endpoint API с сохранением настроенного сервера, порта и пути.
// Параметры:
//  АдресБазы - Строка - базовый HTTP/HTTPS адрес API без query и fragment.
//  Ресурс - Строка - имя ресурса API без начального слеша.
// Возвращаемое значение:
//  Строка - endpoint; для адреса без пути используется /v1.
Функция АдресРесурса(АдресБазы, Ресурс) Экспорт

	Адрес = ПроверенныйАдрес(АдресБазы);
	Если СтрНайти(Адрес, "?") > 0 Тогда
		ВызватьИсключение НСтр("ru = 'Базовый адрес API не должен содержать параметры запроса.'");
	КонецЕсли;
	СтруктураURL = ИИА_HTTPКоннектор.РазобратьURL(Адрес);
	Пока СтрЗаканчиваетсяНа(Адрес, "/") Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;
	Если СтруктураURL.Путь = "/" Тогда
		Адрес = Адрес + "/v1";
	КонецЕсли;
	Возврат Адрес + "/" + Ресурс;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьЗапрос(Метод, Знач Адрес, ТелоJSON, Заголовки, Таймаут, ПовторПри429, РежимПрокси)

	Адрес = ПроверенныйАдрес(Адрес);
	Если Таймаут < 1 Тогда
		ВызватьИсключение НСтр("ru = 'Время ожидания HTTP должно быть не меньше одной секунды.'");
	КонецЕсли;

	Настройки = ИИА_HTTPКоннектор.НовыеПараметры();
	Настройки.Заголовки = Заголовки;
	Настройки.Данные = ТелоJSON;
	Настройки.ПроверятьSSL = Истина;
	Настройки.РазрешитьПеренаправление = Ложь;
	Настройки.МаксимальноеКоличествоПовторов = 0;
	Настройки.Таймаут = Цел(Таймаут);
	Настройки.Прокси = ПроксиДляАдреса(Адрес, РежимПрокси);
	Сессия = ИИА_HTTPКоннектор.СоздатьСессию();
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Ответ = ИИА_HTTPКоннектор.ВызватьМетод(Метод, Адрес, Настройки, Сессия);
	Если ПовторПри429 И Ответ.КодСостояния = 429 И НетОжиданияПовтора(Ответ.Заголовки) Тогда
		Остаток = Цел(Таймаут - (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000);
		Если Остаток >= 1 Тогда
			Настройки.Таймаут = Остаток;
			Ответ = ИИА_HTTPКоннектор.ВызватьМетод(Метод, Адрес, Настройки, Сессия);
		КонецЕсли;
	КонецЕсли;

	Возврат Новый Структура("КодСостояния, Заголовки, Тело", Ответ.КодСостояния, Ответ.Заголовки,
		ИИА_HTTPКоннектор.КакТекст(Ответ, КодировкаТекста.UTF8));

КонецФункции

Функция НетОжиданияПовтора(Заголовки)

	Для Каждого Заголовок Из Заголовки Цикл
		Если НРег(Заголовок.Ключ) = "retry-after" Тогда
			// Дата, положительный интервал и нераспознанное значение требуют ожидания.
			Возврат СокрЛП(Строка(Заголовок.Значение)) = "0";
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ПроверенныйАдрес(Знач Адрес)

	Адрес = СокрЛП(Адрес);
	Разделитель = СтрНайти(Адрес, "://");
	Если Разделитель = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Для подключения требуется адрес с явной схемой HTTP или HTTPS.'");
	КонецЕсли;
	Схема = НРег(Лев(Адрес, Разделитель - 1));
	Если Схема <> "http" И Схема <> "https" Тогда
		ВызватьИсключение НСтр("ru = 'Для подключения требуется адрес с явной схемой HTTP или HTTPS.'");
	КонецЕсли;
	Если СтрНайти(Адрес, "@") > 0 Или СтрНайти(Адрес, "#") > 0 Тогда
		ВызватьИсключение НСтр("ru = 'Учётные данные и фрагмент в адресе подключения не допускаются.'");
	КонецЕсли;
	Если СтрНайти(Адрес, Символы.ПС) > 0 Или СтрНайти(Адрес, Символы.ВК) > 0
		Или СтрНайти(Адрес, "\") > 0 Тогда
		ВызватьИсключение НСтр("ru = 'Адрес подключения содержит недопустимые символы.'");
	КонецЕсли;
	Адрес = Схема + Сред(Адрес, Разделитель);
	СтруктураURL = ИИА_HTTPКоннектор.РазобратьURL(Адрес);
	Если ПустаяСтрока(СтруктураURL.Сервер) Или СтруктураURL.Порт < 0 Или СтруктураURL.Порт > 65535 Тогда
		ВызватьИсключение НСтр("ru = 'В адресе подключения не указан сервер или неверно задан порт.'");
	КонецЕсли;
	Возврат Адрес;

КонецФункции

Функция ЭтоЛокальныйАдрес(Адрес)

	Сервер = НРег(ИИА_HTTPКоннектор.РазобратьURL(Адрес).Сервер);
	Возврат Сервер = "localhost" Или Сервер = "127.0.0.1" Или Сервер = "[::1]";

КонецФункции

// Прокси, заданный в настройках ассистента: для HTTP и HTTPS, без системных настроек сервера 1С.
Функция СвойПрокси()

	УстановитьПривилегированныйРежим(Истина);
	Адрес = РазобратьАдресПрокси(Константы.ИИА_АдресПрокси.Получить());
	Если ПустаяСтрока(Адрес.Сервер) Тогда
		ВызватьИсключение НСтр("ru = 'Свой прокси ассистента не задан: укажите адрес «сервер:порт» в настройках ассистента.'");
	КонецЕсли;
	Данные = УчетныеДанныеПрокси();
	Прокси = Новый ИнтернетПрокси(Ложь);
	Для Каждого Протокол Из СтрРазделить("http,https", ",") Цикл
		Прокси.Установить(Протокол, Адрес.Сервер, Адрес.Порт, Данные.Пользователь, Данные.Пароль, Ложь);
	КонецЦикла;
	Возврат Прокси;

КонецФункции

// Вызывается в привилегированном режиме.
Функция УчетныеДанныеПрокси()

	Результат = Новый Структура("Пользователь, Пароль", "", "");
	Сохраненные = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ВладелецУчетныхДанныхПрокси(), "УчетныеДанные");
	Если ТипЗнч(Сохраненные) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Результат, Сохраненные);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ВладелецУчетныхДанныхПрокси()

	Возврат "ИИАссистент.Прокси";

КонецФункции

#КонецОбласти
