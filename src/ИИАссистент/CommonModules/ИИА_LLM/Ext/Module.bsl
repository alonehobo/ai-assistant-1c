// BSLLS:CommonModuleInvalidType-off
// Только сервер: вызов с клиента и внешнее соединение намеренно отключены.
// BSLLS:CommonModuleInvalidType-on
// /////////////////////////////////////////////////////////////////////////////////////////////////////
// ИИ-ассистент: вызов языковой модели через OpenAI-совместимый API (chat/completions с tools).
// Ключ API хранится в безопасном хранилище БСП и читается только на сервере.
// Все текстовые части сообщений перед отправкой проходят детекторы периметра (стоп-проверка).
// /////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Вызывает модель. Подключения перебираются по цепочке пользователя (основное, затем резервные):
// при сбое одного провайдера ход продолжается на следующем.
//
// Параметры:
//  Сообщения - Массив из Соответствие - сообщения в формате OpenAI (role, content, tool_calls, tool_call_id).
//  Инструменты - Массив из Соответствие - описания инструментов в формате OpenAI.
//  КлассДанных - Число - 0..4.
//  Модель - СправочникСсылка.ИИА_ПодключенияМоделей, Неопределено - модель, выбранная пользователем в чате:
//    идёт первой в цепочке; при классе К2 и выше сначала проверяется её допустимость.
//  ПредельныйМомент - Число - абсолютный UTC deadline в миллисекундах; 0 без ограничения. После него
//    резервные подключения не перебираются.
//  Кэш - Структура, Неопределено - кэш проверок ПДн хода, см. НовыйКэшПроверок; Неопределено - на один вызов.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * Ошибка - Строка
//   * СообщениеАссистента - Соответствие - сообщение ассистента для добавления в историю хода.
//   * Текст - Строка
//   * ВызовыИнструментов - Массив из Структура:
//       ** Ид - Строка
//       ** Имя - Строка
//       ** Аргументы - Строка - JSON.
//   * ТокеныВход - Число
//   * ТокеныВыход - Число
//   * СкрытоПередОтправкой - Число - сколько фрагментов скрыла стоп-проверка.
//   * Подключение - Строка - подключение, которое ответило.
//   * ПодключениеСсылка - СправочникСсылка.ИИА_ПодключенияМоделей, Неопределено
//   * НайденоВЗапросе - Число - контрольный перехват: сколько фрагментов ПДн или секретов детекторы нашли
//       в окончательном теле запроса (при находках отправка и failover блокируются).
//   * Сбои - Строка - подключения, на которых был сбой перед успешным ответом.
//   * ПричинаЗавершения - Строка - finish_reason ответа: stop, length (ответ обрезан лимитом токенов),
//       tool_calls; пустая строка, если провайдер её не вернул.
//   * ТокеныКэш - Число - входные токены, которые провайдер взял из кэша префикса.
//   * Провайдер - Строка - исполнитель запроса у агрегатора (поле provider ответа), если он его вернул;
//       для моста ACP - модель, которой ответил агент (поле agent_model).
//   * ИстеклоВремя - Булево - вызов не состоялся или прерван из-за ПредельныйМомент.
//   * ТокеныРассуждений - Число - выходные токены рассуждений (completion_tokens_details.reasoning_tokens);
//       0 - провайдер их не вернул или не рассуждал.
//   * Рассуждения - Строка - запрошенный режим рассуждений ответившего подключения: уровень (none...max),
//       budget=<токены> или пустая строка - умолчание провайдера.
//   * КоммерческиЗамаскировано - Число - замен текстового слоя коммерческого маскирования (commercial_masked).
//   * КоммерческихВЗапросе - Число - находок контрольной проверки коммерческих наименований (commercial_in_request).
//
Функция ВызватьМодель(Сообщения, Инструменты, КлассДанных = 1, Модель = Неопределено, ПредельныйМомент = 0,
	Кэш = Неопределено) Экспорт

	Результат = Новый Структура("Успех, Ошибка, СообщениеАссистента, Текст, ВызовыИнструментов, ТокеныВход, ТокеныВыход, СкрытоПередОтправкой, Подключение, Сбои, ПодключениеСсылка, НайденоВЗапросе, ПричинаЗавершения, ТокеныКэш, Провайдер, ИстеклоВремя, ТокеныРассуждений, Рассуждения, КоммерческиЗамаскировано, КоммерческихВЗапросе",
		Ложь, "", Неопределено, "", Новый Массив, 0, 0, 0, "", "", Неопределено, 0, "", 0, "", Ложь, 0, "", 0, 0);

	ЕстьИзображения = ЕстьЧастиТипа(Сообщения, "image_url");
	ЕстьДокументы = ЕстьЧастиТипа(Сообщения, "file");
	Если КлассДанных >= 2 И ЗначениеЗаполнено(Модель)
		И Не ЕстьПодключениеДляИсследования(КлассДанных, Модель, ЕстьИзображения, ЕстьДокументы) Тогда
		Результат.Ошибка = НСтр("ru = 'DATA_CLASS_NOT_ALLOWED: выбранная модель не разрешена для класса данных исследования. Выберите разрешённую модель.'");
		Возврат Результат;
	КонецЕсли;
	Цепочка = ЦепочкаПодключений(ЕстьИзображения, КлассДанных, ЕстьДокументы, Модель);
	Если Цепочка.Количество() = 0 Тогда
		Если ЕстьДокументы И ЦепочкаПодключений(ЕстьИзображения, КлассДанных).Количество() > 0 Тогда
			Результат.Ошибка = НСтр("ru = 'Нет подключения к модели, принимающей документы PDF. Выберите в чате модель с документами, уберите PDF или обратитесь к администратору.'");
		ИначеЕсли ЕстьИзображения Тогда
			Результат.Ошибка = НСтр("ru = 'Нет подключения к модели, принимающей изображения. Уберите скриншоты или обратитесь к администратору.'");
		ИначеЕсли КлассДанных > 1 И ЦепочкаПодключений(Ложь, 1).Количество() > 0 Тогда
			Результат.Ошибка = СтрШаблон(НСтр("ru = 'Для данных класса %1 нет разрешённой модели. История сохраняет свой класс. Начните новый диалог без истории для нового общего вопроса либо обратитесь к администратору за разрешённой моделью.'"),
				ИИА_КлассыДанных.ПредставлениеКласса(КлассДанных));
		Иначе
			Результат.Ошибка = НСтр("ru = 'Нет настроенной разрешённой модели. Обратитесь к администратору для настройки подключения или назначения модели профилю.'");
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	// Проверка ПДн большого контекста идёт десятки секунд: после срока её не начинаем.
	Если ВремяИстекло(ПредельныйМомент) Тогда
		Результат.ИстеклоВремя = Истина;
		Результат.Ошибка = ОшибкаВремениИсследования();
		Возврат Результат;
	КонецЕсли;
	Если Кэш = Неопределено Тогда
		Кэш = НовыйКэшПроверок();
	КонецЕсли;

	Скрыто = 0;
	ОчищенныеСообщения = ОчищенныеСообщения(Сообщения, Скрыто, Кэш);
	Результат.СкрытоПередОтправкой = Скрыто;

	Сбои = Новый Массив;
	Ответ = Неопределено;
	ОшибкаМаскирования = "";
	Подготовленные = Новый Соответствие; // "Т3" / "Т12" -> результат ИИА_Маскирование.СообщенияДляДоверия
	ДовериеОтветившего = "";
	Если Не Кэш.Свойство("Маскирование") Тогда
		Кэш.Вставить("Маскирование", ИИА_Маскирование.НовыйКэш());
	КонецЕсли;
	Для Каждого Подключение Из Цепочка Цикл
		Если ВремяИстекло(ПредельныйМомент) Тогда
			// Резервная модель уже не успеет: подготовка её запроса только отнимет время финального ответа.
			Результат.ИстеклоВремя = Истина;
			Сбои.Добавить(СтрШаблон("%1: %2", Подключение.Наименование, ОшибкаВремениИсследования()));
			Прервать;
		КонецЕсли;
		// Коммерческое маскирование и номера диалога зависят от уровня доверия подключения: тело готовится
		// для каждого подключения цепочки (результат переиспользуется для подключений того же уровня).
		КлючДоверия = ?(ИИА_Маскирование.ЭтоДовериеТ3(Подключение.Доверие), "Т3", "Т12");
		Подготовка = Подготовленные.Получить(КлючДоверия);
		Если Подготовка = Неопределено Тогда
			Подготовка = ИИА_Маскирование.СообщенияДляДоверия(ОчищенныеСообщения, Подключение.Доверие,
				Кэш.Маскирование);
			Подготовленные.Вставить(КлючДоверия, Подготовка);
		КонецЕсли;
		Если Не Подготовка.Успех Тогда
			// Безопасный отказ: эта модель не получает запрос, цепочка переходит к следующей (Т1/Т2 его получат).
			ОшибкаМаскирования = Подготовка.Ошибка;
			Сбои.Добавить(СтрШаблон("%1: %2", Подключение.Наименование, Подготовка.КодОшибки));
			ЗаписьЖурналаРегистрации("ИИАссистент.LLM", УровеньЖурналаРегистрации.Предупреждение, , ,
				СтрШаблон("%1: %2", Подключение.Наименование, Подготовка.КодОшибки));
			Продолжить;
		КонецЕсли;
		Результат.КоммерческиЗамаскировано = Подготовка.Замаскировано;
		Результат.КоммерческихВЗапросе = Подготовка.ВЗапросе;
		СообщенияЗапроса = Подготовка.Сообщения;
		НастройкиЗапроса = Подключение.НастройкиМодели;
		Если Подготовка.РассужденияУдалены И Подключение.Протокол = Перечисления.ИИА_ПротоколыAPI.Anthropic Тогда
			// Рассуждения другой модели удалены: Anthropic с включёнными рассуждениями отклонит продолжение tool use.
			НастройкиЗапроса = НастройкиБезРассуждений(НастройкиЗапроса);
		КонецЕсли;
		Диагностика = Новый Массив;
		Попытка
			ТелоJSON = ТелоЗапроса(СообщенияЗапроса, Инструменты, Подключение.Модель, Подключение.Протокол,
				Подключение.ПараметрыЗапроса, НастройкиЗапроса);
			Результат.НайденоВЗапросе = ПроверитьТелоЗапроса(ТелоJSON, Диагностика, Кэш);
		Исключение
			// Ни исходное тело, ни подробности разбора не должны попасть в ошибку или журнал.
			ЗаписьЖурналаРегистрации("ИИАссистент.LLM", УровеньЖурналаРегистрации.Предупреждение, , , "REQUEST_JSON_INVALID");
			Результат.НайденоВЗапросе = 1;
		КонецПопытки;
		// Неразборчивое тело или аргументы вызова не очистить - такой запрос не отправляем.
		Если Результат.НайденоВЗапросе > 0 И (Диагностика.Количество() = 0
			Или Диагностика[0].Причина = НСтр("ru = 'аргументы не JSON-объект'")) Тогда
			Результат.Ошибка = СообщениеОБлокировке(Диагностика, СообщенияЗапроса);
			ЗаписьЖурналаРегистрации("ИИАссистент.LLM", УровеньЖурналаРегистрации.Предупреждение, , ,
				СтрШаблон(НСтр("ru = 'Запрос к модели %1 не отправлен: %2'"), Подключение.Наименование,
					ОписаниеДиагностики(Диагностика, СообщенияЗапроса, Символы.ПС)));
			Возврат Результат;
		ИначеЕсли Результат.НайденоВЗапросе > 0 Тогда
			// Контрольная проверка нашла то, что пропустила очистка сообщений: скрываем найденное во всём
			// теле запроса и отправляем, а не обрываем ход. В журнал - место и категория, без значений.
			Попытка
				ТелоJSON = ОчиститьТелоЗапроса(ТелоJSON);
			Исключение
				Результат.Ошибка = СообщениеОБлокировке(Диагностика, СообщенияЗапроса);
				ЗаписьЖурналаРегистрации("ИИАссистент.LLM", УровеньЖурналаРегистрации.Предупреждение, , ,
					"REQUEST_CLEAN_FAILED");
				Возврат Результат;
			КонецПопытки;
			ЗаписьЖурналаРегистрации("ИИАссистент.LLM", УровеньЖурналаРегистрации.Предупреждение, , ,
				СтрШаблон(НСтр("ru = 'В запросе к модели %1 скрыты значения (находок: %2).
				|%3'"), Подключение.Наименование, Результат.НайденоВЗапросе, ОписаниеДиагностики(Диагностика, СообщенияЗапроса, Символы.ПС)));
			// Проверяется именно окончательное тело, передаваемое HTTP, включая разобранные arguments.
			// Тело без находок первой проверки не менялось - она и была проверкой окончательного тела.
			Диагностика = Новый Массив;
			Результат.НайденоВЗапросе = ПроверитьТелоЗапроса(ТелоJSON, Диагностика, Кэш);
			Если Результат.НайденоВЗапросе > 0 Тогда
				Результат.Ошибка = СообщениеОБлокировке(Диагностика, СообщенияЗапроса);
				ЗаписьЖурналаРегистрации("ИИАссистент.LLM", УровеньЖурналаРегистрации.Предупреждение, , ,
					"REQUEST_BLOCKED_AFTER_CLEAN");
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
		Ответ = ОтправитьЗапрос(Подключение, ТелоJSON, ПредельныйМомент);
		Если Ответ.Успех Тогда
			ДовериеОтветившего = КлючДоверия;
			Результат.Подключение = Подключение.Наименование;
			Результат.ПодключениеСсылка = Подключение.Подключение;
			Результат.Рассуждения = ЗапрошенныеРассуждения(Подключение.НастройкиМодели);
			Прервать;
		КонецЕсли;
		Сбои.Добавить(СтрШаблон("%1: %2", Подключение.Наименование, Ответ.Ошибка));
		Если ВремяИстекло(ПредельныйМомент) Тогда
			// Таймаут запроса был урезан до остатка срока: резервные подключения его уже не получат.
			Результат.ИстеклоВремя = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Результат.Сбои = СтрСоединить(Сбои, "; ");

	Если Ответ = Неопределено И Не ПустаяСтрока(ОшибкаМаскирования) Тогда
		Результат.Ошибка = ОшибкаМаскирования;
		Возврат Результат;
	ИначеЕсли Ответ = Неопределено Или Не Ответ.Успех Тогда
		Результат.Ошибка = НСтр("ru = 'Языковая модель недоступна'") + " (" + Результат.Сбои + ").";
		Возврат Результат;
	КонецЕсли;

	Попытка
		Данные = ОбщегоНазначения.JSONВЗначение(Ответ.Тело, , Истина);
		Выбор = Данные.Получить("choices")[0];
		Сообщение = Выбор.Получить("message");
	// Повреждённый ответ модели даёт явный отказ; сырое тело не пишется в журнал.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Результат.Ошибка = НСтр("ru = 'Модель вернула ответ неожиданного формата.'");
		Возврат Результат;
	КонецПопытки;

	Результат.Успех = Истина;
	// Автор ответа: рассуждения модели Т1/Т2 модели Т3 не передаются (см. ИИА_Маскирование.СообщенияДляДоверия).
	Сообщение.Вставить(ИИА_Маскирование.КлючДовериеАвтора(), ДовериеОтветившего);
	Результат.СообщениеАссистента = Сообщение;
	Текст = Сообщение.Получить("content");
	Результат.Текст = ?(ТипЗнч(Текст) = Тип("Строка"), Текст, "");
	Причина = Выбор.Получить("finish_reason");
	Результат.ПричинаЗавершения = ?(ТипЗнч(Причина) = Тип("Строка"), Причина, "");

	Вызовы = Сообщение.Получить("tool_calls");
	Если ТипЗнч(Вызовы) = Тип("Массив") Тогда
		Для Каждого Вызов Из Вызовы Цикл
			Функция_ = Вызов.Получить("function");
			Если Функция_ = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Аргументы = Функция_.Получить("arguments");
			Результат.ВызовыИнструментов.Добавить(Новый Структура("Ид, Имя, Аргументы",
				Строка(Вызов.Получить("id")), Строка(Функция_.Получить("name")),
				?(ТипЗнч(Аргументы) = Тип("Строка"), Аргументы, "{}")));
		КонецЦикла;
	КонецЕсли;

	Использование = Данные.Получить("usage");
	Если ТипЗнч(Использование) = Тип("Соответствие") Тогда
		Результат.ТокеныВход = ЧислоИлиНоль(Использование.Получить("prompt_tokens"));
		Результат.ТокеныВыход = ЧислоИлиНоль(Использование.Получить("completion_tokens"));
		Результат.ТокеныКэш = ТокеныИзКэша(Использование);
		Подробности = Использование.Получить("completion_tokens_details");
		Если ТипЗнч(Подробности) = Тип("Соответствие") Тогда
			Результат.ТокеныРассуждений = ЧислоИлиНоль(Подробности.Получить("reasoning_tokens"));
		КонецЕсли;
	КонецЕсли;
	Провайдер = Данные.Получить("provider");
	Результат.Провайдер = ?(ТипЗнч(Провайдер) = Тип("Строка"), Провайдер, "");
	Если ПустаяСтрока(Результат.Провайдер) Тогда
		Результат.Провайдер = МодельАгента(Данные);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает очищенное тело запроса. Разбирает arguments инструментов как JSON и сохраняет двоичные
// вложения только в позициях content. Результат требует контрольной проверки перед HTTP.
//
// Параметры:
//  ТелоJSON - Строка
//
// Возвращаемое значение:
//  Строка - очищенный JSON.
//
Функция ОчиститьТелоЗапроса(ТелоJSON) Экспорт

	Тело = ОбщегоНазначения.JSONВЗначение(ТелоJSON, , Истина);
	Возврат ОбщегоНазначения.ЗначениеВJSON(ОчищенноеЗначениеЗапроса(Тело));

КонецФункции

// Возвращает кэш проверок ПДн для вызовов модели одного хода. Очистка детерминирована (псевдонимы - по соли
// и идентификатору), поэтому строка истории, уже очищенная или проверенная в этом ходе, повторно не сканируется.
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги, Неопределено - диалог хода (карта номеров объектов).
//  Канал - Строка - "chat" или "http".
//
// Возвращаемое значение:
//  Структура:
//   * Очищенные - Соответствие из КлючИЗначение - исходная строка -> Структура (Текст, Скрыто).
//   * Проверенные - Соответствие из КлючИЗначение - строка без находок контрольной проверки -> Истина.
//   * Маскирование - Структура - см. ИИА_Маскирование.НовыйКэш.
//
Функция НовыйКэшПроверок(Диалог = Неопределено, Канал = "chat") Экспорт

	Возврат Новый Структура("Очищенные, Проверенные, Маскирование", Новый Соответствие, Новый Соответствие,
		ИИА_Маскирование.НовыйКэш(Диалог, Канал));

КонецФункции

// Есть ли в эффективной цепочке профиля текущего пользователя используемое подключение с доверием Т3
// или без уровня доверия (условие коммерческого маскирования).
//
// Возвращаемое значение:
//  Булево
//
Функция ЕстьПодключениеТ3ВЦепочке() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Для Каждого Подключение Из ПодключенияПрофиля(ИИА_ПрофилиДоступа.ЭффективныйПрофиль(Пользователи.ТекущийПользователь())) Цикл
		Описание = ОписаниеПодключения(Подключение);
		Если Описание <> Неопределено И ИИА_Маскирование.ЭтоДовериеТ3(Описание.Доверие) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ПроверитьТелоЗапроса(ТелоJSON, Диагностика = Неопределено, Кэш = Неопределено) Экспорт

	Находок = 0;
	Попытка
		Данные = ОбщегоНазначения.JSONВЗначение(ТелоJSON, , Истина);
		Если ТипЗнч(Данные) <> Тип("Соответствие") Или ТипЗнч(Данные.Получить("messages")) <> Тип("Массив")
			И ТипЗнч(Данные.Получить("input")) <> Тип("Массив") Тогда
			Возврат 1;
		КонецЕсли;
		ПроверитьЗначениеЗапроса(Данные, Находок, "тело", "", Диагностика, Кэш);
	Исключение
		// Счётчик сохраняет контракт: невозможность проверки также закрывает отправку.
		ЗаписьЖурналаРегистрации("ИИАссистент.LLM", УровеньЖурналаРегистрации.Предупреждение, , , "REQUEST_CHECK_FAILED");
		Возврат Макс(1, Находок);
	КонецПопытки;
	Возврат Находок;

КонецФункции

// Возвращает окончательный JSON выбранного протокола до контрольной проверки и HTTP.
//
// Параметры:
//  Сообщения - Массив из Соответствие - сообщения OpenAI, предварительно очищенные вызывающим кодом.
//  Инструменты - Массив из Соответствие - описания инструментов OpenAI.
//  Модель - Строка - идентификатор модели.
//  Протокол - ПеречислениеСсылка.ИИА_ПротоколыAPI - OpenAI, Anthropic или локальный мост ACP.
//  ПараметрыЗапроса - Строка - JSON дополнительных полей тела из подключения, см. ПараметрыЗапросаИзСтроки.
//  НастройкиМодели - Структура, Неопределено - поля подключения, см. НовыеНастройкиМодели; Неопределено -
//    прежние умолчания: температура 0,1, без рассуждений и лимита (кроме обязательного лимита Anthropic).
//
// Возвращаемое значение:
//  Строка - окончательное тело; ошибка преобразования запрещает отправку.
//
Функция ТелоЗапроса(Сообщения, Инструменты, Модель, Протокол, ПараметрыЗапроса = "", НастройкиМодели = Неопределено) Экспорт

	Если НастройкиМодели = Неопределено Тогда
		НастройкиМодели = НовыеНастройкиМодели();
	КонецЕсли;
	Если Протокол = Перечисления.ИИА_ПротоколыAPI.Anthropic Тогда
		Тело = ТелоAnthropic(Сообщения, Инструменты, Модель);
	ИначеЕсли Протокол = Перечисления.ИИА_ПротоколыAPI.GigaChat Тогда
		Тело = ТелоGigaChat(Сообщения, Инструменты, Модель);
	ИначеЕсли Протокол = Перечисления.ИИА_ПротоколыAPI.OpenAIResponses Тогда
		Тело = ТелоResponses(Сообщения, Инструменты, Модель);
	Иначе
		Тело = Новый Соответствие;
		Тело.Вставить("model", Модель);
		Тело.Вставить("messages", СообщенияБезСлужебныхПолей(Сообщения));
		Если Инструменты.Количество() > 0 Тогда
			Тело.Вставить("tools", Инструменты);
			Тело.Вставить("tool_choice", "auto");
		КонецЕсли;
	КонецЕсли;
	Если Протокол <> Перечисления.ИИА_ПротоколыAPI.ACP Тогда
		ДобавитьПоляМодели(Тело, Протокол, НастройкиМодели);
		ДобавитьПараметрыЗапроса(Тело, ПараметрыЗапроса);
	КонецЕсли;
	Возврат ОбщегоНазначения.ЗначениеВJSON(Тело);

КонецФункции

// Поля подключения, которые переводятся в тело запроса по провайдеру.
//
// Возвращаемое значение:
//  Структура:
//   * Провайдер - ПеречислениеСсылка.ИИА_ПровайдерыМоделей
//   * Рассуждения - ПеречислениеСсылка.ИИА_РежимыРассуждений - пустая ссылка: умолчание провайдера.
//   * БюджетРассуждений - Число - токены; 0 не задан.
//   * МаксимумТокенов - Число - 0 по умолчанию.
//   * ЗадатьТемпературу - Булево
//   * Температура - Число
//   * ПорядокПровайдеров - Строка - провайдеры агрегатора через запятую.
//   * РазрешитьДругихПровайдеров - Булево
//
Функция НовыеНастройкиМодели() Экспорт

	Возврат Новый Структура(ПоляНастроекМодели(), Перечисления.ИИА_ПровайдерыМоделей.ПустаяСсылка(),
		Перечисления.ИИА_РежимыРассуждений.ПустаяСсылка(), 0, 0, Истина, 0.1, "", Истина);

КонецФункции

// Свойства провайдера для формы подключения.
//
// Параметры:
//  Провайдер - ПеречислениеСсылка.ИИА_ПровайдерыМоделей
//
// Возвращаемое значение:
//  Структура:
//   * Адрес - Строка - адрес API по умолчанию.
//   * Протокол - ПеречислениеСсылка.ИИА_ПротоколыAPI
//   * Температура - Булево - передавать ли температуру по умолчанию: модели с рассуждениями её не принимают.
//   * Агрегатор - Булево - провайдер маршрутизирует запросы к другим провайдерам.
//   * Бюджет - Булево - принимает бюджет рассуждений в токенах.
//   * ПримерМодели - Строка
//   * Рассуждения - Булево - управление рассуждениями доступно.
//   * ПодсказкаРассуждений - Строка - как поле «Рассуждения» попадает в запрос.
//   * ПодсказкаКлюча - Строка - что вводится в поле «Ключ API».
//
Функция НастройкиПровайдера(Провайдер) Экспорт

	Провайдеры = Перечисления.ИИА_ПровайдерыМоделей;
	Протоколы = Перечисления.ИИА_ПротоколыAPI;
	Результат = Новый Структура("Адрес, Протокол, Температура, Агрегатор, Бюджет, ПримерМодели, Рассуждения, ПодсказкаРассуждений, ПодсказкаКлюча",
		"", Протоколы.OpenAI, Истина, Ложь, Ложь, НСтр("ru = 'выберите кнопкой выбора или введите'"), Истина,
		НСтр("ru = 'Передаётся как reasoning_effort (none, low, medium, high).'"), "");
	Если Провайдер = Провайдеры.OpenAI Тогда
		// Новые модели с рассуждениями принимают инструменты только в Responses; chat/completions остаётся
		// для прежних подключений и выбирается полем «Протокол».
		Результат.Адрес = "https://api.openai.com/v1";
		Результат.Протокол = Протоколы.OpenAIResponses;
		Результат.Температура = Ложь;
		Результат.ПодсказкаРассуждений = НСтр("ru = 'reasoning.effort (Responses) или reasoning_effort (chat/completions): none, minimal, low, medium, high, xhigh. Набор уровней зависит от модели. С рассуждениями температура не передаётся.'");
	ИначеЕсли Провайдер = Провайдеры.Anthropic Тогда
		Результат.Адрес = "https://api.anthropic.com/v1";
		Результат.Протокол = Протоколы.Anthropic;
		Результат.Температура = Ложь;
		Результат.Бюджет = Истина;
		Результат.ПодсказкаРассуждений = НСтр("ru = 'Адаптивные рассуждения с output_config.effort (low...max). Бюджет в токенах - только для моделей до 4.6. Новые модели не принимают температуру и выключение рассуждений.'");
	ИначеЕсли Провайдер = Провайдеры.GoogleGemini Тогда
		Результат.Адрес = "https://generativelanguage.googleapis.com/v1beta/openai";
		Результат.Температура = Ложь;
		Результат.ПодсказкаРассуждений = НСтр("ru = 'reasoning_effort: none, minimal, low, medium, high. Gemini 3 рассуждения полностью не выключает.'");
	ИначеЕсли Провайдер = Провайдеры.DeepSeek Тогда
		Результат.Адрес = "https://api.deepseek.com/v1";
		Результат.ПодсказкаРассуждений = НСтр("ru = 'thinking (enabled/disabled) и reasoning_effort: low, high, max. Без рассуждений ответ быстрее.'");
	ИначеЕсли Провайдер = Провайдеры.OpenRouter Или Провайдер = Провайдеры.RouterAI Тогда
		Результат.Адрес = ?(Провайдер = Провайдеры.OpenRouter, "https://openrouter.ai/api/v1", "https://routerai.ru/api/v1");
		Результат.Агрегатор = Истина;
		Результат.Бюджет = Истина;
		Результат.ПодсказкаРассуждений = НСтр("ru = 'Объект reasoning: effort (none...xhigh) или max_tokens при заданном бюджете. Агрегатор переводит его в поля провайдера модели.'");
	ИначеЕсли Провайдер = Провайдеры.YandexAI Тогда
		Результат.Адрес = "https://llm.api.cloud.yandex.net/v1";
		Результат.ПримерМодели = "gpt://<идентификатор каталога>/yandexgpt/latest";
		Результат.ПодсказкаРассуждений = НСтр("ru = 'reasoning_effort: low, medium, high. Выключение рассуждений не передаётся: часть моделей его не поддерживает.'");
	ИначеЕсли Провайдер = Провайдеры.ZAI Тогда
		Результат.Адрес = "https://api.z.ai/api/paas/v4";
		Результат.ПодсказкаРассуждений = НСтр("ru = 'thinking: enabled или disabled, уровня нет. Новые GLM рассуждения не выключают.'");
	ИначеЕсли Провайдер = Провайдеры.Qwen Тогда
		Результат.Адрес = "https://dashscope-intl.aliyuncs.com/compatible-mode/v1";
		Результат.Бюджет = Истина;
		Результат.ПодсказкаРассуждений = НСтр("ru = 'enable_thinking (да/нет) и thinking_budget при заданном бюджете. Адрес зависит от региона ключа.'");
	ИначеЕсли Провайдер = Провайдеры.Mistral Тогда
		Результат.Адрес = "https://api.mistral.ai/v1";
		Результат.ПодсказкаРассуждений = НСтр("ru = 'reasoning_effort: none или high.'");
	ИначеЕсли Провайдер = Провайдеры.xAI Тогда
		Результат.Адрес = "https://api.x.ai/v1";
		Результат.Температура = Ложь;
		Результат.ПодсказкаРассуждений = НСтр("ru = 'reasoning_effort: low, medium, high, xhigh. Выключить рассуждения нельзя.'");
	ИначеЕсли Провайдер = Провайдеры.GigaChat Тогда
		Результат.Адрес = "https://gigachat.devices.sberbank.ru/api/v1";
		Результат.Протокол = Протоколы.GigaChat;
		Результат.ПримерМодели = "GigaChat-2-Max";
		Результат.Рассуждения = Ложь;
		Результат.ПодсказкаКлюча = НСтр("ru = 'ключ авторизации (Authorization key)'");
	ИначеЕсли Провайдер = Провайдеры.Ollama Тогда
		Результат.Адрес = "http://localhost:11434/v1";
		Результат.ПримерМодели = "qwen3";
	ИначеЕсли Провайдер = Провайдеры.ACP Тогда
		Результат.Адрес = "http://127.0.0.1:18765/v1";
		Результат.Протокол = Протоколы.ACP;
		Результат.ПримерМодели = НСтр("ru = 'выберите агента, установленного на этом компьютере'");
		Результат.Рассуждения = Ложь;
		Результат.ПодсказкаРассуждений = "";
		Результат.ПодсказкаКлюча = НСтр("ru = 'заполняется автоматически при запуске моста'");
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Совпадает ли адрес с адресом по умолчанию одного из провайдеров: такой адрес форма меняет при смене провайдера.
//
// Параметры:
//  Адрес - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоАдресПровайдераПоУмолчанию(Адрес) Экспорт

	Нормализованный = НормализованныйАдрес(Адрес);
	Для Каждого Провайдер Из Метаданные.Перечисления.ИИА_ПровайдерыМоделей.ЗначенияПеречисления Цикл
		Если НормализованныйАдрес(НастройкиПровайдера(Перечисления.ИИА_ПровайдерыМоделей[Провайдер.Имя]).Адрес)
			= Нормализованный Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Провайдер прежнего подключения по адресу API и протоколу.
//
// Параметры:
//  Адрес - Строка
//  Протокол - ПеречислениеСсылка.ИИА_ПротоколыAPI
//
// Возвращаемое значение:
//  ПеречислениеСсылка.ИИА_ПровайдерыМоделей - Другой, если адрес не узнан.
//
Функция ПровайдерПоАдресу(Адрес, Протокол) Экспорт

	Провайдеры = Перечисления.ИИА_ПровайдерыМоделей;
	Если Протокол = Перечисления.ИИА_ПротоколыAPI.ACP Тогда
		Возврат Провайдеры.ACP;
	КонецЕсли;
	Сервер = "";
	Попытка
		Сервер = НРег(ИИА_HTTPКоннектор.РазобратьURL(СокрЛП(Адрес)).Сервер);
	// Неразборчивый адрес не узнаётся: подключение остаётся с провайдером «Другой».
	Исключение // BSLLS:MissingCodeTryCatchEx-off
	КонецПопытки;
	Узлы = Новый Соответствие;
	Узлы.Вставить("api.openai.com", Провайдеры.OpenAI);
	Узлы.Вставить("api.anthropic.com", Провайдеры.Anthropic);
	Узлы.Вставить("generativelanguage.googleapis.com", Провайдеры.GoogleGemini);
	Узлы.Вставить("api.deepseek.com", Провайдеры.DeepSeek);
	Узлы.Вставить("openrouter.ai", Провайдеры.OpenRouter);
	Узлы.Вставить("routerai.ru", Провайдеры.RouterAI);
	Узлы.Вставить("llm.api.cloud.yandex.net", Провайдеры.YandexAI);
	Узлы.Вставить("ai.api.cloud.yandex.net", Провайдеры.YandexAI);
	Узлы.Вставить("api.z.ai", Провайдеры.ZAI);
	Узлы.Вставить("api.mistral.ai", Провайдеры.Mistral);
	Узлы.Вставить("api.x.ai", Провайдеры.xAI);
	Узлы.Вставить("gigachat.devices.sberbank.ru", Провайдеры.GigaChat);
	Провайдер = Узлы.Получить(Сервер);
	Если Провайдер = Неопределено И СтрЗаканчиваетсяНа(Сервер, ".aliyuncs.com") Тогда
		Провайдер = Провайдеры.Qwen;
	ИначеЕсли Провайдер = Неопределено И СтрНайти(Адрес, ":11434") > 0 Тогда
		Провайдер = Провайдеры.Ollama;
	КонецЕсли;
	// Anthropic-совместимый адрес другого провайдера (например, DeepSeek /anthropic) остаётся «Другим»
	// со своим протоколом: свойства провайдера по умолчанию сменили бы протокол. Пустой протокол прежних
	// подключений означает OpenAI-совместимый.
	ПротоколПодключения = ?(ЗначениеЗаполнено(Протокол), Протокол, Перечисления.ИИА_ПротоколыAPI.OpenAI);
	ЭтоПротоколOpenAI = Провайдер = Провайдеры.OpenAI
		И ПротоколПодключения = Перечисления.ИИА_ПротоколыAPI.OpenAI;
	Если Провайдер = Неопределено
		Или ПротоколПодключения <> НастройкиПровайдера(Провайдер).Протокол И Не ЭтоПротоколOpenAI Тогда
		Провайдер = Провайдеры.Другой;
	КонецЕсли;
	Возврат Провайдер;

КонецФункции

// Переносит в поля прежнего подключения провайдер и известные поля строки «Параметры запроса».
// Поле переносится, только если тело запроса из новых полей совпадает с прежним; иначе строка остаётся как есть.
// Прежнее тело всегда содержало температуру 0,1 и лимит 4096 для Anthropic: они переносятся в поля, кроме
// температуры Anthropic, которую новые модели Claude отклоняют.
//
// Параметры:
//  Подключение - СправочникОбъект.ИИА_ПодключенияМоделей - запись выполняет вызывающий код.
//
Процедура ПеренестиПоляПодключения(Подключение) Экспорт

	Провайдеры = Перечисления.ИИА_ПровайдерыМоделей;
	Подключение.Провайдер = ПровайдерПоАдресу(Подключение.АдресAPI, Подключение.Протокол);
	ЭтоAnthropic = Подключение.Протокол = Перечисления.ИИА_ПротоколыAPI.Anthropic;
	Подключение.ЗадатьТемпературу = Не ЭтоAnthropic И Подключение.Провайдер <> Провайдеры.ACP;
	Подключение.Температура = ?(Подключение.ЗадатьТемпературу, 0.1, 0);
	Подключение.МаксимумТокенов = ?(ЭтоAnthropic, 4096, 0);
	Если Подключение.Провайдер = Провайдеры.ACP Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Параметры = ПараметрыЗапросаИзСтроки(Подключение.ПараметрыЗапроса);
	// Неразборчивая строка остаётся как есть: её покажет проверка заполнения при записи формы.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат;
	КонецПопытки;
	Если Параметры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Настройки = НовыеНастройкиМодели();
	ЗаполнитьЗначенияСвойств(Настройки, Подключение, ПоляНастроекМодели());
	Перенесенные = ПоляИзПараметровЗапроса(Параметры, Настройки);
	Если Перенесенные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Новые = Новый Соответствие;
	ДобавитьПоляМодели(Новые, Подключение.Протокол, Настройки);
	Для Каждого Поле Из Новые Цикл
		Прежнее = Параметры.Получить(Поле.Ключ);
		Если Прежнее = Неопределено И (Поле.Ключ = "temperature" Или Поле.Ключ = "max_tokens" И ЭтоAnthropic) Тогда
			Продолжить; // прежние умолчания тела, см. описание
		ИначеЕсли Прежнее = Неопределено Или Не ЗначенияJSONРавны(Прежнее, Поле.Значение) Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Ключ Из Перенесенные Цикл
		Если Новые.Получить(Ключ) = Неопределено Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	ЗаполнитьЗначенияСвойств(Подключение, Настройки, ПоляНастроекМодели());
	Для Каждого Ключ Из Перенесенные Цикл
		Параметры.Удалить(Ключ);
	КонецЦикла;
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Параметры);
	Подключение.ПараметрыЗапроса = ?(Параметры.Количество() = 0, "", Запись.Закрыть());

КонецПроцедуры

// Список моделей провайдера по GET {адрес}/models для выбора в форме подключения.
//
// Параметры:
//  Подключение - СправочникСсылка.ИИА_ПодключенияМоделей - владелец сохранённого ключа.
//  Протокол - ПеречислениеСсылка.ИИА_ПротоколыAPI
//  Адрес - Строка - адрес API из формы.
//  Ключ - Строка - введённый ключ; пустой - сохранённый ключ подключения.
//  ОбластьДоступа - Строка - scope ключа авторизации GigaChat.
//  РежимПрокси - ПеречислениеСсылка.ИИА_РежимыПрокси - режим из формы; пустой - общая настройка ассистента.
//
// Возвращаемое значение:
//  Структура:
//   * Модели - Массив из Строка - идентификаторы по алфавиту.
//   * Ошибка - Строка - пустая при успехе.
//
Функция МоделиПровайдера(Подключение, Протокол, Адрес, Ключ, ОбластьДоступа = "", РежимПрокси = Неопределено) Экспорт

	Результат = Новый Структура("Модели, Ошибка", Новый Массив, "");
	Если Протокол = Перечисления.ИИА_ПротоколыAPI.ACP Тогда
		Результат.Ошибка = НСтр("ru = 'Агентов ACP перечисляет мост на компьютере пользователя: выберите модель в форме подключения.'");
		Возврат Результат;
	ИначеЕсли ПустаяСтрока(Адрес) Тогда
		Результат.Ошибка = НСтр("ru = 'Укажите адрес API.'");
		Возврат Результат;
	КонецЕсли;
	КлючЗапроса = СокрЛП(Ключ);
	ВведенКлюч = Не ПустаяСтрока(КлючЗапроса);
	Если Не ВведенКлюч И ЗначениеЗаполнено(Подключение) Тогда
		КлючЗапроса = КлючПодключения(Подключение);
	КонецЕсли;
	Если Протокол = Перечисления.ИИА_ПротоколыAPI.GigaChat Тогда
		Попытка
			// Введённый, но не сохранённый ключ не должен подменить кэш токена подключения.
			КлючЗапроса = ТокенGigaChat(?(ВведенКлюч, Неопределено, Подключение), КлючЗапроса, ОбластьДоступа, , РежимПрокси);
		Исключение
			ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , , "GIGACHAT_TOKEN_FAILED");
			Результат.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Возврат Результат;
		КонецПопытки;
	КонецЕсли;
	ЭтоAnthropic = Протокол = Перечисления.ИИА_ПротоколыAPI.Anthropic;
	Попытка
		ОтветHTTP = ИИА_HTTPКлиент.Get(ИИА_HTTPКлиент.АдресРесурса(Адрес, ?(ЭтоAnthropic, "models?limit=1000", "models")),
			ЗаголовкиАвторизации(Протокол, КлючЗапроса), 30, РежимПрокси);
	Исключение
		Информация = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
			"MODELS_REQUEST_FAILED: " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));
		Результат.Ошибка = СтрШаблон(НСтр("ru = 'Не удалось получить список моделей: %1. Укажите модель вручную.'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(Информация));
		Возврат Результат;
	КонецПопытки;
	Если ОтветHTTP.КодСостояния <> 200 Тогда
		Результат.Ошибка = СтрШаблон(НСтр("ru = 'Провайдер не вернул список моделей (код %1). Проверьте ключ API или укажите модель вручную.'"),
			ОтветHTTP.КодСостояния);
		Возврат Результат;
	КонецЕсли;
	Список = Новый СписокЗначений;
	Попытка
		Для Каждого Модель Из ОбщегоНазначения.JSONВЗначение(ОтветHTTP.Тело, , Истина).Получить("data") Цикл
			Ид = Модель.Получить("id");
			Если ТипЗнч(Ид) = Тип("Строка") И Не ПустаяСтрока(Ид) Тогда
				Список.Добавить(Ид);
			КонецЕсли;
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , , "MODELS_RESPONSE_INVALID");
		Результат.Ошибка = НСтр("ru = 'Провайдер вернул список моделей в неизвестном формате. Укажите модель вручную.'");
		Возврат Результат;
	КонецПопытки;
	Список.СортироватьПоЗначению();
	Результат.Модели = Список.ВыгрузитьЗначения();
	Если Результат.Модели.Количество() = 0 Тогда
		Результат.Ошибка = НСтр("ru = 'Провайдер вернул пустой список моделей. Укажите модель вручную.'");
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Разбирает дополнительные поля тела запроса подключения: режим рассуждений, маршрутизацию агрегатора.
// Поля, которые формирует сам ассистент, переопределять нельзя.
//
// Параметры:
//  Текст - Строка - JSON-объект, например {"thinking": {"type": "disabled"}}.
//
// Возвращаемое значение:
//  Соответствие - пустое для пустой строки; исключение, если текст не JSON-объект или содержит запрещённое поле.
//
Функция ПараметрыЗапросаИзСтроки(Текст) Экспорт

	Если ПустаяСтрока(Текст) Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	ТекстОшибки = НСтр("ru = 'Параметры запроса должны быть JSON-объектом, например {""thinking"": {""type"": ""disabled""}}.'");
	Попытка
		Параметры = ОбщегоНазначения.JSONВЗначение(Текст, , Истина);
	Исключение
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	Если ТипЗнч(Параметры) <> Тип("Соответствие") Тогда
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	Для Каждого Поле Из СтрРазделить("model,messages,tools,tool_choice,stream,system,functions,function_call", ",") Цикл
		Если Параметры.Получить(Поле) <> Неопределено Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Поле %1 задаёт ассистент, в параметрах запроса его указывать нельзя.'"), Поле);
		КонецЕсли;
	КонецЦикла;
	Возврат Параметры;

КонецФункции

// Есть ли в цепочке пользователя модель, которой можно передать данные этого класса.
//
// Параметры:
//  КлассДанных - Число - 0..4.
//
// Возвращаемое значение:
//  Булево
//
Функция ЕстьПодключениеДляКласса(КлассДанных) Экспорт

	Возврат ЦепочкаПодключений(Ложь, КлассДанных).Количество() > 0;

КонецФункции

// Проверяет разрешённую модель до начала исследования, без сетевого вызова.
// Явно выбранную модель нельзя подменять разрешённым резервом.
// Параметры:
//  КлассДанных - Число - максимальный класс результатов.
//  Модель - СправочникСсылка.ИИА_ПодключенияМоделей, Неопределено - выбор пользователя.
//  НужныИзображения - Булево - наличие изображений в текущем запросе.
//  НужныДокументы - Булево - наличие PDF в текущем запросе.
// Возвращаемое значение:
//  Булево - модель активна, принадлежит цепочке профиля и допускает класс и медиа.
Функция ЕстьПодключениеДляИсследования(КлассДанных, Модель = Неопределено,
	НужныИзображения = Ложь, НужныДокументы = Ложь) Экспорт

	// Привилегированный режим включает и снимает при выходе сама ЦепочкаПодключений:
	// отключать здесь режим, включённый не этой функцией, платформа запрещает.
	Цепочка = ЦепочкаПодключений(НужныИзображения, КлассДанных, НужныДокументы);
	Если Не ЗначениеЗаполнено(Модель) Тогда
		Возврат Цепочка.Количество() > 0;
	КонецЕсли;
	Для Каждого Подключение Из Цепочка Цикл
		Если Подключение.Подключение = Модель Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Возвращает резерв времени для финального ответа исследования.
// Параметры:
//  Модель - СправочникСсылка.ИИА_ПодключенияМоделей, Неопределено - выбранная модель.
// Возвращаемое значение:
//  Число - миллисекунды: настроенный таймаут модели цепочки, ограниченный 60..180 секундами.
Функция БюджетФинальногоОтвета(Модель = Неопределено) Экспорт

	// Привилегированный режим включает и снимает при выходе сама ЦепочкаПодключений.
	Цепочка = ЦепочкаПодключений(Ложь, ?(ЗначениеЗаполнено(Модель), 1, 2), Ложь, Модель);
	Таймаут = 180;
	Если Цепочка.Количество() > 0 Тогда
		Таймаут = Цепочка[0].Таймаут;
	КонецЕсли;
	Возврат Макс(60, Мин(180, Таймаут)) * 1000;

КонецФункции

// Есть ли в цепочке пользователя модель, принимающая изображения.
//
// Возвращаемое значение:
//  Булево
//
Функция ЕстьПодключениеДляИзображений() Экспорт

	Возврат ЦепочкаПодключений(Истина).Количество() > 0;

КонецФункции

// Модели, которые пользователь может выбрать в чате: подключения его профиля в порядке цепочки.
// Адреса и ключи не возвращаются.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Подключение - СправочникСсылка.ИИА_ПодключенияМоделей
//   * Наименование - Строка
//   * Изображения - Булево - принимает изображения.
//   * Документы - Булево - принимает документы PDF.
//
Функция ДоступныеМодели() Экспорт

	Результат = Новый Массив;
	Для Каждого Описание Из ЦепочкаПодключений(Ложь, 0) Цикл
		Результат.Добавить(Новый Структура("Подключение, Наименование, Изображения, Документы", Описание.Подключение,
			Описание.Наименование, Описание.Изображения, Описание.Документы));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Проверяет подключение коротким запросом без инструментов.
//
// Параметры:
//  Подключение - СправочникСсылка.ИИА_ПодключенияМоделей
//
// Возвращаемое значение:
//  Строка - результат проверки для администратора.
//
Функция ПроверитьПодключение(Подключение) Экспорт

	// Администратор проверяет подключение до включения флажка «Используется».
	Описание = ОписаниеПодключения(Подключение, Истина);
	Если Описание = Неопределено Тогда
		Возврат НСтр("ru = 'Подключение не заполнено: укажите адрес API и модель.'");
	КонецЕсли;
	Сообщения = Новый Массив;
	Сообщение = Новый Соответствие;
	Сообщение.Вставить("role", "user");
	Сообщение.Вставить("content", "ping");
	Сообщения.Добавить(Сообщение);
	// Проверка отправляет те же поля модели и параметры запроса, что и ход: провайдер сразу отклонит
	// неподдерживаемое поле или уровень рассуждений.
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Ответ = ОтправитьЗапрос(Описание, ТелоЗапроса(Сообщения, Новый Массив, Описание.Модель, Описание.Протокол,
		Описание.ПараметрыЗапроса, Описание.НастройкиМодели));
	Если Ответ.Успех Тогда
		Итог = СтрШаблон(НСтр("ru = 'Подключение работает, ответ за %1 мс.'"),
			Формат(ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало, "ЧГ="));
		Попытка
			ДанныеОтвета = ОбщегоНазначения.JSONВЗначение(Ответ.Тело, , Истина);
		// Тело уже принято как успешный ответ: без модели агента проверка остаётся успешной.
		Исключение // BSLLS:MissingCodeTryCatchEx-off
			ДанныеОтвета = Неопределено;
		КонецПопытки;
		МодельАгента = МодельАгента(ДанныеОтвета);
		Если Не ПустаяСтрока(МодельАгента) Тогда
			Итог = Итог + " " + СтрШаблон(НСтр("ru = 'Агент отвечает моделью %1.'"), МодельАгента);
		КонецЕсли;
		Возврат Итог;
	КонецЕсли;
	Возврат Ответ.Ошибка;

КонецФункции

// Сохраняет ключ API подключения в безопасное хранилище. Вызывающий код проверяет права администратора.
//
// Параметры:
//  Подключение - СправочникСсылка.ИИА_ПодключенияМоделей
//  Ключ - Строка
//
Процедура СохранитьКлючПодключения(Подключение, Ключ) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Подключение, Ключ, "КлючAPI");
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Сохранён ли ключ подключения (значение не возвращается).
//
// Параметры:
//  Подключение - СправочникСсылка.ИИА_ПодключенияМоделей
//
// Возвращаемое значение:
//  Булево
//
Функция КлючПодключенияЗаполнен(Подключение) Экспорт

	Возврат ЗначениеЗаполнено(КлючПодключения(Подключение));

КонецФункции

// Однократный перенос подключения из прежних настроек (константы адреса и модели, общий ключ)
// в справочник подключений, если справочник пуст.
//
Процедура ПеренестиПодключениеИзНастроек() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Адрес = СокрЛП(Константы.ИИА_АдресAPI.Получить());
	Модель = СокрЛП(Константы.ИИА_Модель.Получить());
	Если ПустаяСтрока(Адрес) Или ПустаяСтрока(Модель) Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 1 КАК Х ИЗ Справочник.ИИА_ПодключенияМоделей КАК П");
	Если Не Запрос.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;
	Элемент = Справочники.ИИА_ПодключенияМоделей.СоздатьЭлемент();
	Элемент.Наименование = Модель;
	Элемент.АдресAPI = Адрес;
	Элемент.Модель = Модель;
	Элемент.Используется = Истина;
	Элемент.Порядок = 1;
	Элемент.ТаймаутСекунд = 180;
	Элемент.Записать();
	СтарыйКлюч = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("ИИАссистент.ПровайдерLLM", "КлючAPI");
	Если ТипЗнч(СтарыйКлюч) = Тип("Строка") И ЗначениеЗаполнено(СтарыйКлюч) Тогда
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Элемент.Ссылка, СтарыйКлюч, "КлючAPI");
	КонецЕсли;
	Константы.ИИА_АдресAPI.Установить("");
	Константы.ИИА_Модель.Установить("");

КонецПроцедуры

// Читает готовность цепочки указанного профиля без HTTP, переноса настроек и смены пользователя.
// Параметры:
//  Профиль - СправочникСсылка.ИИА_ПрофилиДоступа, Неопределено.
// Возвращаемое значение:
//  Структура - Готово, Модели (Массив строк), Текст, ДопустимыеКлассы (Массив чисел 0..4).
//  Ключи и адреса не возвращаются. ДопустимыеКлассы отражают доверие настроенных моделей, без HTTP.
Функция ДиагностикаМоделейПрофиля(Профиль) Экспорт

	Результат = Новый Структура("Готово, Модели, Текст, ДопустимыеКлассы", Ложь, Новый Массив, "", Новый Массив);
	УстановитьПривилегированныйРежим(Истина);
	Для Каждого Подключение Из ПодключенияПрофиля(Профиль) Цикл
		Описание = ОписаниеПодключения(Подключение);
		Если Описание = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Результат.Модели.Добавить(Описание.Наименование + ": " + Описание.Модель);
		Для КлассДанных = 0 По 4 Цикл
			Если Результат.ДопустимыеКлассы.Найти(КлассДанных) = Неопределено
				И ИИА_КлассыДанных.КлассДопустимДляДоверия(КлассДанных, Описание.Доверие) Тогда
				Результат.ДопустимыеКлассы.Добавить(КлассДанных);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Результат.Готово = Результат.ДопустимыеКлассы.Найти(1) <> Неопределено;
	Результат.Текст = ?(Результат.Готово,
		НСтр("ru = 'Есть настроенная модель для обезличенных данных. Соединение и ключ не проверялись.'"),
		НСтр("ru = 'Нет настроенной разрешённой модели. Администратору нужно проверить назначения моделей, адрес и имя модели.'"));
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОчищенноеЗначениеЗапроса(Значение, Контекст = "тело")

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат ИИА_Периметр.ОчиститьТекст(Значение);
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		СледующийКонтекст = ?(Контекст = "данныеИнструмента", Контекст, "");
		Если Контекст = "сообщения" Тогда
			СледующийКонтекст = "сообщение";
		ИначеЕсли Контекст = "содержимое" Тогда
			СледующийКонтекст = "блок";
		ИначеЕсли Контекст = "вызовы" Тогда
			СледующийКонтекст = "вызов";
		КонецЕсли;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ОчищенноеЗначениеЗапроса(Элемент, СледующийКонтекст));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Результат = Новый Соответствие;
		Для Каждого Элемент Из Значение Цикл
			Если ЭтоИдентификаторВызова(Контекст, Элемент.Ключ)
				Или ЭтоАдресИзображения(Контекст, Значение, Элемент.Ключ)
				Или ЭтоДанныеФайла(Контекст, Значение, Элемент.Ключ)
				Или (Контекст = "источникИзображения" Или Контекст = "источникДокумента") И Элемент.Ключ = "data"
				Или ЭтоПодписьРассуждений(Контекст, Значение, Элемент.Ключ) Тогда
				// Двоичные вложения исключаются только в позиции content; их формат проверяется после очистки.
				Результат.Вставить(Элемент.Ключ, Элемент.Значение);
				Продолжить;
			КонецЕсли;
			Если Контекст = "данныеИнструмента" И ИИА_Периметр.ЭтоИмяСекрета(Строка(Элемент.Ключ)) Тогда
				Результат.Вставить(Элемент.Ключ, ИИА_Периметр.ЗаглушкаСкрыто());
				Продолжить;
			КонецЕсли;
			Если ЭтоАргументыВызова(Контекст, Значение, Элемент.Ключ) Тогда
				Аргументы = ОбщегоНазначения.JSONВЗначение(Элемент.Значение, , Истина);
				Если ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
					ВызватьИсключение "REQUEST_ARGUMENTS_INVALID";
				КонецЕсли;
				Результат.Вставить(Элемент.Ключ,
					ОбщегоНазначения.ЗначениеВJSON(ОчищенноеЗначениеЗапроса(Аргументы, "данныеИнструмента")));
				Продолжить;
			КонецЕсли;
			Если Контекст = "блок" И Значение.Получить("type") = "tool_use" И Элемент.Ключ = "input"
				Или Контекст = "вызовФункции" И Элемент.Ключ = "arguments" Тогда
				Результат.Вставить(Элемент.Ключ, ОчищенноеЗначениеЗапроса(Элемент.Значение, "данныеИнструмента"));
				Продолжить;
			КонецЕсли;
			СледующийКонтекст = ?(Контекст = "данныеИнструмента", Контекст, "");
			Если Контекст = "тело" И (Элемент.Ключ = "messages" Или Элемент.Ключ = "input") Тогда
				СледующийКонтекст = "сообщения";
			ИначеЕсли Контекст = "сообщение" И Элемент.Ключ = "tool_calls" Тогда
				СледующийКонтекст = "вызовы";
			ИначеЕсли Контекст = "сообщение" И Элемент.Ключ = "function_call" Тогда
				СледующийКонтекст = "вызовФункции";
			ИначеЕсли Контекст = "вызов" И Элемент.Ключ = "function" Тогда
				СледующийКонтекст = "функция";
			ИначеЕсли (Контекст = "сообщение" Или Контекст = "блок" И Значение.Получить("type") = "tool_result")
				И Элемент.Ключ = "content" Тогда
				СледующийКонтекст = "содержимое";
			ИначеЕсли Контекст = "блок" Тогда
				Если Значение.Получить("type") = "image_url" И Элемент.Ключ = "image_url" Тогда
					СледующийКонтекст = "адресИзображения";
				ИначеЕсли Значение.Получить("type") = "image" И Элемент.Ключ = "source" Тогда
					СледующийКонтекст = "источникИзображения";
				ИначеЕсли Значение.Получить("type") = "file" И Элемент.Ключ = "file" Тогда
					СледующийКонтекст = "файл";
				ИначеЕсли Значение.Получить("type") = "document" И Элемент.Ключ = "source" Тогда
					СледующийКонтекст = "источникДокумента";
				КонецЕсли;
			КонецЕсли;
			Результат.Вставить(Элемент.Ключ, ОчищенноеЗначениеЗапроса(Элемент.Значение, СледующийКонтекст));
		КонецЦикла;
		Возврат Результат;
	Иначе
		Возврат Значение;
	КонецЕсли;

КонецФункции

// Цепочка подключений текущего пользователя: модели его профиля доступа по порядку строк,
// иначе - все используемые подключения по реквизиту Порядок. Подключения, которым по уровню доверия
// нельзя передавать данные класса КлассДанных, исключаются (маршрутизация, план 4.5).
// Предпочтительное подключение (выбор пользователя в чате) ставится первым, если оно есть в цепочке профиля.
Функция ЦепочкаПодключений(НужныИзображения, КлассДанных = 1, НужныДокументы = Ложь, Предпочтительное = Неопределено)

	УстановитьПривилегированныйРежим(Истина);
	ПеренестиПодключениеИзНастроек();

	Подключения = ПодключенияПрофиля(ИИА_ПрофилиДоступа.ЭффективныйПрофиль(Пользователи.ТекущийПользователь()));
	Если ЗначениеЗаполнено(Предпочтительное) Тогда
		Индекс = Подключения.Найти(Предпочтительное);
		Если Индекс <> Неопределено Тогда
			Подключения.Удалить(Индекс);
			Подключения.Вставить(0, Предпочтительное);
		КонецЕсли;
	КонецЕсли;

	Цепочка = Новый Массив;
	Для Каждого Подключение Из Подключения Цикл
		Описание = ОписаниеПодключения(Подключение);
		Если Описание <> Неопределено И (Не НужныИзображения Или Описание.Изображения)
			И (Не НужныДокументы Или Описание.Документы)
			И ИИА_КлассыДанных.КлассДопустимДляДоверия(КлассДанных, Описание.Доверие) Тогда
			Цепочка.Добавить(Описание);
		КонецЕсли;
	КонецЦикла;
	Возврат Цепочка;

КонецФункции

Функция ПодключенияПрофиля(Профиль)

	Подключения = Новый Массив;
	Если ЗначениеЗаполнено(Профиль) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Модели.Подключение КАК Подключение
		|ИЗ
		|	Справочник.ИИА_ПрофилиДоступа.Модели КАК Модели
		|ГДЕ
		|	Модели.Ссылка = &Профиль
		|
		|УПОРЯДОЧИТЬ ПО
		|	Модели.НомерСтроки";
		Запрос.УстановитьПараметр("Профиль", Профиль);
		Подключения = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Подключение");
	КонецЕсли;
	Если Подключения.Количество() = 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	П.Ссылка КАК Подключение
		|ИЗ
		|	Справочник.ИИА_ПодключенияМоделей КАК П
		|ГДЕ
		|	П.Используется
		|	И НЕ П.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	П.Порядок,
		|	П.Наименование";
		Подключения = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Подключение");
	КонецЕсли;

	Возврат Подключения;

КонецФункции

Функция ОписаниеПодключения(Подключение, ВключаяНеиспользуемые = Ложь)

	Если Не ЗначениеЗаполнено(Подключение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Подключение,
		"Наименование, АдресAPI, Модель, ТаймаутСекунд, ПоддерживаетИзображения, ПоддерживаетДокументы, Доверие, Протокол, Используется, ПометкаУдаления, ПараметрыЗапроса, ОбластьДоступа, Прокси, "
		+ ПоляНастроекМодели());
	Если Не (Реквизиты.Используется Или ВключаяНеиспользуемые) Или Реквизиты.ПометкаУдаления
		Или ПустаяСтрока(Реквизиты.АдресAPI) Или ПустаяСтрока(Реквизиты.Модель) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Описание = Новый Структура;
	Описание.Вставить("Наименование", Реквизиты.Наименование);
	Описание.Вставить("Адрес", СокрЛП(Реквизиты.АдресAPI));
	Описание.Вставить("Модель", СокрЛП(Реквизиты.Модель));
	Описание.Вставить("Таймаут", ?(Реквизиты.ТаймаутСекунд > 0, Реквизиты.ТаймаутСекунд, 180));
	// Адаптер GigaChat передаёт только текст (файлы GigaChat загружаются отдельным API), мост ACP - текст
	// и изображения (блоки image, если агент заявил promptCapabilities.image), без PDF.
	// Флажки подключения не расширяют их возможности.
	ЭтоGigaChat = Реквизиты.Протокол = Перечисления.ИИА_ПротоколыAPI.GigaChat;
	ЭтоACP = Реквизиты.Протокол = Перечисления.ИИА_ПротоколыAPI.ACP;
	Описание.Вставить("Изображения", Реквизиты.ПоддерживаетИзображения И Не ЭтоGigaChat);
	Описание.Вставить("Документы", Реквизиты.ПоддерживаетДокументы И Не ЭтоGigaChat И Не ЭтоACP);
	Описание.Вставить("Доверие", Реквизиты.Доверие);
	Описание.Вставить("Протокол", Реквизиты.Протокол);
	Описание.Вставить("ПараметрыЗапроса", Реквизиты.ПараметрыЗапроса);
	Описание.Вставить("ОбластьДоступа", Реквизиты.ОбластьДоступа);
	Описание.Вставить("Прокси", Реквизиты.Прокси);
	НастройкиМодели = НовыеНастройкиМодели();
	ЗаполнитьЗначенияСвойств(НастройкиМодели, Реквизиты);
	Описание.Вставить("НастройкиМодели", НастройкиМодели);
	Описание.Вставить("Подключение", Подключение);
	Возврат Описание;

КонецФункции

Функция ПоляНастроекМодели()

	Возврат "Провайдер, Рассуждения, БюджетРассуждений, МаксимумТокенов, ЗадатьТемпературу, Температура, ПорядокПровайдеров, РазрешитьДругихПровайдеров";

КонецФункции

// Поля режима рассуждений, лимита, температуры и маршрутизации в именах провайдера.
// Значения и ограничения - по документации провайдеров на 10.2026, см. docs/ИИАссистент.md, раздел 5.
Процедура ДобавитьПоляМодели(Тело, Протокол, Настройки)

	Провайдеры = Перечисления.ИИА_ПровайдерыМоделей;
	Провайдер = Настройки.Провайдер;
	Уровень = УровеньРассуждений(Настройки.Рассуждения);
	Выключены = Уровень = "none";
	Бюджет = ?(Выключены, 0, Настройки.БюджетРассуждений);
	Рассуждает = Бюджет > 0 Или Не ПустаяСтрока(Уровень) И Не Выключены;
	МаксимумТокенов = Настройки.МаксимумТокенов;

	Если Протокол = Перечисления.ИИА_ПротоколыAPI.OpenAIResponses Тогда
		ДобавитьПоляResponses(Тело, Настройки, Уровень, Бюджет, МаксимумТокенов);
		Возврат;
	КонецЕсли;
	Если Протокол = Перечисления.ИИА_ПротоколыAPI.Anthropic Тогда
		// max_tokens обязателен, рассуждения расходуют его же; бюджет должен быть меньше лимита.
		Если МаксимумТокенов = 0 Тогда
			МаксимумТокенов = ?(Рассуждает, 16000, 4096);
		КонецЕсли;
		Если Бюджет > 0 Тогда
			Тело.Вставить("thinking", Новый Структура("type, budget_tokens", "enabled", Бюджет));
			МаксимумТокенов = Макс(МаксимумТокенов, Бюджет + 4096);
		ИначеЕсли Выключены Тогда
			Тело.Вставить("thinking", Новый Структура("type", "disabled"));
		ИначеЕсли Рассуждает Тогда
			Тело.Вставить("thinking", Новый Структура("type", "adaptive"));
			Тело.Вставить("output_config", Новый Структура("effort", ЗначениеУровня(Уровень, "low,low,medium,high,max")));
		КонецЕсли;
		Тело.Вставить("max_tokens", МаксимумТокенов);
		// Автоматическое кэширование: точка кэша ставится на последний блок и сдвигается по мере роста диалога,
		// повторный префикс (инструменты, system, история хода) оплачивается по цене чтения кэша.
		// Только для самого Anthropic: Anthropic-совместимые адреса других провайдеров поле могут отклонить.
		Если Провайдер = Провайдеры.Anthropic Тогда
			Тело.Вставить("cache_control", Новый Структура("type", "ephemeral"));
		КонецЕсли;
	ИначеЕсли МаксимумТокенов > 0 Тогда
		Тело.Вставить(?(Провайдер = Провайдеры.OpenAI Или Провайдер = Провайдеры.xAI, "max_completion_tokens", "max_tokens"),
			МаксимумТокенов);
	КонецЕсли;

	// Модели с рассуждениями OpenAI и Anthropic отклоняют температуру, отличную от умолчания.
	Если Настройки.ЗадатьТемпературу И Не (Рассуждает
		И (Провайдер = Провайдеры.OpenAI Или Протокол = Перечисления.ИИА_ПротоколыAPI.Anthropic)) Тогда
		Тело.Вставить("temperature", Настройки.Температура);
	КонецЕсли;

	Если Провайдер = Провайдеры.OpenRouter Или Провайдер = Провайдеры.RouterAI Тогда
		ДобавитьПоляАгрегатора(Тело, Настройки, Уровень, Бюджет);
	КонецЕсли;
	Если Протокол = Перечисления.ИИА_ПротоколыAPI.Anthropic Или Протокол = Перечисления.ИИА_ПротоколыAPI.GigaChat
		Или ПустаяСтрока(Уровень) И Бюджет = 0
		Или Провайдер = Провайдеры.OpenRouter Или Провайдер = Провайдеры.RouterAI Тогда
		Возврат;
	КонецЕсли;

	// Уровни перечисления: минимальные, низкие, средние, высокие, максимальные - в значения провайдера.
	Если Провайдер = Провайдеры.DeepSeek Тогда
		Тело.Вставить("thinking", Новый Структура("type", ?(Выключены, "disabled", "enabled")));
		Если Не Выключены И Не ПустаяСтрока(Уровень) Тогда
			Тело.Вставить("reasoning_effort", ЗначениеУровня(Уровень, "low,low,high,high,max"));
		КонецЕсли;
	ИначеЕсли Провайдер = Провайдеры.ZAI Тогда
		Тело.Вставить("thinking", Новый Структура("type", ?(Выключены, "disabled", "enabled")));
	ИначеЕсли Провайдер = Провайдеры.Qwen Тогда
		Тело.Вставить("enable_thinking", Не Выключены);
		Если Бюджет > 0 Тогда
			Тело.Вставить("thinking_budget", Бюджет);
		КонецЕсли;
	ИначеЕсли ПустаяСтрока(Уровень) Тогда
		Возврат; // бюджет у остальных провайдеров не передаётся
	ИначеЕсли Провайдер = Провайдеры.OpenAI Тогда
		Тело.Вставить("reasoning_effort", ?(Выключены, "none", ЗначениеУровня(Уровень, "minimal,low,medium,high,xhigh")));
	ИначеЕсли Провайдер = Провайдеры.GoogleGemini Тогда
		Тело.Вставить("reasoning_effort", ?(Выключены, "none", ЗначениеУровня(Уровень, "minimal,low,medium,high,high")));
	ИначеЕсли Провайдер = Провайдеры.Mistral Тогда
		Тело.Вставить("reasoning_effort", ?(Выключены, "none", "high"));
	ИначеЕсли Провайдер = Провайдеры.YandexAI Или Провайдер = Провайдеры.xAI Тогда
		// Выключение не передаётся: часть моделей рассуждает всегда и отклоняет none.
		Если Не Выключены Тогда
			Тело.Вставить("reasoning_effort", ЗначениеУровня(Уровень,
				?(Провайдер = Провайдеры.xAI, "low,low,medium,high,xhigh", "low,low,medium,high,high")));
		КонецЕсли;
	Иначе
		Тело.Вставить("reasoning_effort", ?(Выключены, "none", ЗначениеУровня(Уровень, "low,low,medium,high,high")));
	КонецЕсли;

КонецПроцедуры

// OpenAI Responses: max_output_tokens и объект reasoning. Ответы у провайдера не хранятся (store=false),
// поэтому рассуждения между вызовами хода передаются зашифрованными (include reasoning.encrypted_content).
// Бюджета в токенах у Responses нет; температуру модели с рассуждениями отклоняют.
Процедура ДобавитьПоляResponses(Тело, Настройки, Уровень, Бюджет, МаксимумТокенов)

	Выключены = Уровень = "none";
	Рассуждает = Бюджет > 0 Или Не ПустаяСтрока(Уровень) И Не Выключены;
	Если МаксимумТокенов > 0 Тогда
		Тело.Вставить("max_output_tokens", МаксимумТокенов);
	КонецЕсли;
	Если Настройки.ЗадатьТемпературу И Не Рассуждает Тогда
		Тело.Вставить("temperature", Настройки.Температура);
	КонецЕсли;
	Если Выключены Тогда
		Тело.Вставить("reasoning", Новый Структура("effort", "none"));
	ИначеЕсли Не ПустаяСтрока(Уровень) Тогда
		Тело.Вставить("reasoning", Новый Структура("effort", ЗначениеУровня(Уровень, "minimal,low,medium,high,xhigh")));
	КонецЕсли;
	// Модели без рассуждений отклоняют include, поэтому он передаётся только при заданном уровне.
	Если Рассуждает Тогда
		Включить = Новый Массив;
		Включить.Добавить("reasoning.encrypted_content");
		Тело.Вставить("include", Включить);
	КонецЕсли;

КонецПроцедуры

// OpenRouter и RouterAI: объект reasoning и маршрутизация provider.
Процедура ДобавитьПоляАгрегатора(Тело, Настройки, Уровень, Бюджет)

	Если Бюджет > 0 Тогда
		Тело.Вставить("reasoning", Новый Структура("max_tokens", Бюджет));
	ИначеЕсли Уровень = "none" Тогда
		Тело.Вставить("reasoning", Новый Структура("effort", "none"));
	ИначеЕсли Не ПустаяСтрока(Уровень) Тогда
		Тело.Вставить("reasoning", Новый Структура("effort", ЗначениеУровня(Уровень, "minimal,low,medium,high,xhigh")));
	КонецЕсли;
	Порядок = Новый Массив;
	Для Каждого Имя Из СтрРазделить(Настройки.ПорядокПровайдеров, ",;", Ложь) Цикл
		Если Не ПустаяСтрока(Имя) Тогда
			Порядок.Добавить(СокрЛП(Имя));
		КонецЕсли;
	КонецЦикла;
	Если Порядок.Количество() > 0 Тогда
		Тело.Вставить("provider", Новый Структура("order, allow_fallbacks", Порядок, Настройки.РазрешитьДругихПровайдеров));
	КонецЕсли;

КонецПроцедуры

// Уровень рассуждений: "" - умолчание провайдера, none, minimal, low, medium, high, max.
Функция УровеньРассуждений(Режим)

	Режимы = Перечисления.ИИА_РежимыРассуждений;
	Если Режим = Режимы.Выключены Тогда
		Возврат "none";
	ИначеЕсли Режим = Режимы.Минимальные Тогда
		Возврат "minimal";
	ИначеЕсли Режим = Режимы.Низкие Тогда
		Возврат "low";
	ИначеЕсли Режим = Режимы.Средние Тогда
		Возврат "medium";
	ИначеЕсли Режим = Режимы.Высокие Тогда
		Возврат "high";
	ИначеЕсли Режим = Режимы.Максимальные Тогда
		Возврат "max";
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

// Значение провайдера для уровня minimal, low, medium, high, max из списка пяти значений через запятую.
Функция ЗначениеУровня(Уровень, Значения)

	Индекс = СтрРазделить("minimal,low,medium,high,max", ",").Найти(Уровень);
	Возврат СтрРазделить(Значения, ",")[?(Индекс = Неопределено, 2, Индекс)];

КонецФункции

// Поля подключения из прежней строки параметров запроса. Возвращает ключи строки, которые разобраны в поля.
Функция ПоляИзПараметровЗапроса(Параметры, Настройки)

	Режимы = Перечисления.ИИА_РежимыРассуждений;
	Уровни = Новый Соответствие;
	Уровни.Вставить("none", Режимы.Выключены);
	Уровни.Вставить("minimal", Режимы.Минимальные);
	Уровни.Вставить("low", Режимы.Низкие);
	Уровни.Вставить("medium", Режимы.Средние);
	Уровни.Вставить("high", Режимы.Высокие);
	Уровни.Вставить("xhigh", Режимы.Максимальные);
	Уровни.Вставить("max", Режимы.Максимальные);
	Перенесенные = Новый Массив;

	Мышление = Параметры.Получить("thinking");
	Если ТипЗнч(Мышление) = Тип("Соответствие") Тогда
		Перенесенные.Добавить("thinking");
		Настройки.Рассуждения = ?(Мышление.Получить("type") = "disabled", Режимы.Выключены, Режимы.Высокие);
	КонецЕсли;
	Усилие = Параметры.Получить("reasoning_effort");
	Если ТипЗнч(Усилие) = Тип("Строка") И Уровни.Получить(Усилие) <> Неопределено Тогда
		Перенесенные.Добавить("reasoning_effort");
		Настройки.Рассуждения = Уровни.Получить(Усилие);
	КонецЕсли;
	Рассуждения = Параметры.Получить("reasoning");
	Если ТипЗнч(Рассуждения) = Тип("Соответствие") Тогда
		Перенесенные.Добавить("reasoning");
		Если ТипЗнч(Рассуждения.Получить("max_tokens")) = Тип("Число") Тогда
			Настройки.БюджетРассуждений = Рассуждения.Получить("max_tokens");
		ИначеЕсли Уровни.Получить(Рассуждения.Получить("effort")) <> Неопределено Тогда
			Настройки.Рассуждения = Уровни.Получить(Рассуждения.Получить("effort"));
		КонецЕсли;
	КонецЕсли;
	Включены = Параметры.Получить("enable_thinking");
	Если ТипЗнч(Включены) = Тип("Булево") Тогда
		Перенесенные.Добавить("enable_thinking");
		Настройки.Рассуждения = ?(Включены, Режимы.Высокие, Режимы.Выключены);
	КонецЕсли;
	Для Каждого Ключ Из СтрРазделить("thinking_budget,max_tokens,max_completion_tokens", ",") Цикл
		Значение = Параметры.Получить(Ключ);
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Перенесенные.Добавить(Ключ);
			Если Ключ = "thinking_budget" Тогда
				Настройки.БюджетРассуждений = Значение;
			Иначе
				Настройки.МаксимумТокенов = Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Температура = Параметры.Получить("temperature");
	Если ТипЗнч(Температура) = Тип("Число") Тогда
		Перенесенные.Добавить("temperature");
		Настройки.ЗадатьТемпературу = Истина;
		Настройки.Температура = Температура;
	КонецЕсли;
	Маршрут = Параметры.Получить("provider");
	Если ТипЗнч(Маршрут) = Тип("Соответствие") И ТипЗнч(Маршрут.Получить("order")) = Тип("Массив") Тогда
		Перенесенные.Добавить("provider");
		Настройки.ПорядокПровайдеров = СтрСоединить(Маршрут.Получить("order"), ", ");
		Настройки.РазрешитьДругихПровайдеров = Маршрут.Получить("allow_fallbacks") <> Ложь;
	КонецЕсли;
	Возврат Перенесенные;

КонецФункции

// Сравнение значений JSON без учёта порядка ключей объектов.
Функция ЗначенияJSONРавны(Первое, Второе)

	Если ТипЗнч(Первое) = Тип("Структура") Или ТипЗнч(Первое) = Тип("Соответствие") Тогда
		Если ТипЗнч(Второе) <> Тип("Структура") И ТипЗнч(Второе) <> Тип("Соответствие")
			Или Первое.Количество() <> Второе.Количество() Тогда
			Возврат Ложь;
		КонецЕсли;
		Для Каждого Элемент Из Первое Цикл
			Значение = Неопределено;
			Если ТипЗнч(Второе) = Тип("Структура") Тогда
				Второе.Свойство(Элемент.Ключ, Значение);
			Иначе
				Значение = Второе.Получить(Элемент.Ключ);
			КонецЕсли;
			Если Значение = Неопределено Или Не ЗначенияJSONРавны(Элемент.Значение, Значение) Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
		Возврат Истина;
	ИначеЕсли ТипЗнч(Первое) = Тип("Массив") Тогда
		Если ТипЗнч(Второе) <> Тип("Массив") Или Первое.Количество() <> Второе.Количество() Тогда
			Возврат Ложь;
		КонецЕсли;
		Для Индекс = 0 По Первое.ВГраница() Цикл
			Если Не ЗначенияJSONРавны(Первое[Индекс], Второе[Индекс]) Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
		Возврат Истина;
	Иначе
		Возврат ТипЗнч(Первое) = ТипЗнч(Второе) И Первое = Второе;
	КонецЕсли;

КонецФункции

Функция НормализованныйАдрес(Адрес)

	Результат = НРег(СокрЛП(Адрес));
	Пока СтрЗаканчиваетсяНа(Результат, "/") Цикл
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Копия настроек модели с выключенными рассуждениями.
Функция НастройкиБезРассуждений(Настройки)

	Копия = НовыеНастройкиМодели();
	Если Настройки <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Копия, Настройки);
	КонецЕсли;
	Копия.Рассуждения = Перечисления.ИИА_РежимыРассуждений.Выключены;
	Копия.БюджетРассуждений = 0;
	Возврат Копия;

КонецФункции

// Блоки рассуждений Anthropic в сообщении ассистента формата OpenAI, см. ОтветAnthropicКакOpenAI.
Функция КлючБлоковРассуждений()

	Возврат "thinking_blocks";

КонецФункции

// Элементы output ответа OpenAI Responses с рассуждениями, см. ОтветResponsesКакOpenAI.
Функция КлючЭлементовResponses()

	Возврат "responses_output";

КонецФункции

// Блоки рассуждений Anthropic, состояние функций GigaChat и метка автора ответа нужны только своему провайдеру
// или ассистенту: при переходе на резервную модель OpenAI-совместимого протокола их не отправляем.
Функция СообщенияБезСлужебныхПолей(Сообщения)

	Служебные = Новый Соответствие;
	Служебные.Вставить(КлючБлоковРассуждений(), Истина);
	Служебные.Вставить(КлючЭлементовResponses(), Истина);
	Служебные.Вставить("functions_state_id", Истина);
	Служебные.Вставить(ИИА_Маскирование.КлючДовериеАвтора(), Истина);
	Результат = Новый Массив;
	Для Каждого Сообщение Из Сообщения Цикл
		ЕстьСлужебные = Ложь;
		Если ТипЗнч(Сообщение) = Тип("Соответствие") Тогда
			Для Каждого Поле Из Служебные Цикл
				ЕстьСлужебные = ЕстьСлужебные Или Сообщение.Получить(Поле.Ключ) <> Неопределено;
			КонецЦикла;
		КонецЕсли;
		Если Не ЕстьСлужебные Тогда
			Результат.Добавить(Сообщение);
			Продолжить;
		КонецЕсли;
		Копия = Новый Соответствие;
		Для Каждого Поле Из Сообщение Цикл
			Если Служебные.Получить(Поле.Ключ) = Неопределено Тогда
				Копия.Вставить(Поле.Ключ, Поле.Значение);
			КонецЕсли;
		КонецЦикла;
		Результат.Добавить(Копия);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЗаголовкиАвторизации(Протокол, Ключ)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Если Протокол = Перечисления.ИИА_ПротоколыAPI.Anthropic Тогда
		Заголовки.Вставить("anthropic-version", "2023-06-01");
		Если ЗначениеЗаполнено(Ключ) Тогда
			Заголовки.Вставить("x-api-key", Ключ);
		КонецЕсли;
		Возврат Заголовки;
	ИначеЕсли Протокол = Перечисления.ИИА_ПротоколыAPI.GigaChat Тогда
		Заголовки.Вставить("Accept", "application/json");
	КонецЕсли;
	Если ЗначениеЗаполнено(Ключ) Тогда
		Заголовки.Вставить("Authorization", "Bearer " + Ключ);
	КонецЕсли;
	Возврат Заголовки;

КонецФункции

Процедура ДобавитьПараметрыЗапроса(Тело, ПараметрыЗапроса)

	Для Каждого Поле Из ПараметрыЗапросаИзСтроки(ПараметрыЗапроса) Цикл
		Тело.Вставить(Поле.Ключ, Поле.Значение);
	КонецЦикла;

КонецПроцедуры

// Входные токены из кэша префикса: DeepSeek - prompt_cache_hit_tokens, OpenAI и агрегаторы -
// prompt_tokens_details.cached_tokens.
Функция ТокеныИзКэша(Использование)

	Токены = ЧислоИлиНоль(Использование.Получить("prompt_cache_hit_tokens"));
	Подробности = Использование.Получить("prompt_tokens_details");
	Если Токены = 0 И ТипЗнч(Подробности) = Тип("Соответствие") Тогда
		Токены = ЧислоИлиНоль(Подробности.Получить("cached_tokens"));
	КонецЕсли;
	Возврат Токены;

КонецФункции

// Режим рассуждений, запрошенный у модели, для журнала вызовов (см. ДобавитьПоляМодели).
Функция ЗапрошенныеРассуждения(Настройки)

	Если ТипЗнч(Настройки) <> Тип("Структура") Или Не Настройки.Свойство("Рассуждения") Тогда
		Возврат "";
	КонецЕсли;
	Уровень = УровеньРассуждений(Настройки.Рассуждения);
	Если Уровень <> "none" И Настройки.Свойство("БюджетРассуждений") И Настройки.БюджетРассуждений > 0 Тогда
		Возврат "budget=" + Формат(Настройки.БюджетРассуждений, "ЧГ=");
	КонецЕсли;
	Возврат Уровень;

КонецФункции

Функция КлючПодключения(Подключение)

	УстановитьПривилегированныйРежим(Истина);
	Ключ = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Подключение, "КлючAPI");
	УстановитьПривилегированныйРежим(Ложь);
	Возврат ?(ТипЗнч(Ключ) = Тип("Строка"), Ключ, "");

КонецФункции

// Есть ли в мультимодальных сообщениях часть типа ТипЧасти (image_url - изображение, file - документ PDF).
Функция ЕстьЧастиТипа(Сообщения, ТипЧасти)

	Для Каждого Сообщение Из Сообщения Цикл
		Части = Сообщение.Получить("content");
		Если ТипЗнч(Части) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Часть Из Части Цикл
			Если ТипЗнч(Часть) = Тип("Соответствие") И Часть.Получить("type") = ТипЧасти Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Обходит весь текст JSON; исключение для изображения действует только в позиции блока content.
// Структура, похожая на изображение, внутри tool input/arguments не получает исключения.
Процедура ПроверитьЗначениеЗапроса(Значение, Находок, Контекст = "", Путь = "", Диагностика = Неопределено, Кэш = Неопределено)

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		ПроверитьСтрокуЗапроса(Значение, Находок, Путь, Диагностика, Кэш);
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		НомерЭлемента = 0;
		Для Каждого Элемент Из Значение Цикл
			ПутьЭлемента = Путь + "[" + Формат(НомерЭлемента, "ЧН=0; ЧГ=") + "]";
			НомерЭлемента = НомерЭлемента + 1;
			СледующийКонтекст = ?(Контекст = "данныеИнструмента", Контекст, "");
			Если Контекст = "сообщения" Тогда
				СледующийКонтекст = "сообщение";
			ИначеЕсли Контекст = "содержимое" Тогда
				СледующийКонтекст = "блок";
			ИначеЕсли Контекст = "вызовы" Тогда
				СледующийКонтекст = "вызов";
			КонецЕсли;
			ПроверитьЗначениеЗапроса(Элемент, Находок, СледующийКонтекст, ПутьЭлемента, Диагностика, Кэш);
		КонецЦикла;
	ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Для Каждого Элемент Из Значение Цикл
			ПутьЭлемента = Путь + "." + Строка(Элемент.Ключ);
			Если ЭтоИдентификаторВызова(Контекст, Элемент.Ключ) Тогда
				Продолжить; // идентификатор вызова выдаёт провайдер: длинное число - не телефон и не карта
			КонецЕсли;
			Если ЭтоПодписьРассуждений(Контекст, Значение, Элемент.Ключ) Тогда
				Продолжить;
			КонецЕсли;
			Если Контекст = "данныеИнструмента" И ИИА_Периметр.ЭтоИмяСекрета(Строка(Элемент.Ключ))
				И Элемент.Значение <> ИИА_Периметр.ЗаглушкаСкрыто() Тогда
				Находок = Находок + 1;
				ДобавитьДиагностику(Диагностика, ПутьЭлемента, НСтр("ru = 'имя секрета'"));
			КонецЕсли;
			Если ЭтоАргументыВызова(Контекст, Значение, Элемент.Ключ) Тогда
				Аргументы = ОбщегоНазначения.JSONВЗначение(Элемент.Значение, , Истина);
				Если ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
					Находок = Находок + 1;
					ДобавитьДиагностику(Диагностика, ПутьЭлемента, НСтр("ru = 'аргументы не JSON-объект'"));
				Иначе
					ПроверитьЗначениеЗапроса(Аргументы, Находок, "данныеИнструмента", ПутьЭлемента, Диагностика, Кэш);
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			Если Контекст = "блок" И Значение.Получить("type") = "tool_use" И Элемент.Ключ = "input"
				Или Контекст = "вызовФункции" И Элемент.Ключ = "arguments" Тогда
				// Сохраняем связь имени секрета со значением (password/token), включая вложенные объекты.
				ПроверитьЗначениеЗапроса(Элемент.Значение, Находок, "данныеИнструмента", ПутьЭлемента, Диагностика, Кэш);
				Продолжить;
			КонецЕсли;
			Если ЭтоАдресИзображения(Контекст, Значение, Элемент.Ключ) Тогда
				Префикс = "";
				Если ТипЗнч(Элемент.Значение) = Тип("Строка") Тогда
					// Те же форматы, которые принимает серверная проверка вложений чата.
					Если СтрНачинаетсяС(Элемент.Значение, "data:image/png;base64,") Тогда
						Префикс = "data:image/png;base64,";
					ИначеЕсли СтрНачинаетсяС(Элемент.Значение, "data:image/jpeg;base64,") Тогда
						Префикс = "data:image/jpeg;base64,";
					КонецЕсли;
				КонецЕсли;
				Если ПустаяСтрока(Префикс)
					Или Не КорректнаяСтрокаBase64(Сред(Элемент.Значение, СтрДлина(Префикс) + 1)) Тогда
					Находок = Находок + 1;
				КонецЕсли;
				Продолжить;
			ИначеЕсли ЭтоДанныеФайла(Контекст, Значение, Элемент.Ключ) Тогда
				Если ТипЗнч(Элемент.Значение) <> Тип("Строка") Или Не СтрНачинаетсяС(Элемент.Значение, ПрефиксPDF())
					Или Не КорректнаяСтрокаBase64(Сред(Элемент.Значение, СтрДлина(ПрефиксPDF()) + 1)) Тогда
					Находок = Находок + 1;
				КонецЕсли;
				Продолжить;
			ИначеЕсли Контекст = "источникДокумента" И Элемент.Ключ = "data" Тогда
				Если Значение.Получить("type") <> "base64" Или Значение.Получить("media_type") <> "application/pdf"
					Или Не КорректнаяСтрокаBase64(Элемент.Значение) Тогда
					Находок = Находок + 1;
				КонецЕсли;
				Продолжить;
			ИначеЕсли Контекст = "источникИзображения" И Элемент.Ключ = "data" Тогда
				Если Значение.Получить("type") <> "base64"
					Или (Значение.Получить("media_type") <> "image/png" И Значение.Получить("media_type") <> "image/jpeg")
					Или Не КорректнаяСтрокаBase64(Элемент.Значение) Тогда
					Находок = Находок + 1;
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			СледующийКонтекст = ?(Контекст = "данныеИнструмента", Контекст, "");
			Если Контекст = "тело" И (Элемент.Ключ = "messages" Или Элемент.Ключ = "input") Тогда
				СледующийКонтекст = "сообщения";
			ИначеЕсли Контекст = "сообщение" И Элемент.Ключ = "tool_calls" Тогда
				СледующийКонтекст = "вызовы";
			ИначеЕсли Контекст = "сообщение" И Элемент.Ключ = "function_call" Тогда
				СледующийКонтекст = "вызовФункции";
			ИначеЕсли Контекст = "вызов" И Элемент.Ключ = "function" Тогда
				СледующийКонтекст = "функция";
			ИначеЕсли (Контекст = "сообщение" Или Контекст = "блок" И Значение.Получить("type") = "tool_result")
				И Элемент.Ключ = "content" Тогда
				СледующийКонтекст = "содержимое";
			ИначеЕсли Контекст = "блок" Тогда
				Если Значение.Получить("type") = "image_url" И Элемент.Ключ = "image_url" Тогда
					СледующийКонтекст = "адресИзображения";
				ИначеЕсли Значение.Получить("type") = "image" И Элемент.Ключ = "source" Тогда
					СледующийКонтекст = "источникИзображения";
				ИначеЕсли Значение.Получить("type") = "file" И Элемент.Ключ = "file" Тогда
					СледующийКонтекст = "файл";
				ИначеЕсли Значение.Получить("type") = "document" И Элемент.Ключ = "source" Тогда
					СледующийКонтекст = "источникДокумента";
				КонецЕсли;
			КонецЕсли;
			ПроверитьСтрокуЗапроса(Строка(Элемент.Ключ), Находок, ПутьЭлемента + "(ключ)", Диагностика, Кэш);
			ПроверитьЗначениеЗапроса(Элемент.Значение, Находок, СледующийКонтекст, ПутьЭлемента, Диагностика, Кэш);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Понятное сообщение пользователю о блокировке запроса: где и что похоже на ПДн или секрет, что делать.
Функция СообщениеОБлокировке(Диагностика, Сообщения)

	Места = ОписаниеДиагностики(Диагностика, Сообщения, "; ");
	Если ПустаяСтрока(Места) Тогда
		Места = НСтр("ru = 'запрос не удалось проверить'");
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'Ассистент не отправил запрос модели: %1. Это защита от передачи персональных данных и секретов во внешнюю модель.
		|Переформулируйте вопрос или начните новый диалог. Если блокировка повторяется на обычных данных, сообщите администратору: подробности - в журнале регистрации, событие «ИИАссистент.LLM».'"), Места);

КонецФункции

// Места находок по-русски: какая часть запроса (вопрос, ответ модели, результат инструмента) и что найдено.
Функция ОписаниеДиагностики(Диагностика, Сообщения, Разделитель)

	Строки = Новый Массив;
	Если ТипЗнч(Диагностика) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Находка Из Диагностика Цикл
		Строки.Добавить(СтрШаблон(НСтр("ru = 'в «%1» найдено похожее на: %2'"), МестоВЗапросе(Находка.Путь, Сообщения),
			Находка.Причина));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Разделитель);

КонецФункции

Функция МестоВЗапросе(Путь, Сообщения)

	Если СтрНачинаетсяС(Путь, ".tools") Или СтрНачинаетсяС(Путь, ".functions") Тогда
		Возврат НСтр("ru = 'описания инструментов'");
	ИначеЕсли СтрНачинаетсяС(Путь, ".system") Тогда
		Возврат НСтр("ru = 'системные инструкции'");
	ИначеЕсли Не СтрНачинаетсяС(Путь, ".messages[") Тогда
		Возврат Путь;
	КонецЕсли;
	Хвост = Сред(Путь, СтрДлина(".messages[") + 1);
	Позиция = СтрНайти(Хвост, "]");
	ТекстИндекса = Лев(Хвост, Позиция - 1);
	// Повреждённый индекс необязательной подписи не меняет решение проверки; сохраняется путь.
	Если ПустаяСтрока(ТекстИндекса) Или Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ТекстИндекса) Тогда
		Возврат Путь;
	КонецЕсли;
	Индекс = Число(ТекстИндекса);
	Если ТипЗнч(Сообщения) <> Тип("Массив") Или Индекс > Сообщения.ВГраница() Тогда
		Возврат Путь;
	КонецЕсли;
	Сообщение = Сообщения[Индекс];
	Роль = Строка(Сообщение.Получить("role"));
	Если Роль = "system" Тогда
		Возврат НСтр("ru = 'системные инструкции'");
	ИначеЕсли Роль = "user" Тогда
		Возврат НСтр("ru = 'вопрос пользователя или история диалога'");
	ИначеЕсли Роль = "assistant" И СтрНайти(Путь, "tool_calls") > 0 Тогда
		Возврат СтрШаблон(НСтр("ru = 'аргументы вызова инструмента %1'"), ИмяВызоваПоПути(Сообщение, Путь));
	ИначеЕсли Роль = "assistant" Тогда
		Возврат НСтр("ru = 'промежуточный ответ модели'");
	ИначеЕсли Роль = "tool" Тогда
		Возврат СтрШаблон(НСтр("ru = 'результат инструмента %1'"), ИмяИнструментаРезультата(Сообщение, Сообщения, Индекс));
	Иначе
		Возврат Путь;
	КонецЕсли;

КонецФункции

Функция ИмяВызоваПоПути(Сообщение, Путь)

	Вызовы = Сообщение.Получить("tool_calls");
	Если ТипЗнч(Вызовы) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Путь, СтрНайти(Путь, "tool_calls[") + СтрДлина("tool_calls["));
	ТекстИндекса = Лев(Хвост, СтрНайти(Хвост, "]") - 1);
	Если ПустаяСтрока(ТекстИндекса) Или Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ТекстИндекса) Тогда
		Возврат "";
	КонецЕсли;
	Индекс = Число(ТекстИндекса);
	Попытка
		Возврат Строка(Вызовы[Индекс].Получить("function").Получить("name"));
	// Необязательная подпись инструмента отсутствует при повреждённой ссылке.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат "";
	КонецПопытки;

КонецФункции

Функция ИмяИнструментаРезультата(Сообщение, Сообщения, Индекс)

	Ид = Сообщение.Получить("tool_call_id");
	Для Номер = 1 По Индекс Цикл
		Вызовы = Сообщения[Индекс - Номер].Получить("tool_calls");
		Если ТипЗнч(Вызовы) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Вызов Из Вызовы Цикл
			Если Вызов.Получить("id") = Ид Тогда
				Возврат Строка(Вызов.Получить("function").Получить("name"));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат "";

КонецФункции

Процедура ПроверитьСтрокуЗапроса(Текст, Находок, Путь, Диагностика, Кэш = Неопределено)

	// Кэшируются только строки без находок: для строки с находкой каждый раз нужна её диагностика.
	Если Кэш <> Неопределено И Кэш.Проверенные.Получить(Текст) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Категории = ?(Диагностика = Неопределено, Неопределено, Новый Массив);
	ДоПроверки = Находок;
	ИИА_Периметр.ОчиститьТекст(Текст, Находок, Категории);
	Если Находок > ДоПроверки И Категории <> Неопределено Тогда
		ДобавитьДиагностику(Диагностика, Путь, СтрСоединить(Категории, ", "));
	ИначеЕсли Находок = ДоПроверки И Кэш <> Неопределено Тогда
		Кэш.Проверенные.Вставить(Текст, Истина);
	КонецЕсли;

КонецПроцедуры

Функция ОчищенныйТекст(Текст, Скрыто, Кэш)

	Запись = Кэш.Очищенные.Получить(Текст);
	Если Запись = Неопределено Тогда
		Найдено = 0;
		Запись = Новый Структура("Текст, Скрыто", ИИА_Периметр.ОчиститьТекст(Текст, Найдено), Найдено);
		Кэш.Очищенные.Вставить(Текст, Запись);
	КонецЕсли;
	Скрыто = Скрыто + Запись.Скрыто;
	Возврат Запись.Текст;

КонецФункции

Функция ВремяИстекло(ПредельныйМомент)

	Возврат ПредельныйМомент > 0 И ТекущаяУниверсальнаяДатаВМиллисекундах() >= ПредельныйМомент - 1000;

КонецФункции

Функция ОшибкаВремениИсследования()

	Возврат НСтр("ru = 'RESEARCH_TIME_LIMIT: время на ответ исчерпано.'");

КонецФункции

// Служебные идентификаторы вызовов инструментов (id вызова, tool_call_id, tool_use_id) - не данные.
// В аргументах инструмента (Контекст = "данныеИнструмента") ключ id - данные модели и проверяется.
Функция ЭтоИдентификаторВызова(Контекст, Ключ)

	Если Контекст = "данныеИнструмента" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Ключ = "id" Или Ключ = "tool_call_id" Или Ключ = "tool_use_id" Или Ключ = "functions_state_id"
		Или Ключ = "call_id";

КонецФункции

// Подпись блока thinking и зашифрованный блок redacted_thinking выдаёт Anthropic в ответе: это не данные
// пользователя, и менять их нельзя - изменённый блок провайдер отклоняет. Текст рассуждений проверяется.
Функция ЭтоПодписьРассуждений(Контекст, Блок, Ключ)

	Возврат Контекст = "блок" И (Блок.Получить("type") = "thinking" И Ключ = "signature"
		Или Блок.Получить("type") = "redacted_thinking" И Ключ = "data")
		Или Контекст = "сообщение" И Блок.Получить("type") = "reasoning" И Ключ = "encrypted_content";

КонецФункции

// Адрес изображения: image_url.url в OpenAI chat/completions, image_url блока input_image в Responses.
Функция ЭтоАдресИзображения(Контекст, Значение, Ключ)

	Возврат Контекст = "адресИзображения" И Ключ = "url"
		Или Контекст = "блок" И Значение.Получить("type") = "input_image" И Ключ = "image_url";

КонецФункции

// PDF: file.file_data в OpenAI chat/completions, file_data блока input_file в Responses.
Функция ЭтоДанныеФайла(Контекст, Значение, Ключ)

	Возврат Контекст = "файл" И Ключ = "file_data"
		Или Контекст = "блок" И Значение.Получить("type") = "input_file" И Ключ = "file_data";

КонецФункции

// Строка JSON аргументов: function.arguments вызова chat/completions, arguments элемента function_call Responses.
Функция ЭтоАргументыВызова(Контекст, Значение, Ключ)

	Возврат Ключ = "arguments" И (Контекст = "функция"
		Или Контекст = "сообщение" И Значение.Получить("type") = "function_call");

КонецФункции

Процедура ДобавитьДиагностику(Диагностика, Путь, Причина)

	Если Диагностика <> Неопределено И Диагностика.Количество() < 20 Тогда
		Диагностика.Добавить(Новый Структура("Путь, Причина", Путь, Причина));
	КонецЕсли;

КонецПроцедуры

// Декодирование с обратным кодированием исключает текст, замаскированный префиксом изображения.
Функция КорректнаяСтрокаBase64(Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") Или ПустаяСтрока(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Код = СтрЗаменить(СтрЗаменить(Значение, Символы.ВК, ""), Символы.ПС, "");
	Попытка
		ВосстановленныйКод = Base64Строка(Base64Значение(Код));
	Исключение
		ЗаписьЖурналаРегистрации("ИИАссистент.LLM", УровеньЖурналаРегистрации.Предупреждение, , , "IMAGE_BASE64_INVALID");
		Возврат Ложь;
	КонецПопытки;
	Возврат Код = СтрЗаменить(СтрЗаменить(ВосстановленныйКод, Символы.ВК, ""), Символы.ПС, "");

КонецФункции

// Стоп-проверка: каждый текст сообщения проходит детекторы периметра (ПДн, секреты, ФИО).
Функция ОчищенныеСообщения(Сообщения, Скрыто, Кэш)

	Результат = Новый Массив;
	Для Каждого Сообщение Из Сообщения Цикл
		Копия = Новый Соответствие;
		Для Каждого КлючИЗначение Из Сообщение Цикл
			Если КлючИЗначение.Ключ = "content" И ТипЗнч(КлючИЗначение.Значение) = Тип("Строка")
				И Сообщение.Получить("role") <> "system" Тогда
				Копия.Вставить("content", ОчищенныйТекст(КлючИЗначение.Значение, Скрыто, Кэш));
			ИначеЕсли КлючИЗначение.Ключ = "content" И ТипЗнч(КлючИЗначение.Значение) = Тип("Массив") Тогда
				// Мультимодальное содержимое: текстовые части проходят стоп-проверку, изображения - как есть.
				Части = Новый Массив;
				Для Каждого Часть Из КлючИЗначение.Значение Цикл
					Если ТипЗнч(Часть) = Тип("Соответствие") И Часть.Получить("type") = "text" Тогда
						КопияЧасти = Новый Соответствие;
						КопияЧасти.Вставить("type", "text");
						КопияЧасти.Вставить("text", ОчищенныйТекст(Строка(Часть.Получить("text")), Скрыто, Кэш));
						Части.Добавить(КопияЧасти);
					Иначе
						Части.Добавить(Часть);
					КонецЕсли;
				КонецЦикла;
				Копия.Вставить("content", Части);
			Иначе
				Копия.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
			КонецЕсли;
		КонецЦикла;
		Результат.Добавить(Копия);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ОтправитьЗапрос(Настройки, ТелоJSON, ПредельныйМомент = 0)

	Ответ = Новый Структура("Успех, Тело, Ошибка", Ложь, "", "");

	Ключ = КлючПодключения(Настройки.Подключение);
	ЭтоAnthropic = Настройки.Свойство("Протокол") И Настройки.Протокол = Перечисления.ИИА_ПротоколыAPI.Anthropic;
	ЭтоACP = Настройки.Свойство("Протокол") И Настройки.Протокол = Перечисления.ИИА_ПротоколыAPI.ACP;
	ЭтоGigaChat = Настройки.Свойство("Протокол") И Настройки.Протокол = Перечисления.ИИА_ПротоколыAPI.GigaChat;
	ЭтоResponses = Настройки.Свойство("Протокол") И Настройки.Протокол = Перечисления.ИИА_ПротоколыAPI.OpenAIResponses;
	РежимПрокси = ?(Настройки.Свойство("Прокси"), Настройки.Прокси, Неопределено);
	Если ЭтоACP И ПустаяСтрока(Ключ) Тогда
		Ответ.Ошибка = НСтр("ru = 'Ключ моста ACP не сохранён: откройте подключение и нажмите «Проверить подключение», ключ подставится автоматически.'");
		Возврат Ответ;
	КонецЕсли;
	КлючАвторизации = Ключ;
	Если ЭтоGigaChat Тогда
		Попытка
			Ключ = ТокенGigaChat(Настройки.Подключение, КлючАвторизации, Настройки.ОбластьДоступа, , РежимПрокси);
		Исключение
			Ответ.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , , "GIGACHAT_TOKEN_FAILED");
			Возврат Ответ;
		КонецПопытки;
	КонецЕсли;
	Заголовки = ЗаголовкиАвторизации(Настройки.Протокол, Ключ);

	Попытка
		Если ЭтоAnthropic Тогда
			Ресурс = "messages";
		ИначеЕсли ЭтоResponses Тогда
			Ресурс = "responses";
		Иначе
			Ресурс = "chat/completions";
		КонецЕсли;
		Адрес = ИИА_HTTPКлиент.АдресРесурса(Настройки.Адрес, Ресурс);
		Если ЭтоACP Тогда
			СтруктураURL = ИИА_HTTPКоннектор.РазобратьURL(Адрес);
			Если НРег(СтруктураURL.Сервер) <> "localhost" И СтруктураURL.Сервер <> "127.0.0.1"
				И СтруктураURL.Сервер <> "[::1]" Тогда
				Ответ.Ошибка = НСтр("ru = 'Мост ACP должен работать на localhost сервера 1С.'");
				Возврат Ответ;
			КонецЕсли;
		КонецЕсли;
		// Повтор ACP может повторно запустить CLI и расходовать лимит подписки.
		Таймаут = Настройки.Таймаут;
		Если ПредельныйМомент > 0 Тогда
			Остаток = Цел((ПредельныйМомент - ТекущаяУниверсальнаяДатаВМиллисекундах()) / 1000);
			Если Остаток < 1 Тогда
				Ответ.Ошибка = ОшибкаВремениИсследования();
				Возврат Ответ;
			КонецЕсли;
			Таймаут = Мин(Таймаут, Остаток);
		КонецЕсли;
		ОтветHTTP = ИИА_HTTPКлиент.Post(Адрес, ТелоJSON, Заголовки, Таймаут, Не ЭтоACP, РежимПрокси);
		// Сохранённый токен GigaChat мог быть отозван раньше срока: один повтор с новым токеном.
		Если ЭтоGigaChat И ОтветHTTP.КодСостояния = 401 Тогда
			Заголовки = ЗаголовкиАвторизации(Настройки.Протокол,
				ТокенGigaChat(Настройки.Подключение, КлючАвторизации, Настройки.ОбластьДоступа, Истина, РежимПрокси));
			ОтветHTTP = ИИА_HTTPКлиент.Post(Адрес, ТелоJSON, Заголовки, Таймаут, Истина, РежимПрокси);
		КонецЕсли;
	Исключение
		// Причина (DNS, TLS, прокси, таймаут) нужна администратору; ключ передаётся в заголовках и в текст ошибки не попадает.
		Информация = ИнформацияОбОшибке();
		Ответ.Ошибка = СтрШаблон(НСтр("ru = 'ошибка подключения или истёк таймаут: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(Информация));
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
			"HTTP_REQUEST_FAILED: " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));
		Возврат Ответ;
	КонецПопытки;

	Если ОтветHTTP.КодСостояния = 200 Тогда
		Ответ.Успех = Истина;
		Ответ.Тело = ОтветHTTP.Тело;
		Если ЭтоAnthropic Тогда
			Попытка
				Ответ.Тело = ОтветAnthropicКакOpenAI(Ответ.Тело);
			Исключение
				Ответ.Успех = Ложь;
				Ответ.Ошибка = НСтр("ru = 'неожиданный формат ответа Anthropic'");
				ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
					"ANTHROPIC_RESPONSE_INVALID");
			КонецПопытки;
		ИначеЕсли ЭтоResponses Тогда
			Попытка
				Ответ.Тело = ОтветResponsesКакOpenAI(Ответ.Тело);
			Исключение
				Ответ.Успех = Ложь;
				Ответ.Ошибка = НСтр("ru = 'неожиданный формат ответа OpenAI Responses'");
				ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
					"RESPONSES_RESPONSE_INVALID");
			КонецПопытки;
		ИначеЕсли ЭтоGigaChat Тогда
			Попытка
				Ответ.Тело = ОтветGigaChatКакOpenAI(Ответ.Тело);
			Исключение
				Ответ.Успех = Ложь;
				Ответ.Ошибка = НСтр("ru = 'неожиданный формат ответа GigaChat'");
				ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
					"GIGACHAT_RESPONSE_INVALID");
			КонецПопытки;
		КонецЕсли;
		Возврат Ответ;
	КонецЕсли;

	ТекстПровайдера = ?(ЭтоACP, "", ТекстОшибкиПровайдера(ОтветHTTP.Тело));
	Если ЭтоACP Тогда
		Ответ.Ошибка = ТекстОшибкиМостаACP(ОтветHTTP.КодСостояния, ОтветHTTP.Тело);
	Иначе
		Ответ.Ошибка = СтрШаблон(НСтр("ru = 'код %1'"), ОтветHTTP.КодСостояния)
			+ ?(ПустаяСтрока(ТекстПровайдера), "", ": " + ТекстПровайдера);
	КонецЕсли;
	ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
		СтрШаблон("HTTP_STATUS_%1", ОтветHTTP.КодСостояния) + ?(ПустаяСтрока(ТекстПровайдера), "", ": " + ТекстПровайдера));
	Возврат Ответ;

КонецФункции

// Текст error.message из ответа провайдера (OpenAI, Anthropic, OpenRouter): какой параметр отклонён.
// Тело запроса провайдеры в ошибку не включают; текст обрезается до 300 символов.
Функция ТекстОшибкиПровайдера(Тело)

	Текст = "";
	Попытка
		Данные = ОбщегоНазначения.JSONВЗначение(Тело, , Истина);
		Ошибка = ?(ТипЗнч(Данные) = Тип("Соответствие"), Данные.Получить("error"), Неопределено);
		Если ТипЗнч(Ошибка) = Тип("Соответствие") И ТипЗнч(Ошибка.Получить("message")) = Тип("Строка") Тогда
			Текст = Ошибка.Получить("message");
		ИначеЕсли ТипЗнч(Ошибка) = Тип("Строка") Тогда
			Текст = Ошибка;
		КонецЕсли;
	// Не JSON: показывается только HTTP-код.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Текст = "";
	КонецПопытки;
	Текст = СокрЛП(СтрЗаменить(СтрЗаменить(Текст, Символы.ПС, " "), Символы.ВК, " "));
	Возврат ?(СтрДлина(Текст) > 300, Лев(Текст, 300) + "…", Текст);

КонецФункции

// Модель, которой ответил агент за мостом ACP (поле agent_model ответа); пустая строка - мост её не знает.
Функция МодельАгента(Данные)

	Модель = ?(ТипЗнч(Данные) = Тип("Соответствие"), Данные.Получить("agent_model"), Неопределено);
	Возврат ?(ТипЗнч(Модель) = Тип("Строка"), Лев(СокрЛП(Модель), 128), "");

КонецФункции

// Понятный текст ошибки локального моста ACP. Мост отдаёт только код ошибки, без текста агента.
Функция ТекстОшибкиМостаACP(КодСостояния, Тело)

	Если КодСостояния = 401 Тогда
		Возврат НСтр("ru = 'Ключ моста ACP не совпадает: откройте подключение и нажмите «Проверить подключение», ключ подставится автоматически.'");
	КонецЕсли;
	Код = "";
	Попытка
		Ошибка = ОбщегоНазначения.JSONВЗначение(Тело, , Истина).Получить("error");
		Код = Строка(Ошибка.Получить("code"));
	// Не JSON: показывается HTTP-код.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Код = "";
	КонецПопытки;
	Если Код = "agent_auth_required" Тогда
		Возврат НСтр("ru = 'Агент требует входа: войдите в его CLI в терминале на этом компьютере (например, claude, codex login, opencode auth login, kimi login, qwen) и повторите.'");
	ИначеЕсли Код = "agent_not_installed" Или Код = "unknown_profile" Или Код = "unsafe_command_wrapper" Тогда
		Возврат НСтр("ru = 'Агент не найден на компьютере с мостом ACP: выберите в подключении агента из списка установленных.'");
	ИначеЕсли Код = "agent_provider_error" Тогда
		Возврат НСтр("ru = 'Агент не смог обратиться к своей модели: модель по умолчанию снята, недоступна или исчерпан лимит. Выберите в CLI агента рабочую модель (например, параметр model в его конфигурации) и повторите.'");
	ИначеЕсли Код = "agent_timeout" Тогда
		Возврат НСтр("ru = 'Агент не ответил за отведённое мостом время.'");
	ИначеЕсли Код = "bridge_busy" Тогда
		Возврат НСтр("ru = 'Мост ACP занят другими запросами, повторите позже.'");
	ИначеЕсли Код = "agent_images_not_supported" Тогда
		Возврат НСтр("ru = 'Агент не принимает изображения: снимите в подключении флажок «Принимает изображения» или выберите другого агента.'");
	ИначеЕсли Код = "invalid_image" Или Код = "too_many_images" Тогда
		Возврат НСтр("ru = 'Мост ACP принимает до 10 изображений PNG, JPEG, GIF или WEBP.'");
	ИначеЕсли Код = "agent_cli_error" Тогда
		Возврат НСтр("ru = 'CLI агента завершил ход с ошибкой: проверьте его запуском в терминале на этом компьютере.'");
	ИначеЕсли Код = "payload_limit" Тогда
		Возврат НСтр("ru = 'Запрос слишком велик для моста ACP: уменьшите изображения или их количество.'");
	ИначеЕсли СтрДлина(Код) > 0 И СтрДлина(Код) <= 64 Тогда
		Возврат СтрШаблон(НСтр("ru = 'мост ACP: %1'"), Код);
	Иначе
		Возврат СтрШаблон(НСтр("ru = 'код %1'"), КодСостояния);
	КонецЕсли;

КонецФункции

#Область GigaChat

// Тело запроса GigaChat из сообщений и инструментов в формате OpenAI. GigaChat принимает описания
// functions, один вызов function_call в сообщении ассистента с аргументами-объектом и результат в сообщении
// роли function с JSON-содержимым; системное сообщение - только первое.
// Несколько вызовов одного сообщения ассистента (история другой модели) разворачиваются в пары
// «вызов - результат» в порядке результатов.
Функция ТелоGigaChat(Сообщения, Инструменты, Модель)

	Системные = Новый Массив;
	Диалог = Новый Массив;
	ИменаВызовов = Новый Соответствие;
	ОжидающиеВызовы = Новый Соответствие;
	Для Каждого Сообщение Из Сообщения Цикл
		Роль = Сообщение.Получить("role");
		Текст = ТекстСодержимого(Сообщение.Получить("content"));
		Если Роль = "system" Тогда
			Системные.Добавить(Текст);
		ИначеЕсли Роль = "tool" Тогда
			Ид = Сообщение.Получить("tool_call_id");
			Вызов = ОжидающиеВызовы.Получить(Ид);
			Если Вызов <> Неопределено Тогда
				Диалог.Добавить(Вызов);
				ОжидающиеВызовы.Удалить(Ид);
			КонецЕсли;
			Результат = Новый Соответствие;
			Результат.Вставить("role", "function");
			Результат.Вставить("name", ИменаВызовов.Получить(Ид));
			Результат.Вставить("content", РезультатФункцииGigaChat(Текст));
			Диалог.Добавить(Результат);
		ИначеЕсли Роль = "assistant" И ТипЗнч(Сообщение.Получить("tool_calls")) = Тип("Массив")
			И Сообщение.Получить("tool_calls").Количество() > 0 Тогда
			Первый = Истина;
			Для Каждого ВызовOpenAI Из Сообщение.Получить("tool_calls") Цикл
				Функция_ = ВызовOpenAI.Получить("function");
				Аргументы = ОбщегоНазначения.JSONВЗначение(Строка(Функция_.Получить("arguments")), , Истина);
				Если ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
					ВызватьИсключение НСтр("ru = 'Некорректный формат аргументов инструмента.'");
				КонецЕсли;
				ВызовФункции = Новый Соответствие;
				ВызовФункции.Вставить("name", Функция_.Получить("name"));
				ВызовФункции.Вставить("arguments", Аргументы);
				Вызов = Новый Соответствие;
				Вызов.Вставить("role", "assistant");
				Вызов.Вставить("content", "");
				Вызов.Вставить("function_call", ВызовФункции);
				Ид = ВызовOpenAI.Получить("id");
				ИменаВызовов.Вставить(Ид, Функция_.Получить("name"));
				// Первый вызов идёт сразу, с текстом и состоянием функций; остальные - перед своими результатами.
				Если Первый Тогда
					Вызов.Вставить("content", Текст);
					Если ЗначениеЗаполнено(Сообщение.Получить("functions_state_id")) Тогда
						Вызов.Вставить("functions_state_id", Сообщение.Получить("functions_state_id"));
					КонецЕсли;
					Диалог.Добавить(Вызов);
					Первый = Ложь;
				Иначе
					ОжидающиеВызовы.Вставить(Ид, Вызов);
				КонецЕсли;
			КонецЦикла;
		Иначе
			Новое = Новый Соответствие;
			Новое.Вставить("role", ?(Роль = "assistant", "assistant", "user"));
			Новое.Вставить("content", Текст);
			Диалог.Добавить(Новое);
		КонецЕсли;
	КонецЦикла;
	Если Системные.Количество() > 0 Тогда
		Системное = Новый Соответствие;
		Системное.Вставить("role", "system");
		Системное.Вставить("content", СтрСоединить(Системные, Символы.ПС + Символы.ПС));
		Диалог.Вставить(0, Системное);
	КонецЕсли;

	Тело = Новый Соответствие;
	Тело.Вставить("model", Модель);
	Тело.Вставить("messages", Диалог);
	Если Инструменты.Количество() > 0 Тогда
		Функции = Новый Массив;
		Для Каждого Инструмент Из Инструменты Цикл
			Функция_ = Инструмент.Получить("function");
			Описание = Новый Соответствие;
			Описание.Вставить("name", Функция_.Получить("name"));
			Описание.Вставить("description", Функция_.Получить("description"));
			Описание.Вставить("parameters", Функция_.Получить("parameters"));
			Функции.Добавить(Описание);
		КонецЦикла;
		Тело.Вставить("functions", Функции);
		Тело.Вставить("function_call", "auto");
	КонецЕсли;
	Возврат Тело;

КонецФункции

// Ответ GigaChat -> ответ в формате OpenAI chat/completions. Идентификатор вызова GigaChat не выдаёт:
// он создаётся здесь и связывает вызов с результатом в истории хода.
Функция ОтветGigaChatКакOpenAI(ТелоJSON)

	Данные = ОбщегоНазначения.JSONВЗначение(ТелоJSON, , Истина);
	Выбор = Данные.Получить("choices")[0];
	Исходное = Выбор.Получить("message");
	Текст = Исходное.Получить("content");
	Сообщение = Новый Соответствие;
	Сообщение.Вставить("role", "assistant");
	Сообщение.Вставить("content", ?(ТипЗнч(Текст) = Тип("Строка"), Текст, ""));
	ВызовФункции = Исходное.Получить("function_call");
	Если ТипЗнч(ВызовФункции) = Тип("Соответствие") Тогда
		Аргументы = ВызовФункции.Получить("arguments");
		Функция_ = Новый Соответствие;
		Функция_.Вставить("name", ВызовФункции.Получить("name"));
		Если ТипЗнч(Аргументы) <> Тип("Строка") Тогда
			Аргументы = ОбщегоНазначения.ЗначениеВJSON(?(Аргументы = Неопределено, Новый Соответствие, Аргументы));
		КонецЕсли;
		Функция_.Вставить("arguments", Аргументы);
		Вызов = Новый Соответствие;
		Вызов.Вставить("id", "call_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""));
		Вызов.Вставить("type", "function");
		Вызов.Вставить("function", Функция_);
		Вызовы = Новый Массив;
		Вызовы.Добавить(Вызов);
		Сообщение.Вставить("tool_calls", Вызовы);
	КонецЕсли;
	Состояние = Исходное.Получить("functions_state_id");
	Если ТипЗнч(Состояние) = Тип("Строка") И Не ПустаяСтрока(Состояние) Тогда
		Сообщение.Вставить("functions_state_id", Состояние);
	КонецЕсли;
	Причина = Выбор.Получить("finish_reason");
	Результат = Новый Соответствие;
	ВыборOpenAI = Новый Соответствие;
	ВыборOpenAI.Вставить("message", Сообщение);
	ВыборOpenAI.Вставить("finish_reason", ?(Причина = "function_call", "tool_calls", Причина));
	Выборы = Новый Массив;
	Выборы.Добавить(ВыборOpenAI);
	Результат.Вставить("choices", Выборы);
	Использование = Данные.Получить("usage");
	Если ТипЗнч(Использование) = Тип("Соответствие") Тогда
		Токены = Новый Соответствие;
		Токены.Вставить("prompt_tokens", Использование.Получить("prompt_tokens"));
		Токены.Вставить("completion_tokens", Использование.Получить("completion_tokens"));
		Кэш = Новый Соответствие;
		Кэш.Вставить("cached_tokens", Использование.Получить("precached_prompt_tokens"));
		Токены.Вставить("prompt_tokens_details", Кэш);
		Результат.Вставить("usage", Токены);
	КонецЕсли;
	Возврат ОбщегоНазначения.ЗначениеВJSON(Результат);

КонецФункции

// Токен доступа GigaChat по ключу авторизации. Токен живёт 30 минут и хранится в безопасном хранилище
// подключения; без подключения (ключ из формы до записи) запрашивается каждый раз.
Функция ТокенGigaChat(Подключение, КлючАвторизации, ОбластьДоступа, Обновить = Ложь, РежимПрокси = Неопределено)

	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если ЗначениеЗаполнено(Подключение) И Не Обновить Тогда
		УстановитьПривилегированныйРежим(Истина);
		Сохраненный = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Подключение, "ТокенДоступа");
		УстановитьПривилегированныйРежим(Ложь);
		Если ТипЗнч(Сохраненный) = Тип("Структура") И Сохраненный.Свойство("Токен")
			И Сохраненный.ДействуетДо > Сейчас + 60000 Тогда
			Возврат Сохраненный.Токен;
		КонецЕсли;
	КонецЕсли;
	Ключ = СокрЛП(КлючАвторизации);
	Если СтрНачинаетсяС(НРег(Ключ), "basic ") Тогда
		Ключ = СокрЛП(Сред(Ключ, 7));
	КонецЕсли;
	Если ПустаяСтрока(Ключ) Тогда
		ВызватьИсключение НСтр("ru = 'Для GigaChat укажите ключ авторизации (Authorization key) в поле «Ключ API».'");
	КонецЕсли;
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Заголовки.Вставить("Accept", "application/json");
	Заголовки.Вставить("RqUID", Строка(Новый УникальныйИдентификатор));
	Заголовки.Вставить("Authorization", "Basic " + Ключ);
	Попытка
		Ответ = ИИА_HTTPКлиент.Post(АдресТокенаGigaChat(),
			"scope=" + ?(ПустаяСтрока(ОбластьДоступа), "GIGACHAT_API_PERS", СокрЛП(ОбластьДоступа)), Заголовки, 30, , РежимПрокси);
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , , "GIGACHAT_OAUTH_FAILED");
		ВызватьИсключение НСтр("ru = 'Нет связи с сервером авторизации GigaChat. Проверьте доступ к ngw.devices.sberbank.ru:9443 и сертификат НУЦ Минцифры в хранилище сервера 1С.'");
	КонецПопытки;
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'GigaChat не выдал токен доступа (код %1): проверьте ключ авторизации и область доступа.'"),
			Ответ.КодСостояния);
	КонецЕсли;
	Данные = ОбщегоНазначения.JSONВЗначение(Ответ.Тело, , Истина);
	Токен = Данные.Получить("access_token");
	Если ТипЗнч(Токен) <> Тип("Строка") Или ПустаяСтрока(Токен) Тогда
		ВызватьИсключение НСтр("ru = 'GigaChat вернул ответ авторизации без токена.'");
	КонецЕсли;
	Если ЗначениеЗаполнено(Подключение) Тогда
		ДействуетДо = Данные.Получить("expires_at");
		УстановитьПривилегированныйРежим(Истина);
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Подключение, Новый Структура("Токен, ДействуетДо", Токен,
			?(ТипЗнч(ДействуетДо) = Тип("Число"), ДействуетДо, Сейчас + 25 * 60000)), "ТокенДоступа");
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	Возврат Токен;

КонецФункции

Функция АдресТокенаGigaChat()

	Возврат "https://ngw.devices.sberbank.ru:9443/api/v2/oauth";

КонецФункции

// Содержимое сообщения роли function должно быть JSON: текст результата инструмента заворачивается в объект.
Функция РезультатФункцииGigaChat(Текст)

	Попытка
		Значение = ОбщегоНазначения.JSONВЗначение(Текст, , Истина);
	// Текст не JSON - обычный результат инструмента, ниже он заворачивается в объект.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Значение = Неопределено;
	КонецПопытки;
	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат ОбщегоНазначения.ЗначениеВJSON(Новый Структура("result", Текст));

КонецФункции

// Текст сообщения: строка или текстовые части мультимодального содержимого.
Функция ТекстСодержимого(Содержимое)

	Если ТипЗнч(Содержимое) = Тип("Строка") Тогда
		Возврат Содержимое;
	ИначеЕсли ТипЗнч(Содержимое) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;
	Тексты = Новый Массив;
	Для Каждого Часть Из Содержимое Цикл
		Если ТипЗнч(Часть) = Тип("Соответствие") И Часть.Получить("type") = "text" Тогда
			Тексты.Добавить(Строка(Часть.Получить("text")));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Тексты, Символы.ПС);

КонецФункции

#КонецОбласти

#Область OpenAIResponses

// Тело запроса OpenAI Responses (/v1/responses) из сообщений и инструментов в формате chat/completions.
// Системные сообщения собираются в instructions, вызовы инструментов ассистента - в элементы function_call,
// результаты - в function_call_output. Ответы у провайдера не хранятся (store=false): сообщение ассистента
// с рассуждениями повторяется элементами output исходного ответа, см. ЭлементыОтветаResponses.
Функция ТелоResponses(Сообщения, Инструменты, Модель)

	Системные = Новый Массив;
	Элементы = Новый Массив;
	Для Каждого Сообщение Из Сообщения Цикл
		Роль = Сообщение.Получить("role");
		Содержимое = Сообщение.Получить("content");
		Если Роль = "system" Тогда
			Системные.Добавить(ТекстСодержимого(Содержимое));
		ИначеЕсли Роль = "tool" Тогда
			Элемент = Новый Соответствие;
			Элемент.Вставить("type", "function_call_output");
			Элемент.Вставить("call_id", Сообщение.Получить("tool_call_id"));
			Элемент.Вставить("output", ТекстСодержимого(Содержимое));
			Элементы.Добавить(Элемент);
		ИначеЕсли Роль = "assistant" Тогда
			ДобавитьЭлементыАссистентаResponses(Элементы, Сообщение);
		Иначе
			Элемент = Новый Соответствие;
			Элемент.Вставить("role", ?(ТипЗнч(Роль) = Тип("Строка"), Роль, "user"));
			Если ТипЗнч(Содержимое) = Тип("Массив") Тогда
				Части = Новый Массив;
				Для Каждого Часть Из Содержимое Цикл
					Преобразованная = ЧастьResponses(Часть);
					Если Преобразованная <> Неопределено Тогда
						Части.Добавить(Преобразованная);
					КонецЕсли;
				КонецЦикла;
				Элемент.Вставить("content", Части);
			Иначе
				Элемент.Вставить("content", ?(ТипЗнч(Содержимое) = Тип("Строка"), Содержимое, ""));
			КонецЕсли;
			Элементы.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;

	Тело = Новый Соответствие;
	Тело.Вставить("model", Модель);
	Если Системные.Количество() > 0 Тогда
		Тело.Вставить("instructions", СтрСоединить(Системные, Символы.ПС + Символы.ПС));
	КонецЕсли;
	Тело.Вставить("input", Элементы);
	Тело.Вставить("store", Ложь);
	Если Инструменты.Количество() > 0 Тогда
		ИнструментыResponses = Новый Массив;
		Для Каждого Инструмент Из Инструменты Цикл
			Функция_ = Инструмент.Получить("function");
			Описание = Новый Соответствие;
			Описание.Вставить("type", "function");
			Описание.Вставить("name", Функция_.Получить("name"));
			Описание.Вставить("description", Функция_.Получить("description"));
			Описание.Вставить("parameters", Функция_.Получить("parameters"));
			// Строгий режим Responses (по умолчанию) требует закрытых схем, схемы инструментов ассистента не строгие.
			Описание.Вставить("strict", Ложь);
			ИнструментыResponses.Добавить(Описание);
		КонецЦикла;
		Тело.Вставить("tools", ИнструментыResponses);
		Тело.Вставить("tool_choice", "auto");
	КонецЕсли;
	Возврат Тело;

КонецФункции

Процедура ДобавитьЭлементыАссистентаResponses(Элементы, Сообщение)

	// Текст и вызовы берутся из обработанного сообщения (маскирование, номера диалога, контрольная проверка),
	// из сохранённого ответа - только рассуждения и идентификаторы элементов: сырые message и function_call
	// прежней модели повторно не отправляются.
	ИдСообщения = Неопределено;
	ИдВызовов = Новый Соответствие;
	Сохраненные = Сообщение.Получить(КлючЭлементовResponses());
	Если ТипЗнч(Сохраненные) = Тип("Массив") Тогда
		Для Каждого Элемент Из ЭлементыОтветаResponses(Сохраненные) Цикл
			ТипЭлемента = Элемент.Получить("type");
			Если ТипЭлемента = "reasoning" Тогда
				Элементы.Добавить(Элемент);
			ИначеЕсли ТипЭлемента = "function_call" Тогда
				ИдВызовов.Вставить(Элемент.Получить("call_id"), Элемент.Получить("id"));
			ИначеЕсли ТипЭлемента = "message" И ИдСообщения = Неопределено Тогда
				ИдСообщения = Элемент.Получить("id");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Текст = ТекстСодержимого(Сообщение.Получить("content"));
	Если Не ПустаяСтрока(Текст) Тогда
		Элемент = Новый Соответствие;
		Если ИдСообщения = Неопределено Тогда
			Элемент.Вставить("role", "assistant");
			Элемент.Вставить("content", Текст);
		Иначе
			Части = Новый Массив;
			Части.Добавить(Новый Структура("type, text", "output_text", Текст));
			Элемент.Вставить("type", "message");
			Элемент.Вставить("role", "assistant");
			Элемент.Вставить("id", ИдСообщения);
			Элемент.Вставить("content", Части);
		КонецЕсли;
		Элементы.Добавить(Элемент);
	КонецЕсли;
	Вызовы = Сообщение.Получить("tool_calls");
	Если ТипЗнч(Вызовы) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Вызов Из Вызовы Цикл
		Функция_ = Вызов.Получить("function");
		Элемент = Новый Соответствие;
		Элемент.Вставить("type", "function_call");
		Элемент.Вставить("call_id", Вызов.Получить("id"));
		Элемент.Вставить("name", Функция_.Получить("name"));
		Элемент.Вставить("arguments", Строка(Функция_.Получить("arguments")));
		Ид = ИдВызовов.Получить(Вызов.Получить("id"));
		Если Ид <> Неопределено Тогда
			Элемент.Вставить("id", Ид);
		КонецЕсли;
		Элементы.Добавить(Элемент);
	КонецЦикла;

КонецПроцедуры

Функция ЧастьResponses(Часть)

	Если ТипЗнч(Часть) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Соответствие;
	ТипЧасти = Часть.Получить("type");
	Если ТипЧасти = "text" Тогда
		Результат.Вставить("type", "input_text");
		Результат.Вставить("text", Строка(Часть.Получить("text")));
	ИначеЕсли ТипЧасти = "image_url" Тогда
		Изображение = Часть.Получить("image_url");
		Результат.Вставить("type", "input_image");
		Результат.Вставить("image_url",
			?(ТипЗнч(Изображение) = Тип("Соответствие"), Строка(Изображение.Получить("url")), ""));
	ИначеЕсли ТипЧасти = "file" Тогда
		Файл = Часть.Получить("file");
		Результат.Вставить("type", "input_file");
		Результат.Вставить("filename", "document.pdf");
		Результат.Вставить("file_data", ?(ТипЗнч(Файл) = Тип("Соответствие"), Строка(Файл.Получить("file_data")), ""));
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Элементы output прежнего ответа для следующего запроса хода. Рассуждения без зашифрованного содержимого
// без хранения у провайдера не повторить: они отбрасываются, а у остальных элементов снимаются id, иначе
// провайдер потребует связанный элемент рассуждений. Сводка рассуждений обратно не передаётся.
Функция ЭлементыОтветаResponses(Сохраненные)

	ЕстьНеповторимые = Ложь;
	Для Каждого Элемент Из Сохраненные Цикл
		Если ТипЗнч(Элемент) = Тип("Соответствие") И Элемент.Получить("type") = "reasoning"
			И ТипЗнч(Элемент.Получить("encrypted_content")) <> Тип("Строка") Тогда
			ЕстьНеповторимые = Истина;
		КонецЕсли;
	КонецЦикла;
	Результат = Новый Массив;
	Для Каждого Элемент Из Сохраненные Цикл
		Если ТипЗнч(Элемент) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		ТипЭлемента = Элемент.Получить("type");
		Копия = Новый Соответствие;
		Если ТипЭлемента = "reasoning" Тогда
			Если ЕстьНеповторимые Тогда
				Продолжить;
			КонецЕсли;
			Копия.Вставить("type", "reasoning");
			Копия.Вставить("id", Элемент.Получить("id"));
			Копия.Вставить("summary", Новый Массив);
			Копия.Вставить("encrypted_content", Элемент.Получить("encrypted_content"));
		ИначеЕсли ТипЭлемента = "function_call" Тогда
			Копия.Вставить("type", "function_call");
			Копия.Вставить("call_id", Элемент.Получить("call_id"));
			Копия.Вставить("name", Элемент.Получить("name"));
			Копия.Вставить("arguments", Строка(Элемент.Получить("arguments")));
		ИначеЕсли ТипЭлемента = "message" Тогда
			Копия.Вставить("type", "message");
			Копия.Вставить("role", "assistant");
			Копия.Вставить("content", Элемент.Получить("content"));
		Иначе
			Продолжить;
		КонецЕсли;
		Если ТипЭлемента <> "reasoning" И Не ЕстьНеповторимые И Элемент.Получить("id") <> Неопределено Тогда
			Копия.Вставить("id", Элемент.Получить("id"));
		КонецЕсли;
		Результат.Добавить(Копия);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ответ OpenAI Responses -> ответ в формате OpenAI chat/completions (choices[0].message, usage).
Функция ОтветResponsesКакOpenAI(ТелоJSON)

	Данные = ОбщегоНазначения.JSONВЗначение(ТелоJSON, , Истина);
	Тексты = Новый Массив;
	Вызовы = Новый Массив;
	ЕстьРассуждения = Ложь;
	ЭлементыОтвета = Данные.Получить("output");
	Для Каждого Элемент Из ЭлементыОтвета Цикл
		ТипЭлемента = Элемент.Получить("type");
		Если ТипЭлемента = "reasoning" Тогда
			ЕстьРассуждения = Истина;
		ИначеЕсли ТипЭлемента = "message" Тогда
			Для Каждого Часть Из Элемент.Получить("content") Цикл
				Если Часть.Получить("type") = "output_text" Тогда
					Тексты.Добавить(Строка(Часть.Получить("text")));
				ИначеЕсли Часть.Получить("type") = "refusal" Тогда
					Тексты.Добавить(Строка(Часть.Получить("refusal")));
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ТипЭлемента = "function_call" Тогда
			Функция_ = Новый Соответствие;
			Функция_.Вставить("name", Элемент.Получить("name"));
			Функция_.Вставить("arguments", Строка(Элемент.Получить("arguments")));
			Вызов = Новый Соответствие;
			Вызов.Вставить("id", Элемент.Получить("call_id"));
			Вызов.Вставить("type", "function");
			Вызов.Вставить("function", Функция_);
			Вызовы.Добавить(Вызов);
		КонецЕсли;
	КонецЦикла;
	Сообщение = Новый Соответствие;
	Сообщение.Вставить("role", "assistant");
	Сообщение.Вставить("content", СтрСоединить(Тексты, Символы.ПС));
	Если Вызовы.Количество() > 0 Тогда
		Сообщение.Вставить("tool_calls", Вызовы);
	КонецЕсли;
	Если ЕстьРассуждения Тогда
		Сообщение.Вставить(КлючЭлементовResponses(), ЭлементыОтвета);
	КонецЕсли;
	Причина = ?(Вызовы.Количество() > 0, "tool_calls", "stop");
	Если Данные.Получить("status") = "incomplete" Тогда
		Подробности = Данные.Получить("incomplete_details");
		ПричинаНеполноты = ?(ТипЗнч(Подробности) = Тип("Соответствие"), Подробности.Получить("reason"), "");
		Причина = ?(ПричинаНеполноты = "content_filter", "content_filter", "length");
	КонецЕсли;
	Выбор = Новый Соответствие;
	Выбор.Вставить("message", Сообщение);
	Выбор.Вставить("finish_reason", Причина);
	Выборы = Новый Массив;
	Выборы.Добавить(Выбор);
	Результат = Новый Соответствие;
	Результат.Вставить("choices", Выборы);
	Использование = Данные.Получить("usage");
	Если ТипЗнч(Использование) = Тип("Соответствие") Тогда
		Токены = Новый Соответствие;
		Токены.Вставить("prompt_tokens", Использование.Получить("input_tokens"));
		Токены.Вставить("completion_tokens", Использование.Получить("output_tokens"));
		ПодробностиВхода = Использование.Получить("input_tokens_details");
		Если ТипЗнч(ПодробностиВхода) = Тип("Соответствие") Тогда
			Кэш = Новый Соответствие;
			Кэш.Вставить("cached_tokens", ПодробностиВхода.Получить("cached_tokens"));
			Токены.Вставить("prompt_tokens_details", Кэш);
		КонецЕсли;
		ПодробностиВыхода = Использование.Получить("output_tokens_details");
		Если ТипЗнч(ПодробностиВыхода) = Тип("Соответствие") Тогда
			Рассуждения = Новый Соответствие;
			Рассуждения.Вставить("reasoning_tokens", ПодробностиВыхода.Получить("reasoning_tokens"));
			Токены.Вставить("completion_tokens_details", Рассуждения);
		КонецЕсли;
		Результат.Вставить("usage", Токены);
	КонецЕсли;
	Возврат ОбщегоНазначения.ЗначениеВJSON(Результат);

КонецФункции

#КонецОбласти

#Область Anthropic

// Тело запроса Anthropic Messages из сообщений и инструментов в формате OpenAI (план, раздел 3.4).
// Системные сообщения собираются в поле system, результаты инструментов - в блоки tool_result
// сообщения пользователя, вызовы инструментов ассистента - в блоки tool_use; подряд идущие
// сообщения одной роли объединяются (Anthropic требует чередования ролей).
Функция ТелоAnthropic(Сообщения, Инструменты, Модель)

	Системные = Новый Массив;
	Диалог = Новый Массив;
	Для Каждого Сообщение Из Сообщения Цикл
		Роль = Сообщение.Получить("role");
		Содержимое = Сообщение.Получить("content");
		Если Роль = "system" Тогда
			Если ТипЗнч(Содержимое) = Тип("Массив") Тогда
				Для Каждого Часть Из Содержимое Цикл
					Системные.Добавить(Строка(Часть.Получить("text")));
				КонецЦикла;
			Иначе
				Системные.Добавить(Строка(Содержимое));
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Блоки = Новый Массив;
		Рассуждения = Сообщение.Получить(КлючБлоковРассуждений());
		Если Роль = "assistant" И ТипЗнч(Рассуждения) = Тип("Массив") Тогда
			Для Каждого Блок Из Рассуждения Цикл
				Блоки.Добавить(Блок);
			КонецЦикла;
		КонецЕсли;
		Если Роль = "tool" Тогда
			Блок = Новый Соответствие;
			Блок.Вставить("type", "tool_result");
			Блок.Вставить("tool_use_id", Сообщение.Получить("tool_call_id"));
			Блок.Вставить("content", Содержимое);
			Блоки.Добавить(Блок);
			Роль = "user";
		ИначеЕсли ТипЗнч(Содержимое) = Тип("Массив") Тогда
			Для Каждого Часть Из Содержимое Цикл
				Блок = БлокAnthropic(Часть);
				Если Блок <> Неопределено Тогда
					Блоки.Добавить(Блок);
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ТипЗнч(Содержимое) = Тип("Строка") И Не ПустаяСтрока(Содержимое) Тогда
			Блок = Новый Соответствие;
			Блок.Вставить("type", "text");
			Блок.Вставить("text", Содержимое);
			Блоки.Добавить(Блок);
		КонецЕсли;
		Вызовы = Сообщение.Получить("tool_calls");
		Если ТипЗнч(Вызовы) = Тип("Массив") Тогда
			Для Каждого Вызов Из Вызовы Цикл
				Функция_ = Вызов.Получить("function");
				Блок = Новый Соответствие;
				Блок.Вставить("type", "tool_use");
				Блок.Вставить("id", Вызов.Получить("id"));
				Блок.Вставить("name", Функция_.Получить("name"));
				Аргументы = ОбщегоНазначения.JSONВЗначение(Строка(Функция_.Получить("arguments")), , Истина);
				Если ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
					ВызватьИсключение НСтр("ru = 'Некорректный формат аргументов инструмента.'");
				КонецЕсли;
				Блок.Вставить("input", Аргументы);
				Блоки.Добавить(Блок);
			КонецЦикла;
		КонецЕсли;
		Если Блоки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Диалог.Количество() > 0 И Диалог[Диалог.ВГраница()].Получить("role") = Роль Тогда
			Для Каждого Блок Из Блоки Цикл
				Диалог[Диалог.ВГраница()].Получить("content").Добавить(Блок);
			КонецЦикла;
		Иначе
			НовоеСообщение = Новый Соответствие;
			НовоеСообщение.Вставить("role", Роль);
			НовоеСообщение.Вставить("content", Блоки);
			Диалог.Добавить(НовоеСообщение);
		КонецЕсли;
	КонецЦикла;

	Тело = Новый Соответствие;
	Тело.Вставить("model", Модель);
	Тело.Вставить("system", СтрСоединить(Системные, Символы.ПС + Символы.ПС));
	Тело.Вставить("messages", Диалог);
	Если Инструменты.Количество() > 0 Тогда
		ИнструментыAnthropic = Новый Массив;
		Для Каждого Инструмент Из Инструменты Цикл
			Функция_ = Инструмент.Получить("function");
			Описание = Новый Соответствие;
			Описание.Вставить("name", Функция_.Получить("name"));
			Описание.Вставить("description", Функция_.Получить("description"));
			Описание.Вставить("input_schema", Функция_.Получить("parameters"));
			ИнструментыAnthropic.Добавить(Описание);
		КонецЦикла;
		Тело.Вставить("tools", ИнструментыAnthropic);
	КонецЕсли;
	Возврат Тело;

КонецФункции

Функция БлокAnthropic(Часть)

	Если ТипЗнч(Часть) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Блок = Новый Соответствие;
	Если Часть.Получить("type") = "text" Тогда
		Блок.Вставить("type", "text");
		Блок.Вставить("text", Строка(Часть.Получить("text")));
		Возврат Блок;
	ИначеЕсли Часть.Получить("type") = "image_url" Тогда
		Адрес = Строка(Часть.Получить("image_url").Получить("url"));
		// data:image/jpeg;base64,....
		Позиция = СтрНайти(Адрес, ";base64,");
		Если Не СтрНачинаетсяС(Адрес, "data:") Или Позиция = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Источник = Новый Соответствие;
		Источник.Вставить("type", "base64");
		Источник.Вставить("media_type", Сред(Адрес, 6, Позиция - 6));
		Источник.Вставить("data", Сред(Адрес, Позиция + 8));
		Блок.Вставить("type", "image");
		Блок.Вставить("source", Источник);
		Возврат Блок;
	ИначеЕсли Часть.Получить("type") = "file" Тогда
		Файл = Часть.Получить("file");
		Адрес = ?(ТипЗнч(Файл) = Тип("Соответствие"), Строка(Файл.Получить("file_data")), "");
		Если Не СтрНачинаетсяС(Адрес, ПрефиксPDF()) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Источник = Новый Соответствие;
		Источник.Вставить("type", "base64");
		Источник.Вставить("media_type", "application/pdf");
		Источник.Вставить("data", Сред(Адрес, СтрДлина(ПрефиксPDF()) + 1));
		Блок.Вставить("type", "document");
		Блок.Вставить("source", Источник);
		Возврат Блок;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Функция ПрефиксPDF()

	Возврат "data:application/pdf;base64,";

КонецФункции

// Ответ Anthropic Messages -> ответ в формате OpenAI chat/completions (choices[0].message, usage).
Функция ОтветAnthropicКакOpenAI(ТелоJSON)

	Данные = ОбщегоНазначения.JSONВЗначение(ТелоJSON, , Истина);
	Тексты = Новый Массив;
	Вызовы = Новый Массив;
	Рассуждения = Новый Массив;
	Для Каждого Блок Из Данные.Получить("content") Цикл
		Если Блок.Получить("type") = "thinking" Или Блок.Получить("type") = "redacted_thinking" Тогда
			Рассуждения.Добавить(Блок);
		ИначеЕсли Блок.Получить("type") = "text" Тогда
			Тексты.Добавить(Строка(Блок.Получить("text")));
		ИначеЕсли Блок.Получить("type") = "tool_use" Тогда
			Функция_ = Новый Соответствие;
			Функция_.Вставить("name", Блок.Получить("name"));
			Функция_.Вставить("arguments", ОбщегоНазначения.ЗначениеВJSON(Блок.Получить("input")));
			Вызов = Новый Соответствие;
			Вызов.Вставить("id", Блок.Получить("id"));
			Вызов.Вставить("type", "function");
			Вызов.Вставить("function", Функция_);
			Вызовы.Добавить(Вызов);
		КонецЕсли;
	КонецЦикла;
	Сообщение = Новый Соответствие;
	Сообщение.Вставить("role", "assistant");
	Сообщение.Вставить("content", СтрСоединить(Тексты, Символы.ПС));
	Если Вызовы.Количество() > 0 Тогда
		Сообщение.Вставить("tool_calls", Вызовы);
	КонецЕсли;
	// С рассуждениями Anthropic требует вернуть блоки thinking с подписью в следующем запросе хода.
	Если Рассуждения.Количество() > 0 Тогда
		Сообщение.Вставить(КлючБлоковРассуждений(), Рассуждения);
	КонецЕсли;
	Выбор = Новый Соответствие;
	Выбор.Вставить("message", Сообщение);
	Причины = Новый Соответствие;
	Причины.Вставить("end_turn", "stop");
	Причины.Вставить("stop_sequence", "stop");
	Причины.Вставить("max_tokens", "length");
	Причины.Вставить("tool_use", "tool_calls");
	Выбор.Вставить("finish_reason", Причины.Получить(Данные.Получить("stop_reason")));
	Выборы = Новый Массив;
	Выборы.Добавить(Выбор);
	Результат = Новый Соответствие;
	Результат.Вставить("choices", Выборы);
	Использование = Данные.Получить("usage");
	Если ТипЗнч(Использование) = Тип("Соответствие") Тогда
		Токены = Новый Соответствие;
		// input_tokens Anthropic не включает чтение и запись кэша; prompt_tokens OpenAI включает весь вход.
		Токены.Вставить("prompt_tokens", ЧислоИлиНоль(Использование.Получить("input_tokens"))
			+ ЧислоИлиНоль(Использование.Получить("cache_read_input_tokens"))
			+ ЧислоИлиНоль(Использование.Получить("cache_creation_input_tokens")));
		Токены.Вставить("completion_tokens", Использование.Получить("output_tokens"));
		Кэш = Новый Соответствие;
		Кэш.Вставить("cached_tokens", Использование.Получить("cache_read_input_tokens"));
		Токены.Вставить("prompt_tokens_details", Кэш);
		Результат.Вставить("usage", Токены);
	КонецЕсли;
	Возврат ОбщегоНазначения.ЗначениеВJSON(Результат);

КонецФункции

#КонецОбласти

Функция ЧислоИлиНоль(Значение)

	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, 0);

КонецФункции

Функция ИмяСобытияЖурнала()

	Возврат НСтр("ru = 'ИИАссистент.LLM'", ОбщегоНазначения.КодОсновногоЯзыка());

КонецФункции

#КонецОбласти
