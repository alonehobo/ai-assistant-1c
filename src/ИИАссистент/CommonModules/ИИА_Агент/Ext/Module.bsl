// Служебная инструкция модели для продолжения оборванного ответа: частичный ответ уже в истории диалога.
//
// Параметры:
//  Шаги - Массив из Структура, Соответствие - шаги оборванного хода (см. ВыполнитьХод, свойство Шаги).
//
// Возвращаемое значение:
//  Строка
//
Функция ИнструкцияПродолжения(Шаги) Экспорт

	Выполненные = Новый Массив;
	Для Каждого ВыполненныйШаг Из Шаги Цикл
		Если Не ПустаяСтрока(ВыполненныйШаг["tool"]) Тогда
			Выполненные.Добавить(СтрШаблон("%1 %2 (%3)", ВыполненныйШаг["title"], ВыполненныйШаг["detail"],
				ВыполненныйШаг["result"]));
		КонецЕсли;
	КонецЦикла;
	Возврат НСтр("ru = 'Продолжи ответ с места обрыва; не повторяй сказанное.'")
		+ ?(Выполненные.Количество() = 0, "", " " + НСтр("ru = 'Уже выполнены шаги:'") + " " + СтрСоединить(Выполненные, "; ") + ".");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СистемныйПромпт(Граница)

	Строки = Новый Массив;
	Строки.Добавить(НСтр("ru = 'Ты - деловой ИИ-ассистент внутри 1С:Предприятия (конфигурация %1). Отвечай по-русски.'"));
	Строки.Добавить(НСтр("ru = 'Стиль: как опытный аналитик, которому некогда. Видимая часть ответа - 1-3 коротких предложения или короткий список/таблица до 7 строк. Сразу суть: цифра, вывод, действие. Без вступлений, пересказа вопроса, рассуждений о том, как получены данные, предложений помочь ещё и вопросов в конце.'"));
	Строки.Добавить(НСтр("ru = 'Полный ответ давай сразу: всё, что ты выяснил и что пригодится пользователю (формулы, условия, порядок действий, исключения, оговорки), пиши после краткой части блоком ```details - чат покажет его свёрнутым под ссылкой «Подробнее». Краткая часть должна быть понятна без него; пиши её обычным текстом, жирным выделяй только отдельную цифру или ключевое слово. Если добавить нечего, блок не нужен. Внутри ```details не используй ``` - схему ```mermaid и ```suggest ставь вне блока.'"));
	Строки.Добавить(НСтр("ru = 'Если пользователь просит открыть или показать конкретный объект (документ, элемент справочника) - найди его запросом с минимумом полей (ПЕРВЫЕ 1, ссылка и представление), вызови open_object с id из objects и ответь одной фразой, например «Открыл заказ клиента 00УП-000303 от 26.11.2026.». Не выводи реквизиты объекта - пользователь увидит их в форме.'"));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Сегодня %1.'"), Формат(ТекущаяДатаСеанса(), "ДЛФ=D")));
	Строки.Добавить(НСтр("ru = 'Для цифр и выводов используй данные инструментов текущего хода. Историю используй для понимания вопроса и ранее проверенной схемы. Не выдумывай цифры.'"));
	Строки.Добавить(НСтр("ru = 'После утверждения, основанного на данных инструмента, ставь маркер его источника [sN] (source_id из результата, например [s2]); отдельную строку «Источник: ...» не пиши - список источников система выводит сама.'"));
	Строки.Добавить(НСтр("ru = 'Если вопрос закрывает отчёт - используй find_report и run_report; бухгалтерские данные по счетам - только через бухгалтерские инструменты. Если нужная схема уже есть в контексте диалога, не ищи её заново. Для остатков, оборотов и срезов регистров используй read_register; бухгалтерские регистры доступны только бухгалтерским инструментам. Иначе: search_metadata и describe_metadata, затем run_query для сложных запросов. Термины компании сначала проверяй в glossary. Названия контрагентов, товаров, складов и номера документов из вопроса превращай в ссылки через find_records; реквизиты и строки конкретного объекта читай read_object.'"));
	Строки.Добавить(НСтр("ru = 'Запросы пиши на языке запросов 1С с русским синтаксисом, обращайся к полям через псевдонимы таблиц (Т.Поле), для регистров используй виртуальные таблицы (Остатки, Обороты, СрезПоследних) с параметрами. Даты передавай параметрами в формате ГГГГ-ММ-ДД. Ограничивай выборку и агрегируй на стороне запроса.'"));
	Строки.Добавить(НСтр("ru = 'Персональные данные физлиц, кадровые и зарплатные данные, переписка, бухгалтерские проводки, секреты и свободный текст (комментарии, описания) тебе недоступны. Если вопрос о них - откажи одной фразой. Не пытайся обойти ограничение.'"));
	Строки.Добавить(НСтр("ru = 'Значения «[скрыто]», «[физлицо скрыто]», «[ФИО скрыто]», «[номер скрыт]» скрыты намеренно: не пытайся их восстановить.'"));
	Строки.Добавить(НСтр("ru = '«Пользователь №N» - сотрудник (менеджер, ответственный, автор), «Физлицо №N» - контрагент или партнёр - физлицо или ИП, «ФИО №N» - ФИО человека из текста. Группируй и отбирай по ним как по обычным значениям, в параметрах запроса передавай объект строкой «Вид №N» - 1С подставит ссылку. В ответе пиши объект так же: пользователь увидит имя. Реквизиты сотрудников и физлиц (ФИО, контакты, документы) недоступны - не запрашивай их.'"));
	Строки.Добавить(ИИА_Маскирование.ПодсказкаДляМодели());
	Строки.Добавить(НСтр("ru = 'Формат - markdown без заголовков. Не вставляй картинки, HTML и внешние адреса.'"));
	Строки.Добавить(НСтр("ru = 'Каждое упоминание объекта оформляй ссылкой [текст](цель), текст - как на форме или в данных. Цель: o3 - объект хода из objects; m:Вид.Имя (например, m:Справочник.Номенклатура) - справочник, документ, регистр или отчёт, полное имя из search_metadata или describe_metadata; m:Вид.Имя.Реквизит или m:Вид.Имя.ТабличнаяЧасть.Реквизит - реквизит или колонка табличной части; m:Вид.Имя.Реквизит@o3 - реквизит конкретного объекта хода. Другие цели и квадратные скобки без цели не используй.'"));
	Строки.Добавить(НСтр("ru = 'Пиши на языке интерфейса: документы, вкладки, поля, колонки и кнопки называй так, как они подписаны на форме. Не показывай пользователю имена объектов метаданных и реквизитов, модули, методы, номера строк кода и другие внутренние идентификаторы.'"));
	Строки.Добавить(НСтр("ru = 'Наглядность: сравнение, структуру и динамику показывай графиком make_chart по таблице запроса, а не длинной таблицей в тексте. Схему процесса или связей объектов можно нарисовать блоком ```mermaid (flowchart или sequenceDiagram, до 15 узлов, подписи по-русски в кавычках).'"));
	Строки.Добавить(НСтр("ru = 'Сначала дай содержательный ответ по вопросу. Ответ только из предложений следующих вопросов недопустим. В самом конце ответа можно предложить до трёх коротких следующих вопросов блоком ```suggest с JSON-массивом строк, например [""Сравни с прошлым месяцем"", ""Покажи по складам""]. Только если они действительно полезны.'"));
	Строки.Добавить(НСтр("ru = 'Сформированный отчёт открывается пользователю в штатной форме автоматически: не переписывай его, дай вывод и ключевые цифры.'"));
	Если ИИА_ИсходныйКод.КодДоступен() Тогда
		Строки.Добавить(НСтр("ru = 'Вопросы «как работает», «где заполняется», «почему не списалось» решай по исходному коду через rlm_execute; code_movements даёт движения документа. Код - твой источник знаний, а не часть ответа.'"));
	КонецЕсли;
	Строки.Добавить(ИИА_ЗащитаОтИнъекций.ПравилаДляПромпта(Граница));
	Строки[0] = СтрШаблон(Строки[0], Метаданные.Синоним);
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Инструмент slice_result: отбор, сортировка и первые N строк таблицы хода без повторного запроса.
// Срез показывается пользователю и получает свой table_id; ссылки ячеек сохраняются.
Функция СрезХода(АргументыJSON, ТаблицыХода, Результат)

	Выполнение = Новый Структура("Успех, Данные, Таблица, Строк, Скрыто, Итог, Класс", Ложь, Неопределено, Неопределено, 0, 0, "", 1);
	Попытка
		Аргументы = ОбщегоНазначения.JSONВЗначение(АргументыJSON, , Истина);
		Индекс = Число(Сред(Строка(Аргументы.Получить("table_id")), 2)) - 1;
	// Неверный JSON или table_id приводит к явному отказу ниже.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Индекс = -1;
	КонецПопытки;
	Если Индекс < 0 Или Индекс > ТаблицыХода.ВГраница() Тогда
		Возврат ОтказГрафика(Выполнение, НСтр("ru = 'Нет таблицы с таким table_id.'"));
	КонецЕсли;
	Таблица = ТаблицыХода[Индекс];
	Выполнение.Класс = ?(Таблица.Свойство("Класс"), Таблица.Класс, 1);

	// Условия отбора: колонка -> подстрока или сравнение с числом.
	Условия = Новый Массив;
	Отбор = Аргументы.Получить("filter");
	Если ТипЗнч(Отбор) = Тип("Соответствие") Тогда
		Для Каждого КлючИЗначение Из Отбор Цикл
			Колонка = Таблица.Колонки.Найти(Строка(КлючИЗначение.Ключ));
			Если Колонка = Неопределено Тогда
				Возврат ОтказГрафика(Выполнение, СтрШаблон(НСтр("ru = 'Нет колонки %1.'"), КлючИЗначение.Ключ));
			КонецЕсли;
			Условия.Добавить(УсловиеСреза(Колонка, Строка(КлючИЗначение.Значение)));
		КонецЦикла;
	КонецЕсли;

	Отобранные = Новый ТаблицаЗначений;
	Отобранные.Колонки.Добавить("Номер");
	Отобранные.Колонки.Добавить("Ключ");
	КолонкаСортировки = Таблица.Колонки.Найти(Строка(Аргументы.Получить("sort_by")));
	Для Номер = 0 По Таблица.Строки.ВГраница() Цикл
		Значения = Таблица.Строки[Номер];
		Подходит = Истина;
		Для Каждого Условие Из Условия Цикл
			Если Не УсловиеВыполнено(Условие, Значения[Условие.Колонка]) Тогда
				Подходит = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Подходит Тогда
			НоваяСтрока = Отобранные.Добавить();
			НоваяСтрока.Номер = Номер;
			НоваяСтрока.Ключ = ?(КолонкаСортировки = Неопределено, Номер, Значения[КолонкаСортировки]);
		КонецЕсли;
	КонецЦикла;
	Если КолонкаСортировки <> Неопределено Тогда
		Отобранные.Сортировать("Ключ " + ?(Аргументы.Получить("descending") = Истина, "УБЫВ", "ВОЗР"));
	КонецЕсли;

	Первые = Аргументы.Получить("top");
	Первые = ?(ТипЗнч(Первые) = Тип("Число") И Первые > 0, Мин(Первые, 100), 20);
	Строки = Новый Массив;
	ОбъектыЯчеек = Новый Массив;
	ЕстьСсылки = Таблица.Свойство("ОбъектыЯчеек") И Таблица.ОбъектыЯчеек.Количество() = Таблица.Строки.Количество();
	Для Каждого Отобранная Из Отобранные Цикл
		Если Строки.Количество() >= Первые Тогда
			Прервать;
		КонецЕсли;
		Строки.Добавить(Таблица.Строки[Отобранная.Номер]);
		ОбъектыЯчеек.Добавить(?(ЕстьСсылки, Таблица.ОбъектыЯчеек[Отобранная.Номер], Новый Массив));
	КонецЦикла;

	Показ = Новый Структура("Заголовок, Колонки, Строки, ОбъектыЯчеек, Класс",
		НСтр("ru = 'Срез данных'"), Таблица.Колонки, Строки, ОбъектыЯчеек, Выполнение.Класс);
	ТаблицыХода.Добавить(Показ);
	Результат.Таблицы.Добавить(Показ);

	Выполнение.Успех = Истина;
	Выполнение.Итог = "OK";
	Выполнение.Строк = Строки.Количество();
	Выполнение.Данные = Новый Структура("table_id, columns, rows, matched", "t" + Формат(ТаблицыХода.Количество(), "ЧГ="),
		Таблица.Колонки, Строки, Отобранные.Количество());
	Возврат Выполнение;

КонецФункции

Функция УсловиеСреза(Колонка, Текст)

	Условие = Новый Структура("Колонка, Оператор, Число, Текст", Колонка, "", 0, НРег(СокрЛП(Текст)));
	Для Каждого Оператор Из СтрРазделить(">=,<=,<>,>,<,=", ",") Цикл
		Если СтрНачинаетсяС(СокрЛП(Текст), Оператор) Тогда
			Попытка
				Условие.Число = Число(СтрЗаменить(СокрЛП(Сред(СокрЛП(Текст), СтрДлина(Оператор) + 1)), ",", "."));
				Условие.Оператор = Оператор;
			// Нечисловой текст остаётся текстовым условием отбора.
			Исключение // BSLLS:MissingCodeTryCatchEx-off
				Условие.Оператор = "";
			КонецПопытки;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Условие;

КонецФункции

Функция УсловиеВыполнено(Условие, Значение)

	Если ПустаяСтрока(Условие.Оператор) Тогда
		Возврат СтрНайти(НРег(Строка(Значение)), Условие.Текст) > 0;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат Ложь;
	ИначеЕсли Условие.Оператор = ">=" Тогда
		Возврат Значение >= Условие.Число;
	ИначеЕсли Условие.Оператор = "<=" Тогда
		Возврат Значение <= Условие.Число;
	ИначеЕсли Условие.Оператор = "<>" Тогда
		Возврат Значение <> Условие.Число;
	ИначеЕсли Условие.Оператор = ">" Тогда
		Возврат Значение > Условие.Число;
	ИначеЕсли Условие.Оператор = "<" Тогда
		Возврат Значение < Условие.Число;
	КонецЕсли;
	Возврат Значение = Условие.Число;

КонецФункции

// Инструмент read_object: читает объект хода по идентификатору o1, o2, ...
Функция ПрочитатьОбъектХода(АргументыJSON, Результат)

	Выполнение = Новый Структура("Успех, Данные, Таблица, Строк, Скрыто, Итог", Ложь, Неопределено, Неопределено, 0, 0, "");
	Индекс = ИндексОбъектаХода(АргументыJSON);
	Если Индекс < 0 Или Индекс > Результат.Объекты.ВГраница() Или Не Результат.Объекты[Индекс].Свойство("Значение") Тогда
		Выполнение.Итог = "NOT_FOUND";
		Выполнение.Данные = Новый Структура("error, message", "NOT_FOUND",
			НСтр("ru = 'Нет объекта с таким идентификатором. Сначала найди объект (find_records или run_query) и возьми id из objects.'"));
		Возврат Выполнение;
	КонецЕсли;
	Количество = Результат.Объекты.Количество();
	Выполнение = ИИА_Знания.ПрочитатьОбъект(Результат.Объекты[Индекс].Значение, Выполнение, Результат.Объекты);
	// Ссылки из табличных частей добавлены в конец списка объектов хода: даём им идентификаторы.
	Если Выполнение.Успех И Результат.Объекты.Количество() > Количество Тогда
		ОбъектыДляМодели = Новый Массив;
		Для Номер = Количество По Результат.Объекты.ВГраница() Цикл
			ОбъектыДляМодели.Добавить(Новый Структура("id, text", "o" + Формат(Номер + 1, "ЧГ="), Результат.Объекты[Номер].Текст));
		КонецЦикла;
		Выполнение.Данные.Вставить("objects", ОбъектыДляМодели);
	КонецЕсли;
	Возврат Выполнение;

КонецФункции

Функция ИндексОбъектаХода(АргументыJSON)

	Попытка
		Аргументы = ОбщегоНазначения.JSONВЗначение(АргументыJSON);
		Возврат Число(Сред(Строка(Аргументы.Получить("id")), 2)) - 1;
	// Неверный идентификатор не разрешается в объект хода.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат -1;
	КонецПопытки;

КонецФункции

// Инструмент open_object: запоминает объект хода, который форма откроет после ответа.
Функция ОткрытьОбъектХода(АргументыJSON, Результат)

	Выполнение = Новый Структура("Успех, Данные, Таблица, Строк, Скрыто, Итог", Ложь, Неопределено, Неопределено, 0, 0, "");
	Попытка
		Аргументы = ОбщегоНазначения.JSONВЗначение(АргументыJSON);
		Идентификатор = Строка(Аргументы.Получить("id"));
		Индекс = Число(Сред(Идентификатор, 2)) - 1;
	// Неверный JSON или id возвращает NOT_FOUND.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Индекс = -1;
	КонецПопытки;
	Если Индекс < 0 Или Индекс > Результат.Объекты.ВГраница() Тогда
		Выполнение.Итог = "NOT_FOUND";
		Выполнение.Данные = Новый Структура("error, message", "NOT_FOUND",
			НСтр("ru = 'Нет объекта с таким идентификатором. Сначала найди объект запросом run_query и возьми id из objects.'"));
		Возврат Выполнение;
	КонецЕсли;
	Если Результат.ОткрытьОбъекты.Количество() >= 3 Тогда
		Выполнение.Итог = "LIMIT";
		Выполнение.Данные = Новый Структура("error, message", "LIMIT", НСтр("ru = 'За один ответ открывается не больше трёх объектов.'"));
		Возврат Выполнение;
	КонецЕсли;
	Если Результат.ОткрытьОбъекты.Найти(Индекс) = Неопределено Тогда
		Результат.ОткрытьОбъекты.Добавить(Индекс);
	КонецЕсли;
	Выполнение.Успех = Истина;
	Выполнение.Итог = "OK";
	Выполнение.Данные = Новый Структура("opened", Результат.Объекты[Индекс].Текст);
	Возврат Выполнение;

КонецФункции

// Инструмент show_form: под ответом появляется кнопка «Показать на форме» - открывает пользователю настоящую форму
// с отметкой шагов. Модель данные объекта не получает.
Функция ПоказатьФормуХода(АргументыJSON, Результат, Контекст)

	Выполнение = Новый Структура("Успех, Данные, Таблица, Строк, Скрыто, Итог", Ложь, Неопределено, Неопределено, 0, 0, "");
	Попытка
		Аргументы = ОбщегоНазначения.JSONВЗначение(АргументыJSON);
	// Неверный JSON не создаёт форму без последующей проверки объекта.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Аргументы = Новый Соответствие;
	КонецПопытки;
	Аргументы = ?(ТипЗнч(Аргументы) = Тип("Соответствие"), Аргументы, Новый Соответствие);
	Отказ = Новый Структура("error, message", "", "");
	Если Результат.Формы.Количество() >= 2 Тогда
		Отказ.error = "LIMIT";
		Отказ.message = НСтр("ru = 'За один ответ - не больше двух форм.'");
	КонецЕсли;
	ОбъектМетаданных = Неопределено;
	Если ПустаяСтрока(Отказ.error) Тогда
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(СокрЛП(Строка(Аргументы.Получить("object"))));
		Причина = "";
		Если ОбъектМетаданных = Неопределено Тогда
			Отказ.error = "NOT_FOUND";
			Отказ.message = НСтр("ru = 'Объект не найден: укажи полное имя, как в form_layout.'");
		ИначеЕсли ИИА_Периметр.ОбъектЗапрещен(ОбъектМетаданных.ПолноеИмя(), Причина) Тогда
			Отказ.error = "PERIMETER_VIOLATION";
			Отказ.message = Причина;
		КонецЕсли;
	КонецЕсли;
	ФормаМетаданных = Неопределено;
	Если ПустаяСтрока(Отказ.error) Тогда
		ИмяФормы = ?(Аргументы.Получить("form") = Неопределено, "", СокрЛП(Строка(Аргументы.Получить("form"))));
		ФормаМетаданных = ИИА_Формы.ФормаОбъекта(ОбъектМетаданных, ИмяФормы);
		Если ФормаМетаданных = Неопределено Тогда
			Отказ.error = "NOT_FOUND";
			Отказ.message = НСтр("ru = 'У объекта нет такой формы.'");
		КонецЕсли;
	КонецЕсли;
	Если Не ПустаяСтрока(Отказ.error) Тогда
		Выполнение.Итог = Отказ.error;
		Выполнение.Данные = Отказ;
		Возврат Выполнение;
	КонецЕсли;

	// Объект для кнопки «Этот объект»: объект хода (o1, o2, ...) или объект, из которого открыт чат, того же вида.
	Ссылка = Неопределено;
	Идентификатор = ?(Аргументы.Получить("id") = Неопределено, "", СокрЛП(Строка(Аргументы.Получить("id"))));
	Если СтрНачинаетсяС(Идентификатор, "o") Тогда
		Попытка
			Индекс = Число(Сред(Идентификатор, 2)) - 1;
		// Неверный id исключает ссылку из объектов хода; контекст проверяется отдельно.
		Исключение // BSLLS:MissingCodeTryCatchEx-off
			Индекс = -1;
		КонецПопытки;
		Если Индекс >= 0 И Индекс <= Результат.Объекты.ВГраница() И Результат.Объекты[Индекс].Свойство("Значение") Тогда
			Ссылка = Результат.Объекты[Индекс].Значение;
		КонецЕсли;
	КонецЕсли;
	Если Ссылка = Неопределено И Контекст <> Неопределено Тогда
		Ссылка = Контекст;
	КонецЕсли;
	ДанныеXML = "";
	Если Ссылка <> Неопределено И ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Ссылка)) И ЗначениеЗаполнено(Ссылка)
		И Ссылка.Метаданные() = ОбъектМетаданных Тогда
		ДанныеXML = ОбщегоНазначения.ЗначениеВСтрокуXML(Ссылка);
	КонецЕсли;

	Шаги = Новый Массив;
	СписокШагов = Аргументы.Получить("steps");
	Если ТипЗнч(СписокШагов) = Тип("Массив") Тогда
		Для Каждого ОписаниеШага Из СписокШагов Цикл
			Если ТипЗнч(ОписаниеШага) <> Тип("Соответствие") Или Шаги.Количество() >= 9 Тогда
				Продолжить;
			КонецЕсли;
			ИмяЭлемента = СокрЛП(Строка(?(ОписаниеШага.Получить("element") = Неопределено, "", ОписаниеШага.Получить("element"))));
			Если ПустаяСтрока(ИмяЭлемента) Тогда
				Продолжить;
			КонецЕсли;
			Шаги.Добавить(Новый Структура("element, title, hint", Лев(ИмяЭлемента, 150),
				Лев(СокрЛП(Строка(?(ОписаниеШага.Получить("title") = Неопределено, "", ОписаниеШага.Получить("title")))), 100),
				Лев(СокрЛП(Строка(?(ОписаниеШага.Получить("hint") = Неопределено, "", ОписаниеШага.Получить("hint")))), 150)));
		КонецЦикла;
	КонецЕсли;
	Элемент = ?(Аргументы.Получить("highlight") = Неопределено, "", СокрЛП(Строка(Аргументы.Получить("highlight"))));
	Если ПустаяСтрока(Элемент) И Шаги.Количество() > 0 Тогда
		Элемент = Шаги[Шаги.ВГраница()].element;
	КонецЕсли;
	Заголовок = ОбъектМетаданных.Представление();
	Подпись = ?(Аргументы.Получить("title") = Неопределено, "", СокрЛП(Строка(Аргументы.Получить("title"))));
	Если Не ПустаяСтрока(Подпись) Тогда
		Заголовок = Заголовок + ": " + Лев(Подпись, 80);
	КонецЕсли;
	Результат.Формы.Добавить(Новый Структура("ПолноеИмяФормы, Элемент, ДанныеXML, Заголовок, Шаги",
		ФормаМетаданных.ПолноеИмя(), Элемент, ДанныеXML, Заголовок, Шаги));
	Выполнение.Успех = Истина;
	Выполнение.Итог = "OK";
	Выполнение.Данные = Новый Структура("button, with_data, steps", НСтр("ru = 'Под ответом будет кнопка «Показать на форме»: форма откроется по нажатию пользователя. Не пиши, что форма уже открыта.'"),
		Не ПустаяСтрока(ДанныеXML), Шаги.Количество());
	Возврат Выполнение;

КонецФункции

// Инструмент make_chart: график строится в 1С из таблицы результата запроса, модель только выбирает колонки.
Функция ГрафикХода(АргументыJSON, ТаблицыХода, Результат)

	Выполнение = Новый Структура("Успех, Данные, Таблица, Строк, Скрыто, Итог", Ложь, Неопределено, Неопределено, 0, 0, "");
	Попытка
		Аргументы = ОбщегоНазначения.JSONВЗначение(АргументыJSON);
		Индекс = Число(Сред(Строка(Аргументы.Получить("table_id")), 2)) - 1;
	// Неверный table_id приводит к отказу построения графика.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Индекс = -1;
	КонецПопытки;
	Если Индекс < 0 Или Индекс > ТаблицыХода.ВГраница() Тогда
		Возврат ОтказГрафика(Выполнение, НСтр("ru = 'Нет таблицы с таким table_id: сначала нужен результат run_query.'"));
	КонецЕсли;
	Таблица = ТаблицыХода[Индекс];
	ВидГрафика = Строка(Аргументы.Получить("type"));
	Если СтрНайти("bar,hbar,line,pie", ВидГрафика) = 0 Или ПустаяСтрока(ВидГрафика) Тогда
		ВидГрафика = "bar";
	КонецЕсли;
	КолонкаПодписей = Таблица.Колонки.Найти(Строка(Аргументы.Получить("label_column")));
	Если КолонкаПодписей = Неопределено Тогда
		Возврат ОтказГрафика(Выполнение, НСтр("ru = 'Колонка подписей не найдена в таблице.'"));
	КонецЕсли;
	КолонкиЗначений = Новый Массив;
	ИменаЗначений = Аргументы.Получить("value_columns");
	Если ТипЗнч(ИменаЗначений) = Тип("Массив") Тогда
		Для Каждого Имя Из ИменаЗначений Цикл
			Колонка = Таблица.Колонки.Найти(Строка(Имя));
			Если Колонка <> Неопределено И КолонкиЗначений.Количество() < ?(ВидГрафика = "pie", 1, 3) Тогда
				КолонкиЗначений.Добавить(Колонка);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если КолонкиЗначений.Количество() = 0 Тогда
		Возврат ОтказГрафика(Выполнение, НСтр("ru = 'Укажи числовые колонки value_columns из таблицы.'"));
	КонецЕсли;

	Подписи = Новый Массив;
	Ряды = Новый Массив;
	Для Каждого Колонка Из КолонкиЗначений Цикл
		Ряды.Добавить(Новый Структура("name, values", Таблица.Колонки[Колонка], Новый Массив));
	КонецЦикла;
	Для Каждого СтрокаТаблицы Из Таблица.Строки Цикл
		Если Подписи.Количество() >= 50 Тогда
			Прервать;
		КонецЕсли;
		Подписи.Добавить(Строка(СтрокаТаблицы[КолонкаПодписей]));
		Для Номер = 0 По КолонкиЗначений.ВГраница() Цикл
			Значение = СтрокаТаблицы[КолонкиЗначений[Номер]];
			Ряды[Номер].values.Добавить(?(ТипЗнч(Значение) = Тип("Число"), Значение, 0));
		КонецЦикла;
	КонецЦикла;
	Заголовок = Аргументы.Получить("title");
	Результат.Графики.Добавить(Новый Структура("type, title, labels, series", ВидГрафика,
		?(ТипЗнч(Заголовок) = Тип("Строка"), Лев(Заголовок, 150), ""), Подписи, Ряды));

	Выполнение.Успех = Истина;
	Выполнение.Итог = "OK";
	Выполнение.Строк = Подписи.Количество();
	Выполнение.Данные = Новый Структура("shown", СтрШаблон(НСтр("ru = 'График показан пользователю (%1 точек).'"), Подписи.Количество()));
	Возврат Выполнение;

КонецФункции

Функция ОтказГрафика(Выполнение, Текст)

	Выполнение.Итог = "BAD_ARGUMENTS";
	Выполнение.Данные = Новый Структура("error, message", "BAD_ARGUMENTS", Текст);
	Возврат Выполнение;

КонецФункции

// Таблица для показа в чате; объекты таблицы переносятся в общий список хода с пересчётом индексов.
Функция ТаблицаДляПоказа(Таблица, Заголовок, ОбъектыХода)

	ОбъектыЯчеек = Новый Массив;
	Если Таблица.Свойство("Объекты") И Таблица.Свойство("ОбъектыЯчеек") Тогда
		Сдвиг = ОбъектыХода.Количество();
		Для Каждого Объект Из Таблица.Объекты Цикл
			ОбъектыХода.Добавить(Объект);
		КонецЦикла;
		Для Каждого ИндексыСтроки Из Таблица.ОбъектыЯчеек Цикл
			СтрокаИндексов = Новый Массив;
			Для Каждого Индекс Из ИндексыСтроки Цикл
				СтрокаИндексов.Добавить(?(Индекс = Неопределено, Неопределено, Индекс + Сдвиг));
			КонецЦикла;
			ОбъектыЯчеек.Добавить(СтрокаИндексов);
		КонецЦикла;
	КонецЕсли;
	Возврат Новый Структура("Заголовок, Колонки, Строки, ОбъектыЯчеек", Заголовок, Таблица.Колонки, Таблица.Строки, ОбъектыЯчеек);

КонецФункции

Функция Сообщение(Роль, Текст)

	Результат = Новый Соответствие;
	Результат.Вставить("role", Роль);
	Результат.Вставить("content", Текст);
	Возврат Результат;

КонецФункции

Функция ТекстоваяЧасть(Текст)

	Часть = Новый Соответствие;
	Часть.Вставить("type", "text");
	Часть.Вставить("text", Текст);
	Возврат Часть;

КонецФункции

Процедура УдалитьИнструмент(Инструменты, Имя)

	Для Индекс = -Инструменты.ВГраница() По 0 Цикл
		Если Инструменты[-Индекс].Получить("function").Получить("name") = Имя Тогда
			Инструменты.Удалить(-Индекс);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Строка статуса шага: что делает агент и с чем (текст поиска, объект, метод) - видно, что поиск идёт.
Функция ОписаниеШага(ИмяИнструмента, Аргументы = "")

	Описание = ДействиеШага(ИмяИнструмента);
	Подробность = ПодробностьШага(Аргументы);
	Возврат ?(ПустаяСтрока(Подробность), Описание, Описание + ": " + Подробность);

КонецФункции

Функция ПодробностьШага(Аргументы)

	Если ПустаяСтрока(Аргументы) Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Значения = ОбщегоНазначения.JSONВЗначение(Аргументы);
	// Повреждённый JSON не выводится в необязательной подписи шага.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат "";
	КонецПопытки;
	Если ТипЗнч(Значения) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	Части = Новый Массив;
	Текст = Значения.Получить("text");
	Если ЗначениеЗаполнено(Текст) Тогда
		Части.Добавить("«" + СокращенноеЗначение(Текст) + "»");
	КонецЕсли;
	События = Значения.Получить("events");
	Если ТипЗнч(События) = Тип("Массив") И События.Количество() > 0 Тогда
		Части.Добавить(СокращенноеЗначение(СтрСоединить(События, ", ")));
	КонецЕсли;
	Для Каждого Ключ Из СтрРазделить("method,name,field,object,object_type,module,form,report,title,report_kind,account", ",") Цикл
		Значение = Значения.Получить(Ключ);
		Если ЗначениеЗаполнено(Значение) И ТипЗнч(Значение) = Тип("Строка") Тогда
			Части.Добавить(СокращенноеЗначение(Значение));
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, " - ");

КонецФункции

Функция СокращенноеЗначение(Значение)

	Текст = СокрЛП(Строка(Значение));
	// Путь модуля показываем по объекту: Documents/X/Forms/Y/Ext/Form/Module.bsl -> X/Forms/Y.
	Если СтрЗаканчиваетсяНа(Текст, ".bsl") Тогда
		Части = СтрРазделить(Текст, "/", Ложь);
		Если Части.Количество() > 2 Тогда
			Части.Удалить(0);
			Пока Части.Количество() > 1 И (Части[Части.ВГраница()] = "Ext" Или СтрЗаканчиваетсяНа(Части[Части.ВГраница()], ".bsl")
				Или Части[Части.ВГраница()] = "Form") Цикл
				Части.Удалить(Части.ВГраница());
			КонецЦикла;
			Текст = СтрСоединить(Части, "/");
		КонецЕсли;
	КонецЕсли;
	Возврат ?(СтрДлина(Текст) > 60, Лев(Текст, 57) + "...", Текст);

КонецФункции

Функция ДействиеШага(ИмяИнструмента)

	Если ИмяИнструмента = "search_metadata" Тогда
		Возврат НСтр("ru = 'Ищу объекты конфигурации'");
	ИначеЕсли ИмяИнструмента = "describe_metadata" Тогда
		Возврат НСтр("ru = 'Изучаю структуру объекта'");
	ИначеЕсли ИмяИнструмента = "run_query" Тогда
		Возврат НСтр("ru = 'Выполняю запрос'");
	ИначеЕсли ИмяИнструмента = "find_report" Тогда
		Возврат НСтр("ru = 'Ищу отчёт'");
	ИначеЕсли ИмяИнструмента = "run_trial_balance" Тогда
		Возврат НСтр("ru = 'Формирую оборотно-сальдовую ведомость'");
	ИначеЕсли ИмяИнструмента = "run_accounting_report" Тогда
		Возврат НСтр("ru = 'Формирую бухгалтерский отчёт'");
	ИначеЕсли ИмяИнструмента = "accounting_balances" Тогда
		Возврат НСтр("ru = 'Считаю остатки и обороты по счетам'");
	ИначеЕсли ИмяИнструмента = "run_report" Тогда
		Возврат НСтр("ru = 'Формирую отчёт'");
	ИначеЕсли ИмяИнструмента = "configure_report" Тогда
		Возврат НСтр("ru = 'Настраиваю и сохраняю вариант отчёта'");
	ИначеЕсли ИмяИнструмента = "describe_report" Тогда
		Возврат НСтр("ru = 'Изучаю настройки отчёта'");
	ИначеЕсли ИмяИнструмента = "find_records" Тогда
		Возврат НСтр("ru = 'Ищу в справочниках и документах'");
	ИначеЕсли ИмяИнструмента = "read_object" Тогда
		Возврат НСтр("ru = 'Читаю объект'");
	ИначеЕсли ИмяИнструмента = "glossary" Тогда
		Возврат НСтр("ru = 'Смотрю глоссарий'");
	ИначеЕсли ИмяИнструмента = "data_access" Тогда
		Возврат НСтр("ru = 'Проверяю правила доступа к данным'");
	ИначеЕсли ИмяИнструмента = "slice_result" Тогда
		Возврат НСтр("ru = 'Отбираю данные'");
	ИначеЕсли ИмяИнструмента = "propose_draft" Тогда
		Возврат НСтр("ru = 'Готовлю черновик документа'");
	ИначеЕсли ИмяИнструмента = "propose_change" Тогда
		Возврат НСтр("ru = 'Готовлю изменение данных'");
	ИначеЕсли ИмяИнструмента = "rlm_execute" Или СтрНачинаетсяС(ИмяИнструмента, "code_") Тогда
		Возврат НСтр("ru = 'Изучаю исходный код'");
	ИначеЕсли ИмяИнструмента = "form_layout" Тогда
		Возврат НСтр("ru = 'Изучаю форму'");
	ИначеЕсли ИмяИнструмента = "show_form" Тогда
		Возврат НСтр("ru = 'Готовлю показ формы'");
	ИначеЕсли ИмяИнструмента = "read_attachment" Тогда
		Возврат НСтр("ru = 'Читаю приложенный файл'");
	ИначеЕсли ИмяИнструмента = "make_file" Тогда
		Возврат НСтр("ru = 'Готовлю файл'");
	ИначеЕсли ИмяИнструмента = "event_log" Тогда
		Возврат НСтр("ru = 'Читаю журнал регистрации'");
	ИначеЕсли ИмяИнструмента = "check_filling" Тогда
		Возврат НСтр("ru = 'Проверяю заполнение'");
	ИначеЕсли ИмяИнструмента = "field_visibility" Тогда
		Возврат НСтр("ru = 'Проверяю видимость поля'");
	КонецЕсли;
	Возврат ИмяИнструмента;

КонецФункции

// Описание шага хода для пользователя, см. ВыполнитьХод, свойство Шаги.
Функция ШагХода(Инструмент, Заголовок, Подробность, Итог, Строк, Миллисекунд, Токенов = 0, Источники = Неопределено)

	Возврат Новый Структура("tool, title, detail, result, rows, ms, tokens, src", Инструмент, Заголовок, Подробность, Итог,
		Строк, Миллисекунд, Токенов, ?(Источники = Неопределено, Новый Массив, Источники));

КонецФункции

// Добавляет шаг в ход работы. Ход чата пишет шаг и промежуточный результат в регистр состояния хода; иначе шаг
// сообщается сообщением пользователю, а промежуточный результат кладётся во временное хранилище.
Процедура ДобавитьШаг(Результат, ПараметрыШагов, НовыйШаг)

	Если Результат.Шаги.Количество() >= 30 Тогда
		Возврат;
	КонецЕсли;
	НовыйШаг.Вставить("n", ПараметрыШагов.ПервыйШаг + Результат.Шаги.Количество() + 1);
	Результат.Шаги.Добавить(НовыйШаг);
	ИдентификаторСостояния = "";
	Если ПараметрыШагов.Свойство("ИдентификаторСостояния", ИдентификаторСостояния)
		И Не ПустаяСтрока(ИдентификаторСостояния) Тогда
		ИИА_ФоновыйХод.ЗаписатьШаг(ИдентификаторСостояния, Результат, ПараметрыШагов);
		Возврат;
	КонецЕсли;
	СообщениеШага = Новый СообщениеПользователю;
	СообщениеШага.Текст = ПрефиксШага() + ОбщегоНазначения.ЗначениеВJSON(НовыйШаг);
	СообщениеШага.Сообщить();
	Если Не ПустаяСтрока(ПараметрыШагов.АдресРезультата) Тогда
		ПоместитьВоВременноеХранилище(Результат, ПараметрыШагов.АдресРезультата);
	КонецЕсли;

КонецПроцедуры

// Запоминает объекты метаданных из результатов search_metadata и describe_metadata (полное имя и синоним):
// синоним, упомянутый в ответе без разметки, страница сделает ссылкой на список. Не больше 30 объектов за ход.
Процедура ЗапомнитьМетаданныеХода(Результат, ИмяИнструмента, Данные)

	Найденные = Новый Массив;
	Если ИмяИнструмента = "describe_metadata" Тогда
		Найденные.Добавить(Данные);
	ИначеЕсли ИмяИнструмента = "search_metadata" И ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("objects") Тогда
		Найденные = Данные.objects;
	Иначе
		Возврат;
	КонецЕсли;
	Имена = Новый Соответствие;
	Для Каждого Запись Из Результат.МетаданныеХода Цикл
		Имена.Вставить(Запись.name, Истина);
	КонецЦикла;
	Для Каждого Описание Из Найденные Цикл
		Если Результат.МетаданныеХода.Количество() >= 30 Тогда
			Прервать;
		КонецЕсли;
		Если ТипЗнч(Описание) = Тип("Структура") И Описание.Свойство("name") И Описание.Свойство("synonym")
			И Имена[Описание.name] = Неопределено И СтрНайти(Описание.name, ".") > 0 И Не ПустаяСтрока(Описание.synonym) Тогда
			Имена.Вставить(Описание.name, Истина);
			Результат.МетаданныеХода.Добавить(Новый Структура("name, text", Описание.name, Описание.synonym));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Источник данных ответа: повторный объект, отчёт или таблица получает прежний ключ. Пусто - лимит источников.
//  Ссылка - Число - индекс в Объекты или Отчеты хода; Строка - полное имя объекта метаданных для вида list.
Функция ЗарегистрироватьИсточник(Результат, ПараметрыШагов, Вид, Ссылка)

	Для Каждого Источник Из Результат.Источники Цикл
		Если Источник.kind = Вид И (Вид = "list" И Источник.table = Ссылка Или Вид <> "list" И Источник.ref = Ссылка) Тогда
			Возврат Источник.key;
		КонецЕсли;
	КонецЦикла;
	Если Результат.Источники.Количество() >= 20 Тогда
		Возврат "";
	КонецЕсли;
	Ключ = "s" + Формат(ПараметрыШагов.ПервыйИсточник + Результат.Источники.Количество() + 1, "ЧГ=");
	Если Вид = "list" Тогда
		Свойства = Новый Структура("ПредставлениеСписка", "");
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Ссылка);
		ЗаполнитьЗначенияСвойств(Свойства, ОбъектМетаданных);
		Результат.Источники.Добавить(Новый Структура("key, kind, text, table", Ключ, Вид,
			?(ПустаяСтрока(Свойства.ПредставлениеСписка), ОбъектМетаданных.Представление(), Свойства.ПредставлениеСписка), Ссылка));
	Иначе
		Результат.Источники.Добавить(Новый Структура("key, kind, ref", Ключ, Вид, Ссылка));
	КонецЕсли;
	Возврат Ключ;

КонецФункции

// Источники успешного вызова (отчёт, таблицы запроса, прочитанный или открытый объект); модель получает source_id
// первого из них. Ключи - уже зарегистрированные источники вызова, дополняются.
Процедура ЗарегистрироватьИсточникиВызова(Вызов, Выполнение, Результат, ПараметрыШагов, Ключи)

	Если Не Выполнение.Успех Тогда
		Возврат;
	КонецЕсли;
	Новые = Новый Массив;
	Если Выполнение.Свойство("Отчет") И Выполнение.Отчет <> Неопределено Тогда
		Новые.Добавить(ЗарегистрироватьИсточник(Результат, ПараметрыШагов, "report", Результат.Отчеты.ВГраница()));
	КонецЕсли;
	Если Выполнение.Свойство("ИсточникиСписков") Тогда
		Для Каждого ПолноеИмя Из Выполнение.ИсточникиСписков Цикл
			Новые.Добавить(ЗарегистрироватьИсточник(Результат, ПараметрыШагов, "list", ПолноеИмя));
		КонецЦикла;
	КонецЕсли;
	Если Вызов.Имя = "read_object" Или Вызов.Имя = "open_object" Тогда
		Новые.Добавить(ЗарегистрироватьИсточник(Результат, ПараметрыШагов, "object", ИндексОбъектаХода(Вызов.Аргументы)));
	ИначеЕсли Вызов.Имя = "check_filling" Или Вызов.Имя = "event_log" Тогда
		// Проверенный объект хода (o1, o2…) - источник ответа, как прочитанный read_object; @context - нет.
		Индекс = ИндексОбъектаХода(Вызов.Аргументы);
		Если Индекс >= 0 И Индекс <= Результат.Объекты.ВГраница() Тогда
			Новые.Добавить(ЗарегистрироватьИсточник(Результат, ПараметрыШагов, "object", Индекс));
		КонецЕсли;
	КонецЕсли;
	Для Каждого Ключ Из Новые Цикл
		Если Не ПустаяСтрока(Ключ) Тогда
			Ключи.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;
	Если Вызов.Имя <> "find_records" И Ключи.Количество() > 0 И ТипЗнч(Выполнение.Данные) = Тип("Структура") Тогда
		Выполнение.Данные.Вставить("source_id", Ключи[0]);
	КонецЕсли;

КонецПроцедуры

// Варианты отчётов, сохранённые configure_report в этом диалоге (вложения configs реплик) и в текущем ходе.
Функция ВариантыДиалога(Диалог, Результат)

	Варианты = Новый Массив;
	Для Каждого Сообщение Из ?(ЗначениеЗаполнено(Диалог), ИИА_Обслуживание.СообщенияДиалога(Диалог), Новый Массив) Цикл
		Если ПустаяСтрока(Сообщение.Вложения) Тогда
			Продолжить;
		КонецЕсли;
		Данные = ОбщегоНазначения.JSONВЗначение(Сообщение.Вложения);
		// Варианты отчётов, на которые пользователь сослался навигационной ссылкой в своих вопросах.
		Объекты = ?(ТипЗнч(Данные) = Тип("Соответствие") И Строка(Сообщение.Роль) = "user", Данные.Получить("objects"), Неопределено);
		Для Каждого Объект Из ?(ТипЗнч(Объекты) = Тип("Массив"), Объекты, Новый Массив) Цикл
			Значение = ?(ТипЗнч(Объект) = Тип("Соответствие") И ТипЗнч(Объект.Получить("link")) = Тип("Строка"),
				ИИА_Инструменты.СсылкаПоНавигационнойСсылке(Объект.Получить("link")), Неопределено);
			Если ТипЗнч(Значение) = Тип("СправочникСсылка.ВариантыОтчетов") Тогда
				Варианты.Добавить(Новый Структура("Вариант, ИмяОтчета, Указан",
					Строка(Значение.УникальныйИдентификатор()), "", Истина));
			КонецЕсли;
		КонецЦикла;
		Настроенные = ?(ТипЗнч(Данные) = Тип("Соответствие"), Данные.Получить("configs"), Неопределено);
		Для Каждого Настроенный Из ?(ТипЗнч(Настроенные) = Тип("Массив"), Настроенные, Новый Массив) Цикл
			Если ТипЗнч(Настроенный) = Тип("Соответствие") И ТипЗнч(Настроенный.Получить("Вариант")) = Тип("Строка") Тогда
				Варианты.Добавить(Новый Структура("Вариант, ИмяОтчета", Настроенный.Получить("Вариант"),
					Строка(Настроенный.Получить("ИмяОтчета"))));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Для Каждого Настроенный Из Результат.НастроенныеВарианты Цикл
		Варианты.Добавить(Новый Структура("Вариант, ИмяОтчета", Настроенный.Вариант, Настроенный.ИмяОтчета));
	КонецЦикла;
	Возврат Варианты;

КонецФункции

// Текущий статус хода: ход чата пишет его в регистр (не чаще раза в секунду), иначе - сообщение пользователю.
Процедура СообщитьСтатус(Текст, ПараметрыШагов)

	ИдентификаторСостояния = "";
	Если ПараметрыШагов.Свойство("ИдентификаторСостояния", ИдентификаторСостояния)
		И Не ПустаяСтрока(ИдентификаторСостояния) Тогда
		ИИА_ФоновыйХод.ЗаписатьСтатус(ИдентификаторСостояния, Текст, ПараметрыШагов);
		Возврат;
	КонецЕсли;
	СообщениеСтатуса = Новый СообщениеПользователю;
	СообщениеСтатуса.Текст = ПрефиксСтатуса() + Текст;
	СообщениеСтатуса.Сообщить();

КонецПроцедуры

// Ход остановлен пользователем: выполненные шаги остаются, ответ - частичный с кнопкой «Продолжить».
Процедура ОтметитьОстановку(Результат)

	Результат.Успех = Ложь;
	Результат.Ошибка = НСтр("ru = 'Остановлено.'");
	Результат.Обрыв = "stopped";

КонецПроцедуры

Процедура УчестьТокены(Результат, Ответ)

	Результат.Статистика.tokens_in = Результат.Статистика.tokens_in + Ответ.ТокеныВход;
	Результат.Статистика.tokens_cached = Результат.Статистика.tokens_cached + Ответ.ТокеныКэш;

КонецПроцедуры

Процедура ЗаписатьЖурнал(Журнал, Событие, Инструмент, Аргументы, Итог, Строк, Длительность, Инцидент, Подробности)

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запись = РегистрыСведений.ИИА_ЖурналВызовов.СоздатьМенеджерЗаписи();
		Запись.ИдентификаторЗаписи = Строка(Новый УникальныйИдентификатор);
		Запись.МоментВызова = ТекущаяУниверсальнаяДата();
		Запись.Пользователь = Пользователи.ТекущийПользователь();
		Запись.ИдентификаторХода = Журнал.Ход;
		Запись.Диалог = Журнал.Диалог;
		Запись.Подключение = Журнал.Подключение;
		Запись.ТокеныВход = Журнал.ТокеныВход;
		Запись.ТокеныВыход = Журнал.ТокеныВыход;
		Запись.ТокеныКэш = Журнал.ТокеныКэш;
		Запись.КлассДанных = ИИА_КлассыДанных.ЗначениеКласса(Журнал.КлассДанных);
		Запись.Событие = Событие;
		Запись.Инструмент = Инструмент;
		Запись.Аргументы = Аргументы;
		Запись.Итог = Итог;
		Запись.Строк = Строк;
		Запись.Длительность = Длительность;
		Запись.Инцидент = Инцидент;
		Запись.Подробности = Подробности;
		Запись.Записать();
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Ответила не первая модель цепочки: шаг хода с причиной и ЗаменаМодели результата (один раз за ход).
//  Модель - СправочникСсылка.ИИА_ПодключенияМоделей, Неопределено - модель, выбранная пользователем.
Процедура ОтметитьЗаменуМодели(Результат, ПараметрыШагов, Ответ, Модель)

	Если Результат.Свойство("ЗаменаМодели") Тогда
		Возврат;
	КонецЕсли;
	Результат.Вставить("ЗаменаМодели", Новый Структура("Подключение, Наименование, Сбои, Выбранная",
		Ответ.ПодключениеСсылка, Ответ.Подключение, Ответ.Сбои, Модель));
	ДобавитьШаг(Результат, ПараметрыШагов, ШагХода("", СтрШаблон(НСтр("ru = 'Модель недоступна, отвечает %1'"),
		Ответ.Подключение), Ответ.Сбои, НСтр("ru = 'замена модели'"), 0, 0));

КонецПроцедуры

// Запрошенный режим и выходные токены рассуждений вызова модели для подробностей журнала.
Функция ПодробностиРассуждений(Ответ)

	Возврат СтрШаблон("reasoning=%1; tokens_reasoning=%2; ", ?(ПустаяСтрока(Ответ.Рассуждения), "default",
		Ответ.Рассуждения), Формат(Ответ.ТокеныРассуждений, "ЧН=0; ЧГ="));

КонецФункции

// Шаги или время хода исчерпаны: последний вызов модели с просьбой ответить по уже полученным данным,
// без новых инструментов. Если модель всё равно просит инструменты и не даёт текста - ход завершается ошибкой.
// Одна попытка завершить ответ по уже полученным данным, без новых инструментов.
Процедура ДополнитьОтвет(Результат, Ответ, Сообщения, КлассХода, Журнал, ПараметрыШагов, Модель, ПредельныйМомент = 0)

	Сообщения.Добавить(Ответ.СообщениеАссистента);
	Сообщения.Добавить(Сообщение("user", НСтр("ru = 'В ответе отсутствует содержательный вывод. Ответь на вопрос по уже полученным данным в 1-3 предложениях. Не предлагай следующие вопросы, не вызывай инструменты. Если данных недостаточно, прямо сообщи об этом.'")));
	НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Дополнение = ИИА_LLM.ВызватьМодель(Сообщения, Новый Массив, КлассХода, Модель,
		СрокФинальногоОтвета(ПредельныйМомент, Модель), КэшПроверокХода(ПараметрыШагов));
	ПеревестиНомераОтвета(Дополнение, ПараметрыШагов);
	ДлительностьМодели = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова;
	УчестьФинальныйВызов(Результат, ДлительностьМодели);
	Журнал.Подключение = Дополнение.ПодключениеСсылка;
	Журнал.ТокеныВход = Дополнение.ТокеныВход;
	Журнал.ТокеныВыход = Дополнение.ТокеныВыход;
	Журнал.ТокеныКэш = Дополнение.ТокеныКэш;
	УчестьТокены(Результат, Дополнение);
	ЗаписатьЖурнал(Журнал, "ВызовМодели", "", "", ?(Дополнение.Успех, "OK", "ERROR"), 0,
		ДлительностьМодели / 1000, Ложь, "final_after_empty_answer; " + ПодробностиРассуждений(Дополнение));
	Журнал.Подключение = Неопределено;
	Журнал.ТокеныВход = 0;
	Журнал.ТокеныВыход = 0;
	Журнал.ТокеныКэш = 0;
	ДобавитьШаг(Результат, ПараметрыШагов, ШагХода("", НСтр("ru = 'Ответ модели'"), "",
		?(Дополнение.Успех, "OK", "ERROR"), 0, ДлительностьМодели,
		Дополнение.ТокеныВход + Дополнение.ТокеныВыход));
	Если Дополнение.Успех И Дополнение.ВызовыИнструментов.Количество() = 0 И СодержательныйОтвет(Дополнение.Текст) Тогда
		Результат.Успех = Истина;
		Результат.Текст = ИИА_Периметр.ОчиститьТекст(Дополнение.Текст);
		Результат.Обрыв = ?(Дополнение.ПричинаЗавершения = "length", "length", "");
	ИначеЕсли Результат.Таблицы.Количество() > 0 Или Результат.Графики.Количество() > 0 Или Результат.Отчеты.Количество() > 0 Тогда
		Результат.Успех = Истина;
		Результат.Текст = НСтр("ru = 'Данные получены и показаны ниже. Ассистент не смог сформулировать вывод.'");
	Иначе
		Результат.Ошибка = НСтр("ru = 'Ассистент не смог сформулировать ответ. Уточните вопрос или повторите попытку.'");
	КонецЕсли;

КонецПроцедуры
Процедура ЗавершитьНаПределеШагов(Результат, Сообщения, Инструменты, КлассХода, Журнал, ПараметрыШагов, ПоВремени = Ложь,
	Модель = Неопределено, ПредельныйМомент = 0)

	Если Результат.Статистика.final_calls > 0 Тогда
		Возврат;
	КонецЕсли;
	Сообщения.Добавить(Сообщение("user", ?(ПоВремени,
		НСтр("ru = 'Время на ответ исчерпано.'"), НСтр("ru = 'Лимит шагов исчерпан.'"))
		+ " " + НСтр("ru = 'Больше не вызывай инструменты. Ответь по уже полученным данным; если ответа нет - коротко скажи, что не удалось получить и почему (например, данные закрыты периметром), и предложи, как переформулировать вопрос.'")));
	НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Ответ = ИИА_LLM.ВызватьМодель(Сообщения, Новый Массив, КлассХода, Модель,
		СрокФинальногоОтвета(ПредельныйМомент, Модель), КэшПроверокХода(ПараметрыШагов));
	ПеревестиНомераОтвета(Ответ, ПараметрыШагов);
	ДлительностьМодели = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова;
	УчестьФинальныйВызов(Результат, ДлительностьМодели);
	Журнал.Подключение = Ответ.ПодключениеСсылка;
	Журнал.ТокеныВход = Ответ.ТокеныВход;
	Журнал.ТокеныВыход = Ответ.ТокеныВыход;
	Журнал.ТокеныКэш = Ответ.ТокеныКэш;
	УчестьТокены(Результат, Ответ);
	ЗаписатьЖурнал(Журнал, "ВызовМодели", "", "", ?(Ответ.Успех, "OK", "ERROR"), 0,
		ДлительностьМодели / 1000, Ложь,
		?(ПоВремени, "final_after_time_limit", "final_after_step_limit")
			+ СтрШаблон("; provider=%1; tokens_in=%2; tokens_out=%3; tokens_cached=%4; upstream=%5; %6%7",
			Ответ.Подключение, Ответ.ТокеныВход, Ответ.ТокеныВыход, Ответ.ТокеныКэш, Ответ.Провайдер,
			ПодробностиРассуждений(Ответ), Ответ.Ошибка));
	Журнал.Подключение = Неопределено;
	Журнал.ТокеныВход = 0;
	Журнал.ТокеныВыход = 0;
	Журнал.ТокеныКэш = 0;
	ДобавитьШаг(Результат, ПараметрыШагов, ШагХода("", НСтр("ru = 'Ответ модели'"), "", ?(Ответ.Успех, "OK", "ERROR"), 0,
		ДлительностьМодели, Ответ.ТокеныВход + Ответ.ТокеныВыход));
	Результат.Обрыв = "limit";
	Если Ответ.Успех И Ответ.ВызовыИнструментов.Количество() = 0 И СодержательныйОтвет(Ответ.Текст) Тогда
		Результат.Успех = Истина;
		Результат.Текст = ИИА_Периметр.ОчиститьТекст(Ответ.Текст);
		Результат.Ошибка = "";
	ИначеЕсли Результат.Таблицы.Количество() > 0 Или Результат.Графики.Количество() > 0 Или Результат.Отчеты.Количество() > 0 Тогда
		Результат.Успех = Истина;
		Результат.Текст = НСтр("ru = 'Данные получены и показаны ниже. Для вывода не хватило ответа модели.'");
	ИначеЕсли Не ПустаяСтрока(Результат.Ошибка) Тогда
		Результат.Текст = ?(ПоВремени,
			НСтр("ru = 'Время на исследование исчерпано: модель не успела сформулировать вывод по найденному. Уточните вопрос (объект, форма, действие) и повторите.'"),
			НСтр("ru = 'Исследование остановлено из-за ошибки модели. Полученных сведений недостаточно для подтверждённого вывода.'"));
	Иначе
		Результат.Ошибка = ?(Результат.Статистика.denied_class_count > 0,
			НСтр("ru = 'DATA_CLASS_NOT_ALLOWED: выбранная модель не допускает класс данных диалога.'"), ?(ПоВремени,
			НСтр("ru = 'Ход занял слишком много времени и остановлен. Уточните вопрос.'"),
			НСтр("ru = 'Достигнут предел шагов. Уточните вопрос.'")));
	КонецЕсли;

КонецПроцедуры

// Финальный ответ получает свой бюджет от момента начала: подготовка запроса и медленная модель в конце
// исследования не должны съедать его целиком. 0 - без ограничения, как и прежде.
Функция СрокФинальногоОтвета(ПредельныйМомент, Модель)

	Если ПредельныйМомент = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Макс(ПредельныйМомент, ТекущаяУниверсальнаяДатаВМиллисекундах() + ИИА_LLM.БюджетФинальногоОтвета(Модель));

КонецФункции

Функция КэшПроверокХода(ПараметрыШагов)

	Кэш = Неопределено;
	ПараметрыШагов.Свойство("КэшПроверок", Кэш);
	Возврат Кэш;

КонецФункции

// Номера диалога в ответе модели («Контрагент №5») - в хэш-псевдонимы: текст, аргументы вызовов, история хода.
Процедура ПеревестиНомераОтвета(Ответ, ПараметрыШагов)

	Кэш = КэшПроверокХода(ПараметрыШагов);
	Если Кэш <> Неопределено И Кэш.Свойство("Маскирование") Тогда
		ИИА_Маскирование.ПеревестиОтветМодели(Ответ, Кэш.Маскирование);
	КонецЕсли;

КонецПроцедуры

// Вывод rlm_execute доходит до 20 000 символов, и каждый результат повторяется во всех следующих вызовах
// модели. Когда суммарный вывод превышает предел, ранние результаты сокращаются разом (префиксный кэш
// провайдера сбрасывается редко); последний результат остаётся полным.
Процедура СократитьРанниеРезультатыИсследования(РезультатыИсследования, Граница)

	Всего = 0;
	Для Каждого Элемент Из РезультатыИсследования Цикл
		Всего = Всего + СтрДлина(ВыводИсследования(Элемент.Данные));
	КонецЦикла;
	Если Всего <= ПределВыводаИсследования() Тогда
		Возврат;
	КонецЕсли;
	Для Индекс = 0 По РезультатыИсследования.ВГраница() - 1 Цикл
		Данные = РезультатыИсследования[Индекс].Данные;
		Вывод = ВыводИсследования(Данные);
		Если СтрДлина(Вывод) <= СокращенныйВыводИсследования() Тогда
			Продолжить;
		КонецЕсли;
		Данные.Вставить("stdout", Лев(Вывод, СокращенныйВыводИсследования()));
		Данные.Вставить("truncated", Истина);
		Данные.Вставить("note", НСтр("ru = 'Ранний вывод сокращён для экономии контекста. Нужный фрагмент перечитай точечно (read_procedure, safe_grep), не весь модуль.'"));
		Срабатывания = 0;
		РезультатыИсследования[Индекс].Сообщение.Вставить("content",
			ИИА_ЗащитаОтИнъекций.ДанныеВКонверте(ОбщегоНазначения.ЗначениеВJSON(Данные), Граница, Срабатывания));
	КонецЦикла;

КонецПроцедуры

Функция ВыводИсследования(Данные)

	Вывод = Неопределено;
	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Вывод = Данные.Получить("stdout");
	ИначеЕсли ТипЗнч(Данные) = Тип("Структура") Тогда
		Данные.Свойство("stdout", Вывод);
	КонецЕсли;
	Возврат ?(ТипЗнч(Вывод) = Тип("Строка"), Вывод, "");

КонецФункции

Функция ПределВыводаИсследования()
	Возврат 40000;
КонецФункции

Функция СокращенныйВыводИсследования()
	Возврат 2000;
КонецФункции

Функция МинимумНаВызовИсследования()
	Возврат 30000;
КонецФункции

Функция ЭтоИнструментИсследования(Имя)

	// code_movements получает локальные метаданные К1 и не открывает сессию RLM.
	Возврат Имя = "rlm_execute";

КонецФункции

Функция ПодходитКонтрольнаяТочка(Точка, Диалог)

	НомерВопроса = Точка.Получить("question_ref");
	Если ТипЗнч(НомерВопроса) <> Тип("Число") Или НомерВопроса <= 0 Или Цел(НомерВопроса) <> НомерВопроса Тогда
		Возврат Ложь;
	КонецЕсли;
	Вопрос = ИИА_Обслуживание.ВопросИсследования(Диалог, НомерВопроса);
	Если Вопрос.Номер = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Профиль = ИИА_ПрофилиДоступа.ЭффективныйПрофиль(Пользователи.ТекущийПользователь());
	ИдентификаторПрофиля = ?(ЗначениеЗаполнено(Профиль), Строка(Профиль.УникальныйИдентификатор()), "");
	Момент = Точка.Получить("saved_at");
	Возврат Точка.Получить("project") = ИИА_ИсходныйКод.Проект()
		И Точка.Получить("address") = ИИА_ИсходныйКод.АдресСервиса()
		И Точка.Получить("profile") = ИдентификаторПрофиля
		И ТипЗнч(Момент) = Тип("Число")
		И Момент <= ТекущаяУниверсальнаяДатаВМиллисекундах()
		И ТекущаяУниверсальнаяДатаВМиллисекундах() - Момент <= 86400000;

КонецФункции

Функция ПодготовитьИсследование(Диалог, Модель, ПредельныйМомент, Точка = Неопределено,
	НужныИзображения = Ложь, НужныДокументы = Ложь)

	Исследование = ИИА_ИсходныйКод.НовыйКонтекстИсследования(Диалог, Модель);
	Исследование.Вставить("ДанныеВосстановления", Неопределено);
	Исследование.Вставить("ВопросИсследования", Новый Структура("Номер, Текст, Класс", 0, "", 1));
	Исследование.ПредельныйМомент = ПредельныйМомент;
	Если Исследование.Успех
		И Не ИИА_LLM.ЕстьПодключениеДляИсследования(Исследование.КлассДанных, Модель, НужныИзображения, НужныДокументы) Тогда
		Исследование.Успех = Ложь;
		Исследование.Ошибка = НСтр("ru = 'DATA_CLASS_NOT_ALLOWED: выбранная модель не принимает медиа исследования.'");
	КонецЕсли;
	Если Не Исследование.Успех Тогда
		Возврат Исследование;
	КонецЕсли;
	Исследование.ВопросИсследования = ИИА_Обслуживание.ВопросИсследования(Диалог);
	Если Точка = Неопределено Тогда
		Возврат Исследование;
	КонецЕсли;
	Если Точка.Получить("project") <> Исследование.Проект
		Или Точка.Получить("address") <> Исследование.Адрес
		Или Точка.Получить("profile") <> ИдентификаторПрофиляИсследования(Исследование)
		Или ТипЗнч(Точка.Получить("saved_at")) <> Тип("Число")
		Или ТекущаяУниверсальнаяДатаВМиллисекундах() - Точка.Получить("saved_at") > 86400000 Тогда
		Возврат Исследование;
	КонецЕсли;
	НомерВопроса = Точка.Получить("question_ref");
	Если ТипЗнч(НомерВопроса) <> Тип("Число") Или НомерВопроса <= 0 Или Цел(НомерВопроса) <> НомерВопроса Тогда
		Возврат Исследование;
	КонецЕсли;
	Исследование.ВопросИсследования = ИИА_Обслуживание.ВопросИсследования(Диалог, НомерВопроса);
	Если Исследование.ВопросИсследования.Номер = 0 Тогда
		Возврат Исследование;
	КонецЕсли;
	Исследование.КлассДанных = Макс(Исследование.КлассДанных, Исследование.ВопросИсследования.Класс,
		ИИА_КлассыДанных.ПодтвержденныйКласс(Точка.Получить("class")));
	Если Не ИИА_LLM.ЕстьПодключениеДляИсследования(Исследование.КлассДанных, Модель, НужныИзображения, НужныДокументы) Тогда
		Исследование.Успех = Ложь;
		Исследование.Ошибка = НСтр("ru = 'DATA_CLASS_NOT_ALLOWED: исходный вопрос исследования нельзя передать выбранной модели.'");
		Возврат Исследование;
	КонецЕсли;
	Восстановление = ИИА_ИсходныйКод.ВосстановитьКонтрольнуюТочку(Исследование, Точка.Получить("descriptors"));
	Если Восстановление.Успех Тогда
		Исследование.ДанныеВосстановления = Новый Структура("original_question, next_action, data",
			Исследование.ВопросИсследования.Текст, "continue_verified_sources", Восстановление.Данные);
	Иначе
		Исследование.Успех = Ложь;
		Исследование.Ошибка = Восстановление.Ошибка;
	КонецЕсли;
	Возврат Исследование;

КонецФункции

Процедура СохранитьИсследование(Исследование, Журнал, Причина)

	Если Исследование = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Указатели = ИИА_ИсходныйКод.КонтрольнаяТочкаДляХранения(Исследование);
	Если Указатели.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Точка = Новый Структура("version, project, address, profile, descriptors, reason, saved_at, question_ref",
		1, Исследование.Проект, Исследование.Адрес, ИдентификаторПрофиляИсследования(Исследование), Указатели,
		Причина, ТекущаяУниверсальнаяДатаВМиллисекундах(), Исследование.ВопросИсследования.Номер);
	Подпись = ОбщегоНазначения.ЗначениеВJSON(Указатели) + "|" + Причина;
	ПрошлаяПодпись = "";
	Исследование.Свойство("ПодписьСохраненнойТочки", ПрошлаяПодпись);
	Если Подпись = ПрошлаяПодпись Тогда
		Возврат;
	КонецЕсли;
	Если ИИА_Обслуживание.СохранитьКонтрольнуюТочкуИсследования(Журнал.Диалог, Точка, Журнал.Ход,
		Исследование.КлассДанных) Тогда
		Исследование.Вставить("ПодписьСохраненнойТочки", Подпись);
	КонецЕсли;

КонецПроцедуры

Функция ИдентификаторПрофиляИсследования(Исследование)

	Возврат ?(ЗначениеЗаполнено(Исследование.Профиль), Строка(Исследование.Профиль.УникальныйИдентификатор()), "");

КонецФункции

Функция ОтказИсследования(Код, Описание)

	Возврат Новый Структура("Успех, Данные, Таблица, Строк, Скрыто, Итог, Класс", Ложь,
		Новый Структура("error, message", Код, Описание), Неопределено, 0, 0, Код, 1);

КонецФункции

Процедура УчестьФинальныйВызов(Результат, Длительность)

	Результат.Статистика.llm_calls = Результат.Статистика.llm_calls + 1;
	Результат.Статистика.final_calls = Результат.Статистика.final_calls + 1;
	Результат.Статистика.llm_ms = Результат.Статистика.llm_ms + Длительность;

КонецПроцедуры

Процедура ЗавершитьХодИсследования(Результат, Исследование, Журнал, Начало, Причина)

	Если ПустаяСтрока(Причина) Тогда
		Причина = ?(Результат.Успех, ?(ПустаяСтрока(Результат.Обрыв), "complete", Результат.Обрыв), "error");
	КонецЕсли;
	Результат.Вставить("ПричинаЗавершения", Причина);
	Результат.Статистика.total_ms = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	Если Исследование <> Неопределено Тогда
		Результат.Статистика.rlm_exec_calls = Исследование.ЧислоВыполнений;
		СохранитьИсследование(Исследование, Журнал, Причина);
		ИИА_ИсходныйКод.ЗакрытьСессиюИсследования(Исследование);
	КонецЕсли;
	ЗаписатьЖурнал(Журнал, "ЗавершениеХода", "", "", Причина, 0,
		Результат.Статистика.total_ms / 1000, Ложь, ОбщегоНазначения.ЗначениеВJSON(Результат.Статистика));

КонецПроцедуры

Функция КаноническиеАргументы(АргументыJSON)

	Попытка
		Аргументы = ОбщегоНазначения.JSONВЗначение(АргументыJSON);
	Исключение
		ЗаписьЖурналаРегистрации("ИИА.Исследование", УровеньЖурналаРегистрации.Предупреждение, , , "INVALID_TOOL_ARGUMENTS_JSON");
		Возврат АргументыJSON;
	КонецПопытки;
	Возврат ОбщегоНазначения.ЗначениеВJSON(УпорядоченныеАргументы(Аргументы));

КонецФункции

Функция УпорядоченныеАргументы(Значение)

	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Ключи = Новый ТаблицаЗначений;
		Ключи.Колонки.Добавить("Имя");
		Для Каждого Пара Из Значение Цикл
			Ключи.Добавить().Имя = Пара.Ключ;
		КонецЦикла;
		Ключи.Сортировать("Имя");
		Результат = Новый Соответствие;
		Для Каждого Ключ Из Ключи Цикл
			Результат.Вставить(Ключ.Имя, УпорядоченныеАргументы(Значение.Получить(Ключ.Имя)));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(УпорядоченныеАргументы(Элемент));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция МаксимумШагов()
	Возврат 12;
КонецФункции

// Поиск по коду большой конфигурации (ERP) может идти минутами - ход ограничен 15 минутами.
Функция МаксимумМиллисекунд()
	Возврат 900000;
КонецФункции

Функция ИмяСобытияЖурнала()

	Возврат НСтр("ru = 'ИИАссистент.Агент'", ОбщегоНазначения.КодОсновногоЯзыка());

КонецФункции

