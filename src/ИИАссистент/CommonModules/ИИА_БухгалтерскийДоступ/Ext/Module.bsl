///////////////////////////////////////////////////////////////////////////////////////////////////////
// ИИ-ассистент: доступ к бухгалтерским данным - набор доступных счетов профиля, проверка счетов и субконто, отборы отчётов.
// Счета 69, 70, 71, 73 с субсчетами закрыты всегда (периметр этапа 1). Профиль доступа только сужает набор:
// разрешённые счета (с субсчетами) включают белый список, запрещённые исключаются всегда и важнее разрешённых.
// Иерархия счетов задаётся полем Родитель, а не префиксом кода.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// План счетов, с которым работает ассистент: Хозрасчетный (ERP, КА, БП) или Управленческий вместе
// с одноимённым регистром бухгалтерии (УНФ). Тексты запросов модуля написаны для Хозрасчетного
// и переводятся на найденный план функцией ТекстЗапросаПоПлану.
//
// Возвращаемое значение:
//  Строка - имя плана счетов; пустая строка, если плана нет (УТ, ЗУП): счета профилей,
//           закрытые счета и бухгалтерские инструменты тогда не используются.
//
Функция ИмяПланаСчетов() Экспорт

	Если Метаданные.ПланыСчетов.Найти("Хозрасчетный") <> Неопределено Тогда
		Возврат "Хозрасчетный";
	ИначеЕсли Метаданные.ПланыСчетов.Найти("Управленческий") <> Неопределено
		И Метаданные.РегистрыБухгалтерии.Найти("Управленческий") <> Неопределено Тогда
		Возврат "Управленческий";
	КонецЕсли;
	Возврат "";

КонецФункции

// Есть ли в конфигурации план счетов, с которым работает ассистент (см. ИмяПланаСчетов).
//
// Возвращаемое значение:
//  Булево
//
Функция ПланСчетовДоступен() Экспорт

	Возврат Не ПустаяСтрока(ИмяПланаСчетов());

КонецФункции

// Есть ли регистр бухгалтерии по плану счетов ассистента: инструмент остатков и оборотов счетов.
//
// Возвращаемое значение:
//  Булево
//
Функция БухгалтерскийУчетДоступен() Экспорт

	ИмяПлана = ИмяПланаСчетов();
	Возврат Не ПустаяСтрока(ИмяПлана) И Метаданные.РегистрыБухгалтерии.Найти(ИмяПлана) <> Неопределено;

КонецФункции

// Есть ли бухгалтерские отчёты на конвейере БухгалтерскиеОтчеты (ОСВ, анализ счёта): ERP, КА, БП.
//
// Возвращаемое значение:
//  Булево
//
Функция БухгалтерскиеОтчетыДоступны() Экспорт

	Возврат ИмяПланаСчетов() = "Хозрасчетный" И БухгалтерскийУчетДоступен()
		И Метаданные.ОбщиеМодули.Найти("БухгалтерскиеОтчеты") <> Неопределено;

КонецФункции

// Ведётся ли учёт по субконто в плане счетов ассистента (в управленческом плане УНФ субконто нет).
//
// Возвращаемое значение:
//  Булево
//
Функция СубконтоДоступны() Экспорт

	ИмяПлана = ИмяПланаСчетов();
	Возврат Не ПустаяСтрока(ИмяПлана) И Метаданные.ПланыСчетов[ИмяПлана].МаксКоличествоСубконто > 0;

КонецФункции

// Переводит текст запроса, написанный для плана счетов и регистра Хозрасчетный, на план счетов ассистента.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстЗапросаПоПлану(Знач Текст) Экспорт

	ИмяПлана = ИмяПланаСчетов();
	Если ИмяПлана = "Хозрасчетный" Или ПустаяСтрока(ИмяПлана) Тогда
		Возврат Текст;
	КонецЕсли;
	Текст = СтрЗаменить(Текст, "ПланСчетов.Хозрасчетный", "ПланСчетов." + ИмяПлана);
	Если Метаданные.ПланыСчетов[ИмяПлана].Реквизиты.Найти("КодБыстрогоВыбора") = Неопределено Тогда
		Текст = СтрЗаменить(Текст, "Счета.КодБыстрогоВыбора = &Код", "Счета.Код = &Код");
	КонецЕсли;
	Возврат СтрЗаменить(Текст, "РегистрБухгалтерии.Хозрасчетный", "РегистрБухгалтерии." + ИмяПлана);

КонецФункции

// Тип счёта профиля доступа для ограничения выбора в формах.
//
// Возвращаемое значение:
//  ОписаниеТипов, Неопределено - Неопределено, если плана счетов нет.
//
Функция ТипСчета() Экспорт

	ИмяПлана = ИмяПланаСчетов();
	Если ПустаяСтрока(ИмяПлана) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый ОписаниеТипов("ПланСчетовСсылка." + ИмяПлана);

КонецФункции

// Менеджер плана счетов ассистента.
//
// Возвращаемое значение:
//  ПланСчетовМенеджер, Неопределено
//
Функция МенеджерПланаСчетов() Экспорт

	ИмяПлана = ИмяПланаСчетов();
	Возврат ?(ПустаяСтрока(ИмяПлана), Неопределено, ПланыСчетов[ИмяПлана]);

КонецФункции

// Строит набор доступных счетов текущего пользователя без кэша (кэш - ИИА_ПериметрПовтИсп.НаборСчетов):
// иерархия плана счетов, базовые запреты, правила действующего профиля.
// Иерархия читается в привилегированном режиме: модели уходит не план счетов, а только результат проверки.
// Без плана счетов набор пуст.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура - см. ВычислитьНаборСчетов.
//
Функция ПостроитьНаборСчетов() Экспорт

	Если Не ПланСчетовДоступен() Тогда
		Возврат ВычислитьНаборСчетов(Новый Соответствие, Новый Соответствие, Новый Массив, Новый Массив);
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Счета.Ссылка КАК Ссылка,
	|	Счета.Родитель КАК Родитель,
	|	Счета.Код КАК Код
	|ИЗ
	|	ПланСчетов.Хозрасчетный КАК Счета");
	Запрос.Текст = ТекстЗапросаПоПлану(Запрос.Текст);
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	Иерархия = Новый Соответствие;
	Коды = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Иерархия.Вставить(Выборка.Ссылка, Выборка.Родитель);
		Коды.Вставить(Выборка.Ссылка, Выборка.Код);
	КонецЦикла;

	Разрешенные = Новый Массив;
	Запрещенные = БазовыеЗапрещенныеСчета();
	ПоУмолчаниюРазрешено = Истина;
	ПрофильНайден = Истина;
	Правила = ИИА_ПериметрПовтИсп.ПравилаПрофиля();
	Если Правила <> Неопределено Тогда
		ПоУмолчаниюРазрешено = Правила.ПоУмолчаниюРазрешено;
		ПрофильНайден = Правила.ПрофильНайден;
		Для Каждого Счет Из Правила.Счета.Разрешенные Цикл
			Разрешенные.Добавить(Счет);
		КонецЦикла;
		Для Каждого Счет Из Правила.Счета.Запрещенные Цикл
			Запрещенные.Добавить(Счет);
		КонецЦикла;
	КонецЕсли;

	Возврат ВычислитьНаборСчетов(Иерархия, Коды, Разрешенные, Запрещенные, ПоУмолчаниюРазрешено, ПрофильНайден);

КонецФункции

// Вычисляет набор доступных счетов. Чистая функция без обращений к базе: счета могут быть любого типа
// (в тестах - строки кодов).
//
// Параметры:
//  Иерархия - Соответствие, ФиксированноеСоответствие - счёт -> родитель (пустое значение у корневых счетов);
//             содержит весь план счетов.
//  Коды - Соответствие, ФиксированноеСоответствие - счёт -> код.
//  Разрешенные - Массив, ФиксированныйМассив - разрешённые профилем корни (с субсчетами).
//  Запрещенные - Массив, ФиксированныйМассив - базовые и запрещённые профилем корни (с субсчетами).
//  ПоУмолчаниюРазрешено - Булево - флаг профиля; влияет только на РасширенныйДоступ.
//  ПрофильНайден - Булево - Ложь: профиля нет в снимке действующей версии политик, набор пуст.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура:
//   * БелыйСписок - Булево - в профиле есть разрешённые счета.
//   * Доступные - ФиксированноеСоответствие - счёт -> Истина.
//   * ДоступныеМассив - ФиксированныйМассив - доступные счета для параметров запросов и отборов.
//   * Запрещенные - ФиксированноеСоответствие - счёт -> Истина: запрещённые корни со всеми субсчетами.
//   * КодыСчетов - ФиксированноеСоответствие - ВРег(код) -> счёт, весь план счетов.
//   * Субсчета - ФиксированноеСоответствие - счёт -> ФиксированныйМассив непосредственных субсчетов.
//   * Пусто - Булево - доступных счетов нет.
//   * РасширенныйДоступ - Булево - доступны бухгалтерские инструменты и виды отчётов сверх ОСВ.
//
Функция ВычислитьНаборСчетов(Иерархия, Коды, Разрешенные, Запрещенные, ПоУмолчаниюРазрешено = Истина,
	ПрофильНайден = Истина) Экспорт

	ВсеСчета = Новый Соответствие;
	Дети = Новый Соответствие;
	КодыСчетов = Новый Соответствие;
	Для Каждого КлючИЗначение Из Иерархия Цикл
		ВсеСчета.Вставить(КлючИЗначение.Ключ, Истина);
		Код = Коды.Получить(КлючИЗначение.Ключ);
		Если ЗначениеЗаполнено(Код) Тогда
			КодыСчетов.Вставить(ВРег(СокрЛП(Код)), КлючИЗначение.Ключ);
		КонецЕсли;
		Если ЗначениеЗаполнено(КлючИЗначение.Значение) Тогда
			Список = Дети.Получить(КлючИЗначение.Значение);
			Если Список = Неопределено Тогда
				Список = Новый Массив;
				Дети.Вставить(КлючИЗначение.Значение, Список);
			КонецЕсли;
			Список.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	Субсчета = Новый Соответствие;
	Для Каждого КлючИЗначение Из Дети Цикл
		Субсчета.Вставить(КлючИЗначение.Ключ, Новый ФиксированныйМассив(КлючИЗначение.Значение));
	КонецЦикла;

	ЗапрещенныеВсе = Новый Соответствие;
	Для Каждого Корень Из Запрещенные Цикл
		Для Каждого Счет Из ПотомкиСчета(Корень, Субсчета, ВсеСчета) Цикл
			ЗапрещенныеВсе.Вставить(Счет, Истина);
		КонецЦикла;
	КонецЦикла;

	БелыйСписок = Разрешенные.Количество() > 0;
	Кандидаты = ВсеСчета;
	Если БелыйСписок Тогда
		Кандидаты = Новый Соответствие;
		Для Каждого Корень Из Разрешенные Цикл
			Для Каждого Счет Из ПотомкиСчета(Корень, Субсчета, ВсеСчета) Цикл
				Кандидаты.Вставить(Счет, Истина);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	Доступные = Новый Соответствие;
	ДоступныеМассив = Новый Массив;
	Если ПрофильНайден Тогда
		Для Каждого КлючИЗначение Из Кандидаты Цикл
			Если ЗапрещенныеВсе.Получить(КлючИЗначение.Ключ) = Неопределено Тогда
				Доступные.Вставить(КлючИЗначение.Ключ, Истина);
				ДоступныеМассив.Добавить(КлючИЗначение.Ключ);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("БелыйСписок", БелыйСписок);
	Результат.Вставить("Доступные", Новый ФиксированноеСоответствие(Доступные));
	Результат.Вставить("ДоступныеМассив", Новый ФиксированныйМассив(ДоступныеМассив));
	Результат.Вставить("Запрещенные", Новый ФиксированноеСоответствие(ЗапрещенныеВсе));
	Результат.Вставить("КодыСчетов", Новый ФиксированноеСоответствие(КодыСчетов));
	Результат.Вставить("Субсчета", Новый ФиксированноеСоответствие(Субсчета));
	Результат.Вставить("Пусто", Доступные.Количество() = 0);
	Результат.Вставить("РасширенныйДоступ", ПрофильНайден И (ПоУмолчаниюРазрешено Или БелыйСписок));
	Возврат Новый ФиксированнаяСтруктура(Результат);

КонецФункции

// Счета расчётов с персоналом, закрытые всегда: 69, 70, 71, 73 - предопределённые и найденные по коду.
//
// Возвращаемое значение:
//  Массив из ПланСчетовСсылка.Хозрасчетный - корни (субсчета закрываются по иерархии).
//
Функция БазовыеЗапрещенныеСчета() Экспорт

	Если Не ПланСчетовДоступен() Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Счета.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.Хозрасчетный КАК Счета
	|ГДЕ
	|	(Счета.Код В (&Коды)
	|			ИЛИ Счета.ИмяПредопределенныхДанных В (&Имена))");
	Запрос.УстановитьПараметр("Коды", БазовыеКодыСчетов());
	Запрос.УстановитьПараметр("Имена", СтрРазделить("РасчетыПоСоциальномуСтрахованию,РасчетыСПерсоналомПоОплатеТруда,"
		+ "РасчетыСПодотчетнымиЛицами_,РасчетыСПерсоналомПоПрочимОперациям", ","));
	Запрос.Текст = ТекстЗапросаПоПлану(Запрос.Текст);
	УстановитьПривилегированныйРежим(Истина);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

// Реестр бухгалтерских отчётов адаптера (план, раздел 6.2). Новый вид отчёта на конвейере БухгалтерскиеОтчеты
// добавляется строкой реестра.
//
// Возвращаемое значение:
//  Структура - ключ: report_kind; значение - Структура:
//   * ИмяОтчета - Строка - имя отчёта в метаданных.
//   * Заголовок - Строка
//   * НуженСчет - Булево - отчёт по одному счёту (параметр Счет).
//   * КорСчет - Булево - отчёт выводит корреспондирующие счета.
//   * Группировки - Булево - поддерживается группировка по субконто счёта.
//
Функция ВидыБухгалтерскихОтчетов() Экспорт

	Ключи = "ИмяОтчета, Заголовок, НуженСчет, КорСчет, Группировки";
	Виды = Новый Структура;
	Виды.Вставить("trial_balance", Новый Структура(Ключи, "ОборотноСальдоваяВедомость",
		НСтр("ru = 'Оборотно-сальдовая ведомость'"), Ложь, Ложь, Ложь));
	Виды.Вставить("account_trial_balance", Новый Структура(Ключи, "ОборотноСальдоваяВедомостьПоСчету",
		НСтр("ru = 'Оборотно-сальдовая ведомость по счёту'"), Истина, Ложь, Истина));
	Виды.Вставить("account_analysis", Новый Структура(Ключи, "АнализСчета",
		НСтр("ru = 'Анализ счёта'"), Истина, Истина, Истина));
	Виды.Вставить("account_turnovers", Новый Структура(Ключи, "ОборотыСчета",
		НСтр("ru = 'Обороты счёта'"), Истина, Истина, Ложь));
	Возврат Виды;

КонецФункции

// Состояние счёта в наборе.
//
// Параметры:
//  Счет - ПланСчетовСсылка.Хозрасчетный, Произвольный - счёт набора.
//  Набор - ФиксированнаяСтруктура - см. ВычислитьНаборСчетов.
//
// Возвращаемое значение:
//  Строка - "Доступен" (счёт и все субсчета доступны), "Частично" (доступна часть), "Запрещен" (ничего не доступно
//           или счёт запрещён).
//
Функция СостояниеСчета(Счет, Набор) Экспорт

	Если Набор.Запрещенные.Получить(Счет) = Истина Тогда
		Возврат "Запрещен";
	КонецЕсли;
	Всего = 0;
	Доступно = 0;
	Для Каждого Элемент Из ПотомкиСчета(Счет, Набор.Субсчета) Цикл
		Всего = Всего + 1;
		Если Набор.Доступные.Получить(Элемент) = Истина Тогда
			Доступно = Доступно + 1;
		КонецЕсли;
	КонецЦикла;
	Если Доступно = 0 Тогда
		Возврат "Запрещен";
	ИначеЕсли Доступно = Всего Тогда
		Возврат "Доступен";
	КонецЕсли;
	Возврат "Частично";

КонецФункции

// Находит счёт по тексту модели: код («60», «60.01», «60,01») или код быстрого выбора, а если по коду ничего нет -
// по наименованию. Текст в запрос не подставляется, поиск - в правах пользователя.
// Запрещённый счёт - отказ ACCESS_DENIED; среди кандидатов неоднозначного поиска называются только доступные.
//
// Параметры:
//  Текст - Строка
//  Ошибки - Структура - возвращаемый параметр: Код, Текст - отказ, если счёт не найден или недоступен.
//  Набор - ФиксированнаяСтруктура - см. ВычислитьНаборСчетов.
//
// Возвращаемое значение:
//  ПланСчетовСсылка.Хозрасчетный, Неопределено
//
Функция НайтиСчет(Текст, Ошибки, Набор) Экспорт

	Ошибки = Новый Структура("Код, Текст", "", "");
	Код = НормализованныйКодСчета(Текст);
	Если ПустаяСтрока(Код) Тогда
		Ошибки.Код = "ACCOUNT_NOT_FOUND";
		Ошибки.Текст = НСтр("ru = 'Укажите код или наименование счёта.'");
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 20
	|	Счета.Ссылка КАК Ссылка,
	|	Счета.Код КАК Код,
	|	Счета.Наименование КАК Наименование
	|ИЗ
	|	ПланСчетов.Хозрасчетный КАК Счета
	|ГДЕ
	|	НЕ Счета.ПометкаУдаления
	|	И (Счета.Код = &Код
	|			ИЛИ Счета.КодБыстрогоВыбора = &Код)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Счета.Код");
	Запрос.УстановитьПараметр("Код", Код);
	ТекстПоиска = Запрос.Текст;
	Запрос.Текст = ТекстЗапросаПоПлану(ТекстПоиска);
	Найденные = Запрос.Выполнить().Выгрузить();
	Если Найденные.Количество() = 0 Тогда
		Запрос.Текст = ТекстЗапросаПоПлану(СтрЗаменить(ТекстПоиска, "(Счета.Код = &Код
		|			ИЛИ Счета.КодБыстрогоВыбора = &Код)", "Счета.Наименование ПОДОБНО &Подобно СПЕЦСИМВОЛ ""~"""));
		Запрос.УстановитьПараметр("Подобно", "%" + ЭкранироватьПодобно(СокрЛП(Текст)) + "%");
		Найденные = Запрос.Выполнить().Выгрузить();
	КонецЕсли;

	// Точное совпадение кода важнее кода быстрого выбора другого счёта.
	Если Найденные.Количество() > 1 Тогда
		ТочныеКоды = Новый Массив;
		Для Каждого Найденный Из Найденные Цикл
			Если ВРег(СокрЛП(Найденный.Код)) = ВРег(Код) Тогда
				ТочныеКоды.Добавить(Найденный);
			КонецЕсли;
		КонецЦикла;
		Если ТочныеКоды.Количество() = 1 Тогда
			Найденные = Найденные.Скопировать(ТочныеКоды);
		КонецЕсли;
	КонецЕсли;

	Если Найденные.Количество() = 0 Тогда
		Ошибки.Код = "ACCOUNT_NOT_FOUND";
		Ошибки.Текст = СтрШаблон(НСтр("ru = 'Счёт «%1» не найден.'"), СокрЛП(Текст));
		Возврат Неопределено;
	ИначеЕсли Найденные.Количество() > 1 Тогда
		Кандидаты = Новый Массив;
		Для Каждого Найденный Из Найденные Цикл
			Если СостояниеСчета(Найденный.Ссылка, Набор) <> "Запрещен" Тогда
				Кандидаты.Добавить(СокрЛП(Найденный.Код) + " " + СокрЛП(Найденный.Наименование));
			КонецЕсли;
		КонецЦикла;
		Ошибки.Код = "ACCOUNT_AMBIGUOUS";
		Ошибки.Текст = ?(Кандидаты.Количество() = 0,
			СтрШаблон(НСтр("ru = 'Счёт «%1» неоднозначен: укажите код счёта.'"), СокрЛП(Текст)),
			СтрШаблон(НСтр("ru = 'Счёт «%1» неоднозначен, подходят: %2. Укажите код счёта.'"), СокрЛП(Текст),
				СтрСоединить(Кандидаты, "; ")));
		Возврат Неопределено;
	КонецЕсли;

	Счет = Найденные[0].Ссылка;
	Если СостояниеСчета(Счет, Набор) = "Запрещен" Тогда
		Ошибки.Код = "ACCESS_DENIED";
		Ошибки.Текст = СтрШаблон(НСтр("ru = 'Счёт %1 недоступен ассистенту: он вне профиля доступа или это счёт расчётов с персоналом.'"),
			СокрЛП(Найденные[0].Код));
		Возврат Неопределено;
	КонецЕсли;
	Возврат Счет;

КонецФункции

// Доступные счета из запрошенных: каждый запрошенный счёт разворачивается с субсчетами и пересекается с набором.
//
// Параметры:
//  Счета - Массив из ПланСчетовСсылка.Хозрасчетный
//  Набор - ФиксированнаяСтруктура - см. ВычислитьНаборСчетов.
//
// Возвращаемое значение:
//  Структура:
//   * Счета - Массив - доступные счета без повторов.
//   * Частично - Булево - часть запрошенных счетов или их субсчетов вне набора.
//
Функция ДоступныеИзЗапрошенных(Счета, Набор) Экспорт

	Результат = Новый Структура("Счета, Частично", Новый Массив, Ложь);
	Добавленные = Новый Соответствие;
	Для Каждого Счет Из Счета Цикл
		Для Каждого Элемент Из ПотомкиСчета(Счет, Набор.Субсчета) Цикл
			Если Набор.Доступные.Получить(Элемент) <> Истина Тогда
				Результат.Частично = Истина;
			ИначеЕсли Добавленные.Получить(Элемент) = Неопределено Тогда
				Добавленные.Вставить(Элемент, Истина);
				Результат.Счета.Добавить(Элемент);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Проверяет вид субконто: ПДн-периметр этапа (работники, типы людей) и правила профиля доступа.
//
// Параметры:
//  ВидСубконто - ПланВидовХарактеристикСсылка.ВидыСубконтоХозрасчетные
//  Причина - Строка - возвращаемый параметр.
//
// Возвращаемое значение:
//  Строка - код отказа: "PERIMETER_VIOLATION", "ACCESS_DENIED" или пустая строка, если вид разрешён.
//
Функция ВидСубконтоЗапрещен(ВидСубконто, Причина = "") Экспорт

	Если ВидСубконто = ОбщегоНазначения.ПредопределенныйЭлемент(
		"ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.РаботникиОрганизаций") Тогда
		Причина = НСтр("ru = 'персональные данные работников'");
		Возврат "PERIMETER_VIOLATION";
	КонецЕсли;
	ТипЗначения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидСубконто, "ТипЗначения");
	Если ТипЗнч(ТипЗначения) <> Тип("ОписаниеТипов") Тогда
		Возврат "";
	КонецЕсли;
	ЗапрещенныеТипы = ИИА_Периметр.ОписаниеПериметра().ЗапрещенныеТипы;
	Для Каждого ТипСубконто Из ТипЗначения.Типы() Цикл
		ПричинаПериметра = ЗапрещенныеТипы.Получить(ТипСубконто);
		Если ПричинаПериметра <> Неопределено Или ИИА_Периметр.ЭтоМаскируемыйТип(ТипСубконто) Тогда
			Причина = ?(ПричинаПериметра = Неопределено, НСтр("ru = 'персональные данные'"), ПричинаПериметра);
			Возврат "PERIMETER_VIOLATION";
		КонецЕсли;
	КонецЦикла;
	Для Каждого ТипСубконто Из ТипЗначения.Типы() Цикл
		Если ИИА_ПрофилиДоступа.ТипЗапрещенПрофилем(ТипСубконто, Причина) Тогда
			Возврат "ACCESS_DENIED";
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Находит вид субконто по наименованию или имени предопределённого элемента (в правах пользователя).
//
// Параметры:
//  Текст - Строка
//  Ошибки - Структура - возвращаемый параметр: Код, Текст.
//
// Возвращаемое значение:
//  ПланВидовХарактеристикСсылка.ВидыСубконтоХозрасчетные, Неопределено
//
Функция НайтиВидСубконто(Текст, Ошибки) Экспорт

	Ошибки = Новый Структура("Код, Текст", "", "");
	Имя = СокрЛП(Текст);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 6
	|	Виды.Ссылка КАК Ссылка,
	|	Виды.Наименование КАК Наименование,
	|	Виды.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных
	|ИЗ
	|	ПланВидовХарактеристик.ВидыСубконтоХозрасчетные КАК Виды
	|ГДЕ
	|	НЕ Виды.ПометкаУдаления
	|	И (Виды.Наименование ПОДОБНО &Подобно СПЕЦСИМВОЛ ""~""
	|			ИЛИ Виды.ИмяПредопределенныхДанных = &Имя)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Виды.Наименование");
	Запрос.УстановитьПараметр("Подобно", "%" + ЭкранироватьПодобно(Имя) + "%");
	Запрос.УстановитьПараметр("Имя", Имя);
	Найденные = Запрос.Выполнить().Выгрузить();
	Для Каждого Найденный Из Найденные Цикл
		Если ВРег(СокрЛП(Найденный.Наименование)) = ВРег(Имя) Или ВРег(Найденный.ИмяПредопределенныхДанных) = ВРег(Имя) Тогда
			Возврат Найденный.Ссылка;
		КонецЕсли;
	КонецЦикла;
	Если Найденные.Количество() = 1 И Не ПустаяСтрока(Имя) Тогда
		Возврат Найденные[0].Ссылка;
	КонецЕсли;
	Ошибки.Код = "SUBCONTO_NOT_FOUND";
	Если Найденные.Количество() = 0 Или ПустаяСтрока(Имя) Тогда
		Ошибки.Текст = СтрШаблон(НСтр("ru = 'Вид субконто «%1» не найден.'"), Имя);
	Иначе
		Кандидаты = Новый Массив;
		Для Каждого Найденный Из Найденные Цикл
			Кандидаты.Добавить(СокрЛП(Найденный.Наименование));
		КонецЦикла;
		Ошибки.Текст = СтрШаблон(НСтр("ru = 'Вид субконто «%1» неоднозначен, подходят: %2.'"), Имя,
			СтрСоединить(Кандидаты, "; "));
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Добавляет в отбор настроек бухгалтерского отчёта ограничение доступными счетами: группа «И» с отбором
// Счет В СПИСКЕ (если поле Счет доступно для отбора) и вложенной группой «ИЛИ» по КорСчет (не заполнен или в списке),
// если поле КорСчет есть в схеме. Отбор задаётся развёрнутым списком счетов, а не по иерархии: семантика совпадает
// с проверкой в коде. В отчётах по одному счёту (ОСВ по счёту, анализ и обороты счёта) поле Счет закрыто для отбора
// схемой: счёт там ограничен параметром отчёта, вызывающий проверяет его состояние.
//
// Параметры:
//  Отбор - ОтборКомпоновкиДанных - отбор настроек отчёта.
//  ДоступныеПоля - ДоступныеПоляКомпоновкиДанных - доступные поля отбора схемы отчёта.
//  Набор - ФиксированнаяСтруктура - см. ВычислитьНаборСчетов.
//
// Возвращаемое значение:
//  Структура:
//   * Счет - Булево - добавлен отбор по полю Счет.
//   * КорСчет - Булево - добавлен отбор по полю КорСчет.
//
Функция ДобавитьОтборСчетов(Отбор, ДоступныеПоля, Набор) Экспорт

	Результат = Новый Структура("Счет, КорСчет", Ложь, Ложь);
	ПолеСчет = Новый ПолеКомпоновкиДанных("Счет");
	ПолеКорСчет = Новый ПолеКомпоновкиДанных("КорСчет");
	Результат.Счет = ДоступныеПоля.НайтиПоле(ПолеСчет) <> Неопределено;
	Результат.КорСчет = ДоступныеПоля.НайтиПоле(ПолеКорСчет) <> Неопределено;
	Если Не Результат.Счет И Не Результат.КорСчет Тогда
		Возврат Результат;
	КонецЕсли;
	СписокСчетов = Новый СписокЗначений;
	СписокСчетов.ЗагрузитьЗначения(Новый Массив(Набор.ДоступныеМассив));

	Группа = Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	Группа.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	Группа.Представление = НСтр("ru = 'ИИА: ограничение счетов'");
	Группа.Использование = Истина;
	Если Результат.Счет Тогда
		ДобавитьЭлементОтбора(Группа, ПолеСчет, ВидСравненияКомпоновкиДанных.ВСписке, СписокСчетов);
	КонецЕсли;

	Если Результат.КорСчет Тогда
		ГруппаКор = Группа.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаКор.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
		ГруппаКор.Использование = Истина;
		// Без ветки «не заполнен» отбор обнулил бы наборы остатков без корреспонденции.
		ДобавитьЭлементОтбора(ГруппаКор, ПолеКорСчет, ВидСравненияКомпоновкиДанных.НеЗаполнено, Неопределено);
		ДобавитьЭлементОтбора(ГруппаКор, ПолеКорСчет, ВидСравненияКомпоновкиДанных.ВСписке, СписокСчетов);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Фиксированный шаблон запроса остатков и оборотов регистра Хозрасчетный: модель передаёт только параметры.
// Условие по счетам стоит и в параметрах виртуальной таблицы, и во внешнем условии ГДЕ.
// Параметры запроса: ДоступныеСчета, ДоступныеКорСчета (если ПоКорСчету), Организация, НачалоПериода, КонецПериода, ВидыСубконто (если ССубконто).
//
// Параметры:
//  Режим - Строка - "balances", "turnovers", "balances_and_turnovers".
//  ССубконто - Булево - выбрать значение одного вида субконто (поле Субконто).
//  ПоКорСчету - Булево - только для "turnovers": корреспонденция (поле КорСчет).
//
// Возвращаемое значение:
//  Строка - текст запроса; пустая строка для неизвестного режима.
//
Функция ТекстЗапросаОстатковИОборотов(Режим, ССубконто, ПоКорСчету) Экспорт

	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 201
	|	Т.Счет КАК Счет,
	|	Т.Субконто1 КАК Субконто,
	|	Т.СуммаОстатокДт КАК СуммаОстатокДт, Т.СуммаОстатокКт КАК СуммаОстатокКт
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(&КонецПериода, Счет В (&ДоступныеСчета), &ВидыСубконто, Организация = &Организация) КАК Т
	|ГДЕ
	|	Т.Счет В (&ДоступныеСчета)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.Счет.Код";
	ТаблицаОстатков = "Остатки(&КонецПериода, Счет В (&ДоступныеСчета), &ВидыСубконто, Организация = &Организация)";
	РесурсыОстатков = "Т.СуммаОстатокДт КАК СуммаОстатокДт, Т.СуммаОстатокКт КАК СуммаОстатокКт";
	ПоКорСчету = ПоКорСчету И Режим = "turnovers";
	Если Режим = "turnovers" Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ТаблицаОстатков, "Обороты(&НачалоПериода, &КонецПериода, , Счет В (&ДоступныеСчета),
		|		&ВидыСубконто, Организация = &Организация, " + ?(ПоКорСчету, "КорСчет В (&ДоступныеКорСчета)", "") + ", )");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, РесурсыОстатков, "Т.СуммаОборотДт КАК СуммаОборотДт, Т.СуммаОборотКт КАК СуммаОборотКт");
	ИначеЕсли Режим = "balances_and_turnovers" Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ТаблицаОстатков, "ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , ,
		|		Счет В (&ДоступныеСчета), &ВидыСубконто, Организация = &Организация)");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, РесурсыОстатков, "Т.СуммаНачальныйОстатокДт КАК СуммаНачальныйОстатокДт,
		|	Т.СуммаНачальныйОстатокКт КАК СуммаНачальныйОстатокКт, Т.СуммаОборотДт КАК СуммаОборотДт,
		|	Т.СуммаОборотКт КАК СуммаОборотКт, Т.СуммаКонечныйОстатокДт КАК СуммаКонечныйОстатокДт,
		|	Т.СуммаКонечныйОстатокКт КАК СуммаКонечныйОстатокКт");
	ИначеЕсли Режим <> "balances" Тогда
		Возврат "";
	КонецЕсли;
	Если ПоКорСчету Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Т.Счет КАК Счет,", "Т.Счет КАК Счет, Т.КорСчет КАК КорСчет,");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Т.Счет В (&ДоступныеСчета)", "Т.Счет В (&ДоступныеСчета)
		|	И Т.КорСчет В (&ДоступныеКорСчета)");
	КонецЕсли;
	Если Не ССубконто Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Т.Субконто1 КАК Субконто,", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВидыСубконто", "");
	КонецЕсли;
	ТекстЗапроса = ТекстЗапросаПоПлану(ТекстЗапроса);
	// УНФ: в регистре Управленческий рядом с фактом хранятся планы - нужен только фактический сценарий.
	ИмяПлана = ИмяПланаСчетов();
	Если Не ПустаяСтрока(ИмяПлана)
		И Метаданные.РегистрыБухгалтерии[ИмяПлана].Измерения.Найти("СценарийПланирования") <> Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Организация = &Организация",
			"Организация = &Организация И СценарийПланирования = ЗНАЧЕНИЕ(Справочник.СценарииПланирования.Фактический)");
	КонецЕсли;
	Возврат ТекстЗапроса;

КонецФункции

// Второй эшелон защиты бухгалтерского отчёта: удаляет из компактной таблицы строки и колонки закрытых счетов.
// Строка удаляется, если в колонке 1 или 2 первый токен ячейки - код запрещённого счёта (или код базового запрета);
// колонка (3-я и дальше) - если такой код стоит в ячейке шапки (строки до первой строки данных).
// Частично доступные счета не удаляются: их строки уже ограничены отбором до формирования.
//
// Параметры:
//  Таблица - Структура - Колонки (Массив), Строки (Массив из Массив) - результат компактной таблицы отчёта.
//  Набор - ФиксированнаяСтруктура - см. ВычислитьНаборСчетов.
//  ИсключатьИтоги - Булево - удалить строки «Итог...».
//
// Возвращаемое значение:
//  Структура - та же таблица.
//
Функция ТаблицаБезНедоступныхСчетов(Таблица, Набор, ИсключатьИтоги = Истина) Экспорт

	УдаляемыеКолонки = Новый Соответствие;
	Шапка = Истина;
	Строки = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица.Строки Цикл
		Если Шапка И ЭтоСтрокаДанных(СтрокаТаблицы, Набор) Тогда
			Шапка = Ложь;
		КонецЕсли;
		Если Шапка Тогда
			Для Индекс = 2 По СтрокаТаблицы.ВГраница() Цикл
				Если КодЗакрыт(ТокенКодаСчета(СтрокаТаблицы[Индекс]), Набор) Тогда
					УдаляемыеКолонки.Вставить(Индекс, Истина);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Исключить = Ложь;
		Для Индекс = 0 По Мин(1, СтрокаТаблицы.ВГраница()) Цикл
			Ячейка = СокрЛП(СтрокаТаблицы[Индекс]);
			Если ИсключатьИтоги И СтрНачинаетсяС(ВРег(Ячейка), "ИТОГ") Или КодЗакрыт(ТокенКодаСчета(Ячейка), Набор) Тогда
				Исключить = Истина;
			КонецЕсли;
		КонецЦикла;
		Если Не Исключить Тогда
			Строки.Добавить(СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;
	Таблица.Строки = Строки;

	Если УдаляемыеКолонки.Количество() > 0 Тогда
		Индекс = Таблица.Колонки.ВГраница();
		Пока Индекс >= 2 Цикл
			Если УдаляемыеКолонки.Получить(Индекс) <> Неопределено Тогда
				Таблица.Колонки.Удалить(Индекс);
				Для Каждого СтрокаТаблицы Из Таблица.Строки Цикл
					Если СтрокаТаблицы.ВГраница() >= Индекс Тогда
						СтрокаТаблицы.Удалить(Индекс);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;
	КонецЕсли;
	Возврат Таблица;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Корень и все его субсчета на любой глубине. ВсеСчета - если задано, корень вне плана счетов не возвращается.
Функция ПотомкиСчета(Корень, Субсчета, ВсеСчета = Неопределено)

	Результат = Новый Массив;
	Если ВсеСчета <> Неопределено И ВсеСчета.Получить(Корень) = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.Добавить(Корень);
	Индекс = 0;
	Пока Индекс < Результат.Количество() Цикл
		Дети = Субсчета.Получить(Результат[Индекс]);
		Если Дети <> Неопределено Тогда
			Для Каждого Ребенок Из Дети Цикл
				Результат.Добавить(Ребенок);
			КонецЦикла;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция БазовыеКодыСчетов()

	Возврат СтрРазделить("69,70,71,73", ",");

КонецФункции

// Код из текста модели: без пробелов по краям, запятая - точка, без завершающей точки и слова «счёт» в начале.
Функция НормализованныйКодСчета(Текст)

	Код = СокрЛП(Текст);
	Для Каждого Слово Из СтрРазделить("СЧЁТ ,СЧЕТ ", ",") Цикл
		Если СтрНачинаетсяС(ВРег(Код), Слово) Тогда
			Код = СокрЛП(Сред(Код, СтрДлина(Слово) + 1));
		КонецЕсли;
	КонецЦикла;
	Код = СтрЗаменить(Код, ",", ".");
	Пока СтрЗаканчиваетсяНа(Код, ".") Цикл
		Код = Лев(Код, СтрДлина(Код) - 1);
	КонецЦикла;
	Возврат СокрЛП(Код);

КонецФункции

Процедура ДобавитьЭлементОтбора(Группа, Поле, ВидСравнения, Значение)

	Элемент = Группа.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Элемент.ЛевоеЗначение = Поле;
	Элемент.ВидСравнения = ВидСравнения;
	Элемент.ПравоеЗначение = Значение;
	Элемент.Использование = Истина;

КонецПроцедуры

// Первый токен ячейки (до пробела) в формате кода счёта: сегменты из цифр и букв через точку («60», «60.01»,
// «76.АВ»). Сумма с разделителем разрядов или запятой («70 000,00», «70,5») токеном не считается.
// Возвращает токен в верхнем регистре или пустую строку.
Функция ТокенКодаСчета(Знач Ячейка)

	Ячейка = СокрЛП(Ячейка);
	Пробел = СтрНайти(Ячейка, " ");
	Токен = ?(Пробел = 0, Ячейка, Лев(Ячейка, Пробел - 1));
	Если Пробел > 0 И ЭтоЦифра(Лев(СокрЛ(Сред(Ячейка, Пробел + 1)), 1)) Тогда
		Возврат "";
	КонецЕсли;
	Если СтрЗаканчиваетсяНа(Токен, ".") Тогда
		Токен = Лев(Токен, СтрДлина(Токен) - 1);
	КонецЕсли;
	Если ПустаяСтрока(Токен) Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Сегмент Из СтрРазделить(Токен, ".", Истина) Цикл
		Если Сегмент = "" Тогда
			Возврат "";
		КонецЕсли;
		Для Позиция = 1 По СтрДлина(Сегмент) Цикл
			Символ = Сред(Сегмент, Позиция, 1);
			Если Не ЭтоЦифра(Символ) И ВРег(Символ) = НРег(Символ) Тогда
				Возврат "";
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат ВРег(Токен);

КонецФункции

// Токен - код базового запрета («70», «70.01») или код счёта, который в наборе «Запрещен».
Функция КодЗакрыт(Токен, Набор)

	Если ПустаяСтрока(Токен) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЭтоБазовыйКод(Токен) Тогда
		Возврат Истина;
	КонецЕсли;
	Счет = Набор.КодыСчетов.Получить(Токен);
	Возврат Счет <> Неопределено И СостояниеСчета(Счет, Набор) = "Запрещен";

КонецФункции

Функция ЭтоБазовыйКод(Токен)

	Для Каждого Код Из БазовыеКодыСчетов() Цикл
		Если Токен = Код Или СтрНачинаетсяС(Токен, Код + ".") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Первая строка данных: в колонке 1 или 2 код счёта, либо в колонках 3+ число (не код счёта).
Функция ЭтоСтрокаДанных(СтрокаТаблицы, Набор)

	Для Индекс = 0 По СтрокаТаблицы.ВГраница() Цикл
		Токен = ТокенКодаСчета(СтрокаТаблицы[Индекс]);
		ЭтоКод = Не ПустаяСтрока(Токен) И (ЭтоБазовыйКод(Токен) Или Набор.КодыСчетов.Получить(Токен) <> Неопределено);
		Если Индекс <= 1 И ЭтоКод Или Индекс > 1 И Не ЭтоКод И ЭтоЧисло(СтрокаТаблицы[Индекс]) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЭтоЧисло(Знач Текст)

	Текст = СтрЗаменить(СтрЗаменить(СтрЗаменить(СокрЛП(Текст), " ", ""), Символы.НПП, ""), ",", ".");
	Если СтрНачинаетсяС(Текст, "-") Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;
	Если ПустаяСтрока(Текст) Или СтрЧислоВхождений(Текст, ".") > 1 Или Текст = "." Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ <> "." И Не ЭтоЦифра(Символ) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ЭтоЦифра(Символ)

	Возврат СтрДлина(Символ) = 1 И СтрНайти("0123456789", Символ) > 0;

КонецФункции

Функция ЭкранироватьПодобно(Текст)

	Результат = Текст;
	Для Каждого Символ Из СтрРазделить("~,%,_,[,],^", ",") Цикл
		Результат = СтрЗаменить(Результат, Символ, "~" + Символ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
