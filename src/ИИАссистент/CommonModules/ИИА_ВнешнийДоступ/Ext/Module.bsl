///////////////////////////////////////////////////////////////////////////////////////////////////////
// ИИ-ассистент: внешний доступ к тем же инструментам по JWT (план, раздел 4.11, этап 4).
//  - Токен выпускает серверный код в сеансе самого пользователя (ВыпуститьТокен): эмитент, получатель,
//    короткое время жизни, пользователь в ключе сопоставления; подпись RS256 закрытым ключом из
//    безопасного хранилища. Проверку выполняет публикация (accessTokenAuthentication в default.vrd)
//    по открытому ключу - см. docs/plans/ai-chat-1c-external-access.md.
//  - HTTP-сервис ИИА_API работает от имени пользователя из токена; сверху - тот же реестр инструментов,
//    профиль, периметр, классы данных (внешний канал - уровень доверия из константы, по умолчанию Т3),
//    очистка инструкций в данных и журнал.
//  - Отзыва токена до истечения срока нет: срок короткий, выдача журналируется, доступ снимается ролью
//    ИИА_ВнешнийДоступ или флагом аутентификации токеном у пользователя ИБ.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Обработка запроса HTTP-сервиса ИИА_API.
//
// Параметры:
//  Вид - Строка - "tools", "tool", "chat".
//  ИмяИнструмента - Строка
//  ТелоJSON - Строка
//
// Возвращаемое значение:
//  HTTPСервисОтвет
//
Функция ОбработатьЗапрос(Вид, ИмяИнструмента, ТелоJSON) Экспорт

	Если Не РольДоступна("ИИА_ВнешнийДоступ") Или Не ИИА_ЧатВызовСервера.АссистентДоступенПользователю() Тогда
		ЗаписатьЖурнал(Вид, ИмяИнструмента, "ACCESS_DENIED", Истина);
		Возврат Ответ(403, Ошибка("ACCESS_DENIED", НСтр("ru = 'Внешний доступ к ИИ-ассистенту не разрешён.'")));
	КонецЕсли;

	Попытка
		Если Вид = "tools" Тогда
			Возврат Ответ(200, Новый Структура("tools", ВнешниеИнструменты()));
		ИначеЕсли Вид = "tool" Тогда
			Возврат ВыполнитьИнструмент(ИмяИнструмента, ТелоJSON);
		ИначеЕсли Вид = "chat" Тогда
			Возврат ЗадатьВопрос(ТелоJSON);
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ИИАссистент.ВнешнийДоступ", УровеньЖурналаРегистрации.Ошибка, , ,
			ИИА_Периметр.ОчиститьТекст(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат Ответ(500, Ошибка("INTERNAL_ERROR", НСтр("ru = 'Внутренняя ошибка.'")));
	КонецПопытки;
	Возврат Ответ(404, Ошибка("NOT_FOUND", ""));

КонецФункции

// Выпускает JWT для внешнего канала текущему пользователю.
//
// Параметры:
//  МинутЖизни - Число - от 1 до 60.
//
// Возвращаемое значение:
//  Строка - текст токена.
//
Функция ВыпуститьТокен(МинутЖизни = 15) Экспорт

	Если Не РольДоступна("ИИА_ВнешнийДоступ") Тогда
		ВызватьИсключение НСтр("ru = 'Нет роли «ИИ-ассистент: внешний доступ к инструментам».'");
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Ключ = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ВладелецКлюча(), "КлючПодписиJWT");
	УстановитьПривилегированныйРежим(Ложь);
	Если Не ЗначениеЗаполнено(Ключ) Тогда
		ВызватьИсключение НСтр("ru = 'Администратор не задал ключ подписи токенов.'");
	КонецЕсли;

	Токен = Новый ТокенДоступа;
	Токен.Эмитент = Эмитент();
	Получатели = Новый Массив;
	Получатели.Добавить(Получатель());
	Токен.Получатели = Получатели;
	Токен.ВремяСоздания = Число(ТекущаяУниверсальнаяДата() - Дата(1970, 1, 1)) - 30;
	Токен.ВремяЖизни = Макс(1, Мин(60, МинутЖизни)) * 60;
	Токен.Идентификатор = Новый УникальныйИдентификатор;
	Токен.КлючСопоставленияПользователя = ИмяПользователяИБ();
	Токен.Подписать(АлгоритмПодписиТокенаДоступа.RS256, ПолучитьДвоичныеДанныеИзСтроки(Ключ));
	ЗаписатьЖурнал("token", "", "ISSUED", Ложь, СтрШаблон("ttl_min=%1; jti=%2", МинутЖизни, Токен.Идентификатор));
	Возврат Строка(Токен);

КонецФункции

// Сохраняет закрытый ключ подписи (PEM) в безопасное хранилище. Пустой ключ не меняет сохранённый.
//
// Параметры:
//  КлючPEM - Строка
//
Процедура СохранитьКлючПодписи(КлючPEM) Экспорт

	Если Не РольДоступна("ИИА_Администратор") И Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав.'");
	КонецЕсли;
	Если ПустаяСтрока(КлючPEM) Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ВладелецКлюча(), СокрЛП(КлючPEM), "КлючПодписиJWT");

КонецПроцедуры

// Задан ли ключ подписи токенов.
//
// Возвращаемое значение:
//  Булево
//
Функция КлючПодписиЗаполнен() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Возврат ЗначениеЗаполнено(ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ВладелецКлюча(), "КлючПодписиJWT"));

КонецФункции

// Эмитент (iss) токенов - должен совпадать с issuer в default.vrd.
//
// Возвращаемое значение:
//  Строка
//
Функция Эмитент() Экспорт

	Возврат "iia-1c";

КонецФункции

// Получатель (aud) токенов - должен совпадать с accessTokenRecepientName в default.vrd.
//
// Возвращаемое значение:
//  Строка
//
Функция Получатель() Экспорт

	Возврат "iia-api";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Инструменты, доступные вне хода чата: без open_object, make_chart, slice_result, read_object и
// propose_draft, propose_change - им нужен контекст хода (идентификаторы o1/t1) или интерфейс 1С.
Функция ВнешниеИнструменты()

	Инструменты = Новый Массив;
	Для Каждого Инструмент Из ИИА_Инструменты.ОписанияИнструментов() Цикл
		Если ТолькоДляЧата(Инструмент.Получить("function").Получить("name")) Тогда
			Продолжить;
		КонецЕсли;
		Инструменты.Добавить(Инструмент);
	КонецЦикла;
	Возврат Инструменты;

КонецФункции

Функция ТолькоДляЧата(Имя)

	Возврат СтрРазделить("open_object,make_chart,slice_result,read_object,propose_draft,show_form,propose_change", ",")
		.Найти(Имя) <> Неопределено;

КонецФункции

Функция ВыполнитьИнструмент(Имя, ТелоJSON)

	Если ТолькоДляЧата(Имя) Тогда
		Возврат Ответ(400, Ошибка("CHAT_ONLY", НСтр("ru = 'Инструмент доступен только в чате 1С.'")));
	КонецЕсли;
	Выполнение = ИИА_Инструменты.ВыполнитьИнструмент(Имя, ?(ПустаяСтрока(ТелоJSON), "{}", ТелоJSON));
	Класс = ?(Выполнение.Свойство("Класс"), Выполнение.Класс, 1);
	Если Выполнение.Успех И Не ИИА_КлассыДанных.КлассДопустимДляДоверия(Класс, ДовериеКанала()) Тогда
		ЗаписатьЖурнал("tool", Имя, "DATA_CLASS_NOT_ALLOWED", Истина);
		Возврат Ответ(403, Ошибка("DATA_CLASS_NOT_ALLOWED", СтрШаблон(
			НСтр("ru = 'Данные класса %1 нельзя передавать во внешний канал.'"), ИИА_КлассыДанных.ПредставлениеКласса(Класс))));
	КонецЕсли;
	ЗаписатьЖурнал("tool", Имя, Выполнение.Итог, Выполнение.Итог = "PERIMETER_VIOLATION",
		СтрШаблон("rows=%1; hidden=%2", Выполнение.Строк, Выполнение.Скрыто));
	Срабатывания = 0;
	// Канонический вид (хэш-псевдонимы) -> вид для уровня доверия канала: Т3 - текстовый слой коммерческого
	// маскирования, Т1/Т2 - коммерческие псевдонимы раскрываются. Номера диалога во внешний канал не выдаются.
	ДанныеКанала = ИИА_Маскирование.ДляДоверия(Выполнение.Данные, ДовериеКанала(), ИИА_Маскирование.НовыйКэш(, "http"));
	Данные = ИИА_ЗащитаОтИнъекций.ОчиститьДанныеВнешнегоКанала(ОбщегоНазначения.ЗначениеВJSON(ДанныеКанала), Срабатывания);
	Возврат ОтветТекстом(?(Выполнение.Успех, 200, 422), СтрШаблон("{""ok"":%1,""code"":""%2"",""data"":%3}",
		?(Выполнение.Успех, "true", "false"), Выполнение.Итог, Данные));

КонецФункции

Функция ЗадатьВопрос(ТелоJSON)

	Попытка
		Тело = ОбщегоНазначения.JSONВЗначение(ТелоJSON, , Истина);
		Вопрос = Тело.Получить("question");
	Исключение
		Вопрос = Неопределено;
	КонецПопытки;
	Если ТипЗнч(Вопрос) <> Тип("Строка") Или ПустаяСтрока(Вопрос) Тогда
		Возврат Ответ(400, Ошибка("BAD_REQUEST", НСтр("ru = 'Ожидается JSON {""question"": ""...""}.'")));
	КонецЕсли;
	// HTTP использует тот же запуск, лимиты и ключ задания пользователя, что и форма чата.
	// Канал http: результат во временном хранилище, без состояния хода, очереди и паузы.
	Запуск = ИИА_ЧатВызовСервера.ЗапуститьХод(Новый Массив, Лев(Вопрос, 8000), Новый УникальныйИдентификатор, , , , , , ,
		, "http");
	Если Не Запуск.Запущено Тогда
		КодHTTP = 429;
		Если Запуск.КодОшибки = "ASSISTANT_DISABLED" Или Запуск.КодОшибки = "PROFILE_CONFLICT" Тогда
			КодHTTP = 403;
		ИначеЕсли Запуск.КодОшибки = "BAD_REQUEST" Тогда
			КодHTTP = 400;
		КонецЕсли;
		Возврат Ответ(КодHTTP, Ошибка(Запуск.КодОшибки, Запуск.Ошибка));
	КонецЕсли;

	Попытка
		Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Запуск.ИдентификаторЗадания);
		Если Задание <> Неопределено Тогда
			Задание.ОжидатьЗавершенияВыполнения();
		КонецЕсли;
		Состояние = ИИА_ЧатВызовСервера.СостояниеХода(Запуск.ИдентификаторЗадания, Запуск.АдресРезультата);
		Ход = Состояние.Результат;
	Исключение
		ИИА_ЧатВызовСервера.ОтменитьХод(Запуск.ИдентификаторЗадания);
		УдалитьИзВременногоХранилища(Запуск.АдресРезультата);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьИзВременногоХранилища(Запуск.АдресРезультата);
	Если Не Ход.Успех Тогда
		// Текст ошибки хода может содержать данные из канонического вида: выдаётся по доверию канала.
		Возврат Ответ(422, Ошибка("TURN_ERROR", ИИА_Маскирование.ДляДоверия(Ход.Ошибка, ДовериеКанала(),
			ИИА_Маскирование.НовыйКэш(, "http"))));
	КонецЕсли;
	Если Ход.КлассДанных > 0 И Не ИИА_КлассыДанных.КлассДопустимДляДоверия(Ход.КлассДанных, ДовериеКанала()) Тогда
		Возврат Ответ(403, Ошибка("DATA_CLASS_NOT_ALLOWED", НСтр("ru = 'Ответ основан на данных, которые нельзя передавать во внешний канал.'")));
	КонецЕсли;
	Таблицы = Новый Массив;
	Для Каждого Таблица Из Ход.Таблицы Цикл
		Таблицы.Добавить(Новый Структура("title, columns, rows", Таблица.Заголовок, Таблица.Колонки, Таблица.Строки));
	КонецЦикла;
	ЗаписатьЖурнал("chat", "", ?(Ход.Успех, "OK", "ERROR"), Ход.ЕстьЧужойТекст);
	// Ответ хода в каноническом виде -> вид для уровня доверия канала (см. ВыполнитьИнструмент).
	Кэш = ИИА_Маскирование.НовыйКэш(, "http");
	ОтветКанала = ИИА_Маскирование.ДляДоверия(Новый Структура("text, error, tables", Ход.Текст, Ход.Ошибка, Таблицы),
		ДовериеКанала(), Кэш);
	Возврат Ответ(?(Ход.Успех, 200, 422), Новый Структура("ok, text, error, tables", Ход.Успех, ОтветКанала.text,
		ОтветКанала.error, ОтветКанала.tables));

КонецФункции

Функция ДовериеКанала()

	УстановитьПривилегированныйРежим(Истина);
	Возврат Константы.ИИА_ДовериеВнешнегоКанала.Получить();

КонецФункции

Функция Ответ(Код, Данные)

	Возврат ОтветТекстом(Код, ОбщегоНазначения.ЗначениеВJSON(Данные));

КонецФункции

Функция ОтветТекстом(Код, Текст)

	ОтветHTTP = Новый HTTPСервисОтвет(Код);
	ОтветHTTP.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	ОтветHTTP.Заголовки.Вставить("Cache-Control", "no-store");
	ОтветHTTP.УстановитьТелоИзСтроки(Текст, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат ОтветHTTP;

КонецФункции

Функция Ошибка(Код, Текст)

	Возврат Новый Структура("ok, code, message", Ложь, Код, Текст);

КонецФункции

Функция ВладелецКлюча()

	Возврат "ИИАссистент.ВнешнийДоступ";

КонецФункции

Функция ИмяПользователяИБ()

	Возврат ПользователиИнформационнойБазы.ТекущийПользователь().Имя;

КонецФункции

Процедура ЗаписатьЖурнал(Вид, Инструмент, Итог, Инцидент, Подробности = "")

	УстановитьПривилегированныйРежим(Истина);
	Запись = РегистрыСведений.ИИА_ЖурналВызовов.СоздатьМенеджерЗаписи();
	Запись.ИдентификаторЗаписи = Строка(Новый УникальныйИдентификатор);
	Запись.МоментВызова = ТекущаяУниверсальнаяДата();
	Запись.Пользователь = Пользователи.ТекущийПользователь();
	Запись.Событие = "ВнешнийДоступ." + Вид;
	Запись.Инструмент = Инструмент;
	Запись.Итог = Итог;
	Запись.Инцидент = Инцидент;
	Запись.Подробности = Подробности;
	Запись.Записать();

КонецПроцедуры

#КонецОбласти
