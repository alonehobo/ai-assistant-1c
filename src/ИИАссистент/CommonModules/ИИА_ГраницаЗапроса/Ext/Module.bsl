// BSLLS:CommonModuleInvalidType-off
// Только сервер: вызов с клиента и внешнее соединение намеренно отключены.
// BSLLS:CommonModuleInvalidType-on
///////////////////////////////////////////////////////////////////////////////////////////////////////
// ИИ-ассистент: граница данных для свободного запроса агента (режим чёрного списка).
// Правила (план, раздел 4.5 п. 8):
//  - ни один объект/поле из периметра не участвует в запросе: ни источником, ни через разыменование,
//    ни в условиях, соединениях, группировках, подзапросах;
//  - параметры только примитивы, разыменование параметров запрещено;
//  - временные таблицы только из того же пакета (выполнение с новым менеджером временных таблиц);
//  - неразобранная цепочка полей - отказ (fail-closed);
//  - ошибка разбора возвращается с кратким текстом, ошибка исполнения - только кодом;
//  - значения результата проходят фильтр периметра и детекторы.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Проверяет и выполняет запрос агента в сеансе текущего пользователя.
//
// Параметры:
//  ТекстЗапроса - Строка
//  ПараметрыЗапроса - Структура, Соответствие, Неопределено - значения только примитивных типов
//                     или массивы примитивов.
//  МаксимумСтрок - Число - сколько строк вернуть модели.
//  ДопустимыеСсылки - Массив из ЛюбаяСсылка - ссылки, которые можно передать параметром помимо примитивов:
//                     объект контекста, проверенный периметром до вызова (см. ИИА_Инструменты.ОписаниеКонтекста),
//                     и ссылки, полученные из псевдонимов в параметрах модели.
//  РазрешитьМаскируемыеПоля - Булево - Истина только для серверных запросов инструментов (find_records):
//                     реквизиты списка коммерческого маскирования можно использовать в условиях; текст запроса
//                     модели всегда проверяется с Ложь.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * КодОшибки - Строка - PARAMETER_NOT_PRIMITIVE, PARAMETER_DEREFERENCE, QUERY_PARSE_ERROR,
//                          PERIMETER_VIOLATION, MASKED_FIELD, PSEUDONYM_AS_LITERAL, UNRESOLVED_FIELD,
//                          QUERY_EXECUTION_ERROR, QUERY_TIMEOUT, TEMP_TABLE_LIMIT.
//   * Сообщение - Строка
//   * НедостающиеПараметры - Массив из Строка - безопасные имена параметров, которым не передано значение.
//   * ЛишниеПараметры - Массив из Строка - безопасные имена переданных параметров, отсутствующих в тексте.
//   * Колонки - Массив из Строка
//   * Строки - Массив из Массив
//   * Усечено - Булево
//   * Скрыто - Число - число скрытых значений.
//   * Таблицы - Массив из Строка - полные имена объектов метаданных - источников запроса (см. ПроверитьЗапрос).
//
Функция ВыполнитьЗапросАгента(ТекстЗапроса, ПараметрыЗапроса = Неопределено, МаксимумСтрок = 200,
	ДопустимыеСсылки = Неопределено, РазрешитьМаскируемыеПоля = Ложь) Экспорт

	Результат = НовыйРезультат();

	Проверка = ПроверитьЗапрос(ТекстЗапроса, ПараметрыЗапроса, МаксимумСтрок, ДопустимыеСсылки,
		РазрешитьМаскируемыеПоля);
	Если Не Проверка.Успех Тогда
		ЗаполнитьЗначенияСвойств(Результат, Проверка, "Успех, КодОшибки, Сообщение, НедостающиеПараметры, ЛишниеПараметры");
		Возврат Результат;
	КонецЕсли;
	Результат.Класс = Проверка.Класс;
	Результат.Таблицы = Проверка.Таблицы;

	Выполнение = ВыполнитьСТаймаутом(Проверка.ТекстДляВыполнения, ПараметрыКакСоответствие(ПараметрыЗапроса),
		Проверка.ИндексыПомещения);
	Если Не Выполнение.Успех Тогда
		Результат.Успех = Ложь;
		Результат.КодОшибки = Выполнение.КодОшибки;
		Если Выполнение.КодОшибки = "QUERY_TIMEOUT" Тогда
			Результат.Сообщение = СтрШаблон(НСтр("ru = 'Запрос не выполнился за %1 с и прерван. Сузьте период и отборы или используйте виртуальные таблицы с параметрами.'"),
				ТаймаутЗапросаСекунд());
		ИначеЕсли Выполнение.КодОшибки = "TEMP_TABLE_LIMIT" Тогда
			Результат.Сообщение = СтрШаблон(НСтр("ru = 'Во временную таблицу попало больше %1 строк. Сгруппируйте или отберите данные до помещения во временную таблицу.'"),
				МаксимумСтрокВременнойТаблицы());
		Иначе
			Результат.Сообщение = НСтр("ru = 'Ошибка выполнения запроса. Проверьте типы параметров, условия виртуальных таблиц и права.'");
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	ЗаполнитьРезультат(Результат, Выполнение.Таблица, МаксимумСтрок);
	Возврат Результат;

КонецФункции

// Выполняет проверенный текст запроса агента. Вызывается в фоновом задании из ВыполнитьЗапросАгента
// (сеанс того же пользователя, без привилегированного режима). Текст должен пройти ПроверитьЗапрос.
//
// Параметры:
//  ТекстЗапроса - Строка - ТекстДляВыполнения из ПроверитьЗапрос.
//  ПараметрыЗапроса - Соответствие
//  ИндексыПомещения - Массив из Число - см. ПроверитьЗапрос.
//  АдресРезультата - Строка - адрес временного хранилища для результата (см. ВыполнитьПакетЗапросов).
//
Процедура ВыполнитьПакетВФоне(ТекстЗапроса, ПараметрыЗапроса, ИндексыПомещения, АдресРезультата) Экспорт

	ПоместитьВоВременноеХранилище(ВыполнитьПакетЗапросов(ТекстЗапроса, ПараметрыЗапроса, ИндексыПомещения),
		АдресРезультата);

КонецПроцедуры

// Проверяет запрос без выполнения.
//
// Параметры:
//  ТекстЗапроса - Строка
//  ПараметрыЗапроса - Структура, Соответствие, Неопределено
//  МаксимумСтрок - Число
//  ДопустимыеСсылки - Массив из ЛюбаяСсылка - см. ВыполнитьЗапросАгента.
//  РазрешитьМаскируемыеПоля - Булево - см. ВыполнитьЗапросАгента.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * КодОшибки - Строка
//   * Сообщение - Строка
//   * НедостающиеПараметры - Массив из Строка - безопасные имена параметров, которым не передано значение.
//   * ЛишниеПараметры - Массив из Строка - безопасные имена переданных параметров, отсутствующих в тексте.
//   * ТекстДляВыполнения - Строка - текст с РАЗРЕШЕННЫЕ и ограничением числа записей.
//   * Класс - Число - класс данных результата (0..4): максимум по источникам и полям.
//   * ИндексыПомещения - Массив из Число - индексы запросов пакета, помещающих во временную таблицу.
//   * Таблицы - Массив из Строка - полные имена объектов метаданных, к таблицам которых обращается запрос
//       (без временных таблиц и подзапросов; объекты вне периметра запрос не пропускает).
//
Функция ПроверитьЗапрос(ТекстЗапроса, ПараметрыЗапроса = Неопределено, МаксимумСтрок = 200,
	ДопустимыеСсылки = Неопределено, РазрешитьМаскируемыеПоля = Ложь) Экспорт

	Проверка = Новый Структура("Успех, КодОшибки, Сообщение, ТекстДляВыполнения, Класс, ИндексыПомещения, Таблицы",
		Ложь, "", "", "", 0, Новый Массив, Новый Массив);
	Проверка.Вставить("НедостающиеПараметры", Новый Массив);
	Проверка.Вставить("ЛишниеПараметры", Новый Массив);

	Если ПараметрыЗапроса <> Неопределено И ТипЗнч(ПараметрыЗапроса) <> Тип("Соответствие")
		И ТипЗнч(ПараметрыЗапроса) <> Тип("Структура") Тогда
		Проверка.КодОшибки = "BAD_ARGUMENTS";
		Проверка.Сообщение = НСтр("ru = 'Параметры запроса должны быть объектом имя-значение.'");
		Возврат Проверка;
	КонецЕсли;
	Если Не ПараметрыПримитивны(ПараметрыЗапроса, ДопустимыеСсылки) Тогда
		Проверка.КодОшибки = "PARAMETER_NOT_PRIMITIVE";
		Проверка.Сообщение = НСтр("ru = 'Параметры запроса могут быть только строками, числами, датами, булевыми или массивами таких значений.'");
		Возврат Проверка;
	КонецЕсли;
	// Псевдоним в строковом литерале не превращается в ссылку и сравнивался бы с наименованием.
	Если ЕстьПсевдонимВЛитерале(ТекстЗапроса) Тогда
		Проверка.КодОшибки = "PSEUDONYM_AS_LITERAL";
		Проверка.Сообщение = НСтр("ru = 'Объект («Вид №N») в тексте запроса нельзя писать литералом: передай его параметром (ГДЕ Т.Контрагент = &Контрагент, parameters: {""Контрагент"": ""Контрагент №5""}).'");
		Возврат Проверка;
	КонецЕсли;

	Схема = Новый СхемаЗапроса;
	Попытка
		// ПРЕДСТАВЛЕНИЕ(Х) превратило бы ссылку в строку в обход маскирования: оставляем аргумент,
		// колонка остаётся ссылкой и маскируется по типу.
		Схема.УстановитьТекстЗапроса(УбратьФункцииПредставления(ТекстЗапроса));
	// Ошибка пользовательского запроса возвращается как QUERY_PARSE_ERROR.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Проверка.КодОшибки = "QUERY_PARSE_ERROR";
		Проверка.Сообщение = Лев(ИИА_Периметр.ОчиститьТекст(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())), 2000);
		Возврат Проверка;
	КонецПопытки;

	Контекст = НовыйКонтекстАнализа();
	Контекст.РазрешитьМаскируемыеПоля = РазрешитьМаскируемыеПоля = Истина;
	Попытка
		ОбойтиПакет(Схема, Контекст, МаксимумСтрок);
	Исключение
		Проверка.КодОшибки = "PERIMETER_VIOLATION";
		Проверка.Сообщение = НСтр("ru = 'Не удалось проверить структуру запроса.'");
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Проверка;
	КонецПопытки;

	Если ЗначениеЗаполнено(Контекст.Нарушение) Тогда
		Проверка.КодОшибки = Контекст.КодНарушения;
		Проверка.Сообщение = Контекст.Нарушение;
		Возврат Проверка;
	КонецЕсли;

	ТекстДляВыполнения = Схема.ПолучитьТекстЗапроса();
	ПроверитьЦепочкиТекста(ТекстДляВыполнения, Контекст);
	Если ЗначениеЗаполнено(Контекст.Нарушение) Тогда
		Проверка.КодОшибки = Контекст.КодНарушения;
		Проверка.Сообщение = Контекст.Нарушение;
		Возврат Проверка;
	КонецЕсли;

	Если Не ПроверитьИменаПараметров(ТекстДляВыполнения, ПараметрыЗапроса, Проверка) Тогда
		Возврат Проверка;
	КонецЕсли;

	Проверка.Успех = Истина;
	Проверка.ТекстДляВыполнения = ТекстДляВыполнения;
	Проверка.Класс = Контекст.Класс;
	Проверка.ИндексыПомещения = Контекст.ИндексыПомещения;
	Для Каждого Описание Из Контекст.ТаблицыИсточники Цикл
		Части = СтрРазделить(Описание.ИмяТаблицы, ".");
		ОбъектМетаданных = ?(Части.Количество() < 2, Неопределено, Метаданные.НайтиПоПолномуИмени(Части[0] + "." + Части[1]));
		Если ОбъектМетаданных <> Неопределено И Проверка.Таблицы.Найти(ОбъектМетаданных.ПолноеИмя()) = Неопределено Тогда
			Проверка.Таблицы.Добавить(ОбъектМетаданных.ПолноеИмя());
		КонецЕсли;
	КонецЦикла;
	Возврат Проверка;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Параметры

// Имена параметров извлекаются тем же лексером, что используется при проверке периметра:
// литералы и комментарии пропускаются; повторные вхождения и регистр букв не создают дублей.
Функция ПроверитьИменаПараметров(ТекстЗапроса, ПараметрыЗапроса, Проверка)

	Требуемые = Новый Соответствие;
	Для Каждого Цепочка Из ЦепочкиТекста(ТекстЗапроса) Цикл
		Если Цепочка.Параметр Тогда
			Имя = Цепочка.Сегменты[0];
			Требуемые.Вставить(ВРег(Имя), Имя);
		КонецЕсли;
	КонецЦикла;
	Переданные = Новый Соответствие;
	Для Каждого Параметр Из ПараметрыКакСоответствие(ПараметрыЗапроса) Цикл
		Если ТипЗнч(Параметр.Ключ) <> Тип("Строка") Тогда
			Проверка.КодОшибки = "BAD_ARGUMENTS";
			Проверка.Сообщение = НСтр("ru = 'Имена параметров должны быть строками.'");
			Возврат Ложь;
		КонецЕсли;
		Имя = ВРег(Параметр.Ключ);
		Если Переданные.Получить(Имя) <> Неопределено Тогда
			Проверка.КодОшибки = "DUPLICATE_QUERY_PARAMETER";
			Проверка.Сообщение = НСтр("ru = 'Параметр передан повторно с разным регистром букв.'");
			Возврат Ложь;
		КонецЕсли;
		Переданные.Вставить(Имя, Параметр.Ключ);
		Если Требуемые.Получить(Имя) = Неопределено Тогда
			Проверка.ЛишниеПараметры.Добавить(ИИА_Периметр.ОчиститьТекст(Лев(Параметр.Ключ, 100)));
		КонецЕсли;
	КонецЦикла;
	Для Каждого Требуемый Из Требуемые Цикл
		Если Переданные.Получить(Требуемый.Ключ) = Неопределено Тогда
			Проверка.НедостающиеПараметры.Добавить(ИИА_Периметр.ОчиститьТекст(Лев(Требуемый.Значение, 100)));
		КонецЕсли;
	КонецЦикла;
	Если Проверка.НедостающиеПараметры.Количество() = 0 И Проверка.ЛишниеПараметры.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Проверка.КодОшибки = "QUERY_PARAMETERS_MISMATCH";
	Проверка.Сообщение = СтрШаблон(НСтр("ru = 'Параметры запроса не совпадают с текстом. Не заданы: %1. Не используются: %2. Исправьте объект parameters.'"),
		СтрСоединить(Проверка.НедостающиеПараметры, ", "), СтрСоединить(Проверка.ЛишниеПараметры, ", "));
	Возврат Ложь;

КонецФункции

Функция ПараметрыКакСоответствие(ПараметрыЗапроса)

	Результат = Новый Соответствие;
	Если ПараметрыЗапроса = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого КлючИЗначение Из ПараметрыЗапроса Цикл
		Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПараметрыПримитивны(ПараметрыЗапроса, ДопустимыеСсылки = Неопределено)

	Для Каждого КлючИЗначение Из ПараметрыКакСоответствие(ПараметрыЗапроса) Цикл
		Значение = КлючИЗначение.Значение;
		Если ТипЗнч(Значение) = Тип("Массив") Тогда
			Для Каждого Элемент Из Значение Цикл
				Если Не ЭтоПримитив(Элемент)
					И (ДопустимыеСсылки = Неопределено Или ДопустимыеСсылки.Найти(Элемент) = Неопределено) Тогда
					Возврат Ложь;
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ДопустимыеСсылки <> Неопределено И ДопустимыеСсылки.Найти(Значение) <> Неопределено Тогда
			Продолжить;
		ИначеЕсли Не ЭтоПримитив(Значение) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ЭтоПримитив(Значение)

	ТипЗначения = ТипЗнч(Значение);
	Возврат Значение = Неопределено
		Или ТипЗначения = Тип("Строка")
		Или ТипЗначения = Тип("Число")
		Или ТипЗначения = Тип("Дата")
		Или ТипЗначения = Тип("Булево");

КонецФункции

#КонецОбласти

#Область Выполнение

// Тайм-аут одного запроса агента.
Функция ТаймаутЗапросаСекунд()

	Возврат 60;

КонецФункции

// Сколько строк может попасть в одну временную таблицу пакета.
Функция МаксимумСтрокВременнойТаблицы()

	Возврат 100000;

КонецФункции

// Выполняет пакет в отдельном фоновом задании и прерывает его по тайм-ауту (ИИА_ИзолированноеВыполнение).
// В файловой базе и в транзакции пакет выполняется в текущем сеансе без тайм-аута. Сообщения сеанса не читаются.
//
// Возвращаемое значение:
//  см. ВыполнитьПакетЗапросов.
//
Функция ВыполнитьСТаймаутом(ТекстЗапроса, ПараметрыЗапроса, ИндексыПомещения)

	ПараметрыМетода = Новый Массив;
	ПараметрыМетода.Добавить(ТекстЗапроса);
	ПараметрыМетода.Добавить(ПараметрыЗапроса);
	ПараметрыМетода.Добавить(ИндексыПомещения);
	Выполнение = ИИА_ИзолированноеВыполнение.ВыполнитьМетод("ИИА_ГраницаЗапроса.ВыполнитьПакетВФоне", ПараметрыМетода,
		ТаймаутЗапросаСекунд(), НСтр("ru = 'ИИ-ассистент: запрос агента'"), Ложь);
	Если Выполнение.Успех И ТипЗнч(Выполнение.Результат) = Тип("Структура") Тогда
		Возврат Выполнение.Результат;
	КонецЕсли;
	Ответ = НовыйОтветВыполнения();
	Ответ.КодОшибки = ?(Выполнение.КодОшибки = "TIMEOUT", "QUERY_TIMEOUT", "QUERY_EXECUTION_ERROR");
	Возврат Ответ;

КонецФункции

// Выполняет пакет и выгружает результат последнего запроса.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * КодОшибки - Строка - QUERY_EXECUTION_ERROR, TEMP_TABLE_LIMIT, QUERY_TIMEOUT.
//   * Таблица - ТаблицаЗначений, Неопределено - результат последнего запроса пакета.
//
Функция ВыполнитьПакетЗапросов(ТекстЗапроса, ПараметрыЗапроса, ИндексыПомещения)

	Ответ = НовыйОтветВыполнения();
	// Привилегированный режим отключил бы RLS: запрос агента выполняется только с правами пользователя.
	Если ПривилегированныйРежим() Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
			НСтр("ru = 'Запрос агента вызван в привилегированном режиме и не выполнен.'"));
		Ответ.КодОшибки = "QUERY_EXECUTION_ERROR";
		Возврат Ответ;
	КонецЕсли;

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Для Каждого КлючИЗначение Из ПараметрыЗапроса Цикл
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;

	Попытка
		Результаты = Запрос.ВыполнитьПакет();
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
			ИИА_Периметр.ОчиститьТекст(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		Ответ.КодОшибки = "QUERY_EXECUTION_ERROR";
		Возврат Ответ;
	КонецПопытки;

	// Результат запроса с ПОМЕСТИТЬ - одна строка с числом помещённых записей.
	Для Каждого Индекс Из ИндексыПомещения Цикл
		Если Индекс > Результаты.ВГраница() Или Результаты[Индекс] = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Помещено = Результаты[Индекс].Выгрузить();
		Если Помещено.Количество() > 0 И Помещено.Колонки.Количество() > 0
			И ТипЗнч(Помещено[0][0]) = Тип("Число") И Помещено[0][0] > МаксимумСтрокВременнойТаблицы() Тогда
			Ответ.КодОшибки = "TEMP_TABLE_LIMIT";
			Возврат Ответ;
		КонецЕсли;
	КонецЦикла;

	Ответ.Успех = Истина;
	Если Результаты.Количество() > 0 И Результаты[Результаты.ВГраница()] <> Неопределено Тогда
		Ответ.Таблица = Результаты[Результаты.ВГраница()].Выгрузить();
	КонецЕсли;
	Возврат Ответ;

КонецФункции

Функция НовыйОтветВыполнения()

	Возврат Новый Структура("Успех, КодОшибки, Таблица", Ложь, "", Неопределено);

КонецФункции

#КонецОбласти

#Область ОбходСхемы

Функция НовыйКонтекстАнализа()

	Контекст = Новый Структура;
	Контекст.Вставить("Псевдонимы", Новый Соответствие); // ВРег(псевдоним) -> Массив из Структура(Вид, ИмяТаблицы)
	Контекст.Вставить("ТаблицыИсточники", Новый Массив); // все табличные источники пакета
	Контекст.Вставить("ПсевдонимыКолонок", Новый Соответствие); // ВРег(псевдоним колонки) -> Истина
	Контекст.Вставить("ВременныеТаблицы", Новый Соответствие); // ВРег(имя) -> Истина
	Контекст.Вставить("ИндексыПомещения", Новый Массив); // индексы запросов пакета с ПОМЕСТИТЬ
	Контекст.Вставить("Нарушение", "");
	Контекст.Вставить("КодНарушения", "");
	Контекст.Вставить("Класс", 0); // максимальный класс данных источников и полей (ИИА_КлассыДанных)
	Контекст.Вставить("РазрешитьМаскируемыеПоля", Ложь); // реквизиты коммерческого маскирования (серверные запросы)
	Возврат Контекст;

КонецФункции

Процедура ОбойтиПакет(Схема, Контекст, МаксимумСтрок)

	ПакетЗапросов = Схема.ПакетЗапросов;
	ПоследнийИндекс = ПакетЗапросов.Количество() - 1;
	Для Индекс = 0 По ПоследнийИндекс Цикл
		ЗапросПакета = ПакетЗапросов[Индекс];
		Если ТипЗнч(ЗапросПакета) <> Тип("ЗапросВыбораСхемыЗапроса") Тогда
			Продолжить; // уничтожение временной таблицы
		КонецЕсли;
		ОбойтиЗапросВыбора(ЗапросПакета, Контекст);
		ЗапросПакета.ВыбиратьРазрешенные = Истина;
		Если ЗначениеЗаполнено(ЗапросПакета.ТаблицаДляПомещения) Тогда
			// Лимит + 1: превышение обнаруживается после выполнения и даёт отказ, а не молча усечённые данные.
			ОграничитьЧислоЗаписей(ЗапросПакета, МаксимумСтрокВременнойТаблицы());
			Контекст.ВременныеТаблицы.Вставить(ВРег(ЗапросПакета.ТаблицаДляПомещения), Истина);
			Контекст.ИндексыПомещения.Добавить(Индекс);
		Иначе
			ОграничитьЧислоЗаписей(ЗапросПакета, МаксимумСтрок);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОбойтиЗапросВыбора(ЗапросВыбора, Контекст)

	Для Каждого Колонка Из ЗапросВыбора.Колонки Цикл
		Контекст.ПсевдонимыКолонок.Вставить(ВРег(Колонка.Псевдоним), Истина);
	КонецЦикла;

	Для Каждого Оператор Из ЗапросВыбора.Операторы Цикл
		Для Каждого ИсточникОператора Из Оператор.Источники Цикл
			Источник = ИсточникОператора.Источник;
			ТипИсточника = ТипЗнч(Источник);
			Если ТипИсточника = Тип("ТаблицаСхемыЗапроса")
				И КлассМетаданных(СтрРазделить(Источник.ИмяТаблицы, ".")[0]) = ""
				И Контекст.ВременныеТаблицы.Получить(ВРег(Источник.ИмяТаблицы)) <> Неопределено Тогда
				// Временная таблица из предыдущего запроса пакета схема отдаёт как обычную таблицу.
				Описание = Новый Структура("Вид, ИмяТаблицы", "ВременнаяТаблица", Источник.ИмяТаблицы);
			ИначеЕсли ТипИсточника = Тип("ТаблицаСхемыЗапроса") Тогда
				ПроверитьИмяТаблицы(Источник.ИмяТаблицы, Контекст);
				Описание = Новый Структура("Вид, ИмяТаблицы", "Таблица", Источник.ИмяТаблицы);
				Контекст.ТаблицыИсточники.Добавить(Описание);
			ИначеЕсли ТипИсточника = Тип("ВложенныйЗапросСхемыЗапроса") Тогда
				ОбойтиЗапросВыбора(Источник.Запрос, Контекст);
				Описание = Новый Структура("Вид, ИмяТаблицы", "Вложенный", "");
			ИначеЕсли ТипИсточника = Тип("ОписаниеВременнойТаблицыСхемыЗапроса") Тогда
				Описание = Новый Структура("Вид, ИмяТаблицы", "ВременнаяТаблица", Источник.ИмяТаблицы);
			Иначе
				ЗафиксироватьНарушение(Контекст, "PERIMETER_VIOLATION",
					НСтр("ru = 'Неподдерживаемый вид источника запроса.'"));
				Возврат;
			КонецЕсли;
			ДобавитьПсевдоним(Контекст, Источник.Псевдоним, Описание);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПсевдоним(Контекст, Псевдоним, Описание)

	Ключ = ВРег(Псевдоним);
	Список = Контекст.Псевдонимы.Получить(Ключ);
	Если Список = Неопределено Тогда
		Список = Новый Массив;
		Контекст.Псевдонимы.Вставить(Ключ, Список);
	КонецЕсли;
	Список.Добавить(Описание);

КонецПроцедуры

Процедура ОграничитьЧислоЗаписей(ЗапросВыбора, МаксимумСтрок)

	Для Каждого Оператор Из ЗапросВыбора.Операторы Цикл
		Попытка
			Если Оператор.КоличествоПолучаемыхЗаписей = Неопределено
				Или Оператор.КоличествоПолучаемыхЗаписей = 0
				Или Оператор.КоличествоПолучаемыхЗаписей > МаксимумСтрок + 1 Тогда
				Оператор.КоличествоПолучаемыхЗаписей = МаксимумСтрок + 1;
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
				"QUERY_ROW_LIMIT_NOT_APPLIED");
			// Ограничение выборки - только оптимизация: строки всё равно читаются не больше МаксимумСтрок + 1.
			Возврат;
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ПроверкаТаблиц

// Проверяет имя таблицы источника или ссылку на объект метаданных в тексте запроса.
Процедура ПроверитьИмяТаблицы(ИмяТаблицы, Контекст)

	Части = СтрРазделить(ИмяТаблицы, ".");
	Класс = КлассМетаданных(Части[0]);
	Если Класс = "" Тогда
		Возврат; // не класс метаданных - проверяется как цепочка полей
	КонецЕсли;

	Если Класс = "КОНСТАНТЫ" Или Класс = "ВНЕШНИЙИСТОЧНИКДАННЫХ" Или Класс = "КРИТЕРИЙОТБОРА" Тогда
		ЗафиксироватьНарушение(Контекст, "PERIMETER_VIOLATION",
			СтрШаблон(НСтр("ru = 'Таблица %1 недоступна ассистенту.'"), ИмяТаблицы));
		Возврат;
	КонецЕсли;

	Если Части.Количество() < 2 Тогда
		ЗафиксироватьНарушение(Контекст, "UNRESOLVED_FIELD",
			СтрШаблон(НСтр("ru = 'Не удалось распознать таблицу %1.'"), ИмяТаблицы));
		Возврат;
	КонецЕсли;

	ПолноеИмя = Части[0] + "." + Части[1];
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Тогда
		ЗафиксироватьНарушение(Контекст, "UNRESOLVED_FIELD",
			СтрШаблон(НСтр("ru = 'Объект %1 не найден.'"), ПолноеИмя));
		Возврат;
	КонецЕсли;

	Причина = "";
	Если ИИА_Периметр.ОбъектЗапрещен(ОбъектМетаданных.ПолноеИмя(), Причина) Тогда
		ЗафиксироватьНарушение(Контекст, "PERIMETER_VIOLATION",
			СтрШаблон(НСтр("ru = 'Объект %1 вне периметра ассистента (%2).'"), ОбъектМетаданных.ПолноеИмя(), Причина));
		Возврат;
	КонецЕсли;

	Если Класс = "ЖУРНАЛДОКУМЕНТОВ" Тогда
		Для Каждого Документ Из ОбъектМетаданных.РегистрируемыеДокументы Цикл
			Если ИИА_Периметр.ОбъектЗапрещен(Документ.ПолноеИмя(), Причина) Тогда
				ЗафиксироватьНарушение(Контекст, "PERIMETER_VIOLATION",
					СтрШаблон(НСтр("ru = 'Журнал %1 содержит документы вне периметра (%2).'"),
						ОбъектМетаданных.ПолноеИмя(), Документ.ПолноеИмя()));
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Контекст.Класс = Макс(Контекст.Класс, ИИА_КлассыДанных.КлассОбъекта(ОбъектМетаданных.ПолноеИмя()));

	// Табличная часть как таблица источника: Документ.X.Товары
	Если Части.Количество() >= 3 И КлассСТабличнымиЧастями(Класс) Тогда
		ТабличныеЧасти = КоллекцияМетаданных(ОбъектМетаданных, "ТабличныеЧасти");
		Если ТабличныеЧасти <> Неопределено И ТабличныеЧасти.Найти(Части[2]) <> Неопределено Тогда
			Если ИИА_Периметр.ПолеЗапрещено(ОбъектМетаданных.ПолноеИмя(), Части[2], Причина) Тогда
				ЗафиксироватьНарушение(Контекст, "PERIMETER_VIOLATION",
					СтрШаблон(НСтр("ru = 'Табличная часть %1 вне периметра (%2).'"), ИмяТаблицы, Причина));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПроверкаЦепочекТекста

// Находит в тексте запроса все цепочки идентификаторов (А.Б.В) и проверяет каждую.
Процедура ПроверитьЦепочкиТекста(Текст, Контекст)

	Для Каждого Цепочка Из ЦепочкиТекста(Текст) Цикл
		Если ЗначениеЗаполнено(Контекст.Нарушение) Тогда
			Возврат;
		КонецЕсли;
		ПроверитьЦепочку(Цепочка, Контекст);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьЦепочку(Цепочка, Контекст)

	Сегменты = Цепочка.Сегменты;
	Если Цепочка.ПослеВыражения Тогда
		// Поле результата ВЫРАЗИТЬ(...) или скобок проверить по источнику нельзя: иначе обход периметра
		// и MASKED_FIELD («ВЫРАЗИТЬ(Д.Владелец КАК Справочник.Контрагенты).Наименование»).
		ЗафиксироватьНарушение(Контекст, "UNRESOLVED_FIELD",
			СтрШаблон(НСтр("ru = 'Разыменование результата выражения или поле через отделённую точку не поддерживается: .%1. Выберите поле через псевдоним таблицы без пробелов вокруг точки.'"),
				СтрСоединить(Сегменты, ".")));
		Возврат;
	КонецЕсли;
	Если Цепочка.Параметр Тогда
		Если Сегменты.Количество() > 1 Тогда
			ЗафиксироватьНарушение(Контекст, "PARAMETER_DEREFERENCE",
				НСтр("ru = 'Разыменование параметров запрещено.'"));
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Первый = ВРег(Сегменты[0]);

	// Ссылка на объект метаданных: таблица, ЗНАЧЕНИЕ(...), ТИП(...), ССЫЛКА ...
	Если КлассМетаданных(Сегменты[0]) <> "" Тогда
		ПроверитьИмяТаблицы(СтрСоединить(Сегменты, "."), Контекст);
		Возврат;
	КонецЕсли;

	Если Сегменты.Количество() = 1 Тогда
		Если КлючевыеСлова().Получить(Первый) <> Неопределено
			Или Цепочка.ВызовФункции
			Или Контекст.Псевдонимы.Получить(Первый) <> Неопределено
			Или Контекст.ПсевдонимыКолонок.Получить(Первый) <> Неопределено
			Или Контекст.ВременныеТаблицы.Получить(Первый) <> Неопределено Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ОписанияИсточника = Контекст.Псевдонимы.Получить(Первый);
	Если ОписанияИсточника <> Неопределено Тогда
		ПутьПоля = Новый Массив;
		Для Индекс = 1 По Сегменты.ВГраница() Цикл
			ПутьПоля.Добавить(Сегменты[Индекс]);
		КонецЦикла;
		Если ПутьПоля.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		ПроверитьПутьПоИсточникам(ОписанияИсточника, ПутьПоля, Цепочка, Контекст);
		Возврат;
	КонецЕсли;

	// Поле без псевдонима: проверяем по всем табличным источникам пакета.
	ПроверитьПутьПоИсточникам(Контекст.ТаблицыИсточники, Сегменты, Цепочка, Контекст, Истина);

КонецПроцедуры

Процедура ПроверитьПутьПоИсточникам(Описания, ПутьПоля, Цепочка, Контекст, БезПсевдонима = Ложь)

	Разрешено = Ложь;
	Для Каждого Описание Из Описания Цикл
		Если Описание.Вид <> "Таблица" Тогда
			// Колонки временных таблиц и вложенных запросов проверены в исходном запросе;
			// разыменование их колонок не поддерживается.
			Если ПутьПоля.Количество() > 1 Тогда
				ЗафиксироватьНарушение(Контекст, "UNRESOLVED_FIELD",
					СтрШаблон(НСтр("ru = 'Разыменование колонок временных таблиц и вложенных запросов не поддерживается: %1. Разыменуйте поле в исходном запросе.'"),
						СтрСоединить(Цепочка.Сегменты, ".")));
				Возврат;
			КонецЕсли;
			Разрешено = Истина;
			Продолжить;
		КонецЕсли;

		Итог = ПроверитьПутьВТаблице(Описание.ИмяТаблицы, ПутьПоля, Контекст.РазрешитьМаскируемыеПоля);
		Контекст.Класс = Макс(Контекст.Класс, Итог.Класс);
		Если Итог.Запрещено И Итог.Код = "MASKED_FIELD" Тогда
			ЗафиксироватьНарушение(Контекст, "MASKED_FIELD",
				СтрШаблон(НСтр("ru = 'Поле %1 скрыто от модели (%2).'"), СтрСоединить(Цепочка.Сегменты, "."), Итог.Причина));
			Возврат;
		ИначеЕсли Итог.Запрещено Тогда
			ЗафиксироватьНарушение(Контекст, "PERIMETER_VIOLATION",
				СтрШаблон(НСтр("ru = 'Поле %1 вне периметра ассистента (%2).'"),
					СтрСоединить(Цепочка.Сегменты, "."), Итог.Причина));
			Возврат;
		КонецЕсли;
		Если Итог.Найдено Тогда
			Разрешено = Истина;
		КонецЕсли;
	КонецЦикла;

	Если Не Разрешено Тогда
		ЗафиксироватьНарушение(Контекст, "UNRESOLVED_FIELD",
			СтрШаблон(НСтр("ru = 'Граница данных не смогла разобрать поле %1. Укажите поле через псевдоним таблицы.'"),
				СтрСоединить(Цепочка.Сегменты, ".")));
	КонецЕсли;

КонецПроцедуры

// Разбирает путь поля в таблице источника с разыменованиями.
//
// Возвращаемое значение:
//  Структура:
//   * Найдено - Булево
//   * Запрещено - Булево
//   * Причина - Строка
//   * Код - Строка - MASKED_FIELD для реквизита коммерческого маскирования, иначе пусто.
//
Функция ПроверитьПутьВТаблице(ИмяТаблицы, ПутьПоля, РазрешитьМаскируемыеПоля = Ложь)

	Итог = НовыйИтогПути(РазрешитьМаскируемыеПоля);

	Части = СтрРазделить(ИмяТаблицы, ".");
	Если Части.Количество() < 2 Тогда
		Возврат Итог;
	КонецЕсли;
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Части[0] + "." + Части[1]);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Итог;
	КонецЕсли;

	Контекст = Новый Структура("Объект, ТабличнаяЧасть, ВиртуальнаяТаблица", ОбъектМетаданных, Неопределено, "");
	Если Части.Количество() >= 3 Тогда
		ТабличныеЧасти = КоллекцияМетаданных(ОбъектМетаданных, "ТабличныеЧасти");
		Если ТабличныеЧасти <> Неопределено И ТабличныеЧасти.Найти(Части[2]) <> Неопределено Тогда
			Контекст.ТабличнаяЧасть = ТабличныеЧасти.Найти(Части[2]);
		Иначе
			Контекст.ВиртуальнаяТаблица = Части[2];
		КонецЕсли;
	КонецЕсли;

	ПроверитьСегменты(Контекст, ПутьПоля, 0, Итог);
	Возврат Итог;

КонецФункции

Процедура ПроверитьСегменты(Контекст, ПутьПоля, Индекс, Итог)

	ИмяПоля = ПутьПоля[Индекс];
	ПолноеИмяОбъекта = Контекст.Объект.ПолноеИмя();

	Причина = "";
	Если ИИА_Периметр.ОбъектЗапрещен(ПолноеИмяОбъекта, Причина) Тогда
		Итог.Запрещено = Истина;
		Итог.Причина = СтрШаблон("%1: %2", ПолноеИмяОбъекта, Причина);
		Возврат;
	КонецЕсли;

	Поле = НайтиПоле(Контекст, ИмяПоля);
	Если Поле = Неопределено Тогда
		Возврат; // не найдено в этом источнике
	КонецЕсли;

	ПутьДляПроверки = ?(Контекст.ТабличнаяЧасть = Неопределено, Поле.Имя, Контекст.ТабличнаяЧасть.Имя + "." + Поле.Имя);
	Если ИИА_Периметр.ПолеЗапрещено(ПолноеИмяОбъекта, ПутьДляПроверки, Причина) Тогда
		Итог.Запрещено = Истина;
		Итог.Причина = СтрШаблон("%1.%2: %3", ПолноеИмяОбъекта, ПутьДляПроверки, Причина);
		Возврат;
	КонецЕсли;
	Если Не Итог.РазрешитьМаскируемые И ИИА_Маскирование.ПолеМаскируется(ПолноеИмяОбъекта, ПутьДляПроверки, Причина) Тогда
		Итог.Запрещено = Истина;
		Итог.Код = "MASKED_FIELD";
		Итог.Причина = СтрШаблон("%1.%2: %3", ПолноеИмяОбъекта, ПутьДляПроверки, Причина);
		Возврат;
	КонецЕсли;
	Итог.Класс = Макс(Итог.Класс, ИИА_КлассыДанных.КлассОбъекта(ПолноеИмяОбъекта, ПутьДляПроверки));

	// Обращение к табличной части через точку: Р.Товары.Номенклатура
	Если Поле.Вид = "ТабличнаяЧасть" Тогда
		Если Индекс = ПутьПоля.ВГраница() Тогда
			Итог.Найдено = Истина;
			Возврат;
		КонецЕсли;
		КонтекстТЧ = Новый Структура("Объект, ТабличнаяЧасть, ВиртуальнаяТаблица", Контекст.Объект, Поле.Метаданные, "");
		ПроверитьСегменты(КонтекстТЧ, ПутьПоля, Индекс + 1, Итог);
		Возврат;
	КонецЕсли;

	Если Индекс = ПутьПоля.ВГраница() Тогда
		Итог.Найдено = Истина;
		Возврат;
	КонецЕсли;

	// Разыменование: следующий сегмент разрешаем по каждому ссылочному типу поля.
	СледующийСегмент = ВРег(ПутьПоля[Индекс + 1]);
	Если СледующийСегмент = "ПРЕДСТАВЛЕНИЕ" И ЕстьМаскируемыйТип(Поле) Тогда
		Итог.Запрещено = Истина;
		Итог.Причина = НСтр("ru = 'представление маскируемого объекта (персональные данные): выбирай саму ссылку'");
		Возврат;
	КонецЕсли;
	Если СледующийСегмент = "ПРЕДСТАВЛЕНИЕ" И Не Итог.РазрешитьМаскируемые И ЕстьКоммерческийТип(Поле) Тогда
		Итог.Запрещено = Истина;
		Итог.Код = "MASKED_FIELD";
		Итог.Причина = НСтр("ru = 'представление объекта скрыто от модели: выбирай саму ссылку'");
		Возврат;
	КонецЕсли;
	Если СледующийСегмент = "ПРЕДСТАВЛЕНИЕ" Или СледующийСегмент = "ССЫЛКА" Тогда
		ПроверитьТипыПоля(Поле, Итог);
		Если Не Итог.Запрещено Тогда
			Итог.Найдено = Истина;
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если Поле.Тип = Неопределено Тогда
		Возврат; // составной тип неизвестного состава - разыменование не проверить
	КонецЕсли;

	НайденоХотяБыОдно = Ложь;
	Для Каждого ТипПоля Из Поле.Тип.Типы() Цикл
		ОбъектТипа = Метаданные.НайтиПоТипу(ТипПоля);
		Если ОбъектТипа = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ИтогТипа = НовыйИтогПути(Итог.РазрешитьМаскируемые);
		КонтекстТипа = Новый Структура("Объект, ТабличнаяЧасть, ВиртуальнаяТаблица", ОбъектТипа, Неопределено, "");
		ПроверитьСегменты(КонтекстТипа, ПутьПоля, Индекс + 1, ИтогТипа);
		Если ИтогТипа.Запрещено Тогда
			ЗаполнитьЗначенияСвойств(Итог, ИтогТипа);
			Возврат;
		КонецЕсли;
		Итог.Класс = Макс(Итог.Класс, ИтогТипа.Класс);
		Если ИтогТипа.Найдено Тогда
			НайденоХотяБыОдно = Истина;
		КонецЕсли;
	КонецЦикла;
	Итог.Найдено = НайденоХотяБыОдно;

КонецПроцедуры

Функция НовыйИтогПути(РазрешитьМаскируемые)

	Возврат Новый Структура("Найдено, Запрещено, Причина, Класс, Код, РазрешитьМаскируемые", Ложь, Ложь, "", 0, "",
		РазрешитьМаскируемые = Истина);

КонецФункции

Функция ЕстьКоммерческийТип(Поле)

	Если Поле.Тип = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого ТипПоля Из Поле.Тип.Типы() Цикл
		Если ИИА_Маскирование.ЭтоКоммерческийТип(ТипПоля) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Есть ли псевдоним объекта в строковых литералах текста запроса (кавычки "" внутри литерала - экранирование).
Функция ЕстьПсевдонимВЛитерале(ТекстЗапроса)

	Если ТипЗнч(ТекстЗапроса) <> Тип("Строка") Или СтрНайти(ТекстЗапроса, "_") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Длина = СтрДлина(ТекстЗапроса);
	Позиция = 1;
	Пока Позиция <= Длина Цикл
		Символ = Сред(ТекстЗапроса, Позиция, 1);
		Если Символ = "/" И Сред(ТекстЗапроса, Позиция + 1, 1) = "/" Тогда
			Конец = СтрНайти(ТекстЗапроса, Символы.ПС, НаправлениеПоиска.СНачала, Позиция);
			Позиция = ?(Конец = 0, Длина + 1, Конец + 1);
			Продолжить;
		КонецЕсли;
		Если Символ <> """" Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;
		Конец = Позиция + 1;
		Пока Конец <= Длина Цикл
			Если Сред(ТекстЗапроса, Конец, 1) = """" Тогда
				Если Сред(ТекстЗапроса, Конец + 1, 1) = """" Тогда
					Конец = Конец + 2;
					Продолжить;
				КонецЕсли;
				Прервать;
			КонецЕсли;
			Конец = Конец + 1;
		КонецЦикла;
		Если ИИА_Маскирование.ЕстьПсевдоним(Сред(ТекстЗапроса, Позиция + 1, Конец - Позиция - 1)) Тогда
			Возврат Истина;
		КонецЕсли;
		Позиция = Конец + 1;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЕстьМаскируемыйТип(Поле)

	Если Поле.Тип = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого ТипПоля Из Поле.Тип.Типы() Цикл
		Если ИИА_Периметр.ЭтоМаскируемыйТип(ТипПоля) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Процедура ПроверитьТипыПоля(Поле, Итог)

	Если Поле.Тип = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Причина = "";
	ВсеЗапрещены = Поле.Тип.Типы().Количество() > 0;
	Для Каждого ТипПоля Из Поле.Тип.Типы() Цикл
		Если Не ИИА_Периметр.ТипЗапрещен(ТипПоля, Причина) Тогда
			ВсеЗапрещены = Ложь;
		КонецЕсли;
	КонецЦикла;
	Если ВсеЗапрещены Тогда
		Итог.Запрещено = Истина;
		Итог.Причина = Причина;
	КонецЕсли;

КонецПроцедуры

// Ищет поле в контексте (объект, табличная часть или виртуальная таблица регистра).
//
// Возвращаемое значение:
//  Структура, Неопределено:
//   * Имя - Строка - имя поля в метаданных (для ресурсов виртуальной таблицы - имя ресурса).
//   * Вид - Строка - "Поле" или "ТабличнаяЧасть".
//   * Тип - ОписаниеТипов, Неопределено
//   * Метаданные - ОбъектМетаданных, Неопределено
//
Функция НайтиПоле(Контекст, Знач ИмяПоля)

	Если Контекст.ТабличнаяЧасть <> Неопределено Тогда
		Если ВРег(ИмяПоля) = "ССЫЛКА" Тогда
			Возврат ОписаниеПоля(ИмяПоля, ТипСсылки(Контекст.Объект));
		ИначеЕсли ВРег(ИмяПоля) = "НОМЕРСТРОКИ" Тогда
			Возврат ОписаниеПоля(ИмяПоля, Новый ОписаниеТипов("Число"));
		КонецЕсли;
		Реквизит = Контекст.ТабличнаяЧасть.Реквизиты.Найти(ИмяПоля);
		Если Реквизит = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ОписаниеПоля(Реквизит.Имя, Реквизит.Тип);
	КонецЕсли;

	ОбъектМетаданных = Контекст.Объект;
	Для Каждого ИмяКоллекции Из СтрРазделить("Реквизиты,Измерения,Ресурсы", ",") Цикл
		Коллекция = КоллекцияМетаданных(ОбъектМетаданных, ИмяКоллекции);
		Если Коллекция = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Найденное = Коллекция.Найти(ИмяПоля);
		Если Найденное = Неопределено И ЗначениеЗаполнено(Контекст.ВиртуальнаяТаблица) И ИмяКоллекции = "Ресурсы" Тогда
			Найденное = Коллекция.Найти(ИмяРесурсаБезСуффикса(ИмяПоля));
		КонецЕсли;
		Если Найденное <> Неопределено Тогда
			Возврат ОписаниеПоля(Найденное.Имя, Найденное.Тип);
		КонецЕсли;
	КонецЦикла;

	ТабличныеЧасти = КоллекцияМетаданных(ОбъектМетаданных, "ТабличныеЧасти");
	Если ТабличныеЧасти <> Неопределено И ТабличныеЧасти.Найти(ИмяПоля) <> Неопределено Тогда
		ТабличнаяЧасть = ТабличныеЧасти.Найти(ИмяПоля);
		Описание = ОписаниеПоля(ТабличнаяЧасть.Имя, Неопределено);
		Описание.Вид = "ТабличнаяЧасть";
		Описание.Метаданные = ТабличнаяЧасть;
		Возврат Описание;
	КонецЕсли;

	Возврат СтандартноеПоле(ОбъектМетаданных, ИмяПоля);

КонецФункции

Функция ОписаниеПоля(Имя, Тип)

	Возврат Новый Структура("Имя, Вид, Тип, Метаданные", Имя, "Поле", Тип, Неопределено);

КонецФункции

Функция СтандартноеПоле(ОбъектМетаданных, ИмяПоля)

	Имя = ВРег(ИмяПоля);
	Если Имя = "ССЫЛКА" Или Имя = "РОДИТЕЛЬ" Тогда
		Возврат ОписаниеПоля(ИмяПоля, ТипСсылки(ОбъектМетаданных));
	ИначеЕсли Имя = "ВЛАДЕЛЕЦ" Тогда
		Владельцы = КоллекцияМетаданных(ОбъектМетаданных, "Владельцы");
		Если Владельцы = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Типы = Новый Массив;
		Для Каждого Владелец Из Владельцы Цикл
			ТипВладельца = ТипСсылки(Владелец);
			Если ТипВладельца <> Неопределено Тогда
				Типы.Добавить(ТипВладельца.Типы()[0]);
			КонецЕсли;
		КонецЦикла;
		Возврат ОписаниеПоля(ИмяПоля, Новый ОписаниеТипов(Типы));
	ИначеЕсли Имя = "РЕГИСТРАТОР" Или Имя = "ОБЪЕКТ" Тогда
		Возврат ОписаниеПоля(ИмяПоля, Неопределено); // составной тип: значения фильтруются на выходе
	ИначеЕсли СтандартныеПримитивныеПоля().Получить(Имя) <> Неопределено Тогда
		Возврат ОписаниеПоля(ИмяПоля, Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ТипСсылки(ОбъектМетаданных)

	Если Не ОбщегоНазначения.ЭтоОбъектСсылочногоТипа(ОбъектМетаданных)
		И Не Метаданные.Перечисления.Содержит(ОбъектМетаданных) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Пустая = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ОбъектМетаданных.ПолноеИмя()).ПустаяСсылка();
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
			"REFERENCE_TYPE_RESOLUTION_FAILED");
		ВызватьИсключение НСтр("ru = 'Не удалось проверить ссылочный тип поля запроса.'");
	КонецПопытки;
	Типы = Новый Массив;
	Типы.Добавить(ТипЗнч(Пустая));
	Возврат Новый ОписаниеТипов(Типы);

КонецФункции

Функция СтандартныеПримитивныеПоля()

	Поля = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить("КОД,НАИМЕНОВАНИЕ,НОМЕР,ДАТА,ПОМЕТКАУДАЛЕНИЯ,ПРОВЕДЕН,ПРЕДОПРЕДЕЛЕННЫЙ,"
		+ "ИМЯПРЕДОПРЕДЕЛЕННЫХДАННЫХ,ЭТОГРУППА,ПЕРИОД,НОМЕРСТРОКИ,АКТИВНОСТЬ,ВИДДВИЖЕНИЯ,ПРЕДСТАВЛЕНИЕ,"
		+ "ПЕРИОДСЕКУНДА,ПЕРИОДМИНУТА,ПЕРИОДЧАС,ПЕРИОДДЕНЬ,ПЕРИОДНЕДЕЛЯ,ПЕРИОДДЕКАДА,ПЕРИОДМЕСЯЦ,"
		+ "ПЕРИОДКВАРТАЛ,ПЕРИОДПОЛУГОДИЕ,ПЕРИОДГОД,ПОРЯДОК,ТИПЗНАЧЕНИЯ,ВИДСЧЕТА,ЗАБАЛАНСОВЫЙ", ",") Цикл
		Поля.Вставить(Имя, Истина);
	КонецЦикла;
	Возврат Поля;

