#Область Лексер

// Разбирает текст запроса на цепочки идентификаторов, пропуская строковые литералы и комментарии.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Сегменты - Массив из Строка
//   * Параметр - Булево - цепочка начинается с "&".
//   * ВызовФункции - Булево - за цепочкой следует "(".
//   * ПослеВыражения - Булево - перед цепочкой значимая точка: разыменование результата выражения
//       («ВЫРАЗИТЬ(...).Поле») или точка, отделённая пробелом, переводом строки или комментарием.
//
Функция ЦепочкиТекста(Текст)

	Цепочки = Новый Массив;
	Длина = СтрДлина(Текст);
	Позиция = 1;
	Пробельные = " " + Символы.Таб + Символы.ПС + Символы.ВК;
	ПоследнийЗначимый = ""; // последний значимый символ вне литералов и комментариев
	Пока Позиция <= Длина Цикл
		Символ = Сред(Текст, Позиция, 1);

		Если Символ = """" Тогда
			ПоследнийЗначимый = """";
			// Строковый литерал; "" внутри - экранированная кавычка.
			Позиция = Позиция + 1;
			Пока Позиция <= Длина Цикл
				Если Сред(Текст, Позиция, 1) = """" Тогда
					Если Сред(Текст, Позиция + 1, 1) = """" Тогда
						Позиция = Позиция + 2;
						Продолжить;
					КонецЕсли;
					Прервать;
				КонецЕсли;
				Позиция = Позиция + 1;
			КонецЦикла;
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		Если Символ = "/" И Сред(Текст, Позиция + 1, 1) = "/" Тогда
			Пока Позиция <= Длина И Сред(Текст, Позиция, 1) <> Символы.ПС Цикл
				Позиция = Позиция + 1;
			КонецЦикла;
			Продолжить;
		КонецЕсли;

		ЭтоПараметр = (Символ = "&");
		Если ЭтоПараметр Тогда
			Позиция = Позиция + 1;
			Символ = Сред(Текст, Позиция, 1);
		КонецЕсли;

		Если Не ЭтоНачалоИдентификатора(Символ) Тогда
			Если ЭтоЦифра(Символ) Тогда
				Пока Позиция <= Длина И (ЭтоЦифра(Сред(Текст, Позиция, 1)) Или Сред(Текст, Позиция, 1) = ".") Цикл
					Позиция = Позиция + 1;
				КонецЦикла;
				ПоследнийЗначимый = "0";
			Иначе
				Если СтрНайти(Пробельные, Символ) = 0 Тогда
					ПоследнийЗначимый = Символ;
				КонецЕсли;
				Позиция = Позиция + 1;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		// Перед цепочкой значимая точка (через пробелы, переводы строк, комментарии): «ВЫРАЗИТЬ(...).Поле»,
		// «(...) // x <ПС> .Поле», «Т.Поле .Реквизит» - источник поля не определить. Точки в числах сюда не попадают.
		ПослеВыражения = Не ЭтоПараметр И ПоследнийЗначимый = ".";
		Сегменты = Новый Массив;
		Пока Истина Цикл
			Начало = Позиция;
			Пока Позиция <= Длина И ЭтоСимволИдентификатора(Сред(Текст, Позиция, 1)) Цикл
				Позиция = Позиция + 1;
			КонецЦикла;
			Сегменты.Добавить(Сред(Текст, Начало, Позиция - Начало));
			Если Сред(Текст, Позиция, 1) = "." И ЭтоНачалоИдентификатора(Сред(Текст, Позиция + 1, 1)) Тогда
				Позиция = Позиция + 1;
				Продолжить;
			КонецЕсли;
			Прервать;
		КонецЦикла;

		Следующий = Позиция;
		Пока Следующий <= Длина И СтрНайти(" " + Символы.Таб + Символы.ПС + Символы.ВК, Сред(Текст, Следующий, 1)) > 0 Цикл
			Следующий = Следующий + 1;
		КонецЦикла;

		Цепочка = Новый Структура("Сегменты, Параметр, ВызовФункции, ПослеВыражения", Сегменты, ЭтоПараметр,
			Сред(Текст, Следующий, 1) = "(", ПослеВыражения);
		Цепочки.Добавить(Цепочка);
		ПоследнийЗначимый = "_";
	КонецЦикла;

	Возврат Цепочки;

КонецФункции

// Убирает имена функций ПРЕДСТАВЛЕНИЕ, ПРЕДСТАВЛЕНИЕССЫЛКИ (и английские) перед скобкой, оставляя аргумент
// в скобках. Строковые литералы и комментарии не меняются; поле «.Представление» и псевдонимы не затрагиваются.
//
// Параметры:
//  Текст - Строка - текст запроса.
//
// Возвращаемое значение:
//  Строка
//
Функция УбратьФункцииПредставления(Знач Текст) Экспорт

	Имена = СтрРазделить("ПРЕДСТАВЛЕНИЕССЫЛКИ,ПРЕДСТАВЛЕНИЕ,REFPRESENTATION,PRESENTATION", ",");
	Части = Новый Массив;
	Длина = СтрДлина(Текст);
	Позиция = 1;
	Пока Позиция <= Длина Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = """" Тогда
			Конец = Позиция + 1;
			Пока Конец <= Длина Цикл
				Если Сред(Текст, Конец, 1) = """" Тогда
					Если Сред(Текст, Конец + 1, 1) = """" Тогда
						Конец = Конец + 2;
						Продолжить;
					КонецЕсли;
					Прервать;
				КонецЕсли;
				Конец = Конец + 1;
			КонецЦикла;
			Части.Добавить(Сред(Текст, Позиция, Конец - Позиция + 1));
			Позиция = Конец + 1;
		ИначеЕсли Символ = "/" И Сред(Текст, Позиция + 1, 1) = "/" Тогда
			Конец = СтрНайти(Текст, Символы.ПС, НаправлениеПоиска.СНачала, Позиция);
			Конец = ?(Конец = 0, Длина, Конец);
			Части.Добавить(Сред(Текст, Позиция, Конец - Позиция + 1));
			Позиция = Конец + 1;
		ИначеЕсли ЭтоНачалоИдентификатора(Символ) Тогда
			Конец = Позиция;
			Пока Конец < Длина И ЭтоСимволИдентификатора(Сред(Текст, Конец + 1, 1)) Цикл
				Конец = Конец + 1;
			КонецЦикла;
			Слово = Сред(Текст, Позиция, Конец - Позиция + 1);
			Предыдущий = ?(Позиция = 1, "", Сред(Текст, Позиция - 1, 1));
			Следующий = Конец + 1;
			Пока Следующий <= Длина И ПустаяСтрока(Сред(Текст, Следующий, 1)) Цикл
				Следующий = Следующий + 1;
			КонецЦикла;
			ЭтоФункция = Предыдущий <> "." И Имена.Найти(ВРег(Слово)) <> Неопределено И Сред(Текст, Следующий, 1) = "(";
			Если Не ЭтоФункция Тогда
				Части.Добавить(Слово);
			КонецЕсли;
			Позиция = Конец + 1;
		Иначе
			Части.Добавить(Символ);
			Позиция = Позиция + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части);

КонецФункции

Функция ЭтоЦифра(Символ)
	Возврат Символ <> "" И СтрНайти("0123456789", Символ) > 0;
КонецФункции

Функция ЭтоНачалоИдентификатора(Символ)
	Возврат Символ <> "" И (Символ = "_" Или ВРег(Символ) <> НРег(Символ));
КонецФункции

Функция ЭтоСимволИдентификатора(Символ)
	Возврат ЭтоНачалоИдентификатора(Символ) Или ЭтоЦифра(Символ);
КонецФункции

Функция КлассМетаданных(Имя)

	Классы = КлассыМетаданных();
	Найдено = Классы.Получить(ВРег(Имя));
	Возврат ?(Найдено = Неопределено, "", Найдено);

КонецФункции

