#КонецОбласти

#Область ПомощьМодели

// Устанавливает текст запроса в схему; не принятый платформой текст пробует исправить механически.
// При неудаче заполняет КодОшибки и Сообщение проверки.
//
// Возвращаемое значение:
//  Булево - Истина, если схема приняла текст (исходный или исправленный).
//
Функция РазобратьТекстЗапроса(Схема, ТекстЗапроса, Проверка)

	// ПРЕДСТАВЛЕНИЕ(Х) превратило бы ссылку в строку в обход маскирования: оставляем аргумент,
	// колонка остаётся ссылкой и маскируется по типу.
	ТекстРазбора = УбратьФункцииПредставления(ТекстЗапроса);
	ОшибкаРазбора = ОшибкаУстановкиТекста(Схема, ТекстРазбора);
	Если ПустаяСтрока(ОшибкаРазбора) Тогда
		Возврат Истина;
	КонецЕсли;

	// Механические ошибки исправляются до отказа: исправленный текст проходит тот же разбор
	// и те же проверки периметра, что и исходный. Принятый платформой текст не меняется никогда.
	Исправления = Новый Массив;
	ИсправленныйТекст = ИсправитьМеханическиеОшибки(ТекстРазбора, Исправления);
	Если Исправления.Количество() > 0 Тогда
		Схема = Новый СхемаЗапроса;
		ТекстРазбора = ИсправленныйТекст;
		ОшибкаРазбора = ОшибкаУстановкиТекста(Схема, ТекстРазбора);
		Проверка.Исправления = Исправления;
	КонецЕсли;
	Если ПустаяСтрока(ОшибкаРазбора) Тогда
		Возврат Истина;
	КонецЕсли;
	Проверка.КодОшибки = "QUERY_PARSE_ERROR";
	Проверка.Сообщение = СообщениеОшибкиРазбора(ОшибкаРазбора, ТекстРазбора, Проверка.Исправления);
	Возврат Ложь;

КонецФункции

// Возвращает краткий текст ошибки разбора; пустая строка - платформа приняла текст.
Функция ОшибкаУстановкиТекста(Схема, Текст)

	Попытка
		Схема.УстановитьТекстЗапроса(Текст);
	// Ошибка пользовательского запроса возвращается модели текстом.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		ПределОшибки = 2000;
		Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Ошибка = ИИА_Периметр.ОчиститьТекст(Ошибка);
		Ошибка = Лев(Ошибка, ПределОшибки);
		Возврат ?(ПустаяСтрока(Ошибка), "QUERY_PARSE_ERROR", Ошибка);
	КонецПопытки;
	Возврат "";

КонецФункции

// Текст ошибки разбора для модели: диагностика платформы, сведения из метаданных и замены,
// уже сделанные в тексте до разбора.
Функция СообщениеОшибкиРазбора(ОшибкаРазбора, ТекстЗапроса, Исправления)

	Части = Новый Массив;
	Части.Добавить(ОшибкаРазбора);
	Подсказка = ПодсказкаКОшибкеРазбора(ОшибкаРазбора, ТекстЗапроса);
	Если Не ПустаяСтрока(Подсказка) Тогда
		Части.Добавить(Подсказка);
	КонецЕсли;
	Если Исправления.Количество() > 0 Тогда
		Шаблон = НСтр("ru = 'Ошибка показана по тексту после автоматических замен: %1.'");
		СписокЗамен = СтрСоединить(Исправления, "; ");
		Части.Добавить(СтрШаблон(Шаблон, СписокЗамен));
	КонецЕсли;
	ПределСообщения = 3000;
	Возврат Лев(СтрСоединить(Части, Символы.ПС), ПределСообщения);

КонецФункции

Функция ПодсказкаКОшибкеРазбора(ОшибкаРазбора, ТекстЗапроса)

	Если СтрНайти(ОшибкаРазбора, "вложенным таблицам") > 0 Или СтрНайти(ОшибкаРазбора, "nested tables") > 0 Тогда
		Возврат НСтр("ru = 'Поля табличной части (Т.Товары.Поле) нельзя смешивать с полями шапки в условиях и агрегатах:'")
			+ " " + НСтр("ru = 'выбирай из таблицы табличной части (ИЗ Документ.Х.Товары КАК Т), поля шапки бери через Т.Ссылка.'");
	КонецЕсли;
	ПутьПоля = ПутьНенайденногоПоля(ОшибкаРазбора);
	Если ПустаяСтрока(ПутьПоля) Тогда
		Возврат "";
	КонецЕсли;
	Возврат ПодсказкаПоПолюТекста(ТекстЗапроса, СтрРазделить(ПутьПоля, ".", Ложь));

КонецФункции

// Путь поля из диагностики платформы «Поле не найдено "Т.Поле"»; пустая строка - ошибка другого вида.
Функция ПутьНенайденногоПоля(ОшибкаРазбора)

	Начало = 0;
	Для Каждого Маркер Из СтрРазделить("Поле не найдено,Field not found", ",") Цикл
		Позиция = СтрНайти(ОшибкаРазбора, Маркер);
		Если Позиция > 0 Тогда
			Начало = СтрНайти(ОшибкаРазбора, """", НаправлениеПоиска.СНачала, Позиция);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;
	Конец = СтрНайти(ОшибкаРазбора, """", НаправлениеПоиска.СНачала, Начало + 1);
	Возврат ?(Конец = 0, "", СокрЛП(Сред(ОшибкаРазбора, Начало + 1, Конец - Начало - 1)));

КонецФункции

// Сведения из метаданных о поле, которое платформа не нашла: состав таблицы источника, похожие имена первыми.
Функция ПодсказкаПоПолюТекста(ТекстЗапроса, Сегменты)

	Если Сегменты.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Лексемы = ЛексемыЗапроса(ТекстЗапроса);
	Источники = ИсточникиЛексем(Лексемы);
	Если Источники.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Если Сегменты.Количество() = 1 Тогда
		// Поле без псевдонима: состав первой таблицы запроса.
		Возврат ПодсказкаПоПути(Источники[0].ИмяТаблицы, Сегменты);
	КонецЕсли;

	Псевдоним = ВРег(Сегменты[0]);
	Описания = Новый Массив;
	ПределОписаний = 5;
	Для Каждого Источник Из Источники Цикл
		Если ВРег(Источник.Псевдоним) = Псевдоним Тогда
			ПутьПоля = Новый Массив;
			Для Индекс = 1 По Сегменты.ВГраница() Цикл
				ПутьПоля.Добавить(Сегменты[Индекс]);
			КонецЦикла;
			Возврат ПодсказкаПоПути(Источник.ИмяТаблицы, ПутьПоля);
		КонецЕсли;
		Если Описания.Количество() < ПределОписаний Тогда
			Описания.Добавить(СтрШаблон("%1 (%2)", Источник.Псевдоним, Источник.ИмяТаблицы));
		КонецЕсли;
	КонецЦикла;
	Если ПсевдонимОбъявлен(Лексемы, Псевдоним) Тогда
		Возврат ""; // вложенный запрос или временная таблица: их колонки заданы самим запросом
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'Псевдоним %1 в запросе не объявлен. Источники запроса: %2.'"),
		Сегменты[0], СтрСоединить(Описания, ", "));

КонецФункции

// Объясняет по метаданным, почему путь поля не найден в таблице: какого сегмента нет и какие поля есть.
// Объекты и поля вне периметра не раскрываются.
//
// Параметры:
//  ИмяТаблицы - Строка - имя таблицы источника, как в тексте запроса.
//  ПутьПоля - Массив из Строка - сегменты пути без псевдонима таблицы.
//
// Возвращаемое значение:
//  Строка - пустая, если сказать нечего.
//
Функция ПодсказкаПоПути(ИмяТаблицы, ПутьПоля)

	КонтекстТаблицы = КонтекстТаблицы(ИмяТаблицы);
	Если КонтекстТаблицы = Неопределено Или ПутьПоля.Количество() = 0
		Или ИИА_Периметр.ОбъектЗапрещен(КонтекстТаблицы.Объект.ПолноеИмя()) Тогда
		Возврат "";
	КонецЕсли;
	Если ЗначениеЗаполнено(КонтекстТаблицы.ВиртуальнаяТаблица) Тогда
		// Состав виртуальной таблицы зависит от её вида и параметров: показываем его целиком.
		Возврат ОписаниеПолейКонтекста(КонтекстТаблицы, ПутьПоля[0]);
	КонецЕсли;

	Контекст = КонтекстТаблицы;
	Для Индекс = 0 По ПутьПоля.ВГраница() Цикл
		ИмяПоля = ПутьПоля[Индекс];
		Поле = НайтиПоле(Контекст, ИмяПоля);
		Если Поле = Неопределено Тогда
			Возврат ОписаниеПолейКонтекста(Контекст, ИмяПоля);
		КонецЕсли;
		Если Индекс = ПутьПоля.ВГраница() Тогда
			Прервать;
		КонецЕсли;
		Если Поле.Вид = "ТабличнаяЧасть" Тогда
			Контекст = Новый Структура("Объект, ТабличнаяЧасть, ВиртуальнаяТаблица", Контекст.Объект, Поле.Метаданные, "");
			Продолжить;
		КонецЕсли;
		ОбъектТипа = ЕдинственныйОбъектТипа(Поле.Тип);
		Если ОбъектТипа = Неопределено Тогда
			Шаблон = НСтр("ru = 'Поле %1 не ссылается на один объект (составной или примитивный тип): обращение %1.%2 недоступно.'")
				+ " " + НСтр("ru = 'Выбери само поле %1; дата движения регистра - поле Период.'");
			Возврат СтрШаблон(Шаблон, ИмяПоля, ПутьПоля[Индекс + 1]);
		КонецЕсли;
		Если ИИА_Периметр.ОбъектЗапрещен(ОбъектТипа.ПолноеИмя()) Тогда
			Возврат "";
		КонецЕсли;
		Контекст = Новый Структура("Объект, ТабличнаяЧасть, ВиртуальнаяТаблица", ОбъектТипа, Неопределено, "");
	КонецЦикла;
	// Путь есть в метаданных, но платформа его не приняла: показываем состав исходной таблицы.
	Возврат ОписаниеПолейКонтекста(КонтекстТаблицы, ПутьПоля[0]);

КонецФункции

// Причина из метаданных для поля, не разобранного границей: какого поля нет в первой таблице источника и какие есть.
Функция ПодсказкаНеразобранногоПоля(Описания, ПутьПоля)

	Подсказка = "";
	Для Каждого Описание Из Описания Цикл
		Если Описание.Вид = "Таблица" Тогда
			Подсказка = ПодсказкаПоПути(Описание.ИмяТаблицы, ПутьПоля);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат ?(ПустаяСтрока(Подсказка), НСтр("ru = 'Укажите поле через псевдоним таблицы.'"), Подсказка);

КонецФункции

Функция ЕдинственныйОбъектТипа(ОписаниеТипа)

	Если ОписаниеТипа = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Найденный = Неопределено;
	Для Каждого ТипПоля Из ОписаниеТипа.Типы() Цикл
		ОбъектТипа = Метаданные.НайтиПоТипу(ТипПоля);
		Если ОбъектТипа = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Найденный <> Неопределено Тогда
			Возврат Неопределено; // составной ссылочный тип
		КонецЕсли;
		Найденный = ОбъектТипа;
	КонецЦикла;
	Возврат Найденный;

КонецФункции

// Сообщение «в таблице нет поля, есть такие-то»: похожие имена первыми, имена вне периметра не перечисляются.
Функция ОписаниеПолейКонтекста(Контекст, ИскомоеИмя)

	ПолноеИмя = Контекст.Объект.ПолноеИмя();
	Имена = ИменаПолейКонтекста(Контекст);
	Если Имена.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Если Контекст.ТабличнаяЧасть <> Неопределено Тогда
		ИмяТаблицы = ПолноеИмя + "." + Контекст.ТабличнаяЧасть.Имя;
	ИначеЕсли ЗначениеЗаполнено(Контекст.ВиртуальнаяТаблица) Тогда
		ИмяТаблицы = ПолноеИмя + "." + Контекст.ВиртуальнаяТаблица;
	Иначе
		ИмяТаблицы = ПолноеИмя;
	КонецЕсли;

	Части = Новый Массив;
	Части.Добавить(СтрШаблон(НСтр("ru = 'В %1 нет поля %2.'"), ИмяТаблицы, ИскомоеИмя));
	ПределПохожих = 8;
	Похожие = ПохожиеИмена(Имена, ИскомоеИмя, ПределПохожих);
	Если Похожие.Количество() > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'Похожие: %1.'"), СтрСоединить(Похожие, ", ")));
	КонецЕсли;
	Предел = 60;
	Показанные = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		Если Показанные.Количество() = Предел Тогда
			Прервать;
		КонецЕсли;
		Показанные.Добавить(Имя);
	КонецЦикла;
	Части.Добавить(СтрШаблон(НСтр("ru = 'Поля: %1.'"), СтрСоединить(Показанные, ", ")));
	Если Имена.Количество() > Предел Тогда
		Шаблон = НСтр("ru = 'Показаны первые %1 из %2; полный состав - describe_metadata %3.'");
		Показано = Формат(Предел, "ЧГ=");
		Всего = Формат(Имена.Количество(), "ЧГ=");
		Части.Добавить(СтрШаблон(Шаблон, Показано, Всего, ПолноеИмя));
	КонецЕсли;
	ВидТаблицы = ВРег(Контекст.ВиртуальнаяТаблица);
	Если СтрНайти(ВидТаблицы, "ОБОРОТ") > 0 Или СтрНайти(ВидТаблицы, "TURNOVER") > 0 Тогда
		Части.Добавить(НСтр("ru = 'Период и Регистратор есть у таблицы оборотов только при заданной периодичности.'"));
	КонецЕсли;
	Возврат СтрСоединить(Части, " ");

КонецФункции

// Имена полей таблицы источника, доступные в периметре: для виртуальной таблицы - с её суффиксами ресурсов.
Функция ИменаПолейКонтекста(Контекст)

	Имена = Новый Массив;
	ОбъектМетаданных = Контекст.Объект;
	ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	Если Контекст.ТабличнаяЧасть <> Неопределено Тогда
		Имена.Добавить("Ссылка");
		Имена.Добавить("НомерСтроки");
		ДобавитьИменаКоллекции(Имена, ПолноеИмя, Контекст.ТабличнаяЧасть.Реквизиты,
			Контекст.ТабличнаяЧасть.Имя + ".", "");
		Возврат Имена;
	КонецЕсли;

	Если ЗначениеЗаполнено(Контекст.ВиртуальнаяТаблица) Тогда
		Суффиксы = СуффиксыВиртуальнойТаблицы(ОбъектМетаданных, Контекст.ВиртуальнаяТаблица);
		ЭтоСрез = Суффиксы.Количество() = 1 И Суффиксы[0] = "";
		Если ЭтоСрез Тогда
			Имена.Добавить("Период");
		КонецЕсли;
		ДобавитьИменаКоллекции(Имена, ПолноеИмя, КоллекцияМетаданных(ОбъектМетаданных, "Измерения"), "", "");
		Для Каждого Суффикс Из Суффиксы Цикл
			ДобавитьИменаКоллекции(Имена, ПолноеИмя, КоллекцияМетаданных(ОбъектМетаданных, "Ресурсы"), "", Суффикс);
		КонецЦикла;
		Если ЭтоСрез Тогда
			ДобавитьИменаКоллекции(Имена, ПолноеИмя, КоллекцияМетаданных(ОбъектМетаданных, "Реквизиты"), "", "");
		КонецЕсли;
		Возврат Имена;
	КонецЕсли;

	ДобавитьИменаКоллекции(Имена, ПолноеИмя, КоллекцияМетаданных(ОбъектМетаданных, "СтандартныеРеквизиты"), "", "");
	Для Каждого ИмяКоллекции Из СтрРазделить("Измерения,Ресурсы,Реквизиты,ТабличныеЧасти", ",") Цикл
		ДобавитьИменаКоллекции(Имена, ПолноеИмя, КоллекцияМетаданных(ОбъектМетаданных, ИмяКоллекции), "", "");
	КонецЦикла;
	Возврат Имена;

КонецФункции

Процедура ДобавитьИменаКоллекции(Имена, ПолноеИмя, Коллекция, ПрефиксПути, Суффикс)

	Если Коллекция = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Поле Из Коллекция Цикл
		// Свободный текст запрос пропускает с классом К3, поэтому его имя тоже подсказывается.
		Если Не ИИА_Периметр.ПолеЗапрещено(ПолноеИмя, ПрефиксПути + Поле.Имя, , , Истина) Тогда
			Имена.Добавить(Поле.Имя + Суффикс);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Суффиксы имён ресурсов виртуальной таблицы регистра; для срезов и неизвестных таблиц - пустой суффикс.
Функция СуффиксыВиртуальнойТаблицы(ОбъектМетаданных, ВиртуальнаяТаблица)

	Вид = ВРег(ВиртуальнаяТаблица);
	Если Вид = "ОСТАТКИИОБОРОТЫ" Или Вид = "BALANCEANDTURNOVERS" Тогда
		Возврат СтрРазделить("НачальныйОстаток,Приход,Расход,Оборот,КонечныйОстаток", ",");
	ИначеЕсли Вид = "ОСТАТКИ" Или Вид = "BALANCE" Тогда
		Возврат СтрРазделить("Остаток", ",");
	ИначеЕсли Вид = "ОБОРОТЫ" Или Вид = "TURNOVERS" Тогда
		ЭтоРегистрОстатков = Метаданные.РегистрыНакопления.Содержит(ОбъектМетаданных)
			И ОбъектМетаданных.ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки;
		Возврат СтрРазделить(?(ЭтоРегистрОстатков, "Оборот,Приход,Расход", "Оборот"), ",");
	Иначе
		Суффиксы = Новый Массив;
		Суффиксы.Добавить("");
		Возврат Суффиксы;
	КонецЕсли;

КонецФункции

// Имена, похожие на искомое: вхождение одного имени в другое либо общие слова составного имени.
Функция ПохожиеИмена(Имена, ИскомоеИмя, Предел)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Вес", Новый ОписаниеТипов("Число"));
	Для Каждого Имя Из Имена Цикл
		Вес = ПохожестьИмен(Имя, ИскомоеИмя);
		Если Вес > 0 Тогда
			СтрокаТаблицы = Таблица.Добавить();
			СтрокаТаблицы.Имя = Имя;
			СтрокаТаблицы.Вес = Вес;
		КонецЕсли;
	КонецЦикла;
	Таблица.Сортировать("Вес Убыв");
	Похожие = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если Похожие.Количество() = Предел Тогда
			Прервать;
		КонецЕсли;
		Похожие.Добавить(СтрокаТаблицы.Имя);
	КонецЦикла;
	Возврат Похожие;

КонецФункции

Функция ПохожестьИмен(Имя, ИскомоеИмя)

	ВерхнееИмя = ВРег(Имя);
	ВерхнееИскомое = ВРег(ИскомоеИмя);
	МинимумДлиныСлова = МинимумДлиныСлова();
	ВесВхождения = 10;
	Если СтрНайти(ВерхнееИмя, ВерхнееИскомое) > 0
		Или СтрДлина(Имя) >= МинимумДлиныСлова И СтрНайти(ВерхнееИскомое, ВерхнееИмя) > 0 Тогда
		Возврат ВесВхождения;
	КонецЕсли;
	Вес = 0;
	СловаИмени = СловаИдентификатора(Имя);
	Для Каждого Слово Из СловаИдентификатора(ИскомоеИмя) Цикл
		Если СловаИмени.Найти(Слово) <> Неопределено Тогда
			Вес = Вес + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Вес;

КонецФункции

// Слова составного имени («СкладПолучатель» - СКЛАД, ПОЛУЧ): первые пять букв каждого слова от трёх букв.
Функция СловаИдентификатора(Имя)

	Слова = Новый Массив;
	Начало = 1;
	Длина = СтрДлина(Имя);
	МинимумДлиныСлова = МинимумДлиныСлова();
	ДлинаОсновы = 5;
	Для Позиция = Начало + 1 По Длина + 1 Цикл
		Если Позиция <= Длина И Не ЭтоГраницаСлова(Имя, Позиция) Тогда
			Продолжить;
		КонецЕсли;
		Слово = СтрЗаменить(Сред(Имя, Начало, Позиция - Начало), "_", "");
		Если СтрДлина(Слово) >= МинимумДлиныСлова Тогда
			Слова.Добавить(ВРег(Лев(Слово, ДлинаОсновы)));
		КонецЕсли;
		Начало = Позиция;
	КонецЦикла;
	Возврат Слова;

КонецФункции

Функция МинимумДлиныСлова()

	Минимум = 3;
	Возврат Минимум;

КонецФункции

// Слово начинается с подчёркивания либо с заглавной буквы после строчной буквы или цифры.
Функция ЭтоГраницаСлова(Имя, Позиция)

	Символ = Сред(Имя, Позиция, 1);
	Если Символ = "_" Тогда
		Возврат Истина;
	КонецЕсли;
	Предыдущий = Сред(Имя, Позиция - 1, 1);
	Возврат ВРег(Символ) = Символ И НРег(Символ) <> Символ И НРег(Предыдущий) = Предыдущий;

КонецФункции

// Разбирает текст запроса на лексемы без потери символов: соединение текстов лексем даёт исходный текст.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Текст - Строка
//   * Слово - Булево - идентификатор или ключевое слово.
//   * Значимая - Булево - Ложь для пробелов и комментариев.
//
Функция ЛексемыЗапроса(Текст)

	Лексемы = Новый Массив;
	Длина = СтрДлина(Текст);
	Позиция = 1;
	Пока Позиция <= Длина Цикл
		Символ = Сред(Текст, Позиция, 1);
		ЭтоСлово = ЭтоНачалоИдентификатора(Символ);
		ЭтоКомментарий = Символ = "/" И Сред(Текст, Позиция + 1, 1) = "/";
		Значимая = Не ЭтоКомментарий И Не ПустаяСтрока(Символ);
		Если Символ = """" Тогда
			Конец = КонецЛитерала(Текст, Позиция, Длина);
		ИначеЕсли ЭтоКомментарий Тогда
			Конец = КонецСтрокиТекста(Текст, Позиция, Длина);
		ИначеЕсли ЭтоСлово Или Не Значимая Тогда
			Конец = КонецСерии(Текст, Позиция, Длина, ЭтоСлово);
		Иначе
			Конец = Позиция; // знак - один символ
		КонецЕсли;
		ТекстЛексемы = Сред(Текст, Позиция, Конец - Позиция + 1);
		Лексемы.Добавить(Новый Структура("Текст, Слово, Значимая", ТекстЛексемы, ЭтоСлово, Значимая));
		Позиция = Конец + 1;
	КонецЦикла;
	Возврат Лексемы;

КонецФункции

// Позиция закрывающей кавычки строкового литерала ("" внутри - экранированная кавычка).
Функция КонецЛитерала(Текст, Начало, Длина)

	ДлинаЭкранирования = 2;
	Позиция = Начало + 1;
	Пока Позиция <= Длина Цикл
		Если Сред(Текст, Позиция, 1) = """" Тогда
			Если Сред(Текст, Позиция + 1, 1) = """" Тогда
				Позиция = Позиция + ДлинаЭкранирования;
				Продолжить;
			КонецЕсли;
			Возврат Позиция;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Возврат Длина;

КонецФункции

// Позиция последнего символа строки текста, начатой в позиции (без перевода строки).
Функция КонецСтрокиТекста(Текст, Позиция, Длина)

	Конец = СтрНайти(Текст, Символы.ПС, НаправлениеПоиска.СНачала, Позиция);
	Возврат ?(Конец = 0, Длина, Конец - 1);

КонецФункции

// Позиция последнего символа серии: символов идентификатора (ЭтоСлово) либо пробельных символов.
Функция КонецСерии(Текст, Позиция, Длина, ЭтоСлово)

	Конец = Позиция;
	Пока Конец < Длина Цикл
		Следующий = Сред(Текст, Конец + 1, 1);
		Продолжается = ?(ЭтоСлово, ЭтоСимволИдентификатора(Следующий), ПустаяСтрока(Следующий));
		Если Не Продолжается Тогда
			Прервать;
		КонецЕсли;
		Конец = Конец + 1;
	КонецЦикла;
	Возврат Конец;

КонецФункции

Функция ТекстЛексемы(Лексемы, Индекс)

	Возврат ?(Индекс < 0 Или Индекс > Лексемы.ВГраница(), "", Лексемы[Индекс].Текст);

КонецФункции

Функция ЭтоСловоЛексемы(Лексемы, Индекс)

	Возврат Индекс >= 0 И Индекс <= Лексемы.ВГраница() И Лексемы[Индекс].Слово;

КонецФункции

Функция ЭтоСловоКак(Лексема)

	Слово = ВРег(Лексема.Текст);
	Возврат Лексема.Слово И (Слово = "КАК" Или Слово = "AS");

КонецФункции

// Индекс ближайшей лексемы, отличной от пробелов, комментариев и удалённых лексем; -1 - такой нет.
Функция СоседняяЗначимая(Лексемы, Знач Индекс, Шаг)

	Если Индекс < 0 Тогда
		Возврат -1;
	КонецЕсли;
	Индекс = Индекс + Шаг;
	Пока Индекс >= 0 И Индекс <= Лексемы.ВГраница() Цикл
		Лексема = Лексемы[Индекс];
		Если Лексема.Значимая И Лексема.Текст <> "" Тогда
			Возврат Индекс;
		КонецЕсли;
		Индекс = Индекс + Шаг;
	КонецЦикла;
	Возврат -1;

КонецФункции

// Индекс скобки, закрывающей открытую в позиции ИндексОткрывающей; последняя лексема, если пары нет.
Функция ЗакрывающаяСкобка(Лексемы, ИндексОткрывающей)

	Глубина = 0;
	Для Индекс = ИндексОткрывающей По Лексемы.ВГраница() Цикл
		ТекстЛексемы = Лексемы[Индекс].Текст;
		Если ТекстЛексемы = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли ТекстЛексемы = ")" Тогда
			Глубина = Глубина - 1;
		Иначе
			Продолжить;
		КонецЕсли;
		Если Глубина = 0 Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;
	Возврат Лексемы.ВГраница();

КонецФункции

// Табличные источники текста запроса с псевдонимами. Работает по лексемам: текст может не разбираться платформой.
//
// Возвращаемое значение:
//  Массив из Структура - Псевдоним, ИмяТаблицы.
//
Функция ИсточникиЛексем(Лексемы)

	Источники = Новый Массив;
	КлючевыеСлова = КлючевыеСлова();
	Индекс = 0;
	Пока Индекс <= Лексемы.ВГраница() Цикл
		ИмяТаблицы = ИмяТаблицыВПозиции(Лексемы, Индекс);
		Псевдоним = ?(ИмяТаблицы = "", "", ПсевдонимПослеТаблицы(Лексемы, Индекс, КлючевыеСлова));
		Если Псевдоним <> "" Тогда
			Источники.Добавить(Новый Структура("Псевдоним, ИмяТаблицы", Псевдоним, ИмяТаблицы));
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат Источники;

КонецФункции

// Имя таблицы метаданных («Документ.Х.Товары»), начатое в позиции; Индекс переводится на последнее слово имени.
// Пустая строка - в позиции не имя таблицы.
Функция ИмяТаблицыВПозиции(Лексемы, Индекс)

	Лексема = Лексемы[Индекс];
	Если Не Лексема.Слово Или КлассМетаданных(Лексема.Текст) = "" Или ТекстЛексемы(Лексемы, Индекс - 1) = "." Тогда
		Возврат "";
	КонецЕсли;
	Части = Новый Массив;
	Части.Добавить(Лексема.Текст);
	ШагСлова = 2; // точка и следующее слово
	Пока ТекстЛексемы(Лексемы, Индекс + 1) = "." И ЭтоСловоЛексемы(Лексемы, Индекс + ШагСлова) Цикл
		Индекс = Индекс + ШагСлова;
		Части.Добавить(Лексемы[Индекс].Текст);
	КонецЦикла;
	Возврат ?(Части.Количество() = 1, "", СтрСоединить(Части, "."));

КонецФункции

// Псевдоним после имени таблицы: параметры виртуальной таблицы и слово КАК пропускаются.
// Пустая строка - псевдонима нет (ЗНАЧЕНИЕ(...), ССЫЛКА, ВЫРАЗИТЬ ... КАК тип).
Функция ПсевдонимПослеТаблицы(Лексемы, Индекс, КлючевыеСлова)

	Следующая = СоседняяЗначимая(Лексемы, Индекс, 1);
	Если ТекстЛексемы(Лексемы, Следующая) = "(" Тогда
		Закрывающая = ЗакрывающаяСкобка(Лексемы, Следующая);
		Следующая = СоседняяЗначимая(Лексемы, Закрывающая, 1);
	КонецЕсли;
	Если Следующая >= 0 И ЭтоСловоКак(Лексемы[Следующая]) Тогда
		Следующая = СоседняяЗначимая(Лексемы, Следующая, 1);
	КонецЕсли;
	Если Не ЭтоСловоЛексемы(Лексемы, Следующая) Тогда
		Возврат "";
	КонецЕсли;
	Псевдоним = Лексемы[Следующая].Текст;
	Возврат ?(КлючевыеСлова.Получить(ВРег(Псевдоним)) = Неопределено, Псевдоним, "");

КонецФункции

// Псевдоним объявлен в тексте: после КАК либо после закрывающей скобки вложенного запроса.
Функция ПсевдонимОбъявлен(Лексемы, Псевдоним)

	Для Индекс = 0 По Лексемы.ВГраница() Цикл
		Лексема = Лексемы[Индекс];
		Если Не Лексема.Слово Или ВРег(Лексема.Текст) <> Псевдоним Тогда
			Продолжить;
		КонецЕсли;
		Предыдущая = СоседняяЗначимая(Лексемы, Индекс, -1);
		Если Предыдущая >= 0 И (ЭтоСловоКак(Лексемы[Предыдущая]) Или Лексемы[Предыдущая].Текст = ")") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Псевдоним, совпавший с зарезервированным словом, получает суффикс «_» в объявлении и во всех обращениях
// «Псевдоним.Поле»; то же слово в роли оператора не меняется.
Процедура ПереименоватьЗарезервированныеПсевдонимы(Лексемы, Исправления)

	Замены = ЗаменыЗарезервированныхПсевдонимов(Лексемы, Исправления);
	Если Замены.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Для Индекс = 0 По Лексемы.ВГраница() Цикл
		Лексема = Лексемы[Индекс];
		НовоеИмя = ?(Лексема.Слово, Замены.Получить(ВРег(Лексема.Текст)), Неопределено);
		Если НовоеИмя <> Неопределено И ЭтоПсевдонимВПозиции(Лексемы, Индекс) Тогда
			Лексема.Текст = НовоеИмя;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Новые имена псевдонимов, совпавших с зарезервированными словами: ВРег(псевдоним) -> новое имя.
Функция ЗаменыЗарезервированныхПсевдонимов(Лексемы, Исправления)

	Зарезервированные = ЗарезервированныеСлова();
	Занятые = Новый Соответствие;
	Для Каждого Лексема Из Лексемы Цикл
		Если Лексема.Слово Тогда
			Занятые.Вставить(ВРег(Лексема.Текст), Истина);
		КонецЕсли;
	КонецЦикла;

	Замены = Новый Соответствие;
	Шаблон = НСтр("ru = 'псевдоним %1 - зарезервированное слово, заменён на %2'");
	Для Индекс = 0 По Лексемы.ВГраница() Цикл
		Лексема = Лексемы[Индекс];
		Ключ = ВРег(Лексема.Текст);
		ТребуетЗамены = Зарезервированные.Получить(Ключ) <> Неопределено И Замены.Получить(Ключ) = Неопределено;
		Если Не ТребуетЗамены Или Не ЭтоОбъявлениеПсевдонима(Лексемы, Индекс) Тогда
			Продолжить;
		КонецЕсли;
		НовоеИмя = СвободноеИмя(Лексема.Текст, Занятые);
		Замены.Вставить(Ключ, НовоеИмя);
		Исправления.Добавить(СтрШаблон(Шаблон, Лексема.Текст, НовоеИмя));
	КонецЦикла;
	Возврат Замены;

КонецФункции

Функция СвободноеИмя(Имя, Занятые)

	НовоеИмя = Имя + "_";
	Пока Занятые.Получить(ВРег(НовоеИмя)) <> Неопределено Цикл
		НовоеИмя = НовоеИмя + "_";
	КонецЦикла;
	Занятые.Вставить(ВРег(НовоеИмя), Истина);
	Возврат НовоеИмя;

КонецФункции

Функция ЭтоОбъявлениеПсевдонима(Лексемы, Индекс)

	Предыдущая = СоседняяЗначимая(Лексемы, Индекс, -1);
	Возврат Лексемы[Индекс].Слово И Предыдущая >= 0 И ЭтоСловоКак(Лексемы[Предыдущая]);

КонецФункции

// Слово в позиции - объявление псевдонима («КАК И») или обращение через него («И.Поле»), а не оператор.
Функция ЭтоПсевдонимВПозиции(Лексемы, Индекс)

	Если ЭтоОбъявлениеПсевдонима(Лексемы, Индекс) Тогда
		Возврат Истина;
	КонецЕсли;
	Перед = ТекстЛексемы(Лексемы, Индекс - 1);
	Возврат ТекстЛексемы(Лексемы, Индекс + 1) = "." И Перед <> "." И Перед <> "&";

КонецФункции

// Слова, которые платформа не принимает псевдонимом таблицы или колонки (проверено разбором СхемаЗапроса).
Функция ЗарезервированныеСлова()

	Слова = Новый Соответствие;
	// Словарь лексера, а не исполняемый запрос.
	// BSLLS:QueryParseError-off
	// BSLLS:AssignAliasFieldsInQuery-off
	Список = "РАЗЛИЧНЫЕ,ПЕРВЫЕ,РАЗРЕШЕННЫЕ,ИЗ,КАК,ГДЕ,И,ИЛИ,НЕ,В,МЕЖДУ,ПОДОБНО,СПЕЦСИМВОЛ,ЕСТЬ,NULL,ИСТИНА,ЛОЖЬ,"
		+ "НЕОПРЕДЕЛЕНО,ВЫБОР,КОГДА,ТОГДА,ИНАЧЕ,ВНУТРЕННЕЕ,ПО,ВОЗР,УБЫВ,ОБЩИЕ,ПОМЕСТИТЬ,ДЛЯ,АВТОУПОРЯДОЧИВАНИЕ,"
		+ "ПЕРИОДАМИ,ТОЛЬКО,ВЫРАЗИТЬ,FROM,AS,WHERE,AND,OR,NOT,IN,IS,ON,BY,FOR,TOP,CASE,WHEN,THEN,ELSE,INTO,ASC,DESC,"
		+ "OF,TRUE,FALSE,LIKE,ONLY,CAST,BETWEEN,DISTINCT,ALLOWED,ESCAPE,UNDEFINED,INNER,OVERALL,PERIODS,AUTOORDER";
	// BSLLS:AssignAliasFieldsInQuery-on
	// BSLLS:QueryParseError-on
	Для Каждого Слово Из СтрРазделить(Список, ",") Цикл
		Слова.Вставить(Слово, Истина);
	КонецЦикла;
	Возврат Слова;

КонецФункции

// Слово направления сортировки после выражения в УПОРЯДОЧИТЬ ПО: «УБЫВАНИЕ», «УБЫ», DESCENDING и подобные.
Процедура ИсправитьНаправлениеСортировки(Лексемы, Исправления)

	ВУпорядочивании = Ложь;
	НачалоУпорядочивания = СтрРазделить("УПОРЯДОЧИТЬ,ORDER", ",");
	КонецУпорядочивания = СтрРазделить("ИТОГИ,TOTALS,ОБЪЕДИНИТЬ,UNION,ВЫБРАТЬ,SELECT,;", ",");
	Шаблон = НСтр("ru = 'направление сортировки %1 заменено на %2'");
	Для Индекс = 0 По Лексемы.ВГраница() Цикл
		Лексема = Лексемы[Индекс];
		Слово = ВРег(Лексема.Текст);
		Если НачалоУпорядочивания.Найти(Слово) <> Неопределено Тогда
			ВУпорядочивании = Истина;
		ИначеЕсли КонецУпорядочивания.Найти(Слово) <> Неопределено Тогда
			ВУпорядочивании = Ложь;
		Иначе
			Замена = ?(ВУпорядочивании И Лексема.Слово, НаправлениеСортировки(Слово), "");
			Если Замена <> "" И ПослеВыраженияСортировки(Лексемы, Индекс) Тогда
				Исправления.Добавить(СтрШаблон(Шаблон, Лексема.Текст, Замена));
				Лексема.Текст = Замена;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Возвращает УБЫВ или ВОЗР для неверной формы слова направления; пустая строка - слово другое или уже верное.
Функция НаправлениеСортировки(Слово)

	Верные = СтрРазделить("УБЫВ,ВОЗР,DESC,ASC", ",");
	Если Верные.Найти(Слово) <> Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Замена = "";
	Если СтрНачинаетсяС(Слово, "УБЫ") Или СтрНачинаетсяС(Слово, "DESCEND") Тогда
		Замена = Верные[0];
	ИначеЕсли СтрНачинаетсяС(Слово, Верные[1]) Или СтрНачинаетсяС(Слово, "ASCEND") Тогда
		Замена = Верные[1];
	Иначе
		Замена = "";
	КонецЕсли;
	Возврат Замена;

КонецФункции

// Слово стоит после выражения сортировки (имени, скобки или номера колонки), а не само является выражением.
Функция ПослеВыраженияСортировки(Лексемы, Индекс)

	Предыдущая = СоседняяЗначимая(Лексемы, Индекс, -1);
	РядомТочка = ТекстЛексемы(Лексемы, Индекс + 1) = "." Или ТекстЛексемы(Лексемы, Индекс - 1) = ".";
	Если Предыдущая < 0 Или РядомТочка Тогда
		Возврат Ложь;
	КонецЕсли;
	Лексема = Лексемы[Предыдущая];
	Если Лексема.Слово Тогда
		Возврат СтрРазделить("ПО,BY,КАК,AS", ",").Найти(ВРег(Лексема.Текст)) = Неопределено;
	КонецЕсли;
	Возврат Лексема.Текст = ")" Или ЭтоЦифра(Лексема.Текст);

КонецФункции

// Вид движения регистра накопления - системное перечисление: ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
// а не перечисление конфигурации «Перечисление.ВидыДвижений».
Процедура ИсправитьВидДвижения(Лексемы, Исправления)

	ДлинаОбразца = 5; // Перечисление . Имя . Значение
	Шаблон = НСтр("ru = '%1.%2 заменено на системное перечисление ВидДвиженияНакопления'");
	Для Индекс = 0 По Лексемы.Количество() - ДлинаОбразца Цикл
		Если Не ЭтоПеречислениеВидаДвижения(Лексемы, Индекс) Тогда
			Продолжить;
		КонецЕсли;
		Исправления.Добавить(СтрШаблон(Шаблон, Лексемы[Индекс].Текст, Лексемы[Индекс + 2].Текст));
		Лексемы[Индекс].Текст = "ВидДвиженияНакопления";
		Лексемы[Индекс + 1].Текст = "";
		Лексемы[Индекс + 2].Текст = "";
	КонецЦикла;

КонецПроцедуры

// Лексемы с позиции Индекс: «Перечисление.ВидыДвижений.Приход» при отсутствии такого перечисления в конфигурации.
Функция ЭтоПеречислениеВидаДвижения(Лексемы, Индекс)

	Класс = ВРег(Лексемы[Индекс].Текст);
	Если Класс <> "ПЕРЕЧИСЛЕНИЕ" И Класс <> "ENUM" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Лексемы[Индекс + 1].Текст <> "." Или Лексемы[Индекс + 3].Текст <> "." Тогда
		Возврат Ложь;
	КонецЕсли;
	Имя = ВРег(Лексемы[Индекс + 2].Текст);
	Значение = ВРег(Лексемы[Индекс + 4].Текст);
	Если Не СтрНачинаетсяС(Имя, "ВИДДВИЖЕНИ") И Не СтрНачинаетсяС(Имя, "ВИДЫДВИЖЕНИ") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Значение <> "ПРИХОД" И Значение <> "РАСХОД" Тогда
		Возврат Ложь;
	КонецЕсли;
	// Одноимённое перечисление конфигурации остаётся как есть.
	Возврат Метаданные.Перечисления.Найти(Лексемы[Индекс + 2].Текст) = Неопределено;

КонецФункции

#КонецОбласти

#Область Результат

// Приводит таблицу значений (например, вывод СКД в коллекцию) к результату границы данных:
// значения проходят периметр, ссылки становятся объектами, которые можно открыть из чата.
//
// Параметры:
//  Таблица - ТаблицаЗначений
//  МаксимумСтрок - Число
//
// Возвращаемое значение:
//  Структура - см. ВыполнитьЗапросАгента.
//
Функция РезультатИзТаблицы(Таблица, МаксимумСтрок = 200) Экспорт

	Результат = НовыйРезультат();
	ЗаполнитьРезультат(Результат, Таблица, МаксимумСтрок);
	Возврат Результат;

КонецФункции

Функция НовыйРезультат()

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("КодОшибки", "");
	Результат.Вставить("НедостающиеПараметры", Новый Массив);
	Результат.Вставить("ЛишниеПараметры", Новый Массив);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Колонки", Новый Массив);
	Результат.Вставить("Строки", Новый Массив);
	Результат.Вставить("Усечено", Ложь);
	Результат.Вставить("Скрыто", 0);
	Результат.Вставить("Класс", 0); // класс данных результата (ИИА_КлассыДанных)
	Результат.Вставить("Таблицы", Новый Массив); // объекты метаданных - источники запроса
	Результат.Вставить("Исправления", Новый Массив); // автоисправления текста запроса перед разбором
	// Ссылки, которые можно открыть из чата: Текст - представление, Ссылка - навигационная ссылка.
	Результат.Вставить("Объекты", Новый Массив);
	// По строкам: индекс в Объекты для каждой ячейки или Неопределено.
	Результат.Вставить("ОбъектыЯчеек", Новый Массив);
	Возврат Результат;

КонецФункции

Процедура ЗаполнитьРезультат(Результат, РезультатЗапроса, МаксимумСтрок)

	Результат.Успех = Истина;
	Если РезультатЗапроса = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИменаКолонок = Новый Массив;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		ИменаКолонок.Добавить(Колонка.Имя);
		Результат.Колонки.Добавить(Колонка.Имя);
	КонецЦикла;

	// Читаем не больше МаксимумСтрок + 1 строк, собираем ссылки для классификации физлиц.
	СырыеСтроки = Новый Массив;
	Ссылки = Новый Массив;
	ЭтоТаблица = ТипЗнч(РезультатЗапроса) = Тип("ТаблицаЗначений");
	Выборка = ?(ЭтоТаблица, Неопределено, РезультатЗапроса.Выбрать());
	НомерСтроки = 0;
	Пока ?(ЭтоТаблица, НомерСтроки < РезультатЗапроса.Количество(), Выборка.Следующий()) Цикл
		Запись = ?(ЭтоТаблица, РезультатЗапроса[НомерСтроки], Выборка);
		НомерСтроки = НомерСтроки + 1;
		Если СырыеСтроки.Количество() >= МаксимумСтрок Тогда
			Результат.Усечено = Истина;
			Прервать;
		КонецЕсли;
		Значения = Новый Массив;
		Для Каждого ИмяКолонки Из ИменаКолонок Цикл
			Значение = Запись[ИмяКолонки];
			Значения.Добавить(Значение);
			Если Значение <> Null И Значение <> Неопределено И ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Значение)) Тогда
				Ссылки.Добавить(Значение);
			КонецЕсли;
		КонецЦикла;
		СырыеСтроки.Добавить(Значения);
	КонецЦикла;

	ФизлицаСредиСсылок = ИИА_Периметр.ОтметитьСсылки(Ссылки);
	Регистрация = Новый Соответствие; // новые коммерческие пары: пишутся одной записью после цикла
	Скрыто = 0;
	ИндексыОбъектов = Новый Соответствие; // ссылка -> индекс в Результат.Объекты
	Для Каждого Значения Из СырыеСтроки Цикл
		СтрокаРезультата = Новый Массив;
		ОбъектыСтроки = Новый Массив;
		Для Каждого Значение Из Значения Цикл
			СкрытоДо = Скрыто;
			Безопасное = ИИА_Периметр.БезопасноеЗначение(ЗначениеЯчейки(Значение), ФизлицаСредиСсылок, Скрыто, Регистрация);
			Безопасное = ОбрезанныйТекстЯчейки(Безопасное);
			СтрокаРезультата.Добавить(Безопасное);
			// Ссылкой в чате становится только значение, которое периметр показал без замен.
			Индекс = Неопределено;
			Если Скрыто = СкрытоДо И ЗначениеЗаполнено(Значение) И ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Значение))
				И Не Перечисления.ТипВсеСсылки().СодержитТип(ТипЗнч(Значение)) Тогда
				Индекс = ИндексыОбъектов.Получить(Значение);
				Если Индекс = Неопределено Тогда
					// Навигационная ссылка есть не у всех ссылочных типов (например, точки маршрута): такие не открываем.
					Попытка
						Навигация = ПолучитьНавигационнуюСсылку(Значение);
					// Необязательная навигация; маскированное значение сохраняется без ссылки открытия.
					Исключение // BSLLS:MissingCodeTryCatchEx-off
						Навигация = "";
					КонецПопытки;
					Если ЗначениеЗаполнено(Навигация) Тогда
						Результат.Объекты.Добавить(Новый Структура("Текст, Ссылка, Значение", Безопасное, Навигация, Значение));
						Индекс = Результат.Объекты.ВГраница();
						ИндексыОбъектов.Вставить(Значение, Индекс);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			ОбъектыСтроки.Добавить(Индекс);
		КонецЦикла;
		Результат.Строки.Добавить(СтрокаРезультата);
		Результат.ОбъектыЯчеек.Добавить(ОбъектыСтроки);
	КонецЦикла;
	ИИА_Маскирование.ЗаписатьПсевдонимы(Регистрация);
	Результат.Скрыто = Скрыто;

КонецПроцедуры

// Длинный текст ячейки (лог обмена, свободный текст) модели целиком не нужен: предел на ячейку.
Функция ПределТекстаЯчейки()

	Предел = 4000;
	Возврат Предел;

КонецФункции

// Строку больше предела до очистки от ПДн укорачивает с запасом: очистка многомегабайтного текста дорога,
// а итог всё равно обрезается в ОбрезанныйТекстЯчейки.
Функция ЗначениеЯчейки(Значение)

	Запас = 2;
	Предел = ПределТекстаЯчейки() * Запас;
	Если ТипЗнч(Значение) = Тип("Строка") И СтрДлина(Значение) > Предел Тогда
		Возврат Лев(Значение, Предел);
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция ОбрезанныйТекстЯчейки(Значение)

	Предел = ПределТекстаЯчейки();
	Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) <= Предел Тогда
		Возврат Значение;
	КонецЕсли;
	Пометка = НСтр("ru = '… [текст обрезан до %1 символов; нужный фрагмент выбери ПОДСТРОКА(ВЫРАЗИТЬ(...), начало, длина)]'");
	Возврат Лев(Значение, Предел) + СтрШаблон(Пометка, Формат(Предел, "ЧГ="));

КонецФункции

Процедура ЗафиксироватьНарушение(Контекст, Код, Текст)

	Если Не ЗначениеЗаполнено(Контекст.Нарушение) Тогда
		Контекст.Нарушение = Текст;
		Контекст.КодНарушения = Код;
	КонецЕсли;

КонецПроцедуры

Функция ИмяСобытияЖурнала()

	Возврат НСтр("ru = 'ИИАссистент.ГраницаЗапроса'", ОбщегоНазначения.КодОсновногоЯзыка());

КонецФункции

#КонецОбласти

#КонецОбласти
