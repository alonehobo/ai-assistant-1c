#КонецОбласти

#Область Результат

// Приводит таблицу значений (например, вывод СКД в коллекцию) к результату границы данных:
// значения проходят периметр, ссылки становятся объектами, которые можно открыть из чата.
//
// Параметры:
//  Таблица - ТаблицаЗначений
//  МаксимумСтрок - Число
//
// Возвращаемое значение:
//  Структура - см. ВыполнитьЗапросАгента.
//
Функция РезультатИзТаблицы(Таблица, МаксимумСтрок = 200) Экспорт

	Результат = НовыйРезультат();
	ЗаполнитьРезультат(Результат, Таблица, МаксимумСтрок);
	Возврат Результат;

КонецФункции

Функция НовыйРезультат()

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("КодОшибки", "");
	Результат.Вставить("НедостающиеПараметры", Новый Массив);
	Результат.Вставить("ЛишниеПараметры", Новый Массив);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Колонки", Новый Массив);
	Результат.Вставить("Строки", Новый Массив);
	Результат.Вставить("Усечено", Ложь);
	Результат.Вставить("Скрыто", 0);
	Результат.Вставить("Класс", 0); // класс данных результата (ИИА_КлассыДанных)
	Результат.Вставить("Таблицы", Новый Массив); // объекты метаданных - источники запроса
	// Ссылки, которые можно открыть из чата: Текст - представление, Ссылка - навигационная ссылка.
	Результат.Вставить("Объекты", Новый Массив);
	// По строкам: индекс в Объекты для каждой ячейки или Неопределено.
	Результат.Вставить("ОбъектыЯчеек", Новый Массив);
	Возврат Результат;

КонецФункции

Процедура ЗаполнитьРезультат(Результат, РезультатЗапроса, МаксимумСтрок)

	Результат.Успех = Истина;
	Если РезультатЗапроса = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИменаКолонок = Новый Массив;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		ИменаКолонок.Добавить(Колонка.Имя);
		Результат.Колонки.Добавить(Колонка.Имя);
	КонецЦикла;

	// Читаем не больше МаксимумСтрок + 1 строк, собираем ссылки для классификации физлиц.
	СырыеСтроки = Новый Массив;
	Ссылки = Новый Массив;
	ЭтоТаблица = ТипЗнч(РезультатЗапроса) = Тип("ТаблицаЗначений");
	Выборка = ?(ЭтоТаблица, Неопределено, РезультатЗапроса.Выбрать());
	НомерСтроки = 0;
	Пока ?(ЭтоТаблица, НомерСтроки < РезультатЗапроса.Количество(), Выборка.Следующий()) Цикл
		Запись = ?(ЭтоТаблица, РезультатЗапроса[НомерСтроки], Выборка);
		НомерСтроки = НомерСтроки + 1;
		Если СырыеСтроки.Количество() >= МаксимумСтрок Тогда
			Результат.Усечено = Истина;
			Прервать;
		КонецЕсли;
		Значения = Новый Массив;
		Для Каждого ИмяКолонки Из ИменаКолонок Цикл
			Значение = Запись[ИмяКолонки];
			Значения.Добавить(Значение);
			Если Значение <> Null И Значение <> Неопределено И ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Значение)) Тогда
				Ссылки.Добавить(Значение);
			КонецЕсли;
		КонецЦикла;
		СырыеСтроки.Добавить(Значения);
	КонецЦикла;

	ФизлицаСредиСсылок = ИИА_Периметр.ОтметитьСсылки(Ссылки);
	Регистрация = Новый Соответствие; // новые коммерческие пары: пишутся одной записью после цикла
	Скрыто = 0;
	ИндексыОбъектов = Новый Соответствие; // ссылка -> индекс в Результат.Объекты
	Для Каждого Значения Из СырыеСтроки Цикл
		СтрокаРезультата = Новый Массив;
		ОбъектыСтроки = Новый Массив;
		Для Каждого Значение Из Значения Цикл
			СкрытоДо = Скрыто;
			Безопасное = ИИА_Периметр.БезопасноеЗначение(Значение, ФизлицаСредиСсылок, Скрыто, Регистрация);
			СтрокаРезультата.Добавить(Безопасное);
			// Ссылкой в чате становится только значение, которое периметр показал без замен.
			Индекс = Неопределено;
			Если Скрыто = СкрытоДо И ЗначениеЗаполнено(Значение) И ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Значение))
				И Не Перечисления.ТипВсеСсылки().СодержитТип(ТипЗнч(Значение)) Тогда
				Индекс = ИндексыОбъектов.Получить(Значение);
				Если Индекс = Неопределено Тогда
					// Навигационная ссылка есть не у всех ссылочных типов (например, точки маршрута): такие не открываем.
					Попытка
						Навигация = ПолучитьНавигационнуюСсылку(Значение);
					// Необязательная навигация; маскированное значение сохраняется без ссылки открытия.
					Исключение // BSLLS:MissingCodeTryCatchEx-off
						Навигация = "";
					КонецПопытки;
					Если ЗначениеЗаполнено(Навигация) Тогда
						Результат.Объекты.Добавить(Новый Структура("Текст, Ссылка, Значение", Безопасное, Навигация, Значение));
						Индекс = Результат.Объекты.ВГраница();
						ИндексыОбъектов.Вставить(Значение, Индекс);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			ОбъектыСтроки.Добавить(Индекс);
		КонецЦикла;
		Результат.Строки.Добавить(СтрокаРезультата);
		Результат.ОбъектыЯчеек.Добавить(ОбъектыСтроки);
	КонецЦикла;
	ИИА_Маскирование.ЗаписатьПсевдонимы(Регистрация);
	Результат.Скрыто = Скрыто;

КонецПроцедуры

Процедура ЗафиксироватьНарушение(Контекст, Код, Текст)

	Если Не ЗначениеЗаполнено(Контекст.Нарушение) Тогда
		Контекст.Нарушение = Текст;
		Контекст.КодНарушения = Код;
	КонецЕсли;

КонецПроцедуры

Функция ИмяСобытияЖурнала()

	Возврат НСтр("ru = 'ИИАссистент.ГраницаЗапроса'", ОбщегоНазначения.КодОсновногоЯзыка());

КонецФункции

#КонецОбласти

#КонецОбласти
