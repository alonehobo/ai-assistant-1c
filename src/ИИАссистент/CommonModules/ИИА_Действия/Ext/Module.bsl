КонецФункции

Функция ВидДействияЗаписи()

	Возврат "Запись";

КонецФункции

Функция ТекстЛимитаКарточек()

	Возврат НСтр("ru = 'За один ответ предлагается не больше одной карточки (черновик или изменение).'");

КонецФункции

Функция ТекстВнешнейТранзакции()

	Возврат НСтр("ru = 'Изменение нельзя выполнить внутри открытой транзакции (IN_TRANSACTION).'");

КонецФункции

Функция ЭтоВидДляЗаписи(ОбъектМетаданных)

	Возврат ОбъектМетаданных <> Неопределено
		И (Метаданные.Документы.Содержит(ОбъектМетаданных) Или Метаданные.Справочники.Содержит(ОбъектМетаданных));

КонецФункции

// Контекст проверок изменения: правила профиля (при выполнении - без кэша), чьи права проверять, канал хода.
Функция КонтекстИзменения(Правила, ПользовательИБ, Канал)

	Возврат Новый Структура("Правила, ПользовательИБ, Канал", Правила, ПользовательИБ, Канал);

КонецФункции

// Ссылка объекта хода по метке o<N>; Неопределено - не метка или метка без объекта.
Функция ОбъектПоМетке(Метка, ОбъектыХода)

	Текст = НРег(СокрЛП(Строка(Метка)));
	Если СтрДлина(Текст) < 2 Или Лев(Текст, 1) <> "o" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Цифры = Сред(Текст, 2);
	Для Позиция = 1 По СтрДлина(Цифры) Цикл
		Если СтрНайти("0123456789", Сред(Цифры, Позиция, 1)) = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Индекс = Число(Цифры) - 1;
	Если Индекс < 0 Или Индекс > ОбъектыХода.ВГраница() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Объект = ОбъектыХода[Индекс];
	Значение = Неопределено;
	Если ТипЗнч(Объект) = Тип("Структура") И Объект.Свойство("Значение", Значение)
		И ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Значение)) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Проверки 9, 1 (по виду) и 2: внешняя транзакция, вид документа или справочника вне периметра и профиля,
// разрешение операции в строке «Запись данных» профиля.
Функция ПроверитьВидИОперацию(Ссылка, Операция, Контекст)

	Проверка = Новый Структура("Код, Текст, ОбъектМетаданных, Разрешение", "", "", Неопределено, Неопределено);
	Если ТранзакцияАктивна() Тогда
		Проверка.Код = "IN_TRANSACTION";
		Проверка.Текст = ТекстВнешнейТранзакции();
		Возврат Проверка;
	КонецЕсли;
	ОбъектМетаданных = ?(ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Ссылка)), Метаданные.НайтиПоТипу(ТипЗнч(Ссылка)), Неопределено);
	Если Не ЭтоВидДляЗаписи(ОбъектМетаданных)
		Или ИИА_Периметр.ОбъектЗапрещен(ОбъектМетаданных.ПолноеИмя(), , Контекст.Правила)
		Или ИИА_Периметр.ТипЗапрещен(ТипЗнч(Ссылка), , Контекст.Правила) Тогда
		Проверка.Код = "PERIMETER_VIOLATION";
		Проверка.Текст = НСтр("ru = 'Ассистент изменяет только документы и элементы справочников, доступные ему по периметру и профилю.'");
		Возврат Проверка;
	КонецЕсли;
	Проверка.ОбъектМетаданных = ОбъектМетаданных;
	Разрешение = РазрешенияЗаписи(Контекст.Правила).Получить(ВРег(ОбъектМетаданных.ПолноеИмя()));
	Если Разрешение = Неопределено Или Не ОперацияРазрешена(Разрешение, Операция)
		Или Не Метаданные.Документы.Содержит(ОбъектМетаданных) И (Операция = "post" Или Операция = "unpost") Тогда
		Проверка.Код = "ACTION_NOT_ALLOWED";
		Проверка.Текст = СтрШаблон(НСтр("ru = 'Операция %1 для %2 не разрешена профилем доступа.'"), Операция,
			ОбъектМетаданных.ПолноеИмя());
		Возврат Проверка;
	КонецЕсли;
	Проверка.Разрешение = Разрешение;
	Возврат Проверка;

КонецФункции

// Реквизит шапки, который можно записывать: реквизит метаданных или стандартный Наименование справочника.
//
// Возвращаемое значение:
//  Структура, Неопределено - Имя, Представление, Тип (ОписаниеТипов), Метаданные (ОбъектМетаданных; Неопределено -
//    стандартный реквизит).
//
Функция РеквизитЗаписи(ОбъектМетаданных, Имя)

	Реквизит = ОбъектМетаданных.Реквизиты.Найти(Имя);
	Если Реквизит <> Неопределено Тогда
		Возврат Новый Структура("Имя, Представление, Тип, Метаданные", Реквизит.Имя, Реквизит.Представление(),
			Реквизит.Тип, Реквизит);
	КонецЕсли;
	Если ВРег(Имя) = "НАИМЕНОВАНИЕ" И Метаданные.Справочники.Содержит(ОбъектМетаданных)
		И ОбъектМетаданных.ДлинаНаименования > 0 Тогда
		Стандартный = ОбъектМетаданных.СтандартныеРеквизиты.Наименование;
		Возврат Новый Структура("Имя, Представление, Тип, Метаданные", "Наименование", Стандартный.Представление(),
			Стандартный.Тип, Неопределено);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Проверка 5 по именам полей (без значений) и право «Редактирование» на реквизит.
//
// Параметры:
//  Поля - Соответствие - ключи: имена реквизитов.
//
// Возвращаемое значение:
//  Структура - Права (Массив из Строка - поля без права редактирования), Поля (Массив из Строка - имя и причина).
//
Функция ОтказыПолей(ОбъектМетаданных, Разрешение, Поля, Контекст)

	Отказы = Новый Структура("Права, Поля", Новый Массив, Новый Массив);
	Блокируемые = БлокируемыеРеквизиты(ОбъектМетаданных.ПолноеИмя());
	Для Каждого КлючИЗначение Из Поля Цикл
		Имя = СокрЛП(Строка(КлючИЗначение.Ключ));
		Причина = ПричинаОтказаПоля(ОбъектМетаданных, Имя, Разрешение, Контекст, Блокируемые);
		Если Не ПустаяСтрока(Причина) Тогда
			Отказы.Поля.Добавить(Имя + ": " + Причина);
			Продолжить;
		КонецЕсли;
		Реквизит = РеквизитЗаписи(ОбъектМетаданных, Имя);
		Если Не ПравоРедактированияРеквизита(ОбъектМетаданных, Реквизит, Контекст.ПользовательИБ) Тогда
			Отказы.Права.Добавить(Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Отказы;

КонецФункции

// Почему поле нельзя записывать; пусто - можно. Без контекста (проверка строки профиля при записи) - только то,
// что не зависит от пользователя: реквизит шапки, периметр ассистента, секрет, маскирование. С контекстом -
// ещё список реквизитов профиля, периметр и профиль пользователя, значение, скрытое от модели, блокируемые БСП.
//
// Параметры:
//  Разрешение - ФиксированнаяСтруктура, Неопределено - см. ИИА_ПрофилиДоступа.РазрешениеЗаписи.
//  Контекст - Структура, Неопределено - см. КонтекстИзменения.
//  Блокируемые - Массив из Строка - см. БлокируемыеРеквизиты.
//
// Возвращаемое значение:
//  Строка
//
Функция ПричинаОтказаПоля(ОбъектМетаданных, Имя, Разрешение, Контекст, Блокируемые)

	Реквизит = РеквизитЗаписи(ОбъектМетаданных, Имя);
	Если Реквизит = Неопределено Тогда
		Возврат НСтр("ru = 'нет такого реквизита шапки (стандартные реквизиты, кроме Наименование справочника, не изменяются)'");
	КонецЕсли;
	ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	Если ИИА_Периметр.ОписаниеПериметра().ЗапрещенныеПоля.Получить(ВРег(ПолноеИмя + "." + Реквизит.Имя)) <> Неопределено
		Или ИИА_Периметр.ЭтоИмяСекрета(Реквизит.Имя) Тогда
		Возврат НСтр("ru = 'вне периметра ассистента'");
	КонецЕсли;
	Маскируемые = ИИА_Маскирование.НастройкиМаскирования().Поля.Получить(ВРег(ПолноеИмя));
	Если Маскируемые <> Неопределено И Маскируемые.Получить(ВРег(Реквизит.Имя)) <> Неопределено Тогда
		Возврат НСтр("ru = 'маскируется и не записывается (MASKED_FIELD)'");
	ИначеЕсли Контекст = Неопределено Тогда
		Возврат "";
	ИначеЕсли Разрешение.Реквизиты.Количество() > 0 И Разрешение.Реквизиты.Найти(ВРег(Реквизит.Имя)) = Неопределено Тогда
		Возврат НСтр("ru = 'не разрешён профилем для записи'");
	ИначеЕсли ИИА_Периметр.ПолеЗапрещено(ПолноеИмя, Реквизит.Имя, , Контекст.Правила) Тогда
		Возврат НСтр("ru = 'закрыт периметром или профилем'");
	ИначеЕсли ЗначениеСкрытоОтМодели(Реквизит.Тип, Контекст.Правила) Тогда
		Возврат НСтр("ru = 'значение скрыто от модели'");
	ИначеЕсли Блокируемые.Найти(ВРег(Реквизит.Имя)) <> Неопределено Тогда
		Возврат НСтр("ru = 'блокируется после использования объекта (запрет редактирования реквизитов)'");
	КонецЕсли;
	Возврат "";

КонецФункции

// Поле, значения которого модель не видит (тип закрыт периметром или профилем): такое поле не записывается.
Функция ЗначениеСкрытоОтМодели(ОписаниеТипа, Правила)

	Для Каждого ТипЗначения Из ОписаниеТипа.Типы() Цикл
		Если ИИА_Периметр.ТипЗапрещен(ТипЗначения, , Правила) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Реквизиты, которые БСП блокирует после использования объекта (ВРег); без подсистемы - пусто. Блокируемые реквизиты
// ассистенту недоступны всегда: «используется ли объект» знает только форма.
Функция БлокируемыеРеквизиты(ПолноеИмя)

	Результат = Новый Массив;
	Если Не ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов") Тогда
		Возврат Результат;
	КонецЕсли;
	Модуль = ОбщегоНазначения.ОбщийМодуль("ЗапретРедактированияРеквизитовОбъектов");
	Для Каждого Имя Из Модуль.БлокируемыеРеквизитыОбъекта(ПолноеИмя) Цикл
		Результат.Добавить(ВРег(СокрЛП(Имя)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Право «Редактирование» на реквизит (на стандартный - через имя стандартного реквизита).
Функция ПравоРедактированияРеквизита(ОбъектМетаданных, Реквизит, ПользовательИБ)

	Если Реквизит.Метаданные = Неопределено И ПользовательИБ = Неопределено Тогда
		// Стандартный реквизит проверяется только формой с пользователем, а она требует права «Администрирование»:
		// для текущего пользователя вызов привилегированный, результат определяют его роли, а не режим.
		УстановитьПривилегированныйРежим(Истина);
		Разрешено = ПравоДоступа("Редактирование", ОбъектМетаданных, ПользователиИнформационнойБазы.ТекущийПользователь(),
			Реквизит.Имя);
		УстановитьПривилегированныйРежим(Ложь);
		Возврат Разрешено;
	ИначеЕсли Реквизит.Метаданные = Неопределено Тогда
		Возврат ПравоДоступа("Редактирование", ОбъектМетаданных, ПользовательИБ, Реквизит.Имя);
	ИначеЕсли ПользовательИБ = Неопределено Тогда
		Возврат ПравоДоступа("Редактирование", Реквизит.Метаданные);
	КонецЕсли;
	Возврат ПравоДоступа("Редактирование", Реквизит.Метаданные, ПользовательИБ);

КонецФункции

// Значение реквизита из текста модели (spec typed-write, «Разрешение значений»): метка o<N>, псевдоним, примитив,
// точное значение перечисления, ссылка по точному номеру или коду (для немаскируемых видов - и по точному
// наименованию). Подстрока и ПОДОБНО не используются.
//
// Возвращаемое значение:
//  Структура - Успех, Значение, Код (BAD_VALUE, AMBIGUOUS), Текст (без значений базы, кандидаты - псевдонимами).
//
Функция ЗначениеДляЗаписи(ОписаниеТипа, Текст, ИмяПоля, ОбъектыХода, Контекст)

	Результат = Новый Структура("Успех, Значение, Код, Текст", Ложь, Неопределено, "BAD_VALUE", "");
	Если ПустаяСтрока(Текст) Тогда
		Результат.Значение = ОписаниеТипа.ПривестиЗначение(Неопределено);
		Результат.Успех = Истина;
		Возврат Результат;
	КонецЕсли;
	Значение = ОбъектПоМетке(Текст, ОбъектыХода);
	Если Значение = Неопределено И ИИА_Маскирование.ЕстьПсевдоним(Текст) Тогда
		Значение = ИИА_Маскирование.ЗначениеИзПсевдонима(Текст, ОписаниеТипа);
		Если Значение = Неопределено Тогда
			Результат.Текст = СтрШаблон(НСтр("ru = '%1: псевдоним не подходит к типу реквизита, а текстом его записать нельзя (PSEUDONYM_AS_LITERAL)'"),
				ИмяПоля);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	Если Значение = Неопределено Тогда
		Значение = ПримитивИзТекста(ОписаниеТипа, Текст);
	КонецЕсли;
	Если Значение = Неопределено Тогда
		Поиск = СсылкаПоТексту(ОписаниеТипа, Текст, ИмяПоля, Контекст);
		Если Не Поиск.Успех Тогда
			Результат.Код = Поиск.Код;
			Результат.Текст = Поиск.Текст;
			Возврат Результат;
		КонецЕсли;
		Значение = Поиск.Значение;
	КонецЕсли;

	Если Не ОписаниеТипа.СодержитТип(ТипЗнч(Значение)) Тогда
		Результат.Текст = СтрШаблон(НСтр("ru = '%1: значение не подходит к типу реквизита'"), ИмяПоля);
	ИначеЕсли ОписаниеТипа.ПривестиЗначение(Значение) <> Значение Тогда
		Результат.Текст = СтрШаблон(НСтр("ru = '%1: значение не помещается в реквизит (длина или точность)'"), ИмяПоля);
	ИначеЕсли ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Значение)) И ЗначениеЗаполнено(Значение) И Не СсылкаДоступна(Значение, Контекст) Тогда
		Результат.Текст = СтрШаблон(НСтр("ru = '%1: объект значения недоступен ассистенту или пользователю'"), ИмяПоля);
	Иначе
		Результат.Успех = Истина;
		Результат.Код = "";
		Результат.Значение = Значение;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Дата ГГГГ-ММ-ДД[THH:MM:SS], число (точка или запятая), true/false, строка (только для реквизита без ссылочных типов).
Функция ПримитивИзТекста(ОписаниеТипа, Текст)

	Если ОписаниеТипа.СодержитТип(Тип("Дата")) И (СтрДлина(Текст) = 10 Или СтрДлина(Текст) = 19)
		И Сред(Текст, 5, 1) = "-" И Сред(Текст, 8, 1) = "-" Тогда
		Цифры = СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, "-", ""), "T", ""), ":", "");
		Попытка
			Возврат Дата(Лев(Цифры + "000000", 14));
		// Неверная дата - текст разбирается как значение другого типа.
		Исключение // BSLLS:MissingCodeTryCatchEx-off
		КонецПопытки;
	КонецЕсли;
	Если ОписаниеТипа.СодержитТип(Тип("Число")) Тогда
		Попытка
			Возврат Число(СтрЗаменить(Текст, ",", "."));
		// Не число - текст разбирается как значение другого типа.
		Исключение // BSLLS:MissingCodeTryCatchEx-off
		КонецПопытки;
	КонецЕсли;
	Если ОписаниеТипа.СодержитТип(Тип("Булево")) И (НРег(Текст) = "true" Или НРег(Текст) = "false") Тогда
		Возврат НРег(Текст) = "true";
	КонецЕсли;
	Если ОписаниеТипа.СодержитТип(Тип("Строка")) Тогда
		ЕстьСсылочные = Ложь;
		Для Каждого ТипЗначения Из ОписаниеТипа.Типы() Цикл
			ЕстьСсылочные = ЕстьСсылочные Или Метаданные.НайтиПоТипу(ТипЗначения) <> Неопределено;
		КонецЦикла;
		Если Не ЕстьСсылочные Тогда
			Возврат Текст;
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Точное значение перечисления (имя или синоним) или ссылка по точному номеру, коду, наименованию: ровно одно
// совпадение. Для видов, которые модель видит псевдонимами (ПДн всегда; коммерческие - пока действует коммерческое
// маскирование канала), поиска по наименованию нет: иначе ответ «найдено / не найдено» раскрывал бы скрытые имена.
Функция СсылкаПоТексту(ОписаниеТипа, Текст, ИмяПоля, Контекст)

	Результат = Новый Структура("Успех, Значение, Код, Текст", Ложь, Неопределено, "BAD_VALUE", "");
	Кандидаты = Новый Массив;
	ТекстыЗапросов = Новый Массив;
	БезПоискаПоИмени = Ложь;
	Коммерческое = ИИА_Маскирование.ДействуетКоммерческоеМаскирование(Контекст.Канал);
	Для Каждого ТипЗначения Из ОписаниеТипа.Типы() Цикл
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
		Если ОбъектМетаданных = Неопределено Тогда
			Продолжить;
		ИначеЕсли Метаданные.Перечисления.Содержит(ОбъектМетаданных) Тогда
			Для Каждого ЗначениеПеречисления Из ОбъектМетаданных.ЗначенияПеречисления Цикл
				Если НРег(ЗначениеПеречисления.Имя) = НРег(Текст) Или НРег(ЗначениеПеречисления.Синоним) = НРег(Текст) Тогда
					Кандидаты.Добавить(Перечисления[ОбъектМетаданных.Имя][ЗначениеПеречисления.Имя]);
				КонецЕсли;
			КонецЦикла;
			Продолжить;
		КонецЕсли;
		ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
		ЭтоДокумент = Метаданные.Документы.Содержит(ОбъектМетаданных);
		Если Не ЭтоДокумент И Не Метаданные.Справочники.Содержит(ОбъектМетаданных)
			Или ИИА_Периметр.ОбъектЗапрещен(ПолноеИмя, , Контекст.Правила)
			Или ИИА_Периметр.ТипЗапрещен(ТипЗначения, , Контекст.Правила)
			Или Не ПравоДоступа("Чтение", ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		Скрытый = ИИА_Периметр.ЭтоМаскируемыйТип(ТипЗначения)
			Или Коммерческое И ИИА_Маскирование.НастройкиМаскирования().ПоТипу.Получить(ТипЗначения) <> Неопределено;
		Условия = Новый Массив;
		Если ЭтоДокумент Тогда
			ДобавитьУсловиеПоиска(Условия, БезПоискаПоИмени, ПолноеИмя, "Номер", ОбъектМетаданных.ДлинаНомера > 0
				И ОбъектМетаданных.ТипНомера = Метаданные.СвойстваОбъектов.ТипНомераДокумента.Строка, Ложь, Контекст);
		Иначе
			ДобавитьУсловиеПоиска(Условия, БезПоискаПоИмени, ПолноеИмя, "Код", ОбъектМетаданных.ДлинаКода > 0
				И ОбъектМетаданных.ТипКода = Метаданные.СвойстваОбъектов.ТипКодаСправочника.Строка, Ложь, Контекст);
			ДобавитьУсловиеПоиска(Условия, БезПоискаПоИмени, ПолноеИмя, "Наименование",
				ОбъектМетаданных.ДлинаНаименования > 0, Скрытый, Контекст);
		КонецЕсли;
		Если Условия.Количество() > 0 Тогда
			// Источник из разрешённых метаданных, условия - из фиксированных строк.
			// BSLLS:QueryParseError-off
			ТекстыЗапросов.Добавить(СтрШаблон(
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2 Т.Ссылка КАК Ссылка ИЗ %1 КАК Т ГДЕ НЕ Т.ПометкаУдаления И (%2)",
				ПолноеИмя, СтрСоединить(Условия, " ИЛИ ")));
			// BSLLS:QueryParseError-on
		КонецЕсли;
	КонецЦикла;

	Если ТекстыЗапросов.Количество() > 0 Тогда
		Запрос = Новый Запрос(СтрСоединить(ТекстыЗапросов, ";" + Символы.ПС));
		Запрос.УстановитьПараметр("Текст", Текст);
		Попытка
			РезультатыПакета = Запрос.ВыполнитьПакет();
		Исключение
			ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
				ИИА_Периметр.ОчиститьТекст(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			Результат.Текст = СтрШаблон(НСтр("ru = '%1: не удалось найти значение'"), ИмяПоля);
			Возврат Результат;
		КонецПопытки;
		Для Каждого РезультатЗапроса Из РезультатыПакета Цикл
			Для Каждого Найденный Из РезультатЗапроса.Выгрузить() Цикл
				Кандидаты.Добавить(Найденный.Ссылка);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	Если Кандидаты.Количество() = 1 Тогда
		Результат.Успех = Истина;
		Результат.Код = "";
		Результат.Значение = Кандидаты[0];
	ИначеЕсли Кандидаты.Количество() = 0 И БезПоискаПоИмени Тогда
		Результат.Текст = СтрШаблон(НСтр("ru = '%1: укажи объект меткой из результатов поиска (o1, o2, ...) или псевдонимом - поиск по наименованию для этого вида недоступен'"),
			ИмяПоля);
	ИначеЕсли Кандидаты.Количество() = 0 Тогда
		Результат.Текст = СтрШаблон(НСтр("ru = '%1: точное значение «%2» не найдено - найди объект find_records и передай его метку'"),
			ИмяПоля, Текст);
	Иначе
		Признаки = ИИА_Маскирование.ОтметитьСсылки(Кандидаты);
		Регистрация = Новый Соответствие;
		Представления = Новый Массив;
		Для Каждого Кандидат Из Кандидаты Цикл
			Представления.Добавить(ИИА_Маскирование.ЗначениеДляМодели(Кандидат, Признаки, , Регистрация));
		КонецЦикла;
		ИИА_Маскирование.ЗаписатьПсевдонимы(Регистрация);
		Результат.Код = "AMBIGUOUS";
		Результат.Текст = СтрШаблон(НСтр("ru = '%1: «%2» неоднозначно (%3) - уточни у пользователя или передай метку объекта'"),
			ИмяПоля, Текст, СтрСоединить(Представления, "; "));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Условие точного поиска по номеру, коду или наименованию. Поле, которое модель не видит (вид маскируется или поле
// закрыто периметром или профилем), не ищется: ответ «найдено / не найдено» раскрыл бы его значение.
Процедура ДобавитьУсловиеПоиска(Условия, БезПоиска, ПолноеИмя, ИмяПоля, ПолеЕсть, Скрытый, Контекст)

	Если Не ПолеЕсть Тогда
		Возврат;
	ИначеЕсли Скрытый Или ИИА_Периметр.ПолеЗапрещено(ПолноеИмя, ИмяПоля, , Контекст.Правила) Тогда
		БезПоиска = Истина;
	Иначе
		Условия.Добавить("Т." + ИмяПоля + " = &Текст");
	КонецЕсли;

КонецПроцедуры

// Объект значения доступен: не закрыт периметром и профилем, читается пользователем (РАЗРЕШЕННЫЕ, RLS БСП).
Функция СсылкаДоступна(Ссылка, Контекст)

	ОбъектМетаданных = Ссылка.Метаданные();
	Если ИИА_Периметр.ОбъектЗапрещен(ОбъектМетаданных.ПолноеИмя(), , Контекст.Правила)
		Или ИИА_Периметр.ТипЗапрещен(ТипЗнч(Ссылка), , Контекст.Правила) Тогда
		Возврат Ложь;
	ИначеЕсли Метаданные.Перечисления.Содержит(ОбъектМетаданных) Тогда
		Возврат Истина;
	ИначеЕсли Не ПравоДоступа("Чтение", ОбъектМетаданных) Тогда
		Возврат Ложь;
	КонецЕсли;
	// Источник из метаданных самой ссылки.
	// BSLLS:QueryParseError-off
	Запрос = Новый Запрос(СтрШаблон("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ %1 КАК Т ГДЕ Т.Ссылка = &Ссылка",
		ОбъектМетаданных.ПолноеИмя()));
	// BSLLS:QueryParseError-on
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		Возврат ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом").ЧтениеРазрешено(Ссылка);
	КонецЕсли;
	Возврат Истина;

КонецФункции

// Проверка 6: класс данных допустим для модели хода (как маршрутизация ИИА_Агент, но до прогона и карточки).
Функция КлассДопустим(Класс, Настройки)

	Если Настройки.МаксимальныйКласс <> Неопределено Тогда
		Возврат Класс <= Настройки.МаксимальныйКласс;
	КонецЕсли;
	Возврат Класс <= Настройки.КлассХода Или ИИА_LLM.ЕстьПодключениеДляИсследования(Класс, Настройки.Модель);

КонецФункции

// Читает объект в правах пользователя, применяет изменения в памяти и проверяет: проверка 1 по объекту (группа,
// предопределённый), 7 (есть что менять) и 3 - ПрепятствияОперации по объекту с изменениями.
//
// Возвращаемое значение:
//  Структура - Код, Текст, Изменения (Массив из Структура - Имя, Было, Стало), ВерсияДанных, Перепроведение,
//    Предупреждения (Массив из Строка).
//
Функция ПодготовитьИзменение(Ссылка, Операция, Значения, Контекст)

	Подготовка = Новый Структура("Код, Текст, Изменения, ВерсияДанных, Перепроведение, Предупреждения", "", "",
		Новый Массив, "", Ложь, Новый Массив);
	Попытка
		Объект = Ссылка.ПолучитьОбъект();
	Исключение
		// Нет права чтения объекта: тот же отказ, что и по правам на операцию.
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Информация, , ,
			ИИА_Периметр.ОчиститьТекст(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		Подготовка.Код = "ACCESS_DENIED";
		Подготовка.Текст = НСтр("ru = 'Нет доступа к объекту.'");
		Возврат Подготовка;
	КонецПопытки;
	Если Объект = Неопределено Тогда
		Подготовка.Код = "NOT_FOUND";
		Подготовка.Текст = НСтр("ru = 'Объект не найден.'");
		Возврат Подготовка;
	КонецЕсли;
	Подготовка.Текст = ОтказСостава(Объект);
	Если Не ПустаяСтрока(Подготовка.Текст) Тогда
		Подготовка.Код = "PERIMETER_VIOLATION";
		Возврат Подготовка;
	КонецЕсли;
	Подготовка.ВерсияДанных = Объект.ВерсияДанных;
	Для Каждого КлючИЗначение Из Значения Цикл
		Было = Объект[КлючИЗначение.Ключ];
		Если Было <> КлючИЗначение.Значение Тогда
			Подготовка.Изменения.Добавить(Новый Структура("Имя, Было, Стало", КлючИЗначение.Ключ, Было, КлючИЗначение.Значение));
			Объект[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
		КонецЕсли;
	КонецЦикла;
	Если Операция = "set_fields" И Подготовка.Изменения.Количество() = 0 Тогда
		Подготовка.Код = "NOTHING_TO_DO";
		Подготовка.Текст = НСтр("ru = 'Все указанные значения уже установлены: менять нечего.'");
		Возврат Подготовка;
	КонецЕсли;
	Препятствия = ПрепятствияОперации(Объект, ОперацияПрав(Операция), Контекст.ПользовательИБ);
	Если Не Препятствия.Допустимо Тогда
		Подготовка.Код = КодПрепятствия(Препятствия);
		Подготовка.Текст = ТекстПрепятствий(Препятствия);
		Возврат Подготовка;
	КонецЕсли;

	ЭтоДокумент = Метаданные.Документы.Содержит(Объект.Метаданные());
	Проведен = ЭтоДокумент И Объект.Проведен;
	Подготовка.Перепроведение = Операция = "set_fields" И Проведен;
	Если Подготовка.Перепроведение Тогда
		Подготовка.Предупреждения.Добавить(НСтр("ru = 'Документ проведён: при записи он будет перепроведён.'"));
	ИначеЕсли Операция = "mark_deletion" И Проведен Тогда
		Подготовка.Предупреждения.Добавить(НСтр("ru = 'При пометке на удаление платформа отменит проведение документа.'"));
	ИначеЕсли Операция = "mark_deletion" И Не ЭтоДокумент И ЕстьПодчиненныеСправочники(Объект.Метаданные()) Тогда
		Подготовка.Предупреждения.Добавить(НСтр("ru = 'Подчинённые элементы других справочников платформа тоже пометит на удаление.'"));
	КонецЕсли;
	Возврат Подготовка;

КонецФункции

// Проверка 1 по объекту: группы и предопределённые элементы справочников не изменяются.
Функция ОтказСостава(Объект)

	ОбъектМетаданных = Объект.Метаданные();
	Если Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
		Возврат "";
	КонецЕсли;
	ЭтоГруппа = ОбъектМетаданных.Иерархический
		И ОбъектМетаданных.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов
		И Объект.ЭтоГруппа;
	Если ЭтоГруппа Или Объект.Предопределенный Тогда
		Возврат НСтр("ru = 'Группы и предопределённые элементы справочников ассистент не изменяет.'");
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ЕстьПодчиненныеСправочники(ОбъектМетаданных)

	Для Каждого Справочник Из Метаданные.Справочники Цикл
		Если Справочник.Владельцы.Содержит(ОбъектМетаданных) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Код отказа по препятствиям ПрепятствияОперации: права и RLS - ACCESS_DENIED, дата запрета - CHANGE_PROHIBITED.
Функция КодПрепятствия(Препятствия)

	Коды = Новый Массив;
	Для Каждого Причина Из Препятствия.Причины Цикл
		Коды.Добавить(Причина.Код);
	КонецЦикла;
	Если Коды.Найти("ACCESS_DENIED") <> Неопределено Или Коды.Найти("RLS_DENIED") <> Неопределено Тогда
		Возврат "ACCESS_DENIED";
	ИначеЕсли Коды.Найти("CHANGE_PROHIBITED") <> Неопределено Тогда
		Возврат "CHANGE_PROHIBITED";
	ИначеЕсли Коды.Найти("BAD_STATE") <> Неопределено Тогда
		Возврат "BAD_STATE";
	КонецЕсли;
	Возврат "PERIMETER_VIOLATION";

КонецФункции

Функция ТекстПрепятствий(Препятствия)

	Тексты = Новый Массив;
	Для Каждого Причина Из Препятствия.Причины Цикл
		Тексты.Добавить(Причина.Текст);
	КонецЦикла;
	Возврат СтрСоединить(ИИА_Маскирование.ТекстыДляМодели(Тексты), " ");

КонецФункции

// Пробный прогон через общий помощник изолированного выполнения (тайм-аут 60 с в клиент-серверной базе).
//
// Возвращаемое значение:
//  Структура - done, ok, stage, messages (Массив из Строка - в исходном виде, для пользователя), error.
//
Функция ПробныйПрогон(Ссылка, Операция, ЗначенияXML, Запрещен)

	Прогон = Новый Структура("done, ok, stage, messages, error", Ложь, Ложь, "", Новый Массив, "");
	Если Запрещен Тогда
		Возврат Прогон;
	КонецЕсли;
	ПараметрыМетода = Новый Массив;
	ПараметрыМетода.Добавить(Ссылка);
	ПараметрыМетода.Добавить(Операция);
	ПараметрыМетода.Добавить(ЗначенияXML);
	Ответ = ИИА_ИзолированноеВыполнение.ВыполнитьМетод("ИИА_Действия.ВыполнитьПробныйПрогон", ПараметрыМетода, 60,
		НСтр("ru = 'ИИА: пробный прогон изменения'"));
	Прогон.done = Истина;
	Если Ответ.Успех И ТипЗнч(Ответ.Результат) = Тип("Структура") Тогда
		Прогон.ok = Ответ.Результат.ok;
		Прогон.stage = Ответ.Результат.stage;
		Прогон.error = Ответ.Результат.error;
	Иначе
		Прогон.stage = ?(Ответ.КодОшибки = "TIMEOUT", "timeout", "error");
		Прогон.error = Ответ.ТекстОшибки;
	КонецЕсли;
	Если Не ПустаяСтрока(Прогон.error) Тогда
		Прогон.messages.Добавить(Прогон.error);
	КонецЕсли;
	Для Каждого Сообщение Из Ответ.Сообщения Цикл
		Если Прогон.messages.Количество() < 20 И Не ПустаяСтрока(Сообщение.Текст) Тогда
			Прогон.messages.Добавить(Лев(Сообщение.Текст, 300));
		КонецЕсли;
	КонецЦикла;
	Возврат Прогон;

КонецФункции

// Итог прогона для модели: сообщения - через текстовый слой маскирования, не больше 10 по 300 символов.
Функция ПрогонДляМодели(Прогон)

	Итог = Новый Структура("done", Прогон.done);
	Если Не Прогон.done Тогда
		Возврат Итог;
	КонецЕсли;
	Первые = Новый Массив;
	Для Каждого Текст Из Прогон.messages Цикл
		Если Первые.Количество() < 10 Тогда
			Первые.Добавить(Лев(Текст, 300));
		КонецЕсли;
	КонецЦикла;
	Итог.Вставить("ok", Прогон.ok);
	Итог.Вставить("stage", Прогон.stage);
	Итог.Вставить("messages", ИИА_Маскирование.ТекстыДляМодели(Первые));
	Итог.Вставить("messages_hidden", Прогон.messages.Количество() - Первые.Количество());
	Возврат Итог;

КонецФункции

// ДанныеJSON предложения: ref, before / after (имя -> XML), repost, dry_run, warnings, summary.
Функция ДанныеПредложения(Ссылка, Подготовка, Прогон, Сводка)

	Было = Новый Соответствие;
	Стало = Новый Соответствие;
	Для Каждого Изменение Из Подготовка.Изменения Цикл
		Было.Вставить(Изменение.Имя, ОбщегоНазначения.ЗначениеВСтрокуXML(Изменение.Было));
		Стало.Вставить(Изменение.Имя, ОбщегоНазначения.ЗначениеВСтрокуXML(Изменение.Стало));
	КонецЦикла;
	Данные = Новый Структура;
	Данные.Вставить("ref", ОбщегоНазначения.ЗначениеВСтрокуXML(Ссылка));
	Данные.Вставить("before", Было);
	Данные.Вставить("after", Стало);
	Данные.Вставить("repost", Подготовка.Перепроведение);
	Данные.Вставить("dry_run", Новый Структура("done, ok, stage, messages", Прогон.done, Прогон.ok, Прогон.stage,
		Прогон.messages));
	Данные.Вставить("warnings", Подготовка.Предупреждения);
	Данные.Вставить("summary", Сводка);
	Возврат ОбщегоНазначения.ЗначениеВJSON(Данные);

КонецФункции

Процедура СохранитьПредложение(Идентификатор, Диалог, ПолноеИмя, Операция, ВерсияДанных, Данные, ЕстьЧужойТекст, Прогон)

	УстановитьПривилегированныйРежим(Истина);
	Запись = РегистрыСведений.ИИА_ОжидающиеДействия.СоздатьМенеджерЗаписи();
	Запись.Идентификатор = Идентификатор;
	Запись.Пользователь = Пользователи.ТекущийПользователь();
	Запись.Диалог = ?(ЗначениеЗаполнено(Диалог), Диалог, Неопределено);
	Запись.ПолноеИмя = ПолноеИмя;
	Запись.ВидДействия = ВидДействияЗаписи();
	Запись.Операция = Операция;
	Запись.ВерсияДанных = Строка(ВерсияДанных);
	Запись.ДанныеJSON = Данные;
	Запись.Хеш = ХешПредложения(Запись);
	Запись.Создано = ТекущаяДатаСеанса();
	Запись.СрокДействия = ТекущаяДатаСеанса() + 1800;
	Запись.Статус = "Ожидает";
	Запись.ЕстьЧужойТекст = ЕстьЧужойТекст;
	Запись.Записать();
	УстановитьПривилегированныйРежим(Ложь);
	КодПрогона = ?(Не Прогон.done, "DRY_RUN_SKIPPED", ?(Прогон.ok, "DRY_RUN_OK", "DRY_RUN_FAILED"));
	ЗаписатьЖурналДействия(Запись, "Ожидает", КодПрогона + ". "
		+ ПодробностиИзменения(ОбщегоНазначения.JSONВЗначение(Данные, , Истина)));

КонецПроцедуры

// Контроль целостности предложения: вид, полное имя, операция, версия данных и всё содержимое (ref, было/стало).
Функция ХешПредложения(Запись)

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Запись.ВидДействия + Символы.ПС + Запись.ПолноеИмя + Символы.ПС + Запись.Операция + Символы.ПС + Запись.ВерсияДанных
		+ Символы.ПС + Запись.ДанныеJSON);
	Возврат Base64Строка(Хеширование.ХешСумма);

КонецФункции

// Запись изменения в одной транзакции: блокировка предложения (двойной клик), объектная блокировка, ВерсияДанных,
// повторная ПрепятствияОперации по объекту с изменениями, проверка заполнения, запись, статус «Выполнено».
//
// Возвращаемое значение:
//  Структура - Статус (Выполнено, Отказ, Ошибка, Ожидает - объект открыт в форме, Обработано), Текст, Подробности
//    (для журнала регистрации), Сообщения (Массив из Строка).
//
Функция ЗаписатьИзменение(Запись, Ссылка, Значения, Контекст)

	Исход = Новый Структура("Статус, Текст, Подробности, Сообщения", "", "", "", Новый Массив);
	СообщенийДо = ПолучитьСообщенияПользователю(Ложь).Количество();
	НачатьТранзакцию();
	Попытка
		// Отказ (в том числе после перехваченной ошибки Заблокировать) отменяет транзакцию: фиксировать нечего,
		// а фиксация транзакции с перехваченной ошибкой могла бы завершиться исключением.
		Если ПрименитьВТранзакции(Запись, Ссылка, Значения, Контекст, Исход, СообщенийДо) Тогда
			ЗафиксироватьТранзакцию();
		Иначе
			ОтменитьТранзакцию(); // BSLLS:WrongUseOfRollbackTransactionMethod-off
		КонецЕсли;
	// Ошибка записи возвращается в Исход и пишется в журналы через ЗавершитьВыполнение.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		ОтменитьТранзакцию();
		ИнформацияОшибки = ИнформацияОбОшибке();
		Исход.Статус = "Ошибка";
		Исход.Текст = Лев(ИИА_Периметр.ОчиститьТекст(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОшибки)), 500);
		Исход.Подробности = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОшибки);
		Исход.Сообщения = СообщенияСеанса(СообщенийДо);
	КонецПопытки;
	Возврат Исход;

КонецФункции

// Тело транзакции ЗаписатьИзменение: Истина - объект записан и статус «Выполнено» записан, транзакцию фиксировать.
Функция ПрименитьВТранзакции(Запись, Ссылка, Значения, Контекст, Исход, СообщенийДо)

	ЗаблокироватьПредложение(Запись.Идентификатор);
	Если ТекущийСтатус(Запись.Идентификатор) <> "Ожидает" Тогда
		Исход.Статус = "Обработано";
		Исход.Текст = НСтр("ru = 'Предложение уже обработано.'");
		Возврат Ложь;
	КонецЕсли;

	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Исход.Статус = "Отказ";
		Исход.Текст = НСтр("ru = 'Объект не найден.'");
		Возврат Ложь;
	КонецЕсли;
	Если Не ОбъектЗаблокирован(Объект) Тогда
		Исход.Статус = "Ожидает";
		Исход.Текст = НСтр("ru = 'Объект сейчас открыт для редактирования (в вашей или другой форме). Закройте форму объекта и нажмите «Выполнить» ещё раз.'");
		Возврат Ложь;
	КонецЕсли;
	Если Строка(Объект.ВерсияДанных) <> Запись.ВерсияДанных Тогда
		Исход.Статус = "Отказ";
		Исход.Текст = НСтр("ru = 'Объект изменён после предложения. Попросите ассистента предложить изменение заново.'");
		Возврат Ложь;
	КонецЕсли;
	ТекстОтказа = ОтказСостава(Объект);
	Если Не ПустаяСтрока(ТекстОтказа) Тогда
		Исход.Статус = "Отказ";
		Исход.Текст = ТекстОтказа;
		Возврат Ложь;
	КонецЕсли;
	Для Каждого КлючИЗначение Из Значения Цикл
		Объект[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
	КонецЦикла;
	Препятствия = ПрепятствияОперации(Объект, ОперацияПрав(Запись.Операция), Контекст.ПользовательИБ);
	Если Не Препятствия.Допустимо Тогда
		Исход.Статус = "Отказ";
		Исход.Текст = ТекстПрепятствий(Препятствия);
		Возврат Ложь;
	КонецЕсли;
	Если НужнаПроверкаЗаполнения(Объект, Запись.Операция) И Не Объект.ПроверитьЗаполнение() Тогда
		Исход.Статус = "Отказ";
		Исход.Текст = НСтр("ru = 'Объект не прошёл проверку заполнения: изменение не записано.'");
		Исход.Сообщения = СообщенияСеанса(СообщенийДо);
		Возврат Ложь;
	КонецЕсли;

	ЗаписатьОперацию(Объект, Запись.Операция);
	Исход.Статус = "Выполнено";
	Исход.Сообщения = СообщенияСеанса(СообщенийДо);
	Данные = ОбщегоНазначения.JSONВЗначение(Запись.ДанныеJSON, , Истина);
	// Предложение уже заблокировано этой транзакцией и в статусе «Ожидает».
	ЗаписатьСтатус(Запись, "Выполнено", ПодробностиИзменения(Данные),
		ИтогВыполненияJSON(НСтр("ru = 'Изменение записано.'"), Исход.Сообщения));
	Возврат Истина;

КонецФункции

// Объектная блокировка; Ложь - объект заблокирован другой формой или сеансом.
Функция ОбъектЗаблокирован(Объект)

	Попытка
		Объект.Заблокировать();
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Информация, , ,
			ИИА_Периметр.ОчиститьТекст(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;

КонецФункции

// Сообщения сеанса, появившиеся после СообщенийДо; очередь не очищается - они остаются в окне сообщений.
Функция СообщенияСеанса(СообщенийДо)

	Тексты = Новый Массив;
	Все = ПолучитьСообщенияПользователю(Ложь);
	Для Индекс = СообщенийДо По Все.ВГраница() Цикл
		Если Тексты.Количество() < 20 Тогда
			Тексты.Добавить(Лев(Все[Индекс].Текст, 300));
		КонецЕсли;
	КонецЦикла;
	Возврат Тексты;

КонецФункции

// Проверка заполнения перед записью и проведением (как форма): программная запись, в том числе в режиме
// проведения, ПроверитьЗаполнение сама не вызывает.
Функция НужнаПроверкаЗаполнения(Объект, Операция)

	Возврат Операция = "set_fields" Или Операция = "post";

КонецФункции

Функция ЭтапЗаписи(Объект, Операция)

	Если Операция = "post" Или Операция = "set_fields" И Метаданные.Документы.Содержит(Объект.Метаданные())
		И Объект.Проведен Тогда
		Возврат "post";
	КонецЕсли;
	Возврат "write";

КонецФункции

// Запись по операции: штатная, без ОбменДанными.Загрузка и без привилегированного режима.
Процедура ЗаписатьОперацию(Объект, Операция)

	Если Операция = "mark_deletion" Или Операция = "unmark_deletion" Тогда
		Объект.УстановитьПометкуУдаления(Операция = "mark_deletion");
	ИначеЕсли Не Метаданные.Документы.Содержит(Объект.Метаданные()) Тогда
		Объект.Записать();
	ИначеЕсли Операция = "unpost" Тогда
		Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	ИначеЕсли Операция = "post" Или Объект.Проведен Тогда
		Объект.Записать(РежимЗаписиДокумента.Проведение);
	Иначе
		Объект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;

КонецПроцедуры

// Завершает выполнение отказом или ошибкой: статус и итог в записи предложения, журналы.
Функция ЗавершитьВыполнение(Запись, Результат, Статус, Текст, Подробности = "")

	Результат.Статус = Статус;
	Результат.Ошибка = Текст;
	Если Не ЗавершитьОжидающее(Запись, Статус, Текст, ИтогВыполненияJSON(Текст, Результат.Сообщения), Подробности) Тогда
		// Предложение успели обработать (другое нажатие): итог этого вызова не записывается.
		Результат.Статус = ТекущийСтатус(Запись.Идентификатор);
		Результат.Ошибка = НСтр("ru = 'Предложение уже обработано.'");
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ИтогВыполненияJSON(Текст, Сообщения)

	Возврат ОбщегоНазначения.ЗначениеВJSON(Новый Структура("message, messages", Текст, Сообщения));

КонецФункции

// Было -> стало для журналов: значения в виде для модели (псевдонимы, без ПДн и секретов).
Функция ПодробностиИзменения(Данные)

	Было = СоответствиеИзДанных(Данные, "before");
	Части = Новый Массив;
	Для Каждого КлючИЗначение Из СоответствиеИзДанных(Данные, "after") Цикл
		Части.Добавить(СтрШаблон("%1: %2 -> %3", КлючИЗначение.Ключ, ПредставлениеЗначенияXML(Было.Получить(КлючИЗначение.Ключ)),
			ПредставлениеЗначенияXML(КлючИЗначение.Значение)));
	КонецЦикла;
	Возврат СтрСоединить(Части, "; ");

КонецФункции

// Значение из XML в виде для модели: ссылки маскируемых видов - псевдонимами (их раскрывает ДляПользователя).
Функция ПредставлениеЗначенияXML(ЗначениеXML)

	Если ТипЗнч(ЗначениеXML) <> Тип("Строка") Или ПустаяСтрока(ЗначениеXML) Тогда
		Возврат "";
	КонецЕсли;
	Значение = ОбщегоНазначения.ЗначениеИзСтрокиXML(ЗначениеXML);
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДЛФ=D; ДП=");
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Формат(Значение, "БЛ=Нет; БИ=Да");
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=");
	КонецЕсли;
	Представление = ИИА_Маскирование.ЗначениеДляМодели(Значение);
	Возврат ?(Представление = Неопределено, "", Строка(Представление));

КонецФункции

Функция СоответствиеИзДанных(Данные, Ключ)

	Значение = Данные.Получить(Ключ);
	Возврат ?(ТипЗнч(Значение) = Тип("Соответствие"), Значение, Новый Соответствие);

КонецФункции

// Статус предложения текущего пользователя; пусто - не найдено.
Функция ТекущийСтатус(Идентификатор)

	УстановитьПривилегированныйРежим(Истина);
	Запись = РегистрыСведений.ИИА_ОжидающиеДействия.СоздатьМенеджерЗаписи();
	Запись.Идентификатор = Лев(СокрЛП(Идентификатор), 36);
	Запись.Прочитать();
	УстановитьПривилегированныйРежим(Ложь);
	Если Не Запись.Выбран() Или Запись.Пользователь <> Пользователи.ТекущийПользователь() Тогда
		Возврат "";
	КонецЕсли;
	Возврат Запись.Статус;

КонецФункции

// Журнал вызовов ИИА (событие «Действие») и журнал регистрации «ИИАссистент.Действия».
Процедура ЗаписатьЖурналДействия(Запись, Итог, Подробности, ПодробностиЖР = "")

	ЭтоИзменение = Запись.ВидДействия = ВидДействияЗаписи();
	Данные = Неопределено;
	Если ЭтоИзменение Тогда
		Попытка
			Данные = ОбщегоНазначения.JSONВЗначение(Запись.ДанныеJSON, , Истина);
		// Повреждённые данные предложения: событие пишется без полей и ссылки.
		Исключение // BSLLS:MissingCodeTryCatchEx-off
			Данные = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Поля = Новый Массив;
	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Для Каждого КлючИЗначение Из СоответствиеИзДанных(Данные, "after") Цикл
			Поля.Добавить(КлючИЗначение.Ключ);
		КонецЦикла;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Журнал = РегистрыСведений.ИИА_ЖурналВызовов.СоздатьМенеджерЗаписи();
	Журнал.ИдентификаторЗаписи = Строка(Новый УникальныйИдентификатор);
	Журнал.МоментВызова = ТекущаяУниверсальнаяДата();
	Журнал.Пользователь = Пользователи.ТекущийПользователь();
	Журнал.Диалог = Запись.Диалог;
	Журнал.Событие = "Действие";
	Журнал.Инструмент = ?(ЭтоИзменение, "propose_change", "propose_draft");
	Журнал.Аргументы = СокрЛП(Запись.ПолноеИмя + " " + Запись.Операция + " " + СтрСоединить(Поля, ","));
	Журнал.Итог = Итог;
	Журнал.Инцидент = Запись.ЕстьЧужойТекст;
	Журнал.Подробности = Подробности;
	Журнал.Записать();
	УстановитьПривилегированныйРежим(Ложь);

	Если Не ЭтоИзменение Тогда
		ЗаписьЖурналаРегистрации("ИИАссистент.Действия", УровеньЖурналаРегистрации.Информация, , ,
			СтрШаблон("%1: %2 %3", Итог, Запись.ПолноеИмя, Запись.Идентификатор));
		Возврат;
	КонецЕсли;
	Ссылка = Неопределено;
	Если ТипЗнч(Данные) = Тип("Соответствие") И ТипЗнч(Данные.Получить("ref")) = Тип("Строка") Тогда
		Попытка
			Ссылка = ОбщегоНазначения.ЗначениеИзСтрокиXML(Данные.Получить("ref"));
		// Повреждённая ссылка предложения: событие пишется без ссылки.
		Исключение // BSLLS:MissingCodeTryCatchEx-off
			Ссылка = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Комментарий = СтрШаблон(НСтр("ru = '%1 (%2): %3, %4, поля %5; %6; предложение %7, диалог %8'"), Итог,
		Строка(Пользователи.ТекущийПользователь()), Запись.Операция, Запись.ПолноеИмя, СтрСоединить(Поля, ", "),
		Подробности, Запись.Идентификатор,
		?(ЗначениеЗаполнено(Запись.Диалог), Строка(Запись.Диалог.УникальныйИдентификатор()), "-"))
		+ ?(ПустаяСтрока(ПодробностиЖР), "", Символы.ПС + ПодробностиЖР);
	ЗаписьЖурналаРегистрации("ИИАссистент.Действия", ?(Итог = "Ошибка", УровеньЖурналаРегистрации.Ошибка,
		УровеньЖурналаРегистрации.Информация), Метаданные.НайтиПоПолномуИмени(Запись.ПолноеИмя), Ссылка, Комментарий);

КонецПроцедуры

Функция ИмяСобытияЖурнала()

	Возврат НСтр("ru = 'ИИАссистент.Действия'", ОбщегоНазначения.КодОсновногоЯзыка());

КонецФункции

#КонецОбласти

// Права ролей на операцию (таблица spec 2026-10-13-iia-diagnostics, перенесена из typed-write).
Функция ПраваОперации(Операция, ЭтоДокумент, Проведен)

	Права = Новый Массив;
	Если Операция = "write" Тогда
		Права.Добавить("Изменение");
		Права.Добавить("Редактирование");
		Если ЭтоДокумент И Проведен Тогда
			// Запись проведённого документа - перепроведение.
			Права.Добавить("ИнтерактивноеИзменениеПроведенных");
			Права.Добавить("Проведение");
		КонецЕсли;
	ИначеЕсли Операция = "post" Тогда
		Права.Добавить("Проведение");
		Права.Добавить("ИнтерактивноеПроведение");
	ИначеЕсли Операция = "unpost" Тогда
		Права.Добавить("ОтменаПроведения");
		Права.Добавить("ИнтерактивнаяОтменаПроведения");
	ИначеЕсли Операция = "mark_deletion" Тогда
		Права.Добавить("Изменение");
		Права.Добавить("ИнтерактивнаяПометкаУдаления");
		Если ЭтоДокумент И Проведен Тогда
			Права.Добавить("ОтменаПроведения");
		КонецЕсли;
	Иначе
		Права.Добавить("Изменение");
		Права.Добавить("ИнтерактивноеСнятиеПометкиУдаления");
	КонецЕсли;
	Возврат Права;

КонецФункции

// Состояние объекта, при котором операция не имеет смысла; пусто - состояние подходит.
Функция ТекстНедопустимогоСостояния(Операция, Проведен, ПометкаУдаления)

	Если Операция = "post" И ПометкаУдаления Тогда
		Возврат НСтр("ru = 'Документ помечен на удаление: проведение невозможно.'");
	ИначеЕсли Операция = "unpost" И Не Проведен Тогда
		Возврат НСтр("ru = 'Документ не проведён.'");
	ИначеЕсли Операция = "mark_deletion" И ПометкаУдаления Тогда
		Возврат НСтр("ru = 'Объект уже помечен на удаление.'");
	ИначеЕсли Операция = "unmark_deletion" И Не ПометкаУдаления Тогда
		Возврат НСтр("ru = 'Объект не помечен на удаление.'");
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

// RLS на изменение через БСП, если подсистема есть. Функция БСП принимает и объект в памяти: тогда проверяется
// новое состояние и состояние в базе.
Процедура ПроверитьRLS(Результат, ОбъектИлиСсылка, ЭтоСсылка, ПользовательИБ)

	Если Не ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		Возврат;
	КонецЕсли;
	МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
	Если ПользовательИБ = Неопределено Тогда
		Результат.RLS = МодульУправлениеДоступом.ИзменениеРазрешено(ОбъектИлиСсылка);
	Иначе
		// Пользователь ИБ без элемента справочника: RLS не проверяется (Неопределено), а не подменяется текущим.
		ПользовательСправочника = ПользовательСправочника(ПользовательИБ);
		Если ПользовательСправочника <> Неопределено Тогда
			Попытка
				Результат.RLS = МодульУправлениеДоступом.ИзменениеРазрешено(ОбъектИлиСсылка, ПользовательСправочника);
			Исключение // BSLLS:MissingCodeTryCatchEx-off
				// Стандартный вариант ограничения доступа БСП проверяет только текущего пользователя (параметр
				// Пользователь - только Неопределено): RLS другого пользователя не проверяется (Неопределено).
				Результат.RLS = Неопределено;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	Результат.RLSПоНовомуСостоянию = Не ЭтоСсылка И Результат.RLS <> Неопределено;
	Если Результат.RLS = Ложь Тогда
		ДобавитьПричину(Результат, "RLS_DENIED",
			НСтр("ru = 'Ограничение доступа на уровне записей не разрешает изменять этот объект.'"));
	КонецЕсли;

КонецПроцедуры

// Дата запрета изменения через БСП, если подсистема есть: по переданному объекту или по состоянию в базе.
Процедура ПроверитьДатуЗапрета(Результат, ОбъектИлиСсылка, ЭтоСсылка)

	Если Не ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ДатыЗапретаИзменения") Тогда
		Возврат;
	КонецЕсли;
	МодульДатыЗапретаИзменения = ОбщегоНазначения.ОбщийМодуль("ДатыЗапретаИзменения");
	ОписаниеЗапрета = "";
	Если ЭтоСсылка Тогда
		Результат.ИзменениеЗапрещено = МодульДатыЗапретаИзменения.ИзменениеЗапрещено(
			ОбъектИлиСсылка.Метаданные().ПолноеИмя(), ОбъектИлиСсылка, ОписаниеЗапрета);
	Иначе
		Результат.ИзменениеЗапрещено = МодульДатыЗапретаИзменения.ИзменениеЗапрещено(ОбъектИлиСсылка, , ОписаниеЗапрета);
	КонецЕсли;
	Если Результат.ИзменениеЗапрещено Тогда
		Результат.ТекстЗапрета = Лев(Строка(ОписаниеЗапрета), 500);
		ДобавитьПричину(Результат, "CHANGE_PROHIBITED", ИИА_Периметр.ОчиститьТекст(Результат.ТекстЗапрета));
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПричину(Результат, Код, Текст)

	Результат.Причины.Добавить(Новый Структура("Код, Текст", Код, Текст));

КонецПроцедуры

// Элемент справочника Пользователи по пользователю ИБ (для проверки RLS не текущего пользователя).
Функция ПользовательСправочника(ПользовательИБ)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Пользователи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.ИдентификаторПользователяИБ = &Идентификатор");
	Запрос.УстановитьПараметр("Идентификатор", ПользовательИБ.УникальныйИдентификатор);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);

КонецФункции

// Ожидающее действие текущего пользователя в статусе «Ожидает» и в пределах срока; иначе Неопределено и текст
// в Результат.Ошибка. Просроченное переводится в «Просрочено».
//  ВидДействия - Строка - "" (черновик) или "Запись" (изменение): действие другого вида не находится.
Функция ПрочитатьОжидающее(Идентификатор, Результат, ВидДействия)

	ЭтоИзменение = ВидДействия = ВидДействияЗаписи();
	УстановитьПривилегированныйРежим(Истина);
	Запись = РегистрыСведений.ИИА_ОжидающиеДействия.СоздатьМенеджерЗаписи();
	Запись.Идентификатор = Лев(СокрЛП(Идентификатор), 36);
	Запись.Прочитать();
	Если Не Запись.Выбран() Или Запись.Пользователь <> Пользователи.ТекущийПользователь()
		Или Запись.ВидДействия <> ВидДействия Тогда
		Результат.Ошибка = ?(ЭтоИзменение, НСтр("ru = 'Предложение не найдено.'"), НСтр("ru = 'Черновик не найден.'"));
		Возврат Неопределено;
	КонецЕсли;
	Если Запись.Статус <> "Ожидает" Тогда
		Результат.Ошибка = ?(ЭтоИзменение, НСтр("ru = 'Предложение уже обработано.'"),
			НСтр("ru = 'Черновик уже обработан.'"));
		Возврат Неопределено;
	КонецЕсли;
	Если Запись.СрокДействия < ТекущаяДатаСеанса() Тогда
		Результат.Ошибка = ?(ЭтоИзменение,
			НСтр("ru = 'Срок действия предложения истёк. Попросите ассистента предложить изменение снова.'"),
			НСтр("ru = 'Срок действия черновика истёк. Попросите ассистента предложить его снова.'"));
		ЗавершитьОжидающее(Запись, "Просрочено", Результат.Ошибка);
		Возврат Неопределено;
	КонецЕсли;
	Возврат Запись;

КонецФункции

// Переход из «Ожидает» в итоговый статус под исключительной блокировкой записи предложения: статус меняется,
// только если он всё ещё «Ожидает» (гонка «Выполнить» / «Отклонить» / срок). Во внешней транзакции своя
// транзакция не открывается.
//
// Параметры:
//  РезультатJSON - Строка, Неопределено - итог выполнения изменения для карточки (ресурс Результат).
//  ПодробностиЖР - Строка - подробное представление ошибки: только в журнал регистрации, не в журнал вызовов.
//
// Возвращаемое значение:
//  Булево - Ложь, если предложение уже обработано: статус не изменён.
//
Функция ЗавершитьОжидающее(Запись, Статус, Подробности, РезультатJSON = Неопределено, ПодробностиЖР = "")

	Если ТранзакцияАктивна() Тогда
		Возврат СменитьСтатусПодБлокировкой(Запись, Статус, Подробности, РезультатJSON, ПодробностиЖР);
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Изменен = СменитьСтатусПодБлокировкой(Запись, Статус, Подробности, РезультатJSON, ПодробностиЖР);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Изменен;

КонецФункции

// Тело ЗавершитьОжидающее в транзакции: блокировка, проверка «Ожидает», запись статуса.
Функция СменитьСтатусПодБлокировкой(Запись, Статус, Подробности, РезультатJSON, ПодробностиЖР)

	ЗаблокироватьПредложение(Запись.Идентификатор);
	Если ТекущийСтатус(Запись.Идентификатор) <> "Ожидает" Тогда
		Возврат Ложь;
	КонецЕсли;
	ЗаписатьСтатус(Запись, Статус, Подробности, РезультатJSON, ПодробностиЖР);
	Возврат Истина;

КонецФункции

// Исключительная управляемая блокировка записи предложения (служебный регистр - привилегированно).
Процедура ЗаблокироватьПредложение(Идентификатор)

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ИИА_ОжидающиеДействия");
	ЭлементБлокировки.УстановитьЗначение("Идентификатор", Идентификатор);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	УстановитьПривилегированныйРежим(Истина);
	Блокировка.Заблокировать();
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Запись статуса без блокировки (вызывающий держит блокировку предложения) и журналы.
Процедура ЗаписатьСтатус(Запись, Статус, Подробности, РезультатJSON = Неопределено, ПодробностиЖР = "")

	УстановитьПривилегированныйРежим(Истина);
	Запись.Статус = Статус;
	Если РезультатJSON <> Неопределено Тогда
		Запись.Результат = РезультатJSON;
	КонецЕсли;
	Запись.Записать();
	УстановитьПривилегированныйРежим(Ложь);
	ЗаписатьЖурналДействия(Запись, Статус, Подробности, ПодробностиЖР);

КонецПроцедуры

Функция ХешСодержимого(ПолноеИмя, ДанныеJSON)

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ПолноеИмя + Символы.ПС + ДанныеJSON);
	Возврат Base64Строка(Хеширование.ХешСумма);

КонецФункции

Функция Отказ(Выполнение, Код, Текст)

	Выполнение.Итог = Код;
	Выполнение.Данные = Новый Структура("error, message", Код, Текст);
	Возврат Выполнение;

КонецФункции

Функция СвойствоПараметра(Тип, Описание)

	Свойство = Новый Соответствие;
	Свойство.Вставить("type", Тип);
	Свойство.Вставить("description", Описание);
	Возврат Свойство;

КонецФункции

#КонецОбласти
