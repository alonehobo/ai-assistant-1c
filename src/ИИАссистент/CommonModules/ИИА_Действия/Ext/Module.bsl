///////////////////////////////////////////////////////////////////////////////////////////////////////
// ИИ-ассистент: изменение данных через черновики (план, раздел 4.7, этап 3).
// Агент ничего не записывает. Инструмент propose_draft сохраняет предложение как ожидающее действие
// (пользователь, диалог, хеш содержимого, срок действия) и показывает карточку в чате. Открыть черновик
// может только пользователь кнопкой карточки: код 1С повторно проверяет права, периметр и хеш, пишет журнал
// и открывает форму нового документа с заполненными значениями - записывает документ сам пользователь.
// Допустимые виды документов задаются в профиле доступа (табличная часть «Действия»).
//
// Изменение существующих данных (propose_change, change 2026-10-13-iia-typed-write): только типизированные
// операции над одним документом или элементом справочника - реквизиты шапки, проведение, отмена проведения,
// пометка удаления. Инструмент проверяет периметр, профиль («Запись данных»), права пользователя (в том числе
// RLS и дату запрета - ИИА_Действия.ПрепятствияОперации), класс данных, выполняет пробный прогон в транзакции
// с безусловным откатом и показывает карточку. Записывает только ВыполнитьИзменение по кнопке «Выполнить»
// владельца предложения, в правах пользователя, без привилегированного режима и без ОбменДанными.Загрузка.
// Удаление, изменение пользователей, прав и настроек не поддерживаются никогда.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Описание инструмента propose_draft, если профиль пользователя разрешает хотя бы один вид документа, и
// propose_change - только в канале chat и если профиль разрешает запись хотя бы одного вида, на операцию которого
// у пользователя есть права.
//
// Параметры:
//  Канал - Строка - "chat" (ход из окна чата) или "http".
//
// Возвращаемое значение:
//  Массив из Соответствие
//
Функция ОписанияИнструментов(Канал = "http") Экспорт

	Инструменты = Новый Массив;
	Если Канал = "chat" Тогда
		ОписаниеИзменения = ОписаниеИнструментаИзменения();
		Если ОписаниеИзменения <> Неопределено Тогда
			Инструменты.Добавить(ОписаниеИзменения);
		КонецЕсли;
	КонецЕсли;
	СписокДокументов = ДопустимыеДокументы();
	Если СписокДокументов.Количество() = 0 Тогда
		Возврат Инструменты;
	КонецЕсли;

	Свойства = Новый Соответствие;
	Свойства.Вставить("document", СвойствоПараметра("string",
		СтрШаблон(НСтр("ru = 'Полное имя документа, один из: %1.'"), СтрСоединить(СписокДокументов, ", "))));
	Поля = Новый Соответствие;
	Поля.Вставить("type", "object");
	Поля.Вставить("description", НСтр("ru = 'Реквизиты шапки (имена из describe_metadata) -> значение текстом: наименование, номер, дата ГГГГ-ММ-ДД, число.'"));
	Свойства.Вставить("fields", Поля);
	Свойства.Вставить("summary", СвойствоПараметра("string", НСтр("ru = 'Одна фраза: что и зачем создаётся.'")));

	Функция_ = Новый Соответствие;
	Функция_.Вставить("name", "propose_draft");
	Функция_.Вставить("description", НСтр("ru = 'Предлагает пользователю черновик нового документа с заполненной шапкой. Документ не записывается: пользователь сам открывает черновик кнопкой в чате, проверяет и записывает. Используй, только когда пользователь явно просит создать документ.'"));
	Схема = Новый Соответствие;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", СтрРазделить("document,fields", ","));
	Функция_.Вставить("parameters", Схема);
	Инструмент = Новый Соответствие;
	Инструмент.Вставить("type", "function");
	Инструмент.Вставить("function", Функция_);
	Инструменты.Добавить(Инструмент);
	Возврат Инструменты;

КонецФункции

// Инструмент propose_draft: проверяет предложение и сохраняет его как ожидающее действие.
//
// Параметры:
//  АргументыJSON - Строка
//  Диалог - СправочникСсылка.ИИА_Диалоги, Неопределено
//  ЕстьЧужойТекст - Булево - в ходе сработал детектор инъекций: карточка получает предупреждение.
//  РезультатХода - Структура - см. ИИА_Агент.ВыполнитьХод; в Действия добавляется карточка.
//
// Возвращаемое значение:
//  Структура - Успех, Данные, Таблица, Строк, Скрыто, Итог, Класс.
//
Функция ПредложитьЧерновик(АргументыJSON, Диалог, ЕстьЧужойТекст, РезультатХода) Экспорт

	Выполнение = Новый Структура("Успех, Данные, Таблица, Строк, Скрыто, Итог, Класс", Ложь, Неопределено, Неопределено, 0, 0, "", 1);
	Попытка
		Аргументы = ОбщегоНазначения.JSONВЗначение(АргументыJSON, , Истина);
	Исключение
		Возврат Отказ(Выполнение, "BAD_ARGUMENTS", НСтр("ru = 'Аргументы должны быть JSON-объектом.'"));
	КонецПопытки;
	Если РезультатХода.Действия.Количество() >= 1 Тогда
		Возврат Отказ(Выполнение, "LIMIT", ТекстЛимитаКарточек());
	КонецЕсли;

	ПолноеИмя = СокрЛП(Строка(Аргументы.Получить("document")));
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Или ДопустимыеДокументы().Найти(ОбъектМетаданных.ПолноеИмя()) = Неопределено Тогда
		Возврат Отказ(Выполнение, "ACTION_NOT_ALLOWED", НСтр("ru = 'Создание такого документа ассистенту не разрешено профилем.'"));
	КонецЕсли;
	ПолноеИмя = ОбъектМетаданных.ПолноеИмя();

	Значения = Новый Соответствие; // имя реквизита -> значение в XML
	Строки = Новый Массив;          // для карточки: реквизит и представление
	Ошибки = Новый Массив;
	Поля = Аргументы.Получить("fields");
	Если ТипЗнч(Поля) <> Тип("Соответствие") Или Поля.Количество() = 0 Тогда
		Возврат Отказ(Выполнение, "BAD_ARGUMENTS", НСтр("ru = 'Укажите реквизиты шапки в fields.'"));
	КонецЕсли;
	Для Каждого КлючИЗначение Из Поля Цикл
		ИмяРеквизита = СокрЛП(Строка(КлючИЗначение.Ключ));
		Реквизит = ОбъектМетаданных.Реквизиты.Найти(ИмяРеквизита);
		Если Реквизит = Неопределено Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = 'нет реквизита %1'"), ИмяРеквизита));
			Продолжить;
		КонецЕсли;
		Если ИИА_Периметр.ПолеЗапрещено(ПолноеИмя, ИмяРеквизита) Или ИИА_Периметр.ЭтоИмяСекрета(ИмяРеквизита) Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = 'реквизит %1 вне периметра'"), ИмяРеквизита));
			Продолжить;
		КонецЕсли;
		// Реквизит из списка коммерческого маскирования модель не видит и не записывает.
		Если ИИА_Маскирование.ПолеМаскируется(ПолноеИмя, ИмяРеквизита) Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = 'реквизит %1 скрыт от модели (MASKED_FIELD)'"), ИмяРеквизита));
			Продолжить;
		КонецЕсли;
		// Псевдоним не записывается строкой (как наименование или комментарий): только как ссылка.
		Если Реквизит.Тип.СодержитТип(Тип("Строка")) И ИИА_Маскирование.ЕстьПсевдоним(Строка(КлючИЗначение.Значение))
			И ИИА_Маскирование.ЗначениеИзПсевдонима(СокрЛП(Строка(КлючИЗначение.Значение)), Реквизит.Тип) = Неопределено Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = 'в реквизит %1 нельзя записать псевдоним объекта текстом (PSEUDONYM_AS_LITERAL)'"),
				ИмяРеквизита));
			Продолжить;
		КонецЕсли;
		Значение = ИИА_Инструменты.ЗначениеПоТексту(Реквизит.Тип, СокрЛП(Строка(КлючИЗначение.Значение)), Ошибки, ИмяРеквизита);
		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Значения.Вставить(Реквизит.Имя, ОбщегоНазначения.ЗначениеВСтрокуXML(Значение));
		Строки.Добавить(Новый Структура("name, value", ?(ПустаяСтрока(Реквизит.Синоним), Реквизит.Имя, Реквизит.Синоним),
			Значение));
	КонецЦикла;
	// Карточка для модели: разметка физлиц и регистрация псевдонимов - одним пакетом по всем реквизитам.
	Ссылки = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Строка.value)) Тогда
			Ссылки.Добавить(Строка.value);
		КонецЕсли;
	КонецЦикла;
	Признаки = ИИА_Маскирование.ОтметитьСсылки(Ссылки);
	Регистрация = Новый Соответствие;
	Для Каждого Строка Из Строки Цикл
		Строка.value = ИИА_Маскирование.ЗначениеДляМодели(Строка.value, Признаки, , Регистрация);
	КонецЦикла;
	ИИА_Маскирование.ЗаписатьПсевдонимы(Регистрация);
	Если Ошибки.Количество() > 0 Тогда
		Возврат Отказ(Выполнение, "BAD_FIELDS", СтрСоединить(Ошибки, "; "));
	КонецЕсли;

	Данные = ОбщегоНазначения.ЗначениеВJSON(Значения);
	Идентификатор = Строка(Новый УникальныйИдентификатор);
	УстановитьПривилегированныйРежим(Истина);
	Запись = РегистрыСведений.ИИА_ОжидающиеДействия.СоздатьМенеджерЗаписи();
	Запись.Идентификатор = Идентификатор;
	Запись.Пользователь = Пользователи.ТекущийПользователь();
	Запись.Диалог = ?(ЗначениеЗаполнено(Диалог), Диалог, Неопределено);
	Запись.ПолноеИмя = ПолноеИмя;
	Запись.ДанныеJSON = Данные;
	Запись.Хеш = ХешСодержимого(ПолноеИмя, Данные);
	Запись.Создано = ТекущаяДатаСеанса();
	Запись.СрокДействия = ТекущаяДатаСеанса() + 1800;
	Запись.Статус = "Ожидает";
	Запись.ЕстьЧужойТекст = ЕстьЧужойТекст;
	Запись.Записать();
	УстановитьПривилегированныйРежим(Ложь);

	Сводка = Аргументы.Получить("summary");
	Предупреждение = ?(ЕстьЧужойТекст,
		НСтр("ru = 'Внимание: в данных этого ответа найден текст, похожий на инструкцию. Проверьте черновик особенно внимательно.'"), "");
	РезультатХода.Действия.Добавить(Новый Структура("Идентификатор, Заголовок, Строки, Предупреждение",
		Идентификатор, СтрШаблон(НСтр("ru = 'Черновик: %1'"), ОбъектМетаданных.Синоним)
			+ ?(ТипЗнч(Сводка) = Тип("Строка") И Не ПустаяСтрока(Сводка), ". " + ИИА_Периметр.ОчиститьТекст(Лев(Сводка, 200)), ""),
		Строки, Предупреждение));

	Выполнение.Успех = Истина;
	Выполнение.Итог = "OK";
	Выполнение.Строк = Строки.Количество();
	Выполнение.Данные = Новый Структура("proposed",
		НСтр("ru = 'Карточка черновика показана пользователю. Документ не создан: пользователь откроет черновик сам. Ответь одной фразой.'"));
	Возврат Выполнение;

КонецФункции

// Подтверждение черновика пользователем (кнопка карточки): повторные проверки и параметры формы.
//
// Параметры:
//  Идентификатор - Строка
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * Ошибка - Строка
//   * ИмяФормы - Строка
//   * ПараметрыФормы - Структура - ЗначенияЗаполнения.
//
Функция ПодтвердитьЧерновик(Идентификатор) Экспорт

	Результат = Новый Структура("Успех, Ошибка, ИмяФормы, ПараметрыФормы", Ложь, "", "", Неопределено);
	Запись = ПрочитатьОжидающее(Идентификатор, Результат, "");
	Если Запись = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Запись.ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Или ДопустимыеДокументы().Найти(Запись.ПолноеИмя) = Неопределено
		Или Не ПравоДоступа("ИнтерактивноеДобавление", ОбъектМетаданных) Тогда
		Результат.Ошибка = НСтр("ru = 'Создание такого документа вам больше не разрешено.'");
		ЗавершитьОжидающее(Запись, "Отказ", Результат.Ошибка);
		Возврат Результат;
	КонецЕсли;
	Если ХешСодержимого(Запись.ПолноеИмя, Запись.ДанныеJSON) <> Запись.Хеш Тогда
		Результат.Ошибка = НСтр("ru = 'Содержимое черновика изменилось после предложения - он отклонён.'");
		ЗавершитьОжидающее(Запись, "Отказ", Результат.Ошибка);
		Возврат Результат;
	КонецЕсли;

	ЗначенияЗаполнения = Новый Структура;
	Значения = ОбщегоНазначения.JSONВЗначение(Запись.ДанныеJSON, , Истина);
	Для Каждого КлючИЗначение Из Значения Цикл
		Реквизит = ОбъектМетаданных.Реквизиты.Найти(КлючИЗначение.Ключ);
		Если Реквизит = Неопределено Или ИИА_Периметр.ПолеЗапрещено(Запись.ПолноеИмя, Реквизит.Имя) Тогда
			Продолжить;
		КонецЕсли;
		ЗначенияЗаполнения.Вставить(Реквизит.Имя, ОбщегоНазначения.ЗначениеИзСтрокиXML(КлючИЗначение.Значение));
	КонецЦикла;

	Если Не ЗавершитьОжидающее(Запись, "Подтверждено", "") Тогда
		Результат.Ошибка = НСтр("ru = 'Черновик уже обработан.'");
		Возврат Результат;
	КонецЕсли;
	Результат.Успех = Истина;
	Результат.ИмяФормы = Запись.ПолноеИмя + ".ФормаОбъекта";
	Результат.ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
	Возврат Результат;

КонецФункции

// Отклонение черновика пользователем.
//
// Параметры:
//  Идентификатор - Строка
//
Процедура ОтклонитьЧерновик(Идентификатор) Экспорт

	Результат = Новый Структура("Успех, Ошибка", Ложь, "");
	Запись = ПрочитатьОжидающее(Идентификатор, Результат, "");
	Если Запись <> Неопределено Тогда
		ЗавершитьОжидающее(Запись, "Отклонено", "");
	КонецЕсли;

КонецПроцедуры

// Инструмент propose_change: проверяет предложение, выполняет пробный прогон (если он не запрещён профилем для вида)
// и сохраняет предложение как ожидающее действие с карточкой в чате. Прикладной объект не записывается: прогон
// всегда откатывается, в базу пишется только служебная запись ИИА_ОжидающиеДействия.
//
// Параметры:
//  АргументыJSON - Строка - object (метка o<N>), operation, fields (для set_fields), summary.
//  Диалог - СправочникСсылка.ИИА_Диалоги, Неопределено
//  ЕстьЧужойТекст - Булево - в ходе сработал детектор инъекций: карточка получает предупреждение.
//  РезультатХода - Структура - см. ИИА_Агент.ВыполнитьХод: Объекты (метки), Действия (карточка добавляется сюда).
//  ПараметрыПредложения - Структура, Неопределено:
//   * Канал - Строка - "chat"; другой канал - отказ CHAT_ONLY.
//   * Модель - СправочникСсылка.ИИА_ПодключенияМоделей, Неопределено - модель хода (проверка класса данных).
//   * КлассХода - Число - класс данных, уже допущенный в ходе.
//   * МаксимальныйКласс - Число, Неопределено - для тестов: допустимый класс вместо проверки цепочки моделей.
//   * ПользовательИБ - ПользовательИнформационнойБазы, Неопределено - для тестов: чьи права проверять.
//
// Возвращаемое значение:
//  Структура - Успех, Данные, Таблица, Строк, Скрыто, Итог, Класс.
//
Функция ПредложитьИзменение(АргументыJSON, Диалог, ЕстьЧужойТекст, РезультатХода, ПараметрыПредложения = Неопределено) Экспорт

	Выполнение = Новый Структура("Успех, Данные, Таблица, Строк, Скрыто, Итог, Класс", Ложь, Неопределено, Неопределено, 0, 0, "", 1);
	Настройки = Новый Структура("Канал, Модель, КлассХода, МаксимальныйКласс, ПользовательИБ", "http", Неопределено, 1,
		Неопределено, Неопределено);
	Если ПараметрыПредложения <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Настройки, ПараметрыПредложения);
	КонецЕсли;
	Если Настройки.Канал <> "chat" Тогда
		Возврат Отказ(Выполнение, "CHAT_ONLY", НСтр("ru = 'Изменение данных доступно только в чате 1С.'"));
	КонецЕсли;
	Контекст = КонтекстИзменения(ИИА_ПериметрПовтИсп.ПравилаПрофиля(), Настройки.ПользовательИБ, Настройки.Канал);
	Попытка
		Аргументы = ОбщегоНазначения.JSONВЗначение(АргументыJSON, , Истина);
	// Неверный JSON модели - отказ BAD_ARGUMENTS в ответе инструмента.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат Отказ(Выполнение, "BAD_ARGUMENTS", НСтр("ru = 'Аргументы должны быть JSON-объектом.'"));
	КонецПопытки;
	Если ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
		Возврат Отказ(Выполнение, "BAD_ARGUMENTS", НСтр("ru = 'Аргументы должны быть JSON-объектом.'"));
	КонецЕсли;
	Если РезультатХода.Действия.Количество() >= 1 Тогда
		Возврат Отказ(Выполнение, "LIMIT", ТекстЛимитаКарточек());
	КонецЕсли;
	Операция = СокрЛП(Строка(Аргументы.Получить("operation")));
	Если ОперацииЗаписи().Найти(Операция) = Неопределено Тогда
		Возврат Отказ(Выполнение, "BAD_ARGUMENTS", СтрШаблон(НСтр("ru = 'operation - одно из: %1.'"),
			СтрСоединить(ОперацииЗаписи(), ", ")));
	КонецЕсли;
	Ссылка = ОбъектПоМетке(Аргументы.Получить("object"), РезультатХода.Объекты);
	Если Ссылка = Неопределено Тогда
		Возврат Отказ(Выполнение, "NOT_FOUND", НСтр("ru = 'Объект не найден: укажи метку объекта (o1, o2, ...) из результатов find_records, run_query или read_object этого ответа.'"));
	КонецЕсли;

	// Проверки 9, 1, 2: транзакция, вид, периметр, разрешение профиля.
	Проверка = ПроверитьВидИОперацию(Ссылка, Операция, Контекст);
	Если Не ПустаяСтрока(Проверка.Код) Тогда
		Возврат Отказ(Выполнение, Проверка.Код, Проверка.Текст);
	КонецЕсли;
	ОбъектМетаданных = Проверка.ОбъектМетаданных;
	ПолноеИмя = ОбъектМетаданных.ПолноеИмя();

	// Проверка 5 до разрешения значений: по закрытому полю значение не ищется (защита от оракула).
	Значения = Новый Соответствие;
	Если Операция = "set_fields" Тогда
		Поля = Аргументы.Получить("fields");
		Если ТипЗнч(Поля) <> Тип("Соответствие") Или Поля.Количество() = 0 Или Поля.Количество() > 10 Тогда
			Возврат Отказ(Выполнение, "BAD_ARGUMENTS", НСтр("ru = 'Для set_fields укажи в fields от 1 до 10 реквизитов шапки.'"));
		КонецЕсли;
		Отказы = ОтказыПолей(ОбъектМетаданных, Проверка.Разрешение, Поля, Контекст);
		Если Отказы.Права.Количество() > 0 Тогда
			Возврат Отказ(Выполнение, "ACCESS_DENIED", СтрШаблон(НСтр("ru = 'Нет права редактировать реквизиты: %1.'"),
				СтрСоединить(Отказы.Права, ", ")));
		ИначеЕсли Отказы.Поля.Количество() > 0 Тогда
			Возврат Отказ(Выполнение, "BAD_FIELDS", СтрСоединить(Отказы.Поля, "; "));
		КонецЕсли;
		ОшибкиЗначений = Новый Массив;
		КодЗначений = "";
		Для Каждого КлючИЗначение Из Поля Цикл
			Реквизит = РеквизитЗаписи(ОбъектМетаданных, СокрЛП(Строка(КлючИЗначение.Ключ)));
			Разрешение = ЗначениеДляЗаписи(Реквизит.Тип, СокрЛП(Строка(КлючИЗначение.Значение)), Реквизит.Имя,
				РезультатХода.Объекты, Контекст);
			Если Разрешение.Успех Тогда
				Значения.Вставить(Реквизит.Имя, Разрешение.Значение);
			Иначе
				ОшибкиЗначений.Добавить(Разрешение.Текст);
				КодЗначений = ?(КодЗначений = "AMBIGUOUS", КодЗначений, Разрешение.Код);
			КонецЕсли;
		КонецЦикла;
		Если ОшибкиЗначений.Количество() > 0 Тогда
			Возврат Отказ(Выполнение, КодЗначений, СтрСоединить(ОшибкиЗначений, "; "));
		КонецЕсли;
	КонецЕсли;

	// Проверка 6 до прогона и карточки: класс объекта и изменяемых полей допустим для модели хода.
	Класс = ИИА_КлассыДанных.КлассОбъекта(ПолноеИмя);
	Для Каждого КлючИЗначение Из Значения Цикл
		Класс = Макс(Класс, ИИА_КлассыДанных.КлассОбъекта(ПолноеИмя, КлючИЗначение.Ключ));
	КонецЦикла;
	Если Не КлассДопустим(Класс, Настройки) Тогда
		Выполнение.Класс = Класс;
		Возврат Отказ(Выполнение, "DATA_CLASS_NOT_ALLOWED", СтрШаблон(
			НСтр("ru = 'Данные класса %1 нельзя передавать модели этого хода: изменение не предлагается.'"),
			ИИА_КлассыДанных.ПредставлениеКласса(Класс)));
	КонецЕсли;

	// Проверки 7 и 3: состояние, права на операцию, RLS (по новому состоянию) и дата запрета.
	Подготовка = ПодготовитьИзменение(Ссылка, Операция, Значения, Контекст);
	Если Не ПустаяСтрока(Подготовка.Код) Тогда
		Возврат Отказ(Выполнение, Подготовка.Код, Подготовка.Текст);
	КонецЕсли;

	ЗначенияXML = Новый Соответствие;
	Для Каждого Изменение Из Подготовка.Изменения Цикл
		ЗначенияXML.Вставить(Изменение.Имя, ОбщегоНазначения.ЗначениеВСтрокуXML(Изменение.Стало));
	КонецЦикла;
	Прогон = ПробныйПрогон(Ссылка, Операция, ЗначенияXML, Проверка.Разрешение.ПробныйПрогонЗапрещен);

	Идентификатор = Строка(Новый УникальныйИдентификатор);
	Сводка = Аргументы.Получить("summary");
	Сводка = ?(ТипЗнч(Сводка) = Тип("Строка"), ИИА_Периметр.ОчиститьТекст(Лев(СокрЛП(Сводка), 200)), "");
	Данные = ДанныеПредложения(Ссылка, Подготовка, Прогон, Сводка);
	СохранитьПредложение(Идентификатор, Диалог, ПолноеИмя, Операция, Подготовка.ВерсияДанных, Данные, ЕстьЧужойТекст,
		Прогон);

	// Модели - только поля, которые она вправе видеть, в каноническом виде (псевдонимы).
	Ссылки = Новый Массив;
	Ссылки.Добавить(Ссылка);
	Для Каждого Изменение Из Подготовка.Изменения Цикл
		Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Изменение.Было)) Тогда
			Ссылки.Добавить(Изменение.Было);
		КонецЕсли;
		Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Изменение.Стало)) Тогда
			Ссылки.Добавить(Изменение.Стало);
		КонецЕсли;
	КонецЦикла;
	Признаки = ИИА_Маскирование.ОтметитьСсылки(Ссылки);
	Регистрация = Новый Соответствие;
	Скрыто = 0;
	Изменения = Новый Массив;
	Для Каждого Изменение Из Подготовка.Изменения Цикл
		Изменения.Добавить(Новый Структура("field, from, to", Изменение.Имя,
			ИИА_Маскирование.ЗначениеДляМодели(Изменение.Было, Признаки, Скрыто, Регистрация),
			ИИА_Маскирование.ЗначениеДляМодели(Изменение.Стало, Признаки, Скрыто, Регистрация)));
	КонецЦикла;
	ПредставлениеОбъекта = ИИА_Маскирование.ЗначениеДляМодели(Ссылка, Признаки, Скрыто, Регистрация);
	ИИА_Маскирование.ЗаписатьПсевдонимы(Регистрация);

	Предупреждения = Подготовка.Предупреждения;
	Если ЕстьЧужойТекст Тогда
		Предупреждения.Добавить(НСтр("ru = 'Внимание: в данных этого ответа найден текст, похожий на инструкцию. Проверьте изменение особенно внимательно.'"));
	КонецЕсли;
	Заголовок = СтрШаблон(НСтр("ru = 'Изменение: %1 - %2'"), ПредставлениеОперации(Операция), ПредставлениеОбъекта)
		+ ?(ПустаяСтрока(Сводка), "", ". " + Сводка);
	РезультатХода.Действия.Добавить(Новый Структура("Идентификатор, Заголовок, Строки, Предупреждение, Вид",
		Идентификатор, Заголовок, Новый Массив, СтрСоединить(Предупреждения, " "), "change"));

	Выполнение.Успех = Истина;
	Выполнение.Итог = "OK";
	Выполнение.Строк = Изменения.Количество();
	Выполнение.Скрыто = Скрыто;
	Выполнение.Класс = Класс;
	Ответ = Новый Структура;
	Ответ.Вставить("proposed", НСтр("ru = 'Карточка показана пользователю. Ничего не записано: запись выполнит пользователь кнопкой. Ответь одной фразой.'"));
	Ответ.Вставить("operation", Операция);
	Ответ.Вставить("object", СокрЛП(Строка(Аргументы.Получить("object"))));
	Ответ.Вставить("changes", Изменения);
	Ответ.Вставить("repost", Подготовка.Перепроведение);
	Ответ.Вставить("dry_run", ПрогонДляМодели(Прогон));
	Ответ.Вставить("expires_min", 30);
	Выполнение.Данные = Ответ;
	Возврат Выполнение;

КонецФункции

// Выполнение предложенного изменения пользователем (кнопка «Выполнить» карточки). Повторяет проверки (срок,
// целостность, владелец, профиль, периметр, поля, права, RLS, дата запрета, состояние), блокирует запись
// предложения и объект, сверяет ВерсияДанных и записывает объект штатно в правах пользователя.
//
// Параметры:
//  Идентификатор - Строка - идентификатор предложения.
//  ПользовательИБ - ПользовательИнформационнойБазы, Неопределено - для тестов: чьи права проверять.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * Статус - Строка - статус предложения после вызова.
//   * Ошибка - Строка - причина отказа или ошибки.
//   * Сообщения - Массив из Строка - сообщения проверки заполнения и записи.
//
Функция ВыполнитьИзменение(Идентификатор, ПользовательИБ = Неопределено) Экспорт

	Результат = Новый Структура("Успех, Статус, Ошибка, Сообщения", Ложь, "", "", Новый Массив);
	Если ТранзакцияАктивна() Тогда
		Результат.Ошибка = ТекстВнешнейТранзакции();
		Возврат Результат;
	КонецЕсли;
	Запись = ПрочитатьОжидающее(Идентификатор, Результат, ВидДействияЗаписи());
	Если Запись = Неопределено Тогда
		Результат.Статус = ТекущийСтатус(Идентификатор);
		Возврат Результат;
	КонецЕсли;
	Результат.Статус = "Ожидает";

	Если ХешПредложения(Запись) <> Запись.Хеш Тогда
		Возврат ЗавершитьВыполнение(Запись, Результат, "Отказ",
			НСтр("ru = 'Содержимое предложения изменилось после показа карточки - оно отклонено.'"));
	КонецЕсли;
	Данные = ОбщегоНазначения.JSONВЗначение(Запись.ДанныеJSON, , Истина);
	Ссылка = ОбщегоНазначения.ЗначениеИзСтрокиXML(Данные.Получить("ref"));
	// Профиль и версия политик - без кэша сеанса: снятое после предложения разрешение действует сразу.
	Правила = ИИА_ПрофилиДоступа.ПостроитьПравилаТекущегоПользователя(Истина);
	Если Правила = Неопределено Тогда
		Возврат ЗавершитьВыполнение(Запись, Результат, "Отказ",
			НСтр("ru = 'Профиль доступа ассистента вам больше не назначен.'"));
	КонецЕсли;
	Контекст = КонтекстИзменения(Правила, ПользовательИБ, "chat");
	Проверка = ПроверитьВидИОперацию(Ссылка, Запись.Операция, Контекст);
	Если Не ПустаяСтрока(Проверка.Код) Тогда
		Возврат ЗавершитьВыполнение(Запись, Результат, "Отказ", Проверка.Текст);
	КонецЕсли;
	Значения = Новый Соответствие;
	Для Каждого КлючИЗначение Из СоответствиеИзДанных(Данные, "after") Цикл
		Значения.Вставить(КлючИЗначение.Ключ, ОбщегоНазначения.ЗначениеИзСтрокиXML(КлючИЗначение.Значение));
	КонецЦикла;
	Если Значения.Количество() > 0 Тогда
		Отказы = ОтказыПолей(Проверка.ОбъектМетаданных, Проверка.Разрешение, Значения, Контекст);
		ОшибкиПолей = Новый Массив;
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ОшибкиПолей, Отказы.Права);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ОшибкиПолей, Отказы.Поля);
		Если ОшибкиПолей.Количество() > 0 Тогда
			Возврат ЗавершитьВыполнение(Запись, Результат, "Отказ", СтрШаблон(
				НСтр("ru = 'Изменять эти реквизиты вам больше не разрешено: %1.'"), СтрСоединить(ОшибкиПолей, "; ")));
		КонецЕсли;
	КонецЕсли;

	Для Каждого КлючИЗначение Из Значения Цикл
		Значение = КлючИЗначение.Значение;
		Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Значение)) И ЗначениеЗаполнено(Значение)
			И Не СсылкаДоступна(Значение, Контекст) Тогда
			Возврат ЗавершитьВыполнение(Запись, Результат, "Отказ", СтрШаблон(
				НСтр("ru = '%1: объект значения вам или ассистенту больше недоступен.'"), КлючИЗначение.Ключ));
		КонецЕсли;
	КонецЦикла;

	Исход = ЗаписатьИзменение(Запись, Ссылка, Значения, Контекст);
	Результат.Сообщения = Исход.Сообщения;
	Если Исход.Статус = "Выполнено" Тогда
		Результат.Успех = Истина;
		Результат.Статус = "Выполнено";
	ИначеЕсли Исход.Статус = "Ожидает" Или Исход.Статус = "Обработано" Тогда
		// Объект открыт в форме или предложение уже обработано: статус не меняется.
		Результат.Ошибка = Исход.Текст;
		Результат.Статус = ТекущийСтатус(Идентификатор);
	Иначе
		ЗавершитьВыполнение(Запись, Результат, Исход.Статус, Исход.Текст, Исход.Подробности);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Отклонение предложенного изменения владельцем.
//
// Параметры:
//  Идентификатор - Строка
//
// Возвращаемое значение:
//  Структура - Успех, Статус, Ошибка.
//
Функция ОтклонитьИзменение(Идентификатор) Экспорт

	Результат = Новый Структура("Успех, Статус, Ошибка, Сообщения", Ложь, "", "", Новый Массив);
	Запись = ПрочитатьОжидающее(Идентификатор, Результат, ВидДействияЗаписи());
	Если Запись = Неопределено Тогда
		Результат.Статус = ТекущийСтатус(Идентификатор);
		Возврат Результат;
	КонецЕсли;
	Если Не ЗавершитьОжидающее(Запись, "Отклонено", "") Тогда
		Результат.Ошибка = НСтр("ru = 'Предложение уже обработано.'");
		Результат.Статус = ТекущийСтатус(Идентификатор);
		Возврат Результат;
	КонецЕсли;
	Результат.Успех = Истина;
	Результат.Статус = "Отклонено";
	Возврат Результат;

КонецФункции

// Карточка изменения для показа пользователю: строится из записи ИИА_ОжидающиеДействия при каждом показе, значения
// раскрываются через ИИА_Маскирование.ДляПользователя (в правах пользователя). Сохранённый диалог хранит только
// идентификатор предложения и заголовок с псевдонимами.
//
// Параметры:
//  Идентификатор - Строка
//  Диалог - СправочникСсылка.ИИА_Диалоги, Неопределено - для номеров объектов в представлениях.
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если предложение не найдено или принадлежит другому пользователю:
//   * title, object, link, operation - Строка
//   * rows - Массив из Структура - name, from, to.
//   * dry - Структура - done, ok, stage, messages.
//   * warnings - Массив из Строка
//   * status - Строка - Ожидает, Выполнено, Отклонено, Отказ, Ошибка, Просрочено.
//   * canExec - Булево
//   * result - Строка - итог выполнения; messages - Массив из Строка.
//
Функция КарточкаИзменения(Идентификатор, Диалог = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Запись = РегистрыСведений.ИИА_ОжидающиеДействия.СоздатьМенеджерЗаписи();
	Запись.Идентификатор = Лев(СокрЛП(Идентификатор), 36);
	Запись.Прочитать();
	УстановитьПривилегированныйРежим(Ложь);
	Если Не Запись.Выбран() Или Запись.Пользователь <> Пользователи.ТекущийПользователь()
		Или Запись.ВидДействия <> ВидДействияЗаписи() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Данные = ОбщегоНазначения.JSONВЗначение(Запись.ДанныеJSON, , Истина);
	Ссылка = ОбщегоНазначения.ЗначениеИзСтрокиXML(Данные.Получить("ref"));
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Запись.ПолноеИмя);

	Было = СоответствиеИзДанных(Данные, "before");
	Стало = СоответствиеИзДанных(Данные, "after");
	Строки = Новый Массив;
	Для Каждого КлючИЗначение Из Стало Цикл
		Реквизит = ?(ОбъектМетаданных = Неопределено, Неопределено, РеквизитЗаписи(ОбъектМетаданных, КлючИЗначение.Ключ));
		Строки.Добавить(Новый Структура("name, from, to",
			?(Реквизит = Неопределено, КлючИЗначение.Ключ, Реквизит.Представление),
			ПредставлениеЗначенияXML(Было.Получить(КлючИЗначение.Ключ)), ПредставлениеЗначенияXML(КлючИЗначение.Значение)));
	КонецЦикла;
	Прогон = Данные.Получить("dry_run");
	Прогон = ?(ТипЗнч(Прогон) = Тип("Соответствие"), Прогон, Новый Соответствие);
	Сообщения = Прогон.Получить("messages");
	Сухой = Новый Структура("done, ok, stage, messages", Прогон.Получить("done") = Истина, Прогон.Получить("ok") = Истина,
		Строка(Прогон.Получить("stage")), ?(ТипЗнч(Сообщения) = Тип("Массив"), Сообщения, Новый Массив));
	Предупреждения = Данные.Получить("warnings");
	Если Запись.ЕстьЧужойТекст Тогда
		Предупреждения = ?(ТипЗнч(Предупреждения) = Тип("Массив"), Предупреждения, Новый Массив);
		Предупреждения.Добавить(НСтр("ru = 'Внимание: в данных ответа найден текст, похожий на инструкцию. Проверьте изменение особенно внимательно.'"));
	КонецЕсли;

	Статус = Запись.Статус;
	Если Статус = "Ожидает" И Запись.СрокДействия < ТекущаяДатаСеанса() Тогда
		Статус = "Просрочено";
	КонецЕсли;
	Итог = Новый Соответствие;
	Если Не ПустаяСтрока(Запись.Результат) Тогда
		Попытка
			Итог = ОбщегоНазначения.JSONВЗначение(Запись.Результат, , Истина);
		// Повреждённый итог выполнения карточка показывает без текста.
		Исключение // BSLLS:MissingCodeTryCatchEx-off
			Итог = Новый Соответствие;
		КонецПопытки;
	КонецЕсли;
	СообщенияИтога = Итог.Получить("messages");

	Карточка = Новый Структура;
	Карточка.Вставить("title", СтрШаблон(НСтр("ru = 'Изменение: %1'"), ПредставлениеОперации(Запись.Операция))
		+ ?(ПустаяСтрока(Строка(Данные.Получить("summary"))), "", ". " + Строка(Данные.Получить("summary"))));
	Карточка.Вставить("object", ИИА_Маскирование.ЗначениеДляМодели(Ссылка));
	Карточка.Вставить("link", ?(ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Ссылка)), ПолучитьНавигационнуюСсылку(Ссылка), ""));
	Карточка.Вставить("operation", Запись.Операция);
	Карточка.Вставить("rows", Строки);
	Карточка.Вставить("dry", Сухой);
	Карточка.Вставить("warnings", ?(ТипЗнч(Предупреждения) = Тип("Массив"), Предупреждения, Новый Массив));
	Карточка.Вставить("status", Статус);
	Карточка.Вставить("canExec", Статус = "Ожидает");
	Карточка.Вставить("result", Строка(?(Итог.Получить("message") = Неопределено, "", Итог.Получить("message"))));
	Карточка.Вставить("messages", ?(ТипЗнч(СообщенияИтога) = Тип("Массив"), СообщенияИтога, Новый Массив));
	Возврат ИИА_Маскирование.ДляПользователя(Карточка, Диалог);

КонецФункции

// Пробный прогон изменения (вызывается через ИИА_ИзолированноеВыполнение.ВыполнитьМетод, в клиент-серверной базе -
// во вложенном фоновом задании): изменение в транзакции, проверка заполнения, запись или проведение и безусловный
// откат. Сообщения забирает вызывающий помощник; здесь ПолучитьСообщенияПользователю не вызывается.
//
// Параметры:
//  Ссылка - ДокументСсылка, СправочникСсылка
//  Операция - Строка - set_fields, post, unpost, mark_deletion, unmark_deletion.
//  ЗначенияXML - Соответствие из КлючИЗначение - имя реквизита -> значение в XML (для set_fields).
//  АдресРезультата - Строка - сюда кладётся Структура: ok, stage, error.
//
Процедура ВыполнитьПробныйПрогон(Ссылка, Операция, ЗначенияXML, АдресРезультата) Экспорт

	Итог = Новый Структура("ok, stage, error", Ложь, "", "");
	Если ТранзакцияАктивна() Тогда
		// Вложенная отмена испортила бы внешнюю транзакцию: прогон не выполняется.
		Итог.stage = "transaction";
		Итог.error = ТекстВнешнейТранзакции();
		ПоместитьВоВременноеХранилище(Итог, АдресРезультата);
		Возврат;
	КонецЕсли;
	Этап = "lock";
	НачатьТранзакцию();
	Попытка
		Объект = Ссылка.ПолучитьОбъект();
		Объект.Заблокировать();
		Для Каждого КлючИЗначение Из ЗначенияXML Цикл
			Объект[КлючИЗначение.Ключ] = ОбщегоНазначения.ЗначениеИзСтрокиXML(КлючИЗначение.Значение);
		КонецЦикла;
		// Отказ проверки заполнения при проведении - этап post (как отказ проведения в форме).
		Этап = ?(Операция = "post", "post", "fill_check");
		Если Не НужнаПроверкаЗаполнения(Объект, Операция) Или Объект.ПроверитьЗаполнение() Тогда
			Этап = ЭтапЗаписи(Объект, Операция);
			ЗаписатьОперацию(Объект, Операция);
			Итог.ok = Истина;
		КонецЕсли;
		// Прогон не фиксируется ни при каком исходе.
		ОтменитьТранзакцию(); // BSLLS:WrongUseOfRollbackTransactionMethod-off
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		ОтменитьТранзакцию();
		// Ошибка записи - итог прогона: текст уходит в карточку и журнал предложения.
		Итог.error = Лев(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), 300);
	КонецПопытки;
	Итог.stage = ?(Итог.ok, "", Этап);
	ПоместитьВоВременноеХранилище(Итог, АдресРезультата);

КонецПроцедуры

// Ошибки строки разрешения «Запись данных» профиля (проверка при записи профиля): вид - документ или справочник
// вне запрета периметра, операции применимы к виду, реквизиты существуют, не закрыты периметром и не маскируются.
//
// Параметры:
//  ПолноеИмя - Строка
//  Проведение - Булево
//  ОтменаПроведения - Булево
//  Реквизиты - Строка - имена через запятую; пусто - все допустимые.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ОшибкиРазрешенияЗаписи(ПолноеИмя, Проведение, ОтменаПроведения, Реквизиты) Экспорт

	Ошибки = Новый Массив;
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(СокрЛП(ПолноеИмя));
	ЭтоДокумент = ОбъектМетаданных <> Неопределено И Метаданные.Документы.Содержит(ОбъектМетаданных);
	Если ОбъектМетаданных = Неопределено Или Не ЭтоДокумент И Не Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
		Ошибки.Добавить(СтрШаблон(НСтр("ru = '%1 - не документ и не справочник конфигурации.'"), ПолноеИмя));
		Возврат Ошибки;
	КонецЕсли;
	Причина = ИИА_Периметр.ОписаниеПериметра().ЗапрещенныеОбъекты.Получить(ВРег(ОбъектМетаданных.ПолноеИмя()));
	Если Причина <> Неопределено Тогда
		Ошибки.Добавить(СтрШаблон(НСтр("ru = '%1 вне периметра ассистента (%2).'"), ПолноеИмя, Причина));
		Возврат Ошибки;
	КонецЕсли;
	Если Не ЭтоДокумент И (Проведение Или ОтменаПроведения) Тогда
		Ошибки.Добавить(НСтр("ru = 'у справочника нет проведения и отмены проведения.'"));
	ИначеЕсли ЭтоДокумент И (Проведение Или ОтменаПроведения)
		И ОбъектМетаданных.Проведение = Метаданные.СвойстваОбъектов.Проведение.Запретить Тогда
		Ошибки.Добавить(НСтр("ru = 'документ не проводится.'"));
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить(Реквизиты, ",", Ложь) Цикл
		Причина = ПричинаОтказаПоля(ОбъектМетаданных, СокрЛП(Имя), Неопределено, Неопределено, Новый Массив);
		Если Не ПустаяСтрока(Причина) Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = 'реквизит %1: %2.'"), СокрЛП(Имя), Причина));
		КонецЕсли;
	КонецЦикла;
	Возврат Ошибки;

КонецФункции

// Документы, черновики которых разрешены профилем пользователя и периметром.
//
// Возвращаемое значение:
//  Массив из Строка - полные имена.
//
Функция ДопустимыеДокументы() Экспорт

	СписокДокументов = Новый Массив;
	Профиль = ИИА_ПрофилиДоступа.ЭффективныйПрофиль(Пользователи.ТекущийПользователь());
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		Возврат СписокДокументов;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Действия = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Профиль, "Действия");
	УстановитьПривилегированныйРежим(Ложь);
	Для Каждого Строка Из Действия.Выгрузить() Цикл
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(СокрЛП(Строка.ПолноеИмя));
		Если ОбъектМетаданных = Неопределено Или Не Метаданные.Документы.Содержит(ОбъектМетаданных)
			Или ИИА_Периметр.ОбъектЗапрещен(ОбъектМетаданных.ПолноеИмя())
			Или Не ПравоДоступа("ИнтерактивноеДобавление", ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		СписокДокументов.Добавить(ОбъектМетаданных.ПолноеИмя());
	КонецЦикла;
	Возврат СписокДокументов;

КонецФункции

// Что мешает выполнить операцию с документом или элементом справочника: права ролей, состояние объекта, RLS и дата
// запрета изменения. Единственный источник прав на операцию: typed-write трактует препятствие как отказ,
// check_filling только сообщает о нём. Права на отдельные реквизиты не проверяются. Исключений не вызывает,
// кроме ошибок самой БСП. Вызовы БСП условные (ПодсистемаСуществует), привилегированный режим не используется.
//
// Параметры:
//  ОбъектИлиСсылка - ДокументСсылка, СправочникСсылка, ДокументОбъект, СправочникОбъект - объект с применёнными
//    изменениями (тогда RLS и дата запрета проверяются по новому состоянию) или ссылка (текущее состояние в базе).
//  Операция - Строка - write (запись без проведения, set_fields typed-write), post, unpost, mark_deletion,
//    unmark_deletion.
//  ПользовательИБ - ПользовательИнформационнойБазы, Неопределено - чьи права проверять; Неопределено - текущего.
//    Для другого пользователя RLS проверяется от имени его элемента справочника Пользователи (нужны административные
//    права, см. УправлениеДоступом.ИзменениеРазрешено), дата запрета - для текущего пользователя сеанса.
//
// Возвращаемое значение:
//  Структура:
//   * Допустимо - Булево - нет причин и RLS не запретил.
//   * Причины - Массив из Структура - Код (ACCESS_DENIED, RLS_DENIED, CHANGE_PROHIBITED, BAD_STATE, BAD_OPERATION),
//       Текст (без данных; текст запрета БСП очищен ИИА_Периметр.ОчиститьТекст).
//   * Права - Соответствие из КлючИЗначение - имя права -> Булево, по таблице операции.
//   * RLS - Булево, Неопределено - разрешено ли изменение по RLS; Неопределено - подсистемы нет, RLS не проверен
//       (окончательно его проверит запись).
//   * RLSПоНовомуСостоянию - Булево - RLS проверен по переданному объекту, а не по состоянию в базе.
//   * ИзменениеЗапрещено - Булево, Неопределено - действует дата запрета; Неопределено - подсистемы нет.
//   * ТекстЗапрета - Строка - описание запрета от БСП как есть (до 500 символов): выдавать модели только через
//       границу данных (ИИА_ГраницаЗапроса.РезультатИзТаблицы).
//   * Проведен - Булево
//   * ПометкаУдаления - Булево
//
Функция ПрепятствияОперации(ОбъектИлиСсылка, Операция, ПользовательИБ = Неопределено) Экспорт

	Результат = Новый Структура("Допустимо, Причины, Права, RLS, RLSПоНовомуСостоянию, ИзменениеЗапрещено, ТекстЗапрета,
		|Проведен, ПометкаУдаления", Ложь, Новый Массив, Новый Соответствие, Неопределено, Ложь, Неопределено, "",
		Ложь, Ложь);
	// Аргумент неподходящего типа (не документ и не справочник, пустая ссылка) - отказ, а не исключение.
	ЭтоСсылка = ОбщегоНазначения.ЭтоСсылка(ТипЗнч(ОбъектИлиСсылка));
	ОбъектМетаданных = ?(ОбъектИлиСсылка = Неопределено, Неопределено, Метаданные.НайтиПоТипу(ТипЗнч(ОбъектИлиСсылка)));
	ЭтоДокумент = ОбъектМетаданных <> Неопределено И Метаданные.Документы.Содержит(ОбъектМетаданных);
	Если ОбъектМетаданных = Неопределено Или ЭтоСсылка И ОбъектИлиСсылка.Пустая()
		Или Не ЭтоДокумент И Не Метаданные.Справочники.Содержит(ОбъектМетаданных)
		Или СтрРазделить("write,post,unpost,mark_deletion,unmark_deletion", ",").Найти(Операция) = Неопределено
		Или Не ЭтоДокумент И (Операция = "post" Или Операция = "unpost") Тогда
		ДобавитьПричину(Результат, "BAD_OPERATION", СтрШаблон(НСтр("ru = 'Операция %1 не применима к %2.'"),
			Операция, ?(ОбъектМетаданных = Неопределено, Строка(ТипЗнч(ОбъектИлиСсылка)), ОбъектМетаданных.ПолноеИмя())));
		Возврат Результат;
	КонецЕсли;

	// Состояние: у ссылки - одним обращением к базе, у объекта - из памяти (с изменениями).
	Если ЭтоСсылка Тогда
		Состояние = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбъектИлиСсылка,
			?(ЭтоДокумент, "ПометкаУдаления, Проведен", "ПометкаУдаления"));
	Иначе
		Состояние = ОбъектИлиСсылка;
	КонецЕсли;
	Результат.ПометкаУдаления = Состояние.ПометкаУдаления = Истина;
	Результат.Проведен = ЭтоДокумент И Состояние.Проведен = Истина;

	// Права ролей: действие инициирует пользователь, поэтому нужны и программное, и интерактивное право.
	Для Каждого Право Из ПраваОперации(Операция, ЭтоДокумент, Результат.Проведен) Цикл
		Разрешено = ?(ПользовательИБ = Неопределено, ПравоДоступа(Право, ОбъектМетаданных),
			ПравоДоступа(Право, ОбъектМетаданных, ПользовательИБ));
		Результат.Права.Вставить(Право, Разрешено);
		Если Не Разрешено Тогда
			ДобавитьПричину(Результат, "ACCESS_DENIED", СтрШаблон(НСтр("ru = 'Нет права «%1» на %2.'"), Право,
				ОбъектМетаданных.Представление()));
		КонецЕсли;
	КонецЦикла;

	ТекстСостояния = ТекстНедопустимогоСостояния(Операция, Результат.Проведен, Результат.ПометкаУдаления);
	Если Не ПустаяСтрока(ТекстСостояния) Тогда
		ДобавитьПричину(Результат, "BAD_STATE", ТекстСостояния);
	КонецЕсли;
	ПроверитьRLS(Результат, ОбъектИлиСсылка, ЭтоСсылка, ПользовательИБ);
	ПроверитьДатуЗапрета(Результат, ОбъектИлиСсылка, ЭтоСсылка);

	Результат.Допустимо = Результат.Причины.Количество() = 0;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИзменениеДанных

// Описание propose_change по разрешениям профиля и правам пользователя; Неопределено - разрешённого нет.
Функция ОписаниеИнструментаИзменения()

	Виды = Новый Массив;
	Операции = Новый Массив;
	Для Каждого Элемент Из РазрешенияЗаписи(ИИА_ПериметрПовтИсп.ПравилаПрофиля()) Цикл
		Разрешение = Элемент.Значение;
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Разрешение.ПолноеИмя);
		Если Не ЭтоВидДляЗаписи(ОбъектМетаданных) Или ИИА_Периметр.ОбъектЗапрещен(ОбъектМетаданных.ПолноеИмя()) Тогда
			Продолжить;
		КонецЕсли;
		ЭтоДокумент = Метаданные.Документы.Содержит(ОбъектМетаданных);
		ОперацииВида = Новый Массив;
		Для Каждого Операция Из ОперацииЗаписи() Цикл
			Если Не ОперацияРазрешена(Разрешение, Операция) Или Не ЭтоДокумент И (Операция = "post" Или Операция = "unpost") Тогда
				Продолжить;
			КонецЕсли;
			ЕстьПрава = Истина;
			Для Каждого Право Из ПраваОперации(ОперацияПрав(Операция), ЭтоДокумент, Ложь) Цикл
				ЕстьПрава = ЕстьПрава И ПравоДоступа(Право, ОбъектМетаданных);
			КонецЦикла;
			Если ЕстьПрава Тогда
				ОперацииВида.Добавить(Операция);
				Если Операции.Найти(Операция) = Неопределено Тогда
					Операции.Добавить(Операция);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если ОперацииВида.Количество() > 0 Тогда
			Реквизиты = ?(Разрешение.Реквизиты.Количество() = 0, "", " (" + СтрСоединить(Разрешение.Реквизиты, ", ") + ")");
			Виды.Добавить(ОбъектМетаданных.ПолноеИмя() + ": " + СтрСоединить(ОперацииВида, ", ")
				+ ?(ОперацииВида.Найти("set_fields") = Неопределено, "", Реквизиты));
		КонецЕсли;
	КонецЦикла;
	Если Виды.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Свойства = Новый Соответствие;
	Свойства.Вставить("object", СвойствоПараметра("string",
		НСтр("ru = 'Метка объекта хода o1, o2, ... из результатов find_records, run_query или read_object этого ответа (документ или элемент справочника).'")));
	Операция = СвойствоПараметра("string", НСтр("ru = 'set_fields - установить реквизиты шапки; post - провести; unpost - отменить проведение; mark_deletion / unmark_deletion - установить / снять пометку удаления.'"));
	Операция.Вставить("enum", Операции);
	Свойства.Вставить("operation", Операция);
	Поля = Новый Соответствие;
	Поля.Вставить("type", "object");
	Поля.Вставить("description", НСтр("ru = 'Только для set_fields, от 1 до 10: имя реквизита шапки (из describe_metadata) -> значение строкой. Ссылка - метка o<N> или псевдоним из данных хода (для части видов также точный номер или код); дата ГГГГ-ММ-ДД; число; true/false; точное имя значения перечисления; пустая строка - очистить реквизит.'"));
	Свойства.Вставить("fields", Поля);
	Свойства.Вставить("summary", СвойствоПараметра("string", НСтр("ru = 'Одна фраза: что и зачем меняется.'")));

	Функция_ = Новый Соответствие;
	Функция_.Вставить("name", "propose_change");
	Функция_.Вставить("description", СтрШаблон(НСтр("ru = 'Предлагает пользователю изменить один существующий объект: показывает карточку «было/стало» с итогом пробного прогона. Ничего не записывает: запись выполняет пользователь кнопкой «Выполнить». Используй, только когда пользователь явно просит изменить, провести, отменить проведение или пометить объект; одна карточка за ответ. Разрешено: %1.'"),
		СтрСоединить(Виды, "; ")));
	Схема = Новый Соответствие;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", СтрРазделить("object,operation", ","));
	Функция_.Вставить("parameters", Схема);
	Инструмент = Новый Соответствие;
	Инструмент.Вставить("type", "function");
	Инструмент.Вставить("function", Функция_);
	Возврат Инструмент;

КонецФункции

// Разрешения «Запись данных» действующего профиля текущего пользователя (с учётом режима версий политик).
Функция РазрешенияЗаписи(Правила)

	Если Правила = Неопределено Или Не Правила.Свойство("ЗаписьДанных") Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	Возврат Правила.ЗаписьДанных;

КонецФункции

Функция ОперацииЗаписи()

	Возврат СтрРазделить("set_fields,post,unpost,mark_deletion,unmark_deletion", ",");

КонецФункции

Функция ОперацияРазрешена(Разрешение, Операция)

	Если Операция = "set_fields" Тогда
		Возврат Разрешение.Изменение;
	ИначеЕсли Операция = "post" Тогда
		Возврат Разрешение.Проведение;
	ИначеЕсли Операция = "unpost" Тогда
		Возврат Разрешение.ОтменаПроведения;
	КонецЕсли;
	Возврат Разрешение.ПометкаУдаления;

КонецФункции

// Операция для ПрепятствияОперации: запись реквизитов - write, остальные - под своими именами.
