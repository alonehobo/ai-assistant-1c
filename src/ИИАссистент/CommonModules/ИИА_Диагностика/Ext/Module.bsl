// BSLLS:CommonModuleInvalidType-off
// Только сервер: вызов с клиента и внешнее соединение намеренно отключены.
// BSLLS:CommonModuleInvalidType-on
///////////////////////////////////////////////////////////////////////////////////////////////////////
// ИИ-ассистент: инструменты диагностики «почему не проводится», «почему не вижу поле» - только чтение.
//  - event_log: журнал регистрации в правах пользователя (без права «Журнал регистрации» инструмента нет);
//  - check_filling: обязательные поля по метаданным, ПроверитьЗаполнение() записанного объекта без записи
//    и препятствия операции (ИИА_Действия.ПрепятствияОперации);
//  - field_visibility: есть ли поле на форме, видно ли и доступно ли, права и функциональные опции.
// Своего маскирования нет: значения уходят модели через ИИА_ГраницаЗапроса.РезультатИзТаблицы, свободный текст -
// через конверт защиты от инъекций в ИИА_Агент. Чтение журнала и проверка - через ИИА_ИзолированноеВыполнение.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Описания инструментов диагностики в формате OpenAI tools (до фильтра профиля, см. ИИА_Инструменты).
//
// Параметры:
//  Канал - Строка - "chat" или "http": во внешнем канале field_visibility отвечает только по метаданным.
//
// Возвращаемое значение:
//  Массив из Соответствие
//
Функция ОписанияИнструментов(Канал = "http") Экспорт

	Инструменты = Новый Массив;
	ОписаниеОбъекта = НСтр("ru = 'Объект хода o1, o2… (из find_records, run_query, read_object) или ""@context"" - объект, из которого открыт чат.'");

	Если ДоступенЖурналРегистрации() Тогда
		Свойства = Новый Соответствие;
		Свойства.Вставить("id", СвойствоПараметра("string", ОписаниеОбъекта + " " + НСтр("ru = 'События по этому объекту.'")));
		Свойства.Вставить("ref", СвойствоПараметра("string", НСтр("ru = 'Навигационная ссылка e1cib/data/… на объект (внешний канал).'")));
		Свойства.Вставить("object_type", СвойствоПараметра("string",
			НСтр("ru = 'Полное имя объекта метаданных, например «Документ.ЗаказКлиента»: события по всем его объектам.'")));
		Свойства.Вставить("user", СвойствоПараметра("string",
			НСтр("ru = 'Псевдоним пользователя Пользователь_… из результатов или ""me"" - текущий пользователь.'")));
		Свойства.Вставить("events", СписокЗначенийПараметра(СловарьСобытий(),
			НСтр("ru = 'Виды событий: post - проведение, unpost - отмена проведения, write - изменение (в том числе пометка удаления), new - создание, delete - удаление, error - только события уровня «Ошибка», any - любые.'")));
		Свойства.Вставить("levels", СписокЗначенийПараметра(СловарьУровней(), НСтр("ru = 'Уровни событий.'")));
		Период = Новый Соответствие;
		Период.Вставить("type", "object");
		СвойстваПериода = Новый Соответствие;
		СвойстваПериода.Вставить("from", СвойствоПараметра("string", НСтр("ru = 'ГГГГ-ММ-ДД или ГГГГ-ММ-ДДTчч:мм:сс.'")));
		СвойстваПериода.Вставить("to", СвойствоПараметра("string", НСтр("ru = 'ГГГГ-ММ-ДД (весь день) или ГГГГ-ММ-ДДTчч:мм:сс.'")));
		Период.Вставить("properties", СвойстваПериода);
		Период.Вставить("description", СтрШаблон(НСтр("ru = 'По умолчанию последние %1 дней, не больше %2 дней.'"),
			ДнейПоУмолчанию(), МаксимумДнейПериода()));
		Свойства.Вставить("period", Период);
		Свойства.Вставить("limit", СвойствоПараметра("integer",
			СтрШаблон(НСтр("ru = 'Сколько последних записей вернуть, от 1 до %1, по умолчанию %2.'"), МаксимумЗаписей(), ЗаписейПоУмолчанию())));
		Инструменты.Добавить(ОписаниеИнструмента("event_log",
			НСтр("ru = 'Журнал регистрации в правах пользователя: последние события по объекту, виду объектов, пользователю, виду и уровню события за период (от новых к старым). Для вопроса «почему не проводится» сначала вызови check_filling: платформа не пишет в журнал причину отказа проведения, если её не записал код конфигурации, - тогда видны только отменённые транзакции.'"),
			Свойства));
	КонецЕсли;

	Свойства = Новый Соответствие;
	Свойства.Вставить("id", СвойствоПараметра("string", ОписаниеОбъекта + " " + НСтр("ru = 'Проверить этот записанный объект.'")));
	Свойства.Вставить("ref", СвойствоПараметра("string", НСтр("ru = 'Навигационная ссылка e1cib/data/… на объект (внешний канал).'")));
	Свойства.Вставить("object_type", СвойствоПараметра("string",
		НСтр("ru = 'Без объекта: полное имя документа или справочника - только обязательные поля по метаданным.'")));
	Режим = СвойствоПараметра("string", НСтр("ru = 'post - как при проведении (по умолчанию для документов), write - как при записи.'"));
	Режим.Вставить("enum", СтрРазделить("post,write", ","));
	Свойства.Вставить("mode", Режим);
	Инструменты.Добавить(ОписаниеИнструмента("check_filling",
		НСтр("ru = 'Почему документ не проводится или объект не записывается: обязательные поля по метаданным, незаполненные поля и сообщения проверки заполнения записанного объекта (без записи), препятствия - проведён, помечен на удаление, нет прав, дата запрета изменения. Нужен ровно один из id, ref, object_type. Ошибки проведения из кода (контроль остатков, взаиморасчёты) так не видны: их показывает только пробный прогон записи, если профиль разрешает запись.'"),
		Свойства));

	Свойства = Новый Соответствие;
	Свойства.Вставить("object", СвойствоПараметра("string", НСтр("ru = 'Полное имя объекта, например «Документ.ЗаказКлиента».'")));
	Свойства.Вставить("field", СвойствоПараметра("string",
		НСтр("ru = 'Имя или синоним реквизита; для табличной части - «Товары.Цена».'")));
	Свойства.Вставить("form", СвойствоПараметра("string", НСтр("ru = 'Необязательно: имя формы; пусто - основная форма объекта.'")));
	Свойства.Вставить("id", СвойствоПараметра("string",
		НСтр("ru = 'Необязательно: объект хода o1… или ""@context"" - видимость с данными этого объекта.'")));
	Инструменты.Добавить(ОписаниеИнструмента("field_visibility",
		?(Канал = "chat",
		НСтр("ru = 'Почему пользователь не видит поле или не может его изменить: есть ли элемент поля на форме, виден ли он (с учётом скрытых групп), доступен ли, только ли для просмотра; права на реквизит и функциональные опции. С id видимость считается с данными объекта. Причину в коде формы ищи rlm_execute, если доступен исходный код.'"),
		НСтр("ru = 'Почему пользователь не видит поле или не может его изменить: права на реквизит и функциональные опции. Состояние элемента формы во внешнем канале недоступно (on_form = FORM_UNAVAILABLE).'")),
		Свойства, "object,field"));

	Возврат Инструменты;

КонецФункции

// Является ли инструмент инструментом диагностики.
//
// Параметры:
//  Имя - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоИнструментДиагностики(Имя) Экспорт

	Возврат Имя = "event_log" Или Имя = "check_filling" Или Имя = "field_visibility";

КонецФункции

// Выполняет инструмент диагностики. Профиль уже проверен вызывающим (ИИА_Инструменты.ВыполнитьИнструмент).
//
// Параметры:
//  Имя - Строка
//  Аргументы - Соответствие
//  Результат - Структура - см. ИИА_Инструменты.ВыполнитьИнструмент.
//  ОбъектыХода - Массив из Структура, Неопределено - объекты хода (Текст, Значение): по ним разрешаются id o1, o2…;
//    вне хода (внешний канал) не передаются, объект задаётся ref.
//  Контекст - ЛюбаяСсылка, Неопределено - объект, из которого открыт чат (id = "@context").
//  СтруктурыФорм - Соответствие, Неопределено - структуры форм от клиента чата (см. ИИА_ИсходныйКод.
//    КлючСтруктурыФормыИнструмента); Неопределено - клиента нет.
//
// Возвращаемое значение:
//  Структура - Результат.
//
Функция ВыполнитьИнструмент(Имя, Аргументы, Результат, ОбъектыХода = Неопределено, Контекст = Неопределено,
	СтруктурыФорм = Неопределено) Экспорт

	Если Имя = "event_log" Тогда
		Возврат ПрочитатьЖурнал(Результат, Аргументы, ОбъектыХода, Контекст);
	ИначеЕсли Имя = "check_filling" Тогда
		Возврат ПроверитьЗаполнениеОбъекта(Результат, Аргументы, ОбъектыХода, Контекст);
	ИначеЕсли Имя = "field_visibility" Тогда
		Возврат ВидимостьПоля(Результат, Аргументы, ОбъектыХода, Контекст, СтруктурыФорм);
	КонецЕсли;
	Возврат Отказ(Результат, "UNKNOWN_TOOL", СтрШаблон(НСтр("ru = 'Инструмент %1 не зарегистрирован.'"), Имя));

КонецФункции

// Есть ли у текущего пользователя право «Журнал регистрации». Без него event_log не описывается модели и отказывает.
//
// Возвращаемое значение:
//  Булево
//
Функция ДоступенЖурналРегистрации() Экспорт

	// Канонический вызов: право «Журнал регистрации» задаётся на конфигурацию (Метаданные).
	Возврат ПравоДоступа("ЖурналРегистрации", Метаданные); // BSLLS:TypeMismatch-off

КонецФункции

// Ссылка объекта по аргументу id инструмента: "@context" или объект хода o1, o2… с проверкой доступности
// (ИИА_Инструменты.ПроверитьДоступностьОбъекта).
//
// Параметры:
//  Идентификатор - Строка
//  ОбъектыХода - Массив из Структура, Неопределено
//  Контекст - ЛюбаяСсылка, Неопределено
//  Код - Строка - возвращаемый код отказа: NO_CONTEXT, NOT_FOUND, PERIMETER_VIOLATION, ACCESS_DENIED.
//
// Возвращаемое значение:
//  ЛюбаяСсылка, Неопределено - Неопределено при отказе.
//
Функция ОбъектПоИдентификатору(Знач Идентификатор, ОбъектыХода, Контекст, Код = "") Экспорт

	Идентификатор = СокрЛП(Идентификатор);
	Ссылка = Неопределено;
	Если Идентификатор = "@context" Тогда
		Если Контекст = Неопределено Тогда
			Код = "NO_CONTEXT";
			Возврат Неопределено;
		КонецЕсли;
		Ссылка = Контекст;
	Иначе
		Номер = НомерОбъектаХода(Идентификатор);
		Если ОбъектыХода <> Неопределено И Номер > 0 И Номер <= ОбъектыХода.Количество()
			И ОбъектыХода[Номер - 1].Свойство("Значение") Тогда
			Ссылка = ОбъектыХода[Номер - 1].Значение;
		КонецЕсли;
	КонецЕсли;
	Возврат ДоступныйОбъект(Ссылка, Код);

КонецФункции

// Выгружает журнал регистрации окнами назад от конца периода (фоновое задание ИИА_ИзолированноеВыполнение или
// текущий сеанс). Строки объектов вне периметра и профиля исключаются и считаются. Вызывать не напрямую.
//
// Параметры:
//  ПараметрыЧтения - Структура - ДатаНачала, ДатаОкончания, Данные, Метаданные (полное имя), Пользователь (имя
//    пользователя ИБ), События (Массив из Строка), Уровни (Массив из Строка - имена УровеньЖурналаРегистрации), Лимит.
//  АдресРезультата - Строка - см. ИИА_ИзолированноеВыполнение.ВыполнитьМетод.
//
Процедура ВыгрузитьЖурналВФоне(ПараметрыЧтения, АдресРезультата) Экспорт

	ПоместитьВоВременноеХранилище(ПрочитатьОкнаЖурнала(ПараметрыЧтения), АдресРезультата);

КонецПроцедуры

// Проверка заполнения записанного объекта без записи (фоновое задание ИИА_ИзолированноеВыполнение или текущий
// сеанс). Вне внешней транзакции проверка идёт в своей транзакции с откатом: страховка от записи в прикладном
// обработчике ОбработкаПроверкиЗаполнения. Вызывать не напрямую.
//
// Параметры:
//  Ссылка - ДокументСсылка, СправочникСсылка
//  АдресРезультата - Строка - Булево (проверка пройдена) или Неопределено (объект не найден).
//
Процедура ПроверитьЗаполнениеВФоне(Ссылка, АдресРезультата) Экспорт

	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		ПоместитьВоВременноеХранилище(Неопределено, АдресРезультата);
		Возврат;
	КонецЕсли;
	Если ТранзакцияАктивна() Тогда
		// Внешнюю транзакцию откатывает её владелец; вложенный откат сломал бы её.
		Прошла = Объект.ПроверитьЗаполнение();
	Иначе
		НачатьТранзакцию();
		Попытка
			Прошла = Объект.ПроверитьЗаполнение();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
		// Проверка ничего не записывает: транзакция только страхует от записи в прикладном обработчике.
		ОтменитьТранзакцию(); // BSLLS:WrongUseOfRollbackTransactionMethod-off
	КонецЕсли;
	ПоместитьВоВременноеХранилище(Прошла, АдресРезультата);

КонецПроцедуры

// Причины видимости поля по структуре формы от клиента (для field_visibility и тестов).
//
// Параметры:
//  Структура - Массив из Структура - элементы формы, см. ИИА_ЧатКлиент.СтруктураФормы.
//  Поле - Структура - см. РазрешитьПоле: Имя, ТЧ, Заголовок.
//
// Возвращаемое значение:
//  Структура - для модели: status (found, not_found), match (by_name, by_title, not_found), element, path, visible,
//    hidden_by, enabled, read_only, candidates.
//
Функция ПолеНаФорме(Структура, Поле) Экспорт

	Элементы = ЭлементыСтруктуры(Структура);
	ВидыПолей = СтрРазделить("InputField,LabelField,CheckBoxField,RadioButtonField,PictureField", ",");
	ПоИмени = Новый Массив;
	ПоЗаголовку = Новый Массив;
	ИмяВТаблице = НРег(Поле.ТЧ + Поле.Имя);
	Для Индекс = 0 По Элементы.ВГраница() Цикл
		Элемент = Элементы[Индекс];
		Если ВидыПолей.Найти(Элемент.Вид) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Имя = НРег(Элемент.Имя);
		Если ПустаяСтрока(Поле.ТЧ) Тогда
			СовпалоИмя = ПустаяСтрока(Элемент.Таблица) И Имя = НРег(Поле.Имя);
		Иначе
			СовпалоИмя = Имя = ИмяВТаблице Или НРег(Элемент.Таблица) = НРег(Поле.ТЧ) И СтрЗаканчиваетсяНа(Имя, НРег(Поле.Имя));
		КонецЕсли;
		Если СовпалоИмя Тогда
			ПоИмени.Добавить(Индекс);
		ИначеЕсли Не ПустаяСтрока(Поле.Заголовок) И НРег(Элемент.Заголовок) = НРег(Поле.Заголовок)
			И ПустаяСтрока(Элемент.Таблица) = ПустаяСтрока(Поле.ТЧ) Тогда
			ПоЗаголовку.Добавить(Индекс);
		КонецЕсли;
	КонецЦикла;

	Ответ = Новый Структура("status, match, element, path, visible, hidden_by, enabled, read_only, candidates",
		"not_found", "not_found", Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, Неопределено,
		Новый Массив);
	Найденные = ?(ПоИмени.Количество() > 0, ПоИмени, ПоЗаголовку);
	Если Найденные.Количество() = 0 Тогда
		Возврат Ответ;
	КонецЕсли;
	Ответ.status = "found";
	Ответ.match = ?(ПоИмени.Количество() > 0, "by_name", "by_title");
	Для Каждого Индекс Из Найденные Цикл
		Если Ответ.candidates.Количество() >= МаксимумКандидатов() Тогда
			Прервать;
		КонецЕсли;
		Ответ.candidates.Добавить(Элементы[Индекс].Имя);
	КонецЦикла;

	Индекс = Найденные[0];
	Элемент = Элементы[Индекс];
	Видим = Элемент.Видим;
	Доступен = Элемент.Доступность;
	ТолькоПросмотр = Элемент.ТолькоПросмотр;
	СкрытПредком = Неопределено;
	Путь = Новый Массив;
	Для Каждого Предок Из ПредкиЭлемента(Элементы, Индекс) Цикл
		Если Не Предок.Видим И Видим Тогда
			СкрытПредком = Новый Структура("element, title", Предок.Имя, Предок.Заголовок);
		КонецЕсли;
		Видим = Видим И Предок.Видим;
		Доступен = Доступен И Предок.Доступность;
		ТолькоПросмотр = ТолькоПросмотр Или Предок.ТолькоПросмотр;
		Если Не ПустаяСтрока(Предок.Заголовок) И Предок.Вид <> "CommandBar" И Предок.Вид <> "AutoCommandBar" Тогда
			Путь.Вставить(0, Предок.Заголовок);
		КонецЕсли;
	КонецЦикла;
	Путь.Добавить(?(ПустаяСтрока(Элемент.Заголовок), Поле.Заголовок, Элемент.Заголовок));
	Ответ.element = Элемент.Имя;
	Ответ.path = СтрСоединить(Путь, " › ");
	Ответ.visible = Видим;
	Ответ.hidden_by = СкрытПредком;
	Ответ.enabled = Доступен;
	Ответ.read_only = ТолькоПросмотр;
	Возврат Ответ;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЖурналРегистрации

Функция ПрочитатьЖурнал(Результат, Аргументы, ОбъектыХода, Контекст)

	Если Не ДоступенЖурналРегистрации() Тогда
		Возврат Отказ(Результат, "ACCESS_DENIED",
			НСтр("ru = 'У пользователя нет права «Журнал регистрации». Ассистент читает журнал только в правах пользователя; право выдаёт администратор (роль с правом «Журнал регистрации» или «Администрирование»).'"));
	КонецЕсли;

	ПараметрыЧтения = Новый Структура("ДатаНачала, ДатаОкончания, Данные, Метаданные, Пользователь, События, Уровни, Лимит",
		Неопределено, Неопределено, Неопределено, "", "", Новый Массив, Новый Массив, ЗаписейПоУмолчанию());
	Фильтры = Новый Структура;
	Ошибка = "";
	Если Не РазобратьПериод(Аргументы.Получить("period"), ПараметрыЧтения, Ошибка)
		Или Не РазобратьСобытия(Аргументы, ПараметрыЧтения, Фильтры, Ошибка) Тогда
		Возврат Отказ(Результат, "BAD_ARGUMENTS", Ошибка);
	КонецЕсли;
	Лимит = Аргументы.Получить("limit");
	Если ТипЗнч(Лимит) = Тип("Число") Тогда
		ПараметрыЧтения.Лимит = Мин(Макс(Цел(Лимит), 1), МаксимумЗаписей());
	КонецЕсли;

	// Объект: id/ref - отбор Данные, object_type - отбор Метаданные.
	КлассМетаданных = 1;
	Если ЕстьАргумент(Аргументы, "id") Или ЕстьАргумент(Аргументы, "ref") Тогда
		Код = "";
		Ссылка = ОбъектАргументов(Аргументы, ОбъектыХода, Контекст, Код);
		Если Ссылка = Неопределено Тогда
			Возврат ОтказОбъекта(Результат, Код);
		КонецЕсли;
		ПараметрыЧтения.Данные = Ссылка;
		Фильтры.Вставить("object", СтрокаАргумента(Аргументы, ?(ЕстьАргумент(Аргументы, "id"), "id", "ref")));
	КонецЕсли;
	Если ЕстьАргумент(Аргументы, "object_type") Тогда
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(СокрЛП(СтрокаАргумента(Аргументы, "object_type")));
		Если ОбъектМетаданных = Неопределено Тогда
			Возврат Отказ(Результат, "NOT_FOUND", НСтр("ru = 'Объект метаданных не найден: укажи полное имя, например «Документ.ЗаказКлиента».'"));
		КонецЕсли;
		Причина = "";
		Если ИИА_Периметр.ОбъектЗапрещен(ОбъектМетаданных.ПолноеИмя(), Причина) Тогда
			Возврат Отказ(Результат, "PERIMETER_VIOLATION",
				СтрШаблон(НСтр("ru = 'Объект %1 вне периметра ассистента (%2).'"), ОбъектМетаданных.ПолноеИмя(), Причина));
		КонецЕсли;
		ПараметрыЧтения.Метаданные = ОбъектМетаданных.ПолноеИмя();
		Фильтры.Вставить("object_type", ПараметрыЧтения.Метаданные);
		КлассМетаданных = ИИА_КлассыДанных.КлассОбъекта(ПараметрыЧтения.Метаданные);
	КонецЕсли;

	Если ЕстьАргумент(Аргументы, "user") Тогда
		ПараметрыЧтения.Пользователь = ИмяПользователяИБ(СокрЛП(СтрокаАргумента(Аргументы, "user")));
		Если ПустаяСтрока(ПараметрыЧтения.Пользователь) Тогда
			Возврат Отказ(Результат, "BAD_ARGUMENTS",
				НСтр("ru = 'Пользователь не найден: передай псевдоним Пользователь_… из результатов или ""me"".'"));
		КонецЕсли;
		Фильтры.Вставить("user", СтрокаАргумента(Аргументы, "user"));
	КонецЕсли;

	ПараметрыМетода = Новый Массив;
	ПараметрыМетода.Добавить(ПараметрыЧтения);
	Выполнение = ИИА_ИзолированноеВыполнение.ВыполнитьМетод("ИИА_Диагностика.ВыгрузитьЖурналВФоне", ПараметрыМетода,
		ТаймаутСекунд(), НСтр("ru = 'ИИ-ассистент: чтение журнала регистрации'"), Ложь);
	Если Выполнение.КодОшибки = "TIMEOUT" Тогда
		Возврат Отказ(Результат, "EVENT_LOG_TIMEOUT", СтрШаблон(
			НСтр("ru = 'Журнал регистрации не прочитан за %1 с. Сузьте период, укажите объект, пользователя или вид события.'"),
			ТаймаутСекунд()));
	ИначеЕсли Не Выполнение.Успех Или ТипЗнч(Выполнение.Результат) <> Тип("Структура") Тогда
		Возврат Отказ(Результат, "TOOL_ERROR", НСтр("ru = 'Журнал регистрации прочитать не удалось. Подробности - в журнале регистрации.'"));
	КонецЕсли;
	Чтение = Выполнение.Результат;

	Таблица = ТаблицаЖурналаДляМодели(Чтение.Таблица);
	Граница = ИИА_ГраницаЗапроса.РезультатИзТаблицы(Таблица, ПараметрыЧтения.Лимит);

	Класс = Макс(1, КлассМетаданных);
	Для Каждого ПолноеИмя Из Чтение.ИменаМетаданных Цикл
		Класс = Макс(Класс, ИИА_КлассыДанных.КлассОбъекта(ПолноеИмя));
	КонецЦикла;

	Заметки = Новый Массив;
	Заметки.Добавить(НСтр("ru = 'Записи от новых к старым. Пользователь_… - псевдонимы; называй пользователя так, как он показан пользователю. «[нет доступа]» - объект недоступен пользователю по правам.'"));
	Для Каждого Окно Из Чтение.НеполныеОкна Цикл
		Заметки.Добавить(СтрШаблон(НСтр("ru = 'Окно с %1 по %2 и после дробления к концу периода содержит не меньше %3 записей: прочитаны не все его записи (какие - определяет платформа), более старые окна читались дальше - сузьте период или отборы.'"),
			ДатаДляМодели(Окно.Начало), ДатаДляМодели(Окно.Конец), Окно.Прочитано));
	КонецЦикла;
	Если Чтение.ПокрытоС <> Неопределено Тогда
		Заметки.Добавить(СтрШаблон(НСтр("ru = 'Прочитан период только с %1: исчерпан бюджет чтения за вызов - сузьте период или отборы.'"),
			ДатаДляМодели(Чтение.ПокрытоС)));
	КонецЕсли;
	Усечено = Чтение.НеполныеОкна.Количество() > 0 Или Чтение.ПокрытоС <> Неопределено;

	Данные = Новый Структура;
	Данные.Вставить("period", Новый Структура("from, to", ДатаДляМодели(ПараметрыЧтения.ДатаНачала),
		ДатаДляМодели(ПараметрыЧтения.ДатаОкончания)));
	Данные.Вставить("filters", Фильтры);
	Данные.Вставить("columns", Граница.Колонки);
	Данные.Вставить("rows", Граница.Строки);
	Данные.Вставить("returned", Граница.Строки.Количество());
	Данные.Вставить("read", Чтение.Прочитано);
	Данные.Вставить("truncated", Усечено);
	Данные.Вставить("hidden_rows", Чтение.Скрыто);
	Если Чтение.ПокрытоС <> Неопределено Тогда
		Данные.Вставить("covered_from", ДатаДляМодели(Чтение.ПокрытоС));
	КонецЕсли;
	Данные.Вставить("note", СтрСоединить(Заметки, " "));

	Результат.Успех = Истина;
	Результат.Итог = ?(Граница.Строки.Количество() = 0, "EMPTY", "OK");
	Результат.Строк = Граница.Строки.Количество();
	Результат.Скрыто = Чтение.Скрыто + Граница.Скрыто;
	Результат.Класс = Класс;
	Результат.Данные = Данные;
	Результат.Таблица = Новый Структура("Колонки, Строки, Объекты, ОбъектыЯчеек", Граница.Колонки, Граница.Строки,
		Граница.Объекты, Граница.ОбъектыЯчеек);
	Возврат Результат;

КонецФункции

Функция РазобратьПериод(Период, ПараметрыЧтения, Ошибка)

	Начало = "";
	Конец = "";
	Если ТипЗнч(Период) = Тип("Соответствие") Тогда
		Начало = ?(ТипЗнч(Период.Получить("from")) = Тип("Строка"), СокрЛП(Период.Получить("from")), "");
		Конец = ?(ТипЗнч(Период.Получить("to")) = Тип("Строка"), СокрЛП(Период.Получить("to")), "");
	ИначеЕсли Период <> Неопределено Тогда
		Ошибка = НСтр("ru = 'period должен быть объектом {""from"": ..., ""to"": ...}.'");
		Возврат Ложь;
	КонецЕсли;
	ДатаОкончания = ?(ПустаяСтрока(Конец), ТекущаяДатаСеанса(), ДатаАргумента(Конец, Истина));
	ДатаНачала = ?(ПустаяСтрока(Начало), НачалоДня(ДатаОкончания) - (ДнейПоУмолчанию() - 1) * 86400,
		ДатаАргумента(Начало, Ложь));
	Если ДатаНачала = Неопределено Или ДатаОкончания = Неопределено Тогда
		Ошибка = НСтр("ru = 'Даты периода: ГГГГ-ММ-ДД или ГГГГ-ММ-ДДTчч:мм:сс.'");
		Возврат Ложь;
	ИначеЕсли ДатаНачала > ДатаОкончания Тогда
		Ошибка = НСтр("ru = 'Начало периода позже конца.'");
		Возврат Ложь;
	ИначеЕсли ДатаОкончания - ДатаНачала > МаксимумДнейПериода() * 86400 Тогда
		Ошибка = СтрШаблон(НСтр("ru = 'Период длиннее %1 дней: сузьте его.'"), МаксимумДнейПериода());
		Возврат Ложь;
	КонецЕсли;
	ПараметрыЧтения.ДатаНачала = ДатаНачала;
	ПараметрыЧтения.ДатаОкончания = ДатаОкончания;
	Возврат Истина;

КонецФункции

// Отборы по событиям и уровням: словари events и levels; error - отбор Уровень = Ошибка (по И с остальными).
Функция РазобратьСобытия(Аргументы, ПараметрыЧтения, Фильтры, Ошибка)

	События = СловарьСобытий();
	Уровни = СловарьУровней();
	ТолькоОшибки = Ложь;
	ЛюбыеСобытия = Ложь;
	ВидыСобытий = Новый Массив;
	Для Каждого Вид Из СписокСтрок(Аргументы.Получить("events")) Цикл
		Если События.Получить(Вид) = Неопределено Тогда
			Ошибка = СтрШаблон(НСтр("ru = 'Неизвестный вид события %1. Допустимо: post, unpost, write, new, delete, error, any.'"), Вид);
			Возврат Ложь;
		ИначеЕсли Вид = "error" Тогда
			ТолькоОшибки = Истина;
		ИначеЕсли Вид = "any" Тогда
			ЛюбыеСобытия = Истина;
		Иначе
			ПараметрыЧтения.События.Добавить(События.Получить(Вид));
		КонецЕсли;
		ВидыСобытий.Добавить(Вид);
	КонецЦикла;
	Если ЛюбыеСобытия Тогда
		ПараметрыЧтения.События.Очистить();
	КонецЕсли;
	Для Каждого Уровень Из СписокСтрок(Аргументы.Получить("levels")) Цикл
		Если Уровни.Получить(Уровень) = Неопределено Тогда
			Ошибка = СтрШаблон(НСтр("ru = 'Неизвестный уровень %1. Допустимо: error, warning, information, note.'"), Уровень);
			Возврат Ложь;
		КонецЕсли;
		ПараметрыЧтения.Уровни.Добавить(Уровни.Получить(Уровень));
	КонецЦикла;
	Если ТолькоОшибки Тогда
		ПараметрыЧтения.Уровни.Очистить();
		ПараметрыЧтения.Уровни.Добавить(Уровни.Получить("error"));
	КонецЕсли;
	Если ВидыСобытий.Количество() > 0 Тогда
		Фильтры.Вставить("events", ВидыСобытий);
	КонецЕсли;
	Возврат Истина;

КонецФункции

// Имя пользователя ИБ для отбора журнала: "me" - текущий, иначе псевдоним Пользователь_… из результатов.
// Поиск пользователя ИБ по идентификатору требует права «Администрирование»: только он идёт в привилегированном
// режиме, сам журнал читается без него.
Функция ИмяПользователяИБ(Текст)

	Если НРег(Текст) = "me" Тогда
		Возврат ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
	КонецЕсли;
	Пользователь = ИИА_Маскирование.ЗначениеИзПсевдонима(Текст, Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
	Если Пользователь = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Пользователь, "ИдентификаторПользователяИБ"));
	УстановитьПривилегированныйРежим(Ложь);
	Возврат ?(ПользовательИБ = Неопределено, "", ПользовательИБ.Имя);

КонецФункции

// Окна назад от конца периода (см. НовоеСостояниеОкон, ПринятьОкно): записи окон складываются, пока не набран лимит
// строк или не пройден период. Переполненное окно дробится пополам к концу, поэтому читаются самые новые записи.
Функция ПрочитатьОкнаЖурнала(ПараметрыЧтения)

	Отбор = Новый Структура;
	Если ПараметрыЧтения.Данные <> Неопределено Тогда
		Отбор.Вставить("Данные", ПараметрыЧтения.Данные);
	КонецЕсли;
	Если Не ПустаяСтрока(ПараметрыЧтения.Метаданные) Тогда
		Отбор.Вставить("Метаданные", Метаданные.НайтиПоПолномуИмени(ПараметрыЧтения.Метаданные));
	КонецЕсли;
	Если Не ПустаяСтрока(ПараметрыЧтения.Пользователь) Тогда
		Отбор.Вставить("Пользователь", ПараметрыЧтения.Пользователь);
	КонецЕсли;
	Если ПараметрыЧтения.События.Количество() > 0 Тогда
		Отбор.Вставить("Событие", ПараметрыЧтения.События);
	КонецЕсли;
	Если ПараметрыЧтения.Уровни.Количество() > 0 Тогда
		УровниОтбора = Новый Массив;
		Для Каждого Имя Из ПараметрыЧтения.Уровни Цикл
			УровниОтбора.Добавить(УровеньПоИмени(Имя));
		КонецЦикла;
		Отбор.Вставить("Уровень", УровниОтбора);
	КонецЕсли;

	Чтение = Новый Структура("Таблица, Прочитано, Скрыто, НеполныеОкна, ПокрытоС, ИменаМетаданных",
		НоваяТаблицаЖурнала(), 0, 0, Новый Массив, Неопределено, Новый Массив);
	Запреты = Новый Соответствие; // полное имя или тип -> Булево
	ПраваЧтения = Новый Соответствие; // полное имя -> Булево
	Окна = НовоеСостояниеОкон(ПараметрыЧтения.ДатаНачала, ПараметрыЧтения.ДатаОкончания);
	Пока Не Окна.Завершено Цикл
		Отбор.Вставить("ДатаНачала", Окна.Начало);
		Отбор.Вставить("ДатаОкончания", Окна.Конец);
		Записи = Новый ТаблицаЗначений;
		ВыгрузитьЖурналРегистрации(Записи, Отбор,
			"Дата,Уровень,ПредставлениеСобытия,Пользователь,Метаданные,Данные,ПредставлениеДанных,Комментарий,СтатусТранзакции",
			, ЗаписейВОкне(Окна));
		Если Не ПринятьОкно(Окна, Записи.Количество()) Тогда
			// Окно раздроблено: выгрузка отбрасывается, более короткое окно читается заново.
			Продолжить;
		КонецЕсли;
		Для Каждого Запись Из Записи Цикл
			Если ЗаписьЗапрещена(Запись, Запреты) Тогда
				Чтение.Скрыто = Чтение.Скрыто + 1;
				Продолжить;
			КонецЕсли;
			ДобавитьЗаписьЖурнала(Чтение.Таблица, Запись, ПраваЧтения);
		КонецЦикла;
		Если Чтение.Таблица.Количество() >= ПараметрыЧтения.Лимит Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Чтение.Прочитано = Окна.Прочитано;
	Чтение.НеполныеОкна = Окна.НеполныеОкна;
	Чтение.ПокрытоС = Окна.ПокрытоС;

	Чтение.Таблица.Сортировать("Дата Убыв");
	Пока Чтение.Таблица.Количество() > ПараметрыЧтения.Лимит Цикл
		Чтение.Таблица.Удалить(Чтение.Таблица.Количество() - 1);
	КонецЦикла;
	Для Каждого Строка Из Чтение.Таблица Цикл
		Для Каждого Имя Из Строка.ИменаМетаданных Цикл
			Если Чтение.ИменаМетаданных.Найти(Имя) = Неопределено Тогда
				Чтение.ИменаМетаданных.Добавить(Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Чтение.Таблица.Колонки.Удалить("ИменаМетаданных");
	Возврат Чтение;

КонецФункции

// Состояние чтения журнала окнами назад от конца периода: первое окно - 1 день, каждое следующее в 4 раза длиннее
// предыдущего, не дальше начала периода. Всего не больше МаксимумОкон() принятых окон и МаксимумПрочитанных()
// записей. Переполненное окно (записей не меньше лимита выгрузки) дробится пополам к концу, не больше
// МаксимумДроблений() раз за вызов. Экспорт - для тестов выбора окон.
//
// Параметры:
//  ДатаНачала - Дата - начало периода.
//  ДатаОкончания - Дата - конец периода.
//
// Возвращаемое значение:
//  Структура - ДатаНачала, Начало и Конец текущего окна, Длина (секунд), Дроблений, Окон, Прочитано,
//    НеполныеОкна (Массив из Структура: Начало, Конец, Прочитано), ПокрытоС (Дата; Неопределено - период пройден),
//    Завершено.
//
Функция НовоеСостояниеОкон(ДатаНачала, ДатаОкончания) Экспорт

	Окна = Новый Структура("ДатаНачала, Начало, Конец, Длина, Дроблений, Окон, Прочитано, НеполныеОкна, ПокрытоС, Завершено",
		ДатаНачала, ДатаНачала, ДатаОкончания, 86400, 0, 0, 0, Новый Массив, Неопределено, ДатаОкончания < ДатаНачала);
	УстановитьНачалоОкна(Окна);
	Возврат Окна;

КонецФункции

// Сколько записей выгружать в текущем окне.
//
// Параметры:
//  Окна - Структура - см. НовоеСостояниеОкон.
//
// Возвращаемое значение:
//  Число
//
Функция ЗаписейВОкне(Окна) Экспорт

	Возврат Мин(МаксимумВОкне(), МаксимумПрочитанных() - Окна.Прочитано);

КонецФункции

// Учитывает выгрузку текущего окна и переходит к следующему.
//
// Параметры:
//  Окна - Структура - см. НовоеСостояниеОкон.
//  Количество - Число - сколько записей выгружено в текущем окне.
//
// Возвращаемое значение:
//  Булево - Истина: записи окна принимаются; Ложь: окно переполнено и раздроблено - выгрузку отбросить и повторить
//    по новому, более короткому окну.
//
Функция ПринятьОкно(Окна, Количество) Экспорт

	ВОкне = ЗаписейВОкне(Окна);
	Переполнено = Количество >= ВОкне;
	Если Переполнено И Окна.Дроблений < МаксимумДроблений() И Окна.Конец - Окна.Начало >= 1 Тогда
		Окна.Дроблений = Окна.Дроблений + 1;
		Окна.Длина = Цел((Окна.Конец - Окна.Начало + 1) / 2);
		УстановитьНачалоОкна(Окна);
		Возврат Ложь;
	КонецЕсли;
	Окна.Окон = Окна.Окон + 1;
	Окна.Прочитано = Окна.Прочитано + Количество;
	Если Переполнено Тогда
		Окна.НеполныеОкна.Добавить(Новый Структура("Начало, Конец, Прочитано", Окна.Начало, Окна.Конец, ВОкне));
	КонецЕсли;
	Окна.Конец = Окна.Начало - 1;
	Окна.Длина = Окна.Длина * 4;
	УстановитьНачалоОкна(Окна);
	Если Окна.Конец < Окна.ДатаНачала Тогда
		Окна.Завершено = Истина;
	ИначеЕсли Окна.Окон >= МаксимумОкон() Или Окна.Прочитано >= МаксимумПрочитанных() Тогда
		Окна.ПокрытоС = Окна.Конец + 1;
		Окна.Завершено = Истина;
	КонецЕсли;
	Возврат Истина;

КонецФункции

Процедура УстановитьНачалоОкна(Окна)

	Окна.Начало = Макс(Окна.ДатаНачала, Окна.Конец - Окна.Длина + 1);

КонецПроцедуры

Функция НоваяТаблицаЖурнала()

	Таблица = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("Дата,Уровень,Событие,Пользователь,Данные,ПредставлениеДанных,Комментарий,Транзакция,НетДоступа,ИменаМетаданных", ",") Цикл
		Таблица.Колонки.Добавить(Имя);
	КонецЦикла;
	Возврат Таблица;

КонецФункции

Процедура ДобавитьЗаписьЖурнала(Таблица, Запись, ПраваЧтения)

	Строка = Таблица.Добавить();
	Строка.Дата = Запись.Дата;
	Строка.Уровень = Строка(Запись.Уровень);
	Строка.Событие = Лев(Строка(Запись.ПредставлениеСобытия), 100);
	Строка.Пользователь = Запись.Пользователь;
	Строка.Данные = ?(ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Запись.Данные)), Запись.Данные, Неопределено);
	Строка.ПредставлениеДанных = Лев(Строка(Запись.ПредставлениеДанных), МаксимумПредставления());
	Строка.Комментарий = Лев(Строка(Запись.Комментарий), МаксимумКомментария());
	Строка.Транзакция = Строка(Запись.СтатусТранзакции);
	Строка.ИменаМетаданных = ИменаМетаданныхЗаписи(Запись.Метаданные);
	Строка.НетДоступа = Ложь;
	Если Строка.Данные <> Неопределено Тогда
		Строка.ИменаМетаданных.Добавить(Строка.Данные.Метаданные().ПолноеИмя());
	Иначе
		// Данные без ссылки (набор записей, константа): представление показывается, только если пользователь может
		// читать объекты метаданных события.
		Для Каждого ПолноеИмя Из Строка.ИменаМетаданных Цикл
			Если Не ЧтениеРазрешено(ПолноеИмя, ПраваЧтения) Тогда
				Строка.НетДоступа = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Право «Чтение» на объект метаданных события; у объектов без такого права - Истина (читать нечего).
Функция ЧтениеРазрешено(ПолноеИмя, ПраваЧтения)

	Разрешено = ПраваЧтения.Получить(ПолноеИмя);
	Если Разрешено = Неопределено Тогда
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
		Попытка
			Разрешено = ОбъектМетаданных = Неопределено Или ПравоДоступа("Чтение", ОбъектМетаданных);
		// У этого вида объектов метаданных нет права «Чтение».
		Исключение // BSLLS:MissingCodeTryCatchEx-off
			Разрешено = Истина;
		КонецПопытки;
		ПраваЧтения.Вставить(ПолноеИмя, Разрешено);
	КонецЕсли;
	Возврат Разрешено;

КонецФункции

// Запись по объекту вне периметра или профиля (по метаданным события или по типу данных) исключается целиком.
Функция ЗаписьЗапрещена(Запись, Запреты)

	Для Каждого ПолноеИмя Из ИменаМетаданныхЗаписи(Запись.Метаданные) Цикл
		Запрещен = Запреты.Получить(ПолноеИмя);
		Если Запрещен = Неопределено Тогда
			Запрещен = ИИА_Периметр.ОбъектЗапрещен(ПолноеИмя);
			Запреты.Вставить(ПолноеИмя, Запрещен);
		КонецЕсли;
		Если Запрещен Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Если Не ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Запись.Данные)) Тогда
		Возврат Ложь;
	КонецЕсли;
	ТипДанных = ТипЗнч(Запись.Данные);
	Запрещен = Запреты.Получить(ТипДанных);
	Если Запрещен = Неопределено Тогда
		Запрещен = ИИА_Периметр.ТипЗапрещен(ТипДанных)
			Или ИИА_Периметр.ОбъектЗапрещен(Метаданные.НайтиПоТипу(ТипДанных).ПолноеИмя());
		Запреты.Вставить(ТипДанных, Запрещен);
	КонецЕсли;
	Возврат Запрещен;

КонецФункции

Функция ИменаМетаданныхЗаписи(ЗначениеМетаданных)

	Имена = Новый Массив;
	Значения = ?(ТипЗнч(ЗначениеМетаданных) = Тип("Массив"), ЗначениеМетаданных,
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ЗначениеМетаданных));
	Для Каждого Значение Из Значения Цикл
		Если ТипЗнч(Значение) = Тип("Строка") И Не ПустаяСтрока(Значение) Тогда
			Имена.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Имена;

КонецФункции

// Таблица для границы данных: пользователь ИБ -> элемент справочника Пользователи (одним запросом), данные,
// недоступные пользователю по правам, - «[нет доступа]» (один запрос РАЗРЕШЕННЫЕ на тип; для данных без ссылки -
// право «Чтение» на объект метаданных события, колонка НетДоступа). Экспорт - для тестов.
//
// Параметры:
//  Записи - ТаблицаЗначений - Дата, Уровень, Событие, Пользователь (УникальныйИдентификатор), Данные (ЛюбаяСсылка,
//    Неопределено), ПредставлениеДанных, Комментарий, Транзакция, НетДоступа (Булево).
//
// Возвращаемое значение:
//  ТаблицаЗначений - Дата, Уровень, Событие, Пользователь, Объект, Представление, Комментарий, Транзакция.
//
Функция ТаблицаЖурналаДляМодели(Записи) Экспорт

	ПользователиСправочника = ПользователиПоИдентификаторам(Записи.ВыгрузитьКолонку("Пользователь"));
	Доступные = ДоступныеДанные(Записи.ВыгрузитьКолонку("Данные"));
	Таблица = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("Дата,Уровень,Событие,Пользователь,Объект,Представление,Комментарий,Транзакция", ",") Цикл
		Таблица.Колонки.Добавить(Имя);
	КонецЦикла;
	ПустойИдентификатор = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	Для Каждого Запись Из Записи Цикл
		Строка = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Запись, "Дата, Уровень, Событие, Комментарий, Транзакция");
		Если ТипЗнч(Запись.Пользователь) <> Тип("УникальныйИдентификатор") Или Запись.Пользователь = ПустойИдентификатор Тогда
			Строка.Пользователь = НСтр("ru = '[не указан]'");
		Иначе
			Пользователь = ПользователиСправочника.Получить(Запись.Пользователь);
			Строка.Пользователь = ?(Пользователь = Неопределено, НСтр("ru = '[пользователь ИБ без карточки]'"), Пользователь);
		КонецЕсли;
		Если Запись.Данные = Неопределено Тогда
			Строка.Представление = ?(Запись.НетДоступа = Истина, НСтр("ru = '[нет доступа]'"), Запись.ПредставлениеДанных);
		ИначеЕсли Доступные.Получить(Запись.Данные) = Истина Тогда
			Строка.Объект = Запись.Данные;
			Строка.Представление = Запись.ПредставлениеДанных;
		Иначе
			Строка.Представление = НСтр("ru = '[нет доступа]'");
		КонецЕсли;
	КонецЦикла;
	Возврат Таблица;

КонецФункции

// Элементы справочника Пользователи по идентификаторам пользователей ИБ. Привилегированный режим: пользователю
// может быть закрыт справочник, а модели уходят только ссылки (псевдонимы), без реквизитов.
Функция ПользователиПоИдентификаторам(Идентификаторы)

	Результат = Новый Соответствие;
	Уникальные = Новый Массив;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Если ТипЗнч(Идентификатор) = Тип("УникальныйИдентификатор") И Уникальные.Найти(Идентификатор) = Неопределено Тогда
			Уникальные.Добавить(Идентификатор);
		КонецЕсли;
	КонецЦикла;
	Если Уникальные.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Пользователи.Ссылка КАК Ссылка,
	|	Пользователи.ИдентификаторПользователяИБ КАК ИдентификаторПользователяИБ
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.ИдентификаторПользователяИБ В (&Идентификаторы)");
	Запрос.УстановитьПараметр("Идентификаторы", Уникальные);
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.ИдентификаторПользователяИБ, Выборка.Ссылка);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Какие ссылки пользователь может прочитать: право Чтение на тип и запись, пропущенная RLS. Один пакет запросов,
// по запросу на тип.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - ссылка -> Истина для доступных.
//
Функция ДоступныеДанные(Значения)

	Результат = Новый Соответствие;
	ПоТипам = Новый Соответствие; // полное имя -> Массив из ЛюбаяСсылка
	Для Каждого Значение Из Значения Цикл
		Если Не ЗначениеЗаполнено(Значение) Или Не ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Значение)) Тогда
			Продолжить;
		КонецЕсли;
		ОбъектМетаданных = Значение.Метаданные();
		Если Не ПравоДоступа("Чтение", ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		Ссылки = ПоТипам.Получить(ОбъектМетаданных.ПолноеИмя());
		Если Ссылки = Неопределено Тогда
			Ссылки = Новый Массив;
			ПоТипам.Вставить(ОбъектМетаданных.ПолноеИмя(), Ссылки);
		КонецЕсли;
		Если Ссылки.Найти(Значение) = Неопределено Тогда
			Ссылки.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Если ПоТипам.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ТекстыЗапросов = Новый Массив;
	Запрос = Новый Запрос;
	Номер = 0;
	Для Каждого КлючИЗначение Из ПоТипам Цикл
		Номер = Номер + 1;
		ИмяПараметра = "Ссылки" + Формат(Номер, "ЧГ=");
		// Источник - полное имя проверенного объекта метаданных; анализатор видит шаблон до подстановки.
		// BSLLS:QueryParseError-off
		ТекстыЗапросов.Добавить(СтрШаблон("ВЫБРАТЬ РАЗРЕШЕННЫЕ Т.Ссылка КАК Ссылка ИЗ %1 КАК Т ГДЕ Т.Ссылка В (&%2)",
			КлючИЗначение.Ключ, ИмяПараметра));
		// BSLLS:QueryParseError-on
		Запрос.УстановитьПараметр(ИмяПараметра, КлючИЗначение.Значение);
	КонецЦикла;
	Запрос.Текст = СтрСоединить(ТекстыЗапросов, ";" + Символы.ПС);
	Для Каждого РезультатЗапроса Из Запрос.ВыполнитьПакет() Цикл
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(Выборка.Ссылка, Истина);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СловарьСобытий()

	Словарь = Новый Соответствие;
	Словарь.Вставить("post", "_$Data$_.Post");
	Словарь.Вставить("unpost", "_$Data$_.Unpost");
	Словарь.Вставить("write", "_$Data$_.Update");
	Словарь.Вставить("new", "_$Data$_.New");
	Словарь.Вставить("delete", "_$Data$_.Delete");
	Словарь.Вставить("error", "");
	Словарь.Вставить("any", "");
	Возврат Словарь;

КонецФункции

Функция СловарьУровней()

	Словарь = Новый Соответствие;
	Словарь.Вставить("error", "Ошибка");
	Словарь.Вставить("warning", "Предупреждение");
	Словарь.Вставить("information", "Информация");
	Словарь.Вставить("note", "Примечание");
	Возврат Словарь;

КонецФункции

Функция УровеньПоИмени(Имя)

	Если Имя = "Ошибка" Тогда
		Возврат УровеньЖурналаРегистрации.Ошибка;
	ИначеЕсли Имя = "Предупреждение" Тогда
		Возврат УровеньЖурналаРегистрации.Предупреждение;
	ИначеЕсли Имя = "Информация" Тогда
		Возврат УровеньЖурналаРегистрации.Информация;
	Иначе
		Возврат УровеньЖурналаРегистрации.Примечание;
	КонецЕсли;

КонецФункции

#КонецОбласти

#Область ПроверкаЗаполнения

Функция ПроверитьЗаполнениеОбъекта(Результат, Аргументы, ОбъектыХода, Контекст)

	Указано = ?(ЕстьАргумент(Аргументы, "id"), 1, 0) + ?(ЕстьАргумент(Аргументы, "ref"), 1, 0)
		+ ?(ЕстьАргумент(Аргументы, "object_type"), 1, 0);
	Если Указано <> 1 Тогда
		Возврат Отказ(Результат, "BAD_ARGUMENTS", НСтр("ru = 'Укажи ровно один из id, ref, object_type.'"));
	КонецЕсли;
	Ссылка = Неопределено;
	Если ЕстьАргумент(Аргументы, "object_type") Тогда
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(СокрЛП(СтрокаАргумента(Аргументы, "object_type")));
		Если ОбъектМетаданных = Неопределено Тогда
			Возврат Отказ(Результат, "NOT_FOUND", НСтр("ru = 'Объект метаданных не найден: укажи полное имя, например «Документ.ЗаказКлиента».'"));
		КонецЕсли;
		Причина = "";
		Если ИИА_Периметр.ОбъектЗапрещен(ОбъектМетаданных.ПолноеИмя(), Причина) Тогда
			Возврат Отказ(Результат, "PERIMETER_VIOLATION",
				СтрШаблон(НСтр("ru = 'Объект %1 вне периметра ассистента (%2).'"), ОбъектМетаданных.ПолноеИмя(), Причина));
		КонецЕсли;
	Иначе
		Код = "";
		Ссылка = ОбъектАргументов(Аргументы, ОбъектыХода, Контекст, Код);
		Если Ссылка = Неопределено Тогда
			Возврат ОтказОбъекта(Результат, Код);
		КонецЕсли;
		ОбъектМетаданных = Ссылка.Метаданные();
	КонецЕсли;
	ЭтоДокумент = Метаданные.Документы.Содержит(ОбъектМетаданных);
	Если Не ЭтоДокумент И Не Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
		Возврат Отказ(Результат, "BAD_ARGUMENTS", НСтр("ru = 'Проверка заполнения - только для документов и справочников.'"));
	КонецЕсли;
	ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	РежимАргумента = СтрокаАргумента(Аргументы, "mode");
	Если Не ПустаяСтрока(РежимАргумента) И РежимАргумента <> "post" И РежимАргумента <> "write" Тогда
		Возврат Отказ(Результат, "BAD_ARGUMENTS", НСтр("ru = 'mode: post или write.'"));
	КонецЕсли;
	Режим = ?(ЭтоДокумент И РежимАргумента <> "write", "post", "write");

	// Часть A: обязательные поля по метаданным.
	СкрытоПолей = 0;
	Обязательные = ОбязательныеПоля(ОбъектМетаданных, СкрытоПолей);
	Требуемые = Новый Массив;
	Для Каждого Поле Из Обязательные Цикл
		Требуемые.Добавить(Новый Структура("field, title, kind", Поле.Путь, Поле.Заголовок, Поле.Вид));
	КонецЦикла;
	Данные = Новый Структура("object, type, mode, required, hidden_fields, note",
		Неопределено, ПолноеИмя, Режим, Требуемые, СкрытоПолей,
		НСтр("ru = 'required - по метаданным: обработчик ОбработкаПроверкиЗаполнения модуля объекта может добавить или снять проверки; фактический результат - в check. Значения полей не передаются.'"));
	Результат.Успех = Истина;
	Результат.Итог = "OK";
	Результат.Класс = 1;
	Результат.Данные = Данные;
	Результат.Строк = Требуемые.Количество();
	Если Ссылка = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	// Часть B: записанный объект в правах пользователя (RLS на чтение действует).
	Если Не ОбъектЧитается(Ссылка) Тогда
		Возврат Отказ(Результат, "NOT_FOUND", НСтр("ru = 'Объект не найден или недоступен по правам пользователя.'"));
	КонецЕсли;
	Объект = Ссылка.ПолучитьОбъект();
	Данные.Вставить("unfilled", НезаполненныеПоля(Объект, Обязательные));

	ПараметрыМетода = Новый Массив;
	ПараметрыМетода.Добавить(Ссылка);
	Выполнение = ИИА_ИзолированноеВыполнение.ВыполнитьМетод("ИИА_Диагностика.ПроверитьЗаполнениеВФоне", ПараметрыМетода,
		ТаймаутСекунд(), НСтр("ru = 'ИИ-ассистент: проверка заполнения'"));
	Если Выполнение.КодОшибки = "TIMEOUT" Тогда
		Возврат Отказ(Результат, "CHECK_TIMEOUT",
			СтрШаблон(НСтр("ru = 'Проверка заполнения не завершилась за %1 с.'"), ТаймаутСекунд()));
	ИначеЕсли Не Выполнение.Успех Тогда
		Возврат Отказ(Результат, "CHECK_ERROR", НСтр("ru = 'Проверка заполнения завершилась ошибкой: '")
			+ Выполнение.ТекстОшибки);
	ИначеЕсли ТипЗнч(Выполнение.Результат) <> Тип("Булево") Тогда
		Возврат Отказ(Результат, "NOT_FOUND", НСтр("ru = 'Объект не найден.'"));
	КонецЕсли;

	Препятствия = ИИА_Действия.ПрепятствияОперации(Объект, Режим);

	// Сообщения проверки и текст запрета - свободный текст прикладного кода: через границу данных.
	// Представление объекта (псевдоним при маскировании) - отдельной строкой той же таблицы.
	Тексты = ТекстыПроверки(Выполнение.Сообщения, ОбъектМетаданных, Препятствия.ТекстЗапрета);
	СтрокаОбъекта = Тексты.Вставить(0);
	СтрокаОбъекта.Вид = "object";
	СтрокаОбъекта.Объект = Ссылка;
	Граница = ИИА_ГраницаЗапроса.РезультатИзТаблицы(Тексты, МаксимумСообщений() + 2);
	Сообщения = Новый Массив;
	ТекстЗапрета = Неопределено;
	ИндексОбъекта = Граница.Колонки.Найти("Объект");
	Для Каждого Строка Из Граница.Строки Цикл
		Если Строка[0] = "object" Тогда
			Данные.object = Строка[ИндексОбъекта];
		ИначеЕсли Строка[0] = "prohibition" Тогда
			ТекстЗапрета = Строка[3];
		Иначе
			Сообщения.Добавить(Новый Структура("field, title, text", Строка[1], Строка[2], Строка[3]));
		КонецЕсли;
	КонецЦикла;
	Данные.Вставить("check", Новый Структура("passed, messages", Выполнение.Результат, Сообщения));

	ПрепятствияДляМодели = Новый Структура;
	Если ЭтоДокумент Тогда
		ПрепятствияДляМодели.Вставить("posted", Препятствия.Проведен);
	КонецЕсли;
	ПрепятствияДляМодели.Вставить("deletion_mark", Препятствия.ПометкаУдаления);
	ПрепятствияДляМодели.Вставить("rights", Препятствия.Права);
	ПрепятствияДляМодели.Вставить("rls", Препятствия.RLS);
	ПрепятствияДляМодели.Вставить("change_prohibited", Препятствия.ИзменениеЗапрещено);
	ПрепятствияДляМодели.Вставить("prohibition_text", ТекстЗапрета);
	ПрепятствияДляМодели.Вставить("reasons", КодыПричин(Препятствия.Причины));
	ПрепятствияДляМодели.Вставить("trial_post",
		НСтр("ru = 'Пробное проведение доступно только через пробный прогон записи (typed-write), если профиль разрешает запись этого документа.'"));
	Если Препятствия.RLS = Неопределено Тогда
		ПрепятствияДляМодели.Вставить("rls_note", НСтр("ru = 'RLS не проверен: в конфигурации нет подсистемы управления доступом БСП.'"));
	КонецЕсли;
	Данные.Вставить("blockers", ПрепятствияДляМодели);
	Данные.note = Данные.note + " " + НСтр("ru = 'Проверка выполнена по версии объекта, сохранённой в базе, без признака режима записи: типовые ERP его в ОбработкаПроверкиЗаполнения не читают; проверки ПередЗаписью и ОбработкаПроведения так не видны. rights - права ролей без учёта прав на отдельные реквизиты.'");

	Результат.Итог = ?(Выполнение.Результат = Истина И Данные.unfilled.Количество() = 0, "OK", "CHECK_FAILED");
	Результат.Скрыто = Граница.Скрыто;
	Если Тексты.Количество() > 1 Тогда
		// Сообщения прикладного кода могут содержать суммы и цены.
		Результат.Класс = Макс(1, ИИА_КлассыДанных.КлассОбъекта(ПолноеИмя));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Обязательные поля по метаданным: стандартные реквизиты, реквизиты, табличные части и их реквизиты
// с ПроверкаЗаполнения = ВыдаватьОшибку. Поля вне периметра и профиля не возвращаются, а считаются.
Функция ОбязательныеПоля(ОбъектМетаданных, Скрыто)

	Поля = Новый Массив;
	ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	ВыдаватьОшибку = ПроверкаЗаполнения.ВыдаватьОшибку;
	Для Каждого Реквизит Из ОбъектМетаданных.СтандартныеРеквизиты Цикл
		Если СтрРазделить("Дата,Номер,Код,Наименование,Владелец,Родитель", ",").Найти(Реквизит.Имя) <> Неопределено
			И Реквизит.ПроверкаЗаполнения = ВыдаватьОшибку Тогда
			ДобавитьПоле(Поля, Скрыто, ПолноеИмя, "", Реквизит.Имя, Реквизит.Синоним, "standard");
		КонецЕсли;
	КонецЦикла;
	Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
		Если Реквизит.ПроверкаЗаполнения = ВыдаватьОшибку Тогда
			ДобавитьПоле(Поля, Скрыто, ПолноеИмя, "", Реквизит.Имя, Реквизит.Синоним, "attribute");
		КонецЕсли;
	КонецЦикла;
	Для Каждого ТабличнаяЧасть Из ОбъектМетаданных.ТабличныеЧасти Цикл
		Если ИИА_Периметр.ОбъектЗапрещен(ПолноеИмя + "." + ТабличнаяЧасть.Имя) Тогда
			Продолжить;
		КонецЕсли;
		Если ТабличнаяЧасть.ПроверкаЗаполнения = ВыдаватьОшибку Тогда
			ДобавитьПоле(Поля, Скрыто, ПолноеИмя, "", ТабличнаяЧасть.Имя, ТабличнаяЧасть.Синоним, "tabular_section");
		КонецЕсли;
		Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
			Если Реквизит.ПроверкаЗаполнения = ВыдаватьОшибку Тогда
				ДобавитьПоле(Поля, Скрыто, ПолноеИмя, ТабличнаяЧасть.Имя, Реквизит.Имя, Реквизит.Синоним, "tabular_attribute");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Поля;

КонецФункции

Процедура ДобавитьПоле(Поля, Скрыто, ПолноеИмя, ТЧ, Имя, Синоним, Вид)

	Путь = ?(ПустаяСтрока(ТЧ), Имя, ТЧ + "." + Имя);
	Если ИИА_Периметр.ПолеЗапрещено(ПолноеИмя, Путь) Тогда
		Скрыто = Скрыто + 1;
		Возврат;
	КонецЕсли;
	Поля.Добавить(Новый Структура("Путь, Заголовок, Вид, ТЧ, Имя", Путь, ?(ПустаяСтрока(Синоним), Имя, Синоним), Вид, ТЧ, Имя));

КонецПроцедуры

// Незаполненные обязательные поля объекта: имена и номера строк табличных частей, без значений.
Функция НезаполненныеПоля(Объект, Обязательные)

	Незаполненные = Новый Массив;
	Для Каждого Поле Из Обязательные Цикл
		Если Поле.Вид = "tabular_section" Тогда
			Если Объект[Поле.Имя].Количество() = 0 Тогда
				Незаполненные.Добавить(Новый Структура("field, title", Поле.Путь, Поле.Заголовок));
			КонецЕсли;
		ИначеЕсли Поле.Вид = "tabular_attribute" Тогда
			Строки = Новый Массив;
			Для Каждого СтрокаТЧ Из Объект[Поле.ТЧ] Цикл
				Если Не ЗначениеЗаполнено(СтрокаТЧ[Поле.Имя]) Тогда
					Строки.Добавить(СтрокаТЧ.НомерСтроки);
					Если Строки.Количество() >= МаксимумСтрокТЧ() Тогда
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Если Строки.Количество() > 0 Тогда
				Незаполненные.Добавить(Новый Структура("field, title, rows", Поле.Путь, Поле.Заголовок, Строки));
			КонецЕсли;
		ИначеЕсли Не ЗначениеЗаполнено(Объект[Поле.Имя]) Тогда
			Незаполненные.Добавить(Новый Структура("field, title", Поле.Путь, Поле.Заголовок));
		КонецЕсли;
	КонецЦикла;
	Возврат Незаполненные;

КонецФункции

// Таблица текстов для границы данных: Вид (message, prohibition, object), Поле, Заголовок, Текст, Объект.
Функция ТекстыПроверки(Сообщения, ОбъектМетаданных, ТекстЗапрета)

	Таблица = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("Вид,Поле,Заголовок,Текст", ",") Цикл
		Таблица.Колонки.Добавить(Имя, Новый ОписаниеТипов("Строка"));
	КонецЦикла;
	Таблица.Колонки.Добавить("Объект");
	ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	Для Каждого Сообщение Из Сообщения Цикл
		Если Таблица.Количество() >= МаксимумСообщений() Тогда
			Прервать;
		КонецЕсли;
		Строка = Таблица.Добавить();
		Строка.Вид = "message";
		Строка.Поле = ПутьПоляСообщения(Сообщение);
		ПутьБезИндексов = ПутьБезИндексов(Строка.Поле);
		Если Не ПустаяСтрока(ПутьБезИндексов) И ИИА_Периметр.ПолеЗапрещено(ПолноеИмя, ПутьБезИндексов) Тогда
			Строка.Поле = "";
			Строка.Текст = НСтр("ru = '[сообщение по закрытому полю скрыто]'");
			Продолжить;
		КонецЕсли;
		Строка.Заголовок = ЗаголовокПоля(ОбъектМетаданных, ПутьБезИндексов);
		Строка.Текст = Лев(Сообщение.Текст, МаксимумТекстаСообщения());
	КонецЦикла;
	Если Не ПустаяСтрока(ТекстЗапрета) Тогда
		Строка = Таблица.Добавить();
		Строка.Вид = "prohibition";
		Строка.Текст = ТекстЗапрета;
	КонецЕсли;
	Возврат Таблица;

КонецФункции

// «Объект.Товары[2].Количество» -> «Товары[2].Количество»: путь из ПутьКДанным и Поле сообщения.
Функция ПутьПоляСообщения(Сообщение)

	Путь = СокрЛП(Сообщение.ПутьКДанным);
	Если Не ПустаяСтрока(Сообщение.Поле) Тогда
		Путь = ?(ПустаяСтрока(Путь), СокрЛП(Сообщение.Поле), Путь + "." + СокрЛП(Сообщение.Поле));
	КонецЕсли;
	// Префикс «Объект.» может повторяться (ПутьКДанным «Объект» и Поле «Объект.Партнер»).
	Пока СтрНачинаетсяС(Путь, "Объект.") Цикл
		Путь = Сред(Путь, СтрДлина("Объект.") + 1);
	КонецЦикла;
	Если Путь = "Объект" Тогда
		Возврат "";
	КонецЕсли;
	Возврат Лев(Путь, 200);

КонецФункции

Функция ПутьБезИндексов(Путь)

	Результат = "";
	ВИндексе = Ложь;
	Для Позиция = 1 По СтрДлина(Путь) Цикл
		Символ = Сред(Путь, Позиция, 1);
		Если Символ = "[" Тогда
			ВИндексе = Истина;
		ИначеЕсли Символ = "]" Тогда
			ВИндексе = Ложь;
		ИначеЕсли Не ВИндексе Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Синоним реквизита, стандартного реквизита или реквизита табличной части по пути «Поле» или «ТЧ.Поле».
Функция ЗаголовокПоля(ОбъектМетаданных, Путь)

	Части = СтрРазделить(Путь, ".", Ложь);
	Если Части.Количество() = 1 Тогда
		Реквизит = ОбъектМетаданных.Реквизиты.Найти(Части[0]);
		Если Реквизит = Неопределено Тогда
			Реквизит = ОбъектМетаданных.ТабличныеЧасти.Найти(Части[0]);
		КонецЕсли;
		Если Реквизит <> Неопределено Тогда
			Возврат Реквизит.Представление();
		КонецЕсли;
		Для Каждого Стандартный Из ОбъектМетаданных.СтандартныеРеквизиты Цикл
			Если Стандартный.Имя = Части[0] Тогда
				Возврат Стандартный.Представление();
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли Части.Количество() = 2 Тогда
		ТабличнаяЧасть = ОбъектМетаданных.ТабличныеЧасти.Найти(Части[0]);
		Реквизит = ?(ТабличнаяЧасть = Неопределено, Неопределено, ТабличнаяЧасть.Реквизиты.Найти(Части[1]));
		Если Реквизит <> Неопределено Тогда
			Возврат Реквизит.Представление();
		КонецЕсли;
	КонецЕсли;
	Возврат "";

КонецФункции

Функция КодыПричин(Причины)

	Коды = Новый Массив;
	Для Каждого Причина Из Причины Цикл
		Если Причина.Код <> "CHANGE_PROHIBITED" Тогда
			// Текст запрета БСП уходит модели только как prohibition_text через границу данных.
			Коды.Добавить(Новый Структура("code, text", Причина.Код, Причина.Текст));
		Иначе
			Коды.Добавить(Новый Структура("code", Причина.Код));
		КонецЕсли;
	КонецЦикла;
	Возврат Коды;

КонецФункции

// Пропускает ли RLS на чтение запись объекта.
Функция ОбъектЧитается(Ссылка)

	// Источник - полное имя объекта метаданных проверенной ссылки; анализатор видит шаблон до подстановки.
	// BSLLS:QueryParseError-off
	Запрос = Новый Запрос(СтрШаблон("ВЫБРАТЬ РАЗРЕШЕННЫЕ Т.Ссылка КАК Ссылка ИЗ %1 КАК Т ГДЕ Т.Ссылка = &Ссылка",
		Ссылка.Метаданные().ПолноеИмя()));
	// BSLLS:QueryParseError-on
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

#КонецОбласти

#Область ВидимостьПоля

Функция ВидимостьПоля(Результат, Аргументы, ОбъектыХода, Контекст, СтруктурыФорм)

	Форма = ИИА_ИсходныйКод.КлючСтруктурыФормыИнструмента("field_visibility", Аргументы, ОбъектыХода, Контекст);
	Если Не ПустаяСтрока(Форма.Ошибка) Тогда
		Возврат Отказ(Результат, Форма.Ошибка, Форма.Текст);
	КонецЕсли;
	ОбъектМетаданных = Форма.ОбъектМетаданных;
	Если Не Метаданные.Документы.Содержит(ОбъектМетаданных) И Не Метаданные.Справочники.Содержит(ОбъектМетаданных)
		И Не Метаданные.ПланыВидовХарактеристик.Содержит(ОбъектМетаданных) Тогда
		Возврат Отказ(Результат, "BAD_ARGUMENTS", НСтр("ru = 'Видимость поля - для документов, справочников и планов видов характеристик.'"));
	КонецЕсли;
	Кандидаты = Новый Массив;
	Поле = РазрешитьПоле(ОбъектМетаданных, СтрокаАргумента(Аргументы, "field"), Кандидаты);
	Если Кандидаты.Количество() > 1 Тогда
		Отказ(Результат, "AMBIGUOUS", НСтр("ru = 'Поле неоднозначно: уточни имя (для табличной части - «ТЧ.Поле»).'"));
		ОткрытыеКандидаты = Новый Массив;
		Для Каждого Путь Из Кандидаты Цикл
			Если Не ИИА_Периметр.ПолеЗапрещено(ОбъектМетаданных.ПолноеИмя(), Путь) Тогда
				ОткрытыеКандидаты.Добавить(Путь);
			КонецЕсли;
		КонецЦикла;
		Результат.Данные.Вставить("candidates", ОткрытыеКандидаты);
		Возврат Результат;
	ИначеЕсли Поле = Неопределено Тогда
		Возврат Отказ(Результат, "NOT_FOUND", НСтр("ru = 'Такого реквизита нет: проверь имя в describe_metadata.'"));
	КонецЕсли;
	Причина = "";
	Если ИИА_Периметр.ПолеЗапрещено(ОбъектМетаданных.ПолноеИмя(), Поле.Путь, Причина) Тогда
		Возврат Отказ(Результат, "PERIMETER_VIOLATION", СтрШаблон(НСтр("ru = 'Поле вне периметра ассистента (%1).'"), Причина));
	КонецЕсли;

	ПоМетаданным = Новый Структура;
	Если Поле.Реквизит = Неопределено Тогда
		ПоМетаданным.Вставить("rights", Неопределено);
	Иначе
		ПоМетаданным.Вставить("rights", Новый Структура("view, edit", ПравоДоступа("Просмотр", Поле.Реквизит),
			ПравоДоступа("Редактирование", Поле.Реквизит)));
	КонецЕсли;
	ПоМетаданным.Вставить("functional_options", ФункциональныеОпцииПоля(Поле));

	Структура = ?(СтруктурыФорм = Неопределено, Неопределено, СтруктурыФорм.Получить(Форма.Ключ));
	Если ТипЗнч(Структура) = Тип("Массив") Тогда
		НаФорме = ПолеНаФорме(Структура, Поле);
	Иначе
		НаФорме = Новый Структура("status", "FORM_UNAVAILABLE");
		Если ТипЗнч(Структура) = Тип("Строка") И Не ПустаяСтрока(Структура) Тогда
			НаФорме.Вставить("reason", Лев(Структура, 300));
		КонецЕсли;
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.Итог = "OK";
	Результат.Класс = 1;
	Результат.Строк = 1;
	Результат.Данные = Новый Структура("object, form, field, title, with_object_data, on_form, metadata, note",
		ОбъектМетаданных.ПолноеИмя(), Форма.ФормаМетаданных.Имя, Поле.Путь, Поле.Заголовок,
		Форма.КлючОбъекта <> Неопределено И НаФорме.status <> "FORM_UNAVAILABLE", НаФорме, ПоМетаданным,
		НСтр("ru = 'visible учитывает скрытые группы-предки (hidden_by), read_only и enabled - свойства элемента и его групп после кода формы. Форма создаётся отдельным экземпляром: состояние формы, открытой у пользователя (несохранённые изменения, действия в форме), и пользовательские настройки («Изменить форму») могут отличаться. Причину в коде формы ищи rlm_execute, если доступен исходный код.'"));
	Возврат Результат;

КонецФункции

// Реквизит по имени или синониму: реквизит, стандартный реквизит или реквизит табличной части («ТЧ.Поле» или
// просто «Поле»). Совпадение по имени важнее совпадения по синониму.
//
// Возвращаемое значение:
//  Структура, Неопределено - Путь, Имя, ТЧ, Заголовок, Реквизит (ОбъектМетаданных или Неопределено для стандартного),
//    ТабличнаяЧасть; Неопределено - не найдено или неоднозначно (тогда Кандидаты - пути).
//
Функция РазрешитьПоле(ОбъектМетаданных, Знач Текст, Кандидаты)

	Текст = НРег(СокрЛП(Текст));
	Части = СтрРазделить(Текст, ".", Ложь);
	Если Части.Количество() = 0 Или Части.Количество() > 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПоИмени = Новый Массив;
	ПоСинониму = Новый Массив;
	Искомое = Части[Части.ВГраница()];
	Если Части.Количество() = 1 Тогда
		Для Каждого Реквизит Из ОбъектМетаданных.СтандартныеРеквизиты Цикл
			СопоставитьПоле(Реквизит.Имя, Реквизит.Синоним, Искомое, ПоИмени, ПоСинониму, Неопределено, Неопределено);
		КонецЦикла;
		Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
			СопоставитьПоле(Реквизит.Имя, Реквизит.Синоним, Искомое, ПоИмени, ПоСинониму, Реквизит, Неопределено);
		КонецЦикла;
	КонецЕсли;
	Для Каждого ТабличнаяЧасть Из ОбъектМетаданных.ТабличныеЧасти Цикл
		Если Части.Количество() = 2 И НРег(ТабличнаяЧасть.Имя) <> Части[0] И НРег(ТабличнаяЧасть.Синоним) <> Части[0] Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
			СопоставитьПоле(Реквизит.Имя, Реквизит.Синоним, Искомое, ПоИмени, ПоСинониму, Реквизит, ТабличнаяЧасть);
		КонецЦикла;
	КонецЦикла;
	Найденные = ?(ПоИмени.Количество() > 0, ПоИмени, ПоСинониму);
	Если Найденные.Количество() = 1 Тогда
		Возврат Найденные[0];
	КонецЕсли;
	Для Каждого Поле Из Найденные Цикл
		Кандидаты.Добавить(Поле.Путь);
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Процедура СопоставитьПоле(Имя, Синоним, Искомое, ПоИмени, ПоСинониму, Реквизит, ТабличнаяЧасть)

	ПоИмениСовпало = НРег(Имя) = Искомое;
	Если Не ПоИмениСовпало И НРег(Синоним) <> Искомое Тогда
		Возврат;
	КонецЕсли;
	ТЧ = ?(ТабличнаяЧасть = Неопределено, "", ТабличнаяЧасть.Имя);
	Поле = Новый Структура("Путь, Имя, ТЧ, Заголовок, Реквизит, ТабличнаяЧасть", ?(ПустаяСтрока(ТЧ), Имя, ТЧ + "." + Имя),
		Имя, ТЧ, ?(ПустаяСтрока(Синоним), Имя, Синоним), Реквизит, ТабличнаяЧасть);
	Если ПоИмениСовпало Тогда
		ПоИмени.Добавить(Поле);
	Иначе
		ПоСинониму.Добавить(Поле);
	КонецЕсли;

КонецПроцедуры

// Функциональные опции, в состав которых входит реквизит (или его табличная часть), и их значения. Опция
// с параметрами без значений параметров не вычисляется: value = null, parametrized = true.
Функция ФункциональныеОпцииПоля(Поле)

	Опции = Новый Массив;
	Если Поле.Реквизит = Неопределено И Поле.ТабличнаяЧасть = Неопределено Тогда
		Возврат Опции;
	КонецЕсли;
	Для Каждого Опция Из Метаданные.ФункциональныеОпции Цикл
		Если Не (Поле.Реквизит <> Неопределено И Опция.Состав.Содержит(Поле.Реквизит)
			Или Поле.ТабличнаяЧасть <> Неопределено И Опция.Состав.Содержит(Поле.ТабличнаяЧасть)) Тогда
			Продолжить;
		КонецЕсли;
		Описание = Новый Структура("name, title, value", Опция.Имя, Опция.Представление(), Неопределено);
		Попытка
			Описание.value = ПолучитьФункциональнуюОпцию(Опция.Имя);
		// Опция с параметрами требует их значений: признак parametrized вместо значения.
		Исключение // BSLLS:MissingCodeTryCatchEx-off
			Описание.Вставить("parametrized", Истина);
		КонецПопытки;
		Опции.Добавить(Описание);
		Если Опции.Количество() >= 10 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Опции;

КонецФункции

// Элементы структуры от клиента: данные пришли с клиента - строки ограничиваются, флаги приводятся к Булево.
Функция ЭлементыСтруктуры(Структура)

	Элементы = Новый Массив;
	Для Каждого Элемент Из Структура Цикл
		Если Элементы.Количество() >= 3000 Тогда // 2000 видимых и 1000 потомков скрытых групп
			Прервать;
		КонецЕсли;
		Если ТипЗнч(Элемент) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Описание = Новый Структура("Глубина, Вид, Имя, Заголовок, Таблица, Видим, Доступность, ТолькоПросмотр",
			0, "", "", "", "", Истина, Истина, Ложь);
		ЗаполнитьЗначенияСвойств(Описание, Элемент);
		Элементы.Добавить(Новый Структура("Глубина, Вид, Имя, Заголовок, Таблица, Видим, Доступность, ТолькоПросмотр",
			?(ТипЗнч(Описание.Глубина) = Тип("Число"), Мин(Макс(Цел(Описание.Глубина), 0), 50), 0),
			Лев(Строка(Описание.Вид), 50), Лев(Строка(Описание.Имя), 150), Лев(СокрЛП(Строка(Описание.Заголовок)), 200),
			Лев(Строка(Описание.Таблица), 150), Описание.Видим <> Ложь, Описание.Доступность <> Ложь,
			Описание.ТолькоПросмотр = Истина));
	КонецЦикла;
	Возврат Элементы;

КонецФункции

// Предки элемента по глубине - от ближнего к дальнему.
Функция ПредкиЭлемента(Элементы, Индекс)

	Предки = Новый Массив;
	Глубина = Элементы[Индекс].Глубина - 1;
	Позиция = Индекс - 1;
	Пока Глубина >= 0 И Позиция >= 0 Цикл
		Если Элементы[Позиция].Глубина = Глубина Тогда
			Предки.Добавить(Элементы[Позиция]);
			Глубина = Глубина - 1;
		КонецЕсли;
		Позиция = Позиция - 1;
	КонецЦикла;
	Возврат Предки;

КонецФункции

#КонецОбласти

#Область Общее

// Объект по id или ref с проверкой доступности.
Функция ОбъектАргументов(Аргументы, ОбъектыХода, Контекст, Код)

	Если ЕстьАргумент(Аргументы, "id") Тогда
		Возврат ОбъектПоИдентификатору(СтрокаАргумента(Аргументы, "id"), ОбъектыХода, Контекст, Код);
	КонецЕсли;
	Возврат ДоступныйОбъект(ИИА_Инструменты.СсылкаПоНавигационнойСсылке(СтрокаАргумента(Аргументы, "ref")), Код);

КонецФункции

// Ссылка, если объект доступен ассистенту и пользователю (ИИА_Инструменты.ПроверитьДоступностьОбъекта); иначе
// Неопределено и код отказа: NOT_FOUND, PERIMETER_VIOLATION, ACCESS_DENIED.
Функция ДоступныйОбъект(Ссылка, Код)

	Причина = "";
	Если Ссылка = Неопределено Или Не ИИА_Инструменты.ПроверитьДоступностьОбъекта(Ссылка, Причина) Тогда
		Код = ?(Ссылка = Неопределено Или Причина = "BAD_OBJECT", "NOT_FOUND", Причина);
		Возврат Неопределено;
	КонецЕсли;
	Возврат Ссылка;

КонецФункции

Функция ОтказОбъекта(Результат, Код)

	Если Код = "NO_CONTEXT" Тогда
		Текст = НСтр("ru = 'Чат открыт не из объекта: значение @context недоступно.'");
	ИначеЕсли Код = "PERIMETER_VIOLATION" Тогда
		Текст = НСтр("ru = 'Объект недоступен ассистенту: персональные, кадровые и зарплатные данные исключены.'");
	ИначеЕсли Код = "ACCESS_DENIED" Тогда
		Текст = НСтр("ru = 'У пользователя нет права чтения этого объекта.'");
	Иначе
		Текст = НСтр("ru = 'Объект не найден: возьми id из objects результата (o1, o2…) или передай ""@context"".'");
	КонецЕсли;
	Возврат Отказ(Результат, Код, Текст);

КонецФункции

Функция НомерОбъектаХода(Идентификатор)

	Цифры = Сред(Идентификатор, 2);
	Если НРег(Лев(Идентификатор, 1)) <> "o" Или ПустаяСтрока(Цифры) Или СтрДлина(Цифры) > 6 Тогда
		Возврат 0;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Цифры) Цикл
		Если СтрНайти("0123456789", Сред(Цифры, Позиция, 1)) = 0 Тогда
			Возврат 0;
		КонецЕсли;
	КонецЦикла;
	Возврат Число(Цифры);

КонецФункции

// Дата аргумента ГГГГ-ММ-ДД (КонецДня - конец этого дня) или ГГГГ-ММ-ДДTчч:мм:сс; Неопределено - неверный формат.
Функция ДатаАргумента(Текст, КонецДняДаты)

	Если СтрДлина(Текст) <> 10 И СтрДлина(Текст) <> 19 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Значение = XMLЗначение(Тип("Дата"), ?(СтрДлина(Текст) = 10, Текст + "T00:00:00", ВРег(Текст)));
	// Неверный формат или несуществующая дата (2026-02-30) - неверный аргумент модели.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат Неопределено;
	КонецПопытки;
	Возврат ?(КонецДняДаты И СтрДлина(Текст) = 10, КонецДня(Значение), Значение);

КонецФункции

Функция ДатаДляМодели(Дата)

	Возврат Формат(Дата, "ДФ=yyyy-MM-ddTHH:mm:ss");

КонецФункции

Функция ЕстьАргумент(Аргументы, Имя)

	Возврат Не ПустаяСтрока(СтрокаАргумента(Аргументы, Имя));

КонецФункции

Функция СтрокаАргумента(Аргументы, Имя)

	Значение = Аргументы.Получить(Имя);
	Возврат ?(ТипЗнч(Значение) = Тип("Строка"), Значение, "");

КонецФункции

Функция СписокСтрок(Значения)

	Результат = Новый Массив;
	Если ТипЗнч(Значения) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Значение Из Значения Цикл
		Если ТипЗнч(Значение) = Тип("Строка") И Не ПустаяСтрока(Значение) Тогда
			Результат.Добавить(НРег(СокрЛП(Значение)));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Отказ(Результат, Код, Текст)

	Результат.Успех = Ложь;
	Результат.Итог = Код;
	Результат.Данные = Новый Структура("error, message", Код, Текст);
	Возврат Результат;

КонецФункции

Функция ОписаниеИнструмента(Имя, Описание, Свойства, Обязательные = "")

	Схема = Новый Соответствие;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", СтрРазделить(Обязательные, ",", Ложь));
	Схема.Вставить("additionalProperties", Ложь);
	Функция_ = Новый Соответствие;
	Функция_.Вставить("name", Имя);
	Функция_.Вставить("description", Описание);
	Функция_.Вставить("parameters", Схема);
	Инструмент = Новый Соответствие;
	Инструмент.Вставить("type", "function");
	Инструмент.Вставить("function", Функция_);
	Возврат Инструмент;

КонецФункции

Функция СвойствоПараметра(Тип, Описание)

	Свойство = Новый Соответствие;
	Свойство.Вставить("type", Тип);
	Свойство.Вставить("description", Описание);
	Возврат Свойство;

КонецФункции

Функция СписокЗначенийПараметра(Словарь, Описание)

	Значения = Новый Массив;
	Для Каждого КлючИЗначение Из Словарь Цикл
		Значения.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	Элемент = СвойствоПараметра("string", "");
	Элемент.Удалить("description");
	Элемент.Вставить("enum", Значения);
	Свойство = СвойствоПараметра("array", Описание);
	Свойство.Вставить("items", Элемент);
	Возврат Свойство;

КонецФункции

