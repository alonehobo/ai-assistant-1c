///////////////////////////////////////////////////////////////////////////////////////////////////////
// ИИ-ассистент: знания о конфигурации и поиск данных (план, разделы 7.2 и 8).
//  - каталог метаданных: кэш имён, синонимов и разделов, перестраивается при смене версии конфигурации
//    или расширений (слой 1);
//  - глоссарий: бизнес-термины -> объекты, запись помечена версией конфигурации, на которой проверена (слой 2);
//  - find_records и read_object: поиск элементов и документов по тексту и чтение объекта по ссылке.
// Все чтения данных идут через границу запроса (ИИА_ГраницаЗапроса): периметр, профиль, RLS, скрытие ПДн.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Описания инструментов glossary, find_records, read_object.
//
// Возвращаемое значение:
//  Массив из Соответствие
//
Функция ОписанияИнструментов() Экспорт

	Инструменты = Новый Массив;

	Инструменты.Добавить(ОписаниеИнструмента("glossary",
		НСтр("ru = 'Глоссарий внедрения: что означает бизнес-термин в этой базе и какие объекты и отчёты ему соответствуют. Вызывай первым, если вопрос использует термин компании («отгрузка», «маржа», «склад брака»).'"),
		СвойстваПараметров("text", "string", НСтр("ru = 'Термин или его часть.'")), "text"));

	Свойства = СвойстваПараметров("text", "string", НСтр("ru = 'Наименование, код, номер документа или ИНН (полностью или часть).'"));
	Свойства.Вставить("object", СвойствоПараметра("string",
		НСтр("ru = 'Необязательно: полное имя справочника или документа, например «Справочник.Партнеры» или «Документ.ЗаказКлиента». Без него поиск идёт по основным справочникам.'")));
	Инструменты.Добавить(ОписаниеИнструмента("find_records",
		НСтр("ru = 'Находит элементы справочников и документы по тексту и возвращает их со ссылками (objects o1, o2, ...). Используй, чтобы превратить название из вопроса в ссылку для запроса, отчёта или open_object. Если найдено несколько - уточни у пользователя.'"),
		Свойства, "text"));

	Инструменты.Добавить(ОписаниеИнструмента("read_object",
		НСтр("ru = 'Читает реквизиты и табличные части объекта (до 30 строк каждой) по id из objects (o1, o2, ...). Поля вне периметра не возвращаются.'"),
		СвойстваПараметров("id", "string", НСтр("ru = 'Идентификатор объекта из objects.'")), "id"));

	Возврат Инструменты;

КонецФункции

// Выполняет glossary или find_records.
//
// Параметры:
//  Имя - Строка
//  Аргументы - Соответствие
//  Результат - Структура - см. ИИА_Инструменты.ВыполнитьИнструмент.
//
// Возвращаемое значение:
//  Структура
//
Функция ВыполнитьИнструмент(Имя, Аргументы, Результат) Экспорт

	Если Имя = "glossary" Тогда
		Возврат НайтиВГлоссарии(Результат, СтрокаАргумента(Аргументы, "text"));
	ИначеЕсли Имя = "find_records" Тогда
		Возврат НайтиЗаписи(Результат, СтрокаАргумента(Аргументы, "text"), СтрокаАргумента(Аргументы, "object"));
	КонецЕсли;
	Возврат Отказ(Результат, "UNKNOWN_TOOL", Имя);

КонецФункции

// Читает объект: шапка - как контекст чата, табличные части - через границу запроса.
//
// Параметры:
//  Ссылка - ЛюбаяСсылка
//  Результат - Структура - см. ИИА_Инструменты.ВыполнитьИнструмент.
//  ОбъектыХода - Массив из Структура - сюда добавляются ссылки из реквизитов и табличных частей (Текст, Ссылка, Значение).
//
// Возвращаемое значение:
//  Структура
//
Функция ПрочитатьОбъект(Ссылка, Результат, ОбъектыХода = Неопределено) Экспорт

	Описание = ИИА_Инструменты.ОписаниеКонтекста(Ссылка);
	Если Не Описание.Успех Тогда
		Возврат Отказ(Результат, "PERIMETER_VIOLATION", Описание.Ошибка);
	КонецЕсли;

	Данные = Описание.Данные;
	ТабличныеЧасти = Новый Соответствие;
	Объекты = ?(ОбъектыХода = Неопределено, Новый Массив, ОбъектыХода);
	Для Каждого Объект Из Описание.Объекты Цикл
		Объекты.Добавить(Объект);
	КонецЦикла;
	Скрыто = 0;
	Класс = Описание.Класс;
	ПолноеИмя = Данные.type;
	Для Каждого ИмяТЧ Из Данные.tabular_sections Цикл
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
		Имя = Сред(ИмяТЧ, СтрДлина(ПолноеИмя) + 2);
		Поля = Новый Массив;
		Поля.Добавить("Т.НомерСтроки КАК НомерСтроки");
		Для Каждого Реквизит Из ОбъектМетаданных.ТабличныеЧасти[Имя].Реквизиты Цикл
			Если Поля.Количество() < 15 И Не ИИА_Периметр.ПолеЗапрещено(ПолноеИмя, Имя + "." + Реквизит.Имя) Тогда
				Поля.Добавить(СтрШаблон("Т.%1 КАК %1", Реквизит.Имя));
			КонецЕсли;
		КонецЦикла;
		ТекстЗапроса = СтрШаблон("ВЫБРАТЬ %1 ИЗ %2 КАК Т ГДЕ Т.Ссылка = &Объект УПОРЯДОЧИТЬ ПО Т.НомерСтроки",
			СтрСоединить(Поля, ", "), ИмяТЧ);
		Допустимые = Новый Массив;
		Допустимые.Добавить(Ссылка);
		Выполнение = ИИА_ГраницаЗапроса.ВыполнитьЗапросАгента(ТекстЗапроса, Новый Структура("Объект", Ссылка), 30, Допустимые);
		Если Не Выполнение.Успех Тогда
			ТабличныеЧасти.Вставить(Имя, Новый Структура("error", Выполнение.Сообщение));
			Продолжить;
		КонецЕсли;
		ТабличныеЧасти.Вставить(Имя, Новый Структура("columns, rows, truncated",
			Выполнение.Колонки, Выполнение.Строки, Выполнение.Усечено));
		Скрыто = Скрыто + Выполнение.Скрыто;
		Класс = Макс(Класс, Выполнение.Класс);
		Для Каждого Объект Из Выполнение.Объекты Цикл
			Объекты.Добавить(Объект);
		КонецЦикла;
	КонецЦикла;

	Результат.Успех = Истина;
	Результат.Итог = "OK";
	Результат.Строк = 1;
	Результат.Скрыто = Скрыто;
	Результат.Вставить("Класс", Макс(Класс, ИИА_КлассыДанных.КлассОбъекта(ПолноеИмя)));
	Результат.Данные = Новый Структура("object, type, fields, tabular_sections", Данные.object, ПолноеИмя,
		Данные.fields, ТабличныеЧасти);
	Возврат Результат;

КонецФункции

// Ищет объекты конфигурации в каталоге метаданных (кэш перестраивается при смене версии).
// Терпим к написанию: регистр, Ё, дефисы, сдвоенные буквы и падежные окончания не мешают
// («сменно-суточном» найдёт «Сменосуточное задание»). Если точных совпадений нет - нечёткий поиск по похожести слов.
//
// Параметры:
//  Текст - Строка - слова через пробел; объект должен содержать все слова в имени, синониме или разделе.
//  Максимум - Число
//
// Возвращаемое значение:
//  Массив из Структура - name, synonym, sections.
//
Функция НайтиВКаталогеМетаданных(Текст, Максимум = 30) Экспорт

	ОбновитьКаталогМетаданныхПриНеобходимости();

	Слова = ОсновыСлов(Текст);
	Условия = Новый Массив;
	Запрос = Новый Запрос;
	Для Номер = 0 По Мин(Слова.ВГраница(), 4) Цикл
		Условия.Добавить(СтрШаблон("К.СтрокаПоиска ПОДОБНО &Слово%1 СПЕЦСИМВОЛ ""~""", Номер));
		Запрос.УстановитьПараметр("Слово" + Номер, "%" + ЭкранироватьПодобно(Слова[Номер]) + "%");
	КонецЦикла;
	Если Условия.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ ПЕРВЫЕ 300
	|	К.ПолноеИмя КАК ПолноеИмя,
	|	К.Синоним КАК Синоним,
	|	К.Подсистемы КАК Подсистемы
	|ИЗ
	|	РегистрСведений.ИИА_КаталогМетаданных КАК К
	|ГДЕ
	|	%1
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВЫБОР
	|		КОГДА К.Синоним ПОДОБНО &Начало СПЕЦСИМВОЛ ""~""
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА К.Вид = ""Отчет""
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ,
	|	К.Синоним", СтрСоединить(Условия, " И "));
	Запрос.УстановитьПараметр("Начало", ЭкранироватьПодобно(СокрЛП(Текст)) + "%");

	УстановитьПривилегированныйРежим(Истина);
	Строки = Запрос.Выполнить().Выгрузить();
	Если Строки.Количество() = 0 Тогда
		Строки = ПохожиеВКаталоге(Слова);
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);

	Найденные = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		Если Найденные.Количество() >= Максимум Тогда
			Прервать;
		КонецЕсли;
		Если ИИА_Периметр.ОбъектЗапрещен(Строка.ПолноеИмя) Тогда
			Продолжить;
		КонецЕсли;
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Строка.ПолноеИмя);
		Если ОбъектМетаданных = Неопределено Или Не ПравоДоступа("Просмотр", ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		Найденные.Добавить(Новый Структура("name, synonym, sections", Строка.ПолноеИмя, Строка.Синоним, Строка.Подсистемы));
	КонецЦикла;
	Возврат Найденные;

КонецФункции

// Текст для поиска: верхний регистр, Ё -> Е, знаки и дефисы -> пробел, сдвоенные буквы -> одна.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция НормализованныйТекстПоиска(Знач Текст) Экспорт

	Текст = СтрЗаменить(ВРег(Текст), "Ё", "Е");
	Результат = Новый Массив;
	Предыдущий = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Не (ВРег(Символ) <> НРег(Символ) Или СтрНайти("0123456789", Символ) > 0) Тогда
			Символ = " ";
		КонецЕсли;
		Если Символ <> Предыдущий Тогда
			Результат.Добавить(Символ);
		КонецЕсли;
		Предыдущий = Символ;
	КонецЦикла;
	Возврат СокрЛП(СтрСоединить(Результат, ""));

КонецФункции

// Перестраивает каталог метаданных, если изменилась версия конфигурации или состав расширений.
//
Процедура ОбновитьКаталогМетаданныхПриНеобходимости() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Версия = ВерсияМетаданных();
	Если Константы.ИИА_ВерсияКаталогаМетаданных.Получить() = Версия Тогда
		Возврат;
	КонецЕсли;
	ПерестроитьКаталогМетаданных(Версия);

КонецПроцедуры

// Перестраивает каталог метаданных.
//
// Параметры:
//  Версия - Строка - ключ версии; по умолчанию вычисляется.
//
Процедура ПерестроитьКаталогМетаданных(Знач Версия = "") Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Если ПустаяСтрока(Версия) Тогда
		Версия = ВерсияМетаданных();
	КонецЕсли;

	Разделы = Новый Соответствие;
	Для Каждого Подсистема Из Метаданные.Подсистемы Цикл
		ДобавитьРазделы(Подсистема, "", Разделы);
	КонецЦикла;

	Набор = РегистрыСведений.ИИА_КаталогМетаданных.СоздатьНаборЗаписей();
	Виды = Новый Структура("Справочники, Документы, РегистрыСведений, РегистрыНакопления, ПланыВидовХарактеристик, Перечисления, Отчеты, Обработки, ЖурналыДокументов",
		"Справочник", "Документ", "РегистрСведений", "РегистрНакопления", "ПланВидовХарактеристик", "Перечисление", "Отчет", "Обработка", "ЖурналДокументов");
	Для Каждого Вид Из Виды Цикл
		Для Каждого ОбъектМетаданных Из Метаданные[Вид.Ключ] Цикл
			Запись = Набор.Добавить();
			Запись.ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
			Запись.Синоним = Лев(ОбъектМетаданных.Синоним, 300);
			Запись.Вид = Вид.Значение;
			ИменаРазделов = Разделы.Получить(ОбъектМетаданных);
			Запись.Подсистемы = ?(ИменаРазделов = Неопределено, "", Лев(СтрСоединить(ИменаРазделов, "; "), 500));
			Запись.Комментарий = Лев(ОбъектМетаданных.Комментарий, 500);
			Запись.СтрокаПоиска = Лев(НормализованныйТекстПоиска(ОбъектМетаданных.Синоним + " " + ОбъектМетаданных.Имя
				+ " " + Запись.Подсистемы), 1000);
		КонецЦикла;
	КонецЦикла;
	Набор.Записать();
	Константы.ИИА_ВерсияКаталогаМетаданных.Установить(Версия);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Основы слов запроса: нормализованные слова без падежных окончаний; предлоги и союзы короче 3 букв отбрасываются.
Функция ОсновыСлов(Текст)

	Окончания = СтрРазделить("ИЯМИ,ЯМИ,АМИ,ОГО,ЕГО,ОМУ,ЕМУ,ЫМИ,ИМИ,ИЕМ,ИЯХ,ИЙ,ЫЙ,ОЙ,ЕЙ,ОМ,ЕМ,ЫМ,ИМ,АЯ,ЯЯ,ОЕ,ЕЕ,ЫЕ,ИЕ,ОВ,ЕВ,АХ,ЯХ,ИИ,ИЯ,ЬЯ,ЬЕ,Ы,И,А,Я,О,Е,У,Ю,Ь,Й", ",");
	Основы = Новый Массив;
	Для Каждого Слово Из СтрРазделить(НормализованныйТекстПоиска(Текст), " ", Ложь) Цикл
		Основа = Слово;
		Для Каждого Окончание Из Окончания Цикл
			Если СтрЗаканчиваетсяНа(Основа, Окончание) И СтрДлина(Основа) - СтрДлина(Окончание) >= 4 Тогда
				Основа = Лев(Основа, СтрДлина(Основа) - СтрДлина(Окончание));
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если СтрДлина(Основа) >= 3 И Основы.Найти(Основа) = Неопределено Тогда
			Основы.Добавить(Основа);
		КонецЕсли;
	КонецЦикла;
	Возврат Основы;

КонецФункции

// Нечёткий поиск: объекты, у которых в синониме для каждой основы запроса есть похожее слово
// (совпадение пар букв не ниже 0,6). Для опечаток вроде «сменосуточное» / «сменносуточное».
Функция ПохожиеВКаталоге(Основы)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	К.ПолноеИмя КАК ПолноеИмя,
	|	К.Синоним КАК Синоним,
	|	К.Подсистемы КАК Подсистемы
	|ИЗ
	|	РегистрСведений.ИИА_КаталогМетаданных КАК К");
	Таблица = Запрос.Выполнить().Выгрузить();
	Таблица.Колонки.Добавить("Похожесть", Новый ОписаниеТипов("Число"));
	ПарыОснов = Новый Массив;
	Для Каждого Основа Из Основы Цикл
		ПарыОснов.Добавить(ПарыБукв(Основа));
	КонецЦикла;
	Для Каждого Строка Из Таблица Цикл
		ПарыСлов = Новый Массив;
		Для Каждого Слово Из СтрРазделить(НормализованныйТекстПоиска(Строка.Синоним), " ", Ложь) Цикл
			ПарыСлов.Добавить(ПарыБукв(Слово));
		КонецЦикла;
		Сумма = 0;
		Для Каждого Пары Из ПарыОснов Цикл
			Лучшая = 0;
			Для Каждого ПарыСлова Из ПарыСлов Цикл
				Лучшая = Макс(Лучшая, ПохожестьПар(Пары, ПарыСлова));
			КонецЦикла;
			Если Лучшая < 0.6 Тогда
				Сумма = 0;
				Прервать;
			КонецЕсли;
			Сумма = Сумма + Лучшая;
		КонецЦикла;
		Строка.Похожесть = Сумма;
	КонецЦикла;
	Таблица.Сортировать("Похожесть Убыв");
	Результат = Таблица.СкопироватьКолонки();
	Для Каждого Строка Из Таблица Цикл
		Если Строка.Похожесть = 0 Или Результат.Количество() >= 50 Тогда
			Прервать;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Результат.Добавить(), Строка);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПарыБукв(Слово)

	Пары = Новый Соответствие;
	Для Позиция = 1 По СтрДлина(Слово) - 1 Цикл
		Пары.Вставить(Сред(Слово, Позиция, 2), Истина);
	КонецЦикла;
	Возврат Пары;

КонецФункции

// Коэффициент Дайса по парам букв: 1 - одинаковые, 0 - ничего общего. Основа сравнивается с началом слова,
// поэтому окончание слова синонима не снижает похожесть.
Функция ПохожестьПар(ПарыОсновы, ПарыСлова)

	Если ПарыОсновы.Количество() = 0 Или ПарыСлова.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Общих = 0;
	Для Каждого Пара Из ПарыОсновы Цикл
		Если ПарыСлова.Получить(Пара.Ключ) <> Неопределено Тогда
			Общих = Общих + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат 2 * Общих / (ПарыОсновы.Количество() + Мин(ПарыСлова.Количество(), ПарыОсновы.Количество() + 1));

КонецФункции

// Ключ версии метаданных: конфигурация и активные расширения с их хешами.
// Состав сворачивается в SHA-256, а не обрезается: при обрезке хеши последних расширений терялись,
// и сеансы с разным набором активных расширений получали один ключ кэша периметра и каталога.
//
// Возвращаемое значение:
//  Строка - не длиннее 100 символов.
//
Функция ВерсияМетаданных() Экспорт

	Части = Новый Массив;
	Части.Добавить(Метаданные.Имя + " " + Метаданные.Версия);
	Для Каждого Расширение Из РасширенияКонфигурации.Получить(, ИсточникРасширенийКонфигурации.СеансАктивные) Цикл
		Части.Добавить(Расширение.Имя + " " + Расширение.Версия + " " + Base64Строка(Расширение.ХешСумма));
	КонецЦикла;
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(СтрСоединить(Части, "; "));
	// Префикс - формат строки поиска: при его изменении каталог перестраивается.
	Возврат "каталог 3; " + Base64Строка(Хеширование.ХешСумма);

КонецФункции

Процедура ДобавитьРазделы(Подсистема, Путь, Разделы)

	ПутьПодсистемы = ?(ПустаяСтрока(Путь), "", Путь + " / ") + Подсистема.Синоним;
	Для Каждого ОбъектМетаданных Из Подсистема.Состав Цикл
		Имена = Разделы.Получить(ОбъектМетаданных);
		Если Имена = Неопределено Тогда
			Имена = Новый Массив;
			Разделы.Вставить(ОбъектМетаданных, Имена);
		КонецЕсли;
		Если Имена.Количество() < 4 И Имена.Найти(ПутьПодсистемы) = Неопределено Тогда
			Имена.Добавить(ПутьПодсистемы);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Подчиненная Из Подсистема.Подсистемы Цикл
		ДобавитьРазделы(Подчиненная, ПутьПодсистемы, Разделы);
	КонецЦикла;

КонецПроцедуры

Функция НайтиВГлоссарии(Результат, Текст)

	Текст = СокрЛП(Текст);
	Если СтрДлина(Текст) < 2 Тогда
		Возврат Отказ(Результат, "BAD_ARGUMENTS", НСтр("ru = 'Укажите термин.'"));
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 10
	|	Г.Ссылка КАК Ссылка,
	|	Г.Наименование КАК Термин,
	|	Г.Синонимы КАК Синонимы,
	|	Г.Описание КАК Описание,
	|	Г.ВерсияКонфигурации КАК ВерсияКонфигурации
	|ИЗ
	|	Справочник.ИИА_Глоссарий КАК Г
	|ГДЕ
	|	НЕ Г.ПометкаУдаления
	|	И (Г.Наименование ПОДОБНО &Текст СПЕЦСИМВОЛ ""~""
	|			ИЛИ Г.Синонимы ПОДОБНО &Текст СПЕЦСИМВОЛ ""~"")
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	О.Ссылка КАК Ссылка,
	|	О.ПолноеИмя КАК ПолноеИмя,
	|	О.Пояснение КАК Пояснение
	|ИЗ
	|	Справочник.ИИА_Глоссарий.Объекты КАК О
	|ГДЕ
	|	НЕ О.Ссылка.ПометкаУдаления
	|	И (О.Ссылка.Наименование ПОДОБНО &Текст СПЕЦСИМВОЛ ""~""
	|			ИЛИ О.Ссылка.Синонимы ПОДОБНО &Текст СПЕЦСИМВОЛ ""~"")
	|
	|УПОРЯДОЧИТЬ ПО
	|	О.НомерСтроки";
	Запрос.УстановитьПараметр("Текст", "%" + ЭкранироватьПодобно(Текст) + "%");
	УстановитьПривилегированныйРежим(Истина);
	Пакет = Запрос.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);

	ОбъектыТерминов = Новый Соответствие;
	Выборка = Пакет[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		// Объекты вне периметра или профиля пользователю не называем.
		Если ИИА_Периметр.ОбъектЗапрещен(Выборка.ПолноеИмя) Тогда
			Продолжить;
		КонецЕсли;
		Список = ОбъектыТерминов.Получить(Выборка.Ссылка);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			ОбъектыТерминов.Вставить(Выборка.Ссылка, Список);
		КонецЕсли;
		Список.Добавить(Новый Структура("name, note", Выборка.ПолноеИмя, Выборка.Пояснение));
	КонецЦикла;

	Термины = Новый Массив;
	Выборка = Пакет[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Объекты = ОбъектыТерминов.Получить(Выборка.Ссылка);
		Термин = Новый Структура("term, synonyms, description, objects", Выборка.Термин, Выборка.Синонимы,
			ИИА_Периметр.ОчиститьТекст(Выборка.Описание), ?(Объекты = Неопределено, Новый Массив, Объекты));
		Если ЗначениеЗаполнено(Выборка.ВерсияКонфигурации) И Выборка.ВерсияКонфигурации <> Метаданные.Версия Тогда
			Термин.Вставить("warning", СтрШаблон(НСтр("ru = 'Не проверено на текущем релизе (проверено на %1).'"),
				Выборка.ВерсияКонфигурации));
		КонецЕсли;
		Термины.Добавить(Термин);
	КонецЦикла;

	Результат.Успех = Истина;
	Результат.Итог = "OK";
	Результат.Строк = Термины.Количество();
	Результат.Данные = Новый Структура("terms", Термины);
	Результат.Класс = 0;
	Если Термины.Количество() = 0 Тогда
		Результат.Данные.Вставить("note", НСтр("ru = 'Термин не найден в глоссарии. Используй search_metadata.'"));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция НайтиЗаписи(Результат, Текст, ИмяОбъекта)

	// Модель знает ИНН физлица и ФИО только псевдонимами: ищем по исходному значению,
	// найденные ссылки всё равно проходят маскирование результата.
	Текст = СокрЛП(ИИА_Маскирование.РаскрытьАргументы(Текст));
	Если СтрДлина(Текст) < 2 Тогда
		Возврат Отказ(Результат, "BAD_ARGUMENTS", НСтр("ru = 'Укажите не менее 2 символов.'"));
	КонецЕсли;

	Имена = Новый Массив;
	Если ПустаяСтрока(ИмяОбъекта) Тогда
		Для Каждого Имя Из СтрРазделить("Справочник.Партнеры,Справочник.Контрагенты,Справочник.Номенклатура,Справочник.Организации,Справочник.Склады", ",") Цикл
			Имена.Добавить(Имя);
		КонецЦикла;
	Иначе
		Имена.Добавить(СокрЛП(ИмяОбъекта));
	КонецЕсли;

	Части = Новый Массив;
	Причины = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Имя);
		Если ОбъектМетаданных = Неопределено Тогда
			Причины.Добавить(СтрШаблон(НСтр("ru = '%1 не найден'"), Имя));
			Продолжить;
		КонецЕсли;
		Имя = ОбъектМетаданных.ПолноеИмя();
		ЭтоДокумент = Метаданные.Документы.Содержит(ОбъектМетаданных);
		Если Не ЭтоДокумент И Не Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
			Причины.Добавить(СтрШаблон(НСтр("ru = '%1 - не справочник и не документ'"), Имя));
			Продолжить;
		КонецЕсли;
		Если ИИА_Периметр.ОбъектЗапрещен(Имя) Или Не ПравоДоступа("Чтение", ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		Условия = Новый Массив;
		Если ЭтоДокумент Тогда
			Условия.Добавить("Т.Номер ПОДОБНО &Подобно СПЕЦСИМВОЛ ""~""");
			Представление = "Т.Ссылка";
		Иначе
			Если ОбъектМетаданных.ДлинаНаименования > 0 Тогда
				Условия.Добавить("Т.Наименование ПОДОБНО &Подобно СПЕЦСИМВОЛ ""~""");
			КонецЕсли;
			Если ОбъектМетаданных.ДлинаКода > 0 Тогда
				Условия.Добавить("Т.Код = &Точно");
			КонецЕсли;
			Представление = "Т.Ссылка";
		КонецЕсли;
		Реквизит = ОбъектМетаданных.Реквизиты.Найти("ИНН");
		Если Реквизит <> Неопределено И Не ИИА_Периметр.ПолеЗапрещено(Имя, "ИНН") Тогда
			Условия.Добавить("Т.ИНН = &Точно");
		КонецЕсли;
		Если Условия.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Части.Добавить(СтрШаблон("ВЫБРАТЬ ПЕРВЫЕ 10 %1 КАК Объект, ""%2"" КАК Вид ИЗ %3 КАК Т ГДЕ НЕ Т.ПометкаУдаления И (%4)",
			Представление, ОбъектМетаданных.Имя, Имя, СтрСоединить(Условия, " ИЛИ ")));
	КонецЦикла;

	Если Части.Количество() = 0 Тогда
		Возврат Отказ(Результат, "PERIMETER_VIOLATION",
			НСтр("ru = 'Поиск по указанному объекту недоступен ассистенту.'") + " " + СтрСоединить(Причины, "; "));
	КонецЕсли;

	ТекстЗапроса = СтрСоединить(Части, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС);
	// Граница запроса отклоняет неиспользуемые параметры, а &Точно есть не у всех объектов.
	ПараметрыЗапроса = Новый Структура("Подобно", "%" + ЭкранироватьПодобно(Текст) + "%");
	Если СтрНайти(ТекстЗапроса, "&Точно") > 0 Тогда
		ПараметрыЗапроса.Вставить("Точно", Текст);
	КонецЕсли;
	// Серверный поиск по наименованию и ИНН: реквизиты коммерческого маскирования участвуют только в условиях,
	// модель получает найденные ссылки псевдонимами.
	Выполнение = ИИА_ГраницаЗапроса.ВыполнитьЗапросАгента(ТекстЗапроса, ПараметрыЗапроса, 30, , Истина);
	Если Не Выполнение.Успех Тогда
		Возврат Отказ(Результат, Выполнение.КодОшибки, Выполнение.Сообщение);
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.Итог = "OK";
	Результат.Строк = Выполнение.Строки.Количество();
	Результат.Скрыто = Выполнение.Скрыто;
	Результат.Класс = Выполнение.Класс;
	Результат.Таблица = Новый Структура("Колонки, Строки, Объекты, ОбъектыЯчеек",
		Выполнение.Колонки, Выполнение.Строки, Выполнение.Объекты, Выполнение.ОбъектыЯчеек);
	Результат.Данные = Новый Структура("columns, rows, truncated", Выполнение.Колонки, Выполнение.Строки, Выполнение.Усечено);
	Если Выполнение.Строки.Количество() = 0 Тогда
		Результат.Данные.Вставить("note", НСтр("ru = 'Ничего не найдено. Попробуй часть слова или другой объект.'"));
	КонецЕсли;
	Возврат Результат;

КонецФункции

#Область Общее

Функция Отказ(Результат, Код, Текст)

	Результат.Успех = Ложь;
	Результат.Итог = Код;
	Результат.Данные = Новый Структура("error, message", Код, Текст);
	Возврат Результат;

КонецФункции

Функция СтрокаАргумента(Аргументы, Имя)

	Значение = Аргументы.Получить(Имя);
	Возврат ?(ТипЗнч(Значение) = Тип("Строка"), Значение, "");

КонецФункции

Функция ЭкранироватьПодобно(Текст)

	Результат = СтрЗаменить(Текст, "~", "~~");
	Для Каждого Символ Из СтрРазделить("%,_,[,]", ",") Цикл
		Результат = СтрЗаменить(Результат, Символ, "~" + Символ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ОписаниеИнструмента(Имя, Описание, Свойства, Обязательные)

	Схема = Новый Соответствие;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", СтрРазделить(Обязательные, ",", Ложь));

	Функция_ = Новый Соответствие;
	Функция_.Вставить("name", Имя);
	Функция_.Вставить("description", Описание);
	Функция_.Вставить("parameters", Схема);

	Инструмент = Новый Соответствие;
	Инструмент.Вставить("type", "function");
	Инструмент.Вставить("function", Функция_);
	Возврат Инструмент;

КонецФункции

Функция СвойстваПараметров(Имя, Тип, Описание)

	Свойства = Новый Соответствие;
	Свойства.Вставить(Имя, СвойствоПараметра(Тип, Описание));
	Возврат Свойства;

КонецФункции

Функция СвойствоПараметра(Тип, Описание)

	Свойство = Новый Соответствие;
	Свойство.Вставить("type", Тип);
	Свойство.Вставить("description", Описание);
	Возврат Свойство;

КонецФункции

