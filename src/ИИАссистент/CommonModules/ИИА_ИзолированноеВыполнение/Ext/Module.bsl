// BSLLS:CommonModuleInvalidType-off
// Только сервер: вызов с клиента и внешнее соединение намеренно отключены.
// BSLLS:CommonModuleInvalidType-on
///////////////////////////////////////////////////////////////////////////////////////////////////////
// ИИ-ассистент: выполнение серверного метода в отдельном фоновом задании с тайм-аутом.
// Вложенное задание нужно только ради тайм-аута и изоляции сообщений метода: результат возвращается через
// временное хранилище, сообщения - ФоновоеЗадание.ПолучитьСообщенияПользователю. В файловой базе фоновые задания
// не выполняются параллельно (ход агента сам идёт в фоне), а в транзакции задание не видит её данных: там метод
// выполняется в текущем сеансе без тайм-аута. Сообщения сеанса не переотправляются: ход чата пишет шаги и статус
// в регистр состояния хода (ИИА_ФоновыйХод), HTTP-ход ждёт завершения задания и берёт только результат из хранилища,
// поэтому очистка очереди сообщений сеанса шагов не теряет.
// Используют: ИИА_ГраницаЗапроса (запросы агента), ИИА_Диагностика (журнал регистрации, проверка заполнения),
// typed-write (пробный прогон записи).
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Выполняет экспортную процедуру общего модуля ассистента с тайм-аутом.
//
// Параметры:
//  ИмяМетода - Строка - «ИИА_<Модуль>.<Процедура>»: серверная экспортная процедура общего модуля ассистента, последний
//    параметр которой - адрес временного хранилища для результата (метод кладёт туда свой результат). Метод не должен
//    сам вызывать ПолучитьСообщенияПользователю(Истина): в сеансе это забрало бы сообщения вызывающего. Модули
//    «ОМ_ИИА_<Модуль>» допускаются, только если они из тестового расширения ИИА_Тесты (проверка тайм-аута).
//  ПараметрыМетода - Массив - параметры процедуры без адреса результата: сериализуемые значения (для фонового задания).
//  ТаймаутСекунд - Число - сколько ждать задание; по истечении задание отменяется.
//  Наименование - Строка - наименование фонового задания.
//  ЗабратьСообщения - Булево - Истина: вернуть сообщения, выданные методом (в задании - сообщения задания, в сеансе -
//    сообщения сеанса, появившиеся за время вызова; очередь сообщений сеанса при этом очищается). Ложь - сообщения
//    не читаются: так очередь сеанса не меняется (запросы агента).
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * КодОшибки - Строка - TIMEOUT, EXECUTION_ERROR; пусто при успехе.
//   * ТекстОшибки - Строка - краткое очищенное представление ошибки метода (подробное - в журнале регистрации).
//   * Результат - Произвольный - значение, которое метод положил по адресу результата.
//   * Сообщения - ФиксированныйМассив из СообщениеПользователю, Массив - сообщения метода.
//
// В активной транзакции исключение метода не перехватывается и передаётся вызывающему: транзакцию завершает
// её владелец. В привилегированном режиме метод не выполняется (EXECUTION_ERROR): ассистент читает данные только
// с правами пользователя.
//
Функция ВыполнитьМетод(ИмяМетода, ПараметрыМетода, ТаймаутСекунд, Наименование, ЗабратьСообщения = Истина) Экспорт

	Ответ = Новый Структура("Успех, КодОшибки, ТекстОшибки, Результат, Сообщения", Ложь, "", "", Неопределено,
		Новый Массив);
	ПроверитьИмяМетода(ИмяМетода);
	Если ПривилегированныйРежим() Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
			СтрШаблон(НСтр("ru = 'Метод %1 вызван в привилегированном режиме и не выполнен.'"), ИмяМетода));
		Ответ.КодОшибки = "EXECUTION_ERROR";
		Возврат Ответ;
	КонецЕсли;

	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
	ПараметрыВызова = Новый Массив;
	Для Каждого Значение Из ПараметрыМетода Цикл
		ПараметрыВызова.Добавить(Значение);
	КонецЦикла;
	ПараметрыВызова.Добавить(АдресРезультата);

	Попытка
		Если ТранзакцияАктивна() Или ОбщегоНазначения.ИнформационнаяБазаФайловая() Тогда
			ВыполнитьВСеансе(ИмяМетода, ПараметрыВызова, ЗабратьСообщения, Ответ);
		Иначе
			ВыполнитьВЗадании(ИмяМетода, ПараметрыВызова, ТаймаутСекунд, Наименование, ЗабратьСообщения, Ответ);
		КонецЕсли;
	Исключение
		// Только освобождение хранилища (не данные базы): исключение передаётся дальше без изменений, в том числе
		// владельцу внешней транзакции.
		УдалитьИзВременногоХранилища(АдресРезультата);
		ВызватьИсключение;
	КонецПопытки;
	Если Ответ.Успех Тогда
		Ответ.Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	КонецЕсли;
	УдалитьИзВременногоХранилища(АдресРезультата);
	Возврат Ответ;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВыполнитьВЗадании(ИмяМетода, ПараметрыВызова, ТаймаутСекунд, Наименование, ЗабратьСообщения, Ответ)

	Задание = ФоновыеЗадания.Выполнить(ИмяМетода, ПараметрыВызова, , Наименование);
	ИдентификаторЗадания = Задание.УникальныйИдентификатор;
	Попытка
		Задание.ОжидатьЗавершенияВыполнения(ТаймаутСекунд);
	Исключение
		// Аварийное завершение разбирается ниже по состоянию задания.
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Информация, , ,
			ИИА_Периметр.ОчиститьТекст(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);

	Если Задание <> Неопределено И Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Задание.Отменить();
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
			СтрШаблон(НСтр("ru = '%1: выполнение прервано по тайм-ауту %2 с.'"), Наименование, ТаймаутСекунд));
		Ответ.КодОшибки = "TIMEOUT";
	ИначеЕсли Задание <> Неопределено И Задание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
		Ответ.Успех = Истина;
	Иначе
		Ответ.КодОшибки = "EXECUTION_ERROR";
		Если Задание <> Неопределено И Задание.ИнформацияОбОшибке <> Неопределено Тогда
			ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
				ИИА_Периметр.ОчиститьТекст(ОбработкаОшибок.ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке)));
			Ответ.ТекстОшибки = Лев(ИИА_Периметр.ОчиститьТекст(
				ОбработкаОшибок.КраткоеПредставлениеОшибки(Задание.ИнформацияОбОшибке)), 300);
		КонецЕсли;
	КонецЕсли;
	Если ЗабратьСообщения И Задание <> Неопределено Тогда
		Ответ.Сообщения = Задание.ПолучитьСообщенияПользователю(Истина);
	КонецЕсли;

КонецПроцедуры

// Метод в текущем сеансе. Имя метода проверено ПроверитьИмяМетода, параметры передаются массивом, не текстом.
// ЗабратьСообщения = Истина очищает очередь сообщений сеанса целиком (возвращаются только появившиеся за вызов): это
// безопасно, потому что шаги хода чата идут через регистр, а HTTP-ход сообщения задания не использует.
Процедура ВыполнитьВСеансе(ИмяМетода, ПараметрыВызова, ЗабратьСообщения, Ответ)

	СообщенийДо = ?(ЗабратьСообщения, ПолучитьСообщенияПользователю(Ложь).Количество(), 0);
	Аргументы = Новый Массив;
	Для Индекс = 0 По ПараметрыВызова.ВГраница() Цикл
		Аргументы.Добавить(СтрШаблон("ПараметрыВызова[%1]", Формат(Индекс, "ЧН=0; ЧГ=")));
	КонецЦикла;
	ТекстВызова = ИмяМетода + "(" + СтрСоединить(Аргументы, ", ") + ")";

	Если ТранзакцияАктивна() Тогда
		// Исключение внутри чужой транзакции не перехватывается: его обрабатывает владелец транзакции.
		Выполнить(ТекстВызова); // BSLLS:ExecuteExternalCode-off
		Ответ.Успех = Истина;
	Иначе
		Попытка
			Выполнить(ТекстВызова); // BSLLS:ExecuteExternalCode-off
			Ответ.Успех = Истина;
		Исключение
			ОписаниеОшибки = ИнформацияОбОшибке();
			ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
				ИИА_Периметр.ОчиститьТекст(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ОписаниеОшибки)));
			Ответ.КодОшибки = "EXECUTION_ERROR";
			Ответ.ТекстОшибки = Лев(ИИА_Периметр.ОчиститьТекст(
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ОписаниеОшибки)), 300);
		КонецПопытки;
	КонецЕсли;

	Если ЗабратьСообщения Тогда
		Все = ПолучитьСообщенияПользователю(Истина);
		Сообщения = Новый Массив;
		Для Индекс = СообщенийДо По Все.ВГраница() Цикл
			Сообщения.Добавить(Все[Индекс]);
		КонецЦикла;
		Ответ.Сообщения = Сообщения;
	КонецЕсли;

КонецПроцедуры

// Имя метода выполняется как код в сеансе: допускается только «ИИА_<Модуль>.<Процедура>» существующего
// общего модуля ассистента. Нарушение - ошибка программиста, а не данных: вызывается исключение.
Процедура ПроверитьИмяМетода(ИмяМетода)

	Части = СтрРазделить(ИмяМетода, ".", Истина);
	Допустимо = Части.Количество() = 2 И ЭтоИдентификатор(Части[0]) И ЭтоИдентификатор(Части[1])
		И ДопустимыйМодуль(Части[0]);
	Если Не Допустимо Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Недопустимое имя метода для изолированного выполнения: %1'"), ИмяМетода);
	КонецЕсли;

КонецПроцедуры

// Общий модуль ассистента или модуль тестов ассистента из тестового расширения ИИА_Тесты.
Функция ДопустимыйМодуль(ИмяМодуля)

	Модуль = Метаданные.ОбщиеМодули.Найти(ИмяМодуля);
	Если Модуль = Неопределено Тогда
		Возврат Ложь;
	ИначеЕсли СтрНачинаетсяС(ИмяМодуля, "ИИА_") Тогда
		Возврат Истина;
	ИначеЕсли Не СтрНачинаетсяС(ИмяМодуля, "ОМ_ИИА_") Тогда
		Возврат Ложь;
	КонецЕсли;
	Расширение = Модуль.РасширениеКонфигурации();
	Возврат Расширение <> Неопределено И Расширение.Имя = "ИИА_Тесты";

КонецФункции

Функция ЭтоИдентификатор(Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ <> "_" И СтрНайти("0123456789", Символ) = 0 И ВРег(Символ) = НРег(Символ) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ИмяСобытияЖурнала()

	Возврат НСтр("ru = 'ИИАссистент.ИзолированноеВыполнение'", ОбщегоНазначения.КодОсновногоЯзыка());

КонецФункции

#КонецОбласти
