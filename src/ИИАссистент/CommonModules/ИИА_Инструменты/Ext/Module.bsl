// BSLLS:CommonModuleInvalidType-off
// Только сервер: вызов с клиента и внешнее соединение намеренно отключены.
// BSLLS:CommonModuleInvalidType-on
///////////////////////////////////////////////////////////////////////////////////////////////////////
// ИИ-ассистент: реестр и исполнение инструментов агента (план, раздел 8).
// Все инструменты выполняются в сеансе пользователя (его роли и RLS) и внутри периметра этапа 1.
// Имена инструментов - латиница (требование API моделей), описания - по-русски.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Описания инструментов в формате OpenAI tools.
//
// Параметры:
//  Канал - Строка - "chat": ход из окна чата, структуру формы для form_layout строит клиент (пауза хода), поэтому
//    form_layout и show_form доступны и без исходного кода; "http" - внешний API.
//
// Возвращаемое значение:
//  Массив из Соответствие
//
Функция ОписанияИнструментов(Канал = "http") Экспорт

	ФормыНаКлиенте = Канал = "chat";

	Инструменты = Новый Массив;

	Инструменты.Добавить(ОписаниеИнструмента("search_metadata",
		НСтр("ru = 'Ищет объекты конфигурации (справочники, документы, регистры, отчёты) по имени или синониму. Возвращает полные имена для запросов.'"),
		СвойстваПараметров("text", "string", НСтр("ru = 'Часть имени или синонима, например «остатки товаров».'")),
		"text"));

	Инструменты.Добавить(ОписаниеИнструмента("describe_metadata",
		НСтр("ru = 'Описывает объект конфигурации: реквизиты, табличные части, измерения, ресурсы с типами. Поля вне периметра не показываются.'"),
		СвойстваПараметров("name", "string", НСтр("ru = 'Полное имя, например «РегистрНакопления.ТоварыНаСкладах».'")),
		"name"));

	СвойстваЗапроса = СвойстваПараметров("query", "string",
		НСтр("ru = 'Текст запроса на языке запросов 1С (русский синтаксис). Обращайся к полям через псевдонимы таблиц.'"));
	Параметры = Новый Соответствие;
	Параметры.Вставить("type", "object");
	Параметры.Вставить("description", НСтр("ru = 'Параметры запроса: имя -> строка, число, булево или дата строкой ГГГГ-ММ-ДД. Значение ""@context"" - ссылка на объект, из которого открыт чат (если он есть).'"));
	СвойстваЗапроса.Вставить("parameters", Параметры);
	Инструменты.Добавить(ОписаниеИнструмента("run_query",
		НСтр("ru = 'Выполняет запрос только на чтение с правами пользователя. Возвращает до 200 строк. Персональные, кадровые и зарплатные данные недоступны.'"),
		СвойстваЗапроса, "query"));

	СвойстваРегистра = СвойстваПараметров("register", "string",
		НСтр("ru = 'Полное имя регистра из describe_metadata.'"));
	СвойстваРегистра.Вставить("operation", СвойствоПараметра("string",
		НСтр("ru = 'balances - остатки, turnovers - обороты, slice_last - срез последних. Возможности из describe_metadata.'")));
	СвойстваРегистра.Получить("operation").Вставить("enum", СтрРазделить("balances,turnovers,slice_last", ","));
	СвойстваРегистра.Вставить("resources", СписокПолейПараметра(
		НСтр("ru = 'Базовые имена ресурсов из describe_metadata, до 20. Суффиксы виртуальных полей добавляются автоматически.'")));
	СвойстваРегистра.Вставить("group_by", СписокПолейПараметра(
		НСтр("ru = 'Измерения для группировки, до 10; для slice_last это колонки без суммирования ресурсов.'")));
	СвойстваРегистра.Вставить("as_of", СвойствоПараметра("string",
		НСтр("ru = 'Обязательно для balances/slice_last: ГГГГ-ММ-ДД, весь день включительно. Несовместимо с period.'")));
	ПериодРегистра = Новый Соответствие;
	ПериодРегистра.Вставить("type", "object");
	ПериодРегистра.Вставить("properties", СвойстваПараметров("from", "string", НСтр("ru = 'ГГГГ-ММ-ДД, начало дня.'")));
	ПериодРегистра.Получить("properties").Вставить("to",
		СвойствоПараметра("string", НСтр("ru = 'ГГГГ-ММ-ДД, конец дня включительно.'")));
	ПериодРегистра.Вставить("required", СтрРазделить("from,to", ","));
	ПериодРегистра.Вставить("additionalProperties", Ложь);
	СвойстваРегистра.Вставить("period", ПериодРегистра);
	ОтборыРегистра = Новый Соответствие;
	ОтборыРегистра.Вставить("type", "object");
	ОтборыРегистра.Вставить("description",
		НСтр("ru = 'Равенства по измерениям: имя -> строка, число, булево, дата или текущий @context/псевдоним. Объекты и массивы запрещены.'"));
	СвойстваРегистра.Вставить("filters", ОтборыРегистра);
	Инструменты.Добавить(ОписаниеИнструмента("read_register",
		НСтр("ru = 'Читает регистр через виртуальную таблицу, с правами, лимитом 200 строк и маскированием. Сначала describe_metadata. Момент/период обязателен, измерение Год его не заменяет. Бухгалтерия - специальные инструменты.'"),
		СвойстваРегистра, "register,operation,resources"));

	Инструменты.Добавить(ОписаниеИнструмента("open_object",
		НСтр("ru = 'Открывает пользователю форму объекта (документа, элемента справочника) по идентификатору из списка objects результата run_query (o1, o2, ...). Используй, когда пользователь просит открыть или показать конкретный объект.'"),
		СвойстваПараметров("id", "string", НСтр("ru = 'Идентификатор объекта из objects, например o3.'")),
		"id"));

	СвойстваГрафика = СвойстваПараметров("table_id", "string", НСтр("ru = 'Идентификатор таблицы из результата run_query (t1, t2, ...).'"));
	СвойстваГрафика.Вставить("type", СвойствоПараметра("string", НСтр("ru = 'bar - столбцы, hbar - горизонтальные полосы (длинные подписи), line - динамика, pie - доли.'")));
	СвойстваГрафика.Вставить("label_column", СвойствоПараметра("string", НСтр("ru = 'Колонка с подписями (категория или период).'")));
	ЗначенияГрафика = Новый Соответствие;
	ЗначенияГрафика.Вставить("type", "array");
	ЗначенияГрафика.Вставить("items", СвойствоПараметра("string", ""));
	ЗначенияГрафика.Вставить("description", НСтр("ru = 'Числовые колонки (до трёх) - ряды графика.'"));
	СвойстваГрафика.Вставить("value_columns", ЗначенияГрафика);
	СвойстваГрафика.Вставить("title", СвойствоПараметра("string", НСтр("ru = 'Заголовок графика.'")));
	Инструменты.Добавить(ОписаниеИнструмента("make_chart",
		НСтр("ru = 'Показывает пользователю график по данным таблицы из run_query. Числа берутся из результата запроса. Используй, когда сравнение, структура или динамика нагляднее на графике.'"),
		СвойстваГрафика, "table_id"));

	Инструменты.Добавить(ОписаниеИнструмента("find_report",
		НСтр("ru = 'Ищет варианты отчётов по названию или назначению; пустой текст - весь список. Сначала идут проверенные отчёты (curated). Возвращает variant_id.'"),
		СвойстваПараметров("text", "string", НСтр("ru = 'Часть названия отчёта или варианта.'")),
		"text"));

	Инструменты.Добавить(ОписаниеИнструмента("describe_report",
		НСтр("ru = 'Описывает вариант отчёта: параметры (период, дата и т.п.) и поля, по которым можно задать отборы в run_report.'"),
		СвойстваПараметров("variant_id", "string", НСтр("ru = 'Идентификатор варианта из find_report.'")),
		"variant_id"));

	СвойстваОтчета = СвойстваПараметров("variant_id", "string", НСтр("ru = 'Идентификатор варианта из find_report.'"));
	СвойстваОтчета.Вставить("period_start", СвойствоПараметра("string", НСтр("ru = 'Начало периода ГГГГ-ММ-ДД (необязательно).'")));
	СвойстваОтчета.Вставить("period_end", СвойствоПараметра("string", НСтр("ru = 'Конец периода ГГГГ-ММ-ДД (необязательно).'")));
	Отборы = Новый Соответствие;
	Отборы.Вставить("type", "object");
	Отборы.Вставить("description", НСтр("ru = 'Необязательно: отборы и параметры из describe_report, имя поля -> значение текстом (наименование, номер, дата ГГГГ-ММ-ДД, число). Например {""Склад"": ""Основной склад""}.'"));
	СвойстваОтчета.Вставить("filters", Отборы);
	Инструменты.Добавить(ОписаниеИнструмента("run_report",
		НСтр("ru = 'Формирует вариант отчёта штатным механизмом. Отчёт открывается пользователю в его форме; тебе возвращается компактная таблица (table_id для slice_result и make_chart).'"),
		СвойстваОтчета, "variant_id"));

	СвойстваНастройки = СвойстваПараметров("variant_id", "string",
		НСтр("ru = 'Вариант из find_report, variant_id варианта, ранее сохранённого configure_report в этом диалоге, или варианта, на который сослался пользователь. Сохранённый в диалоге и личный вариант пользователя по его ссылке обновляются (по ссылке - под прежним наименованием); общий вариант не меняется - настройка сохраняется новым личным вариантом.'"));
	СвойстваНастройки.Вставить("title", СвойствоПараметра("string", НСтр("ru = 'Наименование личного варианта, коротко по смыслу настройки, например «Продажи по менеджерам».'")));
	СвойстваНастройки.Вставить("period_start", СвойствоПараметра("string", НСтр("ru = 'Начало периода ГГГГ-ММ-ДД (необязательно).'")));
	СвойстваНастройки.Вставить("period_end", СвойствоПараметра("string", НСтр("ru = 'Конец периода ГГГГ-ММ-ДД (необязательно).'")));
	ОтборыНастройки = Новый Соответствие;
	ОтборыНастройки.Вставить("type", "object");
	ОтборыНастройки.Вставить("description", НСтр("ru = 'Необязательно: поле из describe_report -> значение текстом или {""op"": ""=|<>|in|not in|>|<|contains|filled|empty"", ""value"": ...}; для in и not in value - массив.'"));
	СвойстваНастройки.Вставить("filters", ОтборыНастройки);
	ПараметрыНастройки = Новый Соответствие;
	ПараметрыНастройки.Вставить("type", "object");
	ПараметрыНастройки.Вставить("description", НСтр("ru = 'Необязательно: параметр отчёта из describe_report -> значение текстом.'"));
	СвойстваНастройки.Вставить("parameters", ПараметрыНастройки);
	СвойстваНастройки.Вставить("group_by", СписокПолейПараметра(НСтр("ru = 'Необязательно: группировки строк по порядку вложенности, до 5 полей.'")));
	СвойстваНастройки.Вставить("fields", СписокПолейПараметра(НСтр("ru = 'Необязательно: выбранные поля (колонки) по порядку, до 20 полей.'")));
	ЭлементСортировки = Новый Соответствие;
	ЭлементСортировки.Вставить("type", "object");
	СвойстваСортировки = СвойстваПараметров("field", "string", НСтр("ru = 'Поле.'"));
	СвойстваСортировки.Вставить("desc", СвойствоПараметра("boolean", НСтр("ru = 'По убыванию.'")));
	ЭлементСортировки.Вставить("properties", СвойстваСортировки);
	Сортировка = Новый Соответствие;
	Сортировка.Вставить("type", "array");
	Сортировка.Вставить("items", ЭлементСортировки);
	Сортировка.Вставить("description", НСтр("ru = 'Необязательно: сортировка.'"));
	СвойстваНастройки.Вставить("sort", Сортировка);
	СвойстваНастройки.Вставить("save_as_new", СвойствоПараметра("boolean",
		НСтр("ru = 'Создать отдельный вариант, даже если в этом диалоге вариант этого отчёта уже сохранялся. Только по явной просьбе пользователя.'")));
	Инструменты.Добавить(ОписаниеИнструмента("configure_report",
		НСтр("ru = 'Настраивает вариант отчёта (период, отборы, параметры, группировки, поля, сортировка), сразу сохраняет настройку личным вариантом пользователя и формирует по нему отчёт. Используй, когда пользователь просит настроить отчёт или сохранить настройку отчёта. Повторный вызов для того же отчёта в диалоге обновляет сохранённый вариант.'"),
		СвойстваНастройки, "variant_id,title"));

	// Бухгалтерские инструменты: ОСВ и отчёты - на конвейере БухгалтерскиеОтчеты (ERP, КА, БП), остатки и обороты
	// счетов - при любом регистре бухгалтерии ассистента, в том числе Управленческом (УНФ).
	Если ИИА_БухгалтерскийДоступ.БухгалтерскийУчетДоступен() Тогда
		// Бухгалтерские инструменты: профиль с запретом по умолчанию без разрешённых счетов получает только ОСВ.
		НаборСчетов = ИИА_ПериметрПовтИсп.НаборСчетов();
		Если ИИА_БухгалтерскийДоступ.БухгалтерскиеОтчетыДоступны() Тогда
			СвойстваОСВ = СвойстваПараметров("period_start", "string", НСтр("ru = 'Начало периода ГГГГ-ММ-ДД.'"));
			СвойстваОСВ.Вставить("period_end", СвойствоПараметра("string", НСтр("ru = 'Конец периода ГГГГ-ММ-ДД.'")));
			СвойстваОСВ.Вставить("organization", СвойствоПараметра("string", НСтр("ru = 'Часть наименования организации (обязательно, если организаций несколько).'")));
			Инструменты.Добавить(ОписаниеИнструмента("run_trial_balance",
				НСтр("ru = 'Оборотно-сальдовая ведомость бухучёта за период: остатки и обороты по счетам. Счета вне профиля доступа и счета расчётов с персоналом (69, 70, 71, 73) исключены.'"),
				СвойстваОСВ, "period_start,period_end"));

			ВидыОтчетов = Новый Массив;
			Для Каждого КлючИЗначение Из ИИА_БухгалтерскийДоступ.ВидыБухгалтерскихОтчетов() Цикл
				Если НаборСчетов.РасширенныйДоступ Или КлючИЗначение.Ключ = "trial_balance" Тогда
					ВидыОтчетов.Добавить(КлючИЗначение.Ключ);
				КонецЕсли;
			КонецЦикла;
			СвойстваБухОтчета = СвойстваПараметров("report_kind", "string",
				НСтр("ru = 'trial_balance - ОСВ по всем счетам, account_trial_balance - ОСВ по счёту, account_analysis - анализ счёта, account_turnovers - обороты счёта.'"));
			СвойстваБухОтчета.Получить("report_kind").Вставить("enum", ВидыОтчетов);
			СвойстваБухОтчета.Вставить("period_start", СвойствоПараметра("string", НСтр("ru = 'Начало периода ГГГГ-ММ-ДД.'")));
			СвойстваБухОтчета.Вставить("period_end", СвойствоПараметра("string", НСтр("ru = 'Конец периода ГГГГ-ММ-ДД.'")));
			СвойстваБухОтчета.Вставить("organization", СвойствоПараметра("string", НСтр("ru = 'Часть наименования организации (обязательно, если организаций несколько).'")));
			СвойстваБухОтчета.Вставить("account", СвойствоПараметра("string", НСтр("ru = 'Код или наименование счёта: 60, 60.01, расчёты с поставщиками (обязателен, кроме trial_balance).'")));
			СвойстваБухОтчета.Вставить("by_subaccounts", СвойствоПараметра("boolean", НСтр("ru = 'По субсчетам.'")));
			СвойстваБухОтчета.Вставить("by_corr_subaccounts", СвойствоПараметра("boolean", НСтр("ru = 'Корреспондирующие счета по субсчетам (account_analysis, account_turnovers).'")));
			ГруппировкиСубконто = Новый Соответствие;
			ГруппировкиСубконто.Вставить("type", "array");
			ГруппировкиСубконто.Вставить("items", СвойствоПараметра("string", ""));
			ГруппировкиСубконто.Вставить("description", НСтр("ru = 'Наименования видов субконто счёта для группировки, до 3 (account_trial_balance, account_analysis).'"));
			СвойстваБухОтчета.Вставить("group_by_subconto", ГруппировкиСубконто);
			Инструменты.Добавить(ОписаниеИнструмента("run_accounting_report",
				НСтр("ru = 'Бухгалтерский отчёт штатным конвейером ERP: ОСВ, ОСВ по счёту, анализ счёта, обороты счёта. Доступны только счета, разрешённые профилем; счета расчётов с персоналом (69, 70, 71, 73) закрыты всегда. Отчёт открывается пользователю; тебе возвращается компактная таблица.'"),
				СвойстваБухОтчета, "report_kind,period_start,period_end"));
		КонецЕсли;

		Если НаборСчетов.РасширенныйДоступ Тогда
			СвойстваОстатков = СвойстваПараметров("mode", "string",
				НСтр("ru = 'balances - остатки на дату, turnovers - обороты за период, balances_and_turnovers - остатки и обороты.'"));
			СвойстваОстатков.Получить("mode").Вставить("enum", СтрРазделить("balances,turnovers,balances_and_turnovers", ","));
			СвойстваОстатков.Вставить("period_start", СвойствоПараметра("string", НСтр("ru = 'Начало периода ГГГГ-ММ-ДД (для turnovers и balances_and_turnovers).'")));
			СвойстваОстатков.Вставить("period_end", СвойствоПараметра("string", НСтр("ru = 'Конец периода ГГГГ-ММ-ДД (для balances - дата остатков).'")));
			СвойстваОстатков.Вставить("organization", СвойствоПараметра("string", НСтр("ru = 'Часть наименования организации.'")));
			СчетаОстатков = Новый Соответствие;
			СчетаОстатков.Вставить("type", "array");
			СчетаОстатков.Вставить("items", СвойствоПараметра("string", ""));
			СчетаОстатков.Вставить("description", НСтр("ru = 'Коды или наименования счетов (с субсчетами), до 20; без них - все доступные счета.'"));
			СвойстваОстатков.Вставить("accounts", СчетаОстатков);
			Если ИИА_БухгалтерскийДоступ.СубконтоДоступны() Тогда
				СвойстваОстатков.Вставить("subconto", СвойствоПараметра("string", НСтр("ru = 'Необязательно: один вид субконто, например Контрагенты, Номенклатура.'")));
			КонецЕсли;
			СвойстваОстатков.Вставить("by_corr_account", СвойствоПараметра("boolean", НСтр("ru = 'Обороты в разрезе корреспондирующих счетов (только для turnovers).'")));
			Инструменты.Добавить(ОписаниеИнструмента("accounting_balances",
				СтрШаблон(НСтр("ru = 'Остатки и обороты регистра бухгалтерии %1 по счетам%2. Только счета, разрешённые профилем; счета 69, 70, 71, 73 и субконто с людьми недоступны. Возвращает таблицу (table_id для slice_result и make_chart).'"),
					ИИА_БухгалтерскийДоступ.ИмяПланаСчетов(), ?(ИИА_БухгалтерскийДоступ.СубконтоДоступны(),
					НСтр("ru = ' и, по желанию, одному виду субконто'"), "")),
				СвойстваОстатков, "mode,period_end"));
		КонецЕсли;
	КонецЕсли;

	СвойстваСреза = СвойстваПараметров("table_id", "string", НСтр("ru = 'Идентификатор таблицы (t1, t2, ...) из run_query, find_records или run_report.'"));
	Условия = Новый Соответствие;
	Условия.Вставить("type", "object");
	Условия.Вставить("description", НСтр("ru = 'Необязательно: колонка -> текст (вхождение без учёта регистра) или условие ""> 1000"", ""<= 0"".'"));
	СвойстваСреза.Вставить("filter", Условия);
	СвойстваСреза.Вставить("sort_by", СвойствоПараметра("string", НСтр("ru = 'Колонка сортировки.'")));
	СвойстваСреза.Вставить("descending", СвойствоПараметра("boolean", НСтр("ru = 'По убыванию.'")));
	СвойстваСреза.Вставить("top", СвойствоПараметра("integer", НСтр("ru = 'Сколько первых строк вернуть (по умолчанию 20).'")));
	Инструменты.Добавить(ОписаниеИнструмента("slice_result",
		НСтр("ru = 'Срез уже полученной таблицы хода без повторного запроса или формирования отчёта: отбор, сортировка, первые N строк.'"),
		СвойстваСреза, "table_id"));

	Для Каждого Инструмент Из ИИА_Знания.ОписанияИнструментов() Цикл
		Инструменты.Добавить(Инструмент);
	КонецЦикла;
	Для Каждого Инструмент Из ИИА_КартаДоступа.ОписанияИнструментов() Цикл
		Инструменты.Добавить(Инструмент);
	КонецЦикла;
	Для Каждого Инструмент Из ИИА_ИсходныйКод.ОписанияИнструментов(Канал) Цикл
		Инструменты.Добавить(Инструмент);
	КонецЦикла;
	Если ИИА_ИсходныйКод.КодДоступен() Или ФормыНаКлиенте Тогда
		СвойстваФормы = СвойстваПараметров("object", "string", НСтр("ru = 'Полное имя объекта, как в form_layout.'"));
		СвойстваФормы.Вставить("form", СвойствоПараметра("string", НСтр("ru = 'Необязательно: имя формы, как в form_layout.'")));
		Шаг = Новый Соответствие;
		Шаг.Вставить("type", "object");
		СвойстваШага = Новый Соответствие;
		СвойстваШага.Вставить("element", СвойствоПараметра("string", НСтр("ru = 'Имя элемента из form_layout (в квадратных скобках): вкладка, поле, таблица или кнопка.'")));
		СвойстваШага.Вставить("title", СвойствоПараметра("string", НСтр("ru = 'Заголовок элемента, как в form_layout.'")));
		СвойстваШага.Вставить("hint", СвойствоПараметра("string", НСтр("ru = 'Что сделать на этом шаге, коротко: «нажмите», «выберите склад».'")));
		Шаг.Вставить("properties", СвойстваШага);
		Шаги = Новый Соответствие;
		Шаги.Вставить("type", "array");
		Шаги.Вставить("items", Шаг);
		Шаги.Вставить("description", НСтр("ru = 'Шаги инструкции по порядку (до 9): на форме они получат номера ❶ ❷ ❸, цвет и подсказку.'"));
		СвойстваФормы.Вставить("steps", Шаги);
		СвойстваФормы.Вставить("id", СвойствоПараметра("string", НСтр("ru = 'Необязательно: объект хода (o1, o2, ...) - открыть форму этого объекта. Без id - объект, из которого открыт чат, или новый объект.'")));
		СвойстваФормы.Вставить("title", СвойствоПараметра("string", НСтр("ru = 'Короткая подпись кнопки, например «подбор товаров».'")));
		Инструменты.Добавить(ОписаниеИнструмента("show_form",
			НСтр("ru = 'Добавляет под ответом кнопку «Показать на форме»: открывает пользователю настоящую форму, переключает вкладки и отмечает шаги инструкции номерами, цветом и подсказками. Дополняет пошаговую инструкцию по form_layout.'"),
			СвойстваФормы, "object,steps"));
	КонецЕсли;
	Для Каждого Инструмент Из ИИА_Действия.ОписанияИнструментов(Канал) Цикл
		Инструменты.Добавить(Инструмент);
	КонецЦикла;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Инструменты, ИИА_Файлы.ОписанияИнструментов(Канал));
	Для Каждого Инструмент Из ИИА_Диагностика.ОписанияИнструментов(Канал) Цикл
		Инструменты.Добавить(Инструмент);
	КонецЦикла;

	// Инструменты, выключенные профилем пользователя, модель не видит.
	Индекс = Инструменты.ВГраница();
	Пока Индекс >= 0 Цикл
		Если ИИА_ПрофилиДоступа.ИнструментЗапрещенПрофилем(Инструменты[Индекс].Получить("function").Получить("name")) Тогда
			Инструменты.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	// Дополнительные инструменты других расширений: модель видит только разрешённые администратором.
	Дополнительные = Новый Массив;
	ИИА_ИнструментыПереопределяемый.ПриОпределенииИнструментов(Дополнительные);
	Встроенные = Новый Соответствие;
	Для Каждого Инструмент Из Инструменты Цикл
		Встроенные.Вставить(Инструмент.Получить("function").Получить("name"), Истина);
	КонецЦикла;
	Для Каждого Инструмент Из Дополнительные Цикл
		Имя = ИмяИнструмента(Инструмент);
		Если ПустаяСтрока(Имя) Или Встроенные.Получить(Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если РежимДополнительногоИнструмента(Имя, Истина) = "Разрешен" Тогда
			Инструменты.Добавить(Инструмент);
		КонецЕсли;
	КонецЦикла;

	Возврат Инструменты;

КонецФункции

// Инструменты для выбора в профиле доступа: встроенные и уже встречавшиеся инструменты других расширений.
// В отличие от ОписанияИнструментов не зависит от профиля и настроек текущего пользователя.
//
// Возвращаемое значение:
//  СписокЗначений из Строка - значение: имя инструмента, представление: имя и назначение.
//
Функция ИнструментыДляВыбора() Экспорт

	Список = Новый СписокЗначений;
	Список.Добавить("search_metadata", "search_metadata - " + НСтр("ru = 'Поиск объектов конфигурации'"));
	Список.Добавить("describe_metadata", "describe_metadata - " + НСтр("ru = 'Описание объекта конфигурации'"));
	Список.Добавить("read_register", "read_register - " + НСтр("ru = 'Чтение регистра на дату или за период'"));
	Список.Добавить("run_query", "run_query - " + НСтр("ru = 'Запрос к данным'"));
	Список.Добавить("find_records", "find_records - " + НСтр("ru = 'Поиск записей по наименованию, коду, номеру'"));
	Список.Добавить("read_object", "read_object - " + НСтр("ru = 'Чтение реквизитов объекта'"));
	Список.Добавить("open_object", "open_object - " + НСтр("ru = 'Открытие формы объекта'"));
	Список.Добавить("make_chart", "make_chart - " + НСтр("ru = 'Построение графика'"));
	Список.Добавить("slice_result", "slice_result - " + НСтр("ru = 'Отбор и сортировка полученной таблицы'"));
	Список.Добавить("find_report", "find_report - " + НСтр("ru = 'Поиск отчётов'"));
	Список.Добавить("describe_report", "describe_report - " + НСтр("ru = 'Описание параметров отчёта'"));
	Список.Добавить("run_report", "run_report - " + НСтр("ru = 'Формирование отчёта'"));
	Список.Добавить("configure_report", "configure_report - " + НСтр("ru = 'Настройка отчёта с сохранением личного варианта'"));
	Список.Добавить("run_trial_balance", "run_trial_balance - " + НСтр("ru = 'Оборотно-сальдовая ведомость'"));
	Список.Добавить("run_accounting_report", "run_accounting_report - " + НСтр("ru = 'Бухгалтерские отчёты: ОСВ, ОСВ по счёту, анализ и обороты счёта'"));
	Список.Добавить("accounting_balances", "accounting_balances - " + НСтр("ru = 'Остатки и обороты по счетам бухучёта'"));
	Список.Добавить("glossary", "glossary - " + НСтр("ru = 'Глоссарий терминов'"));
	Список.Добавить("data_access", "data_access - " + НСтр("ru = 'Правила доступа ассистента к данным'"));
	Список.Добавить("propose_draft", "propose_draft - " + НСтр("ru = 'Черновик документа'"));
	Список.Добавить("propose_change", "propose_change - " + НСтр("ru = 'Изменение данных с подтверждением'"));
	Список.Добавить("rlm_execute", "rlm_execute - " + НСтр("ru = 'Код: исследование исходников (Python в песочнице rlm)'"));
	Список.Добавить("code_movements", "code_movements - " + НСтр("ru = 'Код: движения документа по регистрам'"));
	Список.Добавить("form_layout", "form_layout - " + НСтр("ru = 'Структура формы для инструкций пользователю'"));
	Список.Добавить("show_form", "show_form - " + НСтр("ru = 'Кнопка «Показать на форме» с отметкой шагов'"));
	Список.Добавить("read_attachment", "read_attachment - " + НСтр("ru = 'Чтение большого файла вопроса порциями'"));
	Список.Добавить("make_file", "make_file - " + НСтр("ru = 'Файл в ответе (md, csv, xlsx)'"));
	Список.Добавить("event_log", "event_log - " + НСтр("ru = 'Журнал регистрации'"));
	Список.Добавить("check_filling", "check_filling - " + НСтр("ru = 'Проверка заполнения и препятствия записи'"));
	Список.Добавить("field_visibility", "field_visibility - " + НСтр("ru = 'Видимость поля на форме'"));
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Р.Инструмент КАК Инструмент,
	|	Р.Источник КАК Источник
	|ИЗ
	|	РегистрСведений.ИИА_РежимыИнструментов КАК Р
	|
	|УПОРЯДОЧИТЬ ПО
	|	Р.Инструмент");
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Список.НайтиПоЗначению(Выборка.Инструмент) = Неопределено Тогда
			Список.Добавить(Выборка.Инструмент, Выборка.Инструмент + " - "
				+ СтрШаблон(НСтр("ru = 'дополнительный (%1)'"), Выборка.Источник));
		КонецЕсли;
	КонецЦикла;
	Возврат Список;

КонецФункции

// Выполняет инструмент.
//
// Параметры:
//  Имя - Строка
//  АргументыJSON - Строка
//  Контекст - ЛюбаяСсылка, Неопределено - объект, из которого открыт чат; проверен ОписаниеКонтекста.
//  ВариантыДиалога - Массив из Структура - Вариант, ИмяОтчета - варианты, сохранённые configure_report в этом диалоге:
//    повторная настройка того же отчёта обновляет вариант, а не создаёт новый.
//
//  Исследование - Структура, Неопределено - доверенное состояние исследования отдельного хода.
//  СтруктурыФорм - Соответствие, Неопределено - структуры форм, построенные клиентом чата: ключ - полное имя
//    формы (с объектом - см. ИИА_ИсходныйКод.КлючСтруктурыФормыИнструмента), значение - Массив элементов или Строка
//    с ошибкой (см. ИИА_ИсходныйКод.ОписатьФорму).
//  ОбъектыХода - Массив из Структура, Неопределено - объекты хода (o1, o2…) для инструментов диагностики; вне хода
//    (внешний канал) объект задаётся навигационной ссылкой.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * Данные - Произвольный - сериализуемый результат для модели.
//   * Таблица - Структура, Неопределено - Колонки и Строки для показа пользователю.
//   * Строк - Число
//   * Скрыто - Число
//   * Итог - Строка - код итога для журнала.
//   * Отчет - Структура, Неопределено - описание открытия отчёта в штатной форме.
//   * Класс - Число - класс данных результата 0..4 (ИИА_КлассыДанных); по нему выбирается провайдер.
//   * ИсточникиСписков - Массив из Строка - полные имена объектов метаданных, данные которых прочитаны напрямую
//       (источники «список» для ссылок под ответом).
//   * НастроенныйВариант - Структура, Неопределено - сохранённый configure_report вариант: Вариант (уникальный
//       идентификатор строкой), ИмяОтчета, Заголовок, Создан.
//
Функция ВыполнитьИнструмент(Имя, АргументыJSON, Контекст = Неопределено, ВариантыДиалога = Неопределено, Исследование = Неопределено,
	СтруктурыФорм = Неопределено, ОбъектыХода = Неопределено) Экспорт

	Результат = Новый Структура("Успех, Данные, Таблица, Строк, Скрыто, Итог, Отчет, Класс, ИсточникиСписков, НастроенныйВариант",
		Ложь, Неопределено, Неопределено, 0, 0, "", Неопределено, 1, Новый Массив, Неопределено);

	Попытка
		Аргументы = ОбщегоНазначения.JSONВЗначение(АргументыJSON, , Истина);
	// Ошибка входного JSON превращается в BAD_ARGUMENTS ниже.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Аргументы = Неопределено;
	КонецПопытки;
	Если ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
		Возврат Отказ(Результат, "BAD_ARGUMENTS", НСтр("ru = 'Аргументы инструмента должны быть JSON-объектом.'"));
	КонецЕсли;
	Если ИИА_ПрофилиДоступа.ИнструментЗапрещенПрофилем(Имя) Тогда
		Возврат Отказ(Результат, "TOOL_DISABLED", СтрШаблон(НСтр("ru = 'Инструмент %1 выключен профилем доступа.'"), Имя));
	КонецЕсли;

	Если Имя = "search_metadata" Тогда
		Возврат НайтиМетаданные(Результат, СтрокаАргумента(Аргументы, "text"));
	ИначеЕсли Имя = "describe_metadata" Тогда
		Возврат ОписатьМетаданные(Результат, СтрокаАргумента(Аргументы, "name"));
	ИначеЕсли Имя = "read_register" Тогда
		Возврат ПрочитатьРегистр(Результат, Аргументы, Контекст);
	ИначеЕсли Имя = "run_query" Тогда
		Возврат ВыполнитьЗапрос(Результат, СтрокаАргумента(Аргументы, "query"), Аргументы.Получить("parameters"), Контекст);
	ИначеЕсли Имя = "find_report" Тогда
		Возврат НайтиОтчет(Результат, СтрокаАргумента(Аргументы, "text"));
	ИначеЕсли Имя = "run_trial_balance" Тогда
		// Совместимая обёртка: прежние параметры и ответ, отбор по набору счетов общего адаптера.
		СформироватьБухгалтерскийОтчет(Результат, "trial_balance", Аргументы);
		Если Результат.Успех Тогда
			Результат.Данные = Новый Структура("report, period, rows, truncated, excluded", Результат.Данные.report,
				Результат.Данные.period, Результат.Данные.rows, Результат.Данные.truncated, Результат.Данные.excluded);
		КонецЕсли;
		Возврат Результат;
	ИначеЕсли Имя = "run_accounting_report" Тогда
		Возврат СформироватьБухгалтерскийОтчет(Результат, СтрокаАргумента(Аргументы, "report_kind"), Аргументы);
	ИначеЕсли Имя = "accounting_balances" Тогда
		Возврат ОстаткиИОборотыСчетов(Результат, Аргументы);
	ИначеЕсли Имя = "run_report" Тогда
		Возврат СформироватьОтчет(Результат, СтрокаАргумента(Аргументы, "variant_id"),
			СтрокаАргумента(Аргументы, "period_start"), СтрокаАргумента(Аргументы, "period_end"),
			УсловияАргументов(Аргументы, "filters"));
	ИначеЕсли Имя = "configure_report" Тогда
		Возврат НастроитьОтчет(Результат, Аргументы, ?(ВариантыДиалога = Неопределено, Новый Массив, ВариантыДиалога));
	ИначеЕсли Имя = "describe_report" Тогда
		Возврат ОписатьОтчет(Результат, СтрокаАргумента(Аргументы, "variant_id"));
	ИначеЕсли Имя = "glossary" Или Имя = "find_records" Тогда
		Возврат ИИА_Знания.ВыполнитьИнструмент(Имя, Аргументы, Результат);
	ИначеЕсли Имя = "data_access" Тогда
		Возврат ИИА_КартаДоступа.ВыполнитьИнструмент(Аргументы, Результат);
	ИначеЕсли Имя = "code_movements" Или Имя = "form_layout" Или Имя = "rlm_execute" Тогда
		Возврат ИИА_ИсходныйКод.ВыполнитьИнструмент(Имя, Аргументы, Результат, Исследование, СтруктурыФорм);
	ИначеЕсли ИИА_Диагностика.ЭтоИнструментДиагностики(Имя) Тогда
		Возврат ИИА_Диагностика.ВыполнитьИнструмент(Имя, Аргументы, Результат, ОбъектыХода, Контекст, СтруктурыФорм);
	КонецЕсли;

	// Дополнительный инструмент: только разрешённый администратором (план, раздел 4.12).
	Режим = РежимДополнительногоИнструмента(Имя, Ложь);
	Если Режим <> "" Тогда
		Если Режим <> "Разрешен" Тогда
			ОтметитьОтказ(Имя);
			Возврат Отказ(Результат, "TOOL_NOT_APPROVED",
				СтрШаблон(НСтр("ru = 'Инструмент %1 ещё не разрешён администратором.'"), Имя));
		КонецЕсли;
		СтандартнаяОбработка = Истина;
		ИИА_ИнструментыПереопределяемый.ПриВыполненииИнструмента(Имя, Аргументы, Результат, СтандартнаяОбработка);
		Если Не СтандартнаяОбработка Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	// Неизвестный инструмент запрещён (план, раздел 4.12).
	Возврат Отказ(Результат, "UNKNOWN_TOOL", СтрШаблон(НСтр("ru = 'Инструмент %1 не зарегистрирован.'"), Имя));

КонецФункции

// Значение по тексту для отбора или реквизита: дата ГГГГ-ММ-ДД, число, булево, перечисление по синониму,
// ссылка по наименованию или номеру (с правами пользователя и периметром). При неоднозначности -
// Неопределено и текст с кандидатами в Ошибки.
//
// Параметры:
//  ОписаниеТипа - ОписаниеТипов
//  Текст - Строка
//  Ошибки - Массив из Строка
//  ИмяПоля - Строка - для текста ошибки.
//
// Возвращаемое значение:
//  Произвольный, Неопределено
//
Функция ЗначениеПоТексту(ОписаниеТипа, Текст, Ошибки, ИмяПоля) Экспорт

	Возврат ЗначениеОтбора(ОписаниеТипа, Текст, Ошибки, ИмяПоля);

КонецФункции

// Проверка, доступен ли отчёт ассистенту: не вне периметра и профиля, есть в карточках или открыт общий мост
// отчётов, у пользователя есть право использования.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - отчёт.
//  Текст - Строка - возвращается пояснение отказа.
//  Карточка - Структура, Неопределено - возвращается карточка отчёта (см. КарточкиОтчетов).
//
// Возвращаемое значение:
//  Строка - код отказа PERIMETER_VIOLATION или ACCESS_DENIED; пусто - отчёт доступен.
//
Функция ОтказДоступаКОтчету(ОбъектМетаданных, Текст = "", Карточка = Неопределено) Экспорт

	Карточка = КарточкиОтчетов().Получить(ОбъектМетаданных.Имя);
	Если ОтчетВнеПериметра(ОбъектМетаданных) Или Карточка = Неопределено И Не ОбщийМостВключен() Тогда
		Текст = НСтр("ru = 'Отчёт вне периметра ассистента.'");
		Возврат "PERIMETER_VIOLATION";
	КонецЕсли;
	Если Не ПравоДоступа("Использование", ОбъектМетаданных) Тогда
		Текст = НСтр("ru = 'Нет права на этот отчёт.'");
		Возврат "ACCESS_DENIED";
	КонецЕсли;
	Возврат "";

КонецФункции

// Сохраняет настройки новым личным вариантом пользователя (только для автора, родитель - по исходному, как в форме
// сохранения варианта БСП) или обновляет ранее созданный. Одна транзакция в правах пользователя: не вызывать
// внутри внешней транзакции.
//
// Параметры:
//  ИсходныйВариант - СправочникСсылка.ВариантыОтчетов - вариант, по которому построены настройки.
//  Настройки - НастройкиКомпоновкиДанных
//  Наименование - Строка - при занятости добавляется « (2)», « (3)» и т.д.
//  ОбновляемыйВариант - СправочникСсылка.ВариантыОтчетов, Неопределено - личный вариант пользователя для обновления.
//  ПользовательскиеНастройки - ПользовательскиеНастройкиКомпоновкиДанных, Неопределено - текущие пользовательские
//                              настройки варианта (как их сохраняет форма отчёта).
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * Вариант - СправочникСсылка.ВариантыОтчетов, Неопределено
//   * Наименование - Строка - итоговое наименование.
//   * Создан - Булево - Истина - создан новый вариант.
//   * КодОшибки - Строка - NO_RIGHT или SAVE_ERROR.
//   * Ошибка - Строка
//
Функция СохранитьЛичныйВариант(ИсходныйВариант, Настройки, Наименование, ОбновляемыйВариант = Неопределено,
	ПользовательскиеНастройки = Неопределено) Экспорт

	Результат = Новый Структура("Успех, Вариант, Наименование, Создан, КодОшибки, Ошибка", Ложь, Неопределено, "",
		ОбновляемыйВариант = Неопределено, "", "");
	ИмяПрава = ?(Результат.Создан, "Добавление", "Изменение");
	// Право SaveUserData относится к корневой конфигурации (документация 1С 8.3.27, раздел «Роли»).
	// Модель AccessRight анализатора не включает Конфигурация в допустимые типы второго параметра.
	Если Не ПравоДоступа("СохранениеДанныхПользователя", Метаданные) // BSLLS:TypeMismatch-off
		Или Не ПравоДоступа(ИмяПрава, Метаданные.Справочники.ВариантыОтчетов) Тогда
		Результат.КодОшибки = "NO_RIGHT";
		Результат.Ошибка = НСтр("ru = 'Нет права сохранять личные варианты отчётов.'");
		Возврат Результат;
	КонецЕсли;
	Исходный = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИсходныйВариант,
		"Отчет, ТипОтчета, Пользовательский, Родитель, Назначение", Истина);
	ИмяОтчета = "Отчет." + ОбъектМетаданныхОтчета(Исходный.Отчет).Имя;
	Основа = Лев(Наименование, 140);

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.ВариантыОтчетов");
		Если Результат.Создан Тогда
			ЭлементБлокировки.УстановитьЗначение("Ссылка", ИсходныйВариант);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Разделяемый;
		Иначе
			ЭлементБлокировки.УстановитьЗначение("Ссылка", ОбновляемыйВариант);
		КонецЕсли;
		Блокировка.Заблокировать();

		Если Результат.Создан Тогда
			ВариантОбъект = Справочники.ВариантыОтчетов.СоздатьЭлемент();
			ВариантОбъект.Отчет = Исходный.Отчет;
			ВариантОбъект.ТипОтчета = Исходный.ТипОтчета;
			ВариантОбъект.КлючВарианта = Строка(Новый УникальныйИдентификатор);
			ВариантОбъект.Пользовательский = Истина;
			ВариантОбъект.Автор = Пользователи.ТекущийПользователь();
			ВариантОбъект.Родитель = ?(Исходный.Пользовательский, Исходный.Родитель, ИсходныйВариант);
			ВариантОбъект.ТолькоДляАвтора = Истина;
			ВариантОбъект.Назначение = Исходный.Назначение;
			ВариантОбъект.Описание = НСтр("ru = 'Создан ИИ-ассистентом'");
		Иначе
			ВариантОбъект = ОбновляемыйВариант.ПолучитьОбъект();
		КонецЕсли;
		Запрос = Новый Запрос("ВЫБРАТЬ Варианты.Наименование КАК Наименование ИЗ Справочник.ВариантыОтчетов КАК Варианты
		|ГДЕ Варианты.Отчет = &Отчет И НЕ Варианты.ПометкаУдаления И Варианты.Ссылка <> &Ссылка");
		Запрос.УстановитьПараметр("Отчет", Исходный.Отчет);
		Запрос.УстановитьПараметр("Ссылка", ВариантОбъект.Ссылка);
		// Чужие личные варианты закрыты RLS БСП, а занятость наименования проверяется по всем (как в БСП).
		УстановитьПривилегированныйРежим(Истина);
		Занятые = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Наименование");
		УстановитьПривилегированныйРежим(Ложь);
		СвободноеНаименование = Основа;
		Номер = 1;
		Пока Занятые.Найти(СвободноеНаименование) <> Неопределено Цикл
			Номер = Номер + 1;
			СвободноеНаименование = СтрШаблон("%1 (%2)", Основа, Формат(Номер, "ЧГ="));
		КонецЦикла;
		ВариантОбъект.Наименование = СвободноеНаименование;
		ПользователиВарианта = Новый СписокЗначений;
		ПользователиВарианта.Добавить(ВариантОбъект.Автор, , Истина);
		ВариантОбъект.ДополнительныеСвойства.Вставить("ПользователиВарианта", ПользователиВарианта);
		ВариантОбъект.ДополнительныеСвойства.Вставить("УведомитьПользователей", Ложь);
		ВариантОбъект.Записать();

		ОписаниеНастроек = Новый ОписаниеНастроек;
		ОписаниеНастроек.Представление = СвободноеНаименование;
		ХранилищеВариантовОтчетов.Сохранить(ИмяОтчета, ВариантОбъект.КлючВарианта, Настройки, ОписаниеНастроек);
		// Период и другие параметры с пользовательской настройкой берутся из текущих пользовательских настроек
		// варианта: без них форма отчёта подставляет свои значения по умолчанию (например, «Этот месяц»).
		Если ПользовательскиеНастройки <> Неопределено Тогда
			ОбщегоНазначения.ХранилищеСистемныхНастроекСохранить(
				КлючТекущихПользовательскихНастроек(ИмяОтчета, ВариантОбъект.КлючВарианта), "", ПользовательскиеНастройки);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		УстановитьПривилегированныйРежим(Ложь);
		Информация = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации("ИИАссистент.Инструменты", УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));
		// Отказ в правах (в том числе RLS и проверка хранилища вариантов) - как отсутствие права, а не сбой.
		Результат.КодОшибки = ?(Информация.Категория = КатегорияОшибки.НарушениеПравДоступа, "NO_RIGHT", "SAVE_ERROR");
		Результат.Ошибка = НСтр("ru = 'Не удалось сохранить вариант отчёта.'");
		Возврат Результат;
	КонецПопытки;

	Результат.Успех = Истина;
	Результат.Вариант = ВариантОбъект.Ссылка;
	Результат.Наименование = СвободноеНаименование;
	Возврат Результат;

КонецФункции

// Описание объекта, из которого открыт чат: проверка периметром и прав, значения шапки через границу запроса.
//
// Параметры:
//  Ссылка - ЛюбаяСсылка
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * Ошибка - Строка - текст для пользователя, если объект недоступен ассистенту.
//   * Класс - Число - класс границы запроса, не понижается очисткой.
//   * Представление - Строка - безопасное представление объекта.
//   * Данные - Структура - для модели: object, type, fields, tabular_sections.
//   * Объекты - Массив из Структура - Текст, Ссылка - ссылки шапки для показа в чате.
//
Функция ОписаниеКонтекста(Ссылка) Экспорт

	Результат = Новый Структура("Успех, Ошибка, Представление, Данные, Объекты, Класс",
		Ложь, "", "", Неопределено, Новый Массив, 4);
	Недоступен = НСтр("ru = 'Этот объект недоступен ИИ-ассистенту: персональные, кадровые и зарплатные данные на этом этапе исключены.'");

	Причина = "";
	Если Не ПроверитьДоступностьОбъекта(Ссылка, Причина) Тогда
		Результат.Ошибка = ?(Причина = "BAD_OBJECT", НСтр("ru = 'Объект не записан или не поддерживается.'"), Недоступен);
		Возврат Результат;
	КонецЕсли;
	ОбъектМетаданных = Ссылка.Метаданные();
	ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	Ссылки = Новый Массив;
	Ссылки.Добавить(Ссылка);

	// Поля шапки: стандартные и реквизиты, разрешённые периметром.
	Поля = Новый Массив;
	Поля.Добавить("Т.Ссылка КАК Ссылка");
	Для Каждого Имя Из СтрРазделить("Код,Наименование,Номер,Дата,Проведен,Владелец,Родитель", ",") Цикл
		Если ЕстьСтандартныйРеквизит(ОбъектМетаданных, Имя) И Не ИИА_Периметр.ПолеЗапрещено(ПолноеИмя, Имя)
			И Не ИИА_Маскирование.ПолеМаскируется(ПолноеИмя, Имя) Тогда
			Поля.Добавить(СтрШаблон("Т.%1 КАК %1", Имя));
		КонецЕсли;
	КонецЦикла;
	Реквизиты = КоллекцияМетаданных(ОбъектМетаданных, "Реквизиты");
	Если Реквизиты <> Неопределено Тогда
		Для Каждого Реквизит Из Реквизиты Цикл
			Если Поля.Количество() >= 40 Тогда
				Прервать;
			КонецЕсли;
			// Реквизиты списка коммерческого маскирования модели не выдаются (ссылка Т.Ссылка - псевдонимом).
			Если Не ИИА_Периметр.ПолеЗапрещено(ПолноеИмя, Реквизит.Имя)
				И Не ИИА_Маскирование.ПолеМаскируется(ПолноеИмя, Реквизит.Имя) Тогда
				Поля.Добавить(СтрШаблон("Т.%1 КАК %1", Реквизит.Имя));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// Поля и источник взяты из проверенных метаданных; анализатор видит шаблон до подстановки.
	// BSLLS:QueryParseError-off
	ТекстЗапроса = СтрШаблон("ВЫБРАТЬ %1 ИЗ %2 КАК Т ГДЕ Т.Ссылка = &Объект", СтрСоединить(Поля, ", "), ПолноеИмя);
	// BSLLS:QueryParseError-on
	ПараметрыЗапроса = Новый Структура("Объект", Ссылка);
	Выполнение = ИИА_ГраницаЗапроса.ВыполнитьЗапросАгента(ТекстЗапроса, ПараметрыЗапроса, 1, Ссылки);
	Если Не Выполнение.Успех Или Выполнение.Строки.Количество() = 0 Тогда
		Результат.Ошибка = НСтр("ru = 'Не удалось прочитать объект: нет прав или он недоступен ассистенту.'");
		Возврат Результат;
	КонецЕсли;

	Значения = Выполнение.Строки[0];
	ПоляОбъекта = Новый Соответствие;
	Для Индекс = 1 По Выполнение.Колонки.ВГраница() Цикл
		Если Значения[Индекс] <> Неопределено И Значения[Индекс] <> "" Тогда
			ПоляОбъекта.Вставить(Выполнение.Колонки[Индекс], Значения[Индекс]);
		КонецЕсли;
	КонецЦикла;
	ТабличныеЧасти = Новый Массив;
	КоллекцияТЧ = КоллекцияМетаданных(ОбъектМетаданных, "ТабличныеЧасти");
	Если КоллекцияТЧ <> Неопределено Тогда
		Для Каждого ТабличнаяЧасть Из КоллекцияТЧ Цикл
			Если Не ИИА_Периметр.ОбъектЗапрещен(ПолноеИмя + "." + ТабличнаяЧасть.Имя) Тогда
				ТабличныеЧасти.Добавить(ПолноеИмя + "." + ТабличнаяЧасть.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.Класс = ИИА_КлассыДанных.ПодтвержденныйКласс(Выполнение.Класс);
	Результат.Представление = Значения[0];
	Результат.Объекты = Выполнение.Объекты;
	Результат.Данные = Новый Структура("object, type, fields, tabular_sections",
		Значения[0], ПолноеИмя, ПоляОбъекта, ТабличныеЧасти);
	Возврат Результат;

КонецФункции

// Доступен ли объект ассистенту: записанная ссылка, объект не закрыт периметром и профилем, у пользователя есть
// право чтения, контрагент или партнёр не физлицо (ИП). Общая проверка объекта контекста и объектов инструментов.
//
// Параметры:
//  Ссылка - ЛюбаяСсылка
//  Причина - Строка - возвращаемый код отказа: BAD_OBJECT (не записан или не ссылка), PERIMETER_VIOLATION
//    (периметр, профиль, физлицо), ACCESS_DENIED (нет права чтения).
//
// Возвращаемое значение:
//  Булево
//
Функция ПроверитьДоступностьОбъекта(Ссылка, Причина = "") Экспорт

	Если Не ЗначениеЗаполнено(Ссылка) Или Не ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Ссылка)) Тогда
		Причина = "BAD_OBJECT";
		Возврат Ложь;
	КонецЕсли;
	ОбъектМетаданных = Ссылка.Метаданные();
	Если ИИА_Периметр.ОбъектЗапрещен(ОбъектМетаданных.ПолноеИмя()) Тогда
		Причина = "PERIMETER_VIOLATION";
		Возврат Ложь;
	КонецЕсли;
	Если Не ПравоДоступа("Чтение", ОбъектМетаданных) Тогда
		Причина = "ACCESS_DENIED";
		Возврат Ложь;
	КонецЕсли;
	Если ИИА_Периметр.ОтметитьСсылки(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ссылка)).Получить(Ссылка) = Истина Тогда
		Причина = "PERIMETER_VIOLATION";
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;

КонецФункции

// Находит в тексте навигационные ссылки на объекты базы (e1cib/data/<Объект>?ref=<32 символа>, в том числе
// с адресом базы перед ними) и заменяет их маркерами. Объект показывается в чате, только если его
// пропускают периметр и права (см. ОписаниеКонтекста); иначе вместо ссылки остаётся пометка.
// Маркеры защищают ссылку от детекторов ПДн (идентификатор похож на секрет); представления подставляет
// ПодставитьОбъектыСсылок.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Структура:
//   * Текст - Строка - текст с маркерами вместо ссылок.
//   * Объекты - Массив из Структура - по одной на ссылку:
//      ** Маркер - Строка
//      ** Текст - Строка - представление объекта или пометка о недоступности.
//      ** Ссылка - Строка - навигационная ссылка доступного объекта, пусто - недоступен.
//      ** Значение - ЛюбаяСсылка, Неопределено - доступный объект.
//      ** Класс - Число - класс данных представления (0 - объект недоступен).
//
Функция РазобратьНавигационныеСсылки(Знач Текст) Экспорт

	Результат = Новый Структура("Текст, Объекты", Текст, Новый Массив);
	Метка = "e1cib/data/";
	НижнийРегистр = НРег(Текст);
	Если СтрНайти(НижнийРегистр, Метка) = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Части = Новый Массив;
	ИндексыСсылок = Новый Соответствие; // навигационная ссылка -> индекс в Объекты
	Начало = 1; // начало ещё не перенесённой части текста
	Поиск = 1;
	Длина = СтрДлина(Текст);
	Пока Поиск <= Длина Цикл
		Найдено = СтрНайти(НижнийРегистр, Метка, , Поиск);
		Если Найдено = 0 Тогда
			Прервать;
		КонецЕсли;
		Поиск = Найдено + СтрДлина(Метка);
		Конец = Поиск;
		Пока Конец <= Длина И СимволИмениМетаданных(Сред(Текст, Конец, 1)) Цикл
			Конец = Конец + 1;
		КонецЦикла;
		ПолноеИмя = Сред(Текст, Поиск, Конец - Поиск);
		Идентификатор = НРег(Сред(Текст, Конец + 5, 32));
		Если ПустаяСтрока(ПолноеИмя) Или НРег(Сред(Текст, Конец, 5)) <> "?ref=" Или Не ЭтоИдентификаторСсылки(Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		Конец = Конец + 37;
		Навигационная = Метка + ПолноеИмя + "?ref=" + Идентификатор;

		// Адрес базы перед ссылкой (http://сервер/база/#e1cib/... или e1c://...#e1cib/...) заменяется вместе с ней.
		НачалоСсылки = Найдено;
		Пока НачалоСсылки > Начало И Не ПустаяСтрока(Сред(Текст, НачалоСсылки - 1, 1))
			И СтрНайти("""'«(<[", Сред(Текст, НачалоСсылки - 1, 1)) = 0 Цикл
			НачалоСсылки = НачалоСсылки - 1;
		КонецЦикла;
		Префикс = Сред(Текст, НачалоСсылки, Найдено - НачалоСсылки);
		Если Не ПустаяСтрока(Префикс) И СтрНайти(Префикс, "://") = 0 И Прав(Префикс, 1) <> "#" Тогда
			НачалоСсылки = Найдено;
		КонецЕсли;

		Индекс = ИндексыСсылок.Получить(Навигационная);
		Если Индекс = Неопределено Тогда
			Если Результат.Объекты.Количество() >= МаксимумСсылокВТексте() Тогда
				Прервать;
			КонецЕсли;
			Результат.Объекты.Добавить(ОбъектНавигационнойСсылки(Навигационная,
				"{{iia-obj-" + Формат(Результат.Объекты.Количество() + 1, "ЧГ=") + "}}"));
			Индекс = Результат.Объекты.ВГраница();
			ИндексыСсылок.Вставить(Навигационная, Индекс);
		КонецЕсли;
		Части.Добавить(Сред(Текст, Начало, НачалоСсылки - Начало));
		Части.Добавить(Результат.Объекты[Индекс].Маркер);
		Начало = Конец;
		Поиск = Конец;
	КонецЦикла;
	Части.Добавить(Сред(Текст, Начало));
	Результат.Текст = СтрСоединить(Части, "");
	Возврат Результат;

КонецФункции

// Подставляет в текст представления объектов вместо маркеров РазобратьНавигационныеСсылки.
//
// Параметры:
//  Текст - Строка
//  Разбор - см. РазобратьНавигационныеСсылки
//
// Возвращаемое значение:
//  Строка
//
Функция ПодставитьОбъектыСсылок(Знач Текст, Разбор) Экспорт

	Для Каждого Объект Из Разбор.Объекты Цикл
		Текст = СтрЗаменить(Текст, Объект.Маркер, Объект.Текст);
	КонецЦикла;
	Возврат Текст;

КонецФункции

// Объект базы по навигационной ссылке e1cib/data/<Объект>?ref=<32 символа>. Права и периметр не проверяются.
//
// Параметры:
//  НавигационнаяСсылка - Строка
//
// Возвращаемое значение:
//  ЛюбаяСсылка, Неопределено - ссылка, в том числе на несуществующий объект; Неопределено - ссылка не разобрана.
//
Функция СсылкаПоНавигационнойСсылке(НавигационнаяСсылка) Экспорт

	Метка = "e1cib/data/";
	Позиция = СтрНайти(НРег(НавигационнаяСсылка), Метка);
	Если Позиция = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Остаток = Сред(НавигационнаяСсылка, Позиция + СтрДлина(Метка));
	Разделитель = СтрНайти(НРег(Остаток), "?ref=");
	Если Разделитель = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Идентификатор = НРег(Сред(Остаток, Разделитель + 5, 32));
	Если Не ЭтоИдентификаторСсылки(Идентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Лев(Остаток, Разделитель - 1));
	Если ОбъектМетаданных = Неопределено Или Не ОбщегоНазначения.ЭтоОбъектСсылочногоТипа(ОбъектМетаданных) Тогда
		Возврат Неопределено;
	КонецЕсли;
	// В ref части GUID переставлены: сначала 4-я и 5-я, затем 3-я, 2-я и 1-я.
	УникальныйИдентификатор = СтрШаблон("%1-%2-%3-%4-%5", Сред(Идентификатор, 25, 8), Сред(Идентификатор, 21, 4),
		Сред(Идентификатор, 17, 4), Сред(Идентификатор, 1, 4), Сред(Идентификатор, 5, 12));
	Попытка
		Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ОбъектМетаданных.ПолноеИмя());
		Возврат Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(УникальныйИдентификатор));
	Исключение
		ЗаписьЖурналаРегистрации("ИИАссистент.Инструменты", УровеньЖурналаРегистрации.Ошибка, , ,
			"NAVIGATION_MANAGER_ERROR");
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Какие из сохранённых в диалоге навигационных ссылок можно показывать сейчас: объект не запрещён периметром,
// у пользователя есть право чтения, объект не физлицо. Используется при восстановлении диалога.
//
// Параметры:
//  НавигационныеСсылки - Массив из Строка
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - навигационная ссылка.
//   * Значение - Булево
//
Функция ДоступныеНавигационныеСсылки(НавигационныеСсылки) Экспорт

	Результат = Новый Соответствие;
	Значения = Новый Соответствие; // навигационная ссылка -> ссылка
	Проверяемые = Новый Массив;
	Для Каждого Навигационная Из НавигационныеСсылки Цикл
		Если ПустаяСтрока(Навигационная) Или Результат.Получить(Навигационная) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Результат.Вставить(Навигационная, Ложь);
		Значение = СсылкаПоНавигационнойСсылке(Навигационная);
		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОбъектМетаданных = Значение.Метаданные();
		Если ИИА_Периметр.ОбъектЗапрещен(ОбъектМетаданных.ПолноеИмя()) Или Не ПравоДоступа("Чтение", ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		Значения.Вставить(Навигационная, Значение);
		Проверяемые.Добавить(Значение);
	КонецЦикла;
	Физлица = ИИА_Периметр.ОтметитьСсылки(Проверяемые);
	Для Каждого КлючИЗначение Из Значения Цикл
		Результат.Вставить(КлючИЗначение.Ключ, Физлица.Получить(КлючИЗначение.Значение) <> Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Возвращает проверенный запрос виртуальной таблицы без чтения бизнес-данных.
//
// Параметры:
//  Аргументы - Соответствие - register, operation, resources; group_by, filters, as_of либо period.from/to.
//  Контекст - ЛюбаяСсылка, Неопределено - текущий объект чата для значения @context.
//
// Возвращаемое значение:
//  Структура - Успех, КодОшибки, Сообщение, ТекстЗапроса, Параметры (Соответствие),
//      ДопустимыеСсылки (Массив), Класс. При ошибке запрос не сформирован.
//
Функция СформироватьЗапросРегистра(Аргументы, Контекст = Неопределено) Экспорт

	Результат = Новый Структура("Успех, КодОшибки, Сообщение, ТекстЗапроса, Параметры, ДопустимыеСсылки, Класс",
		Ложь, "", "", "", Новый Соответствие, Новый Массив, 0);
	Если ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
		Возврат ОшибкаЗапросаРегистра(Результат, "BAD_ARGUMENTS", НСтр("ru = 'Аргументы должны быть объектом.'"));
	КонецЕсли;
	ЕстьДата = Ложь;
	ЕстьПериод = Ложь;
	Для Каждого Аргумент Из Аргументы Цикл
		ЕстьДата = ЕстьДата Или Аргумент.Ключ = "as_of";
		ЕстьПериод = ЕстьПериод Или Аргумент.Ключ = "period";
		Если СтрРазделить("register,operation,resources,group_by,filters,as_of,period", ",").Найти(Аргумент.Ключ) = Неопределено Тогда
			Возврат ОшибкаЗапросаРегистра(Результат, "BAD_ARGUMENTS", НСтр("ru = 'Неизвестный аргумент read_register.'"));
		КонецЕсли;
	КонецЦикла;
	ИмяРегистра = СтрокаАргумента(Аргументы, "register");
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ИмяРегистра);
	Если ОбъектМетаданных = Неопределено Или ОбъектМетаданных.ПолноеИмя() <> ИмяРегистра Тогда
		Возврат ОшибкаЗапросаРегистра(Результат, "NOT_FOUND", НСтр("ru = 'Регистр не найден. Требуется точное полное имя из describe_metadata.'"));
	КонецЕсли;
	Причина = "";
	Если ИИА_Периметр.ОбъектЗапрещен(ИмяРегистра, Причина) Тогда
		Возврат ОшибкаЗапросаРегистра(Результат, "PERIMETER_VIOLATION", НСтр("ru = 'Регистр недоступен в текущем периметре.'"));
	КонецЕсли;
	Если ИИА_ПрофилиДоступа.ИнструментЗапрещенПрофилем("read_register") Тогда
		Возврат ОшибкаЗапросаРегистра(Результат, "TOOL_DISABLED", НСтр("ru = 'Чтение регистров выключено профилем доступа.'"));
	КонецЕсли;
	Результат.Класс = ИИА_КлассыДанных.КлассОбъекта(ИмяРегистра);
	Операция = СтрокаАргумента(Аргументы, "operation");
	Возможности = ВозможностиРегистра(ОбъектМетаданных);
	Возможность = Неопределено;
	Для Каждого ОписаниеОперации Из Возможности Цикл
		Если ОписаниеОперации.operation = Операция Тогда
			Возможность = ОписаниеОперации;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Возможность = Неопределено Тогда
		Возврат ОшибкаЗапросаРегистра(Результат, "REGISTER_OPERATION_UNSUPPORTED",
			НСтр("ru = 'Операция недоступна для этого типа регистра. Возможности указаны в describe_metadata; для бухгалтерии нужны специальные инструменты.'"));
	КонецЕсли;

	ПараметрыТаблицы = ПараметрыПериодаРегистра(Аргументы, Операция, ЕстьДата, ЕстьПериод, Результат);
	Если Не ПустаяСтрока(Результат.КодОшибки) Тогда
		Возврат Результат;
	КонецЕсли;

	Ресурсы = Аргументы.Получить("resources");
	Группировки = Аргументы.Получить("group_by");
	Если Группировки = Неопределено Тогда
		Группировки = Новый Массив;
	КонецЕсли;
	Если Не ПроверитьПоляРегистра(Результат, Ресурсы, ОбъектМетаданных, "Ресурсы", 20, Истина)
		Или Не ПроверитьПоляРегистра(Результат, Группировки, ОбъектМетаданных, "Измерения", 10, Ложь) Тогда
		Возврат Результат;
	КонецЕсли;
	Отборы = Аргументы.Получить("filters");
	Если Отборы = Неопределено Тогда
		Отборы = Новый Соответствие;
	КонецЕсли;
	Если ТипЗнч(Отборы) <> Тип("Соответствие") Или Отборы.Количество() > 20 Тогда
		Возврат ОшибкаЗапросаРегистра(Результат, "BAD_FILTER", НСтр("ru = 'filters должен быть объектом равенств по измерениям, до 20.'"));
	КонецЕсли;
	Условия = Новый Массив;
	Для Каждого Отбор Из Отборы Цикл
		СписокПоля = Новый Массив;
		СписокПоля.Добавить(Отбор.Ключ);
		Если Не ПроверитьПоляРегистра(Результат, СписокПоля, ОбъектМетаданных, "Измерения", 1, Истина) Тогда
			Возврат Результат;
		КонецЕсли;
		ТипЗначения = ТипЗнч(Отбор.Значение);
		Если ТипЗначения <> Тип("Строка") И ТипЗначения <> Тип("Число") И ТипЗначения <> Тип("Булево") Тогда
			Возврат ОшибкаЗапросаРегистра(Результат, "BAD_FILTER", НСтр("ru = 'Значение равенства должно быть строкой, числом или булевым; объекты и массивы недопустимы.'"));
		КонецЕсли;
		Поле = ОбъектМетаданных.Измерения.Найти(Отбор.Ключ);
		Если Отбор.Значение = "@context" Тогда
			Если Контекст = Неопределено Тогда
				Возврат ОшибкаЗапросаРегистра(Результат, "NO_CONTEXT", НСтр("ru = 'В текущем чате нет объекта для @context.'"));
			КонецЕсли;
			ЗначениеОтбора = Контекст;
			Результат.ДопустимыеСсылки.Добавить(Контекст);
		ИначеЕсли ТипЗначения = Тип("Строка") И Поле.Тип.СодержитТип(Тип("Строка")) Тогда
			// Строковое измерение хранит буквальный текст, включая даты и похожие на псевдоним значения.
			ЗначениеОтбора = Отбор.Значение;
		Иначе
			ЗначениеОтбора = ЗначениеПараметра(Отбор.Значение);
			Если ИИА_Периметр.ЭтоМаскируемыйТип(ТипЗнч(ЗначениеОтбора)) Тогда
				Результат.ДопустимыеСсылки.Добавить(ЗначениеОтбора);
			КонецЕсли;
		КонецЕсли;
		Если Не Поле.Тип.СодержитТип(ТипЗнч(ЗначениеОтбора)) Тогда
			Возврат ОшибкаЗапросаРегистра(Результат, "FILTER_TYPE_MISMATCH",
				НСтр("ru = 'Тип значения не подходит измерению. Используйте примитив нужного типа либо текущий @context/псевдоним ссылки.'"));
		КонецЕсли;
		ИмяПараметра = "Отбор" + Строка(Условия.Количество() + 1);
		Результат.Параметры.Вставить(ИмяПараметра, ЗначениеОтбора);
		Условия.Добавить(Поле.Имя + " = &" + ИмяПараметра);
	КонецЦикла;

	ПоляВыбора = Новый Массив;
	ПоляГруппировки = Новый Массив;
	Для Каждого ИмяПоля Из Группировки Цикл
		ПоляВыбора.Добавить("Регистр." + ИмяПоля + " КАК " + ИмяПоля);
		ПоляГруппировки.Добавить("Регистр." + ИмяПоля);
	КонецЦикла;
	Для Каждого ИмяРесурса Из Ресурсы Цикл
		Для Каждого ВиртуальныйРесурс Из Возможность.resources Цикл
			Если ВиртуальныйРесурс.resource <> ИмяРесурса Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого ИмяПоля Из ВиртуальныйРесурс.fields Цикл
				Если Операция = "slice_last" Тогда
					ПоляВыбора.Добавить("Регистр." + ИмяПоля + " КАК " + ИмяПоля);
				Иначе
					ПоляВыбора.Добавить("СУММА(Регистр." + ИмяПоля + ") КАК " + ИмяПоля);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	ТекстЗапроса = "ВЫБРАТЬ" + Символы.ПС + СтрСоединить(ПоляВыбора, "," + Символы.ПС)
		+ Символы.ПС + "ИЗ " + ИмяРегистра + "." + Возможность.virtual_table
		+ "(" + ПараметрыТаблицы + СтрСоединить(Условия, " И ") + ") КАК Регистр";
	Если Операция <> "slice_last" И ПоляГруппировки.Количество() > 0 Тогда
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + "СГРУППИРОВАТЬ ПО " + СтрСоединить(ПоляГруппировки, ", ");
	КонецЕсли;
	Проверка = ИИА_ГраницаЗапроса.ПроверитьЗапрос(ТекстЗапроса, Результат.Параметры, 200, Результат.ДопустимыеСсылки);
	Если Не Проверка.Успех Тогда
		Возврат ОшибкаЗапросаРегистра(Результат, Проверка.КодОшибки, Проверка.Сообщение);
	КонецЕсли;
	Результат.Успех = Истина;
	Результат.ТекстЗапроса = ТекстЗапроса;
	Результат.Класс = Макс(Результат.Класс, Проверка.Класс);
	Возврат Результат;

КонецФункции

// Возвращает единственное значение отбора отчёта по текущему описанию типа поля.
// Поиск ссылок выполняется с правами пользователя и периметром; неоднозначность возвращается как ошибка.
//
// Параметры:
//  ОписаниеТипа - ОписаниеТипов - описание типа разрешённого поля настройки отчёта.
//  Текст - Строка - дата, число, булево, существующий псевдоним, наименование или номер.
//  Ошибки - Массив из Строка - выходные сообщения о недоступности, ошибке поиска или неоднозначности.
//  ИмяПоля - Строка - представление поля для сообщения пользователю.
//
// Возвращаемое значение:
//  Произвольный - распознанное значение, подходящее типу поля; Неопределено при отказе или неоднозначности.
//
Функция ЗначениеОтбора(ОписаниеТипа, Текст, Ошибки, ИмяПоля) Экспорт

	Ссылка = ИИА_Периметр.СсылкаПоПсевдониму(Текст);
	Если Ссылка <> Неопределено И ОписаниеТипа.СодержитТип(ТипЗнч(Ссылка)) Тогда
		Возврат Ссылка;
	КонецЕсли;
	Если ОписаниеТипа.СодержитТип(Тип("Дата")) Тогда
		Дата = ДатаИзСтроки(Текст);
		Если Дата <> Неопределено Тогда
			Возврат Дата;
		КонецЕсли;
	КонецЕсли;
	Если ОписаниеТипа.СодержитТип(Тип("Число")) Тогда
		Попытка
			Возврат Число(СтрЗаменить(Текст, ",", ".")); // BSLLS:TryNumber-off
		// Текст может принадлежать другому разрешённому типу составного поля.
		Исключение // BSLLS:MissingCodeTryCatchEx-off
			// не число - пробуем другие типы
		КонецПопытки;
	КонецЕсли;
	Если ОписаниеТипа.СодержитТип(Тип("Булево")) И (НРег(Текст) = "true" Или НРег(Текст) = "false") Тогда
		Возврат НРег(Текст) = "true";
	КонецЕсли;

	Кандидаты = Новый Массив;
	ТекстыЗапросов = Новый Массив;
	Для Каждого ТипПоля Из ОписаниеТипа.Типы() Цикл
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипПоля);
		Если ОбъектМетаданных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
		Если ИИА_Периметр.ОбъектЗапрещен(ПолноеИмя) Или ИИА_Периметр.ТипЗапрещен(ТипПоля) Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Отбор по полю %1 недоступен ассистенту'"), ИмяПоля));
			Возврат Неопределено;
		КонецЕсли;
		Если Метаданные.Перечисления.Содержит(ОбъектМетаданных) Тогда
			Для Каждого ЗначениеПеречисления Из ОбъектМетаданных.ЗначенияПеречисления Цикл
				Если СтрНайти(НРег(ЗначениеПеречисления.Синоним), НРег(Текст)) > 0 Тогда
					Кандидаты.Добавить(Перечисления[ОбъектМетаданных.Имя][ЗначениеПеречисления.Имя]);
				КонецЕсли;
			КонецЦикла;
			Продолжить;
		КонецЕсли;
		ЭтоДокумент = Метаданные.Документы.Содержит(ОбъектМетаданных);
		Если Не ЭтоДокумент И Не Метаданные.Справочники.Содержит(ОбъектМетаданных)
			И Не Метаданные.ПланыВидовХарактеристик.Содержит(ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		// Индексатор после Содержит даёт объект конкретной коллекции без nullable-типа.
		Если ЭтоДокумент Тогда
			ОбъектЧтения = Метаданные.Документы[ОбъектМетаданных.Имя];
		ИначеЕсли Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
			ОбъектЧтения = Метаданные.Справочники[ОбъектМетаданных.Имя];
		Иначе
			ОбъектЧтения = Метаданные.ПланыВидовХарактеристик[ОбъектМетаданных.Имя];
		КонецЕсли;
		Если Не ПравоДоступа("Чтение", ОбъектЧтения) Тогда
			Продолжить;
		КонецЕсли;
		// Источник из разрешённых метаданных; условие выбирается из двух фиксированных строк.
		// BSLLS:QueryParseError-off
		ТекстыЗапросов.Добавить(СтрШаблон(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 3 Т.Ссылка КАК Ссылка ИЗ %1 КАК Т ГДЕ НЕ Т.ПометкаУдаления И %2",
			ПолноеИмя, ?(ЭтоДокумент, "Т.Номер = &Текст", "Т.Наименование ПОДОБНО &Подобно СПЕЦСИМВОЛ ""~""")));
		// BSLLS:QueryParseError-on
	КонецЦикла;

	Если ТекстыЗапросов.Количество() > 0 Тогда
		Запрос = Новый Запрос(СтрСоединить(ТекстыЗапросов, ";" + Символы.ПС));
		Запрос.УстановитьПараметр("Текст", Текст);
		Запрос.УстановитьПараметр("Подобно", "%" + ЭкранироватьПодобно(Текст) + "%");
		Попытка
			РезультатыПакета = Запрос.ВыполнитьПакет();
		Исключение
			// Частичный пул не доказывает уникальность: при сбое любого источника весь поиск закрыт.
			ЗаписьЖурналаРегистрации("ИИАссистент.Инструменты", УровеньЖурналаРегистрации.Ошибка, , ,
				"REPORT_FILTER_LOOKUP_ERROR");
			Ошибки.Добавить(НСтр("ru = 'Не удалось получить значение отбора. Повторите запрос или уточните настройки отчёта.'"));
			Возврат Неопределено;
		КонецПопытки;
		Для Каждого РезультатЗапроса Из РезультатыПакета Цикл
			Найденные = РезультатЗапроса.Выгрузить();
			Для Каждого Найденный Из Найденные Цикл
				Кандидаты.Добавить(Найденный.Ссылка);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	Если Кандидаты.Количество() = 1 Тогда
		Возврат Кандидаты[0];
	ИначеЕсли Кандидаты.Количество() = 0 Тогда
		Ошибки.Добавить(СтрШаблон(НСтр("ru = '%1: значение «%2» не найдено'"), ИмяПоля, Текст));
	Иначе
		Представления = Новый Массив;
		ФизлицаСредиСсылок = ИИА_Маскирование.ОтметитьСсылки(Кандидаты);
		Регистрация = Новый Соответствие;
		Для Каждого Кандидат Из Кандидаты Цикл
			Представления.Добавить(ИИА_Маскирование.ЗначениеДляМодели(Кандидат, ФизлицаСредиСсылок, , Регистрация));
		КонецЦикла;
		ИИА_Маскирование.ЗаписатьПсевдонимы(Регистрация);
		Ошибки.Добавить(СтрШаблон(НСтр("ru = '%1: «%2» неоднозначно (%3) - уточни у пользователя'"), ИмяПоля, Текст,
			СтрСоединить(Представления, "; ")));
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Объект для РазобратьНавигационныеСсылки: представление - только у объекта, который пропускают периметр и права.
Функция ОбъектНавигационнойСсылки(НавигационнаяСсылка, Маркер)

	Результат = Новый Структура("Маркер, Текст, Ссылка, Значение, Класс", Маркер,
		НСтр("ru = '[объект недоступен ассистенту]'"), "", Неопределено, 0);
	Значение = СсылкаПоНавигационнойСсылке(НавигационнаяСсылка);
	Если Значение = Неопределено Тогда
		Результат.Текст = НСтр("ru = '[ссылка на неизвестный объект]'");
		Возврат Результат;
	КонецЕсли;
	Описание = ОписаниеКонтекста(Значение);
	Если Не Описание.Успех Или ПустаяСтрока(Описание.Представление) Тогда
		Возврат Результат;
	КонецЕсли;
	Попытка
		Ссылка = ПолучитьНавигационнуюСсылку(Значение);
	// Не каждый тип поддерживает навигацию; значение уже проверено и остаётся без ссылки.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Ссылка = "";
	КонецПопытки;
	Если ПустаяСтрока(Ссылка) Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.Текст = Строка(Описание.Представление);
	Результат.Ссылка = Ссылка;
	Результат.Значение = Значение;
	Результат.Класс = ИИА_КлассыДанных.ПодтвержденныйКласс(Описание.Класс);
	Возврат Результат;

КонецФункции

Функция СимволИмениМетаданных(Символ)

	Возврат Символ = "." Или Символ = "_" Или СтрНайти("0123456789", Символ) > 0 Или ВРег(Символ) <> НРег(Символ);

КонецФункции

Функция ЭтоИдентификаторСсылки(Строка)

	Если СтрДлина(Строка) <> 32 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По 32 Цикл
		Если СтрНайти("0123456789abcdef", Сред(Строка, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция МаксимумСсылокВТексте()

	Возврат 10;

КонецФункции

Функция ЕстьСтандартныйРеквизит(ОбъектМетаданных, Имя)

	СтандартныеРеквизиты = КоллекцияМетаданных(ОбъектМетаданных, "СтандартныеРеквизиты");
	Если СтандартныеРеквизиты = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Реквизит Из СтандартныеРеквизиты Цикл
		Если Реквизит.Имя = Имя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#Область Метаданные

Функция НайтиМетаданные(Результат, Текст)

	Если СтрДлина(СокрЛП(Текст)) < 3 Тогда
		Возврат Отказ(Результат, "BAD_ARGUMENTS", НСтр("ru = 'Укажите не менее 3 символов.'"));
	КонецЕсли;

	Найденные = ИИА_Знания.НайтиВКаталогеМетаданных(Текст, 30);
	Результат.Успех = Истина;
	Результат.Итог = "OK";
	Результат.Строк = Найденные.Количество();
	Результат.Данные = Новый Структура("objects", Найденные);
	Возврат Результат;

КонецФункции

Функция ОписатьМетаданные(Результат, ПолноеИмя)

	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Отказ(Результат, "NOT_FOUND", СтрШаблон(НСтр("ru = 'Объект %1 не найден.'"), ПолноеИмя));
	КонецЕсли;

	Причина = "";
	Если ИИА_Периметр.ОбъектЗапрещен(ОбъектМетаданных.ПолноеИмя(), Причина) Тогда
		Возврат Отказ(Результат, "PERIMETER_VIOLATION",
			СтрШаблон(НСтр("ru = 'Объект %1 вне периметра ассистента (%2).'"), ОбъектМетаданных.ПолноеИмя(), Причина));
	КонецЕсли;

	ПолноеИмяОбъекта = ОбъектМетаданных.ПолноеИмя();
	Описание = Новый Структура;
	Описание.Вставить("name", ПолноеИмяОбъекта);
	Описание.Вставить("synonym", ОбъектМетаданных.Синоним);
	Описание.Вставить("comment", ОбъектМетаданных.Комментарий);
	// Закрытые поля не выдаются, но перечисляются: модель должна знать, что разрез недоступен, и не искать обход.
	Скрытые = Новый Массив;
	Для Каждого ИмяКоллекции Из СтрРазделить("Реквизиты,Измерения,Ресурсы", ",") Цикл
		Коллекция = КоллекцияМетаданных(ОбъектМетаданных, ИмяКоллекции);
		Если Коллекция <> Неопределено Тогда
			Описание.Вставить(КлючКоллекции(ИмяКоллекции), ОписанияПолей(ПолноеИмяОбъекта, "", Коллекция, Скрытые));
		КонецЕсли;
	КонецЦикла;
	ТабличныеЧасти = КоллекцияМетаданных(ОбъектМетаданных, "ТабличныеЧасти");
	Если ТабличныеЧасти <> Неопределено Тогда
		Описания = Новый Массив;
		Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
			Описания.Добавить(Новый Структура("name, synonym, columns", ТабличнаяЧасть.Имя, ТабличнаяЧасть.Синоним,
				ОписанияПолей(ПолноеИмяОбъекта, ТабличнаяЧасть.Имя + ".", ТабличнаяЧасть.Реквизиты, Скрытые)));
		КонецЦикла;
		Описание.Вставить("tabular_sections", Описания);
	КонецЕсли;
	Если Скрытые.Количество() > 0 Тогда
		Описание.Вставить("hidden_fields", Скрытые);
		Описание.Вставить("hidden_note", НСтр("ru = 'Поля hidden_fields закрыты периметром данных (персональные данные, пользователи, кадры и т.п.). Разрезы и отборы по ним недоступны любыми способами - сообщи об этом пользователю и предложи доступную альтернативу.'"));
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.Итог = "OK";
	Описание.Вставить("register_capabilities", ВозможностиРегистра(ОбъектМетаданных));
	Результат.Данные = Описание;
	Возврат Результат;

КонецФункции

Функция ОписанияПолей(ПолноеИмяОбъекта, Префикс, Коллекция, Скрытые = Неопределено)

	Поля = Новый Массив;
	Для Каждого Поле Из Коллекция Цикл
		Причина = "";
		Если ИИА_Периметр.ПолеЗапрещено(ПолноеИмяОбъекта, Префикс + Поле.Имя, Причина) Тогда
			Если Скрытые <> Неопределено Тогда
				Скрытые.Добавить(Новый Структура("name, synonym, reason", Префикс + Поле.Имя, Поле.Синоним, Причина));
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Типы = Новый Массив;
		Для Каждого ТипПоля Из Поле.Тип.Типы() Цикл
			ОбъектТипа = Метаданные.НайтиПоТипу(ТипПоля);
			Типы.Добавить(?(ОбъектТипа = Неопределено, Строка(ТипПоля), ОбъектТипа.ПолноеИмя()));
		КонецЦикла;
		Поля.Добавить(Новый Структура("name, synonym, types", Поле.Имя, Поле.Синоним, Типы));
	КонецЦикла;
	Возврат Поля;

КонецФункции

Функция КлючКоллекции(ИмяКоллекции)

	Если ИмяКоллекции = "Реквизиты" Тогда
		Возврат "attributes";
	ИначеЕсли ИмяКоллекции = "Измерения" Тогда
		Возврат "dimensions";
	КонецЕсли;
	Возврат "resources";

КонецФункции

Функция КоллекцияМетаданных(ОбъектМетаданных, ИмяКоллекции)

	Попытка
		Возврат ОбъектМетаданных[ИмяКоллекции];
	// Коллекции реквизитов/измерений доступны не у всех видов метаданных.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область Запрос

// Проверяет обязательные границы и заполняет только параметры Дата для виртуальной таблицы.
Функция ПараметрыПериодаРегистра(Аргументы, Операция, ЕстьДата, ЕстьПериод, Результат)

	Если ЕстьДата И ЕстьПериод Тогда
		ОшибкаЗапросаРегистра(Результат, "BAD_PERIOD", НСтр("ru = 'as_of и period несовместимы.'"));
		Возврат "";
	КонецЕсли;
	Если Операция = "turnovers" Тогда
		ПериодРегистра = Аргументы.Получить("period");
		Если ТипЗнч(ПериодРегистра) <> Тип("Соответствие") Тогда
			ОшибкаЗапросаРегистра(Результат, "PERIOD_REQUIRED", НСтр("ru = 'Для оборотов обязателен period с from и to.'"));
			Возврат "";
		КонецЕсли;
		Если ПериодРегистра.Количество() <> 2 Тогда
			ОшибкаЗапросаРегистра(Результат, "BAD_PERIOD", НСтр("ru = 'period должен содержать только from и to.'"));
			Возврат "";
		КонецЕсли;
		НачалоКорректно = Ложь;
		КонецКорректен = Ложь;
		НачалоПериода = ДатаДняРегистра(ПериодРегистра.Получить("from"), НачалоКорректно);
		КонецПериода = ДатаДняРегистра(ПериодРегистра.Получить("to"), КонецКорректен);
		Если Не НачалоКорректно Или Не КонецКорректен Тогда
			ОшибкаЗапросаРегистра(Результат, "BAD_PERIOD", НСтр("ru = 'from и to должны быть существующими датами ГГГГ-ММ-ДД.'"));
			Возврат "";
		КонецЕсли;
		Если НачалоПериода > КонецПериода Тогда
			ОшибкаЗапросаРегистра(Результат, "BAD_PERIOD", НСтр("ru = 'Начало периода позже окончания.'"));
			Возврат "";
		КонецЕсли;
		Результат.Параметры.Вставить("НачалоПериода", НачалоДня(НачалоПериода));
		Результат.Параметры.Вставить("КонецПериода", КонецДня(КонецПериода));
		ПараметрыТаблицы = "&НачалоПериода, &КонецПериода, , ";
	Иначе
		Если Аргументы.Получить("as_of") = Неопределено Или Аргументы.Получить("period") <> Неопределено Тогда
			ОшибкаЗапросаРегистра(Результат, "PERIOD_REQUIRED", НСтр("ru = 'Для остатков и среза обязателен as_of, без period.'"));
			Возврат "";
		КонецЕсли;
		ДатаКорректна = Ложь;
		ДатаСреза = ДатаДняРегистра(Аргументы.Получить("as_of"), ДатаКорректна);
		Если Не ДатаКорректна Тогда
			ОшибкаЗапросаРегистра(Результат, "BAD_PERIOD", НСтр("ru = 'as_of должен быть существующей датой ГГГГ-ММ-ДД.'"));
			Возврат "";
		КонецЕсли;
		Если Операция = "balances" Тогда
			Если Год(ДатаСреза) >= 3999 И Месяц(ДатаСреза) = 12 И День(ДатаСреза) = 31 Тогда
				ОшибкаЗапросаРегистра(Результат, "BAD_PERIOD", НСтр("ru = 'Для остатков дата должна быть раньше 3999-12-31.'"));
				Возврат "";
			КонецЕсли;
			// Дата в Остатки исключает граничное значение: следующий день включает все секунды нужного дня.
			Результат.Параметры.Вставить("Момент", НачалоДня(ДатаСреза) + 86400);
		Иначе
			Результат.Параметры.Вставить("Момент", КонецДня(ДатаСреза));
		КонецЕсли;
		ПараметрыТаблицы = "&Момент, ";
	КонецЕсли;
	Возврат ПараметрыТаблицы;

КонецФункции

Функция ПрочитатьРегистр(Результат, Аргументы, Контекст)

	ЗапросРегистра = СформироватьЗапросРегистра(Аргументы, Контекст);
	Если Не ЗапросРегистра.Успех Тогда
		Возврат Отказ(Результат, ЗапросРегистра.КодОшибки, ЗапросРегистра.Сообщение);
	КонецЕсли;
	ВыполнитьЗапрос(Результат, ЗапросРегистра.ТекстЗапроса, ЗапросРегистра.Параметры, Контекст, Истина);
	// Фильтр влияет на раскрываемые данные, даже если его поле не выбрано и совпало с ключевым словом лексера.
	Результат.Класс = Макс(Результат.Класс, ЗапросРегистра.Класс);
	Возврат Результат;

КонецФункции

Функция ВозможностиРегистра(ОбъектМетаданных)

	Операции = Новый Массив;
	Возможности = Новый Массив;
	ИмяРегистра = ОбъектМетаданных.ПолноеИмя();
	ЭтоНакопление = СтрНачинаетсяС(ИмяРегистра, "РегистрНакопления.");
	ЭтоОстатки = Ложь;
	Если ЭтоНакопление Тогда
		ЭтоОстатки = ОбъектМетаданных.ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки;
		Если ЭтоОстатки Тогда
			Операции.Добавить(Новый Структура("operation, virtual_table", "balances", "Остатки"));
		КонецЕсли;
		Операции.Добавить(Новый Структура("operation, virtual_table", "turnovers", "Обороты"));
	ИначеЕсли СтрНачинаетсяС(ИмяРегистра, "РегистрСведений.") Тогда
		Если ОбъектМетаданных.ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
			Операции.Добавить(Новый Структура("operation, virtual_table", "slice_last", "СрезПоследних"));
		КонецЕсли;
	КонецЕсли;
	Для Каждого ОписаниеОперации Из Операции Цикл
		Ресурсы = Новый Массив;
		Для Каждого Ресурс Из ОбъектМетаданных.Ресурсы Цикл
			Причина = "";
			Если ИИА_Периметр.ПолеЗапрещено(ИмяРегистра, Ресурс.Имя, Причина) Тогда
				Продолжить;
			КонецЕсли;
			ВиртуальныеПоля = Новый Массив;
			Если ОписаниеОперации.operation = "balances" Тогда
				ВиртуальныеПоля.Добавить(Ресурс.Имя + "Остаток");
			ИначеЕсли ОписаниеОперации.operation = "turnovers" Тогда
				ВиртуальныеПоля.Добавить(Ресурс.Имя + "Оборот");
				Если ЭтоОстатки Тогда
					ВиртуальныеПоля.Добавить(Ресурс.Имя + "Приход");
					ВиртуальныеПоля.Добавить(Ресурс.Имя + "Расход");
				КонецЕсли;
			Иначе
				ВиртуальныеПоля.Добавить(Ресурс.Имя);
			КонецЕсли;
			Ресурсы.Добавить(Новый Структура("resource, fields", Ресурс.Имя, ВиртуальныеПоля));
		КонецЦикла;
		ОписаниеОперации.Вставить("resources", Ресурсы);
		ОписаниеОперации.Вставить("date_argument", ?(ОписаниеОперации.operation = "turnovers", "period.from/to", "as_of"));
		ОписаниеОперации.Вставить("date_semantics", "YYYY-MM-DD; полные дни включительно, календарный период не заменяется измерением");
		ОписаниеОперации.Вставить("filter_fields", ОписанияПолей(ИмяРегистра, "", ОбъектМетаданных.Измерения));
		ОписаниеОперации.Вставить("group_fields", ОписаниеОперации.filter_fields);
		Возможности.Добавить(ОписаниеОперации);
	КонецЦикла;
	Возврат Возможности;

КонецФункции

Функция ОшибкаЗапросаРегистра(Результат, Код, Сообщение)

	Результат.КодОшибки = Код;
	Результат.Сообщение = Сообщение;
	Возврат Результат;

КонецФункции

// Возвращает дату фиксированного типа; значение можно использовать только при ДатаКорректна = Истина.
// При некорректном входе пустая дата не попадает в запрос: вызывающая функция возвращает BAD_PERIOD.
Функция ДатаДняРегистра(Значение, ДатаКорректна)

	ДатаКорректна = Ложь;

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Если СтрДлина(Значение) <> 10 Или Сред(Значение, 5, 1) <> "-" Или Сред(Значение, 8, 1) <> "-" Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Цифры = СтрЗаменить(Значение, "-", "");
	Для Индекс = 1 По СтрДлина(Цифры) Цикл
		Если СтрНайти("0123456789", Сред(Цифры, Индекс, 1)) = 0 Тогда
			Возврат Дата(1, 1, 1);
		КонецЕсли;
	КонецЦикла;
	Если СтрДлина(Цифры) <> 8 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Если ДатаИзСтроки(Значение) = Неопределено Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	// Предыдущая проверка использует тот же конструктор: повторное преобразование сохраняет строгий тип Дата.
	ДатаКорректна = Истина;
	Возврат Дата(Цифры + "000000");

КонецФункции

Функция ПроверитьПоляРегистра(Результат, Поля, ОбъектМетаданных, ИмяКоллекции, Лимит, Обязательны)

	Если ТипЗнч(Поля) <> Тип("Массив") Тогда
		ОшибкаЗапросаРегистра(Результат, "BAD_FIELD", НСтр("ru = 'resources и group_by должны быть массивами точных имён полей.'"));
		Возврат Ложь;
	КонецЕсли;
	Если Поля.Количество() > Лимит Или (Обязательны И Поля.Количество() = 0) Тогда
		ОшибкаЗапросаРегистра(Результат, "BAD_FIELD", НСтр("ru = 'Список полей пуст или превышает допустимый размер.'"));
		Возврат Ложь;
	КонецЕсли;
	Коллекция = КоллекцияМетаданных(ОбъектМетаданных, ИмяКоллекции);
	Проверенные = Новый Массив;
	Для Каждого ИмяПоля Из Поля Цикл
		Если ТипЗнч(ИмяПоля) <> Тип("Строка") Тогда
			ОшибкаЗапросаРегистра(Результат, "BAD_FIELD", НСтр("ru = 'Имя поля должно быть строкой.'"));
			Возврат Ложь;
		КонецЕсли;
		Поле = Коллекция.Найти(ИмяПоля);
		Если Поле = Неопределено Или Поле.Имя <> ИмяПоля Или Проверенные.Найти(ИмяПоля) <> Неопределено Тогда
			ОшибкаЗапросаРегистра(Результат, "BAD_FIELD",
				НСтр("ru = 'Поле отсутствует в нужной коллекции метаданных или повторяется. Используйте resources/group_by из describe_metadata.'"));
			Возврат Ложь;
		КонецЕсли;
		Причина = "";
		Если ИИА_Периметр.ПолеЗапрещено(ОбъектМетаданных.ПолноеИмя(), Поле.Имя, Причина) Тогда
			ОшибкаЗапросаРегистра(Результат, "PERIMETER_VIOLATION", НСтр("ru = 'Выбранное поле недоступно в текущем периметре.'"));
			Возврат Ложь;
		КонецЕсли;
		Если ИмяКоллекции = "Ресурсы" И СтрНачинаетсяС(ОбъектМетаданных.ПолноеИмя(), "РегистрНакопления.")
			И Не Поле.Тип.СодержитТип(Тип("Число")) Тогда
			ОшибкаЗапросаРегистра(Результат, "BAD_FIELD", НСтр("ru = 'Для суммирования требуется числовой ресурс.'"));
			Возврат Ложь;
		КонецЕсли;
		Результат.Класс = Макс(Результат.Класс, ИИА_КлассыДанных.КлассОбъекта(ОбъектМетаданных.ПолноеИмя(), Поле.Имя));
		Проверенные.Добавить(ИмяПоля);
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ВыполнитьЗапрос(Результат, ТекстЗапроса, ПараметрыJSON, Контекст = Неопределено, Подготовленные = Ложь)

	Если ПустаяСтрока(ТекстЗапроса) Тогда
		Возврат Отказ(Результат, "BAD_ARGUMENTS", НСтр("ru = 'Пустой текст запроса.'"));
	КонецЕсли;

	Если ПараметрыJSON <> Неопределено И ТипЗнч(ПараметрыJSON) <> Тип("Соответствие") Тогда
		Возврат Отказ(Результат, "BAD_ARGUMENTS", НСтр("ru = 'parameters должен быть объектом параметров.'"));
	КонецЕсли;
	ПараметрыЗапроса = Новый Структура;
	ИменаПараметров = Новый Соответствие;
	Если ТипЗнч(ПараметрыJSON) = Тип("Соответствие") Тогда
		Для Каждого КлючИЗначение Из ПараметрыJSON Цикл
			Если ТипЗнч(КлючИЗначение.Ключ) <> Тип("Строка") Тогда
				Возврат Отказ(Результат, "BAD_ARGUMENTS", НСтр("ru = 'Имена параметров должны быть строками.'"));
			КонецЕсли;
			ИмяПараметра = ВРег(КлючИЗначение.Ключ);
			Если ИменаПараметров.Получить(ИмяПараметра) <> Неопределено Тогда
				Возврат Отказ(Результат, "DUPLICATE_QUERY_PARAMETER",
					НСтр("ru = 'Параметр передан повторно с разным регистром букв. Оставьте одно значение в parameters.'"));
			КонецЕсли;
			ИменаПараметров.Вставить(ИмяПараметра, Истина);
			Если Подготовленные Тогда
				ЗначениеЗапроса = КлючИЗначение.Значение;
			ИначеЕсли КлючИЗначение.Значение = "@context" Тогда
				Если Контекст = Неопределено Тогда
					Возврат Отказ(Результат, "NO_CONTEXT", НСтр("ru = 'Чат открыт не из объекта: значение @context недоступно.'"));
				КонецЕсли;
				ЗначениеЗапроса = Контекст;
			Иначе
				Попытка
					ЗначениеЗапроса = ЗначениеПараметра(КлючИЗначение.Значение);
				Исключение
					ЗаписьЖурналаРегистрации("ИИАссистент.Инструменты", УровеньЖурналаРегистрации.Ошибка, , ,
						"QUERY_PARAMETER_CONVERSION_ERROR");
					Возврат Отказ(Результат, "PARAMETER_CONVERSION_ERROR",
						НСтр("ru = 'Не удалось подготовить значение параметра запроса.'"));
				КонецПопытки;
			КонецЕсли;
			Попытка
				ПараметрыЗапроса.Вставить(КлючИЗначение.Ключ, ЗначениеЗапроса);
			Исключение
				ЗаписьЖурналаРегистрации("ИИАссистент.Инструменты", УровеньЖурналаРегистрации.Ошибка, , ,
					"QUERY_PARAMETER_NAME_ERROR");
				Возврат Отказ(Результат, "BAD_ARGUMENTS", НСтр("ru = 'Недопустимое имя параметра запроса.'"));
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;

	ДопустимыеСсылки = Новый Массив;
	Если Контекст <> Неопределено Тогда
		ДопустимыеСсылки.Добавить(Контекст);
	КонецЕсли;
	// Ссылки, полученные из псевдонимов (ПДн и коммерческих), допустимы как параметры: из строк модели
	// ЗначениеПараметра делает ссылку только по псевдониму.
	Для Каждого КлючИЗначение Из ПараметрыЗапроса Цикл
		Значения = ?(ТипЗнч(КлючИЗначение.Значение) = Тип("Массив"), КлючИЗначение.Значение, Новый Массив);
		Если ТипЗнч(КлючИЗначение.Значение) <> Тип("Массив") Тогда
			Значения.Добавить(КлючИЗначение.Значение);
		КонецЕсли;
		Для Каждого Значение Из Значения Цикл
			Если Значение = Неопределено Или Значение = Контекст Тогда
				Продолжить;
			КонецЕсли;
			ТипЗначения = ТипЗнч(Значение);
			// Из строк модели ЗначениеПараметра делает ссылку только по псевдониму; подготовленные параметры
			// кода (Подготовленные) допускают только маскируемые типы, как до коммерческого маскирования.
			Если Не Подготовленные И ОбщегоНазначения.ЭтоСсылка(ТипЗначения)
				Или ИИА_Периметр.ЭтоМаскируемыйТип(ТипЗначения) Или ИИА_Маскирование.ЭтоКоммерческийТип(ТипЗначения) Тогда
				ДопустимыеСсылки.Добавить(Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Выполнение = ИИА_ГраницаЗапроса.ВыполнитьЗапросАгента(ТекстЗапроса, ПараметрыЗапроса, 200,
		?(ДопустимыеСсылки.Количество() = 0, Неопределено, ДопустимыеСсылки));
	Если Не Выполнение.Успех Тогда
		Отказ(Результат, Выполнение.КодОшибки, Выполнение.Сообщение);
		Результат.Данные.Вставить("missing_parameters", Выполнение.НедостающиеПараметры);
		Результат.Данные.Вставить("unused_parameters", Выполнение.ЛишниеПараметры);
		Возврат Результат;
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.Итог = "OK";
	Результат.Строк = Выполнение.Строки.Количество();
	Результат.Скрыто = Выполнение.Скрыто;
	Результат.Класс = Выполнение.Класс;
	Результат.ИсточникиСписков = Выполнение.Таблицы;
	Результат.Таблица = Новый Структура("Колонки, Строки, Объекты, ОбъектыЯчеек",
		Выполнение.Колонки, Выполнение.Строки, Выполнение.Объекты, Выполнение.ОбъектыЯчеек);
	Результат.Данные = Новый Структура("columns, rows, truncated, hidden_values",
		Выполнение.Колонки, Выполнение.Строки, Выполнение.Усечено, Выполнение.Скрыто);
	Возврат Результат;

КонецФункции

// Значения параметров из JSON: строки вида ГГГГ-ММ-ДД превращаются в даты, массивы - в массивы примитивов.
Функция ЗначениеПараметра(Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Массив = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Массив.Добавить(ЗначениеПараметра(Элемент));
		КонецЦикла;
		Возврат Массив;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		// Псевдоним маскируемого объекта (например, пользователя) превращается обратно в ссылку.
		Ссылка = ИИА_Периметр.СсылкаПоПсевдониму(Значение);
		Если Ссылка <> Неопределено Тогда
			Возврат Ссылка;
		КонецЕсли;
		Дата = ДатаИзСтроки(Значение);
		Возврат ?(Дата = Неопределено, Значение, Дата);
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Или ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Неопределено; // объекты и прочее не превращаем в ссылки

КонецФункции

Функция ДатаИзСтроки(Строка)

	Корректна = Ложь;
	ДатаПараметра = ПрочитатьДатуИзСтроки(Строка, Корректна);
	Возврат ?(Корректна, ДатаПараметра, Неопределено);

КонецФункции

// Возвращает Дата строго фиксированного типа; Корректна отличает разобранное значение от ошибки.
// Прежний формат: ISO или пробел вместо T, первые 19 символов, отсутствующее время - начало дня.
Функция ПрочитатьДатуИзСтроки(Строка, Корректна)

	Корректна = Ложь;
	Если СтрДлина(Строка) < 10 Или Сред(Строка, 5, 1) <> "-" Или Сред(Строка, 8, 1) <> "-" Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Цифры = СтрЗаменить(СтрЗаменить(СтрЗаменить(Лев(Строка, 19), "-", ""), "T", ""), ":", "");
	Цифры = СтрЗаменить(Цифры, " ", "");
	Попытка
		ДатаПараметра = Дата(Лев(Цифры + "000000", 14));
	// Некорректная входная дата возвращается с Корректна = Ложь.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат Дата(1, 1, 1);
	КонецПопытки;
	Корректна = Истина;
	Возврат ДатаПараметра;

КонецФункции

#КонецОбласти

#Область Отчеты

Функция НайтиОтчет(Результат, Текст)

	Если Не ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ВариантыОтчетов") Тогда
		Возврат Отказ(Результат, "NOT_SUPPORTED", НСтр("ru = 'В конфигурации нет подсистемы вариантов отчётов.'"));
	КонецЕсли;
	МодульВариантыОтчетов = ОбщегоНазначения.ОбщийМодуль("ВариантыОтчетов");

	// Курируемые отчёты (план, раздел 6.2); общий мост БСП - все доступные пользователю отчёты вне запретов
	// периметра, включается администратором (этап 2).
	Карточки = КарточкиОтчетов();
	ДоступныеОтчеты = МодульВариантыОтчетов.ОтчетыТекущегоПользователя();
	ОбщийМост = ОбщийМостВключен();
	СписокОтчетов = Новый Массив;
	Если ОбщийМост Тогда
		Для Каждого Отчет Из ДоступныеОтчеты Цикл
			СписокОтчетов.Добавить(Отчет);
		КонецЦикла;
	КонецЕсли;
	Для Каждого Карточка Из Карточки Цикл
		Если Карточка.Значение.Отчет <> Неопределено И ДоступныеОтчеты.Найти(Карточка.Значение.Отчет) <> Неопределено
			И СписокОтчетов.Найти(Карточка.Значение.Отчет) = Неопределено Тогда
			СписокОтчетов.Добавить(Карточка.Значение.Отчет);
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 3000
	|	Варианты.Ссылка КАК Ссылка,
	|	Варианты.Наименование КАК Наименование,
	|	Варианты.Отчет КАК Отчет
	|ИЗ
	|	Справочник.ВариантыОтчетов КАК Варианты
	|ГДЕ
	|	Варианты.Отчет В(&Отчеты)
	|	И НЕ Варианты.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Варианты.Наименование";
	Запрос.УстановитьПараметр("Отчеты", СписокОтчетов);

	Слова = СтрРазделить(НРег(СокрЛП(Текст)), " ", Ложь);
	Курируемые = Новый Массив;
	Прочие = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбъектМетаданных = ОбъектМетаданныхОтчета(Выборка.Отчет);
		Если ОбъектМетаданных = Неопределено Или ОтчетВнеПериметра(ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		Карточка = Карточки.Получить(ОбъектМетаданных.Имя);
		Назначение = ?(Карточка = Неопределено, "", Карточка.Назначение);
		ТекстПоиска = НРег(Выборка.Наименование + " " + ОбъектМетаданных.Синоним + " " + Назначение);
		Подходит = Истина;
		Для Каждого Слово Из Слова Цикл
			Если СтрНайти(ТекстПоиска, Слово) = 0 Тогда
				Подходит = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не Подходит Тогда
			Продолжить;
		КонецЕсли;
		Описание = Новый Структура("variant_id, name, report, when, curated",
			Строка(Выборка.Ссылка.УникальныйИдентификатор()), Выборка.Наименование, ОбъектМетаданных.Синоним,
			Назначение, Карточка <> Неопределено);
		Если Карточка <> Неопределено Тогда
			Курируемые.Добавить(Описание);
		ИначеЕсли Прочие.Количество() < 30 Тогда
			Прочие.Добавить(Описание);
		КонецЕсли;
	КонецЦикла;

	Найденные = Новый Массив;
	Для Каждого Описание Из Курируемые Цикл
		Найденные.Добавить(Описание);
	КонецЦикла;
	Для Каждого Описание Из Прочие Цикл
		Если Найденные.Количество() >= 30 Тогда
			Прервать;
		КонецЕсли;
		Найденные.Добавить(Описание);
	КонецЦикла;

	Результат.Успех = Истина;
	Результат.Итог = "OK";
	Результат.Строк = Найденные.Количество();
	Результат.Класс = 0;
	Результат.Данные = Новый Структура("variants", Найденные);
	Возврат Результат;

КонецФункции

// Карточки курируемых отчётов из справочника ИИА_КарточкиОтчетов (используемые, без пометки удаления).
// Поставляемые карточки заполняются при обновлении ИБ из общего макета ИИА_КарточкиОтчетов.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - имя отчёта в метаданных.
//   * Значение - Структура:
//    ** Назначение - Строка - когда применять отчёт.
//    ** Отчет - СправочникСсылка.ИдентификаторыОбъектовМетаданных, Неопределено - если отчёта нет в конфигурации.
//    ** Класс - Число - класс данных отчёта, по умолчанию 1.
//    ** РежимДанных - Булево - карточка разрешает вывод СКД в коллекцию.
//
Функция КарточкиОтчетов() Экспорт

	Карточки = Новый Соответствие;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	К.ИмяОтчета КАК ИмяОтчета,
	|	К.Назначение КАК Назначение,
	|	К.Класс КАК Класс,
	|	К.РежимДанных КАК РежимДанных
	|ИЗ
	|	Справочник.ИИА_КарточкиОтчетов КАК К
	|ГДЕ
	|	К.Используется
	|	И НЕ К.ПометкаУдаления");
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	Пока Выборка.Следующий() Цикл
		ОбъектМетаданных = Метаданные.Отчеты.Найти(СокрЛП(Выборка.ИмяОтчета));
		Если ОбъектМетаданных = Неопределено Или ОтчетВнеПериметра(ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		Класс = ?(ЗначениеЗаполнено(Выборка.Класс), ИИА_КлассыДанных.ЧислоКласса(Выборка.Класс), 1);
		Карточки.Вставить(ОбъектМетаданных.Имя, Новый Структура("Назначение, Отчет, Класс, РежимДанных",
			Выборка.Назначение, ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ОбъектМетаданных, Ложь), Класс,
			Выборка.РежимДанных));
	КонецЦикла;

	Возврат Карточки;

КонецФункции

Функция ОписатьОтчет(Результат, ИдентификаторВарианта)

	Вариант = ПодключитьВариант(Результат, ИдентификаторВарианта);
	Если Вариант = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Компоновщик = Вариант.Подключение.Объект.КомпоновщикНастроек;

	Параметры = Новый Массив;
	Для Каждого Параметр Из Компоновщик.Настройки.ПараметрыДанных.Элементы Цикл
		ДоступныйПараметр = Компоновщик.Настройки.ПараметрыДанных.ДоступныеПараметры.НайтиПараметр(Параметр.Параметр);
		Если ДоступныйПараметр = Неопределено Или Не ДоступныйПараметр.Видимость Тогда
			Продолжить;
		КонецЕсли;
		Параметры.Добавить(Новый Структура("name, title, types", Строка(Параметр.Параметр), ДоступныйПараметр.Заголовок,
			ОписаниеТипов(ДоступныйПараметр.ТипЗначения)));
	КонецЦикла;

	Поля = Новый Массив;
	Для Каждого Поле Из Компоновщик.Настройки.ДоступныеПоляОтбора.Элементы Цикл
		Если Поле.Папка Или Поле.Ресурс Или Поля.Количество() >= 40 Тогда
			Продолжить;
		КонецЕсли;
		Поля.Добавить(Новый Структура("name, title, types", Строка(Поле.Поле), Поле.Заголовок, ОписаниеТипов(Поле.ТипЗначения)));
	КонецЦикла;

	Результат.Успех = Истина;
	Результат.Итог = "OK";
	Результат.Класс = 0;
	Результат.Строк = Поля.Количество();
	Результат.Данные = Новый Структура("report, variant, parameters, filter_fields, data_mode",
		Вариант.ОбъектМетаданных.Синоним, Вариант.Наименование, Параметры, Поля, РежимДанныхДоступен(Вариант));
	Возврат Результат;

КонецФункции

Функция СформироватьОтчет(Результат, ИдентификаторВарианта, НачалоПериода, КонецПериода, Условия = Неопределено)

	Вариант = ПодключитьВариант(Результат, ИдентификаторВарианта);
	Если Вариант = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Подключение = Вариант.Подключение;
	ОбъектМетаданных = Вариант.ОбъектМетаданных;
	НеПрименено = Новый Массив;
	УстановитьПериод(Подключение.Объект.КомпоновщикНастроек, НачалоПериода, КонецПериода, НеПрименено);
	Если Условия <> Неопределено Тогда
		Ошибка = ПрименитьОтборы(Подключение.Объект.КомпоновщикНастроек, Условия, НеПрименено);
		Если ЗначениеЗаполнено(Ошибка) Тогда
			Возврат Отказ(Результат, "BAD_FILTER", Ошибка);
		КонецЕсли;
	КонецЕсли;
	Результат.Класс = ИИА_КлассыДанных.КлассОтчета(ОбъектМетаданных.ПолноеИмя(), Вариант.Класс);
	// Реквизиты списка коммерческого маскирования (Номенклатура.Артикул, Контрагент.ИНН) из настроек удаляются.
	МаскируемыеПоля = ИИА_Маскирование.УдалитьМаскируемыеПоляНастроек(Подключение.Объект.КомпоновщикНастроек);
	Если Не МаскируемыеПоля.Успех Тогда
		Возврат Отказ(Результат, "MASKED_FIELD",
			НСтр("ru = 'Не удалось проверить настройки отчёта на скрытые реквизиты: отчёт не формируется.'"));
	КонецЕсли;

	// Режим данных (этап 2): «чистая» СКД выводится в коллекцию значений - типизированные значения и ссылки.
	ТаблицаДанных = Неопределено;
	Если РежимДанныхДоступен(Вариант) Тогда
		ТаблицаДанных = ДанныеОтчетаВКоллекцию(Подключение.Объект);
	КонецЕсли;

	ЕщеОбновляются = Ложь;
	Строки = Новый Массив;
	Если ТаблицаДанных <> Неопределено Тогда
		Выполнение = ИИА_ГраницаЗапроса.РезультатИзТаблицы(ТаблицаДанных, 500);
		Колонки = Выполнение.Колонки;
		Для Индекс = 0 По Мин(59, Выполнение.Строки.ВГраница()) Цикл
			Строки.Добавить(Выполнение.Строки[Индекс]);
		КонецЦикла;
		Усечено = Выполнение.Усечено Или Выполнение.Строки.Количество() > 60;
		Результат.Скрыто = Выполнение.Скрыто;
		Результат.Таблица = Новый Структура("Колонки, Строки, Объекты, ОбъектыЯчеек, НеПоказывать",
			Выполнение.Колонки, Выполнение.Строки, Выполнение.Объекты, Выполнение.ОбъектыЯчеек, Истина);
		Режим = "data";
	Иначе
		МодульВариантыОтчетов = ОбщегоНазначения.ОбщийМодуль("ВариантыОтчетов");
		Вариант.Параметры.Подключение = Подключение;
		Формирование = МодульВариантыОтчетов.СформироватьОтчет(Вариант.Параметры, Ложь, Ложь);
		Если Не Формирование.Успех Тогда
			Возврат Отказ(Результат, "REPORT_ERROR", Лев(ИИА_Периметр.ОчиститьТекст(Формирование.ТекстОшибки), 500));
		КонецЕсли;
		ЕщеОбновляются = Формирование.ДанныеЕщеОбновляются = Истина;
		Таблица = КомпактнаяТаблица(Формирование.ТабличныйДокумент, 200, 12);
		Колонки = Таблица.Колонки;
		Для Индекс = 0 По Мин(59, Таблица.Строки.ВГраница()) Цикл
			Строки.Добавить(Таблица.Строки[Индекс]);
		КонецЦикла;
		Усечено = Таблица.Усечено Или Таблица.Строки.Количество() > 60;
		Результат.Скрыто = Таблица.Скрыто;
		Результат.Таблица = Новый Структура("Колонки, Строки, НеПоказывать", Таблица.Колонки, Таблица.Строки, Истина);
		Режим = "layout";
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.Итог = "OK";
	Результат.Строк = Строки.Количество();
	// Отчёт целиком в чат не выводим: пользователь открывает его штатную форму с теми же пользовательскими
	// настройками. Период и отборы вне пользовательских настроек варианта в ссылку не переносятся - НеПрименено.
	НастройкиXML = ОбщегоНазначения.ЗначениеВСтрокуXML(Подключение.Объект.КомпоновщикНастроек.ПользовательскиеНастройки);
	Если СтрДлина(НастройкиXML) > 65536 Тогда
		НастройкиXML = "";
		НеПрименено.Добавить(НСтр("ru = 'настройки отчёта (слишком большой объём)'"));
	КонецЕсли;
	Результат.Отчет = Новый Структура("Вид, Заголовок, ИмяОтчета, КлючВарианта, Вариант, Настройки, НеПрименено, Структурные",
		"variant", СтрШаблон("%1 (%2)", ОбъектМетаданных.Синоним, Вариант.Наименование),
		ОбъектМетаданных.Имя, Вариант.КлючВарианта, Строка(Вариант.Ссылка.УникальныйИдентификатор()), НастройкиXML,
		НеПрименено, НеПрименено.Количество() > 0);
	Результат.Данные = Новый Структура("report, variant, mode, columns, rows, truncated, data_still_updating",
		ОбъектМетаданных.Синоним, Вариант.Наименование, Режим, Колонки, Строки, Усечено, ЕщеОбновляются);
	Если МаскируемыеПоля.Поля.Количество() > 0 Тогда
		Результат.Данные.Вставить("masked_fields", МаскируемыеПоля.Поля);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Подключает вариант отчёта с проверками периметра и списка отчётов.
// Возвращает Неопределено и заполняет отказ в Результат, если вариант недоступен.
Функция ПодключитьВариант(Результат, ИдентификаторВарианта)

	Если Не ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ВариантыОтчетов") Тогда
		Отказ(Результат, "NOT_SUPPORTED", НСтр("ru = 'В конфигурации нет подсистемы вариантов отчётов.'"));
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Ссылка = Справочники.ВариантыОтчетов.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдентификаторВарианта));
	// Ошибка входного UUID даёт явный BAD_ARGUMENTS.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Отказ(Результат, "BAD_ARGUMENTS", НСтр("ru = 'Некорректный идентификатор варианта.'"));
		Возврат Неопределено;
	КонецПопытки;

	РеквизитыВарианта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка,
		"Отчет, Наименование, КлючВарианта, Пользовательский", Истина);
	Если РеквизитыВарианта = Неопределено Или Не ЗначениеЗаполнено(РеквизитыВарианта.Отчет) Тогда
		Отказ(Результат, "NOT_FOUND", НСтр("ru = 'Вариант отчёта не найден или недоступен.'"));
		Возврат Неопределено;
	КонецЕсли;
	ОбъектМетаданных = ОбъектМетаданныхОтчета(РеквизитыВарианта.Отчет);
	Если ОбъектМетаданных = Неопределено Тогда
		Отказ(Результат, "PERIMETER_VIOLATION", НСтр("ru = 'Отчёт вне периметра ассистента.'"));
		Возврат Неопределено;
	КонецЕсли;
	ТекстОтказа = "";
	Карточка = Неопределено;
	КодОтказа = ОтказДоступаКОтчету(ОбъектМетаданных, ТекстОтказа, Карточка);
	Если ЗначениеЗаполнено(КодОтказа) Тогда
		Отказ(Результат, КодОтказа, ТекстОтказа);
		Возврат Неопределено;
	КонецЕсли;

	МодульВариантыОтчетов = ОбщегоНазначения.ОбщийМодуль("ВариантыОтчетов");
	Параметры = МодульВариантыОтчетов.ПараметрыФормированияОтчета();
	Параметры.СсылкаВарианта = Ссылка;
	// Личный вариант - с текущими пользовательскими настройками, как в форме отчёта: иначе отчёт подставляет
	// свои значения по умолчанию, и сохранённый период теряется.
	Если РеквизитыВарианта.Пользовательский = Истина Тогда
		Сохраненные = ОбщегоНазначения.ХранилищеСистемныхНастроекЗагрузить(
			КлючТекущихПользовательскихНастроек("Отчет." + ОбъектМетаданных.Имя, РеквизитыВарианта.КлючВарианта), "");
		Если ТипЗнч(Сохраненные) = Тип("ПользовательскиеНастройкиКомпоновкиДанных") Тогда
			Параметры.ПользовательскиеНастройкиКД = Сохраненные;
		КонецЕсли;
	КонецЕсли;
	Подключение = МодульВариантыОтчетов.ПодключитьОтчетИЗагрузитьНастройки(Параметры);
	Если Не Подключение.Успех Тогда
		Отказ(Результат, "REPORT_ERROR", НСтр("ru = 'Не удалось подключить отчёт.'"));
		Возврат Неопределено;
	КонецЕсли;

	Вариант = Новый Структура;
	Вариант.Вставить("Ссылка", Ссылка);
	Вариант.Вставить("Наименование", РеквизитыВарианта.Наименование);
	Вариант.Вставить("КлючВарианта", РеквизитыВарианта.КлючВарианта);
	Вариант.Вставить("ОбъектМетаданных", ОбъектМетаданных);
	Вариант.Вставить("Параметры", Параметры);
	Вариант.Вставить("Подключение", Подключение);
	Вариант.Вставить("Класс", ?(Карточка = Неопределено, 1, Карточка.Класс));
	Вариант.Вставить("РежимДанных", Карточка <> Неопределено И Карточка.РежимДанных);
	Возврат Вариант;

КонецФункции

// Режим данных обходит обработчик ПриКомпоновкеРезультата модуля отчёта, поэтому включается только
// карточкой отчёта (data_mode), где это проверено человеком.
Функция РежимДанныхДоступен(Вариант)

	Возврат Вариант.РежимДанных;

КонецФункции

// Выводит отчёт на СКД в таблицу значений. Неопределено, если структура варианта не подходит
// (таблицы и диаграммы СКД в коллекцию не выводятся) - тогда отчёт формируется обычным способом.
Функция ДанныеОтчетаВКоллекцию(ОтчетОбъект)

	Попытка
		Схема = ОтчетОбъект.СхемаКомпоновкиДанных;
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		Макет = КомпоновщикМакета.Выполнить(Схема, ОтчетОбъект.КомпоновщикНастроек.ПолучитьНастройки(), , ,
			Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		Процессор = Новый ПроцессорКомпоновкиДанных;
		Процессор.Инициализировать(Макет, , , Истина);
		Таблица = Новый ТаблицаЗначений;
		Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		Вывод.УстановитьОбъект(Таблица);
		Вывод.Вывести(Процессор);
		Возврат Таблица;
	Исключение
		ЗаписьЖурналаРегистрации("ИИАссистент.Отчеты", УровеньЖурналаРегистрации.Информация, , ,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Применяет отборы на равенство и параметры (см. УсловияАргументов). Значения пишутся в пользовательские настройки
// варианта, чтобы штатная форма отчёта показала их и дала изменить: параметр и отбор - в свой элемент
// пользовательских настроек, отбор по полю без своего элемента - в пользовательскую группу «Отбор». Что так
// перенести нельзя, применяется к настройкам варианта (отчёт ассистента формируется с ним) и описывается в
// НеПрименено. Отбор с другой операцией - ошибка. Возвращает текст ошибки или пустую строку.
Функция ПрименитьОтборы(Компоновщик, Условия, НеПрименено)

	Ошибки = Новый Массив;
	Настройки = Компоновщик.Настройки;
	Для Каждого Условие Из Условия Цикл
		Если ПрименитьПараметр(Компоновщик, Условие, Ошибки, НеПрименено) Тогда
			Продолжить;
		ИначеЕсли Условие.Оператор <> "=" Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Отбор %1 %2: run_report поддерживает только равенство, используй configure_report'"),
				Условие.Поле, Условие.Оператор));
			Продолжить;
		КонецЕсли;
		ТекстЗначения = СокрЛП(Строка(Условие.Значение));
		ДоступноеПоле = Настройки.ДоступныеПоляОтбора.НайтиПоле(Новый ПолеКомпоновкиДанных(Условие.Поле));
		Если ДоступноеПоле = Неопределено Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Нет поля %1 (см. describe_report)'"), Условие.Поле));
			Продолжить;
		КонецЕсли;
		Значение = ЗначениеОтбора(ДоступноеПоле.ТипЗначения, ТекстЗначения, Ошибки, Условие.Поле);
		Если Значение <> Неопределено И Не ОтборПеренесен(Компоновщик, ДоступноеПоле.Поле, Значение) Тогда
			Элемент = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			Элемент.ЛевоеЗначение = ДоступноеПоле.Поле;
			Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
			Элемент.ПравоеЗначение = Значение;
			Элемент.Использование = Истина;
			НеПрименено.Добавить(ДоступноеПоле.Заголовок + " = " + ТекстЗначения);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Ошибки, "; ");

КонецФункции

// Условия аргументов (имена через запятую): {"поле": значение} или {"поле": {"op": ..., "value": ...}}.
// Возвращаемое значение - Массив из Структура - Аргумент, Поле, Оператор (по умолчанию "="), Значение.
Функция УсловияАргументов(Аргументы, ИменаАргументов)

	Результат = Новый Массив;
	Для Каждого ИмяАргумента Из СтрРазделить(ИменаАргументов, ",") Цикл
		Условия = Аргументы.Получить(ИмяАргумента);
		Для Каждого КлючИЗначение Из ?(ТипЗнч(Условия) = Тип("Соответствие"), Условия, Новый Соответствие) Цикл
			Условие = Новый Структура("Аргумент, Поле, Оператор, Значение", ИмяАргумента,
				СокрЛП(Строка(КлючИЗначение.Ключ)), "=", КлючИЗначение.Значение);
			Если ТипЗнч(Условие.Значение) = Тип("Соответствие") Тогда
				Условие.Оператор = НРег(СокрЛП(Строка(Условие.Значение.Получить("op"))));
				Условие.Значение = Условие.Значение.Получить("value");
			КонецЕсли;
			Если Не ПустаяСтрока(Условие.Поле) Тогда
				Результат.Добавить(Условие);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Условие по параметру данных варианта (например, Склад или ДатаОтчета) - в настройки варианта и в пользовательскую
// настройку (см. УстановитьПараметрДанных). Ложь - такого параметра нет.
Функция ПрименитьПараметр(Компоновщик, Условие, Ошибки, НеПрименено)

	ПараметрыДанных = Компоновщик.Настройки.ПараметрыДанных;
	ДоступныйПараметр = ПараметрыДанных.ДоступныеПараметры.НайтиПараметр(Новый ПараметрКомпоновкиДанных(Условие.Поле));
	Если ДоступныйПараметр = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ТекстЗначения = СокрЛП(Строка(Условие.Значение));
	Значение = ЗначениеОтбора(ДоступныйПараметр.ТипЗначения, ТекстЗначения, Ошибки, Условие.Поле);
	Если Значение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Представление = ДоступныйПараметр.Заголовок + " = " + ТекстЗначения;
	ЭлементВарианта = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных(Условие.Поле));
	Если ЭлементВарианта = Неопределено Тогда
		ПараметрыДанных.УстановитьЗначениеПараметра(Условие.Поле, Значение);
		НеПрименено.Добавить(Представление);
	Иначе
		УстановитьПараметрДанных(Компоновщик, ЭлементВарианта, Значение, Представление, НеПрименено);
	КонецЕсли;
	Возврат Истина;

КонецФункции

// Отбор «поле = значение» в пользовательских настройках: в элемент отбора варианта по этому полю, видимый
// пользователю, иначе - в пользовательскую группу «Отбор» варианта. Ложь - перенести некуда.
Функция ОтборПеренесен(Компоновщик, Поле, Значение)

	Недоступный = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	Отбор = Компоновщик.Настройки.Отбор;
	Для Каждого ЭлементВарианта Из Отбор.Элементы Цикл
		Если ТипЗнч(ЭлементВарианта) <> Тип("ЭлементОтбораКомпоновкиДанных") Или ЭлементВарианта.ЛевоеЗначение <> Поле
			Или ЭлементВарианта.РежимОтображения = Недоступный Тогда
			Продолжить;
		КонецЕсли;
		Элемент = ПользовательскаяНастройка(Компоновщик, ЭлементВарианта);
		Если Элемент <> Неопределено Тогда
			Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
			Элемент.ПравоеЗначение = Значение;
			Элемент.Использование = Истина;
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	ГруппаОтбора = ?(Отбор.РежимОтображения = Недоступный, Неопределено, ПользовательскаяНастройка(Компоновщик, Отбор));
	Если ГруппаОтбора = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Элемент = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Элемент.ЛевоеЗначение = Поле;
	Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Элемент.ПравоеЗначение = Значение;
	Элемент.Использование = Истина;
	Возврат Истина;

КонецФункции

// Значение параметра данных - в настройки варианта и в его пользовательскую настройку; если пользовательской
// настройки нет или она скрыта от пользователя, описание значения добавляется в НеПрименено.
Процедура УстановитьПараметрДанных(Компоновщик, ЭлементВарианта, Значение, Представление, НеПрименено)

	ЭлементВарианта.Значение = Значение;
	ЭлементВарианта.Использование = Истина;
	Элемент = ПользовательскаяНастройка(Компоновщик, ЭлементВарианта);
	Если Элемент <> Неопределено Тогда
		Элемент.Значение = Значение;
		Элемент.Использование = Истина;
	КонецЕсли;
	Если Элемент = Неопределено
		Или ЭлементВарианта.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный Тогда
		НеПрименено.Добавить(Представление);
	КонецЕсли;

КонецПроцедуры

// Элемент пользовательских настроек, соответствующий элементу настроек варианта, или Неопределено.
Функция ПользовательскаяНастройка(Компоновщик, ЭлементВарианта)

	Если ПустаяСтрока(ЭлементВарианта.ИдентификаторПользовательскойНастройки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Компоновщик.ПользовательскиеНастройки.Элементы.Найти(ЭлементВарианта.ИдентификаторПользовательскойНастройки);

КонецФункции

// Инструмент configure_report: настройки варианта сразу сохраняются личным вариантом пользователя (новым или
// сохранённым ассистентом ранее в этом диалоге), и отчёт формируется по сохранённому варианту. Без права на личные
// варианты отчёт формируется по исходному варианту, как run_report.
Функция НастроитьОтчет(Результат, Аргументы, ВариантыДиалога)

	ИдентификаторВарианта = СтрокаАргумента(Аргументы, "variant_id");
	Наименование = ИИА_Обслуживание.ОчищенноеНаименование(
		ИИА_Маскирование.ДляПользователя(СтрокаАргумента(Аргументы, "title"), , Ложь));
	Если ПустаяСтрока(Наименование) Тогда
		Возврат Отказ(Результат, "BAD_ARGUMENTS", НСтр("ru = 'Укажи title - наименование варианта.'"));
	КонецЕсли;
	Вариант = ПодключитьВариант(Результат, ИдентификаторВарианта);
	Если Вариант = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Компоновщик = Вариант.Подключение.Объект.КомпоновщикНастроек;
	Ошибка = НастроитьКомпоновку(Компоновщик, Аргументы);
	Если Ошибка <> Неопределено Тогда
		Возврат Отказ(Результат, Ошибка.Код, Ошибка.Текст);
	КонецЕсли;

	ИмяОтчета = Вариант.ОбъектМетаданных.Имя;
	Цель = Неопределено;
	Если Аргументы.Получить("save_as_new") <> Истина Тогда
		// Личный вариант, на который пользователь сослался в диалоге, обновляется под своим наименованием;
		// общий вариант по ссылке не меняется - настройка уходит в личный вариант, как для варианта из find_report.
		Если ВариантУказанПользователем(ВариантыДиалога, ИдентификаторВарианта)
			И ЛичныйВариантПользователя(Вариант.Ссылка) Тогда
			Цель = Вариант.Ссылка;
			Наименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Цель, "Наименование", Истина);
		Иначе
			Цель = ВариантДиалога(ВариантыДиалога, ИдентификаторВарианта, ИмяОтчета);
		КонецЕсли;
	КонецЕсли;
	Если Цель <> Неопределено Тогда
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Цель, "ПометкаУдаления, Пользовательский, Автор", Истина);
		Если Реквизиты = Неопределено Или Реквизиты.ПометкаУдаления <> Ложь Тогда
			Цель = Неопределено; // пользователь удалил вариант - сохраняем новый
		ИначеЕсли Реквизиты.Пользовательский <> Истина Или Реквизиты.Автор <> Пользователи.ТекущийПользователь() Тогда
			Возврат Отказ(Результат, "BAD_ARGUMENTS", НСтр("ru = 'Этот вариант нельзя обновить: он не сохранён ассистентом для пользователя.'"));
		КонецЕсли;
	КонецЕсли;

	Сохранение = СохранитьЛичныйВариант(Вариант.Ссылка, Компоновщик.Настройки, Наименование, Цель,
		Компоновщик.ПользовательскиеНастройки);
	Если Сохранение.КодОшибки = "NO_RIGHT" Тогда
		Возврат ОтчетБезСохранения(Результат, ИдентификаторВарианта, Аргументы);
	ИначеЕсли Не Сохранение.Успех Тогда
		Возврат Отказ(Результат, Сохранение.КодОшибки, Сохранение.Ошибка);
	КонецЕсли;

	Идентификатор = Строка(Сохранение.Вариант.УникальныйИдентификатор());
	СформироватьОтчет(Результат, Идентификатор, "", "");
	Если Не Результат.Успех Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.Отчет = Новый Структура("Вид, Заголовок, ИмяОтчета, Вариант", "saved_variant",
		СтрШаблон("%1 (%2)", Вариант.ОбъектМетаданных.Синоним, Сохранение.Наименование), ИмяОтчета, Идентификатор);
	Результат.НастроенныйВариант = Новый Структура("Вариант, ИмяОтчета, Заголовок, Создан", Идентификатор, ИмяОтчета,
		Сохранение.Наименование, Сохранение.Создан);
	Результат.Данные.Вставить("variant_id", Идентификатор);
	Результат.Данные.Вставить("saved", ?(Сохранение.Создан, "created", "updated"));
	Возврат Результат;

КонецФункции

// Применяет к настройкам варианта аргументы configure_report. Возвращает Неопределено или Структура - Код, Текст.
Функция НастроитьКомпоновку(Компоновщик, Аргументы)

	Настройки = Компоновщик.Настройки;
	Ошибки = Новый Массив;
	НетПолей = Новый Массив;
	Похожие = Новый Массив;
	УстановитьПериод(Компоновщик, СтрокаАргумента(Аргументы, "period_start"), СтрокаАргумента(Аргументы, "period_end"),
		Новый Массив);

	Виды = Новый Соответствие;
	Виды.Вставить("=", ВидСравненияКомпоновкиДанных.Равно);
	Виды.Вставить("<>", ВидСравненияКомпоновкиДанных.НеРавно);
	Виды.Вставить("in", ВидСравненияКомпоновкиДанных.ВСписке);
	Виды.Вставить("not in", ВидСравненияКомпоновкиДанных.НеВСписке);
	Виды.Вставить(">", ВидСравненияКомпоновкиДанных.Больше);
	Виды.Вставить("<", ВидСравненияКомпоновкиДанных.Меньше);
	Виды.Вставить("contains", ВидСравненияКомпоновкиДанных.Содержит);
	Виды.Вставить("filled", ВидСравненияКомпоновкиДанных.Заполнено);
	Виды.Вставить("empty", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	Для Каждого Условие Из УсловияАргументов(Аргументы, "parameters,filters") Цикл
		Если ПрименитьПараметр(Компоновщик, Условие, Ошибки, Новый Массив) Тогда
			Продолжить;
		КонецЕсли;
		ДоступноеПоле = ДоступноеПолеНастройки(Настройки.ДоступныеПоляОтбора, Условие.Поле, Похожие);
		ВидСравненияОтбора = Виды.Получить(Условие.Оператор);
		Если ДоступноеПоле = Неопределено Или Условие.Аргумент = "parameters" Тогда
			НетПолей.Добавить(Условие.Поле);
			Продолжить;
		ИначеЕсли ВидСравненияОтбора = Неопределено Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = '%1: неизвестная операция %2'"), Условие.Поле, Условие.Оператор));
			Продолжить;
		КонецЕсли;
		Значение = Неопределено;
		Если Условие.Оператор = "contains" Тогда
			Значение = Строка(Условие.Значение);
		ИначеЕсли Условие.Оператор = "in" Или Условие.Оператор = "not in" Тогда
			Значение = Новый СписокЗначений;
			Для Каждого Текст Из ?(ТипЗнч(Условие.Значение) = Тип("Массив"), Условие.Значение, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Условие.Значение)) Цикл
				ЗначениеСписка = ЗначениеОтбора(ДоступноеПоле.ТипЗначения, СокрЛП(Строка(Текст)), Ошибки, Условие.Поле);
				Если ЗначениеСписка <> Неопределено Тогда
					Значение.Добавить(ЗначениеСписка);
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли Условие.Оператор <> "filled" И Условие.Оператор <> "empty" Тогда
			Значение = ЗначениеОтбора(ДоступноеПоле.ТипЗначения, СокрЛП(Строка(Условие.Значение)), Ошибки, Условие.Поле);
			Если Значение = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Элемент = Неопределено;
		Для Каждого ЭлементОтбора Из Настройки.Отбор.Элементы Цикл
			Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") И ЭлементОтбора.ЛевоеЗначение = ДоступноеПоле.Поле Тогда
				Элемент = ЭлементОтбора;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Элемент = Неопределено Тогда
			Элемент = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			Элемент.ЛевоеЗначение = ДоступноеПоле.Поле;
		КонецЕсли;
		Элемент.ВидСравнения = ВидСравненияОтбора;
		Элемент.ПравоеЗначение = Значение;
		Элемент.Использование = Истина;
	КонецЦикла;

	Группировки = СписокСтрокАргумента(Аргументы, "group_by");
	Поля = СписокСтрокАргумента(Аргументы, "fields");
	Если Группировки.Количество() > 5 Или Поля.Количество() > 20 Тогда
		Возврат Новый Структура("Код, Текст", "BAD_ARGUMENTS", НСтр("ru = 'Не больше 5 группировок и 20 полей.'"));
	КонецЕсли;
	// Группировки строк - вложенная цепочка вместо прежней структуры варианта.
	Если Группировки.Количество() > 0 Тогда
		Настройки.Структура.Очистить();
		Родитель = Настройки;
		Для Каждого ИмяПоля Из Группировки Цикл
			Группировка = Родитель.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
			ДоступноеПоле = ДоступноеПолеНастройки(Группировка.ПоляГруппировки.ДоступныеПоляПолейГруппировок, ИмяПоля, Похожие);
			Если ДоступноеПоле = Неопределено Тогда
				НетПолей.Добавить(ИмяПоля);
				Продолжить;
			КонецЕсли;
			ПолеГруппировки = Группировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
			ПолеГруппировки.Поле = ДоступноеПоле.Поле;
			ПолеГруппировки.Использование = Истина;
			Группировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
			Группировка.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
			Родитель = Группировка;
		КонецЦикла;
	КонецЕсли;
	Если Поля.Количество() > 0 Тогда
		Настройки.Выбор.Элементы.Очистить();
		Для Каждого ИмяПоля Из Поля Цикл
			ДоступноеПоле = ДоступноеПолеНастройки(Настройки.Выбор.ДоступныеПоляВыбора, ИмяПоля, Похожие);
			Если ДоступноеПоле = Неопределено Тогда
				НетПолей.Добавить(ИмяПоля);
				Продолжить;
			КонецЕсли;
			ВыбранноеПоле = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			ВыбранноеПоле.Поле = ДоступноеПоле.Поле;
			ВыбранноеПоле.Использование = Истина;
		КонецЦикла;
	КонецЕсли;
	Сортировка = Аргументы.Получить("sort");
	Если ТипЗнч(Сортировка) = Тип("Массив") И Сортировка.Количество() > 0 Тогда
		Настройки.Порядок.Элементы.Очистить();
		Для Каждого ОписаниеПорядка Из Сортировка Цикл
			ИмяПоля = ?(ТипЗнч(ОписаниеПорядка) = Тип("Соответствие"), СокрЛП(Строка(ОписаниеПорядка.Получить("field"))), "");
			ДоступноеПоле = ДоступноеПолеНастройки(Настройки.Порядок.ДоступныеПоляПорядка, ИмяПоля, Похожие);
			Если ДоступноеПоле = Неопределено Тогда
				НетПолей.Добавить(ИмяПоля);
				Продолжить;
			КонецЕсли;
			ЭлементПорядка = Настройки.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
			ЭлементПорядка.Поле = ДоступноеПоле.Поле;
			ЭлементПорядка.ТипУпорядочивания = ?(ОписаниеПорядка.Получить("desc") = Истина,
				НаправлениеСортировкиКомпоновкиДанных.Убыв, НаправлениеСортировкиКомпоновкиДанных.Возр);
			ЭлементПорядка.Использование = Истина;
		КонецЦикла;
	КонецЕсли;

	Если НетПолей.Количество() > 0 Тогда
		Допустимые = Новый Массив;
		Для Каждого ДоступноеПоле Из Настройки.ДоступныеПоляОтбора.Элементы Цикл
			Если Не ДоступноеПоле.Папка И Допустимые.Количество() < 40 Тогда
				Допустимые.Добавить(Строка(ДоступноеПоле.Поле));
			КонецЕсли;
		КонецЦикла;
		Текст = СтрШаблон(НСтр("ru = 'Нет полей или параметров: %1. Допустимые поля: %2. Реквизит поля указывай через точку: Поле.Реквизит.'"),
			СтрСоединить(НетПолей, ", "), СтрСоединить(Допустимые, ", "));
		Если Похожие.Количество() > 0 Тогда
			Текст = Текст + " " + СтрШаблон(НСтр("ru = 'Подходят несколько реквизитов, выбери один: %1.'"),
				СтрСоединить(Похожие, ", "));
		КонецЕсли;
		Возврат Новый Структура("Код, Текст", "BAD_FIELD", Текст);
	ИначеЕсли Ошибки.Количество() > 0 Тогда
		Возврат Новый Структура("Код, Текст", "BAD_FILTER", СтрСоединить(Ошибки, "; "));
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Доступное поле настроек по имени из аргументов: точное имя (реквизит - через точку), иначе имя или заголовок
// без учёта регистра и пробелов - среди полей, затем среди их реквизитов. Модель часто передаёт заголовок поля
// или реквизит без поля-владельца; неоднозначный реквизит не выбирается, кандидаты добавляются в Похожие.
Функция ДоступноеПолеНастройки(ДоступныеПоля, ИмяПоля, Похожие)

	Если ПустаяСтрока(ИмяПоля) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Найденное = ДоступныеПоля.НайтиПоле(Новый ПолеКомпоновкиДанных(ИмяПоля));
	Если Найденное <> Неопределено Тогда
		Возврат Найденное;
	КонецЕсли;
	Ключ = КлючПоляНастройки(ИмяПоля);
	Для Каждого Элемент Из ДоступныеПоля.Элементы Цикл
		Если Не Элемент.Папка И ПолеНастройкиСовпадает(Элемент, Ключ) Тогда
			Возврат Элемент;
		КонецЕсли;
	КонецЦикла;
	Реквизиты = Новый Массив;
	Для Каждого Элемент Из ДоступныеПоля.Элементы Цикл
		Для Каждого Реквизит Из Элемент.Элементы Цикл
			Если Не Реквизит.Папка И ПолеНастройкиСовпадает(Реквизит, Ключ) Тогда
				Реквизиты.Добавить(Реквизит);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если Реквизиты.Количество() = 1 Тогда
		Возврат Реквизиты[0];
	КонецЕсли;
	Для Каждого Реквизит Из Реквизиты Цикл
		Если Похожие.Найти(Строка(Реквизит.Поле)) = Неопределено Тогда
			Похожие.Добавить(Строка(Реквизит.Поле));
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ПолеНастройкиСовпадает(ДоступноеПоле, Ключ)

	// Заголовок реквизита платформа дополняет заголовком владельца: «Номенклатура.Номенклатурная группа».
	Тексты = Новый Массив;
	Тексты.Добавить(Строка(ДоступноеПоле.Поле));
	Тексты.Добавить(ДоступноеПоле.Заголовок);
	Для Каждого Текст Из Тексты Цикл
		Части = СтрРазделить(Текст, ".");
		Если Ключ = КлючПоляНастройки(Текст) Или Ключ = КлючПоляНастройки(Части[Части.ВГраница()]) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция КлючПоляНастройки(Текст)

	Возврат СтрЗаменить(НРег(СтрЗаменить(СокрЛП(Текст), " ", "")), "ё", "е");

КонецФункции

// Ключ текущих пользовательских настроек варианта в хранилище системных настроек (так их хранит форма отчёта).
Функция КлючТекущихПользовательскихНастроек(ИмяОтчета, КлючВарианта)

	Возврат ИмяОтчета + "/" + КлючВарианта + "/ТекущиеПользовательскиеНастройки";

КонецФункции

Функция ВариантУказанПользователем(ВариантыДиалога, ИдентификаторВарианта)

	Для Каждого Вариант Из ВариантыДиалога Цикл
		Если Вариант.Свойство("Указан") И Вариант.Указан И Вариант.Вариант = ИдентификаторВарианта Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЛичныйВариантПользователя(Вариант)

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Вариант, "ПометкаУдаления, Пользовательский, Автор", Истина);
	Возврат Реквизиты <> Неопределено И Реквизиты.ПометкаУдаления = Ложь И Реквизиты.Пользовательский = Истина
		И Реквизиты.Автор = Пользователи.ТекущийПользователь();

КонецФункции

// Сохранённый configure_report в этом диалоге вариант того же отчёта: сам variant_id, если это такой вариант,
// иначе последний сохранённый вариант отчёта.
Функция ВариантДиалога(ВариантыДиалога, ИдентификаторВарианта, ИмяОтчета)

	Найденный = "";
	Для Каждого Настроенный Из ВариантыДиалога Цикл
		Если Настроенный.Свойство("Указан") И Настроенный.Указан Тогда
			Продолжить;
		ИначеЕсли Настроенный.Вариант = ИдентификаторВарианта Тогда
			Найденный = Настроенный.Вариант;
			Прервать;
		ИначеЕсли Настроенный.ИмяОтчета = ИмяОтчета Тогда
			Найденный = Настроенный.Вариант;
		КонецЕсли;
	КонецЦикла;
	Возврат ?(ПустаяСтрока(Найденный), Неопределено,
		Справочники.ВариантыОтчетов.ПолучитьСсылку(Новый УникальныйИдентификатор(Найденный)));

КонецФункции

// Нет права на личные варианты: отчёт по исходному варианту механизмом run_report. Отборы на равенство и параметры
// переносятся как в run_report; прочие сравнения, группировки, поля и сортировка - в НеПрименено ссылки.
Функция ОтчетБезСохранения(Результат, ИдентификаторВарианта, Аргументы)

	НеПрименено = Новый Массив;
	Для Каждого ИмяАргумента Из СтрРазделить("group_by,fields", ",") Цикл
		Поля = СписокСтрокАргумента(Аргументы, ИмяАргумента);
		Если Поля.Количество() > 0 Тогда
			НеПрименено.Добавить(СтрШаблон("%1: %2", ?(ИмяАргумента = "group_by", НСтр("ru = 'группировки'"), НСтр("ru = 'поля'")),
				СтрСоединить(Поля, ", ")));
		КонецЕсли;
	КонецЦикла;
	Если ТипЗнч(Аргументы.Получить("sort")) = Тип("Массив") И Аргументы.Получить("sort").Количество() > 0 Тогда
		НеПрименено.Добавить(НСтр("ru = 'сортировка'"));
	КонецЕсли;

	СформироватьОтчет(Результат, ИдентификаторВарианта, СтрокаАргумента(Аргументы, "period_start"),
		СтрокаАргумента(Аргументы, "period_end"), УсловияАргументов(Аргументы, "parameters,filters"));
	Если Не Результат.Успех Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Описание Из НеПрименено Цикл
		Результат.Отчет.НеПрименено.Добавить(Описание);
	КонецЦикла;
	Результат.Отчет.Структурные = Результат.Отчет.НеПрименено.Количество() > 0;
	Результат.Итог = "NO_RIGHT";
	Результат.Данные.Вставить("error", "NO_RIGHT");
	Результат.Данные.Вставить("message", НСтр("ru = 'У пользователя нет права сохранять личные варианты отчётов: настройка не сохранена, отчёт сформирован по исходному варианту с периодом и отборами на равенство. Сообщи об этом пользователю.'"));
	Возврат Результат;

КонецФункции


Функция ОписаниеТипов(ОписаниеТипа)

	Типы = Новый Массив;
	Для Каждого ТипПоля Из ОписаниеТипа.Типы() Цикл
		ОбъектТипа = Метаданные.НайтиПоТипу(ТипПоля);
		Типы.Добавить(?(ОбъектТипа = Неопределено, Строка(ТипПоля), ОбъектТипа.ПолноеИмя()));
		Если Типы.Количество() >= 3 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Типы, ", ");

КонецФункции

Функция ОбщийМостВключен()

	УстановитьПривилегированныйРежим(Истина);
	Возврат Константы.ИИА_ОбщийМостОтчетов.Получить() = Истина;

КонецФункции

// Адаптер семейства «Бухгалтерские отчёты» (план, раздел 6.2): отчёт штатным конвейером ERP
// (ЗаполнениеФинОтчетностиВБанки) с отбором по доступным счетам до формирования и постфильтром строк и колонок.
// Конвейер выводит отчёт в привилегированном режиме, поэтому права, организация и счёт проверяются до формирования.
Функция СформироватьБухгалтерскийОтчет(Результат, ВидОтчета, Аргументы)

	Описание = Неопределено;
	Если Не ИИА_БухгалтерскийДоступ.ВидыБухгалтерскихОтчетов().Свойство(ВидОтчета, Описание) Тогда
		Возврат Отказ(Результат, "BAD_ARGUMENTS", СтрШаблон(НСтр("ru = 'Неизвестный вид отчёта %1.'"), ВидОтчета));
	КонецЕсли;
	НайденныйОтчет = Метаданные.Отчеты.Найти(Описание.ИмяОтчета);
	Если НайденныйОтчет = Неопределено Или Метаданные.РегистрыБухгалтерии.Найти("Хозрасчетный") = Неопределено Тогда
		Возврат Отказ(Результат, "NOT_SUPPORTED", СтрШаблон(НСтр("ru = 'В конфигурации нет отчёта «%1».'"), Описание.Заголовок));
	КонецЕсли;
	НачалоПериода = СтрокаАргумента(Аргументы, "period_start");
	КонецПериода = СтрокаАргумента(Аргументы, "period_end");
	НачалоКорректно = Ложь;
	КонецКорректен = Ложь;
	Начало = ПрочитатьДатуИзСтроки(НачалоПериода, НачалоКорректно);
	Конец = ПрочитатьДатуИзСтроки(КонецПериода, КонецКорректен);
	Если Не НачалоКорректно Или Не КонецКорректен Тогда
		Возврат Отказ(Результат, "BAD_ARGUMENTS", НСтр("ru = 'Укажите период в формате ГГГГ-ММ-ДД.'"));
	КонецЕсли;
	ОбъектМетаданных = Метаданные.Отчеты[Описание.ИмяОтчета];
	ТекстСчета = СтрокаАргумента(Аргументы, "account");
	Если Описание.НуженСчет И ПустаяСтрока(ТекстСчета) Тогда
		Возврат Отказ(Результат, "BAD_ARGUMENTS", НСтр("ru = 'Для этого отчёта укажите счёт (account).'"));
	КонецЕсли;
	ТекстыГруппировок = Аргументы.Получить("group_by_subconto");
	ТекстыГруппировок = ?(ТипЗнч(ТекстыГруппировок) = Тип("Массив"), ТекстыГруппировок, Новый Массив);
	Если ТекстыГруппировок.Количество() > 0 И Не Описание.Группировки Или ТекстыГруппировок.Количество() > 3 Тогда
		Возврат Отказ(Результат, "BAD_ARGUMENTS",
			НСтр("ru = 'group_by_subconto: до 3 видов субконто и только для account_trial_balance и account_analysis.'"));
	КонецЕсли;

	Если Не ПравоДоступа("Использование", ОбъектМетаданных)
		Или Не ПравоДоступа("Чтение", Метаданные.РегистрыБухгалтерии.Хозрасчетный) Тогда
		Возврат Отказ(Результат, "ACCESS_DENIED", СтрШаблон(НСтр("ru = 'Нет права на отчёт «%1».'"), Описание.Заголовок));
	КонецЕсли;
	Если ИИА_ПрофилиДоступа.ОтчетЗапрещенПрофилемЯвно(ОбъектМетаданных.ПолноеИмя()) Тогда
		Возврат Отказ(Результат, "ACCESS_DENIED", СтрШаблон(НСтр("ru = 'Отчёт «%1» запрещён профилем доступа.'"), Описание.Заголовок));
	КонецЕсли;
	Набор = ИИА_ПериметрПовтИсп.НаборСчетов();
	Если Набор.Пусто Тогда
		Возврат Отказ(Результат, "ACCESS_DENIED", НСтр("ru = 'В профиле доступа нет доступных счетов.'"));
	КонецЕсли;
	Если ВидОтчета <> "trial_balance" И Не Набор.РасширенныйДоступ Тогда
		Возврат Отказ(Результат, "ACCESS_DENIED",
			НСтр("ru = 'Профиль не открывает бухгалтерские инструменты: отметьте разрешённые счета.'"));
	КонецЕсли;
	Организация = НайтиОрганизацию(СтрокаАргумента(Аргументы, "organization"));
	Если Организация = Неопределено Тогда
		Возврат Отказ(Результат, "ORGANIZATION_REQUIRED",
			НСтр("ru = 'Укажите организацию (часть наименования): в базе их несколько или такой нет.'"));
	КонецЕсли;

	Значения = Новый Структура("Организация, НачалоПериода, КонецПериода, Счет, ПоСубсчетам, ПоСубсчетамКорСчетов, Группировки",
		Организация, НачалоДня(Начало), КонецДня(Конец), Неопределено,
		Аргументы.Получить("by_subaccounts") = Истина, Аргументы.Получить("by_corr_subaccounts") = Истина, Новый Массив);
	Частично = Ложь;
	ПредставлениеСчета = "";
	Если Описание.НуженСчет Тогда
		Ошибки = Неопределено;
		Значения.Счет = ИИА_БухгалтерскийДоступ.НайтиСчет(ТекстСчета, Ошибки, Набор);
		Если Значения.Счет = Неопределено Тогда
			Возврат Отказ(Результат, Ошибки.Код, Ошибки.Текст);
		КонецЕсли;
		Частично = ИИА_БухгалтерскийДоступ.СостояниеСчета(Значения.Счет, Набор) = "Частично";
		РеквизитыСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Значения.Счет, "Код, Наименование", Истина);
		ПредставлениеСчета = СокрЛП(РеквизитыСчета.Код) + " " + СокрЛП(РеквизитыСчета.Наименование);
	КонецЕсли;

	Класс = ИИА_КлассыДанных.КлассОтчета(ОбъектМетаданных.ПолноеИмя());
	Если Описание.КорСчет Тогда
		Класс = Макс(Класс, ИИА_КлассыДанных.КлассОбъекта("ПланСчетов.Хозрасчетный"));
	КонецЕсли;
	Если ТекстыГруппировок.Количество() > 0 Тогда
		ВидыСубконтоСчета = ВидыСубконтоСчета(Значения.Счет);
		Для Каждого ТекстГруппировки Из ТекстыГруппировок Цикл
			Ошибки = Неопределено;
			ВидСубконто = ИИА_БухгалтерскийДоступ.НайтиВидСубконто(Строка(ТекстГруппировки), Ошибки);
			Если ВидСубконто = Неопределено Тогда
				Возврат Отказ(Результат, Ошибки.Код, Ошибки.Текст);
			КонецЕсли;
			Причина = "";
			КодОтказа = ИИА_БухгалтерскийДоступ.ВидСубконтоЗапрещен(ВидСубконто, Причина);
			Если ЗначениеЗаполнено(КодОтказа) Тогда
				Возврат Отказ(Результат, КодОтказа, СтрШаблон(НСтр("ru = 'Группировка по виду субконто «%1» недоступна ассистенту (%2).'"),
					ТекстГруппировки, Причина));
			КонецЕсли;
			НомерСубконто = ВидыСубконтоСчета.Получить(ВидСубконто);
			Если НомерСубконто = Неопределено Тогда
				Возврат Отказ(Результат, "SUBCONTO_NOT_FOUND",
					СтрШаблон(НСтр("ru = 'У счёта %1 нет вида субконто «%2».'"), ПредставлениеСчета, ТекстГруппировки));
			КонецЕсли;
			Значения.Группировки.Добавить(Новый Структура("Поле, Представление", "Субконто" + НомерСубконто, Строка(ВидСубконто)));
			Класс = Макс(Класс, КлассТиповВидаСубконто(ВидСубконто));
		КонецЦикла;
	КонецЕсли;

	ПараметрыОтчета = Отчеты[Описание.ИмяОтчета].ПустыеПараметрыКомпоновкиОтчета();
	ЗаполнитьПараметрыБухгалтерскогоОтчета(ПараметрыОтчета, Описание, Значения);
	ОбщегоНазначения.ОбщийМодуль("БухгалтерскиеОтчеты").ПодготовитьСхемуКомпоновкиДанных(ПараметрыОтчета);

	// Отбор доступных счетов - до формирования (см. ИИА_БухгалтерскийДоступ.ДобавитьОтборСчетов).
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(ПараметрыОтчета.СхемаКомпоновкиДанных));
	// В отчётах по одному счёту поле Счет закрыто для отбора схемой ERP: счёт ограничен параметром отчёта, поэтому
	// частично доступный счёт (с закрытыми субсчетами) там не формируется.
	Отборы = ИИА_БухгалтерскийДоступ.ДобавитьОтборСчетов(ПараметрыОтчета.НастройкиКомпоновкиДанных.Отбор,
		Компоновщик.Настройки.ДоступныеПоляОтбора, Набор);
	Если Не Отборы.Счет И Не Описание.НуженСчет Или Описание.КорСчет И Не Отборы.КорСчет Тогда
		Возврат Отказ(Результат, "REPORT_ERROR", НСтр("ru = 'В отчёте нет поля счёта для ограничения: отчёт не сформирован.'"));
	ИначеЕсли Не Отборы.Счет И Частично Тогда
		Возврат Отказ(Результат, "ACCESS_DENIED", СтрШаблон(
			НСтр("ru = 'Часть субсчетов счёта %1 недоступна ассистенту, а этот отчёт не ограничивается по субсчетам: укажите доступный субсчёт.'"),
			ПредставлениеСчета));
	КонецЕсли;

	ПараметрыОтчета.Вставить("ИспользоватьДанныеРасшифровки", Истина);
	Формирование = ОбщегоНазначения.ОбщийМодуль("БухгалтерскиеОтчетыВызовСервера").ПодготовитьОтчет(ПараметрыОтчета);
	Если ЭтоАдресВременногоХранилища(Формирование.ДанныеРасшифровки) Тогда
		УдалитьИзВременногоХранилища(Формирование.ДанныеРасшифровки);
	КонецЕсли;
	Если Не Формирование.Выполнено Тогда
		Возврат Отказ(Результат, "REPORT_ERROR", Лев(ИИА_Периметр.ОчиститьТекст(Формирование.КраткоеПредставлениеОшибки), 500));
	КонецЕсли;

	ЭтоОСВ = ВидОтчета = "trial_balance";
	Таблица = КомпактнаяТаблица(Формирование.Результат, 120, ?(ЭтоОСВ, 8, 12));
	ИИА_БухгалтерскийДоступ.ТаблицаБезНедоступныхСчетов(Таблица, Набор, ЭтоОСВ);

	Результат.Успех = Истина;
	Результат.Итог = "OK";
	Результат.Класс = Класс;
	Результат.Строк = Таблица.Строки.Количество();
	Результат.Скрыто = Таблица.Скрыто;
	Период = СтрШаблон("%1 - %2", Формат(Начало, "ДФ=dd.MM.yyyy"), Формат(Конец, "ДФ=dd.MM.yyyy"));
	Если ЭтоОСВ Тогда
		Результат.Отчет = Новый Структура("Вид, Заголовок, Организация, НачалоПериода, КонецПериода",
			"osv", СтрШаблон(НСтр("ru = 'Оборотно-сальдовая ведомость, %1'"), Период),
			ОбщегоНазначения.ЗначениеВСтрокуXML(Организация), Значения.НачалоПериода, Значения.КонецПериода);
	Иначе
		Результат.Отчет = Новый Структура("Вид, Заголовок, ИмяОтчета, Организация, Счет, НачалоПериода, КонецПериода",
			"accounting", СтрШаблон("%1 %2, %3", Описание.Заголовок, ПредставлениеСчета, Период), Описание.ИмяОтчета,
			ОбщегоНазначения.ЗначениеВСтрокуXML(Организация), ОбщегоНазначения.ЗначениеВСтрокуXML(Значения.Счет),
			Значения.НачалоПериода, Значения.КонецПериода);
	КонецЕсли;
	Исключено = ?(ЭтоОСВ, НСтр("ru = 'счета вне профиля доступа, счета 69, 70, 71, 73 и общий итог исключены'"),
		НСтр("ru = 'счета вне профиля и счета 69/70/71/73 исключены до формирования'"));
	Результат.Данные = Новый Структура("report, kind, period, account, rows, truncated, partial, corr_filtered, excluded",
		Описание.Заголовок, ВидОтчета, НачалоПериода + " - " + КонецПериода, ПредставлениеСчета, Таблица.Строки,
		Таблица.Усечено, Частично, Описание.КорСчет, Исключено);
	Возврат Результат;

КонецФункции

// Заполняет параметры отчёта как штатное программное формирование ERP (ЗаполнениеФинОтчетностиВБанки).
// Корреспонденция - только группировкой отчёта по КорСчет: таблица ГруппировкаКор (субконто корсчетов) не заполняется.
Процедура ЗаполнитьПараметрыБухгалтерскогоОтчета(ПараметрыОтчета, Описание, Значения)

	ПараметрыОтчета.Организация = Значения.Организация;
	ПараметрыОтчета.НачалоПериода = Значения.НачалоПериода;
	ПараметрыОтчета.КонецПериода = Значения.КонецПериода;
	Если Описание.НуженСчет Тогда
		ПараметрыОтчета.Счет = Значения.Счет;
	КонецЕсли;
	ПараметрыОтчета.ПоСубсчетам = Значения.ПоСубсчетам;
	Если ПараметрыОтчета.Свойство("ПоСубсчетамКорСчетов") Тогда
		ПараметрыОтчета.ПоСубсчетамКорСчетов = Значения.ПоСубсчетамКорСчетов;
	КонецЕсли;
	Если ПараметрыОтчета.Свойство("ВыводитьЗабалансовыеСчета") Тогда
		ПараметрыОтчета.ВыводитьЗабалансовыеСчета = Ложь;
	КонецЕсли;
	Для Каждого Группировка Из Значения.Группировки Цикл
		НоваяСтрока = ПараметрыОтчета.Группировка.Добавить();
		НоваяСтрока.Поле = Группировка.Поле;
		НоваяСтрока.Представление = Группировка.Представление;
		НоваяСтрока.Использование = Истина;
		НоваяСтрока.ТипГруппировки = 0;
	КонецЦикла;

	ПараметрыОтчета.РежимРасшифровки = Истина;
	Если ПараметрыОтчета.Свойство("ПоказательБУ") Тогда
		ПараметрыОтчета.ПоказательБУ = Истина;
	КонецЕсли;
	ПараметрыРежимаВыгрузки = Новый Структура("ВидОтчета, ИдентификаторФормыВладельца, КлючСтрокиОтчета, ПереопределятьМакетОформления",
		"", "", 0, Ложь);
	ПараметрыОтчета.Вставить("ПараметрыРежимаВыгрузки", ПараметрыРежимаВыгрузки);
	ПараметрыОтчета.ДанныеРасшифровки = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);

КонецПроцедуры

// Виды субконто счёта (в правах пользователя): вид -> номер субконто.
Функция ВидыСубконтоСчета(Счет)

	Результат = Новый Соответствие;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Виды.НомерСтроки КАК НомерСтроки,
	|	Виды.ВидСубконто КАК ВидСубконто
	|ИЗ
	|	ПланСчетов.Хозрасчетный.ВидыСубконто КАК Виды
	|ГДЕ
	|	Виды.Ссылка = &Счет");
	Запрос.УстановитьПараметр("Счет", Счет);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.ВидСубконто, Выборка.НомерСтроки);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Класс данных значений вида субконто: максимум классов объектов его типов.
Функция КлассТиповВидаСубконто(ВидСубконто)

	Класс = 0;
	ТипЗначения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидСубконто, "ТипЗначения");
	Если ТипЗнч(ТипЗначения) <> Тип("ОписаниеТипов") Тогда
		Возврат Класс;
	КонецЕсли;
	Для Каждого ТипСубконто Из ТипЗначения.Типы() Цикл
		ОбъектТипа = Метаданные.НайтиПоТипу(ТипСубконто);
		Если ОбъектТипа <> Неопределено Тогда
			Класс = Макс(Класс, ИИА_КлассыДанных.КлассОбъекта(ОбъектТипа.ПолноеИмя()));
		КонецЕсли;
	КонецЦикла;
	Возврат Класс;

КонецФункции

// Остатки и обороты регистра бухгалтерии ассистента (accounting_balances, см. ИИА_БухгалтерскийДоступ.ИмяПланаСчетов): фиксированный шаблон запроса, принудительное
// условие по доступным счетам, запрос в правах пользователя, значения - через границу запроса.
Функция ОстаткиИОборотыСчетов(Результат, Аргументы)

	Режим = СтрокаАргумента(Аргументы, "mode");
	Если СтрРазделить("balances,turnovers,balances_and_turnovers", ",").Найти(Режим) = Неопределено Тогда
		Возврат Отказ(Результат, "BAD_ARGUMENTS", НСтр("ru = 'mode: balances, turnovers или balances_and_turnovers.'"));
	КонецЕсли;
	НачалоПериода = СтрокаАргумента(Аргументы, "period_start");
	КонецПериода = СтрокаАргумента(Аргументы, "period_end");
	НачалоКорректно = Ложь;
	КонецКорректен = Ложь;
	Начало = ПрочитатьДатуИзСтроки(НачалоПериода, НачалоКорректно);
	Конец = ПрочитатьДатуИзСтроки(КонецПериода, КонецКорректен);
	Если Не КонецКорректен Или Режим <> "balances" И Не НачалоКорректно Тогда
		Возврат Отказ(Результат, "BAD_ARGUMENTS", НСтр("ru = 'Укажите период в формате ГГГГ-ММ-ДД (для balances - period_end).'"));
	КонецЕсли;
	ПоКорСчету = Аргументы.Получить("by_corr_account") = Истина;
	Если ПоКорСчету И Режим <> "turnovers" Тогда
		Возврат Отказ(Результат, "BAD_ARGUMENTS", НСтр("ru = 'by_corr_account допустим только для mode = turnovers.'"));
	КонецЕсли;
	ТекстыСчетов = Аргументы.Получить("accounts");
	ТекстыСчетов = ?(ТипЗнч(ТекстыСчетов) = Тип("Массив"), ТекстыСчетов, Новый Массив);
	Если ТекстыСчетов.Количество() > 20 Тогда
		Возврат Отказ(Результат, "BAD_ARGUMENTS", НСтр("ru = 'Укажите не больше 20 счетов.'"));
	КонецЕсли;

	Если Не ИИА_БухгалтерскийДоступ.БухгалтерскийУчетДоступен() Тогда
		Возврат Отказ(Результат, "NOT_SUPPORTED", НСтр("ru = 'В конфигурации нет регистра бухгалтерии.'"));
	КонецЕсли;
	ИмяПлана = ИИА_БухгалтерскийДоступ.ИмяПланаСчетов();
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыБухгалтерии[ИмяПлана]) Тогда
		Возврат Отказ(Результат, "ACCESS_DENIED", НСтр("ru = 'Нет права на чтение регистра бухучёта.'"));
	КонецЕсли;
	Набор = ИИА_ПериметрПовтИсп.НаборСчетов();
	Если Набор.Пусто Тогда
		Возврат Отказ(Результат, "ACCESS_DENIED", НСтр("ru = 'В профиле доступа нет доступных счетов.'"));
	КонецЕсли;
	Если Не Набор.РасширенныйДоступ Тогда
		Возврат Отказ(Результат, "ACCESS_DENIED",
			НСтр("ru = 'Профиль не открывает бухгалтерские инструменты: отметьте разрешённые счета.'"));
	КонецЕсли;
	Организация = НайтиОрганизацию(СтрокаАргумента(Аргументы, "organization"));
	Если Организация = Неопределено Тогда
		Возврат Отказ(Результат, "ORGANIZATION_REQUIRED",
			НСтр("ru = 'Укажите организацию (часть наименования): в базе их несколько или такой нет.'"));
	КонецЕсли;

	// Счета: запрошенные (с субсчетами) в пересечении с набором; без accounts - все доступные.
	Частично = Ложь;
	Если ТекстыСчетов.Количество() = 0 Тогда
		ДоступныеСчета = Новый Массив(Набор.ДоступныеМассив);
	Иначе
		Запрошенные = Новый Массив;
		Для Каждого ТекстСчета Из ТекстыСчетов Цикл
			Ошибки = Неопределено;
			Счет = ИИА_БухгалтерскийДоступ.НайтиСчет(Строка(ТекстСчета), Ошибки, Набор);
			Если Счет <> Неопределено Тогда
				Запрошенные.Добавить(Счет);
			ИначеЕсли Ошибки.Код = "ACCESS_DENIED" Тогда
				Частично = Истина;
			Иначе
				Возврат Отказ(Результат, Ошибки.Код, Ошибки.Текст);
			КонецЕсли;
		КонецЦикла;
		Пересечение = ИИА_БухгалтерскийДоступ.ДоступныеИзЗапрошенных(Запрошенные, Набор);
		ДоступныеСчета = Пересечение.Счета;
		Частично = Частично Или Пересечение.Частично;
	КонецЕсли;
	Если ДоступныеСчета.Количество() = 0 Тогда
		Возврат Отказ(Результат, "ACCESS_DENIED", НСтр("ru = 'Запрошенные счета недоступны ассистенту.'"));
	КонецЕсли;

	Класс = Макс(ИИА_КлассыДанных.КлассОбъекта("РегистрБухгалтерии." + ИмяПлана),
		ИИА_КлассыДанных.КлассОбъекта("ПланСчетов." + ИмяПлана));
	ВидСубконто = Неопределено;
	ТекстСубконто = СтрокаАргумента(Аргументы, "subconto");
	Если Не ПустаяСтрока(ТекстСубконто) И Не ИИА_БухгалтерскийДоступ.СубконтоДоступны() Тогда
		Возврат Отказ(Результат, "BAD_ARGUMENTS", НСтр("ru = 'В плане счетов нет субконто: уберите subconto.'"));
	ИначеЕсли Не ПустаяСтрока(ТекстСубконто) Тогда
		Ошибки = Неопределено;
		ВидСубконто = ИИА_БухгалтерскийДоступ.НайтиВидСубконто(ТекстСубконто, Ошибки);
		Если ВидСубконто = Неопределено Тогда
			Возврат Отказ(Результат, Ошибки.Код, Ошибки.Текст);
		КонецЕсли;
		Причина = "";
		КодОтказа = ИИА_БухгалтерскийДоступ.ВидСубконтоЗапрещен(ВидСубконто, Причина);
		Если ЗначениеЗаполнено(КодОтказа) Тогда
			Возврат Отказ(Результат, КодОтказа, СтрШаблон(НСтр("ru = 'Вид субконто «%1» недоступен ассистенту (%2).'"),
				ТекстСубконто, Причина));
		КонецЕсли;
		Класс = Макс(Класс, КлассТиповВидаСубконто(ВидСубконто));
	КонецЕсли;

	Запрос = Новый Запрос(ИИА_БухгалтерскийДоступ.ТекстЗапросаОстатковИОборотов(Режим, ВидСубконто <> Неопределено, ПоКорСчету));
	Запрос.УстановитьПараметр("ДоступныеСчета", ДоступныеСчета);
	Запрос.УстановитьПараметр("ДоступныеКорСчета", Набор.ДоступныеМассив);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НачалоПериода", ?(НачалоКорректно, НачалоДня(Начало), Дата(1, 1, 1)));
	Запрос.УстановитьПараметр("КонецПериода", ?(Режим = "balances", Новый Граница(КонецДня(Конец), ВидГраницы.Включая),
		КонецДня(Конец)));
	Если ВидСубконто <> Неопределено Тогда
		Запрос.УстановитьПараметр("ВидыСубконто", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВидСубконто));
	КонецЕсли;
	Попытка
		ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	Исключение
		ЗаписьЖурналаРегистрации("ИИАссистент.Инструменты", УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Отказ(Результат, "QUERY_ERROR",
			Лев(ИИА_Периметр.ОчиститьТекст(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())), 500));
	КонецПопытки;

	Выполнение = ИИА_ГраницаЗапроса.РезультатИзТаблицы(ТаблицаЗапроса, 200);
	Строки = Новый Массив;
	Для Индекс = 0 По Мин(59, Выполнение.Строки.ВГраница()) Цикл
		Строки.Добавить(Выполнение.Строки[Индекс]);
	КонецЦикла;

	Результат.Успех = Истина;
	Результат.Итог = "OK";
	Результат.Класс = Макс(Класс, Выполнение.Класс);
	Результат.Строк = Выполнение.Строки.Количество();
	Результат.Скрыто = Выполнение.Скрыто;
	Результат.ИсточникиСписков.Добавить("РегистрБухгалтерии." + ИмяПлана);
	Результат.Таблица = Новый Структура("Колонки, Строки, Объекты, ОбъектыЯчеек",
		Выполнение.Колонки, Выполнение.Строки, Выполнение.Объекты, Выполнение.ОбъектыЯчеек);
	Результат.Данные = Новый Структура("mode, period, columns, rows, truncated, partial, excluded",
		Режим, ?(Режим = "balances", КонецПериода, НачалоПериода + " - " + КонецПериода), Выполнение.Колонки, Строки,
		Выполнение.Усечено Или Выполнение.Строки.Количество() > 60, Частично,
		НСтр("ru = 'счета вне профиля и счета 69/70/71/73 исключены условием запроса'"));
	Возврат Результат;

КонецФункции

Функция НайтиОрганизацию(Текст)
	
	Запрос = Новый Запрос;
	// Без отбора организация берётся, только если она в базе одна.
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""
	|	И НЕ Организации.ПометкаУдаления";
	Запрос.УстановитьПараметр("Шаблон", "%" + ЭкранироватьПодобно(СокрЛП(Текст)) + "%");
	Выгрузка = Запрос.Выполнить().Выгрузить();
	Если Выгрузка.Количество() = 1 Или (ЗначениеЗаполнено(Текст) И Выгрузка.Количество() > 0) Тогда
		Возврат Выгрузка[0].Ссылка;
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

// Период варианта: параметры Период, НачалоПериода/ДатаНачала, КонецПериода/ДатаОкончания и ДатаОтчета (дата остатков -
// конец периода). Значение пишется в настройки варианта и в пользовательскую настройку параметра (см.
// УстановитьПараметрДанных); не перенесённое в пользовательские настройки описывается в НеПрименено.
Процедура УстановитьПериод(КомпоновщикНастроек, НачалоПериода, КонецПериода, НеПрименено)

	Если ПустаяСтрока(НачалоПериода) И ПустаяСтрока(КонецПериода) Тогда
		Возврат;
	КонецЕсли;
	НачалоКорректно = Ложь;
	КонецКорректен = Ложь;
	Начало = ПрочитатьДатуИзСтроки(НачалоПериода, НачалоКорректно);
	Конец = ПрочитатьДатуИзСтроки(КонецПериода, КонецКорректен);
	Если КонецКорректен Тогда
		Конец = КонецДня(Конец);
	КонецЕсли;

	// Если период варианта перенесён в пользовательскую настройку «Период», границы НачалоПериода/КонецПериода
	// отчёт вычисляет из неё сам: их отсутствие в пользовательских настройках не делает период неприменённым.
	ГраницыИзПериода = Ложь;
	Для Каждого Параметр Из КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы Цикл
		Если ВРег(Строка(Параметр.Параметр)) = "ПЕРИОД" И ТипЗнч(Параметр.Значение) = Тип("СтандартныйПериод")
			И ПользовательскаяНастройка(КомпоновщикНастроек, Параметр) <> Неопределено
			И Параметр.РежимОтображения <> РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный Тогда
			ГраницыИзПериода = Истина;
		КонецЕсли;
	КонецЦикла;
	НеПримененоГраниц = ?(ГраницыИзПериода, Новый Массив, НеПрименено);

	Для Каждого Параметр Из КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы Цикл
		ИмяПараметра = ВРег(Строка(Параметр.Параметр));
		НеПримененоПараметра = НеПрименено;
		Если ИмяПараметра = "ПЕРИОД" И ТипЗнч(Параметр.Значение) = Тип("СтандартныйПериод") Тогда
			Значение = Новый СтандартныйПериод;
			Значение.ДатаНачала = ?(НачалоКорректно, Начало, Дата(1, 1, 1));
			Значение.ДатаОкончания = ?(КонецКорректен, Конец, Дата(1, 1, 1));
			Представление = СтрШаблон("%1 - %2", Формат(Значение.ДатаНачала, "ДЛФ=D"), Формат(Значение.ДатаОкончания, "ДЛФ=D"));
		ИначеЕсли (ИмяПараметра = "НАЧАЛОПЕРИОДА" Или ИмяПараметра = "ДАТАНАЧАЛА") И НачалоКорректно Тогда
			Значение = ЗначениеДатыПараметра(Параметр.Значение, Начало);
			Представление = Формат(Начало, "ДЛФ=D");
			НеПримененоПараметра = НеПримененоГраниц;
		ИначеЕсли (ИмяПараметра = "КОНЕЦПЕРИОДА" Или ИмяПараметра = "ДАТАОКОНЧАНИЯ") И КонецКорректен Тогда
			Значение = ЗначениеДатыПараметра(Параметр.Значение, Конец);
			Представление = Формат(Конец, "ДЛФ=D");
			НеПримененоПараметра = НеПримененоГраниц;
		ИначеЕсли ИмяПараметра = "ДАТАОТЧЕТА" И (КонецКорректен Или НачалоКорректно) Тогда
			Значение = ЗначениеДатыПараметра(Параметр.Значение, ?(КонецКорректен, Конец, Начало));
			Представление = Формат(?(КонецКорректен, Конец, Начало), "ДЛФ=D");
		Иначе
			Продолжить;
		КонецЕсли;
		УстановитьПараметрДанных(КомпоновщикНастроек, Параметр, Значение,
			Строка(Параметр.Параметр) + " = " + Представление, НеПримененоПараметра);
	КонецЦикла;

КонецПроцедуры

// Дата для параметра периода: стандартная дата начала (как ДатаОтчета в ERP) или дата.
Функция ЗначениеДатыПараметра(ТекущееЗначение, Дата)

	Если ТипЗнч(ТекущееЗначение) = Тип("СтандартнаяДатаНачала") Тогда
		Возврат Новый СтандартнаяДатаНачала(Дата);
	КонецЕсли;
	Возврат Дата;

КонецФункции

// Табличный документ -> компактная таблица строк. Пустые строки пропускаются, текст проходит детекторы.
Функция КомпактнаяТаблица(ТабличныйДокумент, МаксимумСтрок, МаксимумКолонок)

	Результат = Новый Структура("Колонки, Строки, Усечено, Скрыто", Новый Массив, Новый Массив, Ложь, 0);
	Высота = ТабличныйДокумент.ВысотаТаблицы;
	Ширина = Мин(ТабличныйДокумент.ШиринаТаблицы, МаксимумКолонок);
	Для НомерКолонки = 1 По Ширина Цикл
		Результат.Колонки.Добавить("C" + НомерКолонки);
	КонецЦикла;

	Скрыто = 0;
	Для НомерСтроки = 1 По Высота Цикл
		Значения = Новый Массив;
		ЕстьДанные = Ложь;
		Для НомерКолонки = 1 По Ширина Цикл
			Текст = СокрЛП(ТабличныйДокумент.Область(НомерСтроки, НомерКолонки).Текст);
			Если Не ПустаяСтрока(Текст) Тогда
				ЕстьДанные = Истина;
				Текст = Лев(ИИА_Периметр.ОчиститьТекст(Текст, Скрыто), 200);
			КонецЕсли;
			Значения.Добавить(Текст);
		КонецЦикла;
		Если Не ЕстьДанные Тогда
			Продолжить;
		КонецЕсли;
		Если Результат.Строки.Количество() >= МаксимумСтрок Тогда
			Результат.Усечено = Истина;
			Прервать;
		КонецЕсли;
		Результат.Строки.Добавить(Значения);
	КонецЦикла;
	// Наименования объектов списка коммерческого маскирования в ячейках - псевдонимами (пакетно).
	Если ИИА_Маскирование.ДействуетКоммерческоеМаскирование() Тогда
		Тексты = Новый Массив;
		Для Каждого Значения Из Результат.Строки Цикл
			Для Каждого Текст Из Значения Цикл
				Тексты.Добавить(Текст);
			КонецЦикла;
		КонецЦикла;
		Тексты = ИИА_Маскирование.ТекстыДляМодели(Тексты, Скрыто);
		Индекс = 0;
		Для Каждого Значения Из Результат.Строки Цикл
			Для НомерКолонки = 0 По Значения.ВГраница() Цикл
				Значения[НомерКолонки] = Тексты[Индекс];
				Индекс = Индекс + 1;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	Результат.Скрыто = Скрыто;
	Возврат Результат;

КонецФункции

Функция ОбъектМетаданныхОтчета(Отчет)

	Если ТипЗнч(Отчет) = Тип("Строка") Тогда
		Возврат Неопределено; // внешние отчёты на этапе 1 не поддерживаются
	КонецЕсли;
	Попытка
		ОбъектМетаданных = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(Отчет, Ложь);
	Исключение
		ЗаписьЖурналаРегистрации("ИИАссистент.Инструменты", УровеньЖурналаРегистрации.Ошибка, , ,
			"REPORT_METADATA_LOOKUP_ERROR");
		Возврат Неопределено;
	КонецПопытки;
	// Для удалённого отчёта или отчёта расширения, которое не подключено, возвращается не объект метаданных.
	Возврат ?(ТипЗнч(ОбъектМетаданных) = Тип("ОбъектМетаданных"), ОбъектМетаданных, Неопределено);

КонецФункции

// Отчёт вне периметра: входит в разделы кадров и зарплаты или в бухгалтерское семейство
// (на этапе 1 бухгалтерские отчёты - только через адаптер с отбором по доступным счетам, см. СформироватьБухгалтерскийОтчет).
Функция ОтчетВнеПериметра(ОбъектМетаданных)

	Если ИИА_Периметр.ОбъектЗапрещен(ОбъектМетаданных.ПолноеИмя()) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат БухгалтерскиеОтчеты().Найти(ОбъектМетаданных.Имя) <> Неопределено;

КонецФункции

Функция БухгалтерскиеОтчеты()

	Возврат СтрРазделить("ОборотноСальдоваяВедомость,ОборотноСальдоваяВедомостьПоСчету,АнализСчета,КарточкаСчета,"
		+ "АнализСубконто,КарточкаСубконто,ОборотыСчета,ОборотыМеждуСубконто,ГлавнаяКнига,ОтчетПоПроводкам,СводныеПроводки", ",");

КонецФункции

Функция ЭкранироватьПодобно(Текст)

	Результат = Текст;
	Для Каждого Символ Из СтрРазделить("~,%,_,[,],^", ",") Цикл
		Результат = СтрЗаменить(Результат, Символ, "~" + Символ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ДополнительныеИнструменты

Функция ИмяИнструмента(Инструмент)

	Если ТипЗнч(Инструмент) <> Тип("Соответствие") Или ТипЗнч(Инструмент.Получить("function")) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	Имя = Инструмент.Получить("function").Получить("name");
	Возврат ?(ТипЗнч(Имя) = Тип("Строка"), Имя, "");

КонецФункции

// Режим дополнительного инструмента; при первом появлении регистрирует его как «Новый».
// Возвращает "" для инструмента, которого нет среди дополнительных.
Функция РежимДополнительногоИнструмента(Имя, Зарегистрировать)

	УстановитьПривилегированныйРежим(Истина);
	Запись = РегистрыСведений.ИИА_РежимыИнструментов.СоздатьМенеджерЗаписи();
	Запись.Инструмент = Имя;
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		Возврат Запись.Режим;
	КонецЕсли;
	Если Не Зарегистрировать Тогда
		// Вызов инструмента, которого нет в списке: проверяем, объявлен ли он расширением.
		Дополнительные = Новый Массив;
		ИИА_ИнструментыПереопределяемый.ПриОпределенииИнструментов(Дополнительные);
		Объявлен = Ложь;
		Для Каждого Инструмент Из Дополнительные Цикл
			Если ИмяИнструмента(Инструмент) = Имя Тогда
				Объявлен = Истина;
			КонецЕсли;
		КонецЦикла;
		Если Не Объявлен Тогда
			Возврат "";
		КонецЕсли;
	КонецЕсли;
	Запись.Инструмент = Имя;
	Запись.Режим = "Новый";
	Запись.ДатаПоявления = ТекущаяДатаСеанса();
	Запись.Источник = НСтр("ru = 'ИИА_ИнструментыПереопределяемый'");
	Попытка
		Запись.Записать();
	Исключение
		// Параллельная регистрация тем же инструментом - не ошибка.
		ЗаписьЖурналаРегистрации("ИИАссистент.Инструменты", УровеньЖурналаРегистрации.Предупреждение, , ,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат "Новый";

КонецФункции

Процедура ОтметитьОтказ(Имя)

	УстановитьПривилегированныйРежим(Истина);
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ИИА_РежимыИнструментов");
	ЭлементБлокировки.УстановитьЗначение("Инструмент", Имя);
	НачатьТранзакцию();
	Попытка
		Блокировка.Заблокировать();
		Запись = РегистрыСведений.ИИА_РежимыИнструментов.СоздатьМенеджерЗаписи();
		Запись.Инструмент = Имя;
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			Запись.Отказов = Запись.Отказов + 1;
			Запись.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации("ИИАссистент.Инструменты", УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область Общее

Функция Отказ(Результат, Код, Текст)

	Результат.Успех = Ложь;
	Результат.Итог = Код;
	Результат.Данные = Новый Структура("error, message", Код, Текст);
	Возврат Результат;

КонецФункции

Функция СтрокаАргумента(Аргументы, Имя)

	Значение = Аргументы.Получить(Имя);
	Возврат ?(ТипЗнч(Значение) = Тип("Строка"), Значение, "");

КонецФункции

Функция СписокПолейПараметра(Описание)

	Свойство = Новый Соответствие;
	Свойство.Вставить("type", "array");
	Свойство.Вставить("items", СвойствоПараметра("string", ""));
	Свойство.Вставить("description", Описание);
	Возврат Свойство;

КонецФункции

// Непустые строки массива-аргумента.
Функция СписокСтрокАргумента(Аргументы, Имя)

	Результат = Новый Массив;
	Значения = Аргументы.Получить(Имя);
	Если ТипЗнч(Значения) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Значение Из Значения Цикл
		Если ТипЗнч(Значение) = Тип("Строка") И Не ПустаяСтрока(Значение) Тогда
			Результат.Добавить(СокрЛП(Значение));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ОписаниеИнструмента(Имя, Описание, Свойства, Обязательные)

	Схема = Новый Соответствие;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", СтрРазделить(Обязательные, ",", Ложь));

	Функция_ = Новый Соответствие;
	Функция_.Вставить("name", Имя);
	Функция_.Вставить("description", Описание);
	Функция_.Вставить("parameters", Схема);

	Инструмент = Новый Соответствие;
	Инструмент.Вставить("type", "function");
	Инструмент.Вставить("function", Функция_);
	Возврат Инструмент;

КонецФункции

Функция СвойстваПараметров(Имя, Тип, Описание)

	Свойства = Новый Соответствие;
	Свойства.Вставить(Имя, СвойствоПараметра(Тип, Описание));
	Возврат Свойства;

КонецФункции

Функция СвойствоПараметра(Тип, Описание)

	Свойство = Новый Соответствие;
	Свойство.Вставить("type", Тип);
	Свойство.Вставить("description", Описание);
	Возврат Свойство;

КонецФункции

