Функция БезопасныйТекст(Текст)

	Строки = Новый Массив;
	Строки.Добавить(Текст);
	Возврат ОчиститьКод(Строки);

КонецФункции

// Очищает строки кода по одной, сохраняя переносы: строковые литералы в строках с именами секретов
// (пароль, токен, ключ API) заменяются, остальное проходит общие детекторы ПДн и секретов.
Функция ОчиститьКод(Строки, КоличествоЗамен = 0)

	Результат = Новый Массив;
	Для Каждого СтрокаКода Из Строки Цикл
		Если ИИА_Периметр.ЭтоИмяСекрета(СтрокаКода) Тогда
			Литералы = СтрНайтиВсеПоРегулярномуВыражению(СтрокаКода, """[^""]{3,}""");
			Для Индекс = -Литералы.ВГраница() По 0 Цикл
				Литерал = Литералы[-Индекс];
				СтрокаКода = Лев(СтрокаКода, Литерал.НачальнаяПозиция - 1) + НСтр("ru = '""[секрет удалён]""'")
					+ Сред(СтрокаКода, Литерал.НачальнаяПозиция + Литерал.Длина);
				КоличествоЗамен = КоличествоЗамен + 1;
			КонецЦикла;
		КонецЕсли;
		Результат.Добавить(ИИА_Периметр.ОчиститьТекст(СтрокаКода, КоличествоЗамен));
	КонецЦикла;
	Возврат СтрСоединить(Результат, Символы.ПС);

КонецФункции

