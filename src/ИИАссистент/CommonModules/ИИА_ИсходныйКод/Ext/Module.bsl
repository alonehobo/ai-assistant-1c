// BSLLS:CommonModuleInvalidType-off
// Только сервер: вызов с клиента и внешнее соединение намеренно отключены.
// BSLLS:CommonModuleInvalidType-on
// /////////////////////////////////////////////////////////////////////////////////////////////////////
// ИИ-ассистент: исходный код конфигурации для ИТ-ролей (план, раздел 7, слой 3).
// Индекс исходников ведёт внешний сервис rlm-tools-bsl (MCP по HTTP): в базе 1С не хранится ни индекс,
// ни текст кода. В настройках задаются адрес сервиса и проект rlm - имя из реестра rlm (путь не допускается).
// Модель пишет Python для rlm_execute сама: песочница rlm разрешает только чтение исходников проекта
// и безопасные модули, здесь - лимиты хода, очистка вывода от секретов и ПДн и журнал.
// Каждая открытая сессия rlm закрывается (rlm_end) после хода или служебного вызова: сервер держит
// ограниченное число сессий, и незакрытые сессии блокируют поиск по коду.
// Доступ - всем пользователям чата, если сервис настроен; профиль может выключить rlm_execute
// на вкладке «Инструменты». Класс допуска для кода не проверяется: код, включая доработки, относится к К1.
// /////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Доступен ли исходный код текущему пользователю (без обращения к сервису).
//
// Возвращаемое значение:
//  Булево
//
Функция КодДоступен() Экспорт

	Возврат ЗначениеЗаполнено(Проект()) И ЗначениеЗаполнено(АдресСервиса());

КонецФункции

// Проект rlm-tools-bsl из настроек: имя проекта из реестра rlm.
//
// Возвращаемое значение:
//  Строка
//
Функция Проект() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Возврат СокрЛП(Константы.ИИА_КаталогИсходников.Получить());

КонецФункции

// Указан ли вместо имени проекта rlm путь к выгрузке. Исследование работает только с проектами
// из реестра rlm, путь отклоняется при записи настроек и в проверках.
//
// Параметры:
//  ПроектRLM - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция ПроектЗаданПутем(ПроектRLM) Экспорт

	Возврат СтрНайти(ПроектRLM, ":") > 0 Или СтрНайти(ПроектRLM, "/") > 0 Или СтрНайти(ПроектRLM, "\") > 0;

КонецФункции

// Текст ошибки для проекта, заданного путём.
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстОшибкиПроектаПутем() Экспорт

	Возврат НСтр("ru = 'Укажите имя проекта из реестра rlm-tools-bsl (например «АТ»), а не путь к выгрузке исходников.'");

КонецФункции

// Адрес MCP-сервиса rlm-tools-bsl из настроек.
//
// Возвращаемое значение:
//  Строка
//
Функция АдресСервиса() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Возврат СокрЛП(Константы.ИИА_АдресRLM.Получить());

КонецФункции

// Открывает новую сессию rlm и возвращает сведения об индексе проекта (для формы настроек).
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * Текст - Строка - описание состояния или ошибки.
//
Функция ПроверитьПодключение() Экспорт

	Результат = Новый Структура("Успех, Текст", Ложь, "");
	Если ПустаяСтрока(Проект()) Или ПустаяСтрока(АдресСервиса()) Тогда
		Результат.Текст = НСтр("ru = 'Не заданы адрес сервиса rlm-tools-bsl или проект.'");
		Возврат Результат;
	КонецЕсли;
	Если ПроектЗаданПутем(Проект()) Тогда
		Результат.Текст = ТекстОшибкиПроектаПутем();
		Возврат Результат;
	КонецЕсли;
	Попытка
		Сессия = НачатьСессию();
	Исключение
		ЗаписьЖурналаРегистрации("ИИАссистент.ИсходныйКод", УровеньЖурналаРегистрации.Ошибка, , ,
			БезопасныйТекст(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		Результат.Текст = "Сервис исходников недоступен.";
		Возврат Результат;
	КонецПопытки;
	ЗавершитьСессию(Сессия.Идентификатор);
	Индекс = Сессия.Индекс;
	Результат.Успех = Истина;
	Если ТипЗнч(Индекс) = Тип("Соответствие") И Индекс.Получить("loaded") = Истина Тогда
		Результат.Текст = СтрШаблон(НСтр("ru = 'Подключено. Индекс rlm: методов %1, вызовов %2. Каталог: %3'"),
			Формат(Индекс.Получить("methods"), "ЧГ=3,0"), Формат(Индекс.Получить("calls"), "ЧГ=3,0"), Сессия.Каталог);
	Иначе
		Результат.Текст = СтрШаблон(НСтр("ru = 'Подключено, но индекс rlm для проекта не построен - поиск будет медленным. Каталог: %1'"),
			Сессия.Каталог);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Тестовый запрос к rlm-tools-bsl для формы настроек: открывает сессию, ищет общий модуль
// ОбщегоНазначения и его метод ЗначениеВJSON (есть в любой конфигурации на БСП), сверяет найденные
// пути с ожидаемыми и закрывает сессию.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево - контрольные модуль и метод найдены, сессия закрыта.
//   * Текст - Строка - итог для пользователя.
//
Функция ВыполнитьТестовыйЗапрос() Экспорт

	Результат = Новый Структура("Успех, Текст", Ложь, "");
	Если ПустаяСтрока(Проект()) Или ПустаяСтрока(АдресСервиса()) Тогда
		Результат.Текст = НСтр("ru = 'Не заданы адрес сервиса rlm-tools-bsl или проект.'");
		Возврат Результат;
	КонецЕсли;
	Если ПроектЗаданПутем(Проект()) Тогда
		Результат.Текст = ТекстОшибкиПроектаПутем();
		Возврат Результат;
	КонецЕсли;

	Модуль = "CommonModules/ОбщегоНазначения/Ext/Module.bsl";
	Код = "import json
	|modules = find_module(name='ОбщегоНазначения', category='CommonModules', limit=50)
	|methods = search_methods('ЗначениеВJSON', limit=20)
	|print(json.dumps({'modules': [m.get('path') for m in modules if isinstance(m, dict)],
	|    'methods': [m.get('module_path') for m in methods if isinstance(m, dict) and m.get('name') == 'ЗначениеВJSON']}))";
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Сессия = "";
	Попытка
		Сессия = НачатьСессию().Идентификатор;
		Данные = ВыводФрагмента(ВыполнитьВСессии(Сессия, Код));
	Исключение
		ЗаписьЖурналаРегистрации("ИИАссистент.ИсходныйКод", УровеньЖурналаРегистрации.Ошибка, , ,
			БезопасныйТекст(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		ЗавершитьСессию(Сессия);
		Результат.Текст = НСтр("ru = 'Тестовый запрос не выполнен: сервис rlm-tools-bsl недоступен или вернул ошибку. Подробности - в журнале регистрации.'");
		Возврат Результат;
	КонецПопытки;
	Закрыта = ЗавершитьСессию(Сессия);
	Секунд = Формат((ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000, "ЧДЦ=1; ЧН=0");

	Модули = Данные.Получить("modules");
	Методы = Данные.Получить("methods");
	НайденМодуль = ТипЗнч(Модули) = Тип("Массив") И Модули.Найти(Модуль) <> Неопределено;
	НайденМетод = ТипЗнч(Методы) = Тип("Массив") И Методы.Найти(Модуль) <> Неопределено;
	Если Не НайденМодуль Или Не НайденМетод Тогда
		Результат.Текст = СтрШаблон(НСтр("ru = 'Сервис ответил за %1 с, но не нашёл контрольный %2 «%3»: проверьте проект и индекс rlm.'"),
			Секунд, ?(НайденМодуль, НСтр("ru = 'метод'"), НСтр("ru = 'общий модуль'")),
			?(НайденМодуль, "ОбщегоНазначения.ЗначениеВJSON", "ОбщегоНазначения"));
	ИначеЕсли Не Закрыта Тогда
		Результат.Текст = СтрШаблон(НСтр("ru = 'Поиск выполнен за %1 с, но сессию rlm закрыть не удалось: она будет занимать место до истечения на сервере. Проверьте версию rlm-tools-bsl.'"),
			Секунд);
	Иначе
		Результат.Успех = Истина;
		Результат.Текст = СтрШаблон(НСтр("ru = 'Тестовый запрос выполнен за %1 с: найдены общий модуль ОбщегоНазначения и метод ЗначениеВJSON. Сессия закрыта.'"),
			Секунд);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Закрывает сессию исследования хода, если она открыта. Вызывается при завершении хода.
//
// Параметры:
//  Состояние - Структура, Неопределено - см. НовыйКонтекстИсследования.
//
Процедура ЗакрытьСессиюИсследования(Состояние) Экспорт

	Если ТипЗнч(Состояние) <> Тип("Структура") Или Не Состояние.Свойство("ИдентификаторСессии") Тогда
		Возврат;
	КонецЕсли;
	ЗавершитьСессию(Состояние.ИдентификаторСессии);
	Состояние.ИдентификаторСессии = "";

КонецПроцедуры

// Описания инструментов исходного кода в формате OpenAI tools (только если код доступен пользователю).
//
// Параметры:
//  Канал - Строка - "chat": структуру формы построит клиент (см. ИИА_Агент, пауза хода), form_layout доступен
//    и без исходного кода; "http" - внешний API.
//
// Возвращаемое значение:
//  Массив из Соответствие
//
Функция ОписанияИнструментов(Канал = "http") Экспорт

	Инструменты = Новый Массив;
	Если Не КодДоступен() Тогда
		Если Канал = "chat" Тогда
			Инструменты.Добавить(ОписаниеСтруктурыФормы());
		КонецЕсли;
		Возврат Инструменты;
	КонецЕсли;

	Инструменты.Добавить(ОписаниеИнструмента("code_movements",
		НСтр("ru = 'Для документа - регистры, по которым он делает движения; для регистра - документы-регистраторы. По метаданным базы.'"),
		СвойстваПараметров("name", "string", НСтр("ru = 'Полное имя документа или регистра.'")), "name"));
	Инструменты.Добавить(ОписаниеСтруктурыФормы());
	Если ИИА_LLM.ЕстьПодключениеДляИсследования(1) И Не ИсследованиеЗапрещеноПрофилем() Тогда
		Инструменты.Добавить(ОписаниеИнструмента("rlm_execute", ОписаниеВыполненияКода(),
			СвойстваПараметров("code", "string", "Python; результат выводи через print()."), "code"));
	КонецЕсли;

	Возврат Инструменты;

КонецФункции

// Нужна ли инструменту структура формы, которую строит клиент чата: ход с присоединённым окном ставится на паузу
// (см. ИИА_Агент.ВыполнитьХод), иначе инструмент выполняется по серверному пути.
//
// Параметры:
//  Имя - Строка - имя инструмента.
//
// Возвращаемое значение:
//  Булево
//
Функция ИнструментТребуетСтруктуруФормы(Имя) Экспорт

	Возврат Имя = "form_layout" Или Имя = "field_visibility";

КонецФункции

// Выполняет инструмент исходного кода.
//
// Параметры:
//  Имя - Строка
//  Аргументы - Соответствие
//  Результат - Структура - см. ИИА_Инструменты.ВыполнитьИнструмент.
//  Исследование - Структура, Неопределено - состояние хода; без него сессия живёт один вызов.
//  СтруктурыФорм - Соответствие, Неопределено - структуры форм, построенные клиентом чата (см. ОписатьФорму).
//
// Возвращаемое значение:
//  Структура
//
Функция ВыполнитьИнструмент(Имя, Аргументы, Результат, Исследование = Неопределено, СтруктурыФорм = Неопределено) Экспорт

	Если Не КодДоступен() И Не (Имя = "form_layout" И СтруктурыФорм <> Неопределено) Тогда
		Возврат Отказ(Результат, "ACCESS_DENIED", НСтр("ru = 'Исходный код недоступен: не настроен сервис rlm-tools-bsl (проект и адрес в настройках ассистента).'"));
	КонецЕсли;

	Если Имя = "code_movements" Тогда
		Возврат НайтиДвижения(Результат, СтрокаАргумента(Аргументы, "name"));
	КонецЕсли;
	Если Имя = "form_layout" Тогда
		Попытка
			Возврат ОписатьФорму(Результат, СтрокаАргумента(Аргументы, "object"), СтрокаАргумента(Аргументы, "form"),
				СтрокаАргумента(Аргументы, "section"), СтруктурыФорм);
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'ИИАссистент.ИсходныйКод'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка, , , ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат Отказ(Результат, "SERVICE_UNAVAILABLE",
				НСтр("ru = 'Сервис исходного кода (rlm-tools-bsl) недоступен или вернул ошибку. Подробности - в журнале регистрации.'"));
		КонецПопытки;
	КонецЕсли;
	Если Имя <> "rlm_execute" Тогда
		Возврат Отказ(Результат, "UNKNOWN_TOOL", "Неизвестный инструмент исходного кода.");
	КонецЕсли;

	Если Исследование <> Неопределено Тогда
		Возврат ВыполнитьИсследование(Имя, Аргументы, Результат, Исследование);
	КонецЕсли;
	// Отдельный вызов без хода: сессия живёт только в пределах этого вызова.
	Исследование = НовыйКонтекстИсследования();
	ВыполнитьИсследование(Имя, Аргументы, Результат, Исследование);
	ЗакрытьСессиюИсследования(Исследование);
	Возврат Результат;

КонецФункции

// Строковый литерал Python, в котором всё, кроме латинских букв, цифр и безопасных знаков, записано
// escape-последовательностями: текст аргумента не может выйти за пределы литерала.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ЛитералPython(Текст) Экспорт

	Безопасные = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 _-.,:/{}[]";
	Части = Новый Массив;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если СтрНайти(Безопасные, Символ) > 0 Тогда
			Части.Добавить(Символ);
		Иначе
			Код = КодСимвола(Символ);
			Если Код > 65535 Тогда
				Части.Добавить("\U" + ЧислоВШестнадцатеричное(Код, 8));
			Иначе
				Части.Добавить("\u" + ЧислоВШестнадцатеричное(Код, 4));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат "'" + СтрСоединить(Части) + "'";

КонецФункции


// Возвращает состояние исследования отдельного хода; сессия rlm открывается лениво.
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги, Неопределено - только доступный текущему пользователю.
//  Модель - СправочникСсылка.ИИА_Модели, Неопределено - явный выбор не подменяется.
// Возвращаемое значение:
//  Структура - Успех, Ошибка, КлассДанных, КонтрольнаяТочка и внутренние поля хода.
Функция НовыйКонтекстИсследования(Диалог = Неопределено, Модель = Неопределено) Экспорт

	Состояние = Новый Структура;
	Состояние.Вставить("Успех", Ложь);
	Состояние.Вставить("Ошибка", "");
	Состояние.Вставить("Диалог", Диалог);
	Состояние.Вставить("Модель", Модель);
	Состояние.Вставить("Проект", Проект());
	Состояние.Вставить("Адрес", АдресСервиса());
	Состояние.Вставить("Пользователь", Пользователи.ТекущийПользователь());
	Состояние.Вставить("Профиль", ИИА_ПрофилиДоступа.ЭффективныйПрофиль(Состояние.Пользователь));
	Состояние.Вставить("КлассДанных", 1);
	Состояние.Вставить("КонтрольнаяТочка", Новый Массив);
	Состояние.Вставить("ИдентификаторСессии", "");
	Состояние.Вставить("Помощники", Новый Массив);
	Состояние.Вставить("ЧислоВыполнений", 0);
	Состояние.Вставить("Восстановления", 0);
	Состояние.Вставить("Начало", ТекущаяУниверсальнаяДатаВМиллисекундах());
	Состояние.Вставить("ПредельныйМомент", Состояние.Начало + 300000);
	Состояние.Вставить("ПредупрежденияИндекса", Новый Массив);
	Состояние.Вставить("Расширения", Новый Массив);
	Состояние.Ошибка = ОшибкаКонтекстаИсследования(Состояние);
	Состояние.Успех = ПустаяСтрока(Состояние.Ошибка);
	Возврат Состояние;

КонецФункции

// Повторно выполняет код из контрольной точки в новой сессии: модель получает свежий вывод,
// а не сохранённый текст. Записи другого формата (прежние версии) пропускаются.
// Параметры:
//  Исследование - Структура - результат НовыйКонтекстИсследования.
//  КонтрольнаяТочка - Массив - элементы {code}.
// Возвращаемое значение:
//  Структура - Успех, Ошибка, Данные.
Функция ВосстановитьКонтрольнуюТочку(Исследование, КонтрольнаяТочка) Экспорт

	Ответ = Новый Структура("Успех, Ошибка, Данные", Ложь, "", Новый Массив);
	Ответ.Ошибка = ОшибкаКонтекстаИсследования(Исследование);
	Если Не ПустаяСтрока(Ответ.Ошибка) Тогда
		Возврат Ответ;
	КонецЕсли;
	Если ТипЗнч(КонтрольнаяТочка) <> Тип("Массив") Или КонтрольнаяТочка.Количество() > 10 Тогда
		Ответ.Ошибка = "BAD_CHECKPOINT";
		Возврат Ответ;
	КонецЕсли;
	Для Каждого Указатель Из КонтрольнаяТочка Цикл
		Код = КодУказателя(Указатель);
		Если Код = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Аргументы = Новый Соответствие;
		Аргументы.Вставить("code", Код);
		Результат = Новый Структура("Успех, Итог, Данные, Класс, Строк, Скрыто", Ложь, "", Неопределено, 1, 0, 0);
		Результат = ВыполнитьИнструмент("rlm_execute", Аргументы, Результат, Исследование);
		Если Не Результат.Успех И Результат.Итог <> "PYTHON_ERROR" Тогда
			Ответ.Ошибка = Результат.Итог;
			Возврат Ответ;
		КонецЕсли;
		Ответ.Данные.Добавить(Результат.Данные);
	КонецЦикла;
	Ответ.Успех = Истина;
	Возврат Ответ;

КонецФункции

// Возвращает код успешных выполнений хода для хранения: до 10 фрагментов по 4000 символов.
// Параметры:
//  Исследование - Структура - доверенное внутреннее состояние текущего хода.
// Возвращаемое значение:
//  Массив из Соответствие - элементы {code}.
Функция КонтрольнаяТочкаДляХранения(Исследование) Экспорт

	Ответ = Новый Массив;
	Если ТипЗнч(Исследование) <> Тип("Структура") Или Не Исследование.Свойство("КонтрольнаяТочка") Тогда
		Возврат Ответ;
	КонецЕсли;
	Для Каждого Указатель Из Исследование.КонтрольнаяТочка Цикл
		Код = КодУказателя(Указатель);
		Если Код = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Элемент = Новый Соответствие;
		Элемент.Вставить("code", Код);
		Ответ.Добавить(Элемент);
		Если Ответ.Количество() >= 10 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Ответ;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Инструменты

Функция НайтиДвижения(Результат, ПолноеИмя)

	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(СокрЛП(ПолноеИмя));
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Отказ(Результат, "NOT_FOUND", СтрШаблон(НСтр("ru = 'Объект %1 не найден.'"), ПолноеИмя));
	КонецЕсли;
	Имена = Новый Массив;
	Если Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
		Для Каждого Регистр Из ОбъектМетаданных.Движения Цикл
			Имена.Добавить(Регистр.ПолноеИмя());
		КонецЦикла;
		Ключ = "registers";
	Иначе
		Для Каждого Документ Из Метаданные.Документы Цикл
			Если Документ.Движения.Содержит(ОбъектМетаданных) Тогда
				Имена.Добавить(Документ.ПолноеИмя());
			КонецЕсли;
		КонецЦикла;
		Ключ = "recorders";
	КонецЕсли;
	Результат.Успех = Истина;
	Результат.Итог = "OK";
	Результат.Строк = Имена.Количество();
	Результат.Данные = Новый Структура("object", ОбъектМетаданных.ПолноеИмя());
	Результат.Данные.Вставить(Ключ, Имена);
	Возврат Результат;

КонецФункции

// Форма, которую строит клиент чата для инструмента (form_layout, field_visibility), и ключ её структуры в кэше
// СтруктурыФорм. Ключ - полное имя формы; для field_visibility с id - «полное имя формы#УИД ссылки»: клиент создаёт
// форму с этим объектом (ПолучитьФорму с параметром Ключ), видимость считается с его данными.
//
// Параметры:
//  Имя - Строка - имя инструмента.
//  Аргументы - Строка, Соответствие - аргументы инструмента (JSON или разобранные).
//  ОбъектыХода - Массив из Структура, Неопределено - объекты хода для id o1, o2…
//  Контекст - ЛюбаяСсылка, Неопределено - объект, из которого открыт чат (id = "@context").
//
// Возвращаемое значение:
//  Структура:
//   * Ключ - Строка - ключ структуры; пусто - форма не определена (см. Ошибка).
//   * Форма - Строка - полное имя формы для ПолучитьФорму.
//   * КлючОбъекта - ЛюбаяСсылка, Неопределено - проверенный объект формы.
//   * Ошибка - Строка - код отказа: BAD_ARGUMENTS, NOT_FOUND, PERIMETER_VIOLATION, ACCESS_DENIED, NO_CONTEXT.
//   * Текст - Строка - причина для модели.
//   * ОбъектМетаданных - ОбъектМетаданных, Неопределено
//   * ФормаМетаданных - ОбъектМетаданных, Неопределено
//
Функция КлючСтруктурыФормыИнструмента(Имя, Знач Аргументы, ОбъектыХода = Неопределено, Контекст = Неопределено) Экспорт

	Описание = Новый Структура("Ключ, Форма, КлючОбъекта, Ошибка, Текст, ОбъектМетаданных, ФормаМетаданных",
		"", "", Неопределено, "", "", Неопределено, Неопределено);
	Если ТипЗнч(Аргументы) = Тип("Строка") Тогда
		Попытка
			Аргументы = ОбщегоНазначения.JSONВЗначение(Аргументы, , Истина);
		// Неверные аргументы разберёт сам инструмент.
		Исключение // BSLLS:MissingCodeTryCatchEx-off
			Аргументы = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
		Описание.Ошибка = "BAD_ARGUMENTS";
		Описание.Текст = НСтр("ru = 'Аргументы инструмента должны быть JSON-объектом.'");
		Возврат Описание;
	КонецЕсли;
	Форма = ФормаИнструмента(СтрокаАргумента(Аргументы, "object"), СтрокаАргумента(Аргументы, "form"));
	ЗаполнитьЗначенияСвойств(Описание, Форма, "Ошибка, Текст, ОбъектМетаданных, ФормаМетаданных");
	Если Не ПустаяСтрока(Описание.Ошибка) Тогда
		Возврат Описание;
	КонецЕсли;
	Описание.Форма = Форма.ФормаМетаданных.ПолноеИмя();

	Идентификатор = СтрокаАргумента(Аргументы, "id");
	Если Имя = "field_visibility" И Не ПустаяСтрока(Идентификатор) Тогда
		Код = "";
		Ссылка = ИИА_Диагностика.ОбъектПоИдентификатору(Идентификатор, ОбъектыХода, Контекст, Код);
		Если Ссылка = Неопределено Тогда
			Описание.Ошибка = Код;
			Описание.Текст = НСтр("ru = 'Объект id недоступен: возьми id из objects результата (o1, o2…) или передай ""@context"".'");
			Возврат Описание;
		ИначеЕсли Ссылка.Метаданные() <> Форма.ОбъектМетаданных Тогда
			Описание.Ошибка = "BAD_ARGUMENTS";
			Описание.Текст = НСтр("ru = 'Объект id другого вида, чем object.'");
			Возврат Описание;
		КонецЕсли;
		Описание.КлючОбъекта = Ссылка;
		Описание.Ключ = Описание.Форма + "#" + Строка(Ссылка.УникальныйИдентификатор());
	Иначе
		Описание.Ключ = Описание.Форма;
	КонецЕсли;
	Возврат Описание;

КонецФункции

// Структура формы: дерево вкладок, групп, полей и кнопок с заголовками. Основной источник - структура, которую
// построил клиент чата по форме, созданной ПолучитьФорму (после её кода и расширений); иначе - разметка Form.xml
// из выгрузки через rlm, без исполнения кода формы.
Функция ОписатьФорму(Результат, ПолноеИмя, ИмяФормы, Раздел, СтруктурыФорм = Неопределено)

	Форма = ФормаИнструмента(ПолноеИмя, ИмяФормы);
	Если Не ПустаяСтрока(Форма.Ошибка) Тогда
		Возврат Отказ(Результат, Форма.Ошибка, Форма.Текст);
	КонецЕсли;
	ОбъектМетаданных = Форма.ОбъектМетаданных;
	ФормаМетаданных = Форма.ФормаМетаданных;
	ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	Путь = Форма.Путь;

	Виды = ВидыЭлементовФормы();
	СтруктураКлиента = ?(СтруктурыФорм = Неопределено, Неопределено, СтруктурыФорм.Получить(ФормаМетаданных.ПолноеИмя()));
	ПоФорме = ТипЗнч(СтруктураКлиента) = Тип("Массив");
	Если ПоФорме Тогда
		Плоский = ЭлементыФормыКлиента(СтруктураКлиента, ОбъектМетаданных, Виды, Путь);
	ИначеЕсли Не КодДоступен() Тогда
		Возврат Отказ(Результат, "FORM_UNAVAILABLE", ?(ТипЗнч(СтруктураКлиента) = Тип("Строка") И Не ПустаяСтрока(СтруктураКлиента),
			Лев(СтруктураКлиента, 300), НСтр("ru = 'Структуру формы получить не удалось.'")));
	Иначе
		Плоский = ЭлементыФормыИзИсходников(Путь, ОбъектМетаданных, Виды);
	КонецЕсли;
	Если Плоский.Количество() = 0 Тогда
		Возврат Отказ(Результат, "NOT_FOUND", СтрШаблон(НСтр("ru = 'Форма %1 не найдена в выгрузке исходников.'"), Путь));
	КонецЕсли;

	Плоский = БезГруппКнопок(Плоский, Виды.Получить("ButtonGroup"));
	Строки = Новый Массив;
	ГлубинаРаздела = -1;
	Раздел = НРег(СокрЛП(Раздел));
	Для Каждого Элемент Из Плоский Цикл
		Глубина = Элемент.Глубина;
		Имя = Элемент.Имя;
		Заголовок = Элемент.Заголовок;
		Если Не ПустаяСтрока(Раздел) Тогда
			Если ГлубинаРаздела >= 0 И Глубина <= ГлубинаРаздела Тогда
				Прервать;
			КонецЕсли;
			Если ГлубинаРаздела < 0 Тогда
				Если НРег(Имя) <> Раздел И НРег(Заголовок) <> Раздел Тогда
					Продолжить;
				КонецЕсли;
				ГлубинаРаздела = Глубина;
			КонецЕсли;
		КонецЕсли;
		Если Строки.Количество() >= 400 Тогда
			Строки.Добавить(НСтр("ru = '... форма длиннее 400 элементов: запроси нужную вкладку параметром section.'"));
			Прервать;
		КонецЕсли;
		Отступ = Глубина - ?(ГлубинаРаздела < 0, 0, ГлубинаРаздела);
		Строки.Добавить(СтрШаблон("%1%2%3 [%4]%5", СтроковыеФункцииКлиентСервер.СформироватьСтрокуСимволов(" ", Отступ * 2),
			Элемент.Вид, ?(ПустаяСтрока(Заголовок), "", " «" + Заголовок + "»"), Имя,
			?(Элемент.Видим, "", " " + НСтр("ru = '(скрыт)'"))));
	КонецЦикла;
	Если Строки.Количество() = 0 Тогда
		Возврат Отказ(Результат, "NOT_FOUND", СтрШаблон(НСтр("ru = 'В форме нет вкладки или группы «%1».'"), Раздел));
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.Итог = "OK";
	Результат.Строк = Строки.Количество();
	Результат.Класс = 1;
	Результат.Данные = Новый Структура("object, form, tree, note", ПолноеИмя, ФормаМетаданных.Имя,
		СтрСоединить(Строки, Символы.ПС),
		?(ПоФорме,
		НСтр("ru = 'Структура формы после кода её создания и расширений, для нового объекта: [имя] - имя элемента (его можно передать в show_form), пользователю имя не показывай, называй элементы заголовками. «(скрыт)» - элемент сейчас не виден: он появляется только при определённых данных или настройках. Заголовок кнопки со знаком ~ восстановлен по имени команды: на экране подпись может быть короче, называй кнопку близко к ней. Стандартные команды, которые платформа добавляет в командные панели сама (Записать, Провести, меню «Ещё»), в структуре могут отсутствовать.'"),
		НСтр("ru = 'Разметка формы из конфигурации без учёта кода формы: [имя] - имя элемента, пользователю его не показывай, называй элементы заголовками. Код формы может скрывать или показывать элементы в зависимости от данных; «(скрыт)» - элемент скрыт по умолчанию. Доработки расширений в разметке не учтены.'")));
	Возврат Результат;

КонецФункции

// Объект и форма для form_layout с проверкой периметра.
//
// Возвращаемое значение:
//  Структура - Ошибка (код; пусто - форма найдена), Текст, ОбъектМетаданных, ФормаМетаданных, Путь (Form.xml в выгрузке).
//
Функция ФормаИнструмента(Знач ПолноеИмя, Знач ИмяФормы)

	Форма = Новый Структура("Ошибка, Текст, ОбъектМетаданных, ФормаМетаданных, Путь", "", "", Неопределено, Неопределено, "");
	ПолноеИмя = СокрЛП(ПолноеИмя);
	ИмяФормы = СокрЛП(ИмяФормы);
	Части = СтрРазделить(ПолноеИмя, ".", Ложь);
	Если Части.Количество() <> 2 Тогда
		Форма.Ошибка = "BAD_ARGUMENTS";
		Форма.Текст = НСтр("ru = 'Укажите полное имя объекта, например «Документ.ЗаказКлиента».'");
		Возврат Форма;
	КонецЕсли;
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Тогда
		Форма.Ошибка = "NOT_FOUND";
		Форма.Текст = СтрШаблон(НСтр("ru = 'Объект %1 не найден.'"), ПолноеИмя);
		Возврат Форма;
	КонецЕсли;
	ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	Причина = "";
	Если ИИА_Периметр.ОбъектЗапрещен(ПолноеИмя, Причина) Тогда
		Форма.Ошибка = "PERIMETER_VIOLATION";
		Форма.Текст = Причина;
		Возврат Форма;
	КонецЕсли;

	Каталог = Категории().Получить(ВРег(Части[0]));
	Если Каталог = Неопределено Тогда
		Форма.Ошибка = "BAD_ARGUMENTS";
		Форма.Текст = НСтр("ru = 'У объекта этого вида нет форм.'");
		Возврат Форма;
	КонецЕсли;
	Если Каталог = "CommonForms" Тогда
		ФормаМетаданных = ОбъектМетаданных;
		Форма.Путь = "CommonForms/" + ОбъектМетаданных.Имя + "/Ext/Form.xml";
	Иначе
		ФормаМетаданных = ИИА_Формы.ФормаОбъекта(ОбъектМетаданных, ИмяФормы);
		Если ФормаМетаданных = Неопределено Тогда
			Форма.Ошибка = "NOT_FOUND";
			Форма.Текст = СтрШаблон(НСтр("ru = 'У объекта %1 нет формы «%2».'"), ПолноеИмя, ИмяФормы);
			Возврат Форма;
		КонецЕсли;
		Форма.Путь = Каталог + "/" + ОбъектМетаданных.Имя + "/Forms/" + ФормаМетаданных.Имя + "/Ext/Form.xml";
	КонецЕсли;
	Форма.ОбъектМетаданных = ОбъектМетаданных;
	Форма.ФормаМетаданных = ФормаМетаданных;
	Возврат Форма;

КонецФункции

// Структура формы от клиента чата (см. ИИА_ЧатКлиент.СтруктураФормы) - плоским списком для дерева form_layout.
// Данные пришли с клиента: виды берутся только из известного списка, строки и глубина ограничиваются.
// Поле без своего заголовка получает синоним реквизита по имени элемента (Реквизит или ТЧРеквизит), кнопка - заголовок
// команды (см. ЗаголовокКнопкиКлиента): на клиенте заголовки команд формы недоступны.
Функция ЭлементыФормыКлиента(Структура, ОбъектМетаданных, Виды, Путь)

	Плоский = Новый Массив;
	Пусто = Новый Соответствие;
	ЗаголовкиИсходников = Неопределено;
	Для Каждого Элемент Из Структура Цикл
		Если Плоский.Количество() >= 2000 Тогда
			Прервать;
		КонецЕсли;
		Если ТипЗнч(Элемент) <> Тип("Структура") Или Не Элемент.Свойство("Глубина")
			Или ТипЗнч(Элемент.Глубина) <> Тип("Число") Тогда
			Продолжить;
		КонецЕсли;
		ОписаниеЭлемента = Новый Структура("Вид, Имя, Таблица, Заголовок, Видим, Команда, ВидимРодитель", "", "", "", "",
			Истина, "", Истина);
		ЗаполнитьЗначенияСвойств(ОписаниеЭлемента, Элемент);
		// Потомков скрытых групп клиент передаёт для field_visibility; дерево form_layout их не показывает.
		Если ОписаниеЭлемента.ВидимРодитель = Ложь Тогда
			Продолжить;
		КонецЕсли;
		Вид = Виды.Получить(Строка(ОписаниеЭлемента.Вид));
		Если Вид = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Имя = Лев(Строка(ОписаниеЭлемента.Имя), 150);
		Таблица = Лев(Строка(ОписаниеЭлемента.Таблица), 150);
		Заголовок = Лев(СокрЛП(Строка(ОписаниеЭлемента.Заголовок)), 200);
		Если ПустаяСтрока(Заголовок) И СтрРазделить("InputField,LabelField,CheckBoxField,RadioButtonField,Table", ",")
			.Найти(Строка(ОписаниеЭлемента.Вид)) <> Неопределено Тогда
			ПутьПоИмени = "Объект." + Имя;
			Если Не ПустаяСтрока(Таблица) И СтрНачинаетсяС(Имя, Таблица) И СтрДлина(Имя) > СтрДлина(Таблица) Тогда
				ПутьПоИмени = "Объект." + Таблица + "." + Сред(Имя, СтрДлина(Таблица) + 1);
			КонецЕсли;
			Заголовок = ЗаголовокПоДанным(ОбъектМетаданных, ПутьПоИмени, "", Пусто);
			Если ПустаяСтрока(Заголовок) И ПустаяСтрока(Таблица) Тогда
				Заголовок = СинонимСтандартногоРеквизита(ОбъектМетаданных, Имя);
			КонецЕсли;
		ИначеЕсли ПустаяСтрока(Заголовок) И ОписаниеЭлемента.Вид = "Button" Тогда
			Если ЗаголовкиИсходников = Неопределено Тогда
				ЗаголовкиИсходников = ЗаголовкиЭлементовИзИсходников(Путь, ОбъектМетаданных, Виды);
			КонецЕсли;
			Заголовок = ЗаголовокКнопкиКлиента(Имя, Лев(Строка(ОписаниеЭлемента.Команда), 150), ЗаголовкиИсходников);
		КонецЕсли;
		Плоский.Добавить(Новый Структура("Глубина, Вид, Имя, Заголовок, Видим", Мин(Макс(Цел(Элемент.Глубина), 0), 50),
			Вид, Имя, Заголовок, ОписаниеЭлемента.Видим = Истина));
	КонецЦикла;
	Возврат Плоский;

КонецФункции

// Заголовки элементов из выгрузки (имя элемента -> заголовок, с подставленными заголовками команд); пусто - исходный
// код не подключён или формы в выгрузке нет.
Функция ЗаголовкиЭлементовИзИсходников(Путь, ОбъектМетаданных, Виды)

	Заголовки = Новый Соответствие;
	Если Не КодДоступен() Тогда
		Возврат Заголовки;
	КонецЕсли;
	Попытка
		Для Каждого Элемент Из ЭлементыФормыИзИсходников(Путь, ОбъектМетаданных, Виды) Цикл
			Если Не ПустаяСтрока(Элемент.Заголовок) Тогда
				Заголовки.Вставить(Элемент.Имя, Элемент.Заголовок);
			КонецЕсли;
		КонецЦикла;
	Исключение
		// Без выгрузки заголовки подбираются по имени команды.
		ЗаписьЖурналаРегистрации("ИИАссистент.ИсходныйКод", УровеньЖурналаРегистрации.Предупреждение, , ,
			БезопасныйТекст(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	Возврат Заголовки;

КонецФункции

// Заголовок кнопки без своего заголовка в структуре от клиента: из выгрузки формы, общей команды по имени кнопки
// (ФормаОбщаяКомандаХ) или по имени команды формы словами со знаком ~; кнопки-автокоманды без имени остаются пустыми.
Функция ЗаголовокКнопкиКлиента(Имя, ИмяКоманды, ЗаголовкиИсходников)

	Заголовок = ЗаголовкиИсходников.Получить(Имя);
	Если Заголовок <> Неопределено Тогда
		Возврат Заголовок;
	КонецЕсли;
	Позиция = СтрНайти(Имя, "ОбщаяКоманда");
	Если Позиция > 0 Тогда
		Команда = Метаданные.ОбщиеКоманды.Найти(Сред(Имя, Позиция + СтрДлина("ОбщаяКоманда")));
		Если Команда <> Неопределено Тогда
			Возврат Команда.Представление();
		КонецЕсли;
	КонецЕсли;
	Если ПустаяСтрока(ИмяКоманды) Или СтрНайти(ИмяКоманды, "__") > 0 Или СтрНайти(ИмяКоманды, ".") > 0 Тогда
		Возврат "";
	КонецЕсли;
	Слова = ИмяСловами(ИмяКоманды);
	Возврат ?(ПустаяСтрока(Слова), "", "~" + Слова);

КонецФункции

// «ЗаполнитьЦеныПоСоглашению» -> «Заполнить цены по соглашению».
Функция ИмяСловами(Имя)

	Результат = "";
	Предыдущий = "";
	Для Индекс = 1 По СтрДлина(Имя) Цикл
		Символ = Сред(Имя, Индекс, 1);
		Если Символ = "_" Тогда
			Символ = " ";
		ИначеЕсли Индекс > 1 И ВРег(Символ) = Символ И НРег(Символ) <> Символ И НРег(Предыдущий) = Предыдущий
			И ВРег(Предыдущий) <> Предыдущий Тогда
			Результат = Результат + " ";
			Символ = НРег(Символ);
		ИначеЕсли Индекс > 1 Тогда
			Символ = НРег(Символ);
		КонецЕсли;
		Результат = Результат + Символ;
		Предыдущий = Сред(Имя, Индекс, 1);
	КонецЦикла;
	Возврат СокрЛП(Результат);

КонецФункции

// Элементы формы из выгрузки через rlm (статический разбор Form.xml) - плоским списком с глубиной.
// Группы кнопок - служебная группировка командных панелей: на экране у них нет заголовка, а в дереве
// их заголовок путают с кнопкой. Убираем такие группы, вложенные элементы поднимаем на уровень выше.
Функция БезГруппКнопок(Плоский, ВидГруппыКнопок)

	Результат = Новый Массив;
	Пропущенные = Новый Массив; // глубины убранных групп на текущем пути
	Для Каждого Элемент Из Плоский Цикл
		Пока Пропущенные.Количество() > 0 И Пропущенные[Пропущенные.ВГраница()] >= Элемент.Глубина Цикл
			Пропущенные.Удалить(Пропущенные.ВГраница());
		КонецЦикла;
		Если Элемент.Вид = ВидГруппыКнопок Тогда
			Пропущенные.Добавить(Элемент.Глубина);
			Продолжить;
		КонецЕсли;
		Копия = Новый Структура("Глубина, Вид, Имя, Заголовок, Видим", Элемент.Глубина - Пропущенные.Количество(),
			Элемент.Вид, Элемент.Имя, Элемент.Заголовок, Элемент.Видим);
		Результат.Добавить(Копия);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЭлементыФормыИзИсходников(Путь, ОбъектМетаданных, Виды)

	ИменаВидов = Новый Массив;
	Для Каждого КлючИЗначение Из Виды Цикл
		ИменаВидов.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	Аргументы = Новый Структура("path, kinds", Путь, ИменаВидов);

	Код =
		"import re
		|raw = read_file(A['path'])
		|txt = '\n'.join(re.sub(r'^\s*\d+ \| ?', '', l, count=1) for l in raw.split('\n'))
		|K = set(A['kinds'])
		|tok = re.compile(r'<(/?)([A-Za-z0-9_:]+)((?:\s[^>]*?)?)(/?)>|([^<]+)', re.S)
		|st = []; es = []; items = []; cmds = {}; cmd = None; lang = None; buf = None; prop = None
		|for m in tok.finditer(txt):
		|    if m.group(5) is not None:
		|        if buf is not None: buf.append(m.group(5))
		|        continue
		|    c, tag, a, sc = m.group(1), m.group(2), m.group(3) or '', m.group(4)
		|    if not c:
		|        st.append(tag); d = len(st)
		|        if tag in K:
		|            nm = re.search(r'name=""([^""]*)""', a)
		|            it = [len(es), tag, nm.group(1) if nm else '', '', 1, '', '']
		|            items.append(it); es.append((d, it))
		|        elif tag == 'Command' and len(st) >= 2 and st[-2] == 'Commands':
		|            nm = re.search(r'name=""([^""]*)""', a); cmd = {'n': nm.group(1) if nm else '', 't': '', 'd': d}
		|        owner = es[-1] if es else None
		|        if tag in ('DataPath', 'CommandName', 'Visible') and owner and d == owner[0] + 1:
		|            buf = []; prop = (tag, owner[1])
		|        if tag == 'v8:lang':
		|            buf = []; prop = ('lang', None)
		|        if tag == 'v8:content' and len(st) >= 3 and st[-3] == 'Title':
		|            if owner and d == owner[0] + 3:
		|                buf = []; prop = ('title', owner[1])
		|            elif cmd and d == cmd['d'] + 3:
		|                buf = []; prop = ('ctitle', cmd)
		|        if sc:
		|            st.pop()
		|            if es and es[-1][0] == len(st) + 1: es.pop()
		|    else:
		|        if prop and tag in ('DataPath', 'CommandName', 'Visible', 'v8:lang', 'v8:content'):
		|            v = ''.join(buf).strip(); k, o = prop
		|            if k == 'lang': lang = v
		|            elif k == 'title':
		|                if lang == 'ru' or not o[3]: o[3] = v
		|            elif k == 'ctitle':
		|                if lang == 'ru' or not o['t']: o['t'] = v
		|            elif k == 'DataPath': o[6] = v
		|            elif k == 'CommandName': o[5] = v
		|            elif k == 'Visible': o[4] = 0 if v == 'false' else 1
		|            buf = None; prop = None
		|        if es and es[-1][0] == len(st): es.pop()
		|        if cmd and cmd['d'] == len(st) and tag == 'Command':
		|            cmds[cmd['n']] = cmd['t']; cmd = None
		|        st.pop()
		|print(json.dumps({'items': items, 'commands': cmds}, ensure_ascii=False))";
	Данные = ВыполнитьКод(Код, Аргументы);

	Плоский = Новый Массив;
	Элементы = Данные.Получить("items");
	Если ТипЗнч(Элементы) <> Тип("Массив") Тогда
		Возврат Плоский;
	КонецЕсли;
	Команды = Данные.Получить("commands");
	Команды = ?(ТипЗнч(Команды) = Тип("Соответствие"), Команды, Новый Соответствие);
	Для Каждого Элемент Из Элементы Цикл
		Заголовок = Элемент[3];
		Если ПустаяСтрока(Заголовок) Тогда
			Заголовок = ЗаголовокПоДанным(ОбъектМетаданных, Элемент[6], Элемент[5], Команды);
		КонецЕсли;
		Плоский.Добавить(Новый Структура("Глубина, Вид, Имя, Заголовок, Видим", Элемент[0], Виды.Получить(Элемент[1]),
			Элемент[2], Заголовок, Элемент[4] <> 0));
	КонецЦикла;
	Возврат Плоский;

КонецФункции

Функция ОписаниеСтруктурыФормы()

	Свойства = СвойстваПараметров("object", "string",
		НСтр("ru = 'Полное имя объекта («Документ.ЗаказКлиента», «Справочник.Номенклатура») или общей формы («ОбщаяФорма.Х»).'"));
	Свойства.Вставить("form", СвойствоПараметра("string",
		НСтр("ru = 'Необязательно: имя формы; пусто - основная форма объекта, «list» - основная форма списка.'")));
	Свойства.Вставить("section", СвойствоПараметра("string",
		НСтр("ru = 'Необязательно: имя или заголовок вкладки или группы - вернуть только её поддерево (для больших форм).'")));
	Возврат ОписаниеИнструмента("form_layout",
		НСтр("ru = 'Структура формы для инструкции пользователю: вкладки, группы, поля, таблицы и кнопки с заголовками, как их видит пользователь. Используй для вопросов «как сделать», «где найти поле или кнопку»: ответ - путь заголовками элементов (вкладка, группа, поле или кнопка); имена в квадратных скобках пользователю не показывай. Значений данных не содержит.'"),
		Свойства, "object");

КонецФункции

// Синоним стандартного реквизита (Наименование, Код, Дата...) по русскому имени; пусто - такого нет.
Функция СинонимСтандартногоРеквизита(ОбъектМетаданных, Имя)

	Попытка
		Для Каждого Реквизит Из ОбъектМетаданных.СтандартныеРеквизиты Цикл
			Если Реквизит.Имя = Имя Тогда
				Возврат Реквизит.Представление();
			КонецЕсли;
		КонецЦикла;
	// У части видов объектов стандартных реквизитов нет.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат "";
	КонецПопытки;
	Возврат "";

КонецФункции

// Заголовок поля или кнопки без собственного заголовка: синоним реквизита по пути данных или представление команды.
Функция ЗаголовокПоДанным(ОбъектМетаданных, ПутьКДанным, ИмяКоманды, Команды)

	Если СтрНачинаетсяС(ПутьКДанным, "Объект.") Тогда
		Части = СтрРазделить(Сред(ПутьКДанным, 8), ".", Ложь);
		Если Части.Количество() = 0 Тогда
			Возврат "";
		КонецЕсли;
		Стандартный = СтандартныеРеквизиты().Получить(Части[Части.ВГраница()]);
		Если Стандартный <> Неопределено Тогда
			Возврат Стандартный;
		КонецЕсли;
		Реквизит = Неопределено;
		Попытка
			Если Части.Количество() = 1 Тогда
				Реквизит = ОбъектМетаданных.Реквизиты.Найти(Части[0]);
				Если Реквизит = Неопределено Тогда
					Реквизит = ОбъектМетаданных.ТабличныеЧасти.Найти(Части[0]);
				КонецЕсли;
			Иначе
				ТабличнаяЧасть = ОбъектМетаданных.ТабличныеЧасти.Найти(Части[0]);
				Реквизит = ?(ТабличнаяЧасть = Неопределено, Неопределено, ТабличнаяЧасть.Реквизиты.Найти(Части[1]));
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации("ИИАссистент.ИсходныйКод", УровеньЖурналаРегистрации.Предупреждение, , ,
				БезопасныйТекст(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			Реквизит = Неопределено;
		КонецПопытки;
		Возврат ?(Реквизит = Неопределено, "", Реквизит.Представление());
	КонецЕсли;

	Если СтрНачинаетсяС(ИмяКоманды, "Form.Command.") Тогда
		Заголовок = Команды.Получить(Сред(ИмяКоманды, 14));
		Возврат ?(Заголовок = Неопределено, "", Заголовок);
	ИначеЕсли СтрНачинаетсяС(ИмяКоманды, "CommonCommand.") Тогда
		Команда = Метаданные.ОбщиеКоманды.Найти(Сред(ИмяКоманды, 15));
		Возврат ?(Команда = Неопределено, "", Команда.Представление());
	ИначеЕсли СтрНайти(ИмяКоманды, "StandardCommand.") > 0 Тогда
		Части = СтрРазделить(ИмяКоманды, ".", Ложь);
		Заголовок = СтандартныеКоманды().Получить(Части[Части.ВГраница()]);
		Возврат ?(Заголовок = Неопределено, "", Заголовок);
	КонецЕсли;
	Возврат "";

КонецФункции

