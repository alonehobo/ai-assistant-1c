#Область СервисRLM

// Выполняет фрагмент Python в отдельной сессии rlm и закрывает её. Аргументы передаются переменной A
// (словарь), фрагмент печатает JSON результата.
//
// Возвращаемое значение:
//  Соответствие - разобранный JSON из вывода фрагмента.
//
Функция ВыполнитьКод(Фрагмент, Аргументы)

	Код = "import json" + Символы.ПС
		+ "A = json.loads(" + ЛитералPython(ОбщегоНазначения.ЗначениеВJSON(Аргументы)) + ")" + Символы.ПС
		+ Фрагмент;

	Сессия = НачатьСессию().Идентификатор;
	Попытка
		Ответ = ВыполнитьВСессии(Сессия, Код);
	Исключение
		ЗавершитьСессию(Сессия);
		ВызватьИсключение;
	КонецПопытки;
	ЗавершитьСессию(Сессия);
	Возврат ВыводФрагмента(Ответ);

КонецФункции

// Разбирает ответ rlm_execute: последняя строка stdout - JSON, напечатанный фрагментом.
//
// Параметры:
//  Ответ - Соответствие, Неопределено - см. ВыполнитьВСессии.
//
// Возвращаемое значение:
//  Соответствие
//
Функция ВыводФрагмента(Ответ)

	Если Ответ = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Сессия rlm-tools-bsl закрылась сразу после открытия.'");
	КонецЕсли;

	Ошибка = Ответ.Получить("error");
	Если ЗначениеЗаполнено(Ошибка) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'rlm-tools-bsl: %1'"), Прав(Строка(Ошибка), 1000));
	КонецЕсли;
	Вывод = СокрЛП(Строка(Ответ.Получить("stdout")));
	// rlm обрезает stdout по max_output_chars сессии и дописывает маркер: JSON фрагмента уже не разобрать.
	Если СтрЗаканчиваетсяНа(Вывод, "[output truncated]") Тогда
		ВызватьИсключение НСтр("ru = 'Ответ rlm-tools-bsl обрезан лимитом вывода сессии.'");
	КонецЕсли;
	// Хелперы могут печатать служебные строки: берём последнюю строку вывода - JSON фрагмента.
	Строки = СтрРазделить(Вывод, Символы.ПС, Ложь);
	Если Строки.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'rlm-tools-bsl вернул пустой ответ.'");
	КонецЕсли;
	Возврат ОбщегоНазначения.JSONВЗначение(Строки[Строки.ВГраница()]);

КонецФункции

// Неопределено - сессия не найдена или истекла.
Функция ВыполнитьВСессии(Сессия, Код)

	Параметры = Новый Структура("session_id, code", Сессия, Код);
	Ответ = ОбщегоНазначения.JSONВЗначение(ВызватьИнструментСервиса("rlm_execute", Параметры, 45));
	Ошибка = Ответ.Получить("error");
	Если ЗначениеЗаполнено(Ошибка) И Не ЗначениеЗаполнено(Ответ.Получить("stdout"))
		И (СтрНайти(НРег(Строка(Ошибка)), "not found or expired") > 0 Или СтрНайти(НРег(Строка(Ошибка)), "call limit exceeded") > 0) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Ответ;

КонецФункции

// Открывает отдельную диагностическую сессию rlm по проекту из настроек.
//
// Возвращаемое значение:
//  Структура - Идентификатор, Каталог, Индекс (Соответствие).
//
Функция НачатьСессию()

	ПроектRLM = Проект();
	Если ПроектЗаданПутем(ПроектRLM) Тогда
		ВызватьИсключение "PROJECT_NOT_REGISTERED";
	КонецЕсли;
	// Диагностика не разделяет сессию с исследовательскими ходами.
	Параметры = Новый Структура("query, project, domains, effort, max_output_chars, max_execute_calls, execution_timeout_seconds",
		"ИИ-ассистент 1С: диагностика", ПроектRLM, "код", "low", 100000, 32, 30);
	Ответ = ОбщегоНазначения.JSONВЗначение(ВызватьИнструментСервиса("rlm_start", Параметры, 30));
	Идентификатор = Ответ.Получить("session_id");
	Если Не ЗначениеЗаполнено(Идентификатор) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'rlm-tools-bsl не открыл сессию: %1'"),
			Лев(Строка(?(Ответ.Получить("error") = Неопределено, "", Ответ.Получить("error"))), 500));
	КонецЕсли;
	Возврат Новый Структура("Идентификатор, Каталог, Индекс", Идентификатор,
		Строка(Ответ.Получить("resolved_path")), Ответ.Получить("index"));

КонецФункции

// Закрывает сессию rlm (rlm_end). Ошибка закрытия не прерывает вызывающего: сессия истечёт на сервере.
//
// Параметры:
//  Идентификатор - Строка - пустая строка ничего не делает.
//
// Возвращаемое значение:
//  Булево - сервис подтвердил закрытие.
//
Функция ЗавершитьСессию(Идентификатор)

	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Ответ = ОбщегоНазначения.JSONВЗначение(
			ВызватьИнструментСервиса("rlm_end", Новый Структура("session_id", Идентификатор), 10));
		Возврат ТипЗнч(Ответ) = Тип("Соответствие") И Ответ.Получить("success") = Истина;
	Исключение
		ЗаписьЖурналаРегистрации("ИИАссистент.ИсходныйКод", УровеньЖурналаРегистрации.Предупреждение, , ,
			БезопасныйТекст(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Вызов инструмента MCP-сервера по HTTP (JSON-RPC tools/call). Ответ сервера - JSON или поток SSE.
//
// Возвращаемое значение:
//  Строка - текст результата инструмента.
//
Функция ВызватьИнструментСервиса(Имя, Аргументы, Таймаут)

	Параметры = Новый Структура("name,arguments", Имя, Аргументы);
	Результат = ВызватьМетодСервиса("tools/call", Параметры, Таймаут);
	Содержимое = Результат.Получить("content");
	Если ТипЗнч(Содержимое) <> Тип("Массив") Или Содержимое.Количество() = 0 Тогда
		ВызватьИсключение "RLM_EMPTY_RESULT";
	КонецЕсли;
	Если Результат.Получить("isError") = Истина Тогда
		ВызватьИсключение "RLM_TOOL_ERROR";
	КонецЕсли;
	Возврат Строка(Содержимое[0].Получить("text"));

КонецФункции

Функция ВызватьМетодСервиса(Метод, Параметры, Таймаут)

	URI = ОбщегоНазначенияКлиентСервер.СтруктураURI(АдресСервиса());
	Если НРег(URI.Хост) <> "localhost" И URI.Хост <> "127.0.0.1" Тогда
		ВызватьИсключение "RLM_ENDPOINT_NOT_LOCAL";
	КонецЕсли;
	Защищенное = НРег(URI.Схема) = "https";
	Если ЗначениеЗаполнено(URI.Порт) Тогда
		Порт = Число(URI.Порт);
	Иначе
		Порт = ?(Защищенное, 443, 80);
	КонецЕсли;
	Соединение = Новый HTTPСоединение(URI.Хост, Порт, , , , Таймаут,
		?(Защищенное, Новый ЗащищенноеСоединениеOpenSSL, Неопределено));

	Тело = Новый Структура("jsonrpc, id, method, params", "2.0", 1, Метод, Параметры);
	Путь = URI.ПутьНаСервере;
	Запрос = Новый HTTPЗапрос(?(СтрНачинаетсяС(Путь, "/"), Путь, "/" + Путь));
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	Запрос.Заголовки.Вставить("Accept", "application/json, text/event-stream");
	Запрос.УстановитьТелоИзСтроки(ОбщегоНазначения.ЗначениеВJSON(Тело), КодировкаТекста.UTF8,
		ИспользованиеByteOrderMark.НеИспользовать);

	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Текст = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'rlm-tools-bsl: HTTP %1 %2'"), Ответ.КодСостояния, "RLM_HTTP_ERROR");
	КонецЕсли;

	Сообщение = "";
	Если СтрНачинаетсяС(СокрЛ(Текст), "{") Тогда
		Сообщение = Текст;
	Иначе
		Для Каждого СтрокаПотока Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
			Если СтрНачинаетсяС(СтрокаПотока, "data:") И СтрНайти(СтрокаПотока, """jsonrpc""") > 0 Тогда
				Сообщение = Сред(СтрокаПотока, 6);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ПустаяСтрока(Сообщение) Тогда
		ВызватьИсключение НСтр("ru = 'rlm-tools-bsl: в ответе нет сообщения JSON-RPC.'");
	КонецЕсли;

	Данные = ОбщегоНазначения.JSONВЗначение(СтрЗаменить(Сообщение, Символы.ВК, ""));
	Если Данные.Получить("error") <> Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'rlm-tools-bsl: %1'"), Лев(ОбщегоНазначения.ЗначениеВJSON(Данные.Получить("error")), 500));
	КонецЕсли;
	Возврат Данные.Получить("result");

КонецФункции

Функция ЧислоВШестнадцатеричное(Число, Знаков)

	Цифры = "0123456789abcdef";
	Результат = "";
	Остаток = Число;
	Пока СтрДлина(Результат) < Знаков Цикл
		Результат = Сред(Цифры, Остаток % 16 + 1, 1) + Результат;
		Остаток = Цел(Остаток / 16);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Общее

Функция Отказ(Результат, Код, Текст)

	Результат.Успех = Ложь;
	Результат.Итог = Код;
	Результат.Данные = Новый Структура("error, message", Код, Текст);
	Возврат Результат;

КонецФункции

Функция СтрокаАргумента(Аргументы, Имя)

	Значение = Аргументы.Получить(Имя);
	Возврат ?(ТипЗнч(Значение) = Тип("Строка"), Значение, "");

КонецФункции

Функция ОписаниеИнструмента(Имя, Описание, Свойства, Обязательные)

	Схема = Новый Соответствие;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", СтрРазделить(Обязательные, ",", Ложь));

	Функция_ = Новый Соответствие;
	Функция_.Вставить("name", Имя);
	Функция_.Вставить("description", Описание);
	Функция_.Вставить("parameters", Схема);

	Инструмент = Новый Соответствие;
	Инструмент.Вставить("type", "function");
	Инструмент.Вставить("function", Функция_);
	Возврат Инструмент;

КонецФункции

Функция СвойстваПараметров(Имя, Тип, Описание)

	Свойства = Новый Соответствие;
	Свойства.Вставить(Имя, СвойствоПараметра(Тип, Описание));
	Возврат Свойства;

КонецФункции

Функция СвойствоПараметра(Тип, Описание)

	Свойство = Новый Соответствие;
	Свойство.Вставить("type", Тип);
	Свойство.Вставить("description", Описание);
	Возврат Свойство;

КонецФункции

