#Область ИсследованиеRLM

Функция ИсследованиеЗапрещеноПрофилем()

	// Прежние имена инструментов кода учитываются: профиль мог выключить их до перехода на rlm_execute.
	Для Каждого Имя Из СтрРазделить("rlm_execute,code_search,code_read,code_callers", ",") Цикл
		Если ИИА_ПрофилиДоступа.ИнструментЗапрещенПрофилем(Имя) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ОшибкаКонтекстаИсследования(Состояние)

	Если ТипЗнч(Состояние) <> Тип("Структура") Тогда
		Возврат "ACCESS_DENIED";
	КонецЕсли;
	Для Каждого Поле Из СтрРазделить("Диалог,Модель,Проект,Адрес,Пользователь,Профиль,КлассДанных,"
		+ "ПредельныйМомент,Начало,ЧислоВыполнений,ИдентификаторСессии", ",") Цикл
		Если Не Состояние.Свойство(Поле) Тогда
			Возврат "ACCESS_DENIED";
		КонецЕсли;
	КонецЦикла;
	Если Состояние.Пользователь <> Пользователи.ТекущийПользователь()
		Или Состояние.Проект <> Проект() Или Состояние.Адрес <> АдресСервиса()
		Или Состояние.Профиль <> ИИА_ПрофилиДоступа.ЭффективныйПрофиль(Состояние.Пользователь) Тогда
		Возврат "RESEARCH_CONTEXT_CHANGED";
	КонецЕсли;
	Если ЗначениеЗаполнено(Состояние.Диалог)
		И Не ИИА_Обслуживание.ДиалогДоступенДляИсследования(Состояние.Диалог) Тогда
		Возврат "ACCESS_DENIED";
	КонецЕсли;
	Если ИсследованиеЗапрещеноПрофилем() Тогда
		Возврат "TOOL_DISABLED";
	КонецЕсли;
	Если Не ИИА_LLM.ЕстьПодключениеДляИсследования(Макс(1, Состояние.КлассДанных), Состояние.Модель) Тогда
		Возврат "DATA_CLASS_NOT_ALLOWED";
	КонецЕсли;
	Если Не КодДоступен() Тогда
		Возврат "SERVICE_UNAVAILABLE";
	КонецЕсли;
	Если ПроектЗаданПутем(Состояние.Проект) Тогда
		Возврат "PROJECT_NOT_REGISTERED";
	КонецЕсли;
	Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= Мин(Состояние.ПредельныйМомент, Состояние.Начало + 300000) Тогда
		Возврат "RESEARCH_DEADLINE";
	КонецЕсли;
	Если Состояние.ЧислоВыполнений >= 32 Тогда
		Возврат "RESEARCH_LIMIT";
	КонецЕсли;
	Возврат "";

КонецФункции



















Функция ВыполнитьИсследование(Имя, Аргументы, Результат, Состояние)

	Если ИИА_ПрофилиДоступа.ИнструментЗапрещенПрофилем(Имя) Тогда
		Возврат Отказ(Результат, "TOOL_DISABLED", "Инструмент выключен профилем.");
	КонецЕсли;
	Код = СтрокаАргумента(Аргументы, "code");
	Если ПустаяСтрока(Код) Тогда
		Возврат Отказ(Результат, "BAD_ARGUMENTS", "Передайте Python в аргументе code.");
	КонецЕсли;
	Ошибка = ОшибкаКонтекстаИсследования(Состояние);
	Если Не ПустаяСтрока(Ошибка) Тогда
		Возврат Отказ(Результат, Ошибка, "Исследование недоступно для текущего диалога, профиля или модели.");
	КонецЕсли;
	Результат.Класс = Макс(1, Состояние.КлассДанных);
	Попытка
		Данные = ВыполнитьКодИсследования(Код, Состояние);
	Исключение
		// Технологическое исключение может содержать URL с ключом или произвольный stdout.
		ЗаписьЖурналаРегистрации("ИИАссистент.ИсходныйКод", УровеньЖурналаРегистрации.Ошибка, , ,
			БезопасныйТекст(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		Ошибка = ОшибкаКонтекстаИсследования(Состояние);
		Возврат Отказ(Результат, ?(ПустаяСтрока(Ошибка), "SERVICE_UNAVAILABLE", Ошибка),
			"Сервис rlm-tools-bsl недоступен или не ответил вовремя.");
	КонецПопытки;
	Результат.Данные = Данные;
	Результат.Успех = Не ЗначениеЗаполнено(Данные.Получить("error"));
	Результат.Итог = ?(Результат.Успех, "OK", "PYTHON_ERROR");
	Результат.Строк = 0;
	Если Результат.Успех Тогда
		ЗапомнитьКод(Состояние, Код);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Выполняет код модели в сессии хода. Песочница rlm сама ограничивает импорт белым списком,
// чтение - корнем проекта и время выполнения; здесь только лимиты хода и очистка вывода.
Функция ВыполнитьКодИсследования(Код, Состояние)

	Новая = ПустаяСтрока(Состояние.ИдентификаторСессии);
	Если Новая Тогда
		ОткрытьСессиюИсследования(Состояние);
	КонецЕсли;
	Ответ = ВыполнитьВСессииИсследования(Код, Состояние);
	Пересоздана = Ложь;
	Если Ответ = Неопределено И Состояние.Восстановления = 0 Тогда
		Состояние.Восстановления = 1;
		Пересоздана = Не Новая;
		ОткрытьСессиюИсследования(Состояние);
		Новая = Истина;
		Ответ = ВыполнитьВСессииИсследования(Код, Состояние);
	КонецЕсли;
	Если Ответ = Неопределено Тогда
		ВызватьИсключение "RLM_SESSION_UNAVAILABLE";
	КонецЕсли;

	Данные = Новый Соответствие;
	Вывод = Ответ.Получить("stdout");
	Вывод = ?(ТипЗнч(Вывод) = Тип("Строка"), Вывод, "");
	Данные.Вставить("stdout", БезопасныйТекст(Лев(Вывод, 20000)));
	Если СтрДлина(Вывод) > 20000 Или Ответ.Получить("output_truncated") = Истина Тогда
		Данные.Вставить("truncated", Истина);
	КонецЕсли;
	Ошибка = Ответ.Получить("error");
	Если ЗначениеЗаполнено(Ошибка) Тогда
		Данные.Вставить("error", БезопасныйТекст(Прав(Строка(Ошибка), 3000)));
	КонецЕсли;
	Если Новая Тогда
		Данные.Вставить("helpers", Состояние.Помощники);
		Если Состояние.ПредупрежденияИндекса.Количество() > 0 Тогда
			Данные.Вставить("index_warnings", Состояние.ПредупрежденияИндекса);
		КонецЕсли;
		Если Состояние.Расширения.Количество() > 0 Тогда
			Данные.Вставить("extensions", Состояние.Расширения);
		КонецЕсли;
	КонецЕсли;
	Если Пересоздана Тогда
		Данные.Вставить("note", "Сессия rlm пересоздана: переменные прошлых вызовов потеряны.");
	КонецЕсли;
	Данные.Вставить("rlm_exec_calls", Состояние.ЧислоВыполнений);
	Возврат Данные;

КонецФункции

// Неопределено - сессия не найдена или истекла.
Функция ВыполнитьВСессииИсследования(Код, Состояние)

	Состояние.ЧислоВыполнений = Состояние.ЧислоВыполнений + 1;
	Параметры = Новый Структура("session_id, code", Состояние.ИдентификаторСессии, Код);
	// Песочница сама прерывает код по execution_timeout_seconds сессии; HTTP ждёт дольше, чтобы получить её ошибку,
	// а не оборвать соединение раньше и оставить сессию занятой.
	Ответ = ОбщегоНазначения.JSONВЗначение(
		ВызватьИнструментСервиса("rlm_execute", Параметры, ТаймаутИсследования(Состояние) + 15), , Истина);
	Ошибка = НРег(Строка(Ответ.Получить("error")));
	Если Ответ.Получить("error_code") = "SESSION_EXPIRED"
		Или Не ЗначениеЗаполнено(Ответ.Получить("stdout")) И СтрНайти(Ошибка, "not found or expired") > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Ответ;

КонецФункции

Процедура ЗапомнитьКод(Состояние, Код)

	Если СтрДлина(Код) > 4000 Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Указатель Из Состояние.КонтрольнаяТочка Цикл
		Если КодУказателя(Указатель) = Код Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Элемент = Новый Соответствие;
	Элемент.Вставить("code", Код);
	Состояние.КонтрольнаяТочка.Добавить(Элемент);
	Если Состояние.КонтрольнаяТочка.Количество() > 10 Тогда
		Состояние.КонтрольнаяТочка.Удалить(0);
	КонецЕсли;

КонецПроцедуры

// Код элемента контрольной точки или Неопределено для записи другого формата.
Функция КодУказателя(Указатель)

	Если ТипЗнч(Указатель) <> Тип("Соответствие") Или Указатель.Количество() <> 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Код = Указатель.Получить("code");
	Если ТипЗнч(Код) <> Тип("Строка") Или ПустаяСтрока(Код) Или СтрДлина(Код) > 4000 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Код;

КонецФункции

Функция ОписаниеВыполненияКода()

	Возврат "Выполняет Python в песочнице rlm-tools-bsl по исходникам конфигурации и её расширений. "
		+ "Переменные сохраняются между вызовами одного хода. Результат печатай через print() (до 20000 символов), "
		+ "делай несколько связанных операций за один вызов. Импорт: json, re, collections, itertools, functools. "
		+ "Основные помощники: search_methods(query, limit), find_definition(name, module_hint), "
		+ "find_module(name, category), extract_procedures(path), read_procedure(path, name или [имена]), "
		+ "find_callers_context(proc, module_hint), safe_grep(pattern, name_hint), get_object_profile(name), "
		+ "find_attributes(...), find_code_usages(...), find_register_movements(name), get_overrides(name). "
		+ "Помощники вызываются внутри code, это не отдельные инструменты. "
		+ "Модули расширений лежат вне корня песочницы (пути '../...'): read_file, grep и glob_files на них дают PermissionError, "
		+ "а find_module, extract_procedures, read_procedure, get_overrides и find_ext_overrides читают их штатно. "
		+ "Полный список с сигнатурами приходит в поле helpers первого ответа; help('тема') - рецепты.";

КонецФункции

Процедура ОткрытьСессиюИсследования(Состояние)

	Домены = Новый Массив;
	Домены.Добавить("весь каталог");
	Параметры = Новый Структура("query,project,domains,effort,max_output_chars,max_execute_calls,execution_timeout_seconds",
		"Исследование исходников 1С", Состояние.Проект, Домены, "low", 20000, 32, ТаймаутИсследования(Состояние));
	Ответ = ОбщегоНазначения.JSONВЗначение(
		ВызватьИнструментСервиса("rlm_start", Параметры, ТаймаутИсследования(Состояние)), , Истина);
	Если ТипЗнч(Ответ.Получить("session_id")) <> Тип("Строка") Тогда
		ВызватьИсключение "RLM_SESSION_UNAVAILABLE";
	КонецЕсли;
	Состояние.ИдентификаторСессии = Ответ.Получить("session_id");
	Состояние.Расширения = Новый Массив;
	КонтекстРасширений = Ответ.Получить("extension_context");
	Если ТипЗнч(КонтекстРасширений) = Тип("Соответствие") Тогда
		Расширения = КонтекстРасширений.Получить("nearby_extensions");
		Если ТипЗнч(Расширения) = Тип("Массив") Тогда
			Для Каждого Расширение Из Расширения Цикл
				Если ТипЗнч(Расширение) = Тип("Соответствие")
					И ТипЗнч(Расширение.Получить("name")) = Тип("Строка") Тогда
					Состояние.Расширения.Добавить(Расширение.Получить("name"));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Состояние.Помощники = Новый Массив;
	Сигнатуры = Ответ.Получить("available_functions");
	Если ТипЗнч(Сигнатуры) = Тип("Массив") Тогда
		Для Каждого Сигнатура Из Сигнатуры Цикл
			Если ТипЗнч(Сигнатура) = Тип("Строка") И Состояние.Помощники.Количество() < 100 Тогда
				Состояние.Помощники.Добавить(БезопасныйТекст(Лев(Сигнатура, 400)));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Состояние.ПредупрежденияИндекса = Новый Массив;
	Индекс = Ответ.Получить("index");
	Если ТипЗнч(Индекс) <> Тип("Соответствие") Или Индекс.Получить("loaded") <> Истина Тогда
		Состояние.ПредупрежденияИндекса.Добавить("Индекс не загружен; полнота поиска не подтверждена.");
	ИначеЕсли ТипЗнч(Индекс.Получить("warnings")) = Тип("Массив") Тогда
		Для Каждого Предупреждение Из Индекс.Получить("warnings") Цикл
			Состояние.ПредупрежденияИндекса.Добавить(БезопасныйТекст(Лев(Строка(Предупреждение), 300)));
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция ТаймаутИсследования(Состояние)

	Осталось = Цел((Мин(Состояние.ПредельныйМомент, Состояние.Начало + 300000)
		- ТекущаяУниверсальнаяДатаВМиллисекундах()) / 1000);
	Если Осталось < 1 Тогда
		ВызватьИсключение "RESEARCH_DEADLINE";
	КонецЕсли;
	Возврат Мин(30, Осталось);

КонецФункции




