///////////////////////////////////////////////////////////////////////////////////////////////////////
// ИИ-ассистент: карта доступа к данным - что и почему получает модель.
// Собирает в одном месте три слоя правил:
//   1. жёсткий периметр кода (персональные, кадровые, зарплатные данные, переписка, секреты, свободный текст);
//   2. классы данных К0-К4 и уровни доверия моделей Т1-Т3 (ИИА_КлассыДанных);
//   3. счета бухучёта: 69, 70, 71, 73 закрыты всегда, остальные - по профилям доступа.
// Используется формой «Доступ к данным» и инструментом агента data_access.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Объекты и поля классификации с действующим классом, периметром и допустимыми уровнями доверия.
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * ПолноеИмя - Строка
//   * Представление - Строка - синоним объекта (и поля).
//   * Вид - Строка - «Объект» или «Поле».
//   * Класс - Строка - «К0»...«К4».
//   * Источник - Строка - «Автоматически» или «Вручную».
//   * Периметр - Строка - причина закрытия жёстким периметром; пусто - не закрыт.
//   * Получают - Строка - уровни доверия моделей, которым можно передать данные: «Т1, Т2, Т3», «Т1» или «никто».
//   * Комментарий - Строка
//
Функция ОбъектыДоступа() Экспорт

	ИИА_КлассыДанных.ОбновитьАвтоматическуюКлассификациюПриНеобходимости();
	УстановитьПривилегированныйРежим(Истина);

	Таблица = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("ПолноеИмя,Представление,Вид,Класс,Источник,Периметр,Получают,Комментарий", ",") Цикл
		Таблица.Колонки.Добавить(Имя, Новый ОписаниеТипов("Строка"));
	КонецЦикла;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	К.ПолноеИмя КАК ПолноеИмя,
	|	К.Класс КАК Класс,
	|	К.Автоматически КАК Автоматически,
	|	К.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.ИИА_КлассификацияДанных КАК К
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПолноеИмя");
	ДействующиеКлассы = ИИА_КлассыДанныхПовтИсп.Классификация();
	Периметр = ИИА_Периметр.ОписаниеПериметра();
	Синонимы = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПолноеИмя = СокрЛП(Выборка.ПолноеИмя);
		Части = СтрРазделить(ПолноеИмя, ".");
		ИмяОбъекта = Части[0] + "." + ?(Части.Количество() > 1, Части[1], "");
		ПутьПоля = Сред(ПолноеИмя, СтрДлина(ИмяОбъекта) + 2);

		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.ПолноеИмя = ПолноеИмя;
		НоваяСтрока.Вид = ?(ПустаяСтрока(ПутьПоля), НСтр("ru = 'Объект'"), НСтр("ru = 'Поле'"));
		НоваяСтрока.Представление = ПредставлениеКлюча(ИмяОбъекта, ПутьПоля, Синонимы);
		НоваяСтрока.Источник = ?(Выборка.Автоматически, НСтр("ru = 'Автоматически'"), НСтр("ru = 'Вручную'"));
		НоваяСтрока.Комментарий = Выборка.Комментарий;
		Класс = ДействующийКласс(ПолноеИмя, Части[0], Выборка.Класс, ДействующиеКлассы);
		НоваяСтрока.Класс = ИИА_КлассыДанных.ПредставлениеКласса(Класс);
		НоваяСтрока.Периметр = ПричинаПериметра(ИмяОбъекта, ПутьПоля, Периметр);
		НоваяСтрока.Получают = ?(ПустаяСтрока(НоваяСтрока.Периметр), ИИА_КлассыДанных.ДопустимыеУровниДоверия(Класс),
			НСтр("ru = 'никто'"));
	КонецЦикла;
	Возврат Таблица;

КонецФункции

// Жёсткий периметр: объекты, поля и типы, закрытые для любой модели и любого профиля.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Вид, Имя, Причина (см. ИИА_Периметр.ПериметрДляПросмотра).
//
Функция ПериметрДоступа() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Возврат ИИА_Периметр.ПериметрДляПросмотра();

КонецФункции

// Счета бухучёта: закрытые всегда и правила профилей доступа.
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * Счет - ПланСчетовСсылка.Хозрасчетный
//   * Код - Строка
//   * Наименование - Строка
//   * Профиль - Строка - «Все профили» для счетов, закрытых всегда.
//   * Состояние - Строка
//   * Пояснение - Строка
//
Функция СчетаДоступа() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Счет");
	Для Каждого Имя Из СтрРазделить("Код,Наименование,Профиль,Состояние,Пояснение", ",") Цикл
		Таблица.Колонки.Добавить(Имя, Новый ОписаниеТипов("Строка"));
	КонецЦикла;
	Если Не ИИА_БухгалтерскийДоступ.ПланСчетовДоступен() Тогда
		Возврат Таблица;
	КонецЕсли;

	Базовые = ИИА_БухгалтерскийДоступ.БазовыеЗапрещенныеСчета();
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Счета.Ссылка КАК Счет,
	|	Счета.Код КАК Код,
	|	Счета.Наименование КАК Наименование
	|ИЗ
	|	ПланСчетов.Хозрасчетный КАК Счета
	|ГДЕ
	|	Счета.Ссылка В (&Базовые)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	С.Счет КАК Счет,
	|	С.Счет.Код КАК Код,
	|	С.Счет.Наименование КАК Наименование,
	|	С.Ссылка.Наименование КАК Профиль,
	|	С.Разрешен КАК Разрешен,
	|	С.Счет В ИЕРАРХИИ (&Базовые) КАК ЗакрытВсегда
	|ИЗ
	|	Справочник.ИИА_ПрофилиДоступа.Счета КАК С
	|ГДЕ
	|	НЕ С.Ссылка.ПометкаУдаления
	|	И С.Счет ССЫЛКА ПланСчетов.Хозрасчетный
	|	И С.Счет <> ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Профиль,
	|	Код");
	Запрос.УстановитьПараметр("Базовые", Базовые);
	Запрос.Текст = ИИА_БухгалтерскийДоступ.ТекстЗапросаПоПлану(Запрос.Текст);
	Пакет = Запрос.ВыполнитьПакет();

	Выборка = Пакет[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Профиль = НСтр("ru = 'Все профили'");
		НоваяСтрока.Состояние = НСтр("ru = 'Закрыт всегда'");
		НоваяСтрока.Пояснение = ПояснениеБазовыхСчетов();
	КонецЦикла;

	Выборка = Пакет[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		Если Выборка.Разрешен И Выборка.ЗакрытВсегда Тогда
			НоваяСтрока.Состояние = НСтр("ru = 'Закрыт всегда'");
			НоваяСтрока.Пояснение = НСтр("ru = 'Разрешение профиля не действует: счёт входит в 69, 70, 71 или 73.'");
		ИначеЕсли Выборка.Разрешен Тогда
			НоваяСтрока.Состояние = НСтр("ru = 'Разрешён профилем'");
			НоваяСтрока.Пояснение = НСтр("ru = 'Счёт со всеми субсчетами доступен в бухгалтерских отчётах ассистента.'");
		Иначе
			НоваяСтрока.Состояние = НСтр("ru = 'Запрещён профилем'");
			НоваяСтрока.Пояснение = НСтр("ru = 'Счёт со всеми субсчетами вырезается из бухгалтерских отчётов ассистента.'");
		КонецЕсли;
	КонецЦикла;
	Возврат Таблица;

КонецФункции

// Подключения моделей с уровнем доверия и классами данных, которые им можно передавать.
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * Подключение - СправочникСсылка.ИИА_ПодключенияМоделей
//   * Модель - Строка
//   * Доверие - Строка - представление уровня; пустой уровень показывается как Т3.
//   * Классы - Строка - «К0–К1», «К0–К2» или «К0–К4».
//   * Используется - Булево
//
Функция МоделиДоступа() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Подключение");
	Таблица.Колонки.Добавить("Модель", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Доверие", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Классы", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Используется", Новый ОписаниеТипов("Булево"));

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	П.Ссылка КАК Подключение,
	|	П.Модель КАК Модель,
	|	П.Доверие КАК Доверие,
	|	П.Используется КАК Используется
	|ИЗ
	|	Справочник.ИИА_ПодключенияМоделей КАК П
	|ГДЕ
	|	НЕ П.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	П.Порядок,
	|	П.Наименование");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка, "Подключение, Модель, Используется");
		НоваяСтрока.Доверие = ПредставлениеДоверия(Выборка.Доверие);
		НоваяСтрока.Классы = ИИА_КлассыДанных.ДопустимыеКлассы(Выборка.Доверие);
	КонецЦикла;
	Возврат Таблица;

КонецФункции

// Краткие правила доступа для формы и модели: слои защиты, классы и матрица доверия.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ПравилаДоступа() Экспорт

	Правила = Новый Массив;
	Правила.Добавить(НСтр("ru = 'Жёсткий периметр закрывает для любой модели персональные данные физлиц, кадровые и зарплатные данные, переписку, секреты (пароли, ключи) и свободный текст (комментарии, описания, адреса, телефоны). Профиль и администратор его не открывают.'"));
	Правила.Добавить(НСтр("ru = 'Классы данных: К0 - открытые (НСИ, перечисления), К1 - внутренние (обороты, остатки), К2 - коммерческая тайна (себестоимость, маржа, наценки, договоры, цены поставщиков, партии), К3 - персональные, К4 - особые.'"));
	Правила.Добавить(НСтр("ru = 'Уровни доверия моделей: Т1 - модель в контуре компании, получает К0-К4; Т2 - облако РФ по договору, получает К0-К2; Т3 - внешнее облако, получает К0-К1. Подключение без уровня считается Т3.'"));
	Правила.Добавить(НСтр("ru = 'Класс объекта определяется автоматически по имени и ресурсам; служба безопасности может переопределить его в «Классификации данных». Класс поля не ниже класса объекта; отчёт классифицируется целиком.'"));
	Правила.Добавить(ПояснениеБазовыхСчетов() + " "
		+ НСтр("ru = 'Регистр бухгалтерии модель читает только через бухгалтерские отчёты и только по счетам, доступным профилю.'"));
	Правила.Добавить(НСтр("ru = 'Профиль доступа только сужает периметр: закрывает объекты, поля, инструменты и счета и задаёт модели пользователя.'"));
	Правила.Добавить(НСтр("ru = 'Значения вне периметра в ответах заменяются; персональные данные в разрешённых объектах маскируются для модели, но видны пользователю.'"));
	Правила.Добавить(НСтр("ru = 'Коммерческое маскирование: если пользователю может отвечать внешняя модель (Т3), наименования и реквизиты объектов из списка маскирования (контрагенты, партнёры, организации, номенклатура и другие) и ИНН организаций передаются ей псевдонимами; модель видит «Контрагент №5», пользователь - настоящее значение. Модели Т1/Т2 видят наименования.'"));
	Возврат Правила;

КонецФункции

// Описание инструмента data_access для агента.
//
// Возвращаемое значение:
//  Массив из Соответствие
//
Функция ОписанияИнструментов() Экспорт

	Свойства = Новый Соответствие;
	Свойства.Вставить("object", СвойствоПараметра("string",
		НСтр("ru = 'Необязательно: объект или поле - полное имя («РегистрНакопления.ВыручкаИСебестоимостьПродаж», «Справочник.ФизическиеЛица.ИНН») или слова из названия («себестоимость продаж»).'")));
	Если ИИА_БухгалтерскийДоступ.ПланСчетовДоступен() Тогда
		Свойства.Вставить("account", СвойствоПараметра("string",
			НСтр("ru = 'Необязательно: код или наименование счёта бухучёта («70», «60.01»).'")));
	КонецЕсли;
	Параметры = Новый Соответствие;
	Параметры.Вставить("type", "object");
	Параметры.Вставить("properties", Свойства);
	Параметры.Вставить("required", Новый Массив);
	ФункцияИнструмента = Новый Соответствие;
	ФункцияИнструмента.Вставить("name", "data_access");
	ФункцияИнструмента.Вставить("description", НСтр("ru = 'Правила доступа ИИ-ассистента к данным: какие данные закрыты всегда (персональные, кадровые, зарплатные, переписка, секреты), класс данных объекта или поля (К0-К4) и откуда он взят, каким моделям (уровни доверия Т1-Т3) его можно передать, состояние счёта бухучёта для пользователя, модели пользователя и их доверие. Вызывай, когда спрашивают, почему ассистент не видит или не отдаёт данные, какие данные уходят модели, как устроен или настраивается доступ ассистента.'"));
	ФункцияИнструмента.Вставить("parameters", Параметры);
	Описание = Новый Соответствие;
	Описание.Вставить("type", "function");
	Описание.Вставить("function", ФункцияИнструмента);

	Инструменты = Новый Массив;
	Инструменты.Добавить(Описание);
	Возврат Инструменты;

КонецФункции

// Выполняет data_access.
//
// Параметры:
//  Аргументы - Соответствие
//  Результат - Структура - см. ИИА_Инструменты.ВыполнитьИнструмент.
//
// Возвращаемое значение:
//  Структура
//
Функция ВыполнитьИнструмент(Аргументы, Результат) Экспорт

	Данные = Новый Структура;
	Данные.Вставить("rules", ПравилаДоступа());
	Данные.Вставить("models", МоделиПользователя());
	Данные.Вставить("masking", ИИА_Маскирование.ОписаниеДляМодели());

	ТекстОбъекта = СокрЛП(СтрокаАргумента(Аргументы, "object"));
	Если Не ПустаяСтрока(ТекстОбъекта) Тогда
		Данные.Вставить("objects", ОписанияОбъектов(ТекстОбъекта));
	КонецЕсли;
	ТекстСчета = СокрЛП(СтрокаАргумента(Аргументы, "account"));
	Если Не ПустаяСтрока(ТекстСчета) Тогда
		Данные.Вставить("account", ОписаниеСчета(ТекстСчета));
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.Итог = "OK";
	Результат.Данные = Данные;
	// Правила доступа и имена метаданных - открытые сведения о расширении.
	Результат.Класс = 0;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДействующийКласс(ПолноеИмя, Вид, КлассЗаписи, ДействующиеКлассы)

	// Отчёт классифицируется целиком, его строка уже содержит класс с учётом карточки.
	Если ВРег(Вид) = "ОТЧЕТ" Тогда
		Ручной = ДействующиеКлассы.Получить(ВРег(ПолноеИмя));
		Возврат ?(Ручной = Неопределено, ИИА_КлассыДанных.ЧислоКласса(КлассЗаписи), Ручной);
	КонецЕсли;
	Возврат ИИА_КлассыДанных.ЭффективныйКласс(ПолноеИмя, ДействующиеКлассы);

КонецФункции

Функция ПричинаПериметра(ИмяОбъекта, ПутьПоля, Периметр)

	Причина = Периметр.ЗапрещенныеОбъекты.Получить(ВРег(ИмяОбъекта));
	Если Причина = Неопределено И Не ПустаяСтрока(ПутьПоля) Тогда
		Причина = Периметр.ЗапрещенныеПоля.Получить(ВРег(ИмяОбъекта + "." + ПутьПоля));
		Если Причина = Неопределено Тогда
			Части = СтрРазделить(ПутьПоля, ".");
			Если ИИА_Периметр.ЭтоИмяСекрета(Части[Части.ВГраница()]) Тогда
				Причина = НСтр("ru = 'секрет'");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат ?(Причина = Неопределено, "", Строка(Причина));

КонецФункции

Функция ПредставлениеКлюча(ИмяОбъекта, ПутьПоля, Синонимы)

	ОбъектМетаданных = Синонимы.Получить(ИмяОбъекта);
	Если ОбъектМетаданных = Неопределено Тогда
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ИмяОбъекта);
		Синонимы.Вставить(ИмяОбъекта, ?(ОбъектМетаданных = Неопределено, Ложь, ОбъектМетаданных));
	КонецЕсли;
	Если ОбъектМетаданных = Ложь Или ОбъектМетаданных = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Представление = ОбъектМетаданных.Представление();
	Если ПустаяСтрока(ПутьПоля) Тогда
		Возврат Представление;
	КонецЕсли;
	Возврат Представление + " / " + ПредставлениеПоля(ОбъектМетаданных, ПутьПоля);

КонецФункции

Функция ПредставлениеПоля(ОбъектМетаданных, ПутьПоля)

	Части = СтрРазделить(ПутьПоля, ".");
	Владелец = ОбъектМетаданных;
	Префикс = "";
	Если Части.Количество() = 2 Тогда
		ТабличнаяЧасть = НайтиВКоллекциях(ОбъектМетаданных, "ТабличныеЧасти", Части[0]);
		Если ТабличнаяЧасть = Неопределено Тогда
			Возврат ПутьПоля;
		КонецЕсли;
		Владелец = ТабличнаяЧасть;
		Префикс = ТабличнаяЧасть.Представление() + ". ";
	КонецЕсли;
	Поле = НайтиВКоллекциях(Владелец, "Реквизиты,Измерения,Ресурсы", Части[Части.ВГраница()]);
	Возврат Префикс + ?(Поле = Неопределено, Части[Части.ВГраница()], Поле.Представление());

КонецФункции

// Ищет элемент по имени в коллекциях объекта метаданных; отсутствующие у вида объекта коллекции пропускаются.
Функция НайтиВКоллекциях(ОбъектМетаданных, ИменаКоллекций, Имя)

	Для Каждого ИмяКоллекции Из СтрРазделить(ИменаКоллекций, ",") Цикл
		Попытка
			Элемент = ОбъектМетаданных[ИмяКоллекции].Найти(Имя);
		// У вида объекта нет такой коллекции (например, у справочника - измерений).
		Исключение // BSLLS:MissingCodeTryCatchEx-off
			Элемент = Неопределено;
		КонецПопытки;
		Если Элемент <> Неопределено Тогда
			Возврат Элемент;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ПояснениеБазовыхСчетов()

	Возврат НСтр("ru = 'Счета 69, 70, 71 и 73 (расчёты с персоналом: кадровые и зарплатные данные) закрыты всегда со всеми субсчетами; разрешение в профиле их не открывает.'");

КонецФункции

Функция ПредставлениеДоверия(Доверие)

	Если ЗначениеЗаполнено(Доверие) Тогда
		Возврат Строка(Доверие);
	КонецЕсли;
	Возврат НСтр("ru = 'не указан (считается Т3)'");

КонецФункции

Функция МоделиПользователя()

	Модели = Новый Массив;
	Подключения = Новый Массив;
	Для Каждого Описание Из ИИА_LLM.ДоступныеМодели() Цикл
		Подключения.Добавить(Описание.Подключение);
	КонецЦикла;
	Если Подключения.Количество() = 0 Тогда
		Возврат Модели;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	П.Ссылка КАК Ссылка,
	|	П.Наименование КАК Наименование,
	|	П.Доверие КАК Доверие
	|ИЗ
	|	Справочник.ИИА_ПодключенияМоделей КАК П
	|ГДЕ
	|	П.Ссылка В (&Подключения)");
	Запрос.УстановитьПараметр("Подключения", Подключения);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Модели.Добавить(Новый Структура("name, trust, classes", Выборка.Наименование,
			ПредставлениеДоверия(Выборка.Доверие), ИИА_КлассыДанных.ДопустимыеКлассы(Выборка.Доверие)));
	КонецЦикла;
	Возврат Модели;

КонецФункции

// Описания объектов или полей по полному имени либо по словам из названия (до пяти).
Функция ОписанияОбъектов(Текст)

	Описания = Новый Массив;
	Ключи = Новый Массив;
	Части = СтрРазделить(Текст, ".");
	ОбъектМетаданных = ?(Части.Количество() >= 2, Метаданные.НайтиПоПолномуИмени(Части[0] + "." + Части[1]), Неопределено);
	Если ОбъектМетаданных <> Неопределено Тогда
		Ключи.Добавить(ОбъектМетаданных.ПолноеИмя() + Сред(Текст, СтрДлина(Части[0] + "." + Части[1]) + 1));
	Иначе
		Для Каждого Найденный Из ИИА_Знания.НайтиВКаталогеМетаданных(Текст, 5) Цикл
			Ключи.Добавить(Найденный.name);
		КонецЦикла;
	КонецЕсли;
	Если Ключи.Количество() = 0 Тогда
		Описания.Добавить(Новый Структура("error", НСтр("ru = 'Объект не найден в конфигурации. Уточните название или полное имя.'")));
		Возврат Описания;
	КонецЕсли;

	ДействующиеКлассы = ИИА_КлассыДанныхПовтИсп.Классификация();
	Периметр = ИИА_Периметр.ОписаниеПериметра();
	УстановитьПривилегированныйРежим(Истина);
	Записи = ЗаписиКлассификации(Ключи);
	Синонимы = Новый Соответствие;
	Для Каждого Ключ Из Ключи Цикл
		Части = СтрРазделить(Ключ, ".");
		ИмяОбъекта = Части[0] + "." + Части[1];
		ПутьПоля = Сред(Ключ, СтрДлина(ИмяОбъекта) + 2);
		Запись = Записи.Получить(ВРег(Ключ));
		Если ВРег(Части[0]) = "ОТЧЕТ" Тогда
			Класс = ИИА_КлассыДанных.КлассОтчета(ИмяОбъекта,
				?(Запись = Неопределено, 1, ИИА_КлассыДанных.ЧислоКласса(Запись.Класс)));
		Иначе
			Класс = ИИА_КлассыДанных.ЭффективныйКласс(Ключ, ДействующиеКлассы);
		КонецЕсли;
		ПричинаЗакрытия = ПричинаПериметра(ИмяОбъекта, ПутьПоля, Периметр);
		ПричинаПрофиля = "";
		Если ПустаяСтрока(ПутьПоля) Тогда
			ИИА_ПрофилиДоступа.ОбъектЗапрещенПрофилем(ИмяОбъекта, ПричинаПрофиля);
		Иначе
			ИИА_ПрофилиДоступа.ПолеЗапрещеноПрофилем(ИмяОбъекта, ПутьПоля, ПричинаПрофиля);
		КонецЕсли;

		Описание = Новый Структура;
		Описание.Вставить("name", Ключ);
		Описание.Вставить("synonym", ПредставлениеКлюча(ИмяОбъекта, ПутьПоля, Синонимы));
		Описание.Вставить("data_class", ИИА_КлассыДанных.ПредставлениеКласса(Класс));
		Описание.Вставить("class_source", ИсточникКласса(Ключ, Запись, ДействующиеКлассы));
		Описание.Вставить("closed_by_perimeter", ПричинаЗакрытия);
		Описание.Вставить("closed_by_user_profile", ПричинаПрофиля);
		Описание.Вставить("allowed_trust_levels", ?(ПустаяСтрока(ПричинаЗакрытия),
			ИИА_КлассыДанных.ДопустимыеУровниДоверия(Класс), НСтр("ru = 'никто'")));
		Если ПустаяСтрока(ПутьПоля) Тогда
			Описание.Вставить("fields_with_higher_class", ПоляСПовышеннымКлассом(ИмяОбъекта, ДействующиеКлассы));
		КонецЕсли;
		Описания.Добавить(Описание);
	КонецЦикла;
	Возврат Описания;

КонецФункции

Функция ЗаписиКлассификации(Ключи)

	Результат = Новый Соответствие;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	К.ПолноеИмя КАК ПолноеИмя,
	|	К.Класс КАК Класс,
	|	К.Автоматически КАК Автоматически
	|ИЗ
	|	РегистрСведений.ИИА_КлассификацияДанных КАК К
	|ГДЕ
	|	К.ПолноеИмя В (&Ключи)");
	Запрос.УстановитьПараметр("Ключи", Ключи);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(ВРег(СокрЛП(Выборка.ПолноеИмя)), Новый Структура("Класс, Автоматически", Выборка.Класс, Выборка.Автоматически));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ИсточникКласса(Ключ, Запись, ДействующиеКлассы)

	Если ДействующиеКлассы.Получить(ВРег(Ключ)) <> Неопределено Тогда
		Если ИИА_Политики.ПолитикиЧерезВерсии() Тогда
			Возврат НСтр("ru = 'задан вручную в действующей версии политик'");
		КонецЕсли;
		Возврат НСтр("ru = 'задан вручную в «Классификации данных»'");
	КонецЕсли;
	Если Запись <> Неопределено И Не Запись.Автоматически Тогда
		Возврат НСтр("ru = 'ручная строка «Классификации данных» ещё не вошла в действующую версию политик; действует класс по умолчанию'");
	КонецЕсли;
	Возврат НСтр("ru = 'по умолчанию: по имени объекта и его ресурсов'");

КонецФункции

// Поля объекта с классом выше класса объекта (до 20).
Функция ПоляСПовышеннымКлассом(ИмяОбъекта, ДействующиеКлассы)

	Поля = Новый Массив;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 20
	|	К.ПолноеИмя КАК ПолноеИмя
	|ИЗ
	|	РегистрСведений.ИИА_КлассификацияДанных КАК К
	|ГДЕ
	|	К.ПолноеИмя ПОДОБНО &Префикс СПЕЦСИМВОЛ ""~""
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПолноеИмя");
	Запрос.УстановитьПараметр("Префикс", ЭкранироватьПодобно(ИмяОбъекта + ".") + "%");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Класс = ИИА_КлассыДанных.ЭффективныйКласс(СокрЛП(Выборка.ПолноеИмя), ДействующиеКлассы);
		Поля.Добавить(Новый Структура("name, data_class", СокрЛП(Выборка.ПолноеИмя), ИИА_КлассыДанных.ПредставлениеКласса(Класс)));
	КонецЦикла;
	Возврат Поля;

КонецФункции

Функция ОписаниеСчета(Текст)

	// Ищем и закрытые счета: инструмент объясняет, почему счёт недоступен. Код и наименование счёта - класс К0,
	// данные по счёту инструмент не читает.
	Если Не ИИА_БухгалтерскийДоступ.ПланСчетовДоступен() Тогда
		Возврат Новый Структура("error", НСтр("ru = 'В конфигурации нет плана счетов бухгалтерского учёта.'"));
	КонецЕсли;
	Набор = ИИА_ПериметрПовтИсп.НаборСчетов();
	Базовые = ИИА_БухгалтерскийДоступ.БазовыеЗапрещенныеСчета();
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Счета.Ссылка КАК Ссылка,
	|	Счета.Код КАК Код,
	|	Счета.Наименование КАК Наименование,
	|	Счета.Ссылка В ИЕРАРХИИ (&Базовые) КАК ЗакрытВсегда
	|ИЗ
	|	ПланСчетов.Хозрасчетный КАК Счета
	|ГДЕ
	|	НЕ Счета.ПометкаУдаления
	|	И (Счета.Код = &Код
	|			ИЛИ Счета.КодБыстрогоВыбора = &Код)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код");
	Запрос.УстановитьПараметр("Код", СтрЗаменить(СокрЛП(Текст), ",", "."));
	Запрос.УстановитьПараметр("Базовые", Базовые);
	ТекстПоиска = Запрос.Текст;
	Запрос.Текст = ИИА_БухгалтерскийДоступ.ТекстЗапросаПоПлану(ТекстПоиска);
	Найденные = Запрос.Выполнить().Выгрузить();
	Если Найденные.Количество() = 0 Тогда
		Запрос.Текст = ИИА_БухгалтерскийДоступ.ТекстЗапросаПоПлану(СтрЗаменить(ТекстПоиска, "(Счета.Код = &Код
		|			ИЛИ Счета.КодБыстрогоВыбора = &Код)", "Счета.Наименование ПОДОБНО &Подобно СПЕЦСИМВОЛ ""~"""));
		Запрос.УстановитьПараметр("Подобно", "%" + ЭкранироватьПодобно(СокрЛП(Текст)) + "%");
		Найденные = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	Если Найденные.Количество() = 0 Тогда
		Возврат Новый Структура("error", СтрШаблон(НСтр("ru = 'Счёт «%1» не найден.'"), СокрЛП(Текст)));
	ИначеЕсли Найденные.Количество() > 1 И ВРег(СокрЛП(Найденные[0].Код)) <> ВРег(СокрЛП(Текст)) Тогда
		Возврат Новый Структура("error", СтрШаблон(НСтр("ru = 'Счёт «%1» неоднозначен: укажите код счёта.'"), СокрЛП(Текст)));
	КонецЕсли;
	Выборка = Найденные[0];
	Счет = Выборка.Ссылка;

	Состояния = Новый Соответствие;
	Состояния.Вставить("Доступен", НСтр("ru = 'доступен со всеми субсчетами'"));
	Состояния.Вставить("Частично", НСтр("ru = 'доступна часть субсчетов'"));
	Состояния.Вставить("Запрещен", НСтр("ru = 'закрыт'"));
	Описание = Новый Структура;
	Описание.Вставить("code", Выборка.Код);
	Описание.Вставить("name", Выборка.Наименование);
	Описание.Вставить("state_for_user", Состояния.Получить(ИИА_БухгалтерскийДоступ.СостояниеСчета(Счет, Набор)));
	Описание.Вставить("always_closed", Выборка.ЗакрытВсегда);
	Описание.Вставить("reason", ?(Выборка.ЗакрытВсегда, ПояснениеБазовыхСчетов(),
		НСтр("ru = 'Доступ к счёту задаётся таблицей «Счета» профиля доступа пользователя.'")));
	Возврат Описание;

КонецФункции

Функция СвойствоПараметра(Тип, Описание)

	Свойство = Новый Соответствие;
	Свойство.Вставить("type", Тип);
	Свойство.Вставить("description", Описание);
	Возврат Свойство;

КонецФункции

Функция СтрокаАргумента(Аргументы, Имя)

	Значение = Аргументы.Получить(Имя);
	Возврат ?(ТипЗнч(Значение) = Тип("Строка"), Значение, "");

КонецФункции

Функция ЭкранироватьПодобно(Текст)

	Результат = СтрЗаменить(Текст, "~", "~~");
	Для Каждого Символ Из СтрРазделить("%,_,[,],^", ",") Цикл
		Результат = СтрЗаменить(Результат, Символ, "~" + Символ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
