///////////////////////////////////////////////////////////////////////////////////////////////////////
// ИИ-ассистент: классы данных и доверие к провайдерам (план, раздел 4.5).
// Класс результата инструмента - максимум классов его источников (таблиц и полей запроса, отчёта, кода).
// Перед отправкой результата модели класс сверяется с уровнем доверия провайдера по матрице:
//   К0-К1 - любой провайдер; К2 - Т1 и Т2; К3-К4 - только Т1 (на этапе 1 К3/К4 к агенту не попадают вовсе).
// Подключение без указанного уровня доверия считается внешним облаком (Т3).
// Умолчания для ERP (себестоимость, маржа, договоры и соглашения - К2; НСИ - К0) переопределяет
// служба безопасности в регистре ИИА_КлассификацияДанных. В регистре есть и строки «Автоматически»:
// умолчания кода для всех объектов и полей с повышенным классом. Они нужны для просмотра, обновляются
// при изменении метаданных и не действуют; правка строки делает её ручной.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Класс объекта метаданных или его поля.
//
// Параметры:
//  ПолноеИмяОбъекта - Строка - «РегистрНакопления.ВыручкаИСебестоимостьПродаж».
//  ПутьПоля - Строка - необязательно: «Товары.Себестоимость».
//
// Возвращаемое значение:
//  Число - 0..4.
//
Функция КлассОбъекта(ПолноеИмяОбъекта, ПутьПоля = "") Экспорт

	Ключ = ПолноеИмяОбъекта + ?(ПустаяСтрока(ПутьПоля), "", "." + ПутьПоля);
	Возврат ЭффективныйКласс(Ключ, ИИА_КлассыДанныхПовтИсп.Классификация());

КонецФункции

// Класс отчёта (отчёт классифицируется целиком): из классификации по полному имени отчёта,
// иначе из карточки отчёта, иначе по умолчанию для имени (себестоимость, маржа - К2), иначе К1.
//
// Параметры:
//  ПолноеИмяОтчета - Строка
//  КлассКарточки - Число - класс из карточки отчёта.
//
// Возвращаемое значение:
//  Число
//
Функция КлассОтчета(ПолноеИмяОтчета, КлассКарточки = 1) Экспорт

	Класс = ИИА_КлассыДанныхПовтИсп.Классификация().Получить(ВРег(ПолноеИмяОтчета));
	Если Класс <> Неопределено Тогда
		Возврат Класс;
	КонецЕсли;
	Возврат Макс(КлассКарточки, ?(КлассПоУмолчанию(ПолноеИмяОтчета) = 2, 2, 1));

КонецФункции

// Возвращает класс объекта, поля или кода по указанному снимку классификации.
// Используется для runtime и сравнения политик; не обращается к действующей версии.
//
// Параметры:
//  Ключ - Строка - полное имя объекта или поля.
//  Классификация - Соответствие, ФиксированноеСоответствие - переопределения классов.
//
// Возвращаемое значение:
//  Число - эффективный класс с учётом умолчаний и наследования поля.
//
Функция ЭффективныйКласс(Ключ, Классификация) Экспорт

	Имя = ВРег(Ключ);
	Класс = Классификация.Получить(Имя);
	Разделитель = СтрНайти(Имя, ".", НаправлениеПоиска.СНачала, 1, 2);
	Если Разделитель = 0 Тогда
		Возврат ?(Класс = Неопределено, КлассПоУмолчанию(Имя), Класс);
	КонецЕсли;
	КлассОбъекта = ЭффективныйКласс(Лев(Имя, Разделитель - 1), Классификация);
	Если Класс = Неопределено Тогда
		Класс = КлассПоляПоУмолчанию(Сред(Имя, Разделитель + 1));
	КонецЕсли;
	Возврат Макс(КлассОбъекта, Класс);

КонецФункции

// Допускает ли уровень доверия провайдера класс данных (матрица раздела 4.5).
//
// Параметры:
//  Класс - Число - 0..4.
//  Доверие - ПеречислениеСсылка.ИИА_УровниДоверия - пустое значение считается Т3.
//
// Возвращаемое значение:
//  Булево
//
Функция КлассДопустимДляДоверия(Класс, Доверие) Экспорт

	УровеньДоверия = УровеньДоверия(Доверие);
	Если Класс <= 1 Тогда
		Возврат Истина;
	ИначеЕсли Класс = 2 Тогда
		Возврат УровеньДоверия <= 2;
	КонецЕсли;
	Возврат УровеньДоверия = 1;

КонецФункции

// Представление класса: «К0» ... «К4».
//
// Параметры:
//  Класс - Число
//
// Возвращаемое значение:
//  Строка
//
Функция ПредставлениеКласса(Класс) Экспорт

	Возврат "К" + Формат(Класс, "ЧН=0; ЧГ=");

КонецФункции

// Значение перечисления ИИА_КлассыДанных по числу.
//
// Параметры:
//  Класс - Число
//
// Возвращаемое значение:
//  ПеречислениеСсылка.ИИА_КлассыДанных
//
Функция ЗначениеКласса(Класс) Экспорт

	Возврат Перечисления.ИИА_КлассыДанных[ПредставлениеКласса(Макс(0, Мин(4, Класс)))];

КонецФункции

// Строит классификацию без кэша (см. ИИА_КлассыДанныхПовтИсп.Классификация).
//
// Возвращаемое значение:
//  ФиксированноеСоответствие
//
Функция ПостроитьКлассификацию() Экспорт

	Результат = Новый Соответствие;
	Если ИИА_Политики.ПолитикиЧерезВерсии() Тогда
		Для Каждого КлючИЗначение Из ИИА_Политики.СнимокДействующейВерсии().Получить("classification") Цикл
			Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		Возврат Новый ФиксированноеСоответствие(Результат);
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	// Автоматические строки повторяют умолчания кода и служат для просмотра; действуют только ручные.
	Запрос = Новый Запрос("ВЫБРАТЬ ПолноеИмя, Класс ИЗ РегистрСведений.ИИА_КлассификацияДанных ГДЕ НЕ Автоматически");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Класс) Тогда
			Результат.Вставить(ВРег(СокрЛП(Выборка.ПолноеИмя)), ЧислоКласса(Выборка.Класс));
		КонецЕсли;
	КонецЦикла;
	Возврат Новый ФиксированноеСоответствие(Результат);

КонецФункции

// Число 0..4 по значению перечисления.
//
// Параметры:
//  Значение - ПеречислениеСсылка.ИИА_КлассыДанных
//
// Возвращаемое значение:
//  Число
//
Функция ЧислоКласса(Значение) Экспорт

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат 1;
	КонецЕсли;
	Возврат Перечисления.ИИА_КлассыДанных.Индекс(Значение);

КонецФункции

// Возвращает подтверждённый класс; неизвестный класс истории/контекста закрывается как К4.
//
// Параметры:
//  Значение - Число, ПеречислениеСсылка.ИИА_КлассыДанных, Неопределено - переданный класс.
//
// Возвращаемое значение:
//  Число - 0..4, для отсутствующего или некорректного значения 4.
//
Функция ПодтвержденныйКласс(Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Если Значение >= 0 И Значение <= 4 И Значение = Цел(Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Значение) = Тип("ПеречислениеСсылка.ИИА_КлассыДанных") Тогда
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Перечисления.ИИА_КлассыДанных.Индекс(Значение);
		КонецЕсли;
	КонецЕсли;
	Возврат 4;

КонецФункции

// Классы по умолчанию для всех объектов конфигурации и полей, класс которых выше класса объекта.
// Отчёт классифицируется целиком: учитывается класс его карточки.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - полное имя объекта или поля («Документ.Х.Товары.Себестоимость»).
//   * Значение - Число - 0..4.
//
Функция АвтоматическаяКлассификация() Экспорт

	Результат = Новый Соответствие;
	КлассыКарточек = КлассыКарточекОтчетов();
	Для Каждого Коллекция Из КоллекцииКлассификации() Цикл
		Для Каждого ОбъектМетаданных Из Метаданные[Коллекция] Цикл
			ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
			Если Коллекция = "Отчеты" Тогда
				Класс = КлассПоУмолчаниюОтчета(ПолноеИмя, КлассыКарточек);
			Иначе
				Класс = КлассПоУмолчанию(ПолноеИмя);
			КонецЕсли;
			Результат.Вставить(ПолноеИмя, Класс);
			Для Каждого ПутьПоля Из ПутиПолей(ОбъектМетаданных, Коллекция) Цикл
				КлассПоля = КлассПоляПоУмолчанию(ПутьПоля);
				Если КлассПоля > Класс Тогда
					Результат.Вставить(ПолноеИмя + "." + ПутьПоля, КлассПоля);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Синхронизирует автоматические строки регистра ИИА_КлассификацияДанных с умолчаниями кода:
// добавляет новые объекты, удаляет исчезнувшие, обновляет класс. Ручные строки не меняются,
// для ключа с ручной строкой автоматическая не создаётся.
//
// Возвращаемое значение:
//  Структура:
//   * Добавлено - Число
//   * Изменено - Число
//   * Удалено - Число
//
Функция СинхронизироватьАвтоматическуюКлассификацию() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Итог = Новый Структура("Добавлено, Изменено, Удалено", 0, 0, 0);
	Нужные = АвтоматическаяКлассификация();

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Блокировка.Добавить("РегистрСведений.ИИА_КлассификацияДанных");
		Блокировка.Заблокировать();

		Набор = РегистрыСведений.ИИА_КлассификацияДанных.СоздатьНаборЗаписей();
		Набор.Прочитать();
		Ручные = Новый Соответствие;
		Для Каждого Запись Из Набор Цикл
			Если Не Запись.Автоматически Тогда
				Ручные.Вставить(ВРег(СокрЛП(Запись.ПолноеИмя)), Истина);
			КонецЕсли;
		КонецЦикла;

		Найденные = Новый Соответствие;
		Удаляемые = Новый Массив;
		Для Каждого Запись Из Набор Цикл
			Если Не Запись.Автоматически Тогда
				Продолжить;
			КонецЕсли;
			Класс = Нужные.Получить(Запись.ПолноеИмя);
			Если Класс = Неопределено Или Ручные.Получить(ВРег(СокрЛП(Запись.ПолноеИмя))) <> Неопределено
				Или Найденные.Получить(Запись.ПолноеИмя) <> Неопределено Тогда
				Удаляемые.Добавить(Запись);
				Продолжить;
			КонецЕсли;
			Найденные.Вставить(Запись.ПолноеИмя, Истина);
			Значение = ЗначениеКласса(Класс);
			Если Запись.Класс <> Значение Тогда
				Запись.Класс = Значение;
				Итог.Изменено = Итог.Изменено + 1;
			КонецЕсли;
		КонецЦикла;
		Для Каждого Запись Из Удаляемые Цикл
			Набор.Удалить(Запись);
		КонецЦикла;
		Итог.Удалено = Удаляемые.Количество();

		Для Каждого КлючИЗначение Из Нужные Цикл
			Если Найденные.Получить(КлючИЗначение.Ключ) <> Неопределено
				Или Ручные.Получить(ВРег(КлючИЗначение.Ключ)) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Запись = Набор.Добавить();
			Запись.ПолноеИмя = КлючИЗначение.Ключ;
			Запись.Класс = ЗначениеКласса(КлючИЗначение.Значение);
			Запись.Автоматически = Истина;
			Итог.Добавлено = Итог.Добавлено + 1;
		КонецЦикла;

		Если Итог.Добавлено + Итог.Изменено + Итог.Удалено > 0 Тогда
			Набор.ДополнительныеСвойства.Вставить("АвтоматическаяКлассификация", Истина);
			Набор.Записать();
		КонецЕсли;
		Константы.ИИА_ВерсияАвтоклассификации.Установить(ВерсияАвтоклассификации());
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Итог;

КонецФункции

// Синхронизирует автоматическую классификацию, если изменились метаданные, карточки отчётов
// или правила умолчаний. Проверка - чтение одной константы; ошибка пишется в журнал регистрации.
//
Процедура ОбновитьАвтоматическуюКлассификациюПриНеобходимости() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Если Константы.ИИА_ВерсияАвтоклассификации.Получить() = ВерсияАвтоклассификации() Тогда
		Возврат;
	КонецЕсли;
	Попытка
		СинхронизироватьАвтоматическуюКлассификацию();
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'ИИАссистент.Классификация'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка, , , ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Удаляет ручную строку классификации и восстанавливает автоматическую, если ключ входит
// в автоматическую классификацию.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта или поля.
//
Процедура ВернутьАвтоматическийКласс(ПолноеИмя) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Набор = РегистрыСведений.ИИА_КлассификацияДанных.СоздатьНаборЗаписей();
	Набор.Отбор.ПолноеИмя.Установить(ПолноеИмя);
	Класс = АвтоматическаяКлассификация().Получить(ПолноеИмя);
	Если Класс <> Неопределено Тогда
		Запись = Набор.Добавить();
		Запись.ПолноеИмя = ПолноеИмя;
		Запись.Класс = ЗначениеКласса(Класс);
		Запись.Автоматически = Истина;
	КонецЕсли;
	Набор.ДополнительныеСвойства.Вставить("АвтоматическаяКлассификация", Истина);
	Набор.Записать();

КонецПроцедуры

// Доступность класса данных по уровням доверия: «Т1, Т2, Т3», «Т1, Т2» или «Т1».
//
// Параметры:
//  Класс - Число
//
// Возвращаемое значение:
//  Строка
//
Функция ДопустимыеУровниДоверия(Класс) Экспорт

	Уровни = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Т1,Т2,Т3", ",") Цикл
		Если КлассДопустимДляДоверия(Класс, Перечисления.ИИА_УровниДоверия[Имя]) Тогда
			Уровни.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Уровни, ", ");

КонецФункции

// Классы данных, которые получает модель с указанным доверием: «К0–К1», «К0–К2» или «К0–К4».
//
// Параметры:
//  Доверие - ПеречислениеСсылка.ИИА_УровниДоверия - пустое значение считается Т3.
//
// Возвращаемое значение:
//  Строка
//
Функция ДопустимыеКлассы(Доверие) Экспорт

	Максимум = 0;
	Для Класс = 1 По 4 Цикл
		Если КлассДопустимДляДоверия(Класс, Доверие) Тогда
			Максимум = Класс;
		КонецЕсли;
	КонецЦикла;
	Возврат "К0–" + ПредставлениеКласса(Максимум);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция УровеньДоверия(Доверие)

	Если Доверие = Перечисления.ИИА_УровниДоверия.Т1 Тогда
		Возврат 1;
	ИначеЕсли Доверие = Перечисления.ИИА_УровниДоверия.Т2 Тогда
		Возврат 2;
	КонецЕсли;
	Возврат 3;

КонецФункции

Функция КлассПоУмолчанию(ПолноеИмяОбъекта)

	Имя = ВРег(ПолноеИмяОбъекта);
	Для Каждого Маркер Из МаркерыК2() Цикл
		Если СтрНайти(Имя, Маркер) > 0 Тогда
			// Регистр «ВыручкаИСебестоимостьПродаж»: выручка и количество - К1, себестоимость - К2 на уровне ресурсов.
			Возврат ?(ЕстьРесурсыБезМаркеров(ПолноеИмяОбъекта), 1, 2);
		КонецЕсли;
	КонецЦикла;
	Если СтрНачинаетсяС(Имя, "ПЕРЕЧИСЛЕНИЕ.") Тогда
		Возврат 0;
	КонецЕсли;
	Для Каждого Справочник Из СтрРазделить("НОМЕНКЛАТУРА,СКЛАДЫ,ОРГАНИЗАЦИИ,ВАЛЮТЫ,УПАКОВКИЕДИНИЦЫИЗМЕРЕНИЯ,ВИДЫНОМЕНКЛАТУРЫ,"
		+ "ХАРАКТЕРИСТИКИНОМЕНКЛАТУРЫ,СТРАНЫМИРА,ПОДРАЗДЕЛЕНИЯ,СТРУКТУРАПРЕДПРИЯТИЯ", ",") Цикл
		Если Имя = "СПРАВОЧНИК." + Справочник Тогда
			Возврат 0;
		КонецЕсли;
	КонецЦикла;
	Возврат 1;

КонецФункции

// Есть ли у регистра ресурсы без признаков К2: тогда класс К2 определяется полями, а не регистром целиком.
Функция ЕстьРесурсыБезМаркеров(ПолноеИмяОбъекта)

	Если Не СтрНачинаетсяС(ВРег(ПолноеИмяОбъекта), "РЕГИСТР") Тогда
		Возврат Ложь;
	КонецЕсли;
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмяОбъекта);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Ресурс Из ОбъектМетаданных.Ресурсы Цикл
		Если КлассПоляПоУмолчанию(Ресурс.Имя) < 2 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция КлассПоляПоУмолчанию(ПутьПоля)

	Имя = ВРег(ПутьПоля);
	Для Каждого Маркер Из МаркерыК2() Цикл
		Если СтрНайти(Имя, Маркер) > 0 Тогда
			Возврат 2;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;

КонецФункции

Функция КоллекцииКлассификации()

	Возврат СтрРазделить("Справочники,Документы,ЖурналыДокументов,Перечисления,ПланыВидовХарактеристик,ПланыСчетов,"
		+ "ПланыВидовРасчета,РегистрыСведений,РегистрыНакопления,РегистрыБухгалтерии,РегистрыРасчета,"
		+ "БизнесПроцессы,Задачи,Константы,Отчеты", ",");

КонецФункции

// Пути полей объекта: «Реквизит», «ТабличнаяЧасть.Реквизит», измерения и ресурсы регистров.
Функция ПутиПолей(ОбъектМетаданных, Коллекция)

	Пути = Новый Массив;
	Если СтрНачинаетсяС(Коллекция, "Регистры") Тогда
		КоллекцииПолей = СтрРазделить("Измерения,Ресурсы,Реквизиты", ",");
		ЕстьТабличныеЧасти = Ложь;
	ИначеЕсли СтрНайти(",Справочники,Документы,ПланыВидовХарактеристик,ПланыСчетов,ПланыВидовРасчета,БизнесПроцессы,Задачи,",
		"," + Коллекция + ",") > 0 Тогда
		КоллекцииПолей = СтрРазделить("Реквизиты", ",");
		ЕстьТабличныеЧасти = Истина;
	Иначе
		Возврат Пути;
	КонецЕсли;
	Для Каждого Имя Из КоллекцииПолей Цикл
		Для Каждого Поле Из ОбъектМетаданных[Имя] Цикл
			Пути.Добавить(Поле.Имя);
		КонецЦикла;
	КонецЦикла;
	Если ЕстьТабличныеЧасти Тогда
		Для Каждого ТабличнаяЧасть Из ОбъектМетаданных.ТабличныеЧасти Цикл
			Для Каждого Поле Из ТабличнаяЧасть.Реквизиты Цикл
				Пути.Добавить(ТабличнаяЧасть.Имя + "." + Поле.Имя);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	Возврат Пути;

КонецФункции

// Максимальный класс используемых карточек по имени отчёта (без префикса «Отчет.»), в верхнем регистре.
Функция КлассыКарточекОтчетов()

	Результат = Новый Соответствие;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	К.ИмяОтчета КАК ИмяОтчета,
	|	К.Класс КАК Класс
	|ИЗ
	|	Справочник.ИИА_КарточкиОтчетов КАК К
	|ГДЕ
	|	НЕ К.ПометкаУдаления
	|	И К.Используется");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = ВРег(СокрЛП(Выборка.ИмяОтчета));
		Класс = ЧислоКласса(Выборка.Класс);
		Результат.Вставить(Ключ, Макс(Класс, ?(Результат.Получить(Ключ) = Неопределено, 0, Результат.Получить(Ключ))));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция КлассПоУмолчаниюОтчета(ПолноеИмяОтчета, КлассыКарточек)

	КлассКарточки = КлассыКарточек.Получить(ВРег(Сред(ПолноеИмяОтчета, СтрНайти(ПолноеИмяОтчета, ".") + 1)));
	Возврат Макс(?(КлассКарточки = Неопределено, 1, КлассКарточки), ?(КлассПоУмолчанию(ПолноеИмяОтчета) = 2, 2, 1));

КонецФункции

// Ключ версии автоматической классификации: правила умолчаний, метаданные и классы карточек отчётов.
Функция ВерсияАвтоклассификации()

	Части = Новый Массив;
	Части.Добавить("правила 1"); // при изменении умолчаний кода увеличить
	Части.Добавить(ИИА_Знания.ВерсияМетаданных());
	Для Каждого КлючИЗначение Из КлассыКарточекОтчетов() Цикл
		Части.Добавить(КлючИЗначение.Ключ + "=" + КлючИЗначение.Значение);
	КонецЦикла;
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(СтрСоединить(Части, ";"));
	Возврат "классы 1; " + Base64Строка(Хеширование.ХешСумма);

КонецФункции

Функция МаркерыК2()

	Возврат СтрРазделить("СЕБЕСТОИМОСТ,МАРЖ,ВАЛОВАЯПРИБЫЛЬ,НАЦЕНК,ЦЕНЫНОМЕНКЛАТУРЫПОСТАВЩИКОВ,ДОГОВОРЫКОНТРАГЕНТОВ,"
		+ "СОГЛАШЕНИЯСКЛИЕНТАМИ,СОГЛАШЕНИЯСПОСТАВЩИКАМИ,ПАРТИИ", ",");

КонецФункции

#КонецОбласти
