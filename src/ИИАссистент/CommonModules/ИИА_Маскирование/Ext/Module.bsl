// BSLLS:CommonModuleInvalidType-off
// Только сервер: вызов с клиента и внешнее соединение намеренно отключены.
// BSLLS:CommonModuleInvalidType-on
///////////////////////////////////////////////////////////////////////////////////////////////////////
// ИИ-ассистент: маскирование данных для модели - единая точка для инструментов и параллельных доработок.
//
// Два вида псевдонимов (канонический вид данных хода):
//  - ПДн (Пользователь_, Физлицо_, ФИО_, ИНН_ + 10 hex) - для всех моделей, см. ИИА_Периметр;
//  - коммерческие (Контрагент_, Партнер_, Номенклатура_, Организация_ и префиксы из настроек, ИННЮЛ_ + 16 hex) -
//    пока действует коммерческое маскирование (ДействуетКоммерческоеМаскирование): в цепочке моделей профиля
//    пользователя есть модель Т3 (или канал http с доверием Т3). Пары «псевдоним -> значение» пишутся
//    в регистр ИИА_ПсевдонимыОбъектов (полный словарь в память не загружается).
//
// Границы (номера в диалоге - только на них):
//  - тело запроса к модели: СообщенияДляДоверия - для Т3 текстовый слой (наименования из справочников
//    списка -> псевдонимы, ИНН-10 -> ИННЮЛ_) и контрольная проверка; для Т1/Т2 коммерческие псевдонимы
//    раскрываются; последний шаг - хэш-псевдонимы -> «Вид №N» (Т1/Т2: «представление (N)»);
//  - ответ модели и вопрос пользователя: НомераВПсевдонимы («Контрагент №5», «менеджер 2», «ООО Ромашка (5)»
//    -> хэш-псевдоним по карте номеров диалога);
//  - показ пользователю: ДляПользователя (раскрытие с учётом RLS, номер в скобках).
//
// Контракт для параллельных изменений (см. .memory/changes/2026-10-13-iia-commercial-mask/spec.md):
//  - инструменты получают и возвращают только хэш-псевдонимы; разбирать номера внутри инструмента запрещено;
//  - значение для модели - ЗначениеДляМодели (не Строка(Ссылка)), строки - ТекстыДляМодели;
//  - аргумент-ссылка от модели - ЗначениеИзПсевдонима с проверкой типа; поиск по тексту - РаскрытьАргументы;
//  - реквизит из списка (ПолеМаскируется) модели не выдаётся, в запросе не принимается, не записывается;
//  - новые точки показа пользователю раскрывают только через ДляПользователя(Значение, Диалог, СНомерами);
//    для Excel и файлов СНомерами = Ложь.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Нужно ли маскировать коммерческие данные текущего пользователя.
// Истина, если в списке маскирования есть используемая строка и текущему пользователю может отвечать модель Т3:
// в эффективной цепочке его профиля есть используемое подключение с доверием Т3 или пустым доверием; для канала
// http - также при доверии внешнего канала Т3 или пустом. Кэшируется на сеанс.
//
// Параметры:
//  Канал - Строка - "chat", "http"; пусто - по сеансу: сеанс HTTP-сервиса - "http", иначе "chat".
//
// Возвращаемое значение:
//  Булево
//
Функция ДействуетКоммерческоеМаскирование(Знач Канал = "") Экспорт

	Если ПустаяСтрока(Канал) Тогда
		Канал = ИИА_МаскированиеПовтИсп.ТекущийКанал();
	КонецЕсли;
	Возврат ИИА_МаскированиеПовтИсп.ДействуетКоммерческоеМаскирование(Канал);

КонецФункции

// Пакетная разметка ссылок: какие контрагенты и партнёры - физлица или ИП (им всегда Физлицо_).
//
// Параметры:
//  Ссылки - Массив из ЛюбаяСсылка
//
// Возвращаемое значение:
//  Соответствие - см. ИИА_Периметр.ОтметитьСсылки.
//
Функция ОтметитьСсылки(Ссылки) Экспорт

	Возврат ИИА_Периметр.ОтметитьСсылки(Ссылки);

КонецФункции

// Канонический вид одного значения для модели: ПДн, коммерческие псевдонимы, периметр, детекторы.
//
// Параметры:
//  Значение - Произвольный
//  Признаки - Соответствие, Неопределено - результат ОтметитьСсылки; Неопределено - разметка по одному значению.
//  Скрыто - Число - увеличивается на число скрытых фрагментов.
//  Регистрация - Соответствие, Неопределено - буфер новых пар «псевдоним -> значение» для пакетной записи
//    (ЗаписатьПсевдонимы); Неопределено - пара пишется сразу.
//
// Возвращаемое значение:
//  Строка, Число, Булево, Неопределено
//
Функция ЗначениеДляМодели(Значение, Признаки = Неопределено, Скрыто = 0, Регистрация = Неопределено) Экспорт

	Возврат ИИА_Периметр.БезопасноеЗначение(Значение, Признаки, Скрыто, Регистрация);

КонецФункции

// Пакетно готовит строки для модели: детекторы ПДн и секретов (ИИА_Периметр.ОчиститьТекст) и, если действует
// коммерческое маскирование, текстовый коммерческий слой (ЗамаскироватьТексты).
//
// Параметры:
//  Тексты - Массив из Строка
//  Скрыто - Число - увеличивается на число скрытых фрагментов.
//  Кэш - Структура, Неопределено - см. НовыйКэш.
//
// Возвращаемое значение:
//  Массив из Строка - в том же порядке.
//
Функция ТекстыДляМодели(Тексты, Скрыто = 0, Кэш = Неопределено) Экспорт

	Результат = Новый Массив;
	Для Каждого Текст Из Тексты Цикл
		Если ТипЗнч(Текст) = Тип("Строка") Тогда
			Результат.Добавить(ИИА_Периметр.ОчиститьТекст(Текст, Скрыто));
		Иначе
			Результат.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
	Если Не ДействуетКоммерческоеМаскирование() Тогда
		Возврат Результат;
	КонецЕсли;
	Маскирование = ЗамаскироватьТексты(Результат, Кэш);
	Если Маскирование.Успех Тогда
		Возврат Маскирование.Тексты;
	КонецЕсли;
	// Безопасный отказ: при превышении лимита текст не уходит модели.
	Для Индекс = 0 По Результат.ВГраница() Цикл
		Если ТипЗнч(Результат[Индекс]) = Тип("Строка") И Не ПустаяСтрока(Результат[Индекс]) Тогда
			Результат[Индекс] = ИИА_Периметр.ЗаглушкаСкрыто();
			Скрыто = Скрыто + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Маскируется ли реквизит объекта: реквизит из списка маскирования, пока действует коммерческое маскирование.
// Такой реквизит модели не выдаётся, в запросе модели не принимается (MASKED_FIELD) и не записывается.
// Представление объекта маскируется вместе с наименованием.
//
// Параметры:
//  ПолноеИмяОбъекта - Строка - например "Справочник.Контрагенты".
//  ПутьПоля - Строка - имя реквизита.
//  Причина - Строка - возвращаемый параметр.
//
// Возвращаемое значение:
//  Булево
//
Функция ПолеМаскируется(ПолноеИмяОбъекта, ПутьПоля, Причина = "") Экспорт

	Если Не ДействуетКоммерческоеМаскирование() Тогда
		Возврат Ложь;
	КонецЕсли;
	Поля = НастройкиМаскирования().Поля.Получить(ВРег(ПолноеИмяОбъекта));
	Если Поля = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Части = СтрРазделить(ПутьПоля, ".");
	Если Части.Количество() <> 1 Или Поля.Получить(ВРег(СокрЛП(Части[0]))) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Причина = НСтр("ru = 'реквизит маскируется для модели: выбирай, группируй и отбирай по самой ссылке (модель получит псевдоним или номер), для поиска по имени есть find_records'");
	Возврат Истина;

КонецФункции

// Значение аргумента модели по псевдониму: ссылка (или строка ИНН) с проверкой типа.
//
// Параметры:
//  Текст - Строка - псевдоним (номер в аргументах уже переведён в хэш-псевдоним, см. НомераВПсевдонимы).
//  ОписаниеТипа - ОписаниеТипов, Неопределено - допустимые типы; Неопределено - любой.
//
// Возвращаемое значение:
//  ЛюбаяСсылка, Строка, Неопределено - Неопределено, если это не псевдоним или тип не подходит.
//
Функция ЗначениеИзПсевдонима(Текст, ОписаниеТипа = Неопределено) Экспорт

	Значение = ИИА_Периметр.СсылкаПоПсевдониму(Текст);
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ОписаниеТипа <> Неопределено И Не ОписаниеТипа.СодержитТип(ТипЗнч(Значение)) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Рекурсивно заменяет псевдонимы в аргументах модели исходными строками (для поиска по тексту).
//
// Параметры:
//  Значение - Произвольный - строка, массив, структура, соответствие.
//
// Возвращаемое значение:
//  Произвольный - копия.
//
Функция РаскрытьАргументы(Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат ИИА_Периметр.РаскрытьПсевдонимы(Значение);
	ИначеЕсли ЭтоКоллекция(Значение) Тогда
		Возврат КопияКоллекции(Значение, "РаскрытьАргументы");
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Канонический вид -> вид для модели или внешнего канала заданного уровня доверия.
// Т3 (и пустое доверие) - текстовый слой; Т1/Т2 - коммерческие псевдонимы раскрываются в представления
// (ПДн-псевдонимы не раскрываются никому). Номера не выдаются: см. ПсевдонимыВНомера.
//
// Параметры:
//  Значение - Произвольный - строка, массив, структура, соответствие.
//  Доверие - ПеречислениеСсылка.ИИА_УровниДоверия
//  Кэш - Структура, Неопределено - см. НовыйКэш.
//
// Возвращаемое значение:
//  Произвольный - копия.
//
Функция ДляДоверия(Значение, Доверие, Кэш = Неопределено) Экспорт

	Если Кэш = Неопределено Тогда
		Кэш = НовыйКэш();
	КонецЕсли;
	Если ЭтоДовериеТ3(Доверие) Тогда
		Если НастройкиМаскирования().Строки.Количество() = 0 Тогда
			Возврат Значение;
		КонецЕсли;
		Слоты = Новый Массив;
		Копия = СобратьСтрокиЗначения(Значение, Слоты);
		Если Не ЗамаскироватьСлоты(Слоты, Кэш).Успех Тогда
			// Лимит кандидатов: безопасный отказ - строки не выдаются.
			Для Каждого Слот Из Слоты Цикл
				УстановитьСлот(Слот, ИИА_Периметр.ЗаглушкаСкрыто());
			КонецЦикла;
		КонецЕсли;
		// Строка верхнего уровня лежит в массиве-держателе СобратьСтрокиЗначения.
		Возврат ?(ТипЗнч(Значение) = Тип("Строка"), Копия[0], Копия);
	КонецЕсли;

	Псевдонимы = Новый Соответствие;
	Порядок = Новый Массив;
	СобратьПсевдонимы(Значение, Псевдонимы, Порядок);
	Отображения = Новый Соответствие;
	Представления = РаскрытыеПредставления(Порядок, Кэш);
	Для Каждого Псевдоним Из Порядок Цикл
		Представление = Представления.Получить(Псевдоним);
		Если Не ПустаяСтрока(Представление) Тогда
			Отображения.Вставить(Псевдоним, Представление);
		КонецЕсли;
	КонецЦикла;
	Возврат ЗаменитьПсевдонимыВЗначении(Значение, Отображения);

КонецФункции

// Кэш маскирования хода: карта номеров диалога, результаты текстового слоя, значения псевдонимов, буфер
// регистрации пар. Входит в кэш проверок хода (ИИА_LLM.НовыйКэшПроверок) и пересоздаётся после паузы.
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги, Неопределено - чужой диалог не используется (номера - в памяти хода).
//  Канал - Строка - "chat" или "http".
//
// Возвращаемое значение:
//  Структура
//
Функция НовыйКэш(Диалог = Неопределено, Канал = "chat") Экспорт

	Кэш = Новый Структура;
	Кэш.Вставить("Диалог", ДиалогТекущегоПользователя(Диалог));
	Кэш.Вставить("Канал", ?(ПустаяСтрока(Канал), "chat", Канал));
	Кэш.Вставить("НомераЗагружены", Ложь);
	Кэш.Вставить("Номера", Новый Соответствие); // псевдоним в нижнем регистре -> номер
	Кэш.Вставить("ПоНомеру", Новый Соответствие); // номер -> канонический псевдоним
	Кэш.Вставить("Тексты", Новый Соответствие); // исходная строка -> строка после текстового слоя
	Кэш.Вставить("Кандидаты", Новый Соответствие); // КлючТекста(кандидат) -> Массив ссылок
	Кэш.Вставить("Варианты", Новый Соответствие); // КлючТекста(вариант) -> Массив ссылок
	Кэш.Вставить("Значения", Новый Соответствие); // канонический псевдоним -> Структура (Значение, Представление)
	Кэш.Вставить("Регистрация", Новый Соответствие); // новые пары псевдоним -> значение
	Кэш.Вставить("Запросов", 0); // число запросов текстового слоя к справочникам
	Кэш.Вставить("Проверенные", Новый Соответствие); // строка -> Соответствие псевдонимов, проверенных контролем
	Возврат Кэш;

КонецФункции

// Рекурсивно переводит номера объектов диалога в хэш-псевдонимы: «Контрагент №5», «менеджер 2», «у клиента (5)»,
// «№5», «ООО Ромашка (5)»; строка целиком из одного номера («5», «№5») - только когда Значение - сама строка
// сообщения (ответ на уточняющий вопрос). Вид в тексте только подтверждает объект номера: номер, которого нет
// в карте, несовместимый вид и количество («3 заказа», «5 шт») текст не меняют. Для вопроса пользователя и истории.
//
// Параметры:
//  Значение - Произвольный - строка, массив, структура, соответствие.
//  Кэш - Структура - см. НовыйКэш.
//
// Возвращаемое значение:
//  Произвольный - копия.
//
Функция НомераВПсевдонимы(Значение, Кэш) Экспорт

	Если Кэш = Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат ТекстБезНомеров(Значение, Кэш, Истина);
	ИначеЕсли ЭтоКоллекция(Значение) Тогда
		ЗагрузитьНомера(Кэш);
		Если Кэш.ПоНомеру.Количество() = 0 Тогда
			Возврат Значение;
		КонецЕсли;
		Слоты = Новый Массив;
		Копия = СобратьСтрокиЗначения(Значение, Слоты);
		Для Каждого Слот Из Слоты Цикл
			УстановитьСлот(Слот, ТекстБезНомеров(Слот.Значение, Кэш));
		КонецЦикла;
		Возврат Копия;
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Рекурсивно переводит хэш-псевдонимы в номера диалога: «Вид №N»; для Т1/Т2 раскрытый коммерческий объект -
// «представление (N)». Новые псевдонимы получают номера (выдача под блокировкой диалога). Последний шаг подготовки
// тела запроса.
//
// Параметры:
//  Значение - Произвольный
//  Кэш - Структура - см. НовыйКэш.
//  Доверие - ПеречислениеСсылка.ИИА_УровниДоверия, Неопределено - уровень модели; пусто - Т3.
//
// Возвращаемое значение:
//  Произвольный - копия.
//
Функция ПсевдонимыВНомера(Значение, Кэш, Доверие = Неопределено) Экспорт

	Псевдонимы = Новый Соответствие;
	Порядок = Новый Массив;
	СобратьПсевдонимы(Значение, Псевдонимы, Порядок);
	Если Порядок.Количество() = 0 Тогда
		Возврат Значение;
	КонецЕсли;
	ВыдатьНомера(Кэш, Порядок);
	Возврат ЗаменитьПсевдонимыВЗначении(Значение, ОтображенияДляМодели(Порядок, Кэш, Доверие));

КонецФункции

// Раскрывает псевдонимы для показа пользователю (ответ, история, таблицы, шаги, журнал, файлы).
// Ссылка раскрывается, только если пользователь может её прочитать (запрос РАЗРЕШЕННЫЕ); иначе остаётся псевдоним
// или «Вид №N». С диалогом и СНомерами к представлению добавляется номер диалога: «ООО Ромашка (5)».
//
// Параметры:
//  Значение - Произвольный - строка, массив, структура, соответствие.
//  Диалог - СправочникСсылка.ИИА_Диалоги, Неопределено - диалог текущего пользователя.
//  СНомерами - Булево - Ложь для графиков, Excel, файлов и журнала.
//
// Возвращаемое значение:
//  Произвольный - копия.
//
Функция ДляПользователя(Значение, Диалог = Неопределено, СНомерами = Истина) Экспорт

	Псевдонимы = Новый Соответствие;
	Порядок = Новый Массив;
	СобратьПсевдонимы(Значение, Псевдонимы, Порядок);
	Если Порядок.Количество() = 0 Тогда
		Возврат Значение;
	КонецЕсли;

	Номера = Новый Соответствие;
	Если СНомерами И ЗначениеЗаполнено(Диалог) Тогда
		Кэш = НовыйКэш(Диалог);
		ЗагрузитьНомера(Кэш);
		Номера = Кэш.Номера;
	КонецЕсли;

	Исходные = ИсходныеЗначенияПсевдонимов(Порядок, Неопределено);
	Ссылки = Новый Массив;
	Для Каждого Элемент Из Исходные Цикл
		Если Элемент.Значение.Значение <> Неопределено И ЭтоСсылка(Элемент.Значение.Значение) Тогда
			Ссылки.Добавить(Элемент.Значение.Значение);
		КонецЕсли;
	КонецЦикла;
	Представления = ПредставленияСсылок(Ссылки, Истина);

	Отображения = Новый Соответствие;
	Для Каждого Псевдоним Из Порядок Цикл
		Исходное = Исходные.Получить(Псевдоним);
		Представление = "";
		Если Исходное <> Неопределено Тогда
			Если ЭтоСсылка(Исходное.Значение) Тогда
				Представление = Представления.Получить(Исходное.Значение);
			Иначе
				Представление = Исходное.Представление;
			КонецЕсли;
		КонецЕсли;
		Номер = Номера.Получить(НРег(Псевдоним));
		Если Не ПустаяСтрока(Представление) Тогда
			Отображения.Вставить(Псевдоним, Представление
				+ ?(Номер = Неопределено, "", " (" + Формат(Номер, "ЧГ=") + ")"));
		ИначеЕсли Номер <> Неопределено Тогда
			Отображения.Вставить(Псевдоним, ВидПсевдонима(Псевдоним) + " №" + Формат(Номер, "ЧГ="));
		КонецЕсли;
	КонецЦикла;
	Возврат ЗаменитьПсевдонимыВЗначении(Значение, Отображения);

КонецФункции

// Готовит сообщения хода к отправке модели заданного уровня доверия (вызывается для каждого подключения цепочки).
//  - Т3: рассуждения, написанные не Т3 (метка КлючДовериеАвтора), удаляются; если список маскирования не пуст -
//    текстовый слой и контрольная проверка по всем строкам, кроме системных сообщений и результатов инструментов
//    кода и метаданных;
//  - Т1/Т2: коммерческие псевдонимы раскрываются;
//  - всем: хэш-псевдонимы -> номера диалога. Оставшиеся блоки рассуждений не меняются (подпись провайдера).
//
// Параметры:
//  Сообщения - Массив из Соответствие - сообщения OpenAI после очистки ПДн.
//  Доверие - ПеречислениеСсылка.ИИА_УровниДоверия
//  Кэш - Структура, Неопределено - см. НовыйКэш.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * Сообщения - Массив из Соответствие - копия для тела запроса.
//   * КодОшибки - Строка - COMMERCIAL_MASK_LIMIT.
//   * Ошибка - Строка - без значений данных.
//   * Замаскировано - Число - замен текстового слоя (commercial_masked).
//   * ВЗапросе - Число - находок контрольной проверки (commercial_in_request).
//   * РассужденияУдалены - Булево - удалены рассуждения другой модели: провайдеру с обязательными рассуждениями
//       продолжения (Anthropic) их нужно выключить для этого запроса.
//
Функция СообщенияДляДоверия(Сообщения, Доверие, Кэш = Неопределено) Экспорт

	Результат = Новый Структура("Успех, Сообщения, КодОшибки, Ошибка, Замаскировано, ВЗапросе, РассужденияУдалены",
		Истина, Неопределено, "", "", 0, 0, Ложь);
	Если Кэш = Неопределено Тогда
		Кэш = НовыйКэш();
	КонецЕсли;
	Копия = КопияКоллекции(Сообщения);
	ЭтоТ3 = ЭтоДовериеТ3(Доверие);
	Если ЭтоТ3 Тогда
		Результат.РассужденияУдалены = УдалитьЧужиеРассуждения(Копия);
	КонецЕсли;
	Разбор = СлотыСообщений(Копия);

	// Для Т3 условие - только непустой список: кэш ДействуетКоммерческоеМаскирование на сеанс может устареть.
	Если ЭтоТ3 И НастройкиМаскирования().Строки.Количество() > 0 Тогда
		СлотыМаскирования = СлотыТекстовогоСлоя(Разбор.Слоты);
		Маскирование = ЗамаскироватьСлоты(СлотыМаскирования, Кэш);
		Если Не Маскирование.Успех Тогда
			Результат.Успех = Ложь;
			Результат.КодОшибки = Маскирование.КодОшибки;
			Результат.Ошибка = ТекстОшибкиЛимита();
			Возврат Результат;
		КонецЕсли;
		Результат.Замаскировано = Маскирование.Замен;
		Результат.ВЗапросе = КонтрольнаяПроверкаСлотов(СлотыМаскирования, Кэш);
	КонецЕсли;

	// Номера диалога: в порядке первого появления в теле запроса.
	Псевдонимы = Новый Соответствие;
	Порядок = Новый Массив;
	Для Каждого Слот Из Разбор.Слоты Цикл
		СобратьПсевдонимы(Слот.Значение, Псевдонимы, Порядок);
	КонецЦикла;
	Если Порядок.Количество() > 0 Тогда
		ВыдатьНомера(Кэш, Порядок);
		Отображения = ОтображенияДляМодели(Порядок, Кэш, Доверие);
		ОтображенияJSON = Новый Соответствие;
		Для Каждого Элемент Из Отображения Цикл
			ОтображенияJSON.Вставить(Элемент.Ключ, ЭкранироватьДляJSON(Элемент.Значение));
		КонецЦикла;
		Для Каждого Слот Из Разбор.Слоты Цикл
			// Содержимое результата инструмента - текст JSON в конверте: подставляемое значение экранируется.
			УстановитьСлот(Слот, ЗаменитьПсевдонимыВТексте(Слот.Значение,
				?(Слот.Роль = "tool", ОтображенияJSON, Отображения)));
		КонецЦикла;
	КонецЕсли;
	ЗавершитьРазборСообщений(Разбор);
	Результат.Сообщения = Копия;
	Возврат Результат;

КонецФункции

// Текстовый слой: заменяет в строках наименования объектов справочников списка маскирования псевдонимами
// (поиск вхождений без полного словаря: кандидаты -> варианты -> запрос РАЗРЕШЕННЫЕ по наименованию в правах
// пользователя) и 10-значные ИНН юрлиц - псевдонимами ИННЮЛ_. Контрагенты и партнёры - физлица и ИП получают
// Физлицо_. Не проверяет, действует ли маскирование: решает вызывающий код.
//
// Параметры:
//  Тексты - Массив из Строка
//  Кэш - Структура, Неопределено - см. НовыйКэш; повторные строки и кандидаты хода не сканируются и не запрашиваются.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево - Ложь при превышении лимита кандидатов (КодОшибки = COMMERCIAL_MASK_LIMIT).
//   * Тексты - Массив из Строка
//   * Замен - Число
//   * Кандидатов - Число - новых кандидатов в этом вызове.
//   * КодОшибки - Строка
//
Функция ЗамаскироватьТексты(Тексты, Кэш = Неопределено) Экспорт

	Если Кэш = Неопределено Тогда
		Кэш = НовыйКэш();
	КонецЕсли;
	Результат = Новый Структура("Успех, Тексты, Замен, Кандидатов, КодОшибки", Истина, Новый Массив, 0, 0, "");
	Настройки = НастройкиМаскирования();

	НовыеИндексы = Новый Массив;
	Разборы = Новый Соответствие; // индекс -> Массив кандидатов текста
	НовыеКандидаты = Новый Соответствие; // КлючТекста(кандидат) -> исходный текст кандидата
	Для Индекс = 0 По Тексты.ВГраница() Цикл
		Текст = Тексты[Индекс];
		Результат.Тексты.Добавить(Текст);
		Если ТипЗнч(Текст) <> Тип("Строка") Или СтрДлина(Текст) < 3 Тогда
			Продолжить;
		КонецЕсли;
		Готовый = Кэш.Тексты.Получить(Текст);
		Если Готовый <> Неопределено Тогда
			Результат.Тексты[Индекс] = Готовый;
			Продолжить;
		КонецЕсли;
		НовыеИндексы.Добавить(Индекс);
		Если Настройки.Строки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Кандидаты = КандидатыТекста(Текст);
		Разборы.Вставить(Индекс, Кандидаты);
		Для Каждого Кандидат Из Кандидаты Цикл
			Ключ = КлючТекста(Кандидат.Текст);
			Если Кэш.Кандидаты.Получить(Ключ) = Неопределено И НовыеКандидаты.Получить(Ключ) = Неопределено Тогда
				НовыеКандидаты.Вставить(Ключ, Кандидат.Текст);
			КонецЕсли;
		КонецЦикла;
		Если НовыеКандидаты.Количество() > ПределКандидатов() Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Результат.Кандидатов = НовыеКандидаты.Количество();
	Если Результат.Кандидатов > ПределКандидатов() Тогда
		Результат.Успех = Ложь;
		Результат.КодОшибки = "COMMERCIAL_MASK_LIMIT";
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
			СтрШаблон("COMMERCIAL_MASK_LIMIT: candidates=%1", Формат(Результат.Кандидатов, "ЧГ=")));
		Возврат Результат;
	КонецЕсли;

	НайтиКандидатов(НовыеКандидаты, Кэш);

	// Разметка физлиц среди найденных ссылок: им Физлицо_ (приоритет ПДн).
	НайденныеСсылки = Новый Массив;
	Для Каждого Индекс Из НовыеИндексы Цикл
		Кандидаты = Разборы.Получить(Индекс);
		Если Кандидаты = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Кандидат Из Кандидаты Цикл
			Для Каждого Ссылка Из Кэш.Кандидаты.Получить(КлючТекста(Кандидат.Текст)) Цикл
				НайденныеСсылки.Добавить(Ссылка);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Признаки = ?(НайденныеСсылки.Количество() = 0, Новый Соответствие, ОтметитьСсылки(НайденныеСсылки));

	Для Каждого Индекс Из НовыеИндексы Цикл
		Исходный = Тексты[Индекс];
		Замен = 0;
		Текст = ЗаменитьКандидатов(Исходный, Разборы.Получить(Индекс), Признаки, Кэш, Замен);
		Текст = ЗаменитьИННЮрлиц(Текст, Кэш, Замен);
		Кэш.Тексты.Вставить(Исходный, Текст);
		Результат.Тексты[Индекс] = Текст;
		Результат.Замен = Результат.Замен + Замен;
	КонецЦикла;
	ЗаписатьПсевдонимы(Кэш.Регистрация);
	Возврат Результат;

КонецФункции

// Контрольная проверка тела запроса к модели Т3: находит в строках текстового слоя (без системных сообщений и
// результатов инструментов кода) коммерческие псевдонимы, получает их исходные наименования, ИНН и строковые
// реквизиты из списка и заменяет найденные точные вхождения псевдонимом. Многословные значения и числа
// сравниваются без учёта регистра, однословные - с учётом регистра; однословные короче 6 символов, общие слова
// («Товары») и имена объектов метаданных не проверяются.
//
// Параметры:
//  Сообщения - Массив из Соответствие - меняется на месте.
//  Кэш - Структура, Неопределено - см. НовыйКэш; проверенные строки хода повторно не сканируются.
//
// Возвращаемое значение:
//  Число - заменённых вхождений (commercial_in_request).
//
Функция КонтрольнаяПроверка(Сообщения, Кэш = Неопределено) Экспорт

	Если Кэш = Неопределено Тогда
		Кэш = НовыйКэш();
	КонецЕсли;
	Разбор = СлотыСообщений(Сообщения);
	Найдено = КонтрольнаяПроверкаСлотов(СлотыТекстовогоСлоя(Разбор.Слоты), Кэш);
	ЗавершитьРазборСообщений(Разбор);
	Возврат Найдено;

КонецФункции

// Переводит номера в ответе модели в хэш-псевдонимы: текст, аргументы вызовов и сообщение ассистента для истории хода.
//
// Параметры:
//  Ответ - Структура - см. ИИА_LLM.ВызватьМодель.
//  Кэш - Структура, Неопределено - см. НовыйКэш.
//
Процедура ПеревестиОтветМодели(Ответ, Кэш) Экспорт

	Если Кэш = Неопределено Или Не Ответ.Успех Тогда
		Возврат;
	КонецЕсли;
	ЗагрузитьНомера(Кэш);
	Если Кэш.ПоНомеру.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Ответ.Текст = ТекстБезНомеров(Ответ.Текст, Кэш);
	Для Каждого Вызов Из Ответ.ВызовыИнструментов Цикл
		Вызов.Аргументы = АргументыБезНомеров(Вызов.Аргументы, Кэш);
	КонецЦикла;
	Сообщение = Ответ.СообщениеАссистента;
	Если ТипЗнч(Сообщение) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;
	Содержимое = Сообщение.Получить("content");
	Если ТипЗнч(Содержимое) = Тип("Строка") Тогда
		Сообщение.Вставить("content", ТекстБезНомеров(Содержимое, Кэш));
	КонецЕсли;
	Вызовы = Сообщение.Получить("tool_calls");
	Если ТипЗнч(Вызовы) = Тип("Массив") Тогда
		Для Каждого Вызов Из Вызовы Цикл
			Функция_ = ?(ТипЗнч(Вызов) = Тип("Соответствие"), Вызов.Получить("function"), Неопределено);
			Если ТипЗнч(Функция_) = Тип("Соответствие") И ТипЗнч(Функция_.Получить("arguments")) = Тип("Строка") Тогда
				Функция_.Вставить("arguments", АргументыБезНомеров(Функция_.Получить("arguments"), Кэш));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Подсказка системного промпта о номерах объектов и коммерческом маскировании.
//
// Возвращаемое значение:
//  Строка
//
Функция ПодсказкаДляМодели() Экспорт

	Строки = Новый Массив;
	Строки.Добавить(НСтр("ru = 'Скрытые объекты (сотрудники, физлица, ФИО, ИНН и другие) приходят как «Вид №N», например «Пользователь №2», «Контрагент №5»; номер действует во всём диалоге. Всегда пиши вид и номер вместе, номер без вида не используй. «Пользователь» - это сотрудник или менеджер. В аргументах инструментов передавай объект так же («Контрагент №5»), в run_query - только параметром, не литералом в тексте запроса. Имена скрыты намеренно: не пытайся их узнать.'"));
	Если ДействуетКоммерческоеМаскирование() Тогда
		Виды = Новый Массив;
		Для Каждого Описание Из НастройкиМаскирования().Строки Цикл
			Виды.Добавить(Описание.Префикс);
		КонецЦикла;
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Наименования и реквизиты видов %1 (и ИНН организаций) скрыты от внешней модели намеренно. Выбирай, группируй и отбирай по самой ссылке: получишь «Вид №N» (модель в контуре видит «Название (N)» - ссылайся на объект так же или «Вид №N»). Поля наименования, ИНН, КПП, артикула этих видов в run_query запрещены (MASKED_FIELD); для поиска по имени есть find_records.'"),
			СтрСоединить(Виды, ", ")));
	КонецЕсли;
	Возврат СтрСоединить(Строки, " ");

КонецФункции

// Удаляет из настроек СКД выбранные поля, группировки и отборы по маскируемым реквизитам объектов списка
// («Номенклатура.Артикул», «Контрагент.ИНН»). Отборы выключаются.
//
// Параметры:
//  Компоновщик - КомпоновщикНастроекКомпоновкиДанных
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево - Ложь: настройки не удалось проверить, отчёт модели не отдаётся.
//   * Поля - Массив из Строка - удалённые поля (masked_fields).
//
Функция УдалитьМаскируемыеПоляНастроек(Компоновщик) Экспорт

	Результат = Новый Структура("Успех, Поля", Истина, Новый Массив);
	Если Не ДействуетКоммерческоеМаскирование() Тогда
		Возврат Результат;
	КонецЕсли;
	Попытка
		Настройки = Компоновщик.Настройки;
		ОбработатьЭлементыВыбора(Настройки.Выбор.Элементы, Настройки, Результат.Поля);
		ОбработатьЭлементыОтбора(Настройки.Отбор.Элементы, Настройки, Результат.Поля);
		ОбработатьСтруктуру(Настройки.Структура, Настройки, Результат.Поля);
		Для Каждого Элемент Из Компоновщик.ПользовательскиеНастройки.Элементы Цикл
			Если ТипЗнч(Элемент) = Тип("ОтборКомпоновкиДанных") Тогда
				ОбработатьЭлементыОтбора(Элемент.Элементы, Настройки, Результат.Поля);
			КонецЕсли;
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Результат.Успех = Ложь;
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Описание маскирования для инструмента data_access и формы «Доступ к данным».
//
// Возвращаемое значение:
//  Структура:
//   * active - Булево - действует для текущего пользователя.
//   * trust - Строка - для каких уровней доверия.
//   * objects - Массив из Структура - object, prefix, fields.
//   * note - Строка
//
Функция ОписаниеДляМодели() Экспорт

	Объекты = Новый Массив;
	Для Каждого Описание Из НастройкиМаскирования().Строки Цикл
		Объекты.Добавить(Новый Структура("object, prefix, fields", Описание.ПолноеИмя, Описание.Префикс,
			Описание.СписокПолей));
	КонецЦикла;
	Возврат Новый Структура("active, trust, objects, note", ДействуетКоммерческоеМаскирование(), "Т3",
		Объекты, НСтр("ru = 'Внешней модели (Т3) ссылки этих видов передаются псевдонимами, наименования в тексте заменяются псевдонимами, перечисленные реквизиты не выдаются. Модели Т1/Т2 видят наименования. Маскирование включается, если в цепочке моделей профиля пользователя есть модель Т3. Пользователь видит настоящие значения.'"));

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Действующие настройки маскирования (кэш сеанса).
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура - см. ПостроитьНастройки.
//
Функция НастройкиМаскирования() Экспорт

	Возврат ИИА_МаскированиеПовтИсп.Настройки();

КонецФункции

// Строит действующие настройки: строки регистра ИИА_МаскированиеОбъектов или снимка действующей версии политик
// (режим ИИА_ПолитикиЧерезВерсии). Без кэша, см. ИИА_МаскированиеПовтИсп.Настройки.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура:
//   * Строки - ФиксированныйМассив из ФиксированнаяСтруктура - ПолноеИмя, Префикс, Тип, Поля, СписокПолей,
//       ТекстовыеПоля (строковые реквизиты фиксированной длины из списка, кроме Наименование и ИНН: контрольная
//       проверка по ссылке), ПоляПоиска (из них индексированные: поиск текстового слоя по значению).
//   * ПоТипу - ФиксированноеСоответствие из КлючИЗначение - Тип -> Префикс.
//   * ПоПрефиксу - ФиксированноеСоответствие из КлючИЗначение - ВРег(префикс) -> ФиксированнаяСтруктура:
//       Префикс, Вид, Коммерческий, ПолноеИмя.
//   * Поля - ФиксированноеСоответствие из КлючИЗначение - ВРег(полное имя) -> ФиксированноеСоответствие ВРег(поле) -> Истина.
//   * Шаблон - Строка - регулярное выражение всех псевдонимов.
//   * Ключ - Строка - хеш состава настроек.
//
Функция ПостроитьНастройки() Экспорт

	Строки = Новый Массив;
	ПоТипу = Новый Соответствие;
	ПоПрефиксу = Новый Соответствие;
	Поля = Новый Соответствие;
	ДляКлюча = Новый Массив;
	Префиксы = Новый Массив;

	Для Каждого Префикс Из ПрефиксыПДн() Цикл
		ПоПрефиксу.Вставить(ВРег(Префикс), Новый ФиксированнаяСтруктура("Префикс, Вид, Коммерческий, ПолноеИмя",
			Префикс, Префикс, Ложь, ""));
	КонецЦикла;
	ПоПрефиксу.Вставить(ВРег(ПрефиксИННЮЛ()), Новый ФиксированнаяСтруктура("Префикс, Вид, Коммерческий, ПолноеИмя",
		ПрефиксИННЮЛ(), НСтр("ru = 'ИНН организации'"), Истина, ""));

	УстановитьПривилегированныйРежим(Истина);
	Периметр = ИИА_Периметр.ОписаниеПериметра();
	Для Каждого Строка Из ИсходныеСтрокиНастроек() Цикл
		Если Не Строка.Используется Или Не ПрефиксКорректен(Строка.Префикс)
			Или ПоПрефиксу.Получить(ВРег(Строка.Префикс)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОбъектМетаданных = СправочникСНаименованием(Строка.ПолноеИмя);
		Если ОбъектМетаданных = Неопределено
			Или Периметр.ЗапрещенныеОбъекты.Получить(ВРег(ОбъектМетаданных.ПолноеИмя())) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ТипСсылки = ТипЗнч(Справочники[ОбъектМетаданных.Имя].ПустаяСсылка());
		Если ПоТипу.Получить(ТипСсылки) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПоляОбъекта = Новый Соответствие;
		СписокПолей = Новый Массив;
		Для Каждого ИмяПоля Из СтрРазделить(Строка.Поля, ",", Ложь) Цикл
			ИмяПоля = СокрЛП(ИмяПоля);
			Если ЕстьПолеСправочника(ОбъектМетаданных, ИмяПоля) И ПоляОбъекта.Получить(ВРег(ИмяПоля)) = Неопределено Тогда
				ПоляОбъекта.Вставить(ВРег(ИмяПоля), Истина);
				СписокПолей.Добавить(ИмяПоля);
			КонецЕсли;
		КонецЦикла;
		Если ПоляОбъекта.Получить("НАИМЕНОВАНИЕ") <> Неопределено Тогда
			ПоляОбъекта.Вставить("ПРЕДСТАВЛЕНИЕ", Истина);
		КонецЕсли;
		ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
		Описание = Новый ФиксированнаяСтруктура("ПолноеИмя, Префикс, Тип, Поля, СписокПолей, ТекстовыеПоля, ПоляПоиска",
			ПолноеИмя, Строка.Префикс, ТипСсылки, Новый ФиксированноеСоответствие(ПоляОбъекта),
			Новый ФиксированныйМассив(СписокПолей), Новый ФиксированныйМассив(ТекстовыеПоля(ОбъектМетаданных, СписокПолей)),
			Новый ФиксированныйМассив(ТекстовыеПоля(ОбъектМетаданных, СписокПолей, Истина)));
		Строки.Добавить(Описание);
		ПоТипу.Вставить(ТипСсылки, Строка.Префикс);
		ПоПрефиксу.Вставить(ВРег(Строка.Префикс), Новый ФиксированнаяСтруктура("Префикс, Вид, Коммерческий, ПолноеИмя",
			Строка.Префикс, Строка.Префикс, Истина, ПолноеИмя));
		Поля.Вставить(ВРег(ПолноеИмя), Описание.Поля);
		Префиксы.Добавить(Строка.Префикс);
		ДляКлюча.Добавить(ПолноеИмя + "=" + Строка.Префикс + ":" + СтрСоединить(СписокПолей, ","));
	КонецЦикла;

	// Длинные префиксы раньше коротких: альтернатива регулярного выражения берётся первая подходящая.
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Префикс");
	Таблица.Колонки.Добавить("Длина");
	Для Каждого Префикс Из Префиксы Цикл
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Префикс = Префикс;
		НоваяСтрока.Длина = СтрДлина(Префикс);
	КонецЦикла;
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Префикс = ПрефиксИННЮЛ();
	НоваяСтрока.Длина = СтрДлина(ПрефиксИННЮЛ());
	Таблица.Сортировать("Длина Убыв");
	Шаблон = "(" + СтрСоединить(ПрефиксыПДн(), "|") + ")_[0-9a-fA-F]{10}|("
		+ СтрСоединить(Таблица.ВыгрузитьКолонку("Префикс"), "|") + ")_[0-9a-fA-F]{16}";

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(СтрСоединить(ДляКлюча, ";"));
	Ключ = НРег(Лев(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма), 16));

	Возврат Новый ФиксированнаяСтруктура("Строки, ПоТипу, ПоПрефиксу, Поля, Шаблон, Ключ",
		Новый ФиксированныйМассив(Строки), Новый ФиксированноеСоответствие(ПоТипу),
		Новый ФиксированноеСоответствие(ПоПрефиксу), Новый ФиксированноеСоответствие(Поля), Шаблон, Ключ);

КонецФункции

// Имена и синонимы объектов метаданных, реквизитов и табличных частей справочников и документов в нижнем
// регистре: однословное значение в кавычках после «поле», «колонка», «список», «табличная часть», совпадающее
// с ними, текстовый слой считает именем поля (см. ЗащищенныеДиапазоны). Контрольная проверка и замена в обычном
// тексте этот список не используют. Без кэша, см. ИИА_МаскированиеПовтИсп.ИменаМетаданных.
//
// Возвращаемое значение:
//  ФиксированноеСоответствие из КлючИЗначение - имя или синоним в нижнем регистре -> Истина.
//
Функция ПостроитьИменаМетаданных() Экспорт

	Имена = Новый Соответствие;
	Коллекции = СтрРазделить("Справочники,Документы,РегистрыСведений,РегистрыНакопления,РегистрыБухгалтерии,"
		+ "Перечисления,Отчеты,Обработки,ПланыВидовХарактеристик,ПланыСчетов,ЖурналыДокументов", ",");
	Для Каждого Коллекция Из Коллекции Цикл
		Для Каждого ОбъектМетаданных Из Метаданные[Коллекция] Цикл
			ДобавитьИмяМетаданных(Имена, ОбъектМетаданных);
			Если Коллекция <> "Справочники" И Коллекция <> "Документы" Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
				ДобавитьИмяМетаданных(Имена, Реквизит);
			КонецЦикла;
			Для Каждого ТабличнаяЧасть Из ОбъектМетаданных.ТабличныеЧасти Цикл
				ДобавитьИмяМетаданных(Имена, ТабличнаяЧасть);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Новый ФиксированноеСоответствие(Имена);

КонецФункции

// Вычисляет, действует ли коммерческое маскирование (без кэша), см. ДействуетКоммерческоеМаскирование.
//
// Параметры:
//  Канал - Строка - "chat" или "http".
//
// Возвращаемое значение:
//  Булево
//
Функция ВычислитьДействиеМаскирования(Канал) Экспорт

	Если НастройкиМаскирования().Строки.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Канал = "http" И ЭтоДовериеТ3(ДовериеВнешнегоКанала()) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ИИА_LLM.ЕстьПодключениеТ3ВЦепочке();

КонецФункции

// Канал текущего сеанса без кэша: сеанс HTTP-сервиса - "http"; фоновый сеанс - "chat" только по метке канала chat
// в наименовании задания (см. МеткаКаналаЗадания), иначе "http"; остальные сеансы - "chat".
//
// Возвращаемое значение:
//  Строка
//
Функция КаналСеанса() Экспорт

	// Фоновый сеанс без метки chat (задание не получено, метки нет, ошибка) считается http: безопасное направление.
	Фоновый = Ложь;
	Попытка
		Сеанс = ПолучитьТекущийСеансИнформационнойБазы();
		Если Сеанс.ИмяПриложения = "HTTPServiceConnection" Тогда
			Возврат "http";
		ИначеЕсли Сеанс.ИмяПриложения <> "BackgroundJob" Тогда
			Возврат "chat";
		КонецЕсли;
		Фоновый = Истина;
		Задание = Сеанс.ПолучитьФоновоеЗадание();
		Если Задание <> Неопределено И СтрЗаканчиваетсяНа(Задание.Наименование, МеткаКаналаЗадания("chat")) Тогда
			Возврат "chat";
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ?(Фоновый, "http", "chat");
	КонецПопытки;
	Возврат "http";

КонецФункции

// Метка канала в конце наименования фонового задания хода: фоновый сеанс так узнаёт канал сеанса, запустившего ход
// (единственное место передачи канала заданию, см. ИИА_ЧатВызовСервера.ЗапуститьЗаданиеХода).
//
// Параметры:
//  Канал - Строка - "chat" или "http".
//
// Возвращаемое значение:
//  Строка
//
Функция МеткаКаналаЗадания(Канал) Экспорт

	Возврат " [канал: " + Канал + "]";

КонецФункции

// Уровень доверия Т3: Т3 или пусто (подключение без уровня считается внешним облаком).
//
// Параметры:
//  Доверие - ПеречислениеСсылка.ИИА_УровниДоверия, Неопределено
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоДовериеТ3(Доверие) Экспорт

	Возврат Не ЗначениеЗаполнено(Доверие) Или Доверие = Перечисления.ИИА_УровниДоверия.Т3;

КонецФункции

// Служебное поле сообщения ассистента: уровень доверия модели-автора ("Т3" или "Т12"). Ставит ИИА_LLM.ВызватьМодель;
// в тело запроса провайдеру не попадает.
//
// Возвращаемое значение:
//  Строка
//
Функция КлючДовериеАвтора() Экспорт

	Возврат "iia_author_trust";

КонецФункции

// Маскируется ли ссылочный тип коммерческим псевдонимом (тип из списка и маскирование действует).
//
// Параметры:
//  ПроверяемыйТип - Тип
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоКоммерческийТип(ПроверяемыйТип) Экспорт

	Префикс = НастройкиМаскирования().ПоТипу.Получить(ПроверяемыйТип);
	Возврат Префикс <> Неопределено И ДействуетКоммерческоеМаскирование();

КонецФункции

// Коммерческий псевдоним ссылки: Префикс_ + 16 hex SHA-256 (соль + UUID); пара регистрируется.
//
// Параметры:
//  Ссылка - ЛюбаяСсылка - тип из списка маскирования.
//  Регистрация - Соответствие, Неопределено - буфер пар; Неопределено - запись сразу.
//
// Возвращаемое значение:
//  Строка - пустая для пустой ссылки.
//
Функция ПсевдонимДляМодели(Ссылка, Регистрация = Неопределено) Экспорт

	Префикс = НастройкиМаскирования().ПоТипу.Получить(ТипЗнч(Ссылка));
	Если Префикс = Неопределено Или Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	Псевдоним = Префикс + "_" + Хеш16(Строка(Ссылка.УникальныйИдентификатор()));
	ЗарегистрироватьПару(Псевдоним, Ссылка, Регистрация);
	Возврат Псевдоним;

КонецФункции

// Псевдоним ИНН юрлица: ИННЮЛ_ + 16 hex SHA-256 (соль + значение); пара регистрируется со строкой ИНН.
//
// Параметры:
//  ИНН - Строка - 10 цифр.
//  Регистрация - Соответствие, Неопределено
//
// Возвращаемое значение:
//  Строка
//
Функция ПсевдонимИННЮЛ(ИНН, Регистрация = Неопределено) Экспорт

	Псевдоним = ПрефиксИННЮЛ() + "_" + Хеш16(ИНН);
	ЗарегистрироватьПару(Псевдоним, ИНН, Регистрация);
	Возврат Псевдоним;

КонецФункции

// Пакетно записывает новые пары «псевдоним -> значение» в ИИА_ПсевдонимыОбъектов (привилегированно).
// Существующие пары не перезаписываются; занятый другим значением ключ пишется в журнал регистрации.
// Ошибка записи вне транзакции не прерывает ход: пользователь позже увидит псевдоним (безопасный отказ).
// В транзакции вызывающего ошибка не перехватывается: перехват внутри транзакции оставил бы её неработоспособной.
//
// Параметры:
//  Пары - Соответствие из КлючИЗначение - псевдоним -> значение; после записи очищается.
//
Процедура ЗаписатьПсевдонимы(Пары) Экспорт

	Если ТипЗнч(Пары) <> Тип("Соответствие") Или Пары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Если ТранзакцияАктивна() Тогда
		Новые = НовыеПары(Пары);
		Если Новые.Количество() > 0 Тогда
			НаборПсевдонимов(Новые).Записать(Ложь);
		КонецЕсли;
		Пары.Очистить();
		Возврат;
	КонецЕсли;
	Повтор = 0;
	Пока Повтор < 2 Цикл
		Повтор = Повтор + 1;
		Новые = НовыеПары(Пары);
		Если Новые.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		Набор = НаборПсевдонимов(Новые);
		Попытка
			Набор.Записать(Ложь);
			Прервать;
		Исключение
			// Конкурентная запись той же пары: повторяем один раз со свежей проверкой, затем пропускаем.
			ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
				"ALIAS_WRITE_RETRY: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	Пары.Очистить();

КонецПроцедуры

// Значение коммерческого псевдонима или ИННЮЛ_ из регистра (привилегированно, без учёта прав).
//
// Параметры:
//  Псевдоним - Строка - в любом регистре.
//
// Возвращаемое значение:
//  Структура, Неопределено - Ссылка (ЛюбаяСсылка или строка ИНН), Представление.
//
Функция ЗначениеПсевдонима(Псевдоним) Экспорт

	Канонический = КаноническийПсевдоним(Псевдоним);
	Если ПустаяСтрока(Канонический) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Список = Новый Массив;
	Список.Добавить(Канонический);
	Значение = ЗначенияИзРегистра(Список).Получить(Канонический);
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ЭтоСсылка(Значение) Тогда
		Ссылки = Новый Массив;
		Ссылки.Добавить(Значение);
		Представление = ПредставленияСсылок(Ссылки, Ложь).Получить(Значение);
		Возврат Новый Структура("Ссылка, Представление", Значение, ?(Представление = Неопределено, "", Представление));
	КонецЕсли;
	Возврат Новый Структура("Ссылка, Представление", Значение, Строка(Значение));

КонецФункции

// Коммерческий ли это псевдоним (префикс из списка или ИННЮЛ, 16 hex).
//
// Параметры:
//  Псевдоним - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоКоммерческийПсевдоним(Псевдоним) Экспорт

	Возврат Не ПустаяСтрока(КаноническийПсевдоним(Псевдоним));

КонецФункции

// Псевдонимы в тексте (ПДн и коммерческие) с границами слова.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Начало - Число
//   * Длина - Число
//   * Псевдоним - Строка - канонический: префикс как в настройках, hex в нижнем регистре.
//   * Коммерческий - Булево
//
Функция НайтиПсевдонимыВТексте(Текст) Экспорт

	Результат = Новый Массив;
	Если ТипЗнч(Текст) <> Тип("Строка") Или СтрНайти(Текст, "_") = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Настройки = НастройкиМаскирования();
	Попытка
		Совпадения = СтрНайтиВсеПоРегулярномуВыражению(Текст, Настройки.Шаблон);
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Результат;
	КонецПопытки;
	Для Каждого Совпадение Из Совпадения Цикл
		Начало = Совпадение.НачальнаяПозиция;
		Длина = Совпадение.Длина;
		Если Начало > 1 И ЭтоСимволСлова(Сред(Текст, Начало - 1, 1))
			Или ЭтоСимволСлова(Сред(Текст, Начало + Длина, 1)) Тогда
			Продолжить;
		КонецЕсли;
		Значение = Сред(Текст, Начало, Длина);
		Разделитель = СтрНайти(Значение, "_", НаправлениеПоиска.СКонца);
		Описание = Настройки.ПоПрефиксу.Получить(ВРег(Лев(Значение, Разделитель - 1)));
		Если Описание = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Новый Структура("Начало, Длина, Псевдоним, Коммерческий", Начало, Длина,
			Описание.Префикс + "_" + НРег(Сред(Значение, Разделитель + 1)), Описание.Коммерческий));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Есть ли в тексте псевдоним (для отказа PSEUDONYM_AS_LITERAL и запрета записи псевдонима как наименования).
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция ЕстьПсевдоним(Текст) Экспорт

	Возврат НайтиПсевдонимыВТексте(Текст).Количество() > 0;

КонецФункции

// Удаляет карту номеров диалога (вместе с диалогом и в регламентной очистке).
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги
//
Процедура УдалитьНомераДиалога(Диалог) Экспорт

	Если Не ЗначениеЗаполнено(Диалог) Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Набор = РегистрыСведений.ИИА_НомераОбъектовДиалога.СоздатьНаборЗаписей();
	Набор.Отбор.Диалог.Установить(Диалог);
	Набор.Записать();

КонецПроцедуры

#Область Настройки

// Строки настроек маскирования для формы «Доступ к данным»: действующие (снимок версии в режиме версий политик).
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * ПолноеИмя - Строка
//   * Представление - Строка - синоним справочника.
//   * Префикс - Строка
//   * Поля - Строка - имена через запятую.
//   * Используется - Булево
//   * Действует - Булево - строка применяется (справочник есть, префикс корректен).
//
Функция СтрокиНастроекДляФормы() Экспорт

	Таблица = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("ПолноеИмя,Представление,Префикс,Поля", ",") Цикл
		Таблица.Колонки.Добавить(Имя, Новый ОписаниеТипов("Строка"));
	КонецЦикла;
	Таблица.Колонки.Добавить("Используется", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Действует", Новый ОписаниеТипов("Булево"));
	Действующие = Новый Соответствие;
	Для Каждого Описание Из ИИА_Маскирование.ПостроитьНастройки().Строки Цикл
		Действующие.Вставить(ВРег(Описание.ПолноеИмя), Истина);
	КонецЦикла;
	Для Каждого Строка Из ИсходныеСтрокиНастроек() Цикл
		НоваяСтрока = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Строка.ПолноеИмя);
		НоваяСтрока.Представление = ?(ОбъектМетаданных = Неопределено, Строка.ПолноеИмя, ОбъектМетаданных.Представление());
		НоваяСтрока.Действует = Действующие.Получить(ВРег(Строка.ПолноеИмя)) <> Неопределено;
	КонецЦикла;
	Таблица.Сортировать("ПолноеИмя");
	Возврат Таблица;

КонецФункции

// Может ли текущий пользователь менять список маскирования: права как на классификацию данных и не включён режим
// версий политик (тогда правка только через черновик версии).
//
// Возвращаемое значение:
//  Булево
//
Функция МожноИзменятьНастройки() Экспорт

	Возврат ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ИИА_КлассификацияДанных)
		И Не ИИА_Политики.ПолитикиЧерезВерсии();

КонецФункции

// Проверяет строку настроек маскирования.
//
// Параметры:
//  ПолноеИмя - Строка
//  Префикс - Строка
//  Поля - Строка - имена реквизитов через запятую.
//  ПрежнееПолноеИмя - Строка - строка, которая редактируется (для проверки уникальности префикса).
//
// Возвращаемое значение:
//  Массив из Строка - тексты ошибок; пустой - строка корректна.
//
Функция ОшибкиНастройки(ПолноеИмя, Префикс, Поля, ПрежнееПолноеИмя = "") Экспорт

	Ошибки = Новый Массив;
	ОбъектМетаданных = СправочникСНаименованием(ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Тогда
		Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Справочник %1 не найден или у него нет наименования.'"), ПолноеИмя));
	Иначе
		УстановитьПривилегированныйРежим(Истина);
		Если ИИА_Периметр.ОписаниеПериметра().ЗапрещенныеОбъекты.Получить(ВРег(ОбъектМетаданных.ПолноеИмя())) <> Неопределено Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Справочник %1 закрыт периметром целиком: маскирование не нужно.'"), ПолноеИмя));
		КонецЕсли;
		Для Каждого ИмяПоля Из СтрРазделить(Поля, ",", Ложь) Цикл
			Если Не ЕстьПолеСправочника(ОбъектМетаданных, СокрЛП(ИмяПоля)) Тогда
				Ошибки.Добавить(СтрШаблон(НСтр("ru = 'У справочника %1 нет реквизита %2.'"), ПолноеИмя, СокрЛП(ИмяПоля)));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Не ПрефиксКорректен(Префикс) Тогда
		Ошибки.Добавить(НСтр("ru = 'Префикс - от 2 до 30 букв без пробелов, цифр и знаков.'"));
	КонецЕсли;
	Для Каждого Зарезервированный Из ЗарезервированныеПрефиксы() Цикл
		Если ВРег(Префикс) = ВРег(Зарезервированный) Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Префикс %1 зарезервирован для персональных данных и ИНН.'"), Префикс));
		КонецЕсли;
	КонецЦикла;
	Для Каждого Строка Из СтрокиРегистра() Цикл
		Если ВРег(Строка.Префикс) = ВРег(Префикс) И ВРег(Строка.ПолноеИмя) <> ВРег(ПолноеИмя)
			И ВРег(Строка.ПолноеИмя) <> ВРег(ПрежнееПолноеИмя) Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Префикс %1 уже используется для %2.'"), Префикс, Строка.ПолноеИмя));
		КонецЕсли;
	КонецЦикла;
	Возврат Ошибки;

КонецФункции

// Записывает строку настроек маскирования (форма «Доступ к данным»). Изменение пишется в журнал вызовов
// (событие «Политика»).
//
// Параметры:
//  ПолноеИмя - Строка
//  Префикс - Строка
//  Поля - Строка
//  Используется - Булево
//  ПрежнееПолноеИмя - Строка - при переименовании строки прежняя запись удаляется.
//
Процедура ЗаписатьНастройку(ПолноеИмя, Префикс, Поля, Используется, ПрежнееПолноеИмя = "") Экспорт

	ПроверитьПравоИзменения();
	ОбъектМетаданных = СправочникСНаименованием(ПолноеИмя);
	ИмяОбъекта = ?(ОбъектМетаданных = Неопределено, СокрЛП(ПолноеИмя), ОбъектМетаданных.ПолноеИмя());
	ИменаПолей = Новый Массив;
	Для Каждого ИмяПоля Из СтрРазделить(Поля, ",", Ложь) Цикл
		ИменаПолей.Добавить(СокрЛП(ИмяПоля));
	КонецЦикла;
	ПоляСтрокой = СтрСоединить(ИменаПолей, ",");
	Ошибки = ОшибкиНастройки(ИмяОбъекта, СокрЛП(Префикс), ПоляСтрокой, ПрежнееПолноеИмя);
	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Блокировка.Добавить("РегистрСведений.ИИА_МаскированиеОбъектов");
		Блокировка.Заблокировать();
		Если Не ПустаяСтрока(ПрежнееПолноеИмя) И ВРег(ПрежнееПолноеИмя) <> ВРег(ИмяОбъекта) Тогда
			Набор = РегистрыСведений.ИИА_МаскированиеОбъектов.СоздатьНаборЗаписей();
			Набор.Отбор.ПолноеИмя.Установить(ПрежнееПолноеИмя);
			Набор.Записать();
		КонецЕсли;
		Запись = РегистрыСведений.ИИА_МаскированиеОбъектов.СоздатьМенеджерЗаписи();
		Запись.ПолноеИмя = ИмяОбъекта;
		Запись.Префикс = СокрЛП(Префикс);
		Запись.Поля = ПоляСтрокой;
		Запись.Используется = Используется;
		Запись.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	ИИА_Политики.ЗаписатьЖурналНастройки("Маскирование", СтрШаблон("%1: %2_; %3; %4", ИмяОбъекта, СокрЛП(Префикс),
		ПоляСтрокой, ?(Используется, "used", "not used")));
	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// Удаляет строку настроек маскирования (ослабление; пишется в журнал вызовов).
//
// Параметры:
//  ПолноеИмя - Строка
//
Процедура УдалитьНастройку(ПолноеИмя) Экспорт

	ПроверитьПравоИзменения();
	УстановитьПривилегированныйРежим(Истина);
	Набор = РегистрыСведений.ИИА_МаскированиеОбъектов.СоздатьНаборЗаписей();
	Набор.Отбор.ПолноеИмя.Установить(ПолноеИмя);
	Набор.Записать();
	ИИА_Политики.ЗаписатьЖурналНастройки("Маскирование", СтрШаблон("%1: deleted", ПолноеИмя));
	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// Поставляемые строки по умолчанию: контрагенты, партнёры, организации, номенклатура - только для справочников,
// которые есть в конфигурации, и только в пустой список (правки и удаления администратора не возвращаются).
//
Процедура ЗаполнитьНастройкиПоУмолчанию() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Если СтрокиРегистра().Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Описание Из НастройкиПоУмолчанию() Цикл
		ОбъектМетаданных = СправочникСНаименованием(Описание.ПолноеИмя);
		Если ОбъектМетаданных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ИменаПолей = Новый Массив;
		Для Каждого ИмяПоля Из СтрРазделить(Описание.Поля, ",", Ложь) Цикл
			Если ЕстьПолеСправочника(ОбъектМетаданных, ИмяПоля) Тогда
				ИменаПолей.Добавить(ИмяПоля);
			КонецЕсли;
		КонецЦикла;
		Запись = РегистрыСведений.ИИА_МаскированиеОбъектов.СоздатьМенеджерЗаписи();
		Запись.ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
		Запись.Префикс = Описание.Префикс;
		Запись.Поля = СтрСоединить(ИменаПолей, ",");
		Запись.Используется = Истина;
		Запись.Записать();
	КонецЦикла;

КонецПроцедуры

// Снимок живых настроек для версии политик (ключ commercial_masking).
//
// Возвращаемое значение:
//  Массив из Соответствие - object, prefix, fields (Массив из Строка), used.
//
Функция СнимокНастроек() Экспорт

	Результат = Новый Массив;
	Для Каждого Строка Из СтрокиРегистра() Цикл
		Элемент = Новый Соответствие;
		Элемент.Вставить("object", Строка.ПолноеИмя);
		Элемент.Вставить("prefix", Строка.Префикс);
		Элемент.Вставить("fields", СтрРазделить(Строка.Поля, ",", Ложь));
		Элемент.Вставить("used", Строка.Используется);
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Сравнивает списки маскирования двух снимков: удаление строки или реквизита, снятие «Используется» и смена
// префикса (прежние псевдонимы и номера в истории перестают раскрываться) - ослабление, добавление - усиление.
//
// Параметры:
//  Старые - Массив, Неопределено - commercial_masking действующей версии (нет ключа - маскирования не было).
//  Новые - Массив, Неопределено - commercial_masking проверяемой версии.
//
// Возвращаемое значение:
//  Массив из Структура - Вид ("Ослабление", "Усиление", "Нейтральное"), Описание.
//
Функция ИзмененияНастроек(Старые, Новые) Экспорт

	Изменения = Новый Массив;
	Если ТипЗнч(Новые) <> Тип("Массив") Тогда
		Возврат Изменения;
	КонецЕсли;
	СтарыеСтроки = Новый Соответствие;
	Для Каждого Строка Из СтрокиИзСнимка(?(ТипЗнч(Старые) = Тип("Массив"), Старые, Новый Массив)) Цикл
		СтарыеСтроки.Вставить(ВРег(Строка.ПолноеИмя), Строка);
	КонецЦикла;
	НовыеСтроки = Новый Соответствие;
	Для Каждого Новая Из СтрокиИзСнимка(Новые) Цикл
		НовыеСтроки.Вставить(ВРег(Новая.ПолноеИмя), Новая);
		Старая = СтарыеСтроки.Получить(ВРег(Новая.ПолноеИмя));
		Если Старая = Неопределено Тогда
			Если Новая.Используется Тогда
				ДобавитьИзменение(Изменения, "Усиление", СтрШаблон(НСтр("ru = 'Маскирование: добавлен %1 (%2)'"),
					Новая.ПолноеИмя, Новая.Поля));
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если Старая.Используется И Не Новая.Используется Тогда
			ДобавитьИзменение(Изменения, "Ослабление", СтрШаблон(НСтр("ru = 'Маскирование: %1 выключен'"), Новая.ПолноеИмя));
			Продолжить;
		ИначеЕсли Не Старая.Используется И Новая.Используется Тогда
			ДобавитьИзменение(Изменения, "Усиление", СтрШаблон(НСтр("ru = 'Маскирование: %1 включён (%2)'"),
				Новая.ПолноеИмя, Новая.Поля));
			Продолжить;
		ИначеЕсли Не Новая.Используется Тогда
			Продолжить;
		КонецЕсли;
		Если ВРег(Старая.Префикс) <> ВРег(Новая.Префикс) Тогда
			ДобавитьИзменение(Изменения, "Ослабление", СтрШаблон(НСтр("ru = 'Маскирование: префикс %1 изменён на %2 - прежние псевдонимы в истории диалогов перестанут раскрываться'"),
				Новая.ПолноеИмя, Новая.Префикс));
		КонецЕсли;
		СтарыеПоля = ВРег("," + СтрЗаменить(Старая.Поля, " ", "") + ",");
		НовыеПоля = ВРег("," + СтрЗаменить(Новая.Поля, " ", "") + ",");
		Для Каждого Поле Из СтрРазделить(Старая.Поля, ",", Ложь) Цикл
			Если СтрНайти(НовыеПоля, ВРег("," + СокрЛП(Поле) + ",")) = 0 Тогда
				ДобавитьИзменение(Изменения, "Ослабление", СтрШаблон(НСтр("ru = 'Маскирование: %1.%2 открыт'"),
					Новая.ПолноеИмя, СокрЛП(Поле)));
			КонецЕсли;
		КонецЦикла;
		Для Каждого Поле Из СтрРазделить(Новая.Поля, ",", Ложь) Цикл
			Если СтрНайти(СтарыеПоля, ВРег("," + СокрЛП(Поле) + ",")) = 0 Тогда
				ДобавитьИзменение(Изменения, "Усиление", СтрШаблон(НСтр("ru = 'Маскирование: %1.%2 скрыт'"),
					Новая.ПолноеИмя, СокрЛП(Поле)));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Для Каждого Элемент Из СтарыеСтроки Цикл
		Если НовыеСтроки.Получить(Элемент.Ключ) = Неопределено И Элемент.Значение.Используется Тогда
			ДобавитьИзменение(Изменения, "Ослабление", СтрШаблон(НСтр("ru = 'Маскирование: строка %1 удалена'"),
				Элемент.Значение.ПолноеИмя));
		КонецЕсли;
	КонецЦикла;
	Возврат Изменения;

КонецФункции

