#КонецОбласти

#Область НомераДиалога

Функция ДиалогТекущегоПользователя(Диалог)

	Если Не ЗначениеЗаполнено(Диалог) Или ТипЗнч(Диалог) <> Тип("СправочникСсылка.ИИА_Диалоги") Тогда
		Возврат Неопределено;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Диалог, "Пользователь") <> Пользователи.ТекущийПользователь() Тогда
		Возврат Неопределено; // карта чужого диалога не используется
	КонецЕсли;
	Возврат Диалог;

КонецФункции

Процедура ЗагрузитьНомера(Кэш)

	Если Кэш.НомераЗагружены Тогда
		Возврат;
	КонецЕсли;
	Кэш.НомераЗагружены = Истина;
	Если Не ЗначениеЗаполнено(Кэш.Диалог) Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Н.НомерОбъекта КАК НомерОбъекта,
	|	Н.Псевдоним КАК Псевдоним
	|ИЗ
	|	РегистрСведений.ИИА_НомераОбъектовДиалога КАК Н
	|ГДЕ
	|	Н.Диалог = &Диалог");
	Запрос.УстановитьПараметр("Диалог", Кэш.Диалог);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗапомнитьНомер(Кэш, Выборка.НомерОбъекта, СокрЛП(Выборка.Псевдоним));
	КонецЦикла;

КонецПроцедуры

Процедура ЗапомнитьНомер(Кэш, Номер, Псевдоним)

	Кэш.Номера.Вставить(НРег(Псевдоним), Номер);
	Кэш.ПоНомеру.Вставить(Номер, Псевдоним);

КонецПроцедуры

Функция МаксимальныйНомер(Кэш)

	Максимум = 0;
	Для Каждого Элемент Из Кэш.ПоНомеру Цикл
		Максимум = Макс(Максимум, Элемент.Ключ);
	КонецЦикла;
	Возврат Максимум;

КонецФункции

// Выдаёт номера новым псевдонимам: следующий номер = максимум + 1, пакетом за одну отправку, отдельной короткой
// транзакцией под блокировкой диалога. Без диалога (HTTP) - в памяти хода. При сбое записи номер не выдаётся:
// модель увидит хэш-псевдоним (безопасный отказ).
Процедура ВыдатьНомера(Кэш, Псевдонимы)

	ЗагрузитьНомера(Кэш);
	Новые = Новый Массив;
	Для Каждого Псевдоним Из Псевдонимы Цикл
		Если Кэш.Номера.Получить(НРег(Псевдоним)) = Неопределено Тогда
			Новые.Добавить(Псевдоним);
		КонецЕсли;
	КонецЦикла;
	Если Новые.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Кэш.Диалог) Тогда
		Максимум = МаксимальныйНомер(Кэш);
		Для Каждого Псевдоним Из Новые Цикл
			Максимум = Максимум + 1;
			ЗапомнитьНомер(Кэш, Максимум, Псевдоним);
		КонецЦикла;
		Возврат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Набор = ЗаписатьНомераДиалога(Кэш.Диалог, Новые);
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
			"DIALOG_NUMBERS_NOT_ISSUED: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	Для Каждого Запись Из Набор Цикл
		ЗапомнитьНомер(Кэш, Запись.НомерОбъекта, СокрЛП(Запись.Псевдоним));
	КонецЦикла;

КонецПроцедуры

// Под блокировкой диалога дописывает номера новым псевдонимам; возвращает все записи диалога.
Функция ЗаписатьНомераДиалога(Диалог, Новые)

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ИИА_НомераОбъектовДиалога");
		ЭлементБлокировки.УстановитьЗначение("Диалог", Диалог);
		Блокировка.Заблокировать();
		Набор = РегистрыСведений.ИИА_НомераОбъектовДиалога.СоздатьНаборЗаписей();
		Набор.Отбор.Диалог.Установить(Диалог);
		Набор.Прочитать();
		Существующие = Новый Соответствие;
		Максимум = 0;
		Для Каждого Запись Из Набор Цикл
			Существующие.Вставить(НРег(СокрЛП(Запись.Псевдоним)), Запись.НомерОбъекта);
			Максимум = Макс(Максимум, Запись.НомерОбъекта);
		КонецЦикла;
		Добавлено = 0;
		Для Каждого Псевдоним Из Новые Цикл
			Если Существующие.Получить(НРег(Псевдоним)) <> Неопределено Тогда
				Продолжить; // номер выдал параллельный ход
			КонецЕсли;
			Максимум = Максимум + 1;
			Если Максимум > 999999 Тогда
				Прервать;
			КонецЕсли;
			Запись = Набор.Добавить();
			Запись.Диалог = Диалог;
			Запись.НомерОбъекта = Максимум;
			Запись.Псевдоним = Псевдоним;
			Существующие.Вставить(НРег(Псевдоним), Максимум);
			Добавлено = Добавлено + 1;
		КонецЦикла;
		Если Добавлено > 0 Тогда
			Набор.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Набор;

КонецФункции

Функция НаборПсевдонимов(Пары)

	Набор = РегистрыСведений.ИИА_ПсевдонимыОбъектов.СоздатьНаборЗаписей();
	Момент = ТекущаяУниверсальнаяДата();
	Для Каждого Пара Из Пары Цикл
		Запись = Набор.Добавить();
		Запись.Псевдоним = Пара.Ключ;
		Запись.Значение = Пара.Значение;
		Запись.Записан = Момент;
	КонецЦикла;
	Возврат Набор;

КонецФункции

// Отображения для тела запроса: «Вид №N»; для Т1/Т2 коммерческий объект - «представление (N)».
Функция ОтображенияДляМодели(Псевдонимы, Кэш, Доверие)

	Представления = ?(ЭтоДовериеТ3(Доверие), Новый Соответствие, РаскрытыеПредставления(Псевдонимы, Кэш));
	Отображения = Новый Соответствие;
	Для Каждого Псевдоним Из Псевдонимы Цикл
		Номер = Кэш.Номера.Получить(НРег(Псевдоним));
		Представление = Представления.Получить(Псевдоним);
		ТекстНомера = ?(Номер = Неопределено, "", Формат(Номер, "ЧГ="));
		Если Не ПустаяСтрока(Представление) Тогда
			Отображения.Вставить(Псевдоним, Представление + ?(Номер = Неопределено, "", " (" + ТекстНомера + ")"));
		ИначеЕсли Номер <> Неопределено Тогда
			Отображения.Вставить(Псевдоним, ВидПсевдонима(Псевдоним) + " №" + ТекстНомера);
		КонецЕсли;
	КонецЦикла;
	Возврат Отображения;

КонецФункции

Функция АргументыБезНомеров(АргументыJSON, Кэш)

	Если ТипЗнч(АргументыJSON) <> Тип("Строка") Или Не ЕстьЦифры(АргументыJSON) Тогда
		Возврат АргументыJSON;
	КонецЕсли;
	// Невалидный JSON: номера разбираются в строке аргументов целиком.
	Попытка
		Аргументы = ОбщегоНазначения.JSONВЗначение(АргументыJSON, , Истина);
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат ТекстБезНомеров(АргументыJSON, Кэш);
	КонецПопытки;
	Если Не ЭтоКоллекция(Аргументы) Тогда
		Возврат АргументыJSON;
	КонецЕсли;
	Слоты = Новый Массив;
	Копия = СобратьСтрокиЗначения(Аргументы, Слоты);
	Изменено = Ложь;
	Для Каждого Слот Из Слоты Цикл
		Новый_ = ТекстБезНомеров(Слот.Значение, Кэш);
		Если Новый_ <> Слот.Значение Тогда
			УстановитьСлот(Слот, Новый_);
			Изменено = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат ?(Изменено, ОбщегоНазначения.ЗначениеВJSON(Копия), АргументыJSON);

КонецФункции

// Разбор номеров в одной строке, см. НомераВПсевдонимы. ЦелоеСообщение - строка является сообщением пользователя:
// строка из одного номера («5», «№5») - ответ на уточняющий вопрос модели. Для значений JSON и ответа модели - Ложь.
Функция ТекстБезНомеров(Текст, Кэш, ЦелоеСообщение = Ложь)

	Если ТипЗнч(Текст) <> Тип("Строка") Или ПустаяСтрока(Текст) Или Не ЕстьЦифры(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	ЗагрузитьНомера(Кэш);
	Если Кэш.ПоНомеру.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	Целиком = СокрЛП(Текст);
	Если Лев(Целиком, 1) = "№" Или Лев(Целиком, 1) = "#" Тогда
		Целиком = СокрЛП(Сред(Целиком, 2));
	КонецЕсли;
	Если ЦелоеСообщение И ТолькоЦифры(Целиком) И СтрДлина(Целиком) <= 6 Тогда
		Псевдоним = Кэш.ПоНомеру.Получить(Число(Целиком));
		Если Псевдоним <> Неопределено Тогда
			Возврат Псевдоним;
		КонецЕсли;
	КонецЕсли;

	Длина = СтрДлина(Текст);
	Части = Новый Массив;
	ПозицияКопии = 1;
	Позиция = 1;
	Пока Позиция <= Длина Цикл
		Если Не ЭтоЦифра(Сред(Текст, Позиция, 1)) Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;
		НачалоЧисла = Позиция;
		Пока Позиция <= Длина И ЭтоЦифра(Сред(Текст, Позиция, 1)) Цикл
			Позиция = Позиция + 1;
		КонецЦикла;
		КонецЧисла = Позиция - 1;
		Замена = ЗаменаНомера(Текст, НачалоЧисла, КонецЧисла, ПозицияКопии, Кэш);
		Если Замена <> Неопределено Тогда
			Части.Добавить(Сред(Текст, ПозицияКопии, Замена.Начало - ПозицияКопии));
			Части.Добавить(Замена.Псевдоним);
			ПозицияКопии = Замена.Конец + 1;
			Позиция = ПозицияКопии;
		КонецЕсли;
	КонецЦикла;
	Если ПозицияКопии = 1 Тогда
		Возврат Текст;
	КонецЕсли;
	Части.Добавить(Сред(Текст, ПозицияКопии));
	Возврат СтрСоединить(Части);

КонецФункции

// Заменяемый фрагмент для числа в позициях НачалоЧисла..КонецЧисла или Неопределено.
// Возвращаемое значение: Структура (Начало, Конец, Псевдоним).
Функция ЗаменаНомера(Текст, НачалоЧисла, КонецЧисла, Граница, Кэш)

	Если КонецЧисла - НачалоЧисла + 1 > 6 Тогда
		Возврат Неопределено;
	КонецЕсли;
	До = ?(НачалоЧисла > 1, Сред(Текст, НачалоЧисла - 1, 1), "");
	После = Сред(Текст, КонецЧисла + 1, 1);
	// Часть слова, кода или дробного числа: «A5», «5_», «5.3», «5,25» - не номер.
	Если ЭтоСимволСлова(До) Или ЭтоСимволСлова(После)
		Или (После = "." Или После = ",") И ЭтоЦифра(Сред(Текст, КонецЧисла + 2, 1))
		Или (До = "." Или До = ",") И НачалоЧисла > 2 И ЭтоЦифра(Сред(Текст, НачалоЧисла - 2, 1)) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Номер = Число(Сред(Текст, НачалоЧисла, КонецЧисла - НачалоЧисла + 1));
	Псевдоним = Кэш.ПоНомеру.Получить(Номер);
	Если Псевдоним = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Префикс = ПрефиксПсевдонима(Псевдоним);

	ВСкобках = До = "(" И После = ")";
	Конец = ?(ВСкобках, КонецЧисла + 1, КонецЧисла);
	Курсор = НачалоЧисла - 1;
	ЗнакНомера = Ложь;
	НачалоЗнака = 0;
	Если ВСкобках Тогда
		Курсор = НачалоЧисла - 2;
	Иначе
		Если Курсор >= 1 И Сред(Текст, Курсор, 1) = " " Тогда
			Курсор = Курсор - 1;
		КонецЕсли;
		Если Курсор >= 1 И (Сред(Текст, Курсор, 1) = "№" Или Сред(Текст, Курсор, 1) = "#") Тогда
			ЗнакНомера = Истина;
			НачалоЗнака = Курсор;
			Курсор = Курсор - 1;
		ИначеЕсли Курсор < НачалоЧисла - 1 Тогда
			// Пробел без знака номера: «менеджер 2».
			Курсор = НачалоЧисла - 1;
		КонецЕсли;
	КонецЕсли;
	// «у клиента 3 заказа», «товар 5 шт», «5%»: без знака номера и скобок число с единицей - количество.
	Если Не ВСкобках И Не ЗнакНомера И ЗаЧисломЕдиница(Текст, КонецЧисла) Тогда
		Возврат Неопределено;
	КонецЕсли;
	КонецПробелов = Курсор;
	Пока Курсор >= Граница И Сред(Текст, Курсор, 1) = " " Цикл
		Курсор = Курсор - 1;
	КонецЦикла;
	ЕстьПробел = Курсор < КонецПробелов Или Не ВСкобках И Не ЗнакНомера;

	// 1. Слово вида перед номером: «менеджер 2», «у контрагента №5», «клиента (5)», «ИНН организации №6».
	Слово = "";
	НачалоСлова = 0;
	Если Курсор >= Граница И ЭтоБуква(Сред(Текст, Курсор, 1)) И (ЕстьПробел Или ЗнакНомера) Тогда
		КонецСлова = Курсор;
		Пока Курсор >= Граница И ЭтоБуква(Сред(Текст, Курсор, 1)) Цикл
			Курсор = Курсор - 1;
		КонецЦикла;
		НачалоСлова = Курсор + 1;
		Слово = Сред(Текст, НачалоСлова, КонецСлова - НачалоСлова + 1);
	КонецЕсли;
	Если Не ПустаяСтрока(Слово) Тогда
		ПредыдущееСлово = "";
		НачалоПредыдущего = 0;
		К = НачалоСлова - 1;
		Если К >= Граница И Сред(Текст, К, 1) = " " Тогда
			Пока К >= Граница И Сред(Текст, К, 1) = " " Цикл
				К = К - 1;
			КонецЦикла;
			КонецПредыдущего = К;
			Пока К >= Граница И ЭтоБуква(Сред(Текст, К, 1)) Цикл
				К = К - 1;
			КонецЦикла;
			Если К < КонецПредыдущего Тогда
				НачалоПредыдущего = К + 1;
				ПредыдущееСлово = Сред(Текст, НачалоПредыдущего, КонецПредыдущего - К);
			КонецЕсли;
		КонецЕсли;
		Виды = ВидыПоСловам(ПредыдущееСлово, Слово);
		Если Виды.Двусловный Тогда
			НачалоСлова = НачалоПредыдущего;
		КонецЕсли;
		Если Виды.Префиксы.Количество() > 0 Тогда
			Если Виды.Префиксы.Найти(ВРег(Префикс)) = Неопределено Тогда
				Возврат Неопределено; // вид несовместим с объектом номера
			КонецЕсли;
			Возврат Новый Структура("Начало, Конец, Псевдоним", НачалоСлова, Конец, Псевдоним);
		КонецЕсли;
	КонецЕсли;

	// 3. Скопированное «ООО Ромашка (5)», «Иванов И.И. (2)»: представление объекта номера перед скобкой.
	Если ВСкобках Тогда
		Представление = ПредставлениеДляНомера(Псевдоним, Кэш);
		Если СтрДлина(Представление) >= 2 Тогда
			Перед = Лев(Текст, НачалоЧисла - 2);
			ПередБезПробелов = СокрП(Перед);
			Если СтрДлина(ПередБезПробелов) - СтрДлина(Представление) + 1 >= Граница
				И СтрЗаканчиваетсяНа(НРег(ПередБезПробелов), НРег(Представление)) Тогда
				НачалоПредставления = СтрДлина(ПередБезПробелов) - СтрДлина(Представление) + 1;
				Если НачалоПредставления = 1 Или Не ЭтоСимволСлова(Сред(Текст, НачалоПредставления - 1, 1)) Тогда
					Возврат Новый Структура("Начало, Конец, Псевдоним", НачалоПредставления, Конец, Псевдоним);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;

	// 2. «№5», «#5» без существительного перед ним: начало фразы, предлог, знак препинания.
	Если ЗнакНомера И (ПустаяСтрока(Слово) Или Предлоги().Найти(НРег(Слово)) <> Неопределено) Тогда
		Возврат Новый Структура("Начало, Конец, Псевдоним", НачалоЗнака, Конец, Псевдоним);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Следует ли за числом единица счёта или счётное существительное: «шт», «%», «заказа», «месяцев», «руб».
Функция ЗаЧисломЕдиница(Текст, КонецЧисла)

	Длина = СтрДлина(Текст);
	Позиция = КонецЧисла + 1;
	Пока Позиция <= Длина И Сред(Текст, Позиция, 1) = " " Цикл
		Позиция = Позиция + 1;
	КонецЦикла;
	Если Сред(Текст, Позиция, 1) = "%" Тогда
		Возврат Истина;
	КонецЕсли;
	Начало = Позиция;
	Пока Позиция <= Длина И ЭтоБуква(Сред(Текст, Позиция, 1)) Цикл
		Позиция = Позиция + 1;
	КонецЦикла;
	Слово = НРег(Сред(Текст, Начало, Позиция - Начало));
	Если ПустаяСтрока(Слово) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрРазделить("р,г,т,л,м,кг,мес,ед,раз,раза,тыс,млн,млрд,шт", ",").Найти(Слово) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого Основа Из СтрРазделить("штук,заказ,месяц,недел,дней,дня,день,год,лет,час,минут,секунд,квартал,руб,процент,позици,строк,единиц,документ,товар,клиент,покупател,поставщик,сделк,счет,счёт,накладн,отгрузк,тонн,литр,метр", ",") Цикл
		Если СтрНачинаетсяС(Слово, Основа) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Совместимые виды по слову перед номером (и предыдущему слову для «ИНН организации», «физическое лицо»).
// Возвращаемое значение: Структура (Префиксы - Массив из Строка в верхнем регистре, Двусловный - Булево).
Функция ВидыПоСловам(ПредыдущееСлово, Слово)

	Результат = Новый Структура("Префиксы, Двусловный", Новый Массив, Ложь);
	Последнее = НРег(Слово);
	Первое = НРег(ПредыдущееСлово);
	Если Первое = "инн" И (СтрНачинаетсяС(Последнее, "организац") Или СтрНачинаетсяС(Последнее, "юрлиц")
		Или СтрНачинаетсяС(Последнее, "юр")) Тогда
		Результат.Префиксы.Добавить(ВРег(ПрефиксИННЮЛ()));
		Результат.Двусловный = Истина;
		Возврат Результат;
	КонецЕсли;
	Если СтрНачинаетсяС(Первое, "физическ") И СтрНачинаетсяС(Последнее, "лиц") Тогда
		Результат.Префиксы.Добавить("ФИЗЛИЦО");
		Результат.Двусловный = Истина;
		Возврат Результат;
	КонецЕсли;
	Для Каждого Элемент Из ТаблицаВидов() Цикл
		Основа = Элемент.Ключ;
		Подходит = ?(СтрДлина(Основа) <= 3, Последнее = Основа, СтрНачинаетсяС(Последнее, Основа));
		Если Не Подходит Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Префикс Из Элемент.Значение Цикл
			Если Результат.Префиксы.Найти(ВРег(Префикс)) = Неопределено Тогда
				Результат.Префиксы.Добавить(ВРег(Префикс));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Основы слов (любая падежная форма) -> совместимые префиксы; дополняется префиксами из настроек.
Функция ТаблицаВидов()

	Таблица = Новый Соответствие;
	ДобавитьВид(Таблица, "пользовател,менеджер,сотрудник,ответственн", "Пользователь");
	ДобавитьВид(Таблица, "контрагент", "Контрагент");
	ДобавитьВид(Таблица, "клиент,покупател,поставщик", "Контрагент,Партнер");
	ДобавитьВид(Таблица, "партнер,партнёр", "Партнер");
	ДобавитьВид(Таблица, "организац,юрлиц", "Организация");
	ДобавитьВид(Таблица, "номенклатур,товар,позици,услуг", "Номенклатура");
	ДобавитьВид(Таблица, "физлиц,предпринимател,ип", "Физлицо");
	ДобавитьВид(Таблица, "фио", "ФИО");
	ДобавитьВид(Таблица, "инн", "ИНН," + ПрефиксИННЮЛ());
	Для Каждого Описание Из НастройкиМаскирования().Строки Цикл
		Основа = НРег(Описание.Префикс);
		Если СтрДлина(Основа) > 5 Тогда
			Основа = Лев(Основа, СтрДлина(Основа) - 1);
		КонецЕсли;
		ДобавитьВид(Таблица, Основа, Описание.Префикс);
	КонецЦикла;
	Возврат Таблица;

КонецФункции

Процедура ДобавитьВид(Таблица, Основы, Префиксы)

	Для Каждого Основа Из СтрРазделить(Основы, ",", Ложь) Цикл
		Список = Таблица.Получить(Основа);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Таблица.Вставить(Основа, Список);
		КонецЕсли;
		Для Каждого Префикс Из СтрРазделить(Префиксы, ",", Ложь) Цикл
			Если Список.Найти(Префикс) = Неопределено Тогда
				Список.Добавить(Префикс);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

