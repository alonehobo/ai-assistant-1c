// Строки настроек: из снимка действующей версии политик (если включены версии и в снимке есть раздел), иначе
// из регистра. Версии без раздела commercial_masking (до этого изменения) используют регистр.
Функция ИсходныеСтрокиНастроек()

	Если ИИА_Политики.ПолитикиЧерезВерсии() Тогда
		СтрокиСнимка = ИИА_ПолитикиПовтИсп.ДействующийСнимок().Получить(КлючСнимка());
		Если ТипЗнч(СтрокиСнимка) = Тип("Массив") Тогда
			Возврат СтрокиИзСнимка(СтрокиСнимка);
		КонецЕсли;
	КонецЕсли;
	Возврат СтрокиРегистра();

КонецФункции

Функция СтрокиРегистра()

	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	М.ПолноеИмя КАК ПолноеИмя,
	|	М.Префикс КАК Префикс,
	|	М.Поля КАК Поля,
	|	М.Используется КАК Используется
	|ИЗ
	|	РегистрСведений.ИИА_МаскированиеОбъектов КАК М
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПолноеИмя");
	Строки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строки.Добавить(Новый Структура("ПолноеИмя, Префикс, Поля, Используется", СокрЛП(Выборка.ПолноеИмя),
			СокрЛП(Выборка.Префикс), СокрЛП(Выборка.Поля), Выборка.Используется = Истина));
	КонецЦикла;
	Возврат Строки;

КонецФункции

Функция СтрокиИзСнимка(СтрокиСнимка)

	Строки = Новый Массив;
	Для Каждого Элемент Из СтрокиСнимка Цикл
		Если ТипЗнч(Элемент) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Поля = Элемент.Получить("fields");
		Если ТипЗнч(Поля) = Тип("Массив") Тогда
			ИменаПолей = Новый Массив;
			Для Каждого Поле Из Поля Цикл
				ИменаПолей.Добавить(СокрЛП(Строка(Поле)));
			КонецЦикла;
			Поля = СтрСоединить(ИменаПолей, ",");
		Иначе
			Поля = ?(ТипЗнч(Поля) = Тип("Строка"), Поля, "");
		КонецЕсли;
		Строки.Добавить(Новый Структура("ПолноеИмя, Префикс, Поля, Используется",
			СокрЛП(Строка(Элемент.Получить("object"))), СокрЛП(Строка(Элемент.Получить("prefix"))), Поля,
			Элемент.Получить("used") = Истина));
	КонецЦикла;
	Возврат Строки;

КонецФункции

Функция СправочникСНаименованием(ПолноеИмя)

	Если ТипЗнч(ПолноеИмя) <> Тип("Строка") Или ПустаяСтрока(ПолноеИмя) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(СокрЛП(ПолноеИмя));
	Если ОбъектМетаданных = Неопределено Или Не Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Справочник = Метаданные.Справочники[ОбъектМетаданных.Имя];
	Если Справочник.ДлинаНаименования = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Справочник;

КонецФункции

Функция ЕстьПолеСправочника(ОбъектМетаданных, ИмяПоля)

	Если ПустаяСтрока(ИмяПоля) Тогда
		Возврат Ложь;
	ИначеЕсли ВРег(ИмяПоля) = "НАИМЕНОВАНИЕ" Тогда
		Возврат ОбъектМетаданных.ДлинаНаименования > 0;
	ИначеЕсли ВРег(ИмяПоля) = "КОД" Тогда
		Возврат ОбъектМетаданных.ДлинаКода > 0;
	КонецЕсли;
	Возврат ОбъектМетаданных.Реквизиты.Найти(ИмяПоля) <> Неопределено;

КонецФункции

// Строковые реквизиты фиксированной длины из списка полей (кроме Наименование и ИНН): их можно сравнить в запросе.
// ТолькоИндексированные - для поиска по значению: без индекса условие дало бы полный просмотр справочника.
Функция ТекстовыеПоля(ОбъектМетаданных, СписокПолей, ТолькоИндексированные = Ложь)

	Результат = Новый Массив;
	Для Каждого ИмяПоля Из СписокПолей Цикл
		Если ВРег(ИмяПоля) = "НАИМЕНОВАНИЕ" Или ВРег(ИмяПоля) = "ИНН" Тогда
			Продолжить;
		КонецЕсли;
		Реквизит = ОбъектМетаданных.Реквизиты.Найти(ИмяПоля);
		Если Реквизит = Неопределено Или Реквизит.Тип.Типы().Количество() <> 1
			Или Не Реквизит.Тип.СодержитТип(Тип("Строка")) Или Реквизит.Тип.КвалификаторыСтроки.Длина = 0
			Или ТолькоИндексированные И Реквизит.Индексирование = Метаданные.СвойстваОбъектов.Индексирование.НеИндексировать Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Реквизит.Имя);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПрефиксКорректен(Префикс)

	Если ТипЗнч(Префикс) <> Тип("Строка") Или СтрДлина(Префикс) < 2 Или СтрДлина(Префикс) > 30 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Номер = 1 По СтрДлина(Префикс) Цикл
		Если Не ЭтоБуква(Сред(Префикс, Номер, 1)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Процедура ПроверитьПравоИзменения()

	Если Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ИИА_КлассификацияДанных) Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для изменения настроек маскирования.'");
	КонецЕсли;
	Если ИИА_Политики.ПолитикиЧерезВерсии() Тогда
		ВызватьИсключение НСтр("ru = 'Включён режим версий политик: список маскирования меняется через черновик версии.'");
	КонецЕсли;

КонецПроцедуры

