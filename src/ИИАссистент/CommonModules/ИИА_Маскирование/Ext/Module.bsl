Функция ПредставлениеДляНомера(Псевдоним, Кэш)

	Сохраненное = Кэш.Значения.Получить(Псевдоним);
	Если Сохраненное <> Неопределено И Не ПустаяСтрока(Сохраненное.Представление) Тогда
		Возврат Сохраненное.Представление;
	КонецЕсли;
	Список = Новый Массив;
	Список.Добавить(Псевдоним);
	Исходные = ИсходныеЗначенияПсевдонимов(Список, Кэш);
	Исходное = Исходные.Получить(Псевдоним);
	Если Исходное = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ЭтоСсылка(Исходное.Значение) Тогда
		Ссылки = Новый Массив;
		Ссылки.Добавить(Исходное.Значение);
		Представление = ПредставленияСсылок(Ссылки, Истина).Получить(Исходное.Значение);
		Исходное.Представление = ?(Представление = Неопределено, "", Представление);
	КонецЕсли;
	Возврат Исходное.Представление;

