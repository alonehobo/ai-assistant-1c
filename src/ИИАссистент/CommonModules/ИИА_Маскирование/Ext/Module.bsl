#КонецОбласти

#Область Псевдонимы

Функция Хеш16(Идентификатор)

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ИИА_ПериметрПовтИсп.ДанныеМаскирования().Соль + Строка(Идентификатор));
	Возврат НРег(Лев(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма), 16));

КонецФункции

Процедура ЗарегистрироватьПару(Псевдоним, Значение, Регистрация)

	Если ТипЗнч(Регистрация) = Тип("Соответствие") Тогда
		Регистрация.Вставить(Псевдоним, Значение);
		Возврат;
	КонецЕсли;
	Пары = Новый Соответствие;
	Пары.Вставить(Псевдоним, Значение);
	ЗаписатьПсевдонимы(Пары);

КонецПроцедуры

// Пары, которых ещё нет в регистре; занятые другим значением ключи - в журнал регистрации.
Функция НовыеПары(Пары)

	Псевдонимы = Новый Массив;
	Для Каждого Пара Из Пары Цикл
		Псевдонимы.Добавить(Пара.Ключ);
	КонецЦикла;
	Существующие = ЗначенияИзРегистра(Псевдонимы);
	Новые = Новый Соответствие;
	Для Каждого Пара Из Пары Цикл
		Было = Существующие.Получить(Пара.Ключ);
		Если Было = Неопределено Тогда
			Новые.Вставить(Пара.Ключ, Пара.Значение);
		ИначеЕсли Было <> Пара.Значение Тогда
			ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
				"ALIAS_COLLISION: " + Лев(Пара.Ключ, СтрНайти(Пара.Ключ, "_")));
		КонецЕсли;
	КонецЦикла;
	Возврат Новые;

КонецФункции

// Значения псевдонимов из регистра (привилегированно): канонический псевдоним -> значение.
Функция ЗначенияИзРегистра(Псевдонимы)

	Результат = Новый Соответствие;
	Если Псевдонимы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	П.Псевдоним КАК Псевдоним,
	|	П.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ИИА_ПсевдонимыОбъектов КАК П
	|ГДЕ
	|	П.Псевдоним В (&Псевдонимы)");
	Запрос.УстановитьПараметр("Псевдонимы", Псевдонимы);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Префикс, которого уже нет в настройках, оставляет ключ как записан (пары пишутся в каноническом виде).
		Ключ = КаноническийПсевдоним(Выборка.Псевдоним, Истина);
		Результат.Вставить(?(ПустаяСтрока(Ключ), СокрЛП(Выборка.Псевдоним), Ключ), Выборка.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Канонический вид коммерческого псевдонима (префикс как в настройках, hex в нижнем регистре); пусто - не коммерческий.
Функция КаноническийПсевдоним(Псевдоним, ЛюбойВид = Ложь)

	Если ТипЗнч(Псевдоним) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	Текст = СокрЛП(Псевдоним);
	Разделитель = СтрНайти(Текст, "_", НаправлениеПоиска.СКонца);
	Если Разделитель < 2 Тогда
		Возврат "";
	КонецЕсли;
	Описание = НастройкиМаскирования().ПоПрефиксу.Получить(ВРег(Лев(Текст, Разделитель - 1)));
	Хеш = НРег(Сред(Текст, Разделитель + 1));
	Если Описание = Неопределено Или Не (ЛюбойВид Или Описание.Коммерческий) Тогда
		Возврат "";
	КонецЕсли;
	Если Не ЛюбойВид И (СтрДлина(Хеш) <> 16 Или Не ЭтоHex(Хеш)) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Описание.Префикс + "_" + Хеш;

КонецФункции

Функция ВидПсевдонима(Псевдоним)

	Разделитель = СтрНайти(Псевдоним, "_", НаправлениеПоиска.СКонца);
	Описание = НастройкиМаскирования().ПоПрефиксу.Получить(ВРег(Лев(Псевдоним, Разделитель - 1)));
	Возврат ?(Описание = Неопределено, Лев(Псевдоним, Разделитель - 1), Описание.Вид);

КонецФункции

Функция ПрефиксПсевдонима(Псевдоним)

	Возврат Лев(Псевдоним, СтрНайти(Псевдоним, "_", НаправлениеПоиска.СКонца) - 1);

КонецФункции

// Исходные значения псевдонимов: канонический псевдоним -> Структура (Значение, Представление).
// Коммерческие - из регистра, ПДн - из карт ИИА_Периметр. Представление ссылки здесь не вычисляется.
Функция ИсходныеЗначенияПсевдонимов(Псевдонимы, Кэш)

	Результат = Новый Соответствие;
	Коммерческие = Новый Массив;
	Для Каждого Псевдоним Из Псевдонимы Цикл
		Если Кэш <> Неопределено И Кэш.Значения.Получить(Псевдоним) <> Неопределено Тогда
			Результат.Вставить(Псевдоним, Кэш.Значения.Получить(Псевдоним));
		ИначеЕсли ЭтоКоммерческийПсевдоним(Псевдоним) Тогда
			Коммерческие.Добавить(Псевдоним);
		Иначе
			Найдено = ИИА_Периметр.ЗначениеПсевдонима(Псевдоним);
			Если Найдено <> Неопределено Тогда
				Результат.Вставить(Псевдоним, Новый Структура("Значение, Представление", Найдено.Ссылка,
					Найдено.Представление));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Значения = ЗначенияИзРегистра(Коммерческие);
	Для Каждого Псевдоним Из Коммерческие Цикл
		Значение = Значения.Получить(Псевдоним);
		Если Значение <> Неопределено Тогда
			Результат.Вставить(Псевдоним, Новый Структура("Значение, Представление", Значение,
				?(ЭтоСсылка(Значение), "", Строка(Значение))));
		КонецЕсли;
	КонецЦикла;
	Если Кэш <> Неопределено Тогда
		Для Каждого Элемент Из Результат Цикл
			Кэш.Значения.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Представления коммерческих псевдонимов для модели Т1/Т2 (с правами пользователя): псевдоним -> строка.
Функция РаскрытыеПредставления(Псевдонимы, Кэш)

	Коммерческие = Новый Массив;
	Для Каждого Псевдоним Из Псевдонимы Цикл
		Если ЭтоКоммерческийПсевдоним(Псевдоним) Тогда
			Коммерческие.Добавить(Псевдоним);
		КонецЕсли;
	КонецЦикла;
	Результат = Новый Соответствие;
	Если Коммерческие.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Исходные = ИсходныеЗначенияПсевдонимов(Коммерческие, Кэш);
	Ссылки = Новый Массив;
	Для Каждого Элемент Из Исходные Цикл
		Если ЭтоСсылка(Элемент.Значение.Значение) Тогда
			Ссылки.Добавить(Элемент.Значение.Значение);
		КонецЕсли;
	КонецЦикла;
	Представления = ПредставленияСсылок(Ссылки, Истина);
	Для Каждого Элемент Из Исходные Цикл
		Если ЭтоСсылка(Элемент.Значение.Значение) Тогда
			Представление = Представления.Получить(Элемент.Значение.Значение);
		Иначе
			Представление = Элемент.Значение.Представление;
		КонецЕсли;
		Если Не ПустаяСтрока(Представление) Тогда
			Результат.Вставить(Элемент.Ключ, Представление);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Представления ссылок одним запросом на объект метаданных; СУчетомПрав - РАЗРЕШЕННЫЕ в правах пользователя.
Функция ПредставленияСсылок(Ссылки, СУчетомПрав)

	Результат = Новый Соответствие;
	ПоОбъектам = Новый Соответствие;
	Для Каждого Ссылка Из Ссылки Цикл
		Если Не ЗначениеЗаполнено(Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		ОбъектМетаданных = Ссылка.Метаданные();
		Список = ПоОбъектам.Получить(ОбъектМетаданных);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			ПоОбъектам.Вставить(ОбъектМетаданных, Список);
		КонецЕсли;
		Если Список.Найти(Ссылка) = Неопределено Тогда
			Список.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Элемент Из ПоОбъектам Цикл
		Если СУчетомПрав И Не ПравоДоступа("Чтение", Элемент.Ключ) Тогда
			Продолжить;
		КонецЕсли;
		// Источник - объект метаданных самой ссылки.
		// BSLLS:QueryParseError-off
		Запрос = Новый Запрос(СтрШаблон(
			"ВЫБРАТЬ %1 Т.Ссылка КАК Ссылка, ПРЕДСТАВЛЕНИЕ(Т.Ссылка) КАК Представление ИЗ %2 КАК Т ГДЕ Т.Ссылка В (&Ссылки)",
			?(СУчетомПрав, "РАЗРЕШЕННЫЕ", ""), Элемент.Ключ.ПолноеИмя()));
		// BSLLS:QueryParseError-on
		Запрос.УстановитьПараметр("Ссылки", Элемент.Значение);
		Попытка
			Если СУчетомПрав Тогда
				Выборка = Запрос.Выполнить().Выбрать();
			Иначе
				Выборка = ВыборкаПривилегированно(Запрос);
			КонецЕсли;
			Пока Выборка.Следующий() Цикл
				Результат.Вставить(Выборка.Ссылка, СокрЛП(Выборка.Представление));
			КонецЦикла;
		Исключение
			ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ВыборкаПривилегированно(Запрос)

	УстановитьПривилегированныйРежим(Истина);
	Возврат Запрос.Выполнить().Выбрать();

КонецФункции

#КонецОбласти

#Область ЗначенияИСлоты

Функция ЭтоКоллекция(Значение)

	Тип = ТипЗнч(Значение);
	Возврат Тип = Тип("Массив") Или Тип = Тип("ФиксированныйМассив") Или Тип = Тип("Структура")
		Или Тип = Тип("ФиксированнаяСтруктура") Или Тип = Тип("Соответствие") Или Тип = Тип("ФиксированноеСоответствие");

КонецФункции

Функция ЭтоСсылка(Значение)

	Возврат Значение <> Неопределено И ТипЗнч(Значение) <> Тип("Строка") И ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Значение));

КонецФункции

// Изменяемая копия коллекции (фиксированные становятся изменяемыми); Обработчик - имя функции для строк.
Функция КопияКоллекции(Значение, Обработчик = "")

	Тип = ТипЗнч(Значение);
	Если Тип = Тип("Строка") И Обработчик = "РаскрытьАргументы" Тогда
		Возврат РаскрытьАргументы(Значение);
	ИначеЕсли Тип = Тип("Массив") Или Тип = Тип("ФиксированныйМассив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(КопияКоллекции(Элемент, Обработчик));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли Тип = Тип("Структура") Или Тип = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Новый Структура;
		Для Каждого Элемент Из Значение Цикл
			Результат.Вставить(Элемент.Ключ, КопияКоллекции(Элемент.Значение, Обработчик));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли Тип = Тип("Соответствие") Или Тип = Тип("ФиксированноеСоответствие") Тогда
		Результат = Новый Соответствие;
		Для Каждого Элемент Из Значение Цикл
			Результат.Вставить(Элемент.Ключ, КопияКоллекции(Элемент.Значение, Обработчик));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Копия значения и слоты всех её строк: Структура (Владелец, Ключ, Значение, Роль, Инструмент).
// Строка верхнего уровня - слот с владельцем Неопределено (копия возвращается после УстановитьСлот).
Функция СобратьСтрокиЗначения(Значение, Слоты)

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Держатель = Новый Массив;
		Держатель.Добавить(Значение);
		ДобавитьСлот(Слоты, Держатель, 0, Значение, "", "");
		Возврат Держатель;
	КонецЕсли;
	Копия = КопияКоллекции(Значение);
	СобратьСлотыКоллекции(Копия, Слоты, "", "");
	Возврат Копия;

КонецФункции

Процедура СобратьСлотыКоллекции(Коллекция, Слоты, Роль, Инструмент)

	Тип = ТипЗнч(Коллекция);
	Если Тип = Тип("Массив") Тогда
		Для Индекс = 0 По Коллекция.ВГраница() Цикл
			Элемент = Коллекция[Индекс];
			Если ТипЗнч(Элемент) = Тип("Строка") Тогда
				ДобавитьСлот(Слоты, Коллекция, Индекс, Элемент, Роль, Инструмент);
			Иначе
				СобратьСлотыКоллекции(Элемент, Слоты, Роль, Инструмент);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли Тип = Тип("Структура") Или Тип = Тип("Соответствие") Тогда
		Для Каждого Элемент Из Коллекция Цикл
			Если ТипЗнч(Элемент.Значение) = Тип("Строка") Тогда
				ДобавитьСлот(Слоты, Коллекция, Элемент.Ключ, Элемент.Значение, Роль, Инструмент);
			Иначе
				СобратьСлотыКоллекции(Элемент.Значение, Слоты, Роль, Инструмент);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьСлот(Слоты, Владелец, Ключ, Значение, Роль, Инструмент)

	Слоты.Добавить(Новый Структура("Владелец, Ключ, Значение, Роль, Инструмент", Владелец, Ключ, Значение, Роль,
		Инструмент));

КонецПроцедуры

Процедура УстановитьСлот(Слот, Значение)

	Слот.Значение = Значение;
	Если ТипЗнч(Слот.Владелец) = Тип("Массив") Тогда
		Слот.Владелец.Установить(Слот.Ключ, Значение);
	Иначе
		Слот.Владелец.Вставить(Слот.Ключ, Значение);
	КонецЕсли;

КонецПроцедуры

// Слоты строк сообщений OpenAI: content (строка или текстовые части) и аргументы tool_calls (разобранный JSON).
// Блоки рассуждений и прочие служебные поля не входят. После правки вызвать ЗавершитьРазборСообщений.
Функция СлотыСообщений(Сообщения)

	Разбор = Новый Структура("Слоты, Аргументы", Новый Массив, Новый Массив);
	ИменаВызовов = Новый Соответствие;
	Для Каждого Сообщение Из Сообщения Цикл
		Если ТипЗнч(Сообщение) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Вызовы = Сообщение.Получить("tool_calls");
		Если ТипЗнч(Вызовы) = Тип("Массив") Тогда
			Для Каждого Вызов Из Вызовы Цикл
				Функция_ = ?(ТипЗнч(Вызов) = Тип("Соответствие"), Вызов.Получить("function"), Неопределено);
				Если ТипЗнч(Функция_) = Тип("Соответствие") Тогда
					ИменаВызовов.Вставить(Вызов.Получить("id"), Строка(Функция_.Получить("name")));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Сообщение Из Сообщения Цикл
		Если ТипЗнч(Сообщение) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Роль = Строка(Сообщение.Получить("role"));
		Инструмент = "";
		Если Роль = "tool" Тогда
			Имя = ИменаВызовов.Получить(Сообщение.Получить("tool_call_id"));
			Инструмент = ?(Имя = Неопределено, "", Имя);
		КонецЕсли;
		Содержимое = Сообщение.Получить("content");
		Если ТипЗнч(Содержимое) = Тип("Строка") Тогда
			ДобавитьСлот(Разбор.Слоты, Сообщение, "content", Содержимое, Роль, Инструмент);
		ИначеЕсли ТипЗнч(Содержимое) = Тип("Массив") Тогда
			Для Каждого Часть Из Содержимое Цикл
				Если ТипЗнч(Часть) = Тип("Соответствие") И Часть.Получить("type") = "text"
					И ТипЗнч(Часть.Получить("text")) = Тип("Строка") Тогда
					ДобавитьСлот(Разбор.Слоты, Часть, "text", Часть.Получить("text"), Роль, Инструмент);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Вызовы = Сообщение.Получить("tool_calls");
		Если ТипЗнч(Вызовы) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Вызов Из Вызовы Цикл
			Функция_ = ?(ТипЗнч(Вызов) = Тип("Соответствие"), Вызов.Получить("function"), Неопределено);
			Если ТипЗнч(Функция_) <> Тип("Соответствие") Или ТипЗнч(Функция_.Получить("arguments")) <> Тип("Строка") Тогда
				Продолжить;
			КонецЕсли;
			// Невалидный JSON от модели - штатный случай: аргументы маскируются как одна строка.
			Попытка
				Аргументы = ОбщегоНазначения.JSONВЗначение(Функция_.Получить("arguments"), , Истина);
			Исключение // BSLLS:MissingCodeTryCatchEx-off
				Аргументы = Неопределено;
			КонецПопытки;
			Если ТипЗнч(Аргументы) = Тип("Соответствие") Тогда
				Разбор.Аргументы.Добавить(Новый Структура("Владелец, Значение, Снимок", Функция_, Аргументы,
					ОбщегоНазначения.ЗначениеВJSON(Аргументы)));
				СобратьСлотыКоллекции(Аргументы, Разбор.Слоты, Роль, "");
			Иначе
				ДобавитьСлот(Разбор.Слоты, Функция_, "arguments", Функция_.Получить("arguments"), Роль, "");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Разбор;

КонецФункции

Процедура ЗавершитьРазборСообщений(Разбор)

	// Неизменённые аргументы остаются исходной строкой (стабильный префикс запроса для кэша провайдера).
	Для Каждого Элемент Из Разбор.Аргументы Цикл
		Новые = ОбщегоНазначения.ЗначениеВJSON(Элемент.Значение);
		Если Новые <> Элемент.Снимок Тогда
			Элемент.Владелец.Вставить("arguments", Новые);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Слоты текстового слоя и контрольной проверки: без системных сообщений и результатов инструментов кода.
Функция СлотыТекстовогоСлоя(Слоты)

	Результат = Новый Массив;
	Для Каждого Слот Из Слоты Цикл
		Если Слот.Роль = "system" Или Слот.Роль = "tool" И ЭтоИнструментКода(Слот.Инструмент) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Слот);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Текстовый слой по строкам слотов; при успехе слоты заменяются. Возвращает результат ЗамаскироватьТексты.
Функция ЗамаскироватьСлоты(Слоты, Кэш)

	Тексты = Новый Массив;
	Для Каждого Слот Из Слоты Цикл
		Тексты.Добавить(Слот.Значение);
	КонецЦикла;
	Маскирование = ЗамаскироватьТексты(Тексты, Кэш);
	Если Маскирование.Успех Тогда
		Для Индекс = 0 По Слоты.ВГраница() Цикл
			УстановитьСлот(Слоты[Индекс], Маскирование.Тексты[Индекс]);
		КонецЦикла;
	КонецЕсли;
	Возврат Маскирование;

КонецФункции

// Рассуждения сообщений ассистента (thinking_blocks Anthropic, responses_output OpenAI) содержат то, что видела
// модель-автор: модели Т3 остаются только рассуждения, написанные Т3. Возвращает Истина, если что-то удалено.
Функция УдалитьЧужиеРассуждения(Сообщения)

	Удалены = Ложь;
	Для Каждого Сообщение Из Сообщения Цикл
		Если ТипЗнч(Сообщение) <> Тип("Соответствие") Или Сообщение.Получить("role") <> "assistant"
			Или Сообщение.Получить(КлючДовериеАвтора()) = "Т3" Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Ключ Из СтрРазделить("thinking_blocks,responses_output", ",") Цикл
			Если Сообщение.Получить(Ключ) <> Неопределено Тогда
				Сообщение.Удалить(Ключ);
				Удалены = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Удалены;

КонецФункции

// Результаты инструментов кода и метаданных - идентификаторы, а не данные: текстовый слой их не трогает.
Функция ЭтоИнструментКода(Имя)

	Возврат СтрРазделить("rlm_execute,code_movements,form_layout,search_metadata,describe_metadata,describe_report,find_report,data_access",
		",").Найти(Имя) <> Неопределено;

КонецФункции

// Собирает канонические псевдонимы всех строк значения в порядке первого появления.
Процедура СобратьПсевдонимы(Значение, Псевдонимы, Порядок)

	Тип = ТипЗнч(Значение);
	Если Тип = Тип("Строка") Тогда
		Для Каждого Найденный Из НайтиПсевдонимыВТексте(Значение) Цикл
			Если Псевдонимы.Получить(Найденный.Псевдоним) = Неопределено Тогда
				Псевдонимы.Вставить(Найденный.Псевдоним, Найденный);
				Порядок.Добавить(Найденный.Псевдоним);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли Тип = Тип("Массив") Или Тип = Тип("ФиксированныйМассив") Тогда
		Для Каждого Элемент Из Значение Цикл
			СобратьПсевдонимы(Элемент, Псевдонимы, Порядок);
		КонецЦикла;
	ИначеЕсли Тип = Тип("Структура") Или Тип = Тип("ФиксированнаяСтруктура") Или Тип = Тип("Соответствие")
		Или Тип = Тип("ФиксированноеСоответствие") Тогда
		Для Каждого Элемент Из Значение Цикл
			СобратьПсевдонимы(Элемент.Значение, Псевдонимы, Порядок);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция ЗаменитьПсевдонимыВЗначении(Значение, Отображения)

	Если Отображения.Количество() = 0 Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат ЗаменитьПсевдонимыВТексте(Значение, Отображения);
	ИначеЕсли Не ЭтоКоллекция(Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Слоты = Новый Массив;
	Копия = СобратьСтрокиЗначения(Значение, Слоты);
	Для Каждого Слот Из Слоты Цикл
		УстановитьСлот(Слот, ЗаменитьПсевдонимыВТексте(Слот.Значение, Отображения));
	КонецЦикла;
	Возврат Копия;

КонецФункции

Функция ЗаменитьПсевдонимыВТексте(Текст, Отображения)

	Найденные = НайтиПсевдонимыВТексте(Текст);
	Если Найденные.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Части = Новый Массив;
	Позиция = 1;
	Для Каждого Найденный Из Найденные Цикл
		Замена = Отображения.Получить(Найденный.Псевдоним);
		Если Замена = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Части.Добавить(Сред(Текст, Позиция, Найденный.Начало - Позиция));
		Части.Добавить(Замена);
		Позиция = Найденный.Начало + Найденный.Длина;
	КонецЦикла;
	Если Позиция = 1 Тогда
		Возврат Текст;
	КонецЕсли;
	Части.Добавить(Сред(Текст, Позиция));
	Возврат СтрСоединить(Части);

КонецФункции

Функция ЭкранироватьДляJSON(Текст)

	Возврат СтрЗаменить(СтрЗаменить(Текст, "\", "\\"), """", "\""");

