// ИИ-ассистент: мастер быстрой настройки после установки расширения (форма ИИА_МастерНастройки).
// Поставляемые данные, подключение к модели, выдача поставляемых профилей групп доступа, включение.
// Вызывается из форм администратора: справочники и константы ассистента читаются в его правах.

#Область СлужебныйПрограммныйИнтерфейс

// Нужна ли настройка: ассистент выключен или нет ни одного используемого подключения к модели.
//
// Возвращаемое значение:
//  Булево
//
Функция ТребуетсяНастройка() Экспорт

	Если Не Константы.ИИА_ИспользоватьАссистента.Получить() Тогда
		Возврат Истина;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Найдено
	|ИЗ
	|	Справочник.ИИА_ПодключенияМоделей КАК П
	|ГДЕ
	|	П.Используется
	|	И НЕ П.ПометкаУдаления");
	Возврат Запрос.Выполнить().Пустой();

КонецФункции

// Заполняет поставляемые данные без проверки версии: добавляются только отсутствующие записи.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * Текст - Строка - сводка заполненных справочников или текст ошибки.
//
Функция ЗаполнитьПоставляемыеДанные() Экспорт

	ПроверитьПраваАдминистратора();
	Результат = Новый Структура("Успех, Текст", Истина, "");
	Ошибка = ОбновлениеИнформационнойБазыИИА.ЗаполнитьПоставляемыеДанныеПринудительно();
	Если ПустаяСтрока(Ошибка) Тогда
		Результат.Текст = СводкаПоставляемыхДанных();
	Иначе
		Результат.Успех = Ложь;
		Результат.Текст = СтрШаблон(НСтр("ru = 'Поставляемые данные не заполнены: %1
			|Подробности - в журнале регистрации, событие «ИИАссистент.ПоставляемыеДанные».'"), Ошибка);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Подключение для шага «Модель»: первое используемое, иначе первое по порядку.
//
// Возвращаемое значение:
//  СправочникСсылка.ИИА_ПодключенияМоделей, Неопределено
//
Функция ПодключениеПоУмолчанию() Экспорт

	ПроверитьПраваАдминистратора();
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	П.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИИА_ПодключенияМоделей КАК П
	|ГДЕ
	|	НЕ П.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	П.Используется УБЫВ,
	|	П.Порядок");
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);

КонецФункции

// Свойства подключения для шага «Модель». Ключ API не возвращается, только признак сохранённого ключа.
//
// Параметры:
//  Подключение - СправочникСсылка.ИИА_ПодключенияМоделей
//
// Возвращаемое значение:
//  Структура:
//   * Модель - Строка
//   * АдресAPI - Строка
//   * Доверие - ПеречислениеСсылка.ИИА_УровниДоверия
//   * Комментарий - Строка
//   * КлючСохранен - Булево
//
Функция ОписаниеПодключения(Подключение) Экспорт

	ПроверитьПраваАдминистратора();
	Результат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Подключение, "Модель, АдресAPI, Доверие, Комментарий");
	// Безопасное хранилище читается только в привилегированном режиме; наружу - лишь признак ключа.
	УстановитьПривилегированныйРежим(Истина); // BSLLS:SetPrivilegedMode-off
	Ключ = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Подключение, "КлючAPI");
	УстановитьПривилегированныйРежим(Ложь);
	Результат.Вставить("КлючСохранен", ЗначениеЗаполнено(Ключ));
	Возврат Результат;

КонецФункции

// Записывает модель и ключ API подключения; пустой ключ не меняет сохранённый.
//
// Параметры:
//  Подключение - СправочникСсылка.ИИА_ПодключенияМоделей
//  Модель - Строка
//  КлючAPI - Строка
//  Включить - Булево - установить «Используется».
//
Процедура ЗаписатьПодключение(Подключение, Модель, КлючAPI, Включить) Экспорт

	ПроверитьПраваАдминистратора();
	ИИА_ЧатВызовСервера.СохранитьКлючПодключения(Подключение, КлючAPI);
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.ИИА_ПодключенияМоделей");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Подключение);
		Блокировка.Заблокировать();
		Элемент = Подключение.ПолучитьОбъект();
		Элемент.Модель = СокрЛП(Модель);
		Если Включить Тогда
			Элемент.Используется = Истина;
		КонецЕсли;
		Элемент.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Проверяет подключение коротким запросом без данных базы.
//
// Параметры:
//  Подключение - СправочникСсылка.ИИА_ПодключенияМоделей
//
// Возвращаемое значение:
//  Строка - результат проверки.
//
Функция ПроверитьПодключение(Подключение) Экспорт

	Возврат ИИА_ЧатВызовСервера.ПроверитьПодключение(Подключение);

КонецФункции

// Пользователи, которым выданы поставляемые профили групп доступа ассистента.
//
// Возвращаемое значение:
//  Структура:
//   * Пользователи - Массив из Структура - Пользователь, Администратор.
//   * Ошибка - Строка - причина, по которой профили выдать нельзя; пусто - можно.
//   * ТекущийПользователь - СправочникСсылка.Пользователи - кандидат в администраторы, когда список пуст.
//
Функция ПользователиАссистента() Экспорт

	ПроверитьПраваАдминистратора();
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	Результат = Новый Структура("Пользователи, Ошибка, ТекущийПользователь", Новый Массив, "", ТекущийПользователь);
	Профили = ПоставляемыеПрофили();
	Если Не ПустаяСтрока(Профили.Ошибка) Тогда
		Результат.Ошибка = Профили.Ошибка;
		Возврат Результат;
	КонецЕсли;
	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		Результат.Ошибка = НСтр("ru = 'Выдавать профили групп доступа может только полноправный пользователь.'");
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Составы.Пользователь КАК Пользователь,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА Участники.Ссылка.Профиль = &ПрофильАдминистратора
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Администратор
	|ИЗ
	|	Справочник.ГруппыДоступа.Пользователи КАК Участники
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СоставыГруппПользователей КАК Составы
	|		ПО (Составы.ГруппаПользователей = Участники.Пользователь)
	|ГДЕ
	|	Участники.Ссылка.Профиль В (&ПрофильПользователя, &ПрофильАдминистратора)
	|	И НЕ Участники.Ссылка.ПометкаУдаления
	|	И Составы.Используется
	|	И ТИПЗНАЧЕНИЯ(Составы.Пользователь) = ТИП(Справочник.Пользователи)
	|
	|СГРУППИРОВАТЬ ПО
	|	Составы.Пользователь
	|
	|УПОРЯДОЧИТЬ ПО
	|	Составы.Пользователь.Наименование");
	Запрос.УстановитьПараметр("ПрофильПользователя", Профили.Пользователь);
	Запрос.УстановитьПараметр("ПрофильАдминистратора", Профили.Администратор);
	// Группы доступа БСП администратору ассистента недоступны: только состав назначений, без прав на изменение.
	УстановитьПривилегированныйРежим(Истина); // BSLLS:SetPrivilegedMode-off
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	Пока Выборка.Следующий() Цикл
		Назначение = Новый Структура("Пользователь, Администратор", Выборка.Пользователь, Выборка.Администратор = 1);
		Результат.Пользователи.Добавить(Назначение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Выдаёт пользователям поставляемый профиль «ИИ-ассистент: пользователь» или «…: администратор»:
// включает их в группу доступа профиля. Уже выданные профили не снимаются.
// ВключитьПрофильПользователю БСП не подходит: работает только в упрощённом интерфейсе настройки прав,
// а в ERP и УТ он полный.
//
// Параметры:
//  Назначения - Массив из Структура - Пользователь, Администратор.
//
// Возвращаемое значение:
//  Число - сколько пользователей обработано.
//
Функция ВыдатьПрофили(Назначения) Экспорт

	ПроверитьПраваАдминистратора();
	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		ВызватьИсключение НСтр("ru = 'Выдавать профили групп доступа может только полноправный пользователь.'");
	КонецЕсли;
	Профили = ПоставляемыеПрофили();
	Если Не ПустаяСтрока(Профили.Ошибка) Тогда
		ВызватьИсключение Профили.Ошибка;
	КонецЕсли;
	ОбычныеПользователи = Новый Массив;
	Администраторы = Новый Массив;
	Для Каждого Назначение Из Назначения Цикл
		Если Не ЗначениеЗаполнено(Назначение.Пользователь) Тогда
			Продолжить;
		КонецЕсли;
		// Профиль администратора включает роль пользователя ассистента.
		Участники = ?(Назначение.Администратор, Администраторы, ОбычныеПользователи);
		Участники.Добавить(Назначение.Пользователь);
	КонецЦикла;
	ВключитьВГруппуДоступаПрофиля(Профили.Пользователь, ОбычныеПользователи);
	ВключитьВГруппуДоступаПрофиля(Профили.Администратор, Администраторы);
	Возврат ОбычныеПользователи.Количество() + Администраторы.Количество();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьПраваАдминистратора()

	Если Не Пользователи.РолиДоступны("ИИА_Администратор") И Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для настройки ИИ-ассистента.'");
	КонецЕсли;

КонецПроцедуры

// Включает пользователей в общую группу доступа профиля: основную группу поставляемого профиля, которую ведёт БСП,
// иначе в другую общую группу профиля, иначе в новую группу с наименованием профиля.
Процедура ВключитьВГруппуДоступаПрофиля(Профиль, Участники)

	Если Участники.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Группа = ГруппаДоступаПрофиля(Профиль);
		Если ЗначениеЗаполнено(Группа) Тогда
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("Справочник.ГруппыДоступа");
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Группа);
			Блокировка.Заблокировать();
			ГруппаОбъект = Группа.ПолучитьОбъект();
			Изменена = Ложь;
		Иначе
			ГруппаОбъект = Справочники.ГруппыДоступа.СоздатьЭлемент();
			ГруппаОбъект.Наименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Профиль, "Наименование");
			ГруппаОбъект.Профиль = Профиль;
			Изменена = Истина;
		КонецЕсли;
		Для Каждого Участник Из Участники Цикл
			Если ГруппаОбъект.Пользователи.Найти(Участник, "Пользователь") = Неопределено Тогда
				ГруппаОбъект.Пользователи.Добавить().Пользователь = Участник;
				Изменена = Истина;
			КонецЕсли;
		КонецЦикла;
		Если Изменена Тогда
			ГруппаОбъект.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Функция ГруппаДоступаПрофиля(Профиль)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ГруппыДоступа.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ГруппыДоступа КАК ГруппыДоступа
	|ГДЕ
	|	ГруппыДоступа.Профиль = &Профиль
	|	И НЕ ГруппыДоступа.ЭтоГруппа
	|	И НЕ ГруппыДоступа.ПометкаУдаления
	|	И ГруппыДоступа.Пользователь В (НЕОПРЕДЕЛЕНО, ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка))
	|
	|УПОРЯДОЧИТЬ ПО
	|	ГруппыДоступа.ОсновнаяГруппаДоступаПоставляемогоПрофиля УБЫВ,
	|	ГруппыДоступа.Наименование");
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);

КонецФункции

// Поставляемые профили групп доступа ассистента (см. УправлениеДоступомПереопределяемый расширения).
// БСП создаёт их при обновлении параметров работы расширений; до этого ссылок нет.
Функция ПоставляемыеПрофили()

	Результат = Новый Структура("Пользователь, Администратор, Ошибка");
	Результат.Пользователь = УправлениеДоступом.ПоставляемыйПрофильПоИдентификатору("ИИА_Пользователь");
	Результат.Администратор = УправлениеДоступом.ПоставляемыйПрофильПоИдентификатору("ИИА_Администратор");
	Если Не ЗначениеЗаполнено(Результат.Пользователь) Или Не ЗначениеЗаполнено(Результат.Администратор) Тогда
		Результат.Ошибка = НСтр("ru = 'Профили групп доступа «ИИ-ассистент: пользователь» и «ИИ-ассистент: администратор»
			|ещё не созданы. Перезапустите программу, чтобы обновились параметры работы расширений, и повторите шаг.'");
	Иначе
		Результат.Ошибка = "";
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция СводкаПоставляемыхДанных()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(П.Ссылка) КАК Количество
	|ИЗ
	|	Справочник.ИИА_ПодключенияМоделей КАК П
	|ГДЕ
	|	НЕ П.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(П.Ссылка) КАК Количество
	|ИЗ
	|	Справочник.ИИА_ПрофилиДоступа КАК П
	|ГДЕ
	|	НЕ П.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(К.Ссылка) КАК Количество
	|ИЗ
	|	Справочник.ИИА_КарточкиОтчетов КАК К
	|ГДЕ
	|	НЕ К.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Г.Ссылка) КАК Количество
	|ИЗ
	|	Справочник.ИИА_Глоссарий КАК Г
	|ГДЕ
	|	НЕ Г.ПометкаУдаления");
	Результаты = Запрос.ВыполнитьПакет();
	Количества = Новый Массив;
	Для Каждого РезультатЗапроса Из Результаты Цикл
		Выборка = РезультатЗапроса.Выбрать();
		Количества.Добавить(?(Выборка.Следующий(), Выборка.Количество, 0));
	КонецЦикла;
	Шаблон = НСтр("ru = 'Поставляемые данные заполнены:
		|- подключений к моделям: %1;
		|- профилей доступа: %2;
		|- карточек отчётов: %3;
		|- терминов глоссария: %4.'");
	Возврат СтрШаблон(Шаблон, Количества[0], Количества[1], Количества[2], Количества[3]);

КонецФункции

#КонецОбласти
