///////////////////////////////////////////////////////////////////////////////////////////////////////
// ИИ-ассистент: локальный мост ACP к агентам, установленным на компьютере пользователя.
// Сервер 1С не может вести диалог с CLI через stdin/stdout, поэтому запросы идут в мост на 127.0.0.1,
// а мост запускает агента. Мост запускает клиент: от имени пользователя, которому принадлежат CLI
// и их авторизация. Токен моста постоянный и хранится в профиле пользователя, ключ подключения
// заполняется из него автоматически.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Запускает мост, если он не отвечает или устарел, и возвращает его токен и установленных агентов.
//
// Параметры:
//  АдресAPI - Строка - адрес подключения, например http://127.0.0.1:18765/v1.
//
// Возвращаемое значение:
//  Обещание - результат Структура:
//   * Токен - Строка - пусто при ошибке.
//   * Агенты - СписокЗначений - идентификатор профиля и название агента, только установленные.
//   * Ошибка - Строка
//
Асинх Функция ЗапуститьМостАсинх(АдресAPI) Экспорт

	Результат = Новый Структура("Токен, Агенты, Ошибка", "", Новый СписокЗначений, "");
	#Если ВебКлиент Тогда
	Результат.Ошибка = НСтр("ru = 'Агенты на компьютере пользователя доступны только в тонком клиенте.'");
	Возврат Результат;
	#Иначе
	Порт = ПортМоста(АдресAPI);
	Если Порт = 0 Тогда
		Результат.Ошибка = НСтр("ru = 'Адрес моста ACP должен быть вида http://127.0.0.1:18765/v1.'");
		Возврат Результат;
	КонецЕсли;
	Каталог = КаталогМоста();
	ФайлТокена = Каталог + "token";
	Скрипт = ИИА_ЧатВызовСервера.СкриптМостаACP();

	Ответ = Ждать ОтветМостаАсинх(ФайлТокена, Порт);
	Если Ответ.Код = 200 И Ответ.Версия = Скрипт.Версия Тогда
		Возврат РезультатПоОтвету(Результат, Ответ);
	КонецЕсли;
	Если Ответ.Код = 200 Тогда
		// Мост от прежней версии расширения: останавливаем его и ждём, пока он освободит порт.
		ОстановитьМост(Порт, Ответ.Токен);
		Срок = ТекущаяУниверсальнаяДатаВМиллисекундах() + 5000;
		Пока Ответ.Код <> 0 И ТекущаяУниверсальнаяДатаВМиллисекундах() < Срок Цикл
			Ответ = Ждать ОтветМостаАсинх(ФайлТокена, Порт);
		КонецЦикла;
	ИначеЕсли Ответ.Код = 401 Тогда
		Результат.Ошибка = СтрШаблон(НСтр("ru = 'На порту %1 работает мост ACP, запущенный вручную с другим токеном. Закройте его или укажите его токен в поле «Ключ API».'"), Порт);
		Возврат Результат;
	КонецЕсли;

	Python = Ждать КомандаPythonАсинх();
	Если ПустаяСтрока(Python) Тогда
		Результат.Ошибка = НСтр("ru = 'Для агентов на этом компьютере нужен Python 3.10 или новее. Установите его с python.org (с отметкой «Add python.exe to PATH»), перезапустите 1С и повторите.'");
		Возврат Результат;
	КонецЕсли;
	Ждать СоздатьКаталогАсинх(Каталог);
	ФайлСкрипта = Каталог + "acp_bridge.py";
	Ждать Скрипт.Данные.ЗаписатьАсинх(ФайлСкрипта);
	Ждать ЗапуститьПриложениеАсинх(СтрШаблон("%1 -I ""%2"" --port %3 --token-file ""%4""",
		Python, ФайлСкрипта, Формат(Порт, "ЧГ="), ФайлТокена), Каталог, Ложь);

	Срок = ТекущаяУниверсальнаяДатаВМиллисекундах() + 15000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Срок Цикл
		Ждать ПаузаАсинх(Python);
		Ответ = Ждать ОтветМостаАсинх(ФайлТокена, Порт);
		Если Ответ.Код = 200 Тогда
			Возврат РезультатПоОтвету(Результат, Ответ);
		КонецЕсли;
	КонецЦикла;
	Результат.Ошибка = СтрШаблон(НСтр("ru = 'Мост ACP не запустился на порту %1. Проверьте, что порт свободен, и запустите в PowerShell для диагностики:
		|%2 -I ""%3"" --check'"), Порт, ?(Python = "pythonw", "python", "py -3"), ФайлСкрипта);
	Возврат Результат;
	#КонецЕсли

КонецФункции

// Запускает мосты используемых подключений ACP без сообщений пользователю: чат открывается сразу,
// а мост успевает подняться к первому вопросу.
//
Асинх Процедура ЗапуститьМостыЧатаАсинх() Экспорт

	#Если Не ВебКлиент Тогда
	Для Каждого Адрес Из ИИА_ЧатВызовСервера.АдресаМостовACP() Цикл
		Попытка
			Ждать ЗапуститьМостАсинх(Адрес);
		Исключение
			// Ошибку запуска пользователь увидит в ответе чата: модель недоступна.
			Продолжить; // BSLLS:MissingCodeTryCatchEx-off
		КонецПопытки;
	КонецЦикла;
	#КонецЕсли

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Если Не ВебКлиент Тогда

// Каталог моста в профиле пользователя, общий для всех баз: порт у моста один.
// %LOCALAPPDATA%\IIA\acp-bridge\ - на уровень выше временного каталога, чтобы очистка Temp не меняла токен.
Функция КаталогМоста()

	Временный = КаталогВременныхФайлов();
	Разделитель = ПолучитьРазделительПути();
	Если Не СтрЗаканчиваетсяНа(Временный, Разделитель) Тогда
		Временный = Временный + Разделитель;
	КонецЕсли;
	Хвост = Разделитель + "Temp" + Разделитель;
	Если СтрЗаканчиваетсяНа(НРег(Временный), НРег(Хвост)) Тогда
		Основа = Лев(Временный, СтрДлина(Временный) - СтрДлина(Хвост) + 1);
	Иначе
		Основа = Временный;
	КонецЕсли;
	Возврат Основа + "IIA" + Разделитель + "acp-bridge" + Разделитель;

КонецФункции

// Порт из адреса моста; 0 - адрес не на этом компьютере или без порта.
Функция ПортМоста(АдресAPI)

	Адрес = НРег(СокрЛП(АдресAPI));
	Если Не СтрНачинаетсяС(Адрес, "http://") Тогда
		Возврат 0;
	КонецЕсли;
	Сервер = СтрРазделить(Сред(Адрес, 8), "/")[0];
	Части = СтрРазделить(Сервер, ":");
	Если Части.Количество() <> 2 Или (Части[0] <> "127.0.0.1" И Части[0] <> "localhost") Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Порт = Число(Части[1]);
	Исключение
		Возврат 0;
	КонецПопытки;
	Возврат ?(Порт > 0 И Порт < 65536 И Порт = Цел(Порт), Порт, 0);

КонецФункции

// Ответ моста на GET /v1/models с токеном из файла: Код 0 - мост не отвечает или токена нет.
Асинх Функция ОтветМостаАсинх(ФайлТокена, Порт)

	Ответ = Новый Структура("Код, Токен, Версия, Агенты", 0, "", "", Новый СписокЗначений);
	Файл = Новый Файл(ФайлТокена);
	Если Не Ждать Файл.СуществуетАсинх() Тогда
		Возврат Ответ;
	КонецЕсли;
	Документ = Новый ТекстовыйДокумент;
	Ждать Документ.ПрочитатьАсинх(ФайлТокена, КодировкаТекста.UTF8);
	Ответ.Токен = СокрЛП(Документ.ПолучитьТекст());
	Если ПустаяСтрока(Ответ.Токен) Тогда
		Возврат Ответ;
	КонецЕсли;
	Запрос = Новый HTTPЗапрос("/v1/models");
	Запрос.Заголовки.Вставить("Authorization", "Bearer " + Ответ.Токен);
	Соединение = Новый HTTPСоединение("127.0.0.1", Порт, , , , 5);
	Попытка
		ОтветHTTP = Соединение.Получить(Запрос);
	Исключение
		// Мост ещё не слушает порт.
		Возврат Ответ; // BSLLS:MissingCodeTryCatchEx-off
	КонецПопытки;
	Ответ.Код = ОтветHTTP.КодСостояния;
	Если Ответ.Код <> 200 Тогда
		Возврат Ответ;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ОтветHTTP.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
	Данные = ПрочитатьJSON(Чтение, Истина);
	Ответ.Версия = НРег(Строка(Данные.Получить("bridge")));
	Для Каждого Агент Из Данные.Получить("data") Цикл
		Ответ.Агенты.Добавить(Агент.Получить("id"), Строка(Агент.Получить("name")));
	КонецЦикла;
	Возврат Ответ;

КонецФункции

Функция РезультатПоОтвету(Результат, Ответ)

	Результат.Токен = Ответ.Токен;
	Результат.Агенты = Ответ.Агенты;
	Если Ответ.Агенты.Количество() = 0 Тогда
		Результат.Ошибка = НСтр("ru = 'На этом компьютере не найден ни один агент с поддержкой ACP: OpenCode, Qwen Code, Gemini CLI, Kimi Code, Cursor Agent, claude-agent-acp, codex-acp, zcode-acp-server.'");
	КонецЕсли;
	Возврат Результат;

КонецФункции

Процедура ОстановитьМост(Порт, Токен)

	Запрос = Новый HTTPЗапрос("/v1/shutdown");
	Запрос.Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	Запрос.УстановитьТелоИзСтроки("{}");
	Соединение = Новый HTTPСоединение("127.0.0.1", Порт, , , , 5);
	Попытка
		Соединение.ОтправитьДляОбработки(Запрос);
	Исключение
		// Мост уже завершился.
		Возврат; // BSLLS:MissingCodeTryCatchEx-off
	КонецПопытки;

КонецПроцедуры

// Команда Python 3.10+ без окна консоли: py-launcher (только у установленного Python), затем pythonw.
// Пусто - Python не найден. Найденная команда запоминается до конца сеанса.
Асинх Функция КомандаPythonАсинх()

	Ключ = "ИИА.МостACP.Python";
	Найденная = ПараметрыПриложения.Получить(Ключ);
	Если Найденная <> Неопределено Тогда
		Возврат Найденная;
	КонецЕсли;
	Проверка = " -I -c ""import sys; sys.exit(0 if sys.version_info >= (3, 10) else 3)""";
	Для Каждого Кандидат Из СтрРазделить("pyw -3|pythonw", "|") Цикл
		Попытка
			Код = Ждать ЗапуститьПриложениеАсинх(Кандидат + Проверка, , Истина);
		Исключение
			// Команды нет на этом компьютере: пробуем следующую.
			Продолжить; // BSLLS:MissingCodeTryCatchEx-off
		КонецПопытки;
		Если Код = 0 Тогда
			ПараметрыПриложения.Вставить(Ключ, Кандидат);
			Возврат Кандидат;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Пауза между проверками запуска: у клиента нет асинхронного ожидания по времени.
Асинх Функция ПаузаАсинх(Python)

	Возврат Ждать ЗапуститьПриложениеАсинх(Python + " -I -c ""import time; time.sleep(0.3)""", , Истина);

КонецФункции

#КонецЕсли

#КонецОбласти
