	|</style></head><body>" + Тело + "</body></html>";

КонецФункции

Функция ВремяHTML(Дата, ТолькоВремя = Ложь)

	Если Не ЗначениеЗаполнено(Дата) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Формат(Дата, ?(ТолькоВремя Или НачалоДня(Дата) = НачалоДня(ТекущаяДатаСеанса()),
		"ДФ=ЧЧ:мм:сс", "ДФ='дд.ММ.гггг ЧЧ:мм'"));

КонецФункции

// Текст реплики: без служебного блока подсказок ```suggest и разметки блока ```details, экранирование и жирный
// **текст** из markdown. Подробности в истории показываются развёрнутыми сразу после краткой части.
Функция ТекстHTML(Знач Текст)

	Позиция = СтрНайти(Текст, "```details");
	Если Позиция > 0 Тогда
		Хвост = Сред(Текст, Позиция + 10);
		Хвост = Сред(Хвост, СтрНайти(Хвост + Символы.ПС, Символы.ПС) + 1);
		Конец = СтрНайти(Хвост, "```");
		Текст = Лев(Текст, Позиция - 1) + ?(Конец = 0, Хвост, Лев(Хвост, Конец - 1) + Сред(Хвост, Конец + 3));
	КонецЕсли;

	Позиция = СтрНайти(Текст, "```suggest");
	Если Позиция > 0 Тогда
		Конец = СтрНайти(Сред(Текст, Позиция + 10), "```");
		Текст = СокрП(Лев(Текст, Позиция - 1)) + ?(Конец = 0, "", Сред(Текст, Позиция + 10 + Конец + 2));
	КонецЕсли;
	Результат = ЭкранироватьHTML(СокрЛП(Текст));
	Части = СтрРазделить(Результат, "**", Истина);
	Если Части.Количество() < 3 Тогда
		Возврат Результат;
	КонецЕсли;
	Для Индекс = 1 По Части.ВГраница() Цикл
		Если Индекс % 2 = 1 И Индекс < Части.ВГраница() Тогда
			Части[Индекс] = "<b>" + Части[Индекс] + "</b>";
		ИначеЕсли Индекс % 2 = 1 Тогда
			Части[Индекс] = "**" + Части[Индекс];
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, "");

КонецФункции

Функция ЭкранироватьHTML(Знач Текст)

	Текст = СтрЗаменить(Строка(Текст), "&", "&amp;");
	Текст = СтрЗаменить(Текст, "<", "&lt;");
	Текст = СтрЗаменить(Текст, ">", "&gt;");
	Возврат СтрЗаменить(Текст, "'", "&#39;");

КонецФункции

