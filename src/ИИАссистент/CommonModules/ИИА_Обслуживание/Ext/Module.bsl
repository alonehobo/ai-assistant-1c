// BSLLS:CommonModuleInvalidType-on
///////////////////////////////////////////////////////////////////////////////////////////////////////
// ИИ-ассистент: хранение диалогов, отзывы, очистка устаревших данных (план, раздел 4.9).
// Диалог принадлежит пользователю: читать и продолжать его может только автор.
// Тексты хранятся, если профиль пользователя не запрещает (флаг «Не хранить тексты диалогов»):
// тогда сохраняются только метаданные - роль, дата, идентификатор хода.
// /////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Проверяет владельца и состояние диалога перед исследованием.
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги, Неопределено - пустой допускает исследование без хранения.
// Возвращаемое значение:
//  Булево - диалог принадлежит текущему пользователю и не удалён.
Функция ДиалогДоступенДляИсследования(Диалог) Экспорт

	Если Не ЗначениеЗаполнено(Диалог) Тогда
		Возврат Истина;
	КонецЕсли;
	Если Не ДиалогТекущегоПользователя(Диалог) Тогда
		Возврат Ложь;
	КонецЕсли;
	// У роли ИИА_Пользователь нет права на справочник диалогов: пометка своего диалога читается привилегированно.
	УстановитьПривилегированныйРежим(Истина);
	ПометкаУдаления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Диалог, "ПометкаУдаления");
	УстановитьПривилегированныйРежим(Ложь);
	Возврат ПометкаУдаления = Ложь;

КонецФункции

// Возвращает исходный вопрос исследования по ссылке на реплику.
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги, Неопределено
//  НомерСообщения - Число - 0 означает последний вопрос.
// Возвращаемое значение:
//  Структура - Номер, Текст, Класс; пустая при отказе владельца или политики.
Функция ВопросИсследования(Диалог, НомерСообщения = 0) Экспорт

	Вопрос = Новый Структура("Номер, Текст, Класс", 0, "", 2);
	Если Не ЗначениеЗаполнено(Диалог) Или Не ДиалогДоступенДляИсследования(Диалог) Или Не ХранитьТексты() Тогда
		Возврат Вопрос;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|   С.НомерСообщения КАК Номер,
	|   С.Текст КАК Текст,
	|   С.КлассДанных КАК КлассДанных
	|ИЗ
	|   РегистрСведений.ИИА_СообщенияДиалогов КАК С
	|ГДЕ
	|   С.Диалог = &Диалог
	|   И С.Диалог.Пользователь = &Пользователь
	|   И С.Роль = ""user""
	|   И (&Номер = 0 ИЛИ С.НомерСообщения = &Номер)
	|УПОРЯДОЧИТЬ ПО
	|   С.НомерСообщения УБЫВ");
	Запрос.УстановитьПараметр("Диалог", Диалог);
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	Запрос.УстановитьПараметр("Номер", НомерСообщения);
	// Служебный регистр читается привилегированно (у роли ИИА_Пользователь нет прав); отбор по владельцу - в запросе.
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Вопрос.Номер = Выборка.Номер;
		Вопрос.Текст = Лев(ИИА_Периметр.ОчиститьТекст(Выборка.Текст), 8000);
		Вопрос.Класс = ИИА_КлассыДанных.ПодтвержденныйКласс(Выборка.КлассДанных);
	КонецЕсли;
	Возврат Вопрос;

КонецФункции

// Возвращает последнюю логическую контрольную точку своего диалога.
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги, Неопределено
// Возвращаемое значение:
//  Соответствие, Неопределено - versioned research, без сессии и текста исходников.
//  Проверку проекта, профиля, прав и свежих источников выполняет потребитель.
Функция КонтрольнаяТочкаИсследования(Диалог) Экспорт

	Если Не ЗначениеЗаполнено(Диалог) Или Не ДиалогДоступенДляИсследования(Диалог) Или Не ХранитьТексты() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|   С.Вложения КАК Вложения,
	|   С.КлассДанных КАК КлассДанных
	|ИЗ
	|   РегистрСведений.ИИА_СообщенияДиалогов КАК С
	|ГДЕ
	|   С.Диалог = &Диалог
	|   И С.Диалог.Пользователь = &Пользователь
	|   И С.Роль = ""research""
	|УПОРЯДОЧИТЬ ПО
	|   С.НомерСообщения УБЫВ");
	Запрос.УстановитьПараметр("Диалог", Диалог);
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	// Служебный регистр читается привилегированно (у роли ИИА_Пользователь нет прав); отбор по владельцу - в запросе.
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	Выборка = РезультатЗапроса.Выбрать();
	Если Не Выборка.Следующий() Или СтрДлина(Выборка.Вложения) > 20000 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Вложения = ОбщегоНазначения.JSONВЗначение(Выборка.Вложения);
	Исключение
		ЗаписьЖурналаРегистрации("ИИА.Исследование", УровеньЖурналаРегистрации.Предупреждение, , ,
			"CHECKPOINT_INVALID_JSON");
		Возврат Неопределено;
	КонецПопытки;
	Если ТипЗнч(Вложения) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Точка = Вложения.Получить("research");
	Если ТипЗнч(Точка) <> Тип("Соответствие") Или Точка.Получить("version") <> 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Точка.Вставить("class", Макс(1, ИИА_КлассыДанных.ПодтвержденныйКласс(Выборка.КлассДанных)));
	Возврат Точка;

КонецФункции

// Сохраняет контрольную точку независимо от успеха ответа, соблюдая политику хранения.
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги, Неопределено
//  Точка - Структура - version, project, profile, address, descriptors, reason, question_ref.
//  ИдентификаторХода - Строка
//  КлассДанных - Число - класс очищенных указателей, минимум К1.
// Возвращаемое значение:
//  Булево - сохранено; отказ владельца или политики не создаёт даже пустой записи.
Функция СохранитьКонтрольнуюТочкуИсследования(Диалог, Точка, ИдентификаторХода, КлассДанных) Экспорт

	Если Не ЗначениеЗаполнено(Диалог) Или Не ДиалогДоступенДляИсследования(Диалог) Или Не ХранитьТексты() Тогда
		Возврат Ложь;
	КонецЕсли;
	Вложения = ОбщегоНазначения.ЗначениеВJSON(Новый Структура("research", Точка));
	Если СтрДлина(Вложения) > 20000 Тогда
		Возврат Ложь;
	КонецЕсли;
	// Привилегированный режим включает и снимает при выходе сам СохранитьСообщение.
	Попытка
		СохранитьСообщение(Диалог, "research", "", ИдентификаторХода, , Макс(1, КлассДанных), Вложения);
	Исключение
		ЗаписьЖурналаРегистрации("ИИА.Исследование", УровеньЖурналаРегистрации.Предупреждение, , ,
			"CHECKPOINT_SAVE_FAILED");
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;

КонецФункции


// Сохраняет реплику диалога, создавая диалог при первой реплике.
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги, Неопределено
//  Роль - Строка - "user" или "assistant".
//  Текст - Строка - уже очищенный периметром текст.
//  ИдентификаторХода - Строка
//  Контекст - ЛюбаяСсылка, Неопределено - объект, из которого открыт чат.
//  КлассДанных - Число, Неопределено - 0..4; неизвестное значение хранится как К4.
//  Вложения - Строка - JSON интерактивных частей реплики.
//  Файлы - Массив из Структура, Неопределено - изображения и файлы вопроса: Имя, Вид ("image", "file"),
//          ТипMIME, ДвоичныеДанные. Хранятся сжатыми в ХранилищеЗначения вместе с текстом.
//  НомерСообщения - Число - возвращается номер сохранённой реплики.
//  ФайлыСохранены - Булево - возвращается Истина, если Файлы сохранены с репликой.
//
// Возвращаемое значение:
//  СправочникСсылка.ИИА_Диалоги
//
Функция СохранитьСообщение(Знач Диалог, Роль, Текст, ИдентификаторХода = "", Контекст = Неопределено,
	КлассДанных = Неопределено, Вложения = "", Файлы = Неопределено, НомерСообщения = 0, ФайлыСохранены = Ложь) Экспорт

	НомерСообщения = 0;
	ФайлыСохранены = Ложь;
	Пользователь = Пользователи.ТекущийПользователь();
	УстановитьПривилегированныйРежим(Истина);
	Хранить = ХранитьТексты();
	ХранитьФайлы = Хранить И Файлы <> Неопределено И Файлы.Количество() > 0;

	Если ЗначениеЗаполнено(Диалог) И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Диалог, "Пользователь") <> Пользователь Тогда
		Диалог = Неопределено; // чужой диалог не продолжаем
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Если ЗначениеЗаполнено(Диалог) Тогда
			Блокировка = Новый БлокировкаДанных;
			Блокировка.Добавить("Справочник.ИИА_Диалоги").УстановитьЗначение("Ссылка", Диалог);
			Блокировка.Заблокировать();
			ОбъектДиалога = Диалог.ПолучитьОбъект();
		Иначе
			ОбъектДиалога = Справочники.ИИА_Диалоги.СоздатьЭлемент();
			ОбъектДиалога.Пользователь = Пользователь;
			ОбъектДиалога.Создан = ТекущаяДатаСеанса();
			ОбъектДиалога.Наименование = ЗаголовокДиалога(Текст);
			Если ЗначениеЗаполнено(Контекст) Тогда
				Попытка
					ОбъектДиалога.Контекст = ПолучитьНавигационнуюСсылку(Контекст);
				// Необязательный контекст без навигации не раскрывается; сообщение сохраняется.
				Исключение // BSLLS:MissingCodeTryCatchEx-off
					ОбъектДиалога.Контекст = "";
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		ОбъектДиалога.Изменен = ТекущаяДатаСеанса();
		ОбъектДиалога.Записать();
		Диалог = ОбъектДиалога.Ссылка;

		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(МАКСИМУМ(С.НомерСообщения), 0) КАК Номер
		|ИЗ
		|	РегистрСведений.ИИА_СообщенияДиалогов КАК С
		|ГДЕ
		|	С.Диалог = &Диалог");
		Запрос.УстановитьПараметр("Диалог", Диалог);
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();

		Запись = РегистрыСведений.ИИА_СообщенияДиалогов.СоздатьМенеджерЗаписи();
		Запись.Диалог = Диалог;
		Запись.НомерСообщения = Выборка.Номер + 1;
		Запись.КлассДанных = ИИА_КлассыДанных.ЗначениеКласса(ИИА_КлассыДанных.ПодтвержденныйКласс(КлассДанных));
		Запись.Роль = Роль;
		Запись.Текст = ?(Хранить, Текст, НСтр("ru = '[текст не хранится по настройке профиля]'"));
		Запись.ДатаСообщения = ТекущаяДатаСеанса();
		Запись.ИдентификаторХода = ИдентификаторХода;
		Запись.Вложения = ?(Хранить, Вложения, "");
		Если ХранитьФайлы Тогда
			Запись.Файлы = Новый ХранилищеЗначения(Файлы, Новый СжатиеДанных(9));
		КонецЕсли;
		Запись.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	// Номер отдаётся только после фиксации: откаченная реплика не должна получить ссылки на файлы.
	НомерСообщения = Запись.НомерСообщения;
	ФайлыСохранены = ХранитьФайлы;
	Возврат Диалог;

КонецФункции

// Удаляет реплику диалога текущего пользователя - вопрос, ход по которому не запустился, - вместе с её файлами.
// Диалог, в котором не осталось реплик, удаляется.
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги
//  НомерСообщения - Число
//
// Возвращаемое значение:
//  Булево - Истина, если удалён и сам диалог.
//
Функция УдалитьСообщение(Диалог, НомерСообщения) Экспорт

	Пользователь = Пользователи.ТекущийПользователь();
	УстановитьПривилегированныйРежим(Истина);
	Если Не ЗначениеЗаполнено(Диалог) Или НомерСообщения = 0
		Или ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Диалог, "Пользователь") <> Пользователь Тогда
		Возврат Ложь;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Блокировка.Добавить("Справочник.ИИА_Диалоги").УстановитьЗначение("Ссылка", Диалог);
		Блокировка.Заблокировать();
		Набор = РегистрыСведений.ИИА_СообщенияДиалогов.СоздатьНаборЗаписей();
		Набор.Отбор.Диалог.Установить(Диалог);
		Набор.Отбор.НомерСообщения.Установить(НомерСообщения);
		Набор.Записать();

		// Пустой диалог удаляется, только если у него нет и записей очереди: ждущим сообщениям нужен диалог.
		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	С.НомерСообщения КАК НомерСообщения
		|ИЗ
		|	РегистрСведений.ИИА_СообщенияДиалогов КАК С
		|ГДЕ
		|	С.Диалог = &Диалог
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	О.ИдентификаторЗаписи КАК ИдентификаторЗаписи
		|ИЗ
		|	РегистрСведений.ИИА_ОчередьСообщений КАК О
		|ГДЕ
		|	О.Диалог = &Диалог");
		Запрос.УстановитьПараметр("Диалог", Диалог);
		Пакет = Запрос.ВыполнитьПакет();
		ДиалогУдален = Пакет[0].Пустой() И Пакет[1].Пустой();
		Если ДиалогУдален Тогда
			ИИА_Маскирование.УдалитьНомераДиалога(Диалог);
			Диалог.ПолучитьОбъект().Удалить();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат ДиалогУдален;

КонецФункции

// Диалоги текущего пользователя для боковой панели чата (до 50): закреплённые первыми, затем по дате изменения,
// без помеченных на удаление.
//
// Параметры:
//  Отбор - Строка - подстрока наименования или текста реплик; пусто - без отбора. Тексты реплик хранятся
//          замаскированными (псевдонимы вместо ФИО), поэтому поиск по ним идёт по замаскированному тексту.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Ссылка - СправочникСсылка.ИИА_Диалоги
//   * Наименование - Строка
//   * Изменен - Дата
//   * Закреплен - Булево
//
Функция ДиалогиДляПанели(Отбор = "") Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 50
	|	Д.Ссылка КАК Ссылка,
	|	Д.Наименование КАК Наименование,
	|	Д.Изменен КАК Изменен,
	|	Д.Закреплен КАК Закреплен
	|ИЗ
	|	Справочник.ИИА_Диалоги КАК Д
	|ГДЕ
	|	Д.Пользователь = &Пользователь
	|	И НЕ Д.ПометкаУдаления
	|	И Д.Ссылка В
	|			(ВЫБРАТЬ
	|				Н.Ссылка КАК Диалог
	|			ИЗ
	|				Справочник.ИИА_Диалоги КАК Н
	|			ГДЕ
	|				Н.Пользователь = &Пользователь
	|				И Н.Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""
	|
	|			ОБЪЕДИНИТЬ
	|
	|			ВЫБРАТЬ
	|				С.Диалог
	|			ИЗ
	|				РегистрСведений.ИИА_СообщенияДиалогов КАК С
	|			ГДЕ
	|				НЕ &БезОтбора
	|				И С.Диалог.Пользователь = &Пользователь
	|				И С.Роль <> ""research""
	|				И С.Текст ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~"")
	|
	|УПОРЯДОЧИТЬ ПО
	|	Закреплен УБЫВ,
	|	Изменен УБЫВ");
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	Запрос.УстановитьПараметр("БезОтбора", ПустаяСтрока(Отбор));
	Запрос.УстановитьПараметр("Шаблон", "%" + ОбщегоНазначения.СформироватьСтрокуДляПоискаВЗапросе(СокрЛП(Отбор)) + "%");
	УстановитьПривилегированныйРежим(Истина);
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Новый Структура("Ссылка, Наименование, Изменен, Закреплен",
			Выборка.Ссылка, Выборка.Наименование, Выборка.Изменен, Выборка.Закреплен));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Переименовывает диалог текущего пользователя. Дата изменения диалога не меняется.
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги
//  Наименование - Строка - очищается, см. ОчищенноеНаименование.
//
// Возвращаемое значение:
//  Булево - Ложь, если диалог чужой или наименование пустое.
//
Функция ПереименоватьДиалог(Диалог, Наименование) Экспорт

	НовоеНаименование = ОчищенноеНаименование(Наименование);
	Если ПустаяСтрока(НовоеНаименование) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ИзменитьДиалог(Диалог, Новый Структура("Наименование, НаименованиеЗадано", НовоеНаименование, Истина));

КонецФункции

// Закрепляет диалог текущего пользователя в панели или снимает закрепление. Дата изменения не меняется,
// срок хранения на закреплённые диалоги действует как на остальные.
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги
//  Закреплен - Булево
//
// Возвращаемое значение:
//  Булево - Ложь, если диалог чужой.
//
Функция ЗакрепитьДиалог(Диалог, Закреплен) Экспорт

	Возврат ИзменитьДиалог(Диалог, Новый Структура("Закреплен", Закреплен = Истина));

КонецФункции

// Помечает диалог текущего пользователя на удаление; физически его удаляет регламентное задание ИИА_Очистка.
// Журнал вызовов для аудита сохраняется.
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги
//
// Возвращаемое значение:
//  Булево - Ложь, если диалог чужой или занят: в нём идёт ход или есть ждущие сообщения.
//
Функция УдалитьДиалог(Диалог) Экспорт

	Если ИИА_ФоновыйХод.ДиалогЗанят(Диалог) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ИзменитьДиалог(Диалог, Новый Структура("ПометкаУдаления", Истина));

КонецФункции

// Создаёт пустой диалог текущего пользователя: у сообщения, поставленного в очередь в новом диалоге, должен быть
// диалог. Заголовок - по тексту сообщения, как у диалога, созданного первой репликой.
//
// Параметры:
//  Текст - Строка
//  Контекст - ЛюбаяСсылка, Неопределено - объект, из которого открыт чат.
//
// Возвращаемое значение:
//  СправочникСсылка.ИИА_Диалоги
//
Функция СоздатьДиалог(Текст, Контекст = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	ОбъектДиалога = Справочники.ИИА_Диалоги.СоздатьЭлемент();
	ОбъектДиалога.Пользователь = Пользователи.ТекущийПользователь();
	ОбъектДиалога.Создан = ТекущаяДатаСеанса();
	ОбъектДиалога.Изменен = ОбъектДиалога.Создан;
	ОбъектДиалога.Наименование = ЗаголовокДиалога(Текст);
	Если ЗначениеЗаполнено(Контекст) Тогда
		Попытка
			ОбъектДиалога.Контекст = ПолучитьНавигационнуюСсылку(Контекст);
		// Необязательный контекст без навигации не раскрывается; диалог создаётся.
		Исключение // BSLLS:MissingCodeTryCatchEx-off
			ОбъектДиалога.Контекст = "";
		КонецПопытки;
	КонецЕсли;
	ОбъектДиалога.Записать();
	Возврат ОбъектДиалога.Ссылка;

КонецФункции

// Заменяет последнюю реплику ассистента в диалоге текущего пользователя (перегенерация, продолжение ответа).
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги
//  НомерСообщения - Число - реплика ассистента, последняя в диалоге.
//  Текст - Строка - уже очищенный периметром текст.
//  ИдентификаторХода - Строка
//  КлассДанных - Число, Неопределено
//  Вложения - Строка - JSON интерактивных частей реплики.
//
// Возвращаемое значение:
//  Булево - Ложь, если диалог чужой или реплика не последний ответ ассистента.
//
Функция ОбновитьСообщение(Диалог, НомерСообщения, Текст, ИдентификаторХода, КлассДанных, Вложения) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Если Не ДиалогТекущегоПользователя(Диалог) Тогда
		Возврат Ложь;
	КонецЕсли;
	Хранить = ХранитьТексты();

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Блокировка.Добавить("Справочник.ИИА_Диалоги").УстановитьЗначение("Ссылка", Диалог);
		Блокировка.Заблокировать();

		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(МАКСИМУМ(С.НомерСообщения), 0) КАК Номер
		|ИЗ
		|	РегистрСведений.ИИА_СообщенияДиалогов КАК С
		|ГДЕ
		|	С.Диалог = &Диалог
		|	И С.Роль <> ""research""");
		Запрос.УстановитьПараметр("Диалог", Диалог);
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Запись = РегистрыСведений.ИИА_СообщенияДиалогов.СоздатьМенеджерЗаписи();
		Запись.Диалог = Диалог;
		Запись.НомерСообщения = НомерСообщения;
		Запись.Прочитать();
		Обновлено = Выборка.Номер = НомерСообщения И Запись.Выбран() И Запись.Роль = "assistant";
		Если Обновлено Тогда
			Запись.КлассДанных = ИИА_КлассыДанных.ЗначениеКласса(ИИА_КлассыДанных.ПодтвержденныйКласс(КлассДанных));
			Запись.Текст = ?(Хранить, Текст, НСтр("ru = '[текст не хранится по настройке профиля]'"));
			Запись.ДатаСообщения = ТекущаяДатаСеанса();
			Запись.ИдентификаторХода = ИдентификаторХода;
			Запись.Вложения = ?(Хранить, Вложения, "");
			Запись.Оценка = 0;
			Запись.Записать();
			ОбъектДиалога = Диалог.ПолучитьОбъект();
			ОбъектДиалога.Изменен = ТекущаяДатаСеанса();
			ОбъектДиалога.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Обновлено;

КонецФункции

// Наименование, введённое пользователем или предложенное моделью: переводы строк и табуляция - пробелом,
// без управляющих символов, не длиннее 150 символов.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ОчищенноеНаименование(Знач Текст) Экспорт

	Знаки = Новый Массив;
	Для Номер = 1 По СтрДлина(Текст) Цикл
		Код = КодСимвола(Текст, Номер);
		Если Код = 9 Или Код = 10 Или Код = 13 Тогда
			Знаки.Добавить(" ");
		ИначеЕсли Код >= 32 И Код <> 127 Тогда
			Знаки.Добавить(Сред(Текст, Номер, 1));
		КонецЕсли;
	КонецЦикла;
	Возврат Лев(СокрЛП(СтрСоединить(Знаки, "")), 150);

КонецФункции

// Навигационная ссылка объекта, из которого был открыт чат диалога текущего пользователя.
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги
//
// Возвращаемое значение:
//  Строка - пусто, если контекста нет или диалог чужой.
//
Функция КонтекстДиалога(Диалог) Экспорт

	Если Не ЗначениеЗаполнено(Диалог) Тогда
		Возврат "";
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Диалог, "Пользователь, Контекст");
	Если Реквизиты.Пользователь <> Пользователи.ТекущийПользователь() Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Реквизиты.Контекст);

КонецФункции

// Реплики диалога текущего пользователя.
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги
//
// Возвращаемое значение:
//  Массив из Структура - Роль, Текст, КлассДанных, ДатаСообщения, Вложения, НомерСообщения, ИдентификаторХода.
//    Пустой, если диалог чужой.
//
Функция СообщенияДиалога(Диалог) Экспорт

	Результат = Новый Массив;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	С.Роль КАК Роль,
	|	С.Текст КАК Текст,
	|	С.КлассДанных КАК КлассДанных,
	|	С.ДатаСообщения КАК ДатаСообщения,
	|	С.Вложения КАК Вложения,
	|	С.НомерСообщения КАК НомерСообщения,
	|	С.ИдентификаторХода КАК ИдентификаторХода
	|ИЗ
	|	РегистрСведений.ИИА_СообщенияДиалогов КАК С
	|ГДЕ
	|	С.Диалог = &Диалог
	|	И С.Роль <> ""research""
	|	И С.Диалог.Пользователь = &Пользователь
	|
	|УПОРЯДОЧИТЬ ПО
	|	С.НомерСообщения");
	Запрос.УстановитьПараметр("Диалог", Диалог);
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Новый Структура("Роль, Текст, КлассДанных, ДатаСообщения, Вложения, НомерСообщения, ИдентификаторХода",
			Выборка.Роль, Выборка.Текст, ИИА_КлассыДанных.ПодтвержденныйКласс(Выборка.КлассДанных), Выборка.ДатаСообщения,
			Выборка.Вложения, Выборка.НомерСообщения, Выборка.ИдентификаторХода));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Возвращает ограниченный технический контекст успешных инструментов своего диалога.
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги - диалог текущего пользователя.
// Возвращаемое значение:
//  Массив из Структура - Имя, Параметры. Значения отборов и результаты не восстанавливаются.
Функция КонтекстИнструментовДиалога(Диалог) Экспорт

	Результат = Новый Массив;
	// Свой и не помеченный на удаление диалог (служебный справочник читается привилегированно внутри проверки).
	Если Не ЗначениеЗаполнено(Диалог) Или Не ДиалогДоступенДляИсследования(Диалог) Или Не ХранитьТексты() Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 30
	|	Ж.Инструмент КАК Инструмент,
	|	Ж.Аргументы КАК Аргументы
	|ИЗ
	|	РегистрСведений.ИИА_ЖурналВызовов КАК Ж
	|ГДЕ
	|	Ж.Диалог = &Диалог
	|	И Ж.Пользователь = &Пользователь
	|	И Ж.Событие = ""Инструмент""
	|	И Ж.Итог = ""OK""
	|	И Ж.Инструмент В (""describe_metadata"", ""read_register"")
	|УПОРЯДОЧИТЬ ПО
	|	Ж.МоментВызова УБЫВ");
	Запрос.УстановитьПараметр("Диалог", Диалог);
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	БылПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		РезультатЗапроса = Запрос.Выполнить();
		Записи = РезультатЗапроса.Выгрузить();
	Исключение
		ЗаписьЖурналаРегистрации("ИИА.ТехническийКонтекст", УровеньЖурналаРегистрации.Предупреждение, , ,
			НСтр("ru = 'Не удалось прочитать технический контекст диалога.'"));
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
		Возврат Результат;
	КонецПопытки;
	УстановитьПривилегированныйРежим(БылПривилегированныйРежим);

	Имена = Новый Соответствие;
	Для Каждого Запись Из Записи Цикл
		Если СтрДлина(Запись.Аргументы) > 16000 Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Аргументы = ОбщегоНазначения.JSONВЗначение(Запись.Аргументы);
		Исключение
			ЗаписьЖурналаРегистрации("ИИА.ТехническийКонтекст", УровеньЖурналаРегистрации.Предупреждение, , ,
				НСтр("ru = 'Некорректный JSON контекста пропущен.'"));
			Продолжить;
		КонецПопытки;
		Если ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Имя = Аргументы.Получить(?(Запись.Инструмент = "describe_metadata", "name", "register"));
		Если ТипЗнч(Имя) <> Тип("Строка") Или СтрДлина(Имя) > 200 Или Имена.Получить(Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Параметры = Новый Соответствие;
		Если Запись.Инструмент = "read_register" Тогда
			Операция = Аргументы.Получить("operation");
			Если СтрРазделить("balances,turnovers,slice_last", ",").Найти(Операция) <> Неопределено Тогда
				Параметры.Вставить("operation", Операция);
			КонецЕсли;
			Для Каждого Ключ Из СтрРазделить("resources,group_by", ",") Цикл
				Поля = Аргументы.Получить(Ключ);
				Если ТипЗнч(Поля) = Тип("Массив") И Поля.Количество() <= 20 Тогда
					ИменаПолей = Новый Массив;
					Для Каждого Поле Из Поля Цикл
						Если ТипЗнч(Поле) = Тип("Строка") И СтрДлина(Поле) <= 100 Тогда
							ИменаПолей.Добавить(Поле);
						КонецЕсли;
					КонецЦикла;
					Параметры.Вставить(Ключ, ИменаПолей);
				КонецЕсли;
			КонецЦикла;
			Отборы = Аргументы.Получить("filters");
			Если ТипЗнч(Отборы) = Тип("Соответствие") И Отборы.Количество() <= 20 Тогда
				ПоляОтборов = Новый Массив;
				Для Каждого Отбор Из Отборы Цикл
					Если СтрДлина(Отбор.Ключ) <= 100 Тогда
						ПоляОтборов.Добавить(Отбор.Ключ);
					КонецЕсли;
				КонецЦикла;
				Параметры.Вставить("filter_fields", ПоляОтборов);
			КонецЕсли;
			Момент = ДатаКонтекста(Аргументы.Получить("as_of"));
			Если Не ПустаяСтрока(Момент) Тогда
				Параметры.Вставить("as_of", Момент);
			КонецЕсли;
			Период = Аргументы.Получить("period");
			Если ТипЗнч(Период) = Тип("Соответствие") Тогда
				НачалоПериода = ДатаКонтекста(Период.Получить("from"));
				КонецПериода = ДатаКонтекста(Период.Получить("to"));
				Если Не ПустаяСтрока(НачалоПериода) И Не ПустаяСтрока(КонецПериода) Тогда
					Параметры.Вставить("period", Новый Структура("from, to", НачалоПериода, КонецПериода));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Имена.Вставить(Имя, Истина);
		Результат.Добавить(Новый Структура("Имя, Параметры", Имя, Параметры));
		Если Результат.Количество() >= 3 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции
// Изображения и файлы реплики диалога текущего пользователя (см. СохранитьСообщение).
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги
//  НомерСообщения - Число
//
// Возвращаемое значение:
//  Массив из Структура - Имя, Вид, ТипMIME, ДвоичныеДанные. Пустой, если файлов нет или диалог чужой.
//
Функция ФайлыСообщения(Диалог, НомерСообщения) Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	С.Файлы КАК Файлы
	|ИЗ
	|	РегистрСведений.ИИА_СообщенияДиалогов КАК С
	|ГДЕ
	|	С.Диалог = &Диалог
	|	И С.НомерСообщения = &НомерСообщения
	|	И С.Диалог.Пользователь = &Пользователь");
	Запрос.УстановитьПараметр("Диалог", Диалог);
	Запрос.УстановитьПараметр("НомерСообщения", НомерСообщения);
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Файлы = Выборка.Файлы.Получить();
	Возврат ?(ТипЗнч(Файлы) = Тип("Массив"), Файлы, Новый Массив);

КонецФункции

// Возвращает последние десять реплик JSON-истории с подтверждёнными классами для агента.
//
// Параметры:
//  ИсторияJSON - Строка - массив role, text, class.
//
// Возвращаемое значение:
//  Массив из Структура - Роль, Текст, КлассДанных.
//
Функция ИсторияИзJSON(ИсторияJSON) Экспорт

	Результат = Новый Массив;
	Записи = ОбщегоНазначения.JSONВЗначение(ИсторияJSON);
	Если ТипЗнч(Записи) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;
	Для Индекс = Макс(0, Записи.Количество() - 10) По Записи.ВГраница() Цикл
		Запись = Записи[Индекс];
		Если ТипЗнч(Запись) = Тип("Соответствие") Тогда
			Результат.Добавить(Новый Структура("Роль, Текст, КлассДанных",
				Запись.Получить("role"), Запись.Получить("text"),
				ИИА_КлассыДанных.ПодтвержденныйКласс(Запись.Получить("class"))));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Записывает оценку последнего ответа диалога и событие отзыва в журнал.
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги, Неопределено
//  ИдентификаторХода - Строка
//  Оценка - Строка - "up" или "down".
//
Процедура ЗаписатьОтзыв(Диалог, ИдентификаторХода, Оценка) Экспорт

	Пользователь = Пользователи.ТекущийПользователь();
	УстановитьПривилегированныйРежим(Истина);
	Значение = ?(Оценка = "up", 1, 2);

	Если ЗначениеЗаполнено(Диалог) И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Диалог, "Пользователь") = Пользователь Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	С.НомерСообщения КАК НомерСообщения
		|ИЗ
		|	РегистрСведений.ИИА_СообщенияДиалогов КАК С
		|ГДЕ
		|	С.Диалог = &Диалог
		|	И С.Роль = ""assistant""
		|	И (С.ИдентификаторХода = &Ход ИЛИ &Ход = """")
		|
		|УПОРЯДОЧИТЬ ПО
		|	С.НомерСообщения УБЫВ");
		Запрос.УстановитьПараметр("Диалог", Диалог);
		Запрос.УстановитьПараметр("Ход", ИдентификаторХода);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Запись = РегистрыСведений.ИИА_СообщенияДиалогов.СоздатьМенеджерЗаписи();
			Запись.Диалог = Диалог;
			Запись.НомерСообщения = Выборка.НомерСообщения;
			Запись.Прочитать();
			Если Запись.Выбран() Тогда
				Запись.Оценка = Значение;
				Запись.Записать();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Запись = РегистрыСведений.ИИА_ЖурналВызовов.СоздатьМенеджерЗаписи();
	Запись.ИдентификаторЗаписи = Строка(Новый УникальныйИдентификатор);
	Запись.МоментВызова = ТекущаяУниверсальнаяДата();
	Запись.Пользователь = Пользователь;
	Запись.ИдентификаторХода = ИдентификаторХода;
	Запись.Диалог = ?(ЗначениеЗаполнено(Диалог), Диалог, Неопределено);
	Запись.Событие = "Отзыв";
	Запись.Итог = ?(Значение = 1, "up", "down");
	Запись.Записать();

КонецПроцедуры

// Расход токенов текущего пользователя за сегодня по журналу.
//
// Возвращаемое значение:
//  Число
//
Функция ТокеновЗаСегодня() Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Ж.ТокеныВход + Ж.ТокеныВыход), 0) КАК Токенов
	|ИЗ
	|	РегистрСведений.ИИА_ЖурналВызовов КАК Ж
	|ГДЕ
	|	Ж.Пользователь = &Пользователь
	|	И Ж.МоментВызова >= &Начало
	|	И Ж.Событие = ""ВызовМодели""");
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	// Журнал хранит универсальное время; сутки считаем по часовому поясу сеанса пользователя.
	Запрос.УстановитьПараметр("Начало", УниверсальноеВремя(НачалоДня(ТекущаяДатаСеанса()), ЧасовойПоясСеанса()));
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Токенов;

КонецФункции

// Дневной лимит токенов из профиля пользователя; 0 - без лимита.
//
// Возвращаемое значение:
//  Число
//
Функция ЛимитТокеновВДень() Экспорт

	Профиль = ИИА_ПрофилиДоступа.ЭффективныйПрофиль(Пользователи.ТекущийПользователь());
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		Возврат 0;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Профиль, "ЛимитТокеновВДень");

КонецФункции

// Обработчик регламентного задания ИИА_Очистка: удаляет диалоги, помеченные пользователем на удаление, а также
// диалоги (в том числе закреплённые) и записи журнала старше срока хранения. Без срока хранения - только помеченные.
//
Процедура Очистка() Экспорт

	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.ИИА_Очистка);
	УстановитьПривилегированныйРежим(Истина);
	СрокДней = Константы.ИИА_СрокХраненияДней.Получить();
	// Одна граница для диалогов и журнала: сдвиг часового пояса несущественен при сроке в днях.
	Граница = ?(СрокДней > 0, ТекущаяДатаСеанса() - СрокДней * 86400, Дата(1, 1, 1));

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Д.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИИА_Диалоги КАК Д
	|ГДЕ
	|	(Д.Изменен < &Граница
	|			ИЛИ Д.ПометкаУдаления)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 100000
	|	Ж.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
	|	Ж.МоментВызова КАК МоментВызова
	|ИЗ
	|	РегистрСведений.ИИА_ЖурналВызовов КАК Ж
	|ГДЕ
	|	Ж.МоментВызова < &Граница");
	Запрос.УстановитьПараметр("Граница", Граница);
	Пакет = Запрос.ВыполнитьПакет();

	// Состояния ходов и очередь удаляемых диалогов, завершённые состояния старше суток.
	ИИА_ФоновыйХод.ОчиститьРегистры(Пакет[0].Выгрузить().ВыгрузитьКолонку("Ссылка"));

	Выборка = Пакет[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Набор = РегистрыСведений.ИИА_СообщенияДиалогов.СоздатьНаборЗаписей();
		Набор.Отбор.Диалог.Установить(Выборка.Ссылка);
		Набор.Записать();
		ИИА_Маскирование.УдалитьНомераДиалога(Выборка.Ссылка);
		ОбъектДиалога = Выборка.Ссылка.ПолучитьОбъект();
		ОбъектДиалога.Удалить();
	КонецЦикла;

	Измерения = ИзмеренияЖурнала();
	Выборка = Пакет[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Набор = РегистрыСведений.ИИА_ЖурналВызовов.СоздатьНаборЗаписей();
		Для Каждого Измерение Из Измерения Цикл
			Набор.Отбор[Измерение].Установить(Выборка[Измерение]);
		КонецЦикла;
		Набор.Записать();
	КонецЦикла;

КонецПроцедуры

// HTML-лента диалога для администратора: реплики по времени, под ответом - шаги хода из журнала
// (инструменты, итог, длительность, токены, ошибки). Ходы без ответа (ошибки) тоже показываются.
// Тексты раскрываются: псевдонимы заменяются именами.
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги
//
// Возвращаемое значение:
//  Строка - HTML-документ.
//
Функция HTMLДиалога(Диалог) Экспорт

	Если Не ЗначениеЗаполнено(Диалог) Тогда
		Возврат ОберткаHTMLДиалога("<p class='empty'>" + НСтр("ru = 'Выберите диалог в списке.'") + "</p>");
	КонецЕсли;
	Если Не ПравоДоступа("Просмотр", Метаданные.РегистрыСведений.ИИА_СообщенияДиалогов) Тогда
		Возврат ОберткаHTMLДиалога("<p class='empty'>" + НСтр("ru = 'Недостаточно прав для просмотра сообщений.'") + "</p>");
	КонецЕсли;
	ЕстьЖурнал = ПравоДоступа("Просмотр", Метаданные.РегистрыСведений.ИИА_ЖурналВызовов);

	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	С.НомерСообщения КАК Номер,
	|	С.Роль КАК Роль,
	|	С.Текст КАК Текст,
	|	С.ДатаСообщения КАК Дата,
	|	С.ИдентификаторХода КАК Ход,
	|	С.Оценка КАК Оценка
	|ИЗ
	|	РегистрСведений.ИИА_СообщенияДиалогов КАК С
	|ГДЕ
	|	С.Диалог = &Диалог
	|	И С.Роль <> ""research""
	|
	|УПОРЯДОЧИТЬ ПО
	|	С.НомерСообщения
	|;
	|ВЫБРАТЬ
	|	Ж.ИдентификаторХода КАК Ход,
	|	Ж.МоментВызова КАК Момент,
	|	Ж.Событие КАК Событие,
	|	Ж.Инструмент КАК Инструмент,
	|	Ж.Итог КАК Итог,
	|	Ж.Длительность КАК Длительность,
	|	Ж.Строк КАК Строк,
	|	Ж.ТокеныВход КАК ТокеныВход,
	|	Ж.ТокеныВыход КАК ТокеныВыход,
	|	Ж.Инцидент КАК Инцидент,
	|	ВЫРАЗИТЬ(Ж.Аргументы КАК СТРОКА(300)) КАК Аргументы,
	|	ВЫРАЗИТЬ(Ж.Подробности КАК СТРОКА(500)) КАК Подробности
	|ИЗ
	|	РегистрСведений.ИИА_ЖурналВызовов КАК Ж
	|ГДЕ
	|	Ж.Диалог = &Диалог
	|	И &ЕстьЖурнал
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ж.МоментВызова");
	Запрос.УстановитьПараметр("Диалог", Диалог);
	Запрос.УстановитьПараметр("ЕстьЖурнал", ЕстьЖурнал);
	Результаты = Запрос.ВыполнитьПакет();
	Сообщения = Результаты[0].Выгрузить();
	Вызовы = Результаты[1].Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);

	// Ходы: идентификатор -> вызовы; начало хода - в местном времени для упорядочивания с репликами.
	Ходы = Новый Соответствие;
	ПорядокХодов = Новый Массив;
	Для Каждого Вызов Из Вызовы Цикл
		Если Ходы.Получить(Вызов.Ход) = Неопределено Тогда
			Ходы.Вставить(Вызов.Ход, Новый Массив);
			ПорядокХодов.Добавить(Вызов.Ход);
		КонецЕсли;
		Ходы.Получить(Вызов.Ход).Добавить(Вызов);
	КонецЦикла;
	ХодыСОтветом = Новый Соответствие;
	Для Каждого Сообщение Из Сообщения Цикл
		Если ЗначениеЗаполнено(Сообщение.Ход) Тогда
			ХодыСОтветом.Вставить(Сообщение.Ход, Истина);
		КонецЕсли;
	КонецЦикла;

	Лента = Новый ТаблицаЗначений;
	Лента.Колонки.Добавить("Дата");
	Лента.Колонки.Добавить("Порядок");
	Лента.Колонки.Добавить("HTML");
	Для Каждого Сообщение Из Сообщения Цикл
		ЭлементЛенты = Лента.Добавить();
		ЭлементЛенты.Дата = Сообщение.Дата;
		ЭлементЛенты.Порядок = Сообщение.Номер * 2;
		ЭлементЛенты.HTML = HTMLРеплики(Сообщение, Ходы.Получить(Сообщение.Ход));
	КонецЦикла;
	Для Каждого Ход Из ПорядокХодов Цикл
		Если ХодыСОтветом.Получить(Ход) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ВызовыХода = Ходы.Получить(Ход);
		ЭлементЛенты = Лента.Добавить();
		ЭлементЛенты.Дата = МестноеВремя(ВызовыХода[0].Момент, ЧасовойПоясСеанса());
		ЭлементЛенты.Порядок = 0;
		ЭлементЛенты.HTML = "<div class='msg orphan'><div class='role'>" + НСтр("ru = 'Ход без ответа'") + " <span class='time'>"
			+ ВремяHTML(ЭлементЛенты.Дата) + "</span></div>" + HTMLХода(ВызовыХода, Истина) + "</div>";
	КонецЦикла;
	Лента.Сортировать("Дата, Порядок");

	Части = Новый Массив;
	Для Каждого ЭлементЛенты Из Лента Цикл
		Части.Добавить(ЭлементЛенты.HTML);
	КонецЦикла;
	Если Части.Количество() = 0 Тогда
		Части.Добавить("<p class='empty'>" + НСтр("ru = 'В диалоге нет сообщений.'") + "</p>");
	КонецЕсли;
	Возврат ОберткаHTMLДиалога(СтрСоединить(Части, Символы.ПС));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Только каноническая календарная дата может попасть из журнала в контекст модели.
Функция ДатаКонтекста(Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) <> 10
		Или Сред(Значение, 5, 1) <> "-" Или Сред(Значение, 8, 1) <> "-" Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Момент = Дата(Число(Лев(Значение, 4)), Число(Сред(Значение, 6, 2)), Число(Прав(Значение, 2)));
		Если Формат(Момент, "ДФ=yyyy-MM-dd") = Значение Тогда
			Возврат Значение;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ИИА.ТехническийКонтекст", УровеньЖурналаРегистрации.Предупреждение, , ,
			НСтр("ru = 'Некорректная дата контекста пропущена.'"));
		Возврат "";
	КонецПопытки;
	Возврат "";

КонецФункции
Функция ХранитьТексты()

	Профиль = ИИА_ПрофилиДоступа.ЭффективныйПрофиль(Пользователи.ТекущийПользователь());
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		Возврат Истина;
	КонецЕсли;
	// Профиль доступа - служебный справочник без прав у роли ИИА_Пользователь: флаг своего профиля читается
	// привилегированно.
	УстановитьПривилегированныйРежим(Истина);
	НеХранить = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Профиль, "НеХранитьТекстыДиалогов");
	УстановитьПривилегированныйРежим(Ложь);
	Возврат НеХранить = Ложь; // Null или битая ссылка - не хранить (безопасный отказ)

КонецФункции

Функция ДиалогТекущегоПользователя(Диалог)

	Если Не ЗначениеЗаполнено(Диалог) Или ТипЗнч(Диалог) <> Тип("СправочникСсылка.ИИА_Диалоги") Тогда
		Возврат Ложь;
	КонецЕсли;
	// У роли ИИА_Пользователь нет права на справочник диалогов: владелец читается привилегированно.
	УстановитьПривилегированныйРежим(Истина);
	ВладелецДиалога = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Диалог, "Пользователь");
	УстановитьПривилегированныйРежим(Ложь);
	Возврат ВладелецДиалога = Пользователи.ТекущийПользователь();

КонецФункции

// Меняет реквизиты диалога текущего пользователя без изменения даты изменения.
Функция ИзменитьДиалог(Диалог, Значения)

	УстановитьПривилегированныйРежим(Истина);
	Если Не ДиалогТекущегоПользователя(Диалог) Тогда
		Возврат Ложь;
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Блокировка.Добавить("Справочник.ИИА_Диалоги").УстановитьЗначение("Ссылка", Диалог);
		Блокировка.Заблокировать();
		ОбъектДиалога = Диалог.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(ОбъектДиалога, Значения);
		ОбъектДиалога.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Истина;

КонецФункции

Функция ЗаголовокДиалога(Текст)

	Заголовок = СокрЛП(СтрЗаменить(СтрЗаменить(Текст, Символы.ПС, " "), Символы.ВК, ""));
	Если Не ХранитьТексты() Или ПустаяСтрока(Заголовок) Тогда
		Возврат СтрШаблон(НСтр("ru = 'Диалог от %1'"), Формат(ТекущаяДатаСеанса(), "ДЛФ=DT"));
	КонецЕсли;
	Возврат ?(СтрДлина(Заголовок) > 80, Лев(Заголовок, 77) + "...", Заголовок);

КонецФункции

Функция ИзмеренияЖурнала()

	Измерения = Новый Массив;
	Для Каждого Измерение Из Метаданные.РегистрыСведений.ИИА_ЖурналВызовов.Измерения Цикл
		Измерения.Добавить(Измерение.Имя);
	КонецЦикла;
	Возврат Измерения;

КонецФункции


Функция HTMLРеплики(Сообщение, ВызовыХода)

	ЭтоОтвет = Сообщение.Роль = "assistant";
	Заголовок = ?(ЭтоОтвет, НСтр("ru = 'Ассистент'"), НСтр("ru = 'Пользователь'"));
	Оценка = "";
	Если Сообщение.Оценка = 1 Тогда
		Оценка = " <span class='ok'>" + НСтр("ru = 'полезно'") + "</span>";
	ИначеЕсли Сообщение.Оценка = 2 Тогда
		Оценка = " <span class='bad'>" + НСтр("ru = 'неверно'") + "</span>";
	КонецЕсли;
	HTML = "<div class='msg " + ?(ЭтоОтвет, "assistant", "user") + "'><div class='role'>" + Заголовок
		+ " <span class='time'>" + ВремяHTML(Сообщение.Дата) + "</span>" + Оценка + "</div>"
		+ "<div class='text'>" + ТекстHTML(ИИА_Маскирование.ДляПользователя(Сообщение.Текст, , Ложь)) + "</div>";
	Если ВызовыХода <> Неопределено Тогда
		HTML = HTML + HTMLХода(ВызовыХода, Ложь);
	КонецЕсли;
	Возврат HTML + "</div>";

КонецФункции

Функция HTMLХода(Вызовы, Раскрыть)

	Длительность = 0;
	Токены = 0;
	Ошибок = 0;
	Скрытий = 0;
	Строки = Новый Массив;
	Для Каждого Вызов Из Вызовы Цикл
		Длительность = Длительность + Вызов.Длительность;
		Токены = Токены + Вызов.ТокеныВход + Вызов.ТокеныВыход;
		ЭтоОшибка = Не (Вызов.Итог = "OK" Или Вызов.Итог = "up" Или Вызов.Итог = "down");
		// Инцидент с итогом OK - перед отправкой модели скрыты данные: не сбой, а предупреждение.
		ЭтоПредупреждение = Не ЭтоОшибка И Вызов.Инцидент;
		Если ЭтоОшибка Тогда
			Ошибок = Ошибок + 1;
		ИначеЕсли ЭтоПредупреждение Тогда
			Скрытий = Скрытий + 1;
		КонецЕсли;
		Что = ?(ЗначениеЗаполнено(Вызов.Инструмент), Вызов.Инструмент, Вызов.Событие);
		Подробности = ?(ЭтоОшибка Или Не ЗначениеЗаполнено(Вызов.Инструмент), Вызов.Подробности, Вызов.Аргументы);
		Строки.Добавить("<tr" + ?(ЭтоОшибка, " class='err'", ?(ЭтоПредупреждение, " class='warn'", "")) + "><td>"
			+ ВремяHTML(МестноеВремя(Вызов.Момент, ЧасовойПоясСеанса()), Истина) + "</td><td>" + ЭкранироватьHTML(Что)
			+ "</td><td>" + ЭкранироватьHTML(Вызов.Итог) + "</td><td class='num'>"
			+ Формат(Вызов.Длительность, "ЧДЦ=1; ЧН=0") + "</td><td class='num'>"
			+ ?(Вызов.ТокеныВход + Вызов.ТокеныВыход = 0, "", Формат(Вызов.ТокеныВход, "ЧН=0") + " / " + Формат(Вызов.ТокеныВыход, "ЧН=0"))
			+ "</td><td class='det'>" + ЭкранироватьHTML(ИИА_Маскирование.ДляПользователя(Подробности, , Ложь)) + "</td></tr>");
	КонецЦикла;
	Сводка = СтрШаблон(НСтр("ru = 'Ход: шагов %1, %2 с, токенов %3'"), Вызовы.Количество(),
		Формат(Длительность, "ЧДЦ=0; ЧН=0"), Формат(Токены, "ЧН=0"))
		+ ?(Ошибок > 0, " - <span class='bad'>" + СтрШаблон(НСтр("ru = 'ошибок: %1'"), Ошибок) + "</span>", "")
		+ ?(Скрытий > 0, " - <span class='hid'>" + СтрШаблон(НСтр("ru = 'со скрытыми данными: %1'"), Скрытий) + "</span>", "");
	Возврат "<details" + ?(Раскрыть Или Ошибок > 0, " open", "") + "><summary>" + Сводка + "</summary>"
		+ "<table><tr><th>" + НСтр("ru = 'Время'") + "</th><th>" + НСтр("ru = 'Шаг'") + "</th><th>"
		+ НСтр("ru = 'Итог'") + "</th><th>" + НСтр("ru = 'Сек'") + "</th><th>" + НСтр("ru = 'Токены'") + "</th><th>"
		+ НСтр("ru = 'Подробности'") + "</th></tr>" + СтрСоединить(Строки, "") + "</table></details>";

КонецФункции

Функция ОберткаHTMLДиалога(Тело)

	Возврат "<!DOCTYPE html><html><head><meta charset='utf-8'><style>
	|body{margin:0;padding:12px;background:#f6f7f9;color:#1f2328;font:13px/1.5 Arial,'Segoe UI',sans-serif}
	|.msg{margin:0 0 10px;padding:8px 12px;border-radius:10px;border:1px solid #e3e7ec;background:#fff}
