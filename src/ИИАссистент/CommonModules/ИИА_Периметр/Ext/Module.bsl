// Тексты запросов контрагентов и партнёров - физлиц и ИП: Ссылка, Представление (наименование).
Функция ТекстыЗапросовФизлиц()

	Тексты = Новый Массив;
	Если ЕстьРеквизитИПеречисление("Контрагенты", "ЮрФизЛицо", "ЮрФизЛицо") Тогда
		Тексты.Добавить(
		"ВЫБРАТЬ К.Ссылка КАК Ссылка, К.Наименование КАК Представление
		|ИЗ Справочник.Контрагенты КАК К
		|ГДЕ К.ЮрФизЛицо В (ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо),
		|	ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ИндивидуальныйПредприниматель))");
	ИначеЕсли ЕстьРеквизитИПеречисление("Контрагенты", "ЮридическоеФизическоеЛицо", "ЮридическоеФизическоеЛицо") Тогда
		// УНФ
		Тексты.Добавить(
		"ВЫБРАТЬ К.Ссылка КАК Ссылка, К.Наименование КАК Представление
		|ИЗ Справочник.Контрагенты КАК К
		|ГДЕ К.ЮридическоеФизическоеЛицо = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ФизическоеЛицо)");
	КонецЕсли;
	Если ЕстьРеквизитИПеречисление("Партнеры", "ЮрФизЛицо", "КомпанияЧастноеЛицо") Тогда
		Тексты.Добавить(
		"ВЫБРАТЬ П.Ссылка КАК Ссылка, П.Наименование КАК Представление
		|ИЗ Справочник.Партнеры КАК П
		|ГДЕ П.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.КомпанияЧастноеЛицо.ЧастноеЛицо)");
	КонецЕсли;
	Возврат Тексты;

КонецФункции

// Поиск псевдонима: пользователи - в карте сеанса, физлица, ФИО и ИНН - в ленивых картах.
Функция НайтиПсевдоним(ПсевдонимНРег)

	Найдено = ИИА_ПериметрПовтИсп.ДанныеМаскирования().Карта.Получить(ПсевдонимНРег);
	Если Найдено = Неопределено И СтрНачинаетсяС(ПсевдонимНРег, НРег(ПрефиксФизлица()) + "_") Тогда
		Найдено = ИИА_ПериметрПовтИсп.КартаФизлиц().Получить(ПсевдонимНРег);
	КонецЕсли;
	Если Найдено = Неопределено И СтрНачинаетсяС(ПсевдонимНРег, НРег(ПрефиксФИО()) + "_") Тогда
		Найдено = ИИА_ПериметрПовтИсп.КартаФИО().Получить(ПсевдонимНРег);
	КонецЕсли;
	Если Найдено = Неопределено И СтрНачинаетсяС(ПсевдонимНРег, НРег(ПрефиксИНН()) + "_") Тогда
		Найдено = ИИА_ПериметрПовтИсп.КартаИНН().Получить(ПсевдонимНРег);
	КонецЕсли;
	Если Найдено = Неопределено И ИИА_Маскирование.ЭтоКоммерческийПсевдоним(ПсевдонимНРег) Тогда
		// Коммерческие псевдонимы и ИННЮЛ_ - из регистра ИИА_ПсевдонимыОбъектов.
		Найдено = ИИА_Маскирование.ЗначениеПсевдонима(ПсевдонимНРег);
	КонецЕсли;
	Возврат Найдено;

КонецФункции

Функция ПсевдонимПоИдентификатору(Префикс, Соль, Идентификатор)

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Соль + Строка(Идентификатор));
	Возврат Префикс + "_" + НРег(Лев(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма), 10));

КонецФункции

// Маскируемые объекты не запрещаются целиком (даже если попали в периметр по карте ПДн БСП).
Процедура ИсключитьМаскируемыеОбъекты(Контекст)

	Для Каждого Описание Из МаскируемыеОбъекты() Цикл
		Контекст.Объекты.Удалить(ВРег(Описание.Ключ));
	КонецЦикла;

КонецПроцедуры

// У маскируемых объектов закрыты все поля, кроме ссылки: модель работает только со ссылкой (псевдонимом).
Процедура ЗакрытьПоляМаскируемыхОбъектов(Контекст)

	Причина = НСтр("ru = 'персональные данные: доступна только ссылка, модели передаётся псевдоним'");
	Для Каждого Описание Из МаскируемыеОбъекты() Цикл
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Описание.Ключ);
		Если ОбъектМетаданных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
		Для Каждого Реквизит Из ОбъектМетаданных.СтандартныеРеквизиты Цикл
			Если ВРег(Реквизит.Имя) <> "ССЫЛКА" Тогда
				Контекст.Поля.Вставить(ВРег(ПолноеИмя + "." + Реквизит.Имя), Причина);
			КонецЕсли;
		КонецЦикла;
		Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
			Контекст.Поля.Вставить(ВРег(ПолноеИмя + "." + Реквизит.Имя), Причина);
		КонецЦикла;
		Для Каждого ТабличнаяЧасть Из ОбъектМетаданных.ТабличныеЧасти Цикл
			Контекст.Поля.Вставить(ВРег(ПолноеИмя + "." + ТабличнаяЧасть.Имя), Причина);
			Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
				Контекст.Поля.Вставить(ВРег(ПолноеИмя + "." + ТабличнаяЧасть.Имя + "." + Реквизит.Имя), Причина);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ИсключитьОбщиеОбъекты(Контекст)

	Для Каждого ПолноеИмя Из ОбщиеОбъектыИсключения() Цикл
		Контекст.Объекты.Удалить(ВРег(ПолноеИмя));
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьЗапрещенныеТипы(Контекст)

	Для Каждого КлючИЗначение Из Контекст.Объекты Цикл
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(КлючИЗначение.Ключ);
		Если ОбъектМетаданных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ТипСсылки = ТипСсылкиОбъекта(ОбъектМетаданных);
		Если ТипСсылки <> Неопределено Тогда
			Контекст.Типы.Вставить(ТипСсылки, КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПоляПоПравилам(Контекст)

	// Классификация одинаковых имён повторяется в тысячах объектов; результаты живут только эту сборку.
	Контекст.Вставить("МаркерыСекретов", МаркерыСекретов());
	Контекст.Вставить("МаркерыСвободногоТекста", ИменаПолейСвободногоТекста());
	Контекст.Вставить("СекретыПоИменам", Новый Соответствие);
	Контекст.Вставить("СвободныйТекстПоИменам", Новый Соответствие);
	Контекст.Вставить("ТипСтроки", Тип("Строка"));
	Контекст.Вставить("ИменаКоллекцийПолей", СтрРазделить("Реквизиты,Измерения,Ресурсы", ","));

	Для Каждого Коллекция Из КоллекцииОбъектовДанных() Цикл
		Для Каждого ОбъектМетаданных Из Коллекция Цикл
			Если Контекст.Объекты.Получить(ВРег(ОбъектМетаданных.ПолноеИмя())) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ПроверитьПоляОбъекта(Контекст, ОбъектМетаданных);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьПоляОбъекта(Контекст, ОбъектМетаданных)

	ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	Для Каждого ИмяКоллекции Из Контекст.ИменаКоллекцийПолей Цикл
		Поля = КоллекцияПолей(ОбъектМетаданных, ИмяКоллекции);
		Если Поля = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Поле Из Поля Цикл
			ПроверитьПоле(Контекст, ПолноеИмя + "." + Поле.Имя, Поле);
		КонецЦикла;
	КонецЦикла;

	ТабличныеЧасти = КоллекцияПолей(ОбъектМетаданных, "ТабличныеЧасти");
	Если ТабличныеЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
		Для Каждого Поле Из ТабличнаяЧасть.Реквизиты Цикл
			ПроверитьПоле(Контекст, ПолноеИмя + "." + ТабличнаяЧасть.Имя + "." + Поле.Имя, Поле);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьПоле(Контекст, ПолноеИмяПоля, Поле)

	Ключ = ВРег(ПолноеИмяПоля);
	Если Контекст.Поля.Получить(Ключ) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ИмяПоляСекретно(Контекст, Поле.Имя) Или РежимПароля(Поле) Тогда
		Контекст.Поля.Вставить(Ключ, НСтр("ru = 'секрет'"));
		Возврат;
	КонецЕсли;

	ТипыПоля = Поле.Тип.Типы();
	Если ТипыПоля.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ВсеТипыЗапрещены = Истина;
	Для Каждого ТипПоля Из ТипыПоля Цикл
		Если Контекст.Типы.Получить(ТипПоля) = Неопределено Тогда
			ВсеТипыЗапрещены = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ВсеТипыЗапрещены Тогда
		Контекст.Поля.Вставить(Ключ, НСтр("ru = 'ссылка на запрещённый объект'"));
		Возврат;
	КонецЕсли;

	Если ЭтоСвободныйТекст(Контекст, Поле, ТипыПоля) Тогда
		Контекст.Поля.Вставить(Ключ, НСтр("ru = 'свободный текст'"));
	КонецЕсли;

КонецПроцедуры

Функция ЭтоСвободныйТекст(Контекст, Поле, ТипыПоля)

	Если ТипыПоля.Найти(Контекст.ТипСтроки) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипыПоля.Количество() = 1 И Поле.Тип.КвалификаторыСтроки.Длина = 0 Тогда
		Возврат Истина; // строка неограниченной длины
	КонецЕсли;
	// Маркеры свободного текста в имени или синониме, в том числе в доработках (БР_...Комментарий).
	ИмяИСиноним = ВРег(Поле.Имя + " " + Поле.Синоним);
	ИмяИСиноним = СтрЗаменить(ИмяИСиноним, " ", "");
	Результат = Контекст.СвободныйТекстПоИменам.Получить(ИмяИСиноним);
	Если Результат = Неопределено Тогда
		Результат = СодержитМаркер(ИмяИСиноним, Контекст.МаркерыСвободногоТекста);
		Контекст.СвободныйТекстПоИменам.Вставить(ИмяИСиноним, Результат);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// В кэш попадает только проверка имени, не режим пароля, типы или причины запрета конкретного поля.
Функция ИмяПоляСекретно(Контекст, Имя)

	Результат = Контекст.СекретыПоИменам.Получить(Имя);
	Если Результат = Неопределено Тогда
		Результат = ИмяСекретаПоМаркерам(Имя, Контекст.МаркерыСекретов);
		Контекст.СекретыПоИменам.Вставить(Имя, Результат);
	КонецЕсли;
	Возврат Результат;

