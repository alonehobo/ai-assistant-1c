// Замеряет только диагностический вызов с массивом; обычное построение не обращается к таймеру.
Функция ДобавитьЗамерПостроения(Замеры, Этап, Начало)

	Если ТипЗнч(Замеры) <> Тип("Массив") Тогда
		Возврат 0;
	КонецЕсли;
	Окончание = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Замеры.Добавить(Новый Структура("Этап, Миллисекунд", Этап, Окончание - Начало));
	Возврат Окончание;

КонецФункции

Процедура ДобавитьОбъект(Контекст, ОбъектМетаданных, Причина)

	Если ОбъектМетаданных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Ключ = ВРег(ОбъектМетаданных.ПолноеИмя());
	Если Контекст.Объекты.Получить(Ключ) = Неопределено Тогда
		Контекст.Объекты.Вставить(Ключ, Причина);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьОбъектыПодсистем(Контекст)

	Для Каждого ИмяПодсистемы Из ЗапрещенныеПодсистемы() Цикл
		Подсистема = Метаданные.Подсистемы.Найти(ИмяПодсистемы);
		Если Подсистема <> Неопределено Тогда
			ДобавитьСоставПодсистемы(Контекст, Подсистема,
				СтрШаблон(НСтр("ru = 'кадры и зарплата: подсистема %1'"), ИмяПодсистемы));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьСоставПодсистемы(Контекст, Подсистема, Причина)

	Для Каждого ОбъектМетаданных Из Подсистема.Состав Цикл
		Если ЭтоОбъектДанных(ОбъектМетаданных) Тогда
			ДобавитьОбъект(Контекст, ОбъектМетаданных, Причина);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Вложенная Из Подсистема.Подсистемы Цикл
		ДобавитьСоставПодсистемы(Контекст, Вложенная, Причина);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьЯвныеОбъекты(Контекст)

	Для Каждого ПолноеИмя Из ЯвноЗапрещенныеОбъекты() Цикл
		ДобавитьОбъект(Контекст, Метаданные.НайтиПоПолномуИмени(ПолноеИмя),
			НСтр("ru = 'персональные данные или переписка'"));
	КонецЦикла;

	// Служебные данные коммерческого маскирования: словарь псевдонимов, номера диалогов, список маскирования.
	Для Каждого Имя Из СтрРазделить("ИИА_ПсевдонимыОбъектов,ИИА_НомераОбъектовДиалога,ИИА_МаскированиеОбъектов", ",") Цикл
		ДобавитьОбъект(Контекст, Метаданные.РегистрыСведений.Найти(Имя), НСтр("ru = 'служебные данные маскирования'"));
	КонецЦикла;

	// Присоединённые файлы переписки.
	Для Каждого Справочник Из Метаданные.Справочники Цикл
		Если СтрНачинаетсяС(Справочник.Имя, "ЭлектронноеПисьмо")
			Или СтрНачинаетсяС(Справочник.Имя, "ТелефонныйЗвонок")
			Или СтрНачинаетсяС(Справочник.Имя, "Встреча")
			Или СтрНачинаетсяС(Справочник.Имя, "СообщениеSMS") Тогда
			ДобавитьОбъект(Контекст, Справочник, НСтр("ru = 'переписка'"));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьКартуПерсональныхДанныхБСП(Контекст)

	Если Не ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ЗащитаПерсональныхДанных") Тогда
		Возврат;
	КонецЕсли;

	МодульЗащитаПерсональныхДанных = ОбщегоНазначения.ОбщийМодуль("ЗащитаПерсональныхДанных");
	УстановитьПривилегированныйРежим(Истина);
	Сведения = МодульЗащитаПерсональныхДанных.СведенияОПерсональныхДанных();
	УстановитьПривилегированныйРежим(Ложь);

	Причина = НСтр("ru = 'карта персональных данных БСП'");
	Для Каждого СтрокаСведений Из Сведения Цикл
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(СтрокаСведений.Объект);
		Если ОбъектМетаданных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если СокрЛП(СтрокаСведений.ПоляРегистрации) = "Ссылка" Тогда
			ДобавитьОбъект(Контекст, ОбъектМетаданных, Причина);
		КонецЕсли;
		ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
		Для Каждого Поле Из СтрРазделить(СтрокаСведений.ПоляДоступа, ",", Ложь) Цикл
			Контекст.Поля.Вставить(ВРег(ПолноеИмя + "." + СокрЛП(Поле)), Причина);
		КонецЦикла;
		// Поле регистрации указывает на субъекта ПДн.
		Для Каждого Поле Из СтрРазделить(СтрокаСведений.ПоляРегистрации, ",", Ложь) Цикл
			Если СокрЛП(Поле) <> "Ссылка" Тогда
				Контекст.Поля.Вставить(ВРег(ПолноеИмя + "." + СокрЛП(Поле)), Причина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьРегистрыБухгалтерииИПланыОбмена(Контекст)

	Для Каждого Регистр Из Метаданные.РегистрыБухгалтерии Цикл
		ДобавитьОбъект(Контекст, Регистр,
			НСтр("ru = 'бухгалтерия: на этапе 1 только через отчёты (без счетов 69/70/71/73)'"));
	КонецЦикла;
	Для Каждого ПланОбмена Из Метаданные.ПланыОбмена Цикл
		ДобавитьОбъект(Контекст, ПланОбмена, НСтр("ru = 'служебные настройки обмена'"));
	КонецЦикла;

КонецПроцедуры

