#КонецОбласти

#Область Детекторы

Функция СкрытьСекреты(Знач Текст, КоличествоЗамен)

	// PEM-блоки.
	Позиция = СтрНайти(Текст, "-----BEGIN");
	Если Позиция > 0 Тогда
		КоличествоЗамен = КоличествоЗамен + 1;
		Возврат Лев(Текст, Позиция - 1) + НСтр("ru = '[секрет удалён]'");
	КонецЕсли;

	// Фрагменты вида "пароль=значение", "token: значение".
	Слова = СтрРазделить(Текст, " " + Символы.ПС + Символы.ВК + Символы.Таб, Истина);
	Изменено = Ложь;
	Для Индекс = 0 По Слова.ВГраница() Цикл
		Слово = Слова[Индекс];
		Разделитель = 0;
		Для Каждого Символ Из СтрРазделить("=,:", ",") Цикл
			ПозицияСимвола = СтрНайти(Слово, Символ);
			Если ПозицияСимвола > 1 И (Разделитель = 0 Или ПозицияСимвола < Разделитель) Тогда
				Разделитель = ПозицияСимвола;
			КонецЕсли;
		КонецЦикла;
		Если Разделитель > 1 И ЭтоИмяСекрета(Лев(Слово, Разделитель - 1)) Тогда
			Слова[Индекс] = Лев(Слово, Разделитель) + НСтр("ru = '[секрет удалён]'");
			КоличествоЗамен = КоличествоЗамен + 1;
			Изменено = Истина;
			Если Разделитель = СтрДлина(Слово) И Индекс < Слова.ВГраница() Тогда
				Слова[Индекс + 1] = "";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если Изменено Тогда
		Возврат СтрСоединить(Слова, " ");
	КонецЕсли;
	Возврат Текст;

КонецФункции

Функция СкрытьПочту(Знач Текст, КоличествоЗамен)

	Если СтрНайти(Текст, "@") = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	Попытка
		Количество = СтрНайтиВсеПоРегулярномуВыражению(Текст, "[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}").Количество();
		Если Количество > 0 Тогда
			КоличествоЗамен = КоличествоЗамен + Количество;
			Возврат СтрЗаменитьПоРегулярномуВыражению(Текст,
				"[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}", НСтр("ru = '[почта скрыта]'"));
		КонецЕсли;
		Возврат Текст;
	Исключение
		// Без регулярных выражений скрываем слова с "@" целиком.
		Слова = СтрРазделить(Текст, " ", Истина);
		Для Индекс = 0 По Слова.ВГраница() Цикл
			Если СтрНайти(Слова[Индекс], "@") > 0 Тогда
				Слова[Индекс] = НСтр("ru = '[почта скрыта]'");
				КоличествоЗамен = КоличествоЗамен + 1;
			КонецЕсли;
		КонецЦикла;
		Возврат СтрСоединить(Слова, " ");
	КонецПопытки;

КонецФункции

// Находит последовательности цифр (с допустимыми разделителями) и скрывает те,
// что похожи на СНИЛС, телефон, банковскую карту, лицевой счёт физлица или паспорт.
Функция СкрытьНомера(Знач Текст, КоличествоЗамен)

	Длина = СтрДлина(Текст);
	Результат = Новый Массив;
	Позиция = 1;
	Пока Позиция <= Длина Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Не ЭтоЦифра(Символ) И Не (Символ = "+" И Позиция < Длина И ЭтоЦифра(Сред(Текст, Позиция + 1, 1))) Тогда
			Результат.Добавить(Символ);
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		// Собираем токен: цифры и разделители " ()-+" между цифрами.
		Начало = Позиция;
		Цифры = "";
		Конец = Позиция;
		Курсор = Позиция;
		Пока Курсор <= Длина Цикл
			СимволТокена = Сред(Текст, Курсор, 1);
			Если ЭтоЦифра(СимволТокена) Тогда
				Цифры = Цифры + СимволТокена;
				Конец = Курсор;
			ИначеЕсли СтрНайти(" ()-+", СимволТокена) = 0 Тогда
				Прервать;
			КонецЕсли;
			Курсор = Курсор + 1;
		КонецЦикла;
		Токен = Сред(Текст, Начало, Конец - Начало + 1);

		Если СтрДлина(Токен) = 12 И ЭтоИННФизлица(Цифры) Тогда
			// ИНН физлица или ИП: обратимый псевдоним, не находка - по нему можно искать и отбирать.
			Результат.Добавить(ПсевдонимПоИдентификатору(ПрефиксИНН(), ИИА_ПериметрПовтИсп.ДанныеМаскирования().Соль, Цифры));
		ИначеЕсли ЭтоПерсональныйНомер(Цифры, Токен) Тогда
			Результат.Добавить(НСтр("ru = '[номер скрыт]'"));
			КоличествоЗамен = КоличествоЗамен + 1;
		Иначе
			Результат.Добавить(Токен);
		КонецЕсли;
		Позиция = Конец + 1;
	КонецЦикла;

	Возврат СтрСоединить(Результат, "");

КонецФункции

Функция ЭтоПерсональныйНомер(Цифры, Токен)

	Количество = СтрДлина(Цифры);
	Если Количество = 11 И КонтрольСНИЛС(Цифры) Тогда
		Возврат Истина;
	ИначеЕсли Количество = 11 И (Лев(Цифры, 1) = "7" Или Лев(Цифры, 1) = "8") И Сред(Цифры, 2, 1) = "9" Тогда
		Возврат Истина; // мобильный телефон
	ИначеЕсли Количество = 10 И Лев(Цифры, 1) = "9" И Не КонтрольИНН10(Цифры) Тогда
		Возврат Истина; // мобильный телефон без кода страны
	ИначеЕсли Количество = 10 И СтрДлина(СокрЛП(Токен)) = 11 И Сред(СокрЛП(Токен), 5, 1) = " " Тогда
		Возврат Истина; // паспорт "1234 567890"
	ИначеЕсли Количество >= 16 И Количество <= 19 И КонтрольЛуна(Цифры) Тогда
		Возврат Истина; // банковская карта
	ИначеЕсли Количество = 20 И (СтрНачинаетсяС(Цифры, "40817") Или СтрНачинаетсяС(Цифры, "40820")
		Или СтрНачинаетсяС(Цифры, "423") Или СтрНачинаетсяС(Цифры, "426")) Тогда
		Возврат Истина; // счёт физлица
	КонецЕсли;
	Возврат Ложь;

КонецФункции

Функция ЭтоЦифра(Символ)
	Возврат СтрНайти("0123456789", Символ) > 0 И Символ <> "";
КонецФункции

Функция Цифра(Цифры, Номер)
	Возврат Число(Сред(Цифры, Номер, 1));
КонецФункции

Функция КонтрольнаяЦифраИНН(Цифры, Коэффициенты)

	Сумма = 0;
	Для Индекс = 0 По Коэффициенты.ВГраница() Цикл
		Сумма = Сумма + Цифра(Цифры, Индекс + 1) * Коэффициенты[Индекс];
	КонецЦикла;
	Возврат (Сумма % 11) % 10;

КонецФункции

Функция КонтрольИНН10(Цифры)

	Коэффициенты = СтрРазделить("2,4,10,3,5,9,4,6,8", ",");
	Для Индекс = 0 По Коэффициенты.ВГраница() Цикл
		Коэффициенты[Индекс] = Число(Коэффициенты[Индекс]);
	КонецЦикла;
	Возврат КонтрольнаяЦифраИНН(Цифры, Коэффициенты) = Цифра(Цифры, 10);

КонецФункции

// 12-значный ИНН физлица или ИП с верными контрольными цифрами.
Функция ЭтоИННФизлица(Строка)

	Если СтрДлина(Строка) <> 12 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Номер = 1 По 12 Цикл
		Если Не ЭтоЦифра(Сред(Строка, Номер, 1)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Коэффициенты11 = Новый Массив;
	Для Каждого Коэффициент Из СтрРазделить("7,2,4,10,3,5,9,4,6,8", ",") Цикл
		Коэффициенты11.Добавить(Число(Коэффициент));
	КонецЦикла;
	Коэффициенты12 = Новый Массив;
	Для Каждого Коэффициент Из СтрРазделить("3,7,2,4,10,3,5,9,4,6,8", ",") Цикл
		Коэффициенты12.Добавить(Число(Коэффициент));
	КонецЦикла;
	Возврат КонтрольнаяЦифраИНН(Строка, Коэффициенты11) = Цифра(Строка, 11)
		И КонтрольнаяЦифраИНН(Строка, Коэффициенты12) = Цифра(Строка, 12);

КонецФункции

Функция КонтрольСНИЛС(Цифры)

	Сумма = 0;
	Для Индекс = 1 По 9 Цикл
		Сумма = Сумма + Цифра(Цифры, Индекс) * (10 - Индекс);
	КонецЦикла;
	Контроль = Сумма % 101;
	Если Контроль = 100 Тогда
		Контроль = 0;
	КонецЕсли;
	Возврат Контроль = Число(Прав(Цифры, 2));

КонецФункции

Функция КонтрольЛуна(Цифры)

	Сумма = 0;
	Количество = СтрДлина(Цифры);
	Для Индекс = 0 По Количество - 1 Цикл
		Значение = Цифра(Цифры, Количество - Индекс);
		Если Индекс % 2 = 1 Тогда
			Значение = Значение * 2;
			Если Значение > 9 Тогда
				Значение = Значение - 9;
			КонецЕсли;
		КонецЕсли;
		Сумма = Сумма + Значение;
	КонецЦикла;
	Возврат Сумма % 10 = 0;

КонецФункции

// Заменяет ФИО из стоп-словаря («Фамилия Имя [Отчество]», «Фамилия И.», «Имя Отчество») псевдонимами ФИО_...
Функция ЗаменитьФИОПсевдонимами(Знач Текст)

	Словарь = ИИА_ПериметрПовтИсп.СловарьФИО();
	Если Словарь.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	Слова = СловаТекста(Текст);
	Если Слова.Количество() < 2 Тогда
		Возврат Текст;
	КонецЕсли;

	Соль = ИИА_ПериметрПовтИсп.ДанныеМаскирования().Соль;
	Результат = Новый Массив;
	Позиция = 1;
	Индекс = 0;
	Пока Индекс < Слова.Количество() - 1 Цикл
		// ФИО пишут с заглавной: «по продажам» не принимаем за «Имя Отчество».
		Если Не Слова[Индекс].СЗаглавной Или Не Слова[Индекс + 1].СЗаглавной Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		Ключ = Слова[Индекс].Нормализованное + " " + Слова[Индекс + 1].Нормализованное;
		Если Словарь.Получить(Ключ) = Неопределено Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		Последнее = Индекс + 1;
		Если Индекс + 2 < Слова.Количество()
			И Словарь.Получить(Ключ + " " + Слова[Индекс + 2].Нормализованное) <> Неопределено Тогда
			Ключ = Ключ + " " + Слова[Индекс + 2].Нормализованное;
			Последнее = Индекс + 2;
		КонецЕсли;
		Результат.Добавить(Сред(Текст, Позиция, Слова[Индекс].Начало - Позиция));
		Результат.Добавить(ПсевдонимПоИдентификатору(ПрефиксФИО(), Соль, Ключ));
		Позиция = Слова[Последнее].Конец + 1;
		Индекс = Последнее + 1;
	КонецЦикла;
	Если Позиция = 1 Тогда
		Возврат Текст;
	КонецЕсли;
	Результат.Добавить(Сред(Текст, Позиция));
	Возврат СтрСоединить(Результат, "");

КонецФункции

// Разбивает текст на слова из букв с позициями.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Начало - Число
//   * Конец - Число
//   * Нормализованное - Строка
//
Функция СловаТекста(Текст)

	Слова = Новый Массив;
	Длина = СтрДлина(Текст);
	Позиция = 1;
	Пока Позиция <= Длина Цикл
		Если Не ЭтоБуква(Сред(Текст, Позиция, 1)) Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;
		Начало = Позиция;
		Пока Позиция <= Длина И (ЭтоБуква(Сред(Текст, Позиция, 1)) Или Сред(Текст, Позиция, 1) = "-") Цикл
			Позиция = Позиция + 1;
		КонецЦикла;
		Конец = Позиция - 1;
		// Инициал с точкой: "И." входит в слово.
		Если Позиция <= Длина И Сред(Текст, Позиция, 1) = "." И Конец - Начало = 0 Тогда
			Конец = Позиция;
			Позиция = Позиция + 1;
		КонецЕсли;
		Слово = Новый Структура("Начало, Конец, Нормализованное, СЗаглавной", Начало, Конец,
			НормализоватьСлово(Сред(Текст, Начало, Конец - Начало + 1)), ЭтоЗаглавная(Сред(Текст, Начало, 1)));
		Слова.Добавить(Слово);
	КонецЦикла;
	Возврат Слова;

КонецФункции

Функция ЭтоЗаглавная(Символ)

	Возврат ЭтоБуква(Символ) И ВРег(Символ) = Символ;

КонецФункции

Функция ЭтоБуква(Символ)

	Если Символ = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ВРег(Символ) <> НРег(Символ);

КонецФункции

Функция НормализоватьСлово(Слово)

	Возврат СтрЗаменить(СтрЗаменить(ВРег(Слово), "Ё", "Е"), ".", "");

КонецФункции

Процедура ДобавитьФормуФИО(Словарь, Ключ, Представление)

	Если Словарь.Получить(Ключ) = Неопределено Тогда
		Словарь.Вставить(Ключ, Представление);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьФИОВСловарь(Словарь, Фамилия, Имя, Отчество)

	ЧФ = НормализоватьСлово(СокрЛП(Фамилия));
	ЧИ = НормализоватьСлово(СокрЛП(Имя));
	ЧО = НормализоватьСлово(СокрЛП(Отчество));
	// Однобуквенная «фамилия» или пустое имя дают слишком общие ключи.
	Если СтрДлина(ЧФ) < 2 Или СтрДлина(ЧИ) < 2 Тогда
		Возврат;
	КонецЕсли;

	ФамилияТекст = СокрЛП(Фамилия);
	ИмяТекст = СокрЛП(Имя);
	ОтчествоТекст = СокрЛП(Отчество);
	ДобавитьФормуФИО(Словарь, ЧФ + " " + ЧИ, ФамилияТекст + " " + ИмяТекст);
	ДобавитьФормуФИО(Словарь, ЧИ + " " + ЧФ, ИмяТекст + " " + ФамилияТекст);
	ДобавитьФормуФИО(Словарь, ЧФ + " " + Лев(ЧИ, 1), ФамилияТекст + " " + Лев(ИмяТекст, 1) + ".");
	ДобавитьФормуФИО(Словарь, Лев(ЧИ, 1) + " " + ЧФ, Лев(ИмяТекст, 1) + ". " + ФамилияТекст);
	Если СтрДлина(ЧО) >= 2 Тогда
		ДобавитьФормуФИО(Словарь, ЧФ + " " + ЧИ + " " + ЧО, ФамилияТекст + " " + ИмяТекст + " " + ОтчествоТекст);
		ДобавитьФормуФИО(Словарь, ЧФ + " " + Лев(ЧИ, 1) + " " + Лев(ЧО, 1), ФамилияТекст + " " + Лев(ИмяТекст, 1) + "." + Лев(ОтчествоТекст, 1) + ".");
		ДобавитьФормуФИО(Словарь, ЧИ + " " + ЧО, ИмяТекст + " " + ОтчествоТекст); // "Имя Отчество"
	КонецЕсли;

КонецПроцедуры

// Разбирает наименование физлица или ИП («ИП Иванов Иван Иванович», «Петров П.П. (ИП)») на ФИО
// и добавляет его формы в словарь. Слова правовой формы отбрасываются.
Процедура ДобавитьФИОИзНаименования(Словарь, Наименование)

	Если ТипЗнч(Наименование) <> Тип("Строка") Или ПустаяСтрока(Наименование) Тогда
		Возврат;
	КонецЕсли;
	СловаПравовойФормы = СловаПравовойФормыФизлица();
	Части = Новый Массив;
	Для Каждого Слово Из СловаТекста(Наименование) Цикл
		Если СловаПравовойФормы.Найти(Слово.Нормализованное) = Неопределено Тогда
			Части.Добавить(Сред(Наименование, Слово.Начало, Слово.Конец - Слово.Начало + 1));
		КонецЕсли;
	КонецЦикла;
	// «Фамилия Имя [Отчество] [оглы]»; иначе это не ФИО (например, «Частное лицо»).
	Если Части.Количество() < 2 Или Части.Количество() > 4 Тогда
		Возврат;
	КонецЕсли;
	Фамилия = Части[0];
	Имя = Части[1];
	Отчество = ?(Части.Количество() > 2, Части[2], "");
	ЧИ = НормализоватьСлово(Имя);
	Если СтрДлина(ЧИ) >= 2 Тогда
		ДобавитьФИОВСловарь(Словарь, Фамилия, Имя, Отчество);
		Возврат;
	КонецЕсли;

	// Фамилия с инициалами: «Петров П.П.», «Петров П. П.».
	ЧФ = НормализоватьСлово(Фамилия);
	Если СтрДлина(ЧФ) < 2 Или СтрДлина(ЧИ) <> 1 Тогда
		Возврат;
	КонецЕсли;
	ДобавитьФормуФИО(Словарь, ЧФ + " " + ЧИ, Фамилия + " " + Имя);
	ЧО = НормализоватьСлово(Отчество);
	Если СтрДлина(ЧО) = 1 Тогда
		ДобавитьФормуФИО(Словарь, ЧФ + " " + ЧИ + " " + ЧО, Фамилия + " " + Имя + Отчество);
	КонецЕсли;

КонецПроцедуры

Функция СловаПравовойФормыФизлица()

	Возврат СтрРазделить("ИП,ИНДИВИДУАЛЬНЫЙ,ПРЕДПРИНИМАТЕЛЬ,ГЛАВА,КФХ,КРЕСТЬЯНСКОГО,ФЕРМЕРСКОГО,ХОЗЯЙСТВА,"
		+ "САМОЗАНЯТЫЙ,НОТАРИУС,АДВОКАТ,ЧАСТНЫЙ,ЧАСТНОЕ,ЛИЦО", ",");

КонецФункции

#КонецОбласти

#КонецОбласти
