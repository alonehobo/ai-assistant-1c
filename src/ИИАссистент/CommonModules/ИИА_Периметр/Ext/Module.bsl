///////////////////////////////////////////////////////////////////////////////////////////////////////
// ИИ-ассистент: периметр данных этапа 1.
// Агент не получает персональные данные физлиц, кадровые и зарплатные данные, секреты и свободный текст.
// Периметр строится по метаданным (чёрный список) и применяется ко всем инструментам агента.
// План: docs/plans/ai-chat-1c-plan.md, раздел 4.5.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Описание периметра (кэшируется на сеанс).
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура:
//   * ЗапрещенныеОбъекты - ФиксированноеСоответствие из КлючИЗначение:
//       ** Ключ - Строка - ВРег(полное имя объекта метаданных).
//       ** Значение - Строка - причина запрета.
//   * ЗапрещенныеПоля - ФиксированноеСоответствие из КлючИЗначение:
//       ** Ключ - Строка - ВРег("Объект.Поле") или ВРег("Объект.ТабличнаяЧасть.Поле").
//       ** Значение - Строка - причина запрета.
//   * ЗапрещенныеТипы - ФиксированноеСоответствие из КлючИЗначение:
//       ** Ключ - Тип - ссылочный тип запрещённого объекта.
//       ** Значение - Строка - причина запрета.
//
Функция ОписаниеПериметра() Экспорт

	Возврат ИИА_ПериметрПовтИсп.ОписаниеПериметра();

КонецФункции

// Проверяет, запрещён ли объект метаданных целиком.
//
// Параметры:
//  ПолноеИмяОбъекта - Строка - например "Справочник.ФизическиеЛица".
//  Причина - Строка - возвращаемый параметр.
//  ПравилаПрофиля - ФиксированнаяСтруктура, Неопределено - правила профиля вместо кэша сеанса
//    (см. ИИА_ПрофилиДоступа.ПостроитьПравилаТекущегоПользователя).
//
// Возвращаемое значение:
//  Булево
//
Функция ОбъектЗапрещен(ПолноеИмяОбъекта, Причина = "", ПравилаПрофиля = Неопределено) Экспорт

	Периметр = ОписаниеПериметра();
	Найдено = Периметр.ЗапрещенныеОбъекты.Получить(ВРег(ПолноеИмяОбъекта));
	Если Найдено = Неопределено Тогда
		// Периметр этапа разрешает - дальше решает профиль доступа пользователя (только сужает).
		Возврат ИИА_ПрофилиДоступа.ОбъектЗапрещенПрофилем(ПолноеИмяОбъекта, Причина, ПравилаПрофиля);
	КонецЕсли;
	Причина = Найдено;
	Возврат Истина;

КонецФункции

// Проверяет, запрещено ли поле объекта.
//
// Параметры:
//  ПолноеИмяОбъекта - Строка - полное имя объекта метаданных.
//  ПутьПоля - Строка - "Поле" или "ТабличнаяЧасть.Поле".
//  Причина - Строка - возвращаемый параметр.
//  ПравилаПрофиля - ФиксированнаяСтруктура, Неопределено - см. ОбъектЗапрещен.
//
// Возвращаемое значение:
//  Булево
//
Функция ПолеЗапрещено(ПолноеИмяОбъекта, ПутьПоля, Причина = "", ПравилаПрофиля = Неопределено) Экспорт

	Если ОбъектЗапрещен(ПолноеИмяОбъекта, Причина, ПравилаПрофиля) Тогда
		Возврат Истина;
	КонецЕсли;

	Если ЭтоИмяСекрета(ПоследнийСегмент(ПутьПоля)) Тогда
		Причина = НСтр("ru = 'секрет'");
		Возврат Истина;
	КонецЕсли;

	Периметр = ОписаниеПериметра();
	Найдено = Периметр.ЗапрещенныеПоля.Получить(ВРег(ПолноеИмяОбъекта + "." + ПутьПоля));
	Если Найдено = Неопределено Тогда
		Возврат ИИА_ПрофилиДоступа.ПолеЗапрещеноПрофилем(ПолноеИмяОбъекта, ПутьПоля, Причина, ПравилаПрофиля);
	КонецЕсли;
	Причина = Найдено;
	Возврат Истина;

КонецФункции

// Проверяет, запрещён ли ссылочный тип.
//
// Параметры:
//  ПроверяемыйТип - Тип
//  Причина - Строка - возвращаемый параметр.
//  ПравилаПрофиля - ФиксированнаяСтруктура, Неопределено - см. ОбъектЗапрещен.
//
// Возвращаемое значение:
//  Булево
//
Функция ТипЗапрещен(ПроверяемыйТип, Причина = "", ПравилаПрофиля = Неопределено) Экспорт

	Найдено = ОписаниеПериметра().ЗапрещенныеТипы.Получить(ПроверяемыйТип);
	Если Найдено = Неопределено Тогда
		Возврат ИИА_ПрофилиДоступа.ТипЗапрещенПрофилем(ПроверяемыйТип, Причина, ПравилаПрофиля);
	КонецЕсли;
	Причина = Найдено;
	Возврат Истина;

КонецФункции

// Проверяет, является ли имя реквизита именем секрета (пароль, токен, ключ API и т.п.).
//
// Параметры:
//  Имя - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоИмяСекрета(Имя) Экспорт

	Возврат ИмяСекретаПоМаркерам(Имя, МаркерыСекретов());

КонецФункции

// Строит периметр без кэша. Используется ИИА_ПериметрПовтИсп и выгрузкой для просмотра.
//
// Параметры:
//  Замеры - Массив из Структура, Неопределено - необязательный выходной массив:
//    * Этап - Строка - фиксированное имя этапа построения.
//    * Миллисекунд - Число - длительность этапа; без массива таймер не используется.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура - см. ОписаниеПериметра.
//
Функция ПостроитьОписаниеПериметра(Замеры = Неопределено) Экспорт

	Контекст = Новый Структура;
	Контекст.Вставить("Объекты", Новый Соответствие);
	Контекст.Вставить("Поля", Новый Соответствие);
	Контекст.Вставить("Типы", Новый Соответствие);

	НачалоЭтапа = 0;
	Если ТипЗнч(Замеры) = Тип("Массив") Тогда
		НачалоЭтапа = ТекущаяУниверсальнаяДатаВМиллисекундах();
	КонецЕсли;

	ДобавитьОбъектыПодсистем(Контекст);
	НачалоЭтапа = ДобавитьЗамерПостроения(Замеры, "ДобавитьОбъектыПодсистем", НачалоЭтапа);
	ДобавитьЯвныеОбъекты(Контекст);
	НачалоЭтапа = ДобавитьЗамерПостроения(Замеры, "ДобавитьЯвныеОбъекты", НачалоЭтапа);
	ДобавитьКартуПерсональныхДанныхБСП(Контекст);
	НачалоЭтапа = ДобавитьЗамерПостроения(Замеры, "ДобавитьКартуПерсональныхДанныхБСП", НачалоЭтапа);
	ДобавитьРегистрыБухгалтерииИПланыОбмена(Контекст);
	НачалоЭтапа = ДобавитьЗамерПостроения(Замеры, "ДобавитьРегистрыБухгалтерииИПланыОбмена", НачалоЭтапа);
	ИсключитьОбщиеОбъекты(Контекст);
	НачалоЭтапа = ДобавитьЗамерПостроения(Замеры, "ИсключитьОбщиеОбъекты", НачалоЭтапа);
	ИсключитьМаскируемыеОбъекты(Контекст);
	НачалоЭтапа = ДобавитьЗамерПостроения(Замеры, "ИсключитьМаскируемыеОбъекты", НачалоЭтапа);
	ЗаполнитьЗапрещенныеТипы(Контекст);
	НачалоЭтапа = ДобавитьЗамерПостроения(Замеры, "ЗаполнитьЗапрещенныеТипы", НачалоЭтапа);
	ДобавитьПоляПоПравилам(Контекст);
	НачалоЭтапа = ДобавитьЗамерПостроения(Замеры, "ДобавитьПоляПоПравилам", НачалоЭтапа);
	ЗакрытьПоляМаскируемыхОбъектов(Контекст);
	НачалоЭтапа = ДобавитьЗамерПостроения(Замеры, "ЗакрытьПоляМаскируемыхОбъектов", НачалоЭтапа);

	Результат = Новый Структура;
	Результат.Вставить("ЗапрещенныеОбъекты", Новый ФиксированноеСоответствие(Контекст.Объекты));
	Результат.Вставить("ЗапрещенныеПоля", Новый ФиксированноеСоответствие(Контекст.Поля));
	Результат.Вставить("ЗапрещенныеТипы", Новый ФиксированноеСоответствие(Контекст.Типы));
	Возврат Новый ФиксированнаяСтруктура(Результат);

КонецФункции

// Описание периметра из постоянного кэша. Периметр зависит только от метаданных, а его построение
// обходит все реквизиты конфигурации (десятки секунд): ход чата идёт в фоновом задании - новом сеансе,
// и кэш сеанса его не спасает. Кэш сбрасывается при смене конфигурации, состава или версий расширений.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура - см. ПостроитьОписаниеПериметра.
//
Функция СохраненноеОписаниеПериметра() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	// Номер в ключе меняется вместе с правилами построения периметра в этом модуле.
	Версия = "периметр 2; " + ИИА_Знания.ВерсияМетаданных();
	Кэш = Константы.ИИА_КэшПериметра.Получить().Получить();
	Если ТипЗнч(Кэш) = Тип("Структура") И Кэш.Свойство("Версия") И Кэш.Версия = Версия
		И Кэш.Свойство("Описание") И ТипЗнч(Кэш.Описание) = Тип("ФиксированнаяСтруктура") Тогда
		Возврат Кэш.Описание;
	КонецЕсли;

	Описание = ПостроитьОписаниеПериметра();
	Попытка
		Константы.ИИА_КэшПериметра.Установить(Новый ХранилищеЗначения(
			Новый Структура("Версия, Описание", Версия, Описание)));
	Исключение
		// Параллельная запись или запрет записи в текущем сеансе: периметр уже построен, ход продолжается.
		ЗаписьЖурналаРегистрации("ИИАссистент.Периметр", УровеньЖурналаРегистрации.Предупреждение, , ,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Описание;

КонецФункции

// Периметр в виде таблицы для просмотра и ревью службой безопасности.
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * Вид - Строка - "Объект", "Поле" или "Тип".
//   * Имя - Строка
//   * Причина - Строка
//
Функция ПериметрДляПросмотра() Экспорт

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Вид", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Причина", Новый ОписаниеТипов("Строка"));

	Периметр = ОписаниеПериметра();
	Для Каждого КлючИЗначение Из Периметр.ЗапрещенныеОбъекты Цикл
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Вид = "Объект";
		НоваяСтрока.Имя = КлючИЗначение.Ключ;
		НоваяСтрока.Причина = КлючИЗначение.Значение;
	КонецЦикла;
	Для Каждого КлючИЗначение Из Периметр.ЗапрещенныеПоля Цикл
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Вид = "Поле";
		НоваяСтрока.Имя = КлючИЗначение.Ключ;
		НоваяСтрока.Причина = КлючИЗначение.Значение;
	КонецЦикла;
	Для Каждого КлючИЗначение Из Периметр.ЗапрещенныеТипы Цикл
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Вид = "Тип";
		НоваяСтрока.Имя = Строка(КлючИЗначение.Ключ);
		НоваяСтрока.Причина = КлючИЗначение.Значение;
	КонецЦикла;
	Таблица.Сортировать("Вид, Имя");
	Возврат Таблица;

КонецФункции

// Приводит значение из результата инструмента к безопасному примитиву для передачи модели.
// Ссылки запрещённых типов и физлица/ИП среди контрагентов заменяются заглушками,
// строки проходят детекторы и стоп-словарь ФИО.
//
// Параметры:
//  Значение - Произвольный
//  ФизлицаСредиСсылок - Соответствие, Неопределено - результат ОтметитьСсылки; Неопределено - контрагент
//    или партнёр размечается по одной ссылке.
//  КоличествоЗамен - Число - увеличивается на число скрытых фрагментов.
//  Регистрация - Соответствие, Неопределено - буфер новых коммерческих пар «псевдоним -> значение»
//    (см. ИИА_Маскирование.ЗаписатьПсевдонимы); Неопределено - пара пишется сразу.
//
// Возвращаемое значение:
//  Строка, Число, Булево, Неопределено
//
Функция БезопасноеЗначение(Значение, ФизлицаСредиСсылок, КоличествоЗамен = 0, Регистрация = Неопределено) Экспорт

	ТипЗначения = ТипЗнч(Значение);
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат Неопределено;
	ИначеЕсли ТипЗначения = Тип("Булево") Или ТипЗначения = Тип("Число") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss");
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Возврат ОчиститьТекст(Значение, КоличествоЗамен);
	ИначеЕсли ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат Строка(Значение);
	ИначеЕсли ЭтоМаскируемыйТип(ТипЗначения) Тогда
		Возврат Псевдоним(Значение);
	ИначеЕсли ТипЗапрещен(ТипЗначения) Тогда
		КоличествоЗамен = КоличествоЗамен + 1;
		Возврат ЗаглушкаСкрыто();
	КонецЕсли;

	Признаки = ФизлицаСредиСсылок;
	Если Признаки = Неопределено И ЭтоКонтрагентИлиПартнер(ТипЗначения) Тогда
		Признаки = ОтметитьСсылки(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Значение));
	КонецЕсли;
	Если Признаки <> Неопределено И Признаки.Получить(Значение) = Истина Тогда
		// Контрагент или партнёр - физлицо или ИП: модели псевдоним, пользователю имя (приоритет ПДн).
		Возврат ПсевдонимФизлица(Значение);
	ИначеЕсли ИИА_Маскирование.ЭтоКоммерческийТип(ТипЗначения) Тогда
		// Коммерческое маскирование для модели Т3: стабильный псевдоним, пара - в регистр псевдонимов.
		Возврат ИИА_Маскирование.ПсевдонимДляМодели(Значение, Регистрация);
	ИначеЕсли ОбщегоНазначения.ЭтоСсылка(ТипЗначения) Тогда
		Возврат ОчиститьТекст(Строка(Значение), КоличествоЗамен);
	КонецЕсли;

	Возврат НСтр("ru = '[значение не передаётся]'");

КонецФункции

// Устарела: см. ОтметитьСсылки.
//
// Параметры:
//  Ссылки - Массив из ЛюбаяСсылка
//
// Возвращаемое значение:
//  Соответствие - см. ОтметитьСсылки.
//
Функция ОтметитьФизлицСредиСсылок(Ссылки) Экспорт

	Возврат ОтметитьСсылки(Ссылки);

КонецФункции

// Пакетная разметка ссылок: какие контрагенты и партнёры - физлица или ИП (им псевдоним Физлицо_).
// Классификация выполняется в привилегированном режиме: возвращаются только признаки, не данные.
//
// Параметры:
//  Ссылки - Массив из ЛюбаяСсылка
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - ЛюбаяСсылка
//   * Значение - Булево - Истина, если физлицо или ИП.
//
Функция ОтметитьСсылки(Ссылки) Экспорт

	Результат = Новый Соответствие;
	СсылкиКонтрагентов = Новый Массив;
	СсылкиПартнеров = Новый Массив;

	ТипКонтрагенты = ТипСсылкиСправочника("Контрагенты");
	ТипПартнеры = ТипСсылкиСправочника("Партнеры");
	Для Каждого Ссылка Из Ссылки Цикл
		Если ТипКонтрагенты <> Неопределено И ТипЗнч(Ссылка) = ТипКонтрагенты Тогда
			СсылкиКонтрагентов.Добавить(Ссылка);
		ИначеЕсли ТипПартнеры <> Неопределено И ТипЗнч(Ссылка) = ТипПартнеры Тогда
			СсылкиПартнеров.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;

	УстановитьПривилегированныйРежим(Истина);

	Если СсылкиКонтрагентов.Количество() > 0 И ЕстьРеквизитИПеречисление("Контрагенты", "ЮрФизЛицо", "ЮрФизЛицо") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка В (&Ссылки)
		|	И Контрагенты.ЮрФизЛицо В (ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо),
		|		ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ИндивидуальныйПредприниматель))";
		Запрос.УстановитьПараметр("Ссылки", СсылкиКонтрагентов);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(Выборка.Ссылка, Истина);
		КонецЦикла;
	ИначеЕсли СсылкиКонтрагентов.Количество() > 0
		И ЕстьРеквизитИПеречисление("Контрагенты", "ЮридическоеФизическоеЛицо", "ЮридическоеФизическоеЛицо") Тогда
		// УНФ: вид контрагента - реквизит ЮридическоеФизическоеЛицо.
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка В (&Ссылки)
		|	И Контрагенты.ЮридическоеФизическоеЛицо = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ФизическоеЛицо)";
		Запрос.УстановитьПараметр("Ссылки", СсылкиКонтрагентов);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(Выборка.Ссылка, Истина);
		КонецЦикла;
	КонецЕсли;

	Если СсылкиПартнеров.Количество() > 0 И ЕстьРеквизитИПеречисление("Партнеры", "ЮрФизЛицо", "КомпанияЧастноеЛицо") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Партнеры.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Партнеры КАК Партнеры
		|ГДЕ
		|	Партнеры.Ссылка В (&Ссылки)
		|	И Партнеры.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.КомпанияЧастноеЛицо.ЧастноеЛицо)";
		Запрос.УстановитьПараметр("Ссылки", СсылкиПартнеров);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(Выборка.Ссылка, Истина);
		КонецЦикла;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Скрывает в тексте персональные данные и секреты: СНИЛС, телефоны, карты, лицевые счета физлиц,
// паспорт, почту, секреты вида ключ=значение и PEM. ИНН организации (10 цифр) не скрывается.
// ФИО из стоп-словаря и 12-значный ИНН физлица или ИП заменяет обратимыми псевдонимами (см. РаскрытьПсевдонимы).
//
// Параметры:
//  Текст - Строка
//  КоличествоЗамен - Число - увеличивается на число скрытых фрагментов.
//
// Возвращаемое значение:
//  Строка
//  Категории - Массив из Строка, Неопределено - категории находок без исходных значений.
//
Функция ОчиститьТекст(Знач Текст, КоличествоЗамен = 0, Категории = Неопределено) Экспорт

	Если ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;

	ДоПроверки = КоличествоЗамен;
	Текст = СкрытьСекреты(Текст, КоличествоЗамен);
	Если Категории <> Неопределено И КоличествоЗамен > ДоПроверки Тогда
		Категории.Добавить("Секреты");
	КонецЕсли;
	ДоПроверки = КоличествоЗамен;
	Текст = СкрытьПочту(Текст, КоличествоЗамен);
	Если Категории <> Неопределено И КоличествоЗамен > ДоПроверки Тогда
		Категории.Добавить("Электронная почта");
	КонецЕсли;
	ДоПроверки = КоличествоЗамен;
	Текст = СкрытьНомера(Текст, КоличествоЗамен);
	Если Категории <> Неопределено И КоличествоЗамен > ДоПроверки Тогда
		Категории.Добавить("Номера документов/контактов");
	КонецЕсли;
	// ФИО не блокируют вопрос и не считаются находкой: модель получает псевдоним, пользователь - ФИО.
	Текст = ЗаменитьФИОПсевдонимами(Текст);
	Возврат Текст;

КонецФункции

// Строит стоп-словарь ФИО (без кэша). Используется ИИА_ПериметрПовтИсп.
// Источники:
//  - регистр сведений ФИОФизическихЛиц: фамилия, имя и отчество разложены по полям; берутся все записи
//    истории, чтобы скрывать и прежние фамилии;
//  - наименования контрагентов, партнёров и организаций - физлиц и ИП («ИП Иванов Иван Иванович»,
//    «Петров П.П.»): строковые реквизиты и ячейки отчётов с их именем не должны уходить модели.
//
// Возвращаемое значение:
//  ФиксированноеСоответствие из КлючИЗначение:
//   * Ключ - Строка - нормализованные "ФАМИЛИЯ ИМЯ", "ФАМИЛИЯ ИМЯ ОТЧЕСТВО", "ФАМИЛИЯ И", "ИМЯ ОТЧЕСТВО".
//   * Значение - Строка - представление этой формы ФИО («Иванов И.»).
//
Функция ПостроитьСловарьФИО() Экспорт

	Словарь = Новый Соответствие;

	УстановитьПривилегированныйРежим(Истина);
	Если Метаданные.РегистрыСведений.Найти("ФИОФизическихЛиц") <> Неопределено Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1000000
		|	ФИО.Фамилия КАК Фамилия,
		|	ФИО.Имя КАК Имя,
		|	ФИО.Отчество КАК Отчество
		|ИЗ
		|	РегистрСведений.ФИОФизическихЛиц КАК ФИО";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ДобавитьФИОВСловарь(Словарь, Выборка.Фамилия, Выборка.Имя, Выборка.Отчество);
		КонецЦикла;
	КонецЕсли;

	ТекстыЗапросов = ТекстыЗапросовФизлиц();
	Если ЕстьРеквизитИПеречисление("Организации", "ЮрФизЛицо", "ЮрФизЛицо") Тогда
		ТекстыЗапросов.Добавить(
		"ВЫБРАТЬ О.Ссылка КАК Ссылка, О.Наименование КАК Представление
		|ИЗ Справочник.Организации КАК О
		|ГДЕ О.ЮрФизЛицо В (ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо),
		|	ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ИндивидуальныйПредприниматель))");
	ИначеЕсли ЕстьРеквизитИПеречисление("Организации", "ЮридическоеФизическоеЛицо", "ЮридическоеФизическоеЛицо") Тогда
		// УНФ: организация - индивидуальный предприниматель.
		ТекстыЗапросов.Добавить(
		"ВЫБРАТЬ О.Ссылка КАК Ссылка, О.Наименование КАК Представление
		|ИЗ Справочник.Организации КАК О
		|ГДЕ О.ЮридическоеФизическоеЛицо = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ФизическоеЛицо)");
	КонецЕсли;
	Если ТекстыЗапросов.Количество() > 0 Тогда
		Запрос = Новый Запрос(СтрСоединить(ТекстыЗапросов, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС));
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ДобавитьФИОИзНаименования(Словарь, Выборка.Представление);
		КонецЦикла;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Новый ФиксированноеСоответствие(Словарь);

КонецФункции

// Заглушка для скрытого значения.
//
// Возвращаемое значение:
//  Строка
//
Функция ЗаглушкаСкрыто() Экспорт
	Возврат НСтр("ru = '[скрыто]'");
КонецФункции

// Заглушка для контрагента-физлица или ИП.
//
// Возвращаемое значение:
//  Строка
//
Функция ЗаглушкаФизлицо() Экспорт
	Возврат НСтр("ru = '[физлицо скрыто]'");
КонецФункции

#Область Маскирование

// Маскирование персональных данных: данные маскируются для модели, но не для пользователя.
// Ссылки маскируемых типов (пользователи) передаются модели стабильными псевдонимами вида
// «Пользователь_3f2a1c0d8e»: хеш SHA-256 от UUID с секретной солью базы. Реквизиты маскируемых объектов
// (ФИО, контакты) модели недоступны, доступна только ссылка - поэтому работают группировки и отборы.
// Пользователю ответ и таблицы показываются с раскрытыми псевдонимами (РаскрытьПсевдонимы).

// Маскируется ли ссылочный тип.
//
// Параметры:
//  ПроверяемыйТип - Тип
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоМаскируемыйТип(ПроверяемыйТип) Экспорт

	Возврат ИИА_ПериметрПовтИсп.ДанныеМаскирования().Префиксы.Получить(ПроверяемыйТип) <> Неопределено;

КонецФункции

// Псевдоним ссылки маскируемого типа.
//
// Параметры:
//  Ссылка - ЛюбаяСсылка
//
// Возвращаемое значение:
//  Строка
//
Функция Псевдоним(Ссылка) Экспорт

	Данные = ИИА_ПериметрПовтИсп.ДанныеМаскирования();
	Префикс = Данные.Префиксы.Получить(ТипЗнч(Ссылка));
	Если Префикс = Неопределено Или Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат ЗаглушкаСкрыто();
	КонецЕсли;
	Возврат ПсевдонимПоИдентификатору(Префикс, Данные.Соль, Ссылка.УникальныйИдентификатор());

КонецФункции

// Псевдоним контрагента или партнёра - физлица (ИП).
//
// Параметры:
//  Ссылка - СправочникСсылка.Контрагенты, СправочникСсылка.Партнеры
//
// Возвращаемое значение:
//  Строка
//
Функция ПсевдонимФизлица(Ссылка) Экспорт

	Возврат ПсевдонимПоИдентификатору(ПрефиксФизлица(), ИИА_ПериметрПовтИсп.ДанныеМаскирования().Соль,
		Ссылка.УникальныйИдентификатор());

КонецФункции

// Ссылка по псевдониму (для параметров запроса модели).
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  ЛюбаяСсылка, Неопределено
//
Функция СсылкаПоПсевдониму(Текст) Экспорт

	Если ТипЗнч(Текст) <> Тип("Строка") Или СтрНайти(Текст, "_") = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Найдено = НайтиПсевдоним(НРег(СокрЛП(Текст)));
	Возврат ?(Найдено = Неопределено, Неопределено, Найдено.Ссылка);

КонецФункции

// Значение псевдонима (ПДн или коммерческого) без учёта прав пользователя.
//
// Параметры:
//  Псевдоним - Строка
//
// Возвращаемое значение:
//  Структура, Неопределено:
//   * Ссылка - ЛюбаяСсылка, Строка, Неопределено - ссылка, строка ИНН или Неопределено (ФИО).
//   * Представление - Строка
//
Функция ЗначениеПсевдонима(Псевдоним) Экспорт

	Если ТипЗнч(Псевдоним) <> Тип("Строка") Или СтрНайти(Псевдоним, "_") = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НайтиПсевдоним(НРег(СокрЛП(Псевдоним)));

КонецФункции

// Заменяет псевдонимы в тексте на представления (для показа пользователю, не модели).
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция РаскрытьПсевдонимы(Знач Текст) Экспорт

	Если ТипЗнч(Текст) <> Тип("Строка") Или СтрНайти(Текст, "_") = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	// ПДн и коммерческие псевдонимы (ИИА_Маскирование) с границами слова.
	Совпадения = ИИА_Маскирование.НайтиПсевдонимыВТексте(Текст);
	Для Индекс = -Совпадения.ВГраница() По 0 Цикл
		Совпадение = Совпадения[-Индекс];
		Найдено = НайтиПсевдоним(НРег(Совпадение.Псевдоним));
		Если Найдено <> Неопределено Тогда
			Текст = Лев(Текст, Совпадение.Начало - 1) + Найдено.Представление
				+ Сред(Текст, Совпадение.Начало + Совпадение.Длина);
		КонецЕсли;
	КонецЦикла;
	Возврат Текст;

КонецФункции

// Раскрывает псевдонимы во всех строках значения без учёта прав и номеров диалога (для поиска по аргументам).
// Для показа пользователю - ИИА_Маскирование.ДляПользователя.
//
// Параметры:
//  Значение - Произвольный
//
// Возвращаемое значение:
//  Произвольный - копия с раскрытыми псевдонимами.
//
Функция РаскрытьПсевдонимыВЗначении(Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат РаскрытьПсевдонимы(Значение);
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Или ТипЗнч(Значение) = Тип("ФиксированныйМассив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(РаскрытьПсевдонимыВЗначении(Элемент));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли ТипЗнч(Значение) = Тип("Структура") Или ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Новый Структура;
		Для Каждого КлючИЗначение Из Значение Цикл
			Результат.Вставить(КлючИЗначение.Ключ, РаскрытьПсевдонимыВЗначении(КлючИЗначение.Значение));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") Или ТипЗнч(Значение) = Тип("ФиксированноеСоответствие") Тогда
		Результат = Новый Соответствие;
		Для Каждого КлючИЗначение Из Значение Цикл
			Результат.Вставить(КлючИЗначение.Ключ, РаскрытьПсевдонимыВЗначении(КлючИЗначение.Значение));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Заменяет в тексте пользователя представления маскируемых объектов (ФИО пользователей) на псевдонимы,
// чтобы вопрос «продажи Иванова Ивана» дошёл до модели без ФИО, но с возможностью отбора.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ЗамаскироватьИмена(Знач Текст) Экспорт

	Если ТипЗнч(Текст) <> Тип("Строка") Или ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	Для Каждого Элемент Из ИИА_ПериметрПовтИсп.ДанныеМаскирования().Имена Цикл
		Если СтрНайти(Текст, Элемент.Представление) > 0 Тогда
			Текст = СтрЗаменить(Текст, Элемент.Представление, Элемент.Псевдоним);
		КонецЕсли;
	КонецЦикла;
	Возврат Текст;

КонецФункции

// Данные маскирования для повторного использования в сеансе.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура:
//   * Префиксы - ФиксированноеСоответствие из КлючИЗначение - Тип -> префикс псевдонима.
//   * Соль - Строка
//   * Карта - ФиксированноеСоответствие из КлючИЗначение - псевдоним в нижнем регистре -> Структура (Ссылка, Представление).
//   * Имена - ФиксированныйМассив из Структура - Представление, Псевдоним; от длинных представлений к коротким.
//   * Шаблон - Строка - регулярное выражение псевдонима.
//
Функция ПостроитьДанныеМаскирования() Экспорт

	Префиксы = Новый Соответствие;
	Карта = Новый Соответствие;
	Шаблоны = Новый Массив;
	ТаблицаИмен = Новый ТаблицаЗначений;
	ТаблицаИмен.Колонки.Добавить("Представление");
	ТаблицаИмен.Колонки.Добавить("Псевдоним");
	ТаблицаИмен.Колонки.Добавить("Длина");

	УстановитьПривилегированныйРежим(Истина);
	Соль = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("ИИАссистент.Маскирование", "Соль");
	Если Не ЗначениеЗаполнено(Соль) Тогда
		Соль = Строка(Новый УникальныйИдентификатор) + Строка(Новый УникальныйИдентификатор);
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище("ИИАссистент.Маскирование", Соль, "Соль");
	КонецЕсли;

	Для Каждого Описание Из МаскируемыеОбъекты() Цикл
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Описание.Ключ);
		Если ОбъектМетаданных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Префиксы.Вставить(ТипСсылкиОбъекта(ОбъектМетаданных), Описание.Значение);
		Шаблоны.Добавить(Описание.Значение);
		Запрос = Новый Запрос(СтрШаблон("ВЫБРАТЬ Т.Ссылка КАК Ссылка, Т.Наименование КАК Представление ИЗ %1 КАК Т",
			ОбъектМетаданных.ПолноеИмя()));
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Псевдоним = ПсевдонимПоИдентификатору(Описание.Значение, Соль, Выборка.Ссылка.УникальныйИдентификатор());
			Представление = СокрЛП(Выборка.Представление);
			Карта.Вставить(НРег(Псевдоним), Новый Структура("Ссылка, Представление", Выборка.Ссылка, Представление));
			Если СтрДлина(Представление) >= 5 Тогда
				НоваяСтрока = ТаблицаИмен.Добавить();
				НоваяСтрока.Представление = Представление;
				НоваяСтрока.Псевдоним = Псевдоним;
				НоваяСтрока.Длина = СтрДлина(Представление);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);

	// Длинные представления заменяются первыми: «Иванов Иван Иванович» раньше, чем «Иванов Иван».
	ТаблицаИмен.Сортировать("Длина Убыв");
	Имена = Новый Массив;
	Для Каждого Имя Из ТаблицаИмен Цикл
		Имена.Добавить(Новый ФиксированнаяСтруктура("Представление, Псевдоним", Имя.Представление, Имя.Псевдоним));
	КонецЦикла;

	Шаблоны.Добавить(ПрефиксФизлица());
	Шаблоны.Добавить(ПрефиксФИО());
	Шаблоны.Добавить(ПрефиксИНН());
	Шаблон ="(" + СтрСоединить(Шаблоны, "|") + ")_[0-9a-fA-F]{10}";
	Возврат Новый ФиксированнаяСтруктура("Префиксы, Соль, Карта, Имена, Шаблон",
		Новый ФиксированноеСоответствие(Префиксы), Соль, Новый ФиксированноеСоответствие(Карта),
		Новый ФиксированныйМассив(Имена), Шаблон);

КонецФункции

// Карта псевдонимов контрагентов и партнёров - физлиц и ИП. Строится лениво (только когда в тексте или
// параметре встретился псевдоним физлица) и кэшируется на сеанс: физлиц может быть много.
//
// Возвращаемое значение:
//  ФиксированноеСоответствие из КлючИЗначение - псевдоним в нижнем регистре -> Структура (Ссылка, Представление).
//
Функция ПостроитьКартуФизлиц() Экспорт

	Карта = Новый Соответствие;
	Соль = ИИА_ПериметрПовтИсп.ДанныеМаскирования().Соль;
	Префикс = ПрефиксФизлица();
	Тексты = ТекстыЗапросовФизлиц();
	Если Тексты.Количество() = 0 Тогда
		Возврат Новый ФиксированноеСоответствие(Карта);
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(СтрСоединить(Тексты, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Псевдоним = ПсевдонимПоИдентификатору(Префикс, Соль, Выборка.Ссылка.УникальныйИдентификатор());
		Карта.Вставить(НРег(Псевдоним), Новый Структура("Ссылка, Представление", Выборка.Ссылка,
			СокрЛП(Выборка.Представление)));
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Новый ФиксированноеСоответствие(Карта);

КонецФункции

// Карта псевдонимов 12-значных ИНН (физлица и ИП). Строится лениво, когда в тексте или параметре
// встретился псевдоним ИНН, и кэшируется на сеанс. Источник - реквизит ИНН справочников конфигурации.
// ИНН, которого нет в справочниках (например, введённый пользователем), обратно не раскрывается.
//
// Возвращаемое значение:
//  ФиксированноеСоответствие из КлючИЗначение - псевдоним в нижнем регистре -> Структура (Ссылка, Представление):
//   Ссылка и Представление - Строка - сам ИНН (в параметре запроса псевдоним превращается в строку ИНН).
//
Функция ПостроитьКартуИНН() Экспорт

	Карта = Новый Соответствие;
	Соль = ИИА_ПериметрПовтИсп.ДанныеМаскирования().Соль;
	Префикс = ПрефиксИНН();
	Тексты = Новый Массив;
	Для Каждого Справочник Из Метаданные.Справочники Цикл
		Реквизит = Справочник.Реквизиты.Найти("ИНН");
		Если Реквизит = Неопределено Или Не Реквизит.Тип.СодержитТип(Тип("Строка")) Тогда
			Продолжить;
		КонецЕсли;
		Тексты.Добавить(СтрШаблон(
			"ВЫБРАТЬ ВЫРАЗИТЬ(Т.ИНН КАК СТРОКА(12)) КАК ИНН ИЗ %1 КАК Т ГДЕ Т.ИНН ПОДОБНО ""____________""",
			Справочник.ПолноеИмя()));
	КонецЦикла;
	Если Тексты.Количество() = 0 Тогда
		Возврат Новый ФиксированноеСоответствие(Карта);
	КонецЕсли;

	ТипСтрока = Новый ОписаниеТипов("Строка");
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(СтрСоединить(Тексты, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ИНН = ТипСтрока.ПривестиЗначение(Выборка.ИНН);
		Если ЭтоИННФизлица(ИНН) Тогда
			Карта.Вставить(НРег(ПсевдонимПоИдентификатору(Префикс, Соль, ИНН)),
				Новый Структура("Ссылка, Представление", ИНН, ИНН));
		КонецЕсли;
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Новый ФиксированноеСоответствие(Карта);

КонецФункции

// Карта псевдонимов ФИО (без кэша). Используется ИИА_ПериметрПовтИсп: строится, когда в тексте
// для пользователя встретился псевдоним ФИО.
//
// Возвращаемое значение:
//  ФиксированноеСоответствие из КлючИЗначение - псевдоним в нижнем регистре -> Структура (Ссылка, Представление).
//
Функция ПостроитьКартуФИО() Экспорт

	Карта = Новый Соответствие;
	Соль = ИИА_ПериметрПовтИсп.ДанныеМаскирования().Соль;
	Префикс = ПрефиксФИО();
	Для Каждого Форма Из ИИА_ПериметрПовтИсп.СловарьФИО() Цикл
		Карта.Вставить(НРег(ПсевдонимПоИдентификатору(Префикс, Соль, Форма.Ключ)),
			Новый Структура("Ссылка, Представление", Неопределено, Форма.Значение));
	КонецЦикла;
	Возврат Новый ФиксированноеСоответствие(Карта);

КонецФункции

