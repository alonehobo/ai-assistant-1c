// /////////////////////////////////////////////////////////////////////////////////////////////////////
// ИИ-ассистент: поиск по исходному коду своей внешней компонентой (общий макет ИИА_ПоискКода, класс
// IIACodeSearch, исходники - native/code-search). Индекса и внешних сервисов нет: компонента читает
// XML-выгрузку конфигурации, расширений и внешних отчётов и обработок при каждом запросе.
// Путь к выгрузке - константа ИИА_ПутьКИсходникам. Выгрузка лежит на сервере 1С или, если включена
// ИИА_ИсходникиНаКлиенте, на компьютере пользователя: тогда поиск выполняет окно чата во время паузы хода
// (тот же механизм, что у form_layout, см. ИИА_Агент), а сюда приходит готовый ответ компоненты.
// Компонента читает файлы только ниже корня; запрос модели проходит здесь белый список полей.
// Вывод очищается от секретов и ПДн так же, как код из rlm (ИИА_Периметр).
// /////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Путь к выгрузке исходников из настроек.
//
// Возвращаемое значение:
//  Строка
//
Функция ПутьКИсходникам() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Возврат СокрЛП(Константы.ИИА_ПутьКИсходникам.Получить());

КонецФункции

// Выгрузка лежит на компьютере пользователя, а не на сервере 1С.
//
// Возвращаемое значение:
//  Булево
//
Функция ИсходникиНаКлиенте() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Возврат Константы.ИИА_ИсходникиНаКлиенте.Получить() = Истина;

КонецФункции

// Задан ли путь к исходникам (без обращения к компоненте).
//
// Возвращаемое значение:
//  Булево
//
Функция ПоискДоступен() Экспорт

	Возврат ЗначениеЗаполнено(ПутьКИсходникам());

КонецФункции

// Инструмент поиска по коду.
//
// Параметры:
//  Имя - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоИнструментПоиска(Имя) Экспорт

	Возврат Имя = ИмяПоиска() Или Имя = ИмяЧтения();

КонецФункции

// Описания инструментов в формате OpenAI tools: пусто, если путь не задан или исходники на клиенте,
// а клиента чата нет.
//
// Параметры:
//  Канал - Строка - "chat" или "http" (внешний API).
//
// Возвращаемое значение:
//  Массив из Соответствие
//
Функция ОписанияИнструментов(Канал = "http") Экспорт

	Инструменты = Новый Массив;
	Если Не ПоискДоступен() Или Канал <> "chat" И ИсходникиНаКлиенте() Тогда
		Возврат Инструменты;
	КонецЕсли;
	Если Не ИИА_ПрофилиДоступа.ИнструментЗапрещенПрофилем(ИмяПоиска()) Тогда
		Инструменты.Добавить(ОписаниеИнструментаПоиска());
	КонецЕсли;
	Если Не ИИА_ПрофилиДоступа.ИнструментЗапрещенПрофилем(ИмяЧтения()) Тогда
		Инструменты.Добавить(ОписаниеИнструментаЧтения());
	КонецЕсли;
	Возврат Инструменты;

КонецФункции

// Ключ запроса для окна чата, когда исходники на компьютере пользователя: «code#<операция>#<запрос JSON>».
// Форма описания - как у ИИА_ИсходныйКод.КлючСтруктурыФормыИнструмента, чтобы ход встал на паузу тем же путём.
//
// Параметры:
//  Имя - Строка - code_search или code_read.
//  Аргументы - Строка, Соответствие - аргументы инструмента.
//
// Возвращаемое значение:
//  Структура:
//   * Ключ - Строка - пусто, если запрос не составлен (см. Ошибка).
//   * Форма - Строка - всегда пусто.
//   * КлючОбъекта - Неопределено
//   * Ошибка - Строка
//   * Текст - Строка
//   * ОбъектМетаданных - Неопределено
//   * ФормаМетаданных - Неопределено
//
Функция КлючЗапросаКлиента(Имя, Знач Аргументы) Экспорт

	Описание = Новый Структура("Ключ, Форма, КлючОбъекта, Ошибка, Текст, ОбъектМетаданных, ФормаМетаданных");
	Запрос = ЗапросКомпоненты(Имя, Аргументы);
	Описание.Ошибка = Запрос.Ошибка;
	Описание.Текст = Запрос.Текст;
	Описание.Форма = "";
	Описание.Ключ = ?(ПустаяСтрока(Запрос.Ошибка), КлючЗапроса(Запрос), "");
	Возврат Описание;

КонецФункции

// Префикс ключа запроса к окну чата: по нему окно отличает поиск по коду от структуры формы.
//
// Возвращаемое значение:
//  Строка
//
Функция ПрефиксКлючаКлиента() Экспорт

	Возврат "code#";

КонецФункции

// Выполняет инструмент поиска.
//
// Параметры:
//  Имя - Строка - code_search или code_read.
//  Аргументы - Соответствие
//  Результат - Структура - см. ИИА_Инструменты.ВыполнитьИнструмент.
//  СтруктурыФорм - Соответствие, Неопределено - ответы окна чата по ключам КлючЗапросаКлиента.
//
// Возвращаемое значение:
//  Структура - Результат.
//
Функция ВыполнитьИнструмент(Имя, Аргументы, Результат, СтруктурыФорм = Неопределено) Экспорт

	Если Не ПоискДоступен() Тогда
		Возврат Отказ(Результат, "ACCESS_DENIED",
			НСтр("ru = 'Поиск по коду не настроен: не задан путь к исходникам в настройках ассистента.'"));
	КонецЕсли;
	Если ИИА_ПрофилиДоступа.ИнструментЗапрещенПрофилем(Имя) Тогда
		Возврат Отказ(Результат, "TOOL_DISABLED", НСтр("ru = 'Инструмент выключен профилем.'"));
	КонецЕсли;
	Запрос = ЗапросКомпоненты(Имя, Аргументы);
	Если Не ПустаяСтрока(Запрос.Ошибка) Тогда
		Возврат Отказ(Результат, Запрос.Ошибка, Запрос.Текст);
	КонецЕсли;
	Если ИсходникиНаКлиенте() Тогда
		Возврат РезультатКлиента(Запрос, Результат, СтруктурыФорм);
	КонецЕсли;

	Попытка
		Ответ = ВыполнитьНаСервере(Запрос.Операция, Запрос.Текст);
	Исключение
		ЗаписатьОшибку(ИнформацияОбОшибке());
		Возврат Отказ(Результат, "SERVICE_UNAVAILABLE",
			НСтр("ru = 'Компонента поиска по коду не подключилась на сервере. Подробности - в журнале регистрации.'"));
	КонецПопытки;
	Возврат РезультатОтвета(Ответ, Результат);

КонецФункции

// Выполняет запрос компоненты на сервере 1С.
//
// Параметры:
//  Операция - Строка - find или read.
//  ТекстЗапроса - Строка - JSON запроса компоненты.
//
// Возвращаемое значение:
//  Строка - JSON ответа компоненты.
//
Функция ВыполнитьНаСервере(Операция, ТекстЗапроса) Экспорт

	Компонента = Компонента();
	Если Операция = ОперацияЧтения() Тогда
		Возврат Компонента.ПрочитатьСтроки(ПутьКИсходникам(), ТекстЗапроса);
	КонецЕсли;
	Возврат Компонента.Найти(ПутьКИсходникам(), ТекстЗапроса);

КонецФункции

// Проверка для формы настроек на сервере 1С: подключает компоненту, считает модули и время контрольного поиска.
//
// Параметры:
//  Путь - Строка - проверяемый путь (ещё не записанный в настройки).
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * Текст - Строка
//
Функция ПроверитьНаСервере(Знач Путь) Экспорт

	Путь = СокрЛП(Путь);
	Если ПустаяСтрока(Путь) Тогда
		Возврат Новый Структура("Успех, Текст", Ложь, НСтр("ru = 'Укажите путь к выгрузке исходников.'"));
	КонецЕсли;
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Компонента = Компонента();
		Ответ = Компонента.Найти(Путь, ЗапросПроверки());
		Версия = Компонента.Версия();
	Исключение
		ЗаписатьОшибку(ИнформацияОбОшибке());
		Возврат Новый Структура("Успех, Текст", Ложь,
			НСтр("ru = 'Компонента поиска не подключилась на сервере 1С. Подробности - в журнале регистрации.'"));
	КонецПопытки;
	Возврат ИтогПроверки(Ответ, Версия, ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало);

КонецФункции

// Запрос контрольного поиска для проверки настроек: число модулей проекта.
//
// Возвращаемое значение:
//  Строка - JSON запроса компоненты.
//
Функция ЗапросПроверки() Экспорт

	Возврат "{""query"":""Процедура"",""find"":""word"",""output"":""count"",""budget_ms"":60000}";

КонецФункции

// Текст итога проверки по ответу компоненты (общий для сервера и клиента).
//
// Параметры:
//  Ответ - Строка - JSON ответа компоненты.
//  Версия - Строка - версия компоненты.
//  Миллисекунд - Число - время поиска.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * Текст - Строка
//
Функция ИтогПроверки(Ответ, Версия, Миллисекунд) Экспорт

	Результат = Новый Структура("Успех, Текст", Ложь, "");
	Данные = РазобратьОтвет(Ответ);
	Если Данные = Неопределено Тогда
		Результат.Текст = НСтр("ru = 'Компонента вернула не JSON.'");
		Возврат Результат;
	КонецЕсли;
	Ошибка = Данные.Получить("error");
	Если ТипЗнч(Ошибка) = Тип("Соответствие") Тогда
		Результат.Текст = СтрШаблон(НСтр("ru = 'Поиск не выполнен: %1'"), ТекстОшибки(Ошибка));
		Возврат Результат;
	КонецЕсли;
	Всего = Данные.Получить("total_files");
	Если Не ЗначениеЗаполнено(Всего) Тогда
		Результат.Текст = НСтр("ru = 'В каталоге не найдено ни одного модуля: укажите каталог выгрузки
			|(с Configuration.xml или с подкаталогами выгрузок).'");
		Возврат Результат;
	КонецЕсли;
	Результат.Успех = Истина;
	Результат.Текст = СтрШаблон(НСтр("ru = 'Компонента %1: модулей %2, контрольный поиск за %3 с.'"), Версия,
		Формат(Всего, "ЧГ=3,0"), Формат(Миллисекунд / МиллисекундВСекунде(), "ЧДЦ=1; ЧН=0"));
	Если Данные.Получить("stopped") = "time" Тогда
		Результат.Текст = Результат.Текст + " " + НСтр("ru = 'Поиск не уложился во время: выгрузка большая или диск медленный.'");
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяПоиска()

	Возврат "code_search";

КонецФункции

Функция ИмяЧтения()

	Возврат "code_read";

КонецФункции

Функция ОперацияЧтения()

	Возврат "read";

КонецФункции

Функция МиллисекундВСекунде()

	Миллисекунд = 1000;
	Возврат Миллисекунд;

КонецФункции

Функция РежимыПоиска()

	Возврат "text,word,regex,method,calls,overrides,attribute,rights,subscriptions,movements,queries,handlers,references";

КонецФункции

Функция ОписаниеИнструментаПоиска()

	Свойства = Новый Соответствие;
	ДобавитьСтроку(Свойства, "query", НСтр("ru = 'Что искать: текст, слово, регулярное выражение,
		|имя метода (Имя или Модуль.Имя; для method и calls несколько через |: Имя|Другое, до 20),
		|Вид.Имя объекта - по find.'"));
	ДобавитьСтроку(Свойства, "find", НСтр("ru = 'Режим поиска, по умолчанию text.'"));
	Свойства["find"].Вставить("enum", СтрРазделить(РежимыПоиска(), ","));
	ДобавитьСтроку(Свойства, "object", НСтр("ru = 'Только этот объект или его часть: Document.ЗаказКлиента,
		|Документ.ЗаказКлиента.Форма.ФормаДокумента, CommonModule.ОбщегоНазначения.'"));
	ДобавитьСтроку(Свойства, "kind", НСтр("ru = 'Только один вид объектов: Document, CommonModule,
		|ExternalDataProcessor, ExternalReport (можно по-русски).'"));
	ДобавитьСтроку(Свойства, "files", НСтр("ru = 'modules (по умолчанию) - модули .bsl; xml - формы, описания
		|объектов, права; all - все текстовые файлы.'"));
	ДобавитьСтроку(Свойства, "glob", НСтр("ru = 'Маска пути ниже корня: Documents/*/Forms/**, *.xml.'"));
	ДобавитьСтроку(Свойства, "file", НСтр("ru = 'Искать только в этом файле: path из прошлого ответа.'"));
	ДобавитьЧисло(Свойства, "context", НСтр("ru = 'Строк до и после каждого совпадения, до 20.'"));
	ДобавитьФлаг(Свойства, "body", НСтр("ru = 'find=method или queries: вернуть текст метода или запроса.'"));
	ДобавитьЧисло(Свойства, "limit", НСтр("ru = 'Сколько совпадений вернуть, по умолчанию 50.'"));
	ДобавитьСтроку(Свойства, "output", НСтр("ru = 'hits (по умолчанию) - совпадения; files - файлы с числом
		|совпадений; count - только итоги.'"));
	ДобавитьФлаг(Свойства, "match_case", НСтр("ru = 'text, word, regex: с учётом регистра.'"));
	ДобавитьСтроку(Свойства, "cursor", НСтр("ru = 'next_cursor прошлого ответа - продолжение того же поиска.'"));
	Возврат ОписаниеИнструмента(ИмяПоиска(), ОписаниеПоиска(), Свойства, "query");

КонецФункции

Функция ОписаниеИнструментаЧтения()

	Свойства = Новый Соответствие;
	ДобавитьСтроку(Свойства, "file", НСтр("ru = 'path из ответа code_search.'"));
	ДобавитьЧисло(Свойства, "start_line", НСтр("ru = 'С какой строки, по умолчанию 1.'"));
	ДобавитьЧисло(Свойства, "limit", НСтр("ru = 'Сколько строк, по умолчанию 200, до 1000.'"));
	Описание = НСтр("ru = 'Строки файла исходников по пути из code_search. Метод целиком дешевле получить
		|code_search с find=method и body=true.'");
	Возврат ОписаниеИнструмента(ИмяЧтения(), Описание, Свойства, "file");

КонецФункции

Функция ОписаниеПоиска()

	Возврат НСтр("ru = 'Поиск по исходному коду конфигурации, её расширений и внешних отчётов и обработок.
		|find: text - часть строки; word - слово целиком; regex - регулярное выражение по строке;
		|method - где определён метод (body=true - его текст); calls - где вызывается метод, без комментариев и строк;
		|overrides - что перехватывают расширения (object=Вид.Имя);
		|attribute - реквизиты, измерения, ресурсы, табличные части по части имени, синонима или типа;
		|rights - роли с правами на Вид.Имя; subscriptions - подписки на события объекта;
		|movements - регистры документа или документы регистра; queries - запросы, читающие Вид.Имя;
		|handlers - события форм, подписки и задания, вызывающие метод;
		|references - где упоминается Вид.Имя в метаданных и коде.
		|В ответе path - путь файла для code_read, module - модуль, method - метод вокруг строки.
		|stopped=limit или time и next_cursor - есть продолжение: повтори запрос с cursor.'");

КонецФункции

// Запрос компоненты по аргументам модели: только известные поля и типы.
//
// Возвращаемое значение:
//  Структура:
//   * Операция - Строка - find или read.
//   * Текст - Строка - JSON запроса или причина отказа.
//   * Ошибка - Строка - код отказа, пусто - запрос составлен.
//
Функция ЗапросКомпоненты(Имя, Знач Аргументы)

	Запрос = Новый Структура("Операция, Текст, Ошибка", "", "", "");
	Аргументы = РазобранныеАргументы(Аргументы);
	Если Аргументы = Неопределено Тогда
		Возврат ОтказЗапроса(Запрос, НСтр("ru = 'Аргументы инструмента должны быть JSON-объектом.'"));
	КонецЕсли;
	Если Имя = ИмяЧтения() Тогда
		Запрос.Операция = ОперацияЧтения();
		Поля = ПоляАргументов(Аргументы, "file", "start_line,limit", "");
		Если Поля.Получить("file") = Неопределено Тогда
			Возврат ОтказЗапроса(Запрос, НСтр("ru = 'Передайте file: path из ответа code_search.'"));
		КонецЕсли;
	ИначеЕсли Имя = ИмяПоиска() Тогда
		Запрос.Операция = "find";
		Поля = ПоляАргументов(Аргументы, "query,find,kind,object,glob,file,files,output,cursor", "context,limit",
			"body,match_case,multiline");
		Причина = ПричинаОтказаПоиска(Поля);
		Если Не ПустаяСтрока(Причина) Тогда
			Возврат ОтказЗапроса(Запрос, Причина);
		КонецЕсли;
		Поля.Вставить("budget_ms", 30000);
	Иначе
		Запрос.Ошибка = "UNKNOWN_TOOL";
		Запрос.Текст = НСтр("ru = 'Неизвестный инструмент поиска по коду.'");
		Возврат Запрос;
	КонецЕсли;

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Поля);
	Запрос.Текст = Запись.Закрыть();
	Возврат Запрос;

КонецФункции

Функция РазобранныеАргументы(Аргументы)

	Значение = Аргументы;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Попытка
			Значение = ОбщегоНазначения.JSONВЗначение(Значение, , Истина);
		// Не JSON - вызывающий вернёт понятный отказ.
		Исключение // BSLLS:MissingCodeTryCatchEx-off
			Значение = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Возврат ?(ТипЗнч(Значение) = Тип("Соответствие"), Значение, Неопределено);

КонецФункции

// Поля запроса из аргументов: строки (непустые, до 2000 символов), положительные целые и флаги Истина.
Функция ПоляАргументов(Аргументы, Строки, Числа, Флаги)

	Поля = Новый Соответствие;
	Для Каждого Поле Из СтрРазделить(Строки, ",", Ложь) Цикл
		Значение = Аргументы.Получить(Поле);
		Если ТипЗнч(Значение) = Тип("Строка") И Не ПустаяСтрока(Значение) Тогда
			Поля.Вставить(Поле, Лев(Значение, 2000));
		КонецЕсли;
	КонецЦикла;
	Для Каждого Поле Из СтрРазделить(Числа, ",", Ложь) Цикл
		Значение = Аргументы.Получить(Поле);
		Если ТипЗнч(Значение) = Тип("Число") И Значение > 0 Тогда
			Поля.Вставить(Поле, Мин(Цел(Значение), 100000));
		КонецЕсли;
	КонецЦикла;
	Для Каждого Поле Из СтрРазделить(Флаги, ",", Ложь) Цикл
		Если Аргументы.Получить(Поле) = Истина Тогда
			Поля.Вставить(Поле, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Поля;

КонецФункции

Функция ПричинаОтказаПоиска(Поля)

	Режим = Поля.Получить("find");
	Если Режим <> Неопределено И СтрРазделить(РежимыПоиска(), ",").Найти(Режим) = Неопределено Тогда
		Возврат СтрШаблон(НСтр("ru = 'find - одно из: %1.'"), СтрЗаменить(РежимыПоиска(), ",", ", "));
	КонецЕсли;
	Если Поля.Получить("query") = Неопределено И Режим <> "overrides" И Режим <> "handlers" Тогда
		Возврат НСтр("ru = 'Передайте query: что искать.'");
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ОтказЗапроса(Запрос, Текст)

	Запрос.Ошибка = "BAD_ARGUMENTS";
	Запрос.Текст = Текст;
	Возврат Запрос;

КонецФункции

Функция КлючЗапроса(Запрос)

	Возврат ПрефиксКлючаКлиента() + Запрос.Операция + "#" + Запрос.Текст;

КонецФункции

// Ответ окна чата: JSON компоненты или причина, по которой окно поиск не выполнило.
Функция РезультатКлиента(Запрос, Результат, СтруктурыФорм)

	Ответ = Неопределено;
	Если СтруктурыФорм <> Неопределено Тогда
		Ответ = СтруктурыФорм.Получить(КлючЗапроса(Запрос));
	КонецЕсли;
	Если ТипЗнч(Ответ) <> Тип("Строка") Или ПустаяСтрока(Ответ) Тогда
		Возврат Отказ(Результат, "CLIENT_UNAVAILABLE",
			НСтр("ru = 'Исходники лежат на компьютере пользователя, а окно чата не выполнило поиск: открой чат и повтори.'"));
	КонецЕсли;
	Если Не СтрНачинаетсяС(СокрЛ(Ответ), "{") Тогда
		// Причина от окна или от хода (окно закрыто, компонента не подключилась).
		Возврат Отказ(Результат, "CLIENT_UNAVAILABLE", ОчиститьСтроку(Лев(Ответ, ДлинаПричины())));
	КонецЕсли;
	Возврат РезультатОтвета(Ответ, Результат);

КонецФункции

Функция ДлинаПричины()

	Длина = 1000;
	Возврат Длина;

КонецФункции

Функция Компонента()

	// Изолированно: ошибка компоненты не роняет рабочий процесс сервера. Платформа кэширует подключение на сеанс.
	Если Не ПодключитьВнешнююКомпоненту("ОбщийМакет.ИИА_ПоискКода", "ИИАПоискКода", ТипВнешнейКомпоненты.Native,
		ТипПодключенияВнешнейКомпоненты.Изолированно) Тогда
		ВызватьИсключение НСтр("ru = 'Внешняя компонента ИИА_ПоискКода не подключилась.'");
	КонецЕсли;
	Возврат Новый("AddIn.ИИАПоискКода.IIACodeSearch");

КонецФункции

Процедура ЗаписатьОшибку(Информация)

	ЗаписьЖурналаРегистрации(НСтр("ru = 'ИИАссистент.ПоискКода'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Ошибка, , , ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));

КонецПроцедуры

// Ответ компоненты -> результат инструмента: текст кода очищен, ошибка компоненты - отказ.
Функция РезультатОтвета(Ответ, Результат)

	Данные = РазобратьОтвет(Ответ);
	Если Данные = Неопределено Тогда
		Возврат Отказ(Результат, "SERVICE_UNAVAILABLE", НСтр("ru = 'Компонента поиска вернула не JSON.'"));
	КонецЕсли;
	Ошибка = Данные.Получить("error");
	Если ТипЗнч(Ошибка) = Тип("Соответствие") Тогда
		Код = Ошибка.Получить("code");
		Возврат Отказ(Результат, ?(ЗначениеЗаполнено(Код), Строка(Код), "SEARCH_ERROR"), ТекстОшибки(Ошибка));
	КонецЕсли;
	Данные.Удалить("elapsed_ms");
	Замен = 0;
	ОчиститьЗначение(Данные, Замен);
	Если Замен > 0 Тогда
		Данные.Вставить("redacted", Замен);
	КонецЕсли;
	Результат.Успех = Истина;
	Результат.Итог = "OK";
	Результат.Класс = 1; // исходный код, включая доработки, - К1
	Результат.Строк = ЧислоСтрок(Данные);
	Результат.Данные = Данные;
	Возврат Результат;

КонецФункции

Функция ЧислоСтрок(Данные)

	Совпадения = Данные.Получить("hits");
	Если ТипЗнч(Совпадения) = Тип("Число") Тогда
		Возврат Совпадения;
	КонецЕсли;
	Строки = Данные.Получить("lines");
	Возврат ?(ТипЗнч(Строки) = Тип("Массив"), Строки.Количество(), 0);

КонецФункции

Функция РазобратьОтвет(Ответ)

	Если ТипЗнч(Ответ) <> Тип("Строка") Или Не СтрНачинаетсяС(СокрЛ(Ответ), "{") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат РазобранныеАргументы(Ответ);

КонецФункции

Функция ТекстОшибки(Ошибка)

	Текст = Ошибка.Получить("message");
	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		Текст = Строка(Ошибка.Получить("code"));
	КонецЕсли;
	Возврат ОчиститьСтроку(Текст);

КонецФункции

// Очищает строки кода в ответе: текст строки, тело метода, контекст и строки файла.
Процедура ОчиститьЗначение(Значение, Замен)

	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Ключи = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Ключи.Добавить(Элемент.Ключ);
		КонецЦикла;
		Для Каждого Ключ Из Ключи Цикл
			Значение.Вставить(Ключ, ОчищенноеЗначение(Значение.Получить(Ключ), Замен));
		КонецЦикла;
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Индекс = 0 По Значение.ВГраница() Цикл
			Значение[Индекс] = ОчищенноеЗначение(Значение[Индекс], Замен);
		КонецЦикла;
	Иначе
		Возврат; // числа и булево не очищаются
	КонецЕсли;

КонецПроцедуры

Функция ОчищенноеЗначение(Значение, Замен)

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат ОчиститьСтроку(Значение, Замен);
	КонецЕсли;
	ОчиститьЗначение(Значение, Замен);
	Возврат Значение;

КонецФункции

// Построчно, с сохранением переносов: строковые литералы в строках с именами секретов (пароль, токен, ключ API)
// заменяются, остальное проходит общие детекторы ПДн и секретов. Как ИИА_ИсходныйКод для вывода rlm.
Функция ОчиститьСтроку(Текст, Замен = 0)

	Результат = Новый Массив;
	Для Каждого СтрокаКода Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Если ИИА_Периметр.ЭтоИмяСекрета(СтрокаКода) Тогда
			СтрокаКода = СтрокаБезЛитералов(СтрокаКода, Замен);
		КонецЕсли;
		Результат.Добавить(ИИА_Периметр.ОчиститьТекст(СтрокаКода, Замен));
	КонецЦикла;
	Возврат СтрСоединить(Результат, Символы.ПС);

КонецФункции

Функция СтрокаБезЛитералов(Знач СтрокаКода, Замен)

	Литералы = СтрНайтиВсеПоРегулярномуВыражению(СтрокаКода, """[^""]{3,}""");
	Индекс = Литералы.ВГраница();
	Пока Индекс >= 0 Цикл
		Литерал = Литералы[Индекс];
		СтрокаКода = Лев(СтрокаКода, Литерал.НачальнаяПозиция - 1) + НСтр("ru = '""[секрет удалён]""'")
			+ Сред(СтрокаКода, Литерал.НачальнаяПозиция + Литерал.Длина);
		Замен = Замен + 1;
		Индекс = Индекс - 1;
	КонецЦикла;
	Возврат СтрокаКода;

КонецФункции

Функция Отказ(Результат, Код, Текст)

	Результат.Успех = Ложь;
	Результат.Итог = Код;
	Результат.Данные = Новый Структура("error, message", Код, Текст);
	Возврат Результат;

КонецФункции

Функция ОписаниеИнструмента(Имя, Описание, Свойства, Обязательные)

	Схема = Новый Соответствие;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", СтрРазделить(Обязательные, ",", Ложь));

	Функция_ = Новый Соответствие;
	Функция_.Вставить("name", Имя);
	Функция_.Вставить("description", Описание);
	Функция_.Вставить("parameters", Схема);

	Инструмент = Новый Соответствие;
	Инструмент.Вставить("type", "function");
	Инструмент.Вставить("function", Функция_);
	Возврат Инструмент;

КонецФункции

Процедура ДобавитьСтроку(Свойства, Имя, Описание)

	ДобавитьСвойство(Свойства, Имя, "string", Описание);

КонецПроцедуры

Процедура ДобавитьЧисло(Свойства, Имя, Описание)

	ДобавитьСвойство(Свойства, Имя, "integer", Описание);

КонецПроцедуры

Процедура ДобавитьФлаг(Свойства, Имя, Описание)

	ДобавитьСвойство(Свойства, Имя, "boolean", Описание);

КонецПроцедуры

Процедура ДобавитьСвойство(Свойства, Имя, Тип, Описание)

	Свойство = Новый Соответствие;
	Свойство.Вставить("type", Тип);
	Свойство.Вставить("description", Описание);
	Свойства.Вставить(Имя, Свойство);

КонецПроцедуры

