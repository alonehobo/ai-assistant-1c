///////////////////////////////////////////////////////////////////////////////////////////////////////
// ИИ-ассистент: версии политик, сравнение, сухой прогон (план, раздел 4.12, этап 2).
// Политика - профили доступа (правила объектов и полей, режим по умолчанию, доступ к коду), классификация
// данных и режимы дополнительных инструментов. Версия хранит снимок политики в JSON.
// Статусы: черновик -> действующая -> архивная. Действующую не правят; откат - новый черновик из архивной.
// Администратор самостоятельно активирует версии, включая ослабления ограничений.
// Если включена константа ИИА_ПолитикиЧерезВерсии, агент применяет правила только из действующей версии:
// правка профиля начинает действовать после активации новой версии.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Снимок текущих (живых) настроек политики.
//
// Возвращаемое значение:
//  Строка - JSON: profiles, classification, tools, commercial_masking.
//
Функция СнимокТекущихПолитик() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Профили = Новый Соответствие;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	П.Ссылка КАК Ссылка,
	|	П.Наименование КАК Наименование,
	|	П.ПоУмолчаниюРазрешено КАК ПоУмолчаниюРазрешено,
	|	П.ИсходныйКод КАК ИсходныйКод
	|ИЗ
	|	Справочник.ИИА_ПрофилиДоступа КАК П
	|ГДЕ
	|	НЕ П.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Пр.Ссылка КАК Ссылка,
	|	Пр.ПолноеИмя КАК ПолноеИмя,
	|	Пр.Разрешено КАК Разрешено
	|ИЗ
	|	Справочник.ИИА_ПрофилиДоступа.Правила КАК Пр
	|ГДЕ
	|	НЕ Пр.Ссылка.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Инстр.Ссылка КАК Ссылка,
	|	Инстр.Имя КАК Имя
	|ИЗ
	|	Справочник.ИИА_ПрофилиДоступа.Инструменты КАК Инстр
	|ГДЕ
	|	НЕ Инстр.Ссылка.ПометкаУдаления
	|	И Инстр.Запрещен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	К.ПолноеИмя КАК ПолноеИмя,
	|	К.Класс КАК Класс
	|ИЗ
	|	РегистрСведений.ИИА_КлассификацияДанных КАК К
	|ГДЕ
	|	НЕ К.Автоматически
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Р.Инструмент КАК Инструмент,
	|	Р.Режим КАК Режим
	|ИЗ
	|	РегистрСведений.ИИА_РежимыИнструментов КАК Р
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	С.Ссылка КАК Ссылка,
	|	С.Счет КАК Счет,
	|	С.Счет.Код КАК Код,
	|	С.Разрешен КАК Разрешен
	|ИЗ
	|	Справочник.ИИА_ПрофилиДоступа.Счета КАК С
	|ГДЕ
	|	НЕ С.Ссылка.ПометкаУдаления
	|	И С.Счет ССЫЛКА ПланСчетов.Хозрасчетный
	|	И С.Счет <> ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	З.Ссылка КАК Ссылка,
	|	З.ПолноеИмя КАК ПолноеИмя,
	|	З.Изменение КАК Изменение,
	|	З.Проведение КАК Проведение,
	|	З.ОтменаПроведения КАК ОтменаПроведения,
	|	З.ПометкаУдаления КАК ПометкаУдаления,
	|	З.Реквизиты КАК Реквизиты,
	|	З.ПробныйПрогонЗапрещен КАК ПробныйПрогонЗапрещен
	|ИЗ
	|	Справочник.ИИА_ПрофилиДоступа.ЗаписьДанных КАК З
	|ГДЕ
	|	НЕ З.Ссылка.ПометкаУдаления");
	Если Не ИИА_БухгалтерскийДоступ.ПланСчетовДоступен() Тогда
		// Без плана счетов (УТ, УНФ) счетов в профилях нет: таблица пакета остаётся пустой.
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "С.Счет.Код КАК Код", """"" КАК Код");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И С.Счет ССЫЛКА ПланСчетов.Хозрасчетный", "И ЛОЖЬ");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И С.Счет <> ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка)", "");
	КонецЕсли;
	Запрос.Текст = ИИА_БухгалтерскийДоступ.ТекстЗапросаПоПлану(Запрос.Текст);
	Пакет = Запрос.ВыполнитьПакет();

	Выборка = Пакет[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Описание = Новый Соответствие;
		Описание.Вставить("name", Выборка.Наименование);
		Описание.Вставить("default_allowed", Выборка.ПоУмолчаниюРазрешено);
		Описание.Вставить("source_code", Выборка.ИсходныйКод);
		Описание.Вставить("rules", Новый Соответствие);
		Описание.Вставить("tools_denied", Новый Массив);
		Описание.Вставить("accounts", Новый Соответствие);
		Описание.Вставить("write", Новый Соответствие);
		Профили.Вставить(Строка(Выборка.Ссылка.УникальныйИдентификатор()), Описание);
	КонецЦикла;
	Выборка = Пакет[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Описание = Профили.Получить(Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Если Описание <> Неопределено И ЗначениеЗаполнено(Выборка.ПолноеИмя) Тогда
			Описание.Получить("rules").Вставить(ВРег(СокрЛП(Выборка.ПолноеИмя)), Выборка.Разрешено);
		КонецЕсли;
	КонецЦикла;

	Выборка = Пакет[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		Описание = Профили.Получить(Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Если Описание <> Неопределено И ЗначениеЗаполнено(Выборка.Имя) Тогда
			Описание.Получить("tools_denied").Добавить(НРег(СокрЛП(Выборка.Имя)));
		КонецЕсли;
	КонецЦикла;

	КлассыОбъектов = Новый Соответствие;
	Выборка = Пакет[3].Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Класс) Тогда
			КлассыОбъектов.Вставить(ВРег(СокрЛП(Выборка.ПолноеИмя)), ИИА_КлассыДанных.ЧислоКласса(Выборка.Класс));
		КонецЕсли;
	КонецЦикла;

	Инструменты = Новый Соответствие;
	Выборка = Пакет[4].Выбрать();
	Пока Выборка.Следующий() Цикл
		Инструменты.Вставить(Выборка.Инструмент, Выборка.Режим);
	КонецЦикла;

	// Счета профиля: UUID счёта -> {code, allowed}; код - только для чтения версии человеком.
	Выборка = Пакет[5].Выбрать();
	Пока Выборка.Следующий() Цикл
		Описание = Профили.Получить(Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Если Описание <> Неопределено Тогда
			Счет = Новый Соответствие;
			Счет.Вставить("code", СокрЛП(Выборка.Код));
			Счет.Вставить("allowed", Выборка.Разрешен);
			Описание.Получить("accounts").Вставить(Строка(Выборка.Счет.УникальныйИдентификатор()), Счет);
		КонецЕсли;
	КонецЦикла;

	// Разрешения «Запись данных»: ВРег(полное имя) -> флаги операций, реквизиты (пусто - все допустимые), прогон.
	Выборка = Пакет[6].Выбрать();
	Пока Выборка.Следующий() Цикл
		Описание = Профили.Получить(Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Если Описание <> Неопределено И ЗначениеЗаполнено(Выборка.ПолноеИмя) Тогда
			Разрешение = ИИА_ПрофилиДоступа.РазрешениеЗаписи(Выборка.ПолноеИмя, Выборка.Изменение, Выборка.Проведение,
				Выборка.ОтменаПроведения, Выборка.ПометкаУдаления, Выборка.Реквизиты, Выборка.ПробныйПрогонЗапрещен);
			Описание.Получить("write").Вставить(ВРег(СокрЛП(Выборка.ПолноеИмя)), СнимокРазрешенияЗаписи(Разрешение));
		КонецЕсли;
	КонецЦикла;

	Снимок = Новый Соответствие;
	Снимок.Вставить("profiles", Профили);
	Снимок.Вставить("classification", КлассыОбъектов);
	Снимок.Вставить("tools", Инструменты);
	// Список коммерческого маскирования (ИИА_МаскированиеОбъектов); версии без раздела используют живой регистр.
	Снимок.Вставить(ИИА_Маскирование.КлючСнимка(), ИИА_Маскирование.СнимокНастроек());
	Возврат ОбщегоНазначения.ЗначениеВJSON(Снимок);

КонецФункции

// Сравнивает эффективные классы двух снимков, включая встроенные умолчания и классы владельцев полей.
//
// Параметры:
//  Старая - Соответствие, ФиксированноеСоответствие - предыдущая классификация.
//  Новая - Соответствие, ФиксированноеСоответствие - следующая классификация.
//
// Возвращаемое значение:
//  Массив из Структура - Вид, Описание; только изменения эффективного класса.
//
Функция ИзмененияКлассификации(Старая, Новая) Экспорт

	Ключи = Новый Соответствие;
	Для Каждого Элемент Из Старая Цикл
		Ключи.Вставить(Элемент.Ключ, Истина);
	КонецЦикла;
	Для Каждого Элемент Из Новая Цикл
		Ключи.Вставить(Элемент.Ключ, Истина);
	КонецЦикла;
	Изменения = Новый Массив;
	Для Каждого Элемент Из Ключи Цикл
		Было = ИИА_КлассыДанных.ЭффективныйКласс(Элемент.Ключ, Старая);
		Стало = ИИА_КлассыДанных.ЭффективныйКласс(Элемент.Ключ, Новая);
		Если Было <> Стало Тогда
			Вид = ?(Стало < Было, "Ослабление", "Усиление");
			Добавить(Изменения, Вид, СтрШаблон(НСтр("ru = 'Класс данных %1: %2 → %3'"), Элемент.Ключ,
				ИИА_КлассыДанных.ПредставлениеКласса(Было), ИИА_КлассыДанных.ПредставлениеКласса(Стало)));
		КонецЕсли;
	КонецЦикла;
	Возврат Изменения;

КонецФункции

// Изменения версии относительно действующей: ослабления, усиления, нейтральные.
//
// Параметры:
//  СнимокJSON - Строка - снимок проверяемой версии.
//
// Возвращаемое значение:
//  Массив из Структура - Вид ("Ослабление", "Усиление", "Нейтральное"), Описание.
//
Функция ИзмененияОтносительноДействующей(СнимокJSON) Экспорт

	Действующий = СнимокДействующейВерсии();
	Новый_ = РазобратьСнимок(СнимокJSON);
	Изменения = Новый Массив;

	СтарыеПрофили = Действующий.Получить("profiles");
	НовыеПрофили = Новый_.Получить("profiles");
	Для Каждого КлючИЗначение Из НовыеПрофили Цикл
		НовыйПрофиль = КлючИЗначение.Значение;
		Имя = НовыйПрофиль.Получить("name");
		СтарыйПрофиль = СтарыеПрофили.Получить(КлючИЗначение.Ключ);
		Если СтарыйПрофиль = Неопределено Тогда
			Добавить(Изменения, "Ослабление", СтрШаблон(НСтр("ru = 'Новый профиль «%1»'"), Имя));
			СравнитьЗаписьДанных(Изменения, Имя, Новый Соответствие, НовыйПрофиль.Получить("write"));
			Продолжить;
		КонецЕсли;
		СравнитьФлаг(Изменения, Имя, НСтр("ru = 'объекты по умолчанию разрешены'"),
			СтарыйПрофиль.Получить("default_allowed"), НовыйПрофиль.Получить("default_allowed"));
		СравнитьФлаг(Изменения, Имя, НСтр("ru = 'доступ к исходному коду'"),
			СтарыйПрофиль.Получить("source_code"), НовыйПрофиль.Получить("source_code"));
		СтарыеПравила = СтарыйПрофиль.Получить("rules");
		НовыеПравила = НовыйПрофиль.Получить("rules");
		Для Каждого Правило Из НовыеПравила Цикл
			Было = СтарыеПравила.Получить(Правило.Ключ);
			Если Было = Правило.Значение Тогда
				Продолжить;
			КонецЕсли;
			Если Было = Неопределено Тогда
				// Новое правило: ослабление, если оно разрешает то, что было закрыто по умолчанию.
				ПоУмолчанию = НовыйПрофиль.Получить("default_allowed") = Истина;
				Если Правило.Значение = ПоУмолчанию Тогда
					Вид = "Нейтральное";
				Иначе
					Вид = ?(Правило.Значение, "Ослабление", "Усиление");
				КонецЕсли;
			Иначе
				Вид = ?(Правило.Значение, "Ослабление", "Усиление");
			КонецЕсли;
			Добавить(Изменения, Вид, СтрШаблон(НСтр("ru = '«%1»: %2 - %3'"), Имя, Правило.Ключ,
				?(Правило.Значение, НСтр("ru = 'разрешено'"), НСтр("ru = 'запрещено'"))));
		КонецЦикла;
		СтарыеЗапреты = СтарыйПрофиль.Получить("tools_denied");
		НовыеЗапреты = НовыйПрофиль.Получить("tools_denied");
		СтарыеЗапреты = ?(ТипЗнч(СтарыеЗапреты) = Тип("Массив"), СтарыеЗапреты, Новый Массив);
		НовыеЗапреты = ?(ТипЗнч(НовыеЗапреты) = Тип("Массив"), НовыеЗапреты, Новый Массив);
		Для Каждого Инструмент Из СтарыеЗапреты Цикл
			Если НовыеЗапреты.Найти(Инструмент) = Неопределено Тогда
				Добавить(Изменения, "Ослабление", СтрШаблон(НСтр("ru = '«%1»: инструмент %2 включён'"), Имя, Инструмент));
			КонецЕсли;
		КонецЦикла;
		Для Каждого Инструмент Из НовыеЗапреты Цикл
			Если СтарыеЗапреты.Найти(Инструмент) = Неопределено Тогда
				Добавить(Изменения, "Усиление", СтрШаблон(НСтр("ru = '«%1»: инструмент %2 выключен'"), Имя, Инструмент));
			КонецЕсли;
		КонецЦикла;
		Для Каждого Правило Из СтарыеПравила Цикл
			Если НовыеПравила.Получить(Правило.Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ПоУмолчанию = НовыйПрофиль.Получить("default_allowed") = Истина;
			Если Правило.Значение = ПоУмолчанию Тогда
				Вид = "Нейтральное";
			Иначе
				Вид = ?(ПоУмолчанию, "Ослабление", "Усиление");
			КонецЕсли;
			Добавить(Изменения, Вид, СтрШаблон(НСтр("ru = '«%1»: правило для %2 удалено (действует умолчание)'"), Имя, Правило.Ключ));
		КонецЦикла;
		СравнитьСчета(Изменения, Имя, СтарыйПрофиль, НовыйПрофиль);
		СравнитьЗаписьДанных(Изменения, Имя, СтарыйПрофиль.Получить("write"), НовыйПрофиль.Получить("write"));
	КонецЦикла;
	Для Каждого КлючИЗначение Из СтарыеПрофили Цикл
		Если НовыеПрофили.Получить(КлючИЗначение.Ключ) = Неопределено Тогда
			Добавить(Изменения, "Усиление", СтрШаблон(НСтр("ru = 'Профиль «%1» удалён'"), КлючИЗначение.Значение.Получить("name")));
		КонецЕсли;
	КонецЦикла;

	// Классификация: класс ниже - данные уйдут большему числу провайдеров (ослабление).
	СтараяКлассификация = Действующий.Получить("classification");
	НоваяКлассификация = Новый_.Получить("classification");
	Для Каждого Изменение Из ИзмененияКлассификации(СтараяКлассификация, НоваяКлассификация) Цикл
		Изменения.Добавить(Изменение);
	КонецЦикла;

	// Дополнительные инструменты: перевод в «Разрешен» - ослабление.
	СтарыеИнструменты = Действующий.Получить("tools");
	Для Каждого КлючИЗначение Из Новый_.Получить("tools") Цикл
		Было = СтарыеИнструменты.Получить(КлючИЗначение.Ключ);
		Если Было = КлючИЗначение.Значение Тогда
			Продолжить;
		КонецЕсли;
		Если КлючИЗначение.Значение = "Разрешен" Тогда
			Вид = "Ослабление";
		Иначе
			Вид = ?(Было = "Разрешен", "Усиление", "Нейтральное");
		КонецЕсли;
		Добавить(Изменения, Вид, СтрШаблон(НСтр("ru = 'Инструмент %1: %2'"), КлючИЗначение.Ключ, КлючИЗначение.Значение));
	КонецЦикла;

	// Коммерческое маскирование: удаление строки или реквизита и выключение - ослабление.
	Для Каждого Изменение Из ИИА_Маскирование.ИзмененияНастроек(Действующий.Получить(ИИА_Маскирование.КлючСнимка()),
		Новый_.Получить(ИИА_Маскирование.КлючСнимка())) Цикл
		Изменения.Добавить(Изменение);
	КонецЦикла;

	Возврат Изменения;

КонецФункции

// Сухой прогон версии по вызовам run_query из журнала: какие вызовы станут разрешены или запрещены.
// Значения данных не показываются - только число вызовов и таблицы.
//
// Параметры:
//  СнимокJSON - Строка
//  Дней - Число
//
// Возвращаемое значение:
//  Строка - отчёт для администратора.
//
Функция СухойПрогон(СнимокJSON, Дней = 7) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Действующий = СнимокДействующейВерсии();
	Новый_ = РазобратьСнимок(СнимокJSON);

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 2000
	|	Ж.Пользователь КАК Пользователь,
	|	Ж.Аргументы КАК Аргументы
	|ИЗ
	|	РегистрСведений.ИИА_ЖурналВызовов КАК Ж
	|ГДЕ
	|	Ж.МоментВызова >= &Начало
	|	И Ж.Событие = ""Инструмент""
	|	И Ж.Инструмент = ""run_query""");
	Запрос.УстановитьПараметр("Начало", ТекущаяУниверсальнаяДата() - Дней * 86400);
	Выборка = Запрос.Выполнить().Выбрать();

	Вызовов = 0;
	Открываются = Новый Соответствие; // таблица -> число вызовов
	Закрываются = Новый Соответствие;
	ПрофилиПользователей = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Таблицы = ТаблицыЗапроса(Выборка.Аргументы);
		Если Таблицы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Вызовов = Вызовов + 1;
		Профиль = ПрофилиПользователей.Получить(Выборка.Пользователь);
		Если Профиль = Неопределено Тогда
			Профиль = ИИА_ПрофилиДоступа.ЭффективныйПрофиль(Выборка.Пользователь);
			Профиль = ?(ЗначениеЗаполнено(Профиль), Строка(Профиль.УникальныйИдентификатор()), "");
			ПрофилиПользователей.Вставить(Выборка.Пользователь, Профиль);
		КонецЕсли;
		Для Каждого Таблица Из Таблицы Цикл
			Было = ОбъектРазрешенСнимком(Действующий, Профиль, Таблица);
			Стало = ОбъектРазрешенСнимком(Новый_, Профиль, Таблица);
			Если Было = Стало Тогда
				Продолжить;
			КонецЕсли;
			Счетчики = ?(Стало, Открываются, Закрываются);
			Счетчики.Вставить(Таблица, ЧислоИлиНоль(Счетчики.Получить(Таблица)) + 1);
		КонецЦикла;
	КонецЦикла;

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Проверено вызовов run_query за %1 дн.: %2.'"), Дней, Вызовов));
	Строки.Добавить(ОписаниеСчетчиков(НСтр("ru = 'Станут доступны'"), Открываются));
	Строки.Добавить(ОписаниеСчетчиков(НСтр("ru = 'Станут недоступны'"), Закрываются));
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Активирует версию администратором и переводит прежнюю действующую в архив.
//
// Параметры:
//  Версия - СправочникСсылка.ИИА_ВерсииПолитик
//
Процедура Активировать(Версия) Экспорт

	ПроверитьПраваАдминистратора();
	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Блокировка.Добавить("Справочник.ИИА_ВерсииПолитик");
		Блокировка.Добавить("Константа.ИИА_ДействующаяВерсияПолитик");
		Блокировка.Заблокировать();

		ОбъектВерсии = Версия.ПолучитьОбъект();
		Если ОбъектВерсии.Статус <> "Черновик" Тогда
			ВызватьИсключение НСтр("ru = 'Активировать можно только черновик.'");
		КонецЕсли;
		Если ПустаяСтрока(ОбъектВерсии.Снимок) Тогда
			ВызватьИсключение НСтр("ru = 'В версии нет снимка политик.'");
		КонецЕсли;
		// Изменения пересчитываются на момент активации относительно действующей версии.
		ОбъектВерсии.Изменения.Очистить();
		Для Каждого Изменение Из ИзмененияОтносительноДействующей(ОбъектВерсии.Снимок) Цикл
			Строка = ОбъектВерсии.Изменения.Добавить();
			Строка.Вид = Изменение.Вид;
			Строка.Описание = Изменение.Описание;
		КонецЦикла;

		Прежняя = Константы.ИИА_ДействующаяВерсияПолитик.Получить();
		Если ЗначениеЗаполнено(Прежняя) И Прежняя <> Версия Тогда
			ОбъектПрежней = Прежняя.ПолучитьОбъект();
			ОбъектПрежней.Статус = "Архивная";
			ОбъектПрежней.ДополнительныеСвойства.Вставить("ИИА_Активация", Истина);
			ОбъектПрежней.Записать();
		КонецЕсли;
		ОбъектВерсии.Статус = "Действующая";
		ОбъектВерсии.Активирована = ТекущаяДатаСеанса();
		ОбъектВерсии.Активировал = Пользователи.ТекущийПользователь();
		ОбъектВерсии.ДополнительныеСвойства.Вставить("ИИА_Активация", Истина);
		ОбъектВерсии.Записать();
		Константы.ИИА_ДействующаяВерсияПолитик.Установить(Версия);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	ЗаписатьЖурналНастройки("Активация", Строка(Версия));
	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

// Создаёт черновик: снимок текущих настроек или копия указанной версии (откат).
//
// Параметры:
//  Основание - СправочникСсылка.ИИА_ВерсииПолитик, Неопределено
//
// Возвращаемое значение:
//  СправочникСсылка.ИИА_ВерсииПолитик
//
Функция СоздатьЧерновик(Основание = Неопределено) Экспорт

	ПроверитьПраваАдминистратора();
	УстановитьПривилегированныйРежим(Истина);
	Черновик = Справочники.ИИА_ВерсииПолитик.СоздатьЭлемент();
	Черновик.Статус = "Черновик";
	Черновик.Автор = Пользователи.ТекущийПользователь();
	Черновик.Создана = ТекущаяДатаСеанса();
	Если ЗначениеЗаполнено(Основание) Тогда
		Черновик.Снимок = Основание.Снимок;
		Черновик.ОснованиеВерсия = Основание;
		Черновик.Наименование = СтрШаблон(НСтр("ru = 'Откат к «%1»'"), Основание.Наименование);
	Иначе
		Черновик.Снимок = СнимокТекущихПолитик();
		Черновик.Наименование = СтрШаблон(НСтр("ru = 'Политики от %1'"), Формат(ТекущаяДатаСеанса(), "ДЛФ=DT"));
	КонецЕсли;
	Черновик.Записать();
	ЗаписатьЖурналНастройки(?(ЗначениеЗаполнено(Основание), "Откат", "Черновик"), Строка(Черновик.Ссылка));
	Возврат Черновик.Ссылка;

КонецФункции

// Создаёт черновик из импортированного снимка (JSON). Снимок проверяется на структуру; профили
// сопоставляются по уникальному идентификатору.
//
// Параметры:
//  СнимокJSON - Строка
//
// Возвращаемое значение:
//  СправочникСсылка.ИИА_ВерсииПолитик
//
Функция ИмпортироватьЧерновик(СнимокJSON) Экспорт

	ПроверитьПраваАдминистратора();
	Попытка
		Данные = ОбщегоНазначения.JSONВЗначение(СнимокJSON, , Истина);
	Исключение
		ВызватьИсключение НСтр("ru = 'Текст не является JSON.'");
	КонецПопытки;
	Если ТипЗнч(Данные) <> Тип("Соответствие") Или ТипЗнч(Данные.Получить("profiles")) <> Тип("Соответствие") Тогда
		ВызватьИсключение НСтр("ru = 'Это не снимок политик: нет раздела profiles.'");
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Черновик = Справочники.ИИА_ВерсииПолитик.СоздатьЭлемент();
	Черновик.Статус = "Черновик";
	Черновик.Автор = Пользователи.ТекущийПользователь();
	Черновик.Создана = ТекущаяДатаСеанса();
	Черновик.Снимок = ОбщегоНазначения.ЗначениеВJSON(РазобратьСнимок(СнимокJSON));
	Черновик.Наименование = СтрШаблон(НСтр("ru = 'Импорт от %1'"), Формат(ТекущаяДатаСеанса(), "ДЛФ=DT"));
	Черновик.Записать();
	ЗаписатьЖурналНастройки("Импорт", Строка(Черновик.Ссылка));
	Возврат Черновик.Ссылка;

КонецФункции

// Применять ли правила из действующей версии вместо живых настроек.
//
// Возвращаемое значение:
//  Булево
//
Функция ПолитикиЧерезВерсии() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Возврат Константы.ИИА_ПолитикиЧерезВерсии.Получить() = Истина
		И ЗначениеЗаполнено(Константы.ИИА_ДействующаяВерсияПолитик.Получить());

КонецФункции

// Снимок действующей версии без кэша (см. ИИА_ПолитикиПовтИсп.ДействующийСнимок).
//
// Возвращаемое значение:
//  Соответствие - profiles, classification, tools (пустые, если действующей версии нет).
//
Функция СнимокДействующейВерсии() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Версия = Константы.ИИА_ДействующаяВерсияПолитик.Получить();
	Если Не ЗначениеЗаполнено(Версия) Тогда
		Возврат РазобратьСнимок("");
	КонецЕсли;
	Возврат РазобратьСнимок(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Версия, "Снимок"));

КонецФункции

// Правила профиля из снимка в формате ИИА_ПрофилиДоступа.ПостроитьПравилаТекущегоПользователя.
// Профиль, которого нет в снимке, ничего не разрешает (ПрофильНайден = Ложь).
//
// Параметры:
//  Профиль - СправочникСсылка.ИИА_ПрофилиДоступа
//  БезКэша - Булево - читать снимок действующей версии без кэша сеанса.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура
//
Функция ПравилаПрофиляИзДействующейВерсии(Профиль, БезКэша = Ложь) Экспорт

	Снимок = ?(БезКэша, СнимокДействующейВерсии(), ИИА_ПолитикиПовтИсп.ДействующийСнимок());
	Описание = Снимок.Получить("profiles").Получить(Строка(Профиль.УникальныйИдентификатор()));
	Правила = Новый Соответствие;
	РазрешенныеСчета = Новый Массив;
	ЗапрещенныеСчета = Новый Массив;
	Ключи = "Профиль, Наименование, ПоУмолчаниюРазрешено, ИсходныйКод, Правила, ЗапрещенныеИнструменты, Счета, ПрофильНайден, ЗаписьДанных";
	Результат = Новый Структура(Ключи, Профиль, Строка(Профиль), Ложь, Ложь, Неопределено,
		Новый ФиксированныйМассив(Новый Массив), Неопределено, Описание <> Неопределено, Неопределено);
	ЗаписьДанных = Новый Соответствие;
	Если Описание <> Неопределено Тогда
		Результат.Наименование = Описание.Получить("name");
		Результат.ПоУмолчаниюРазрешено = Описание.Получить("default_allowed") = Истина;
		Результат.ИсходныйКод = Описание.Получить("source_code") = Истина;
		Для Каждого Правило Из Описание.Получить("rules") Цикл
			Правила.Вставить(Правило.Ключ, Правило.Значение = Истина);
		КонецЦикла;
		Запрещенные = Описание.Получить("tools_denied");
		Если ТипЗнч(Запрещенные) = Тип("Массив") Тогда
			Результат.ЗапрещенныеИнструменты = Новый ФиксированныйМассив(Запрещенные);
		КонецЕсли;
		// Счёт, которого нет в базе, остаётся ссылкой: разрешённый ничего не открывает, но включает белый список,
		// запрещённый не влияет на набор. Без плана счетов правила счетов не применяются.
		МенеджерСчетов = ИИА_БухгалтерскийДоступ.МенеджерПланаСчетов();
		Счета = ?(МенеджерСчетов = Неопределено, Новый Соответствие, Описание.Получить("accounts"));
		Для Каждого КлючИЗначение Из Счета Цикл
			Попытка
				Счет = МенеджерСчетов.ПолучитьСсылку(Новый УникальныйИдентификатор(КлючИЗначение.Ключ));
			Исключение
				// Некорректный идентификатор в импортированном снимке: пустая ссылка ничего не открывает,
				// но разрешённое правило сохраняет режим белого списка.
				ЗаписьЖурналаРегистрации("ИИАссистент.Политики", УровеньЖурналаРегистрации.Предупреждение, , ,
					ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				Счет = МенеджерСчетов.ПустаяСсылка();
			КонецПопытки;
			Если ТипЗнч(КлючИЗначение.Значение) = Тип("Соответствие") И КлючИЗначение.Значение.Получить("allowed") = Истина Тогда
				РазрешенныеСчета.Добавить(Счет);
			Иначе
				ЗапрещенныеСчета.Добавить(Счет);
			КонецЕсли;
		КонецЦикла;
		// Снимок без раздела write (версии до typed-write) - разрешений записи нет.
		Для Каждого КлючИЗначение Из Описание.Получить("write") Цикл
			Если ТипЗнч(КлючИЗначение.Значение) = Тип("Соответствие") Тогда
				ЗаписьДанных.Вставить(ВРег(КлючИЗначение.Ключ), РазрешениеЗаписиИзСнимка(КлючИЗначение.Ключ,
					КлючИЗначение.Значение));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Результат.ЗаписьДанных = Новый ФиксированноеСоответствие(ЗаписьДанных);
	Результат.Правила = Новый ФиксированноеСоответствие(Правила);
	Результат.Счета = Новый ФиксированнаяСтруктура("Разрешенные, Запрещенные",
		Новый ФиксированныйМассив(РазрешенныеСчета), Новый ФиксированныйМассив(ЗапрещенныеСчета));
	Возврат Новый ФиксированнаяСтруктура(Результат);

КонецФункции

// Записывает событие настройки политик в журнал вызовов (событие «Политика»).
//
// Параметры:
//  Действие - Строка - Черновик, Активация, Откат, Импорт, Экспорт.
//  Подробности - Строка
//
Процедура ЗаписатьЖурналНастройки(Действие, Подробности) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Запись = РегистрыСведений.ИИА_ЖурналВызовов.СоздатьМенеджерЗаписи();
	Запись.ИдентификаторЗаписи = Строка(Новый УникальныйИдентификатор);
	Запись.МоментВызова = ТекущаяУниверсальнаяДата();
	Запись.Пользователь = Пользователи.ТекущийПользователь();
	Запись.Событие = "Политика";
	Запись.Итог = Действие;
	Запись.Подробности = Лев(Подробности, 1000);
	Запись.Записать();
	ЗаписьЖурналаРегистрации("ИИАссистент.Политики", УровеньЖурналаРегистрации.Информация, , , Действие + ": " + Подробности);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазобратьСнимок(СнимокJSON)

	Снимок = Неопределено;
	Если Не ПустаяСтрока(СнимокJSON) Тогда
		Попытка
			Снимок = ОбщегоНазначения.JSONВЗначение(СнимокJSON, , Истина);
		// Неразборчивый снимок считается пустым: проверки ниже сообщат об отсутствии настроек.
		Исключение // BSLLS:MissingCodeTryCatchEx-off
			Снимок = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если ТипЗнч(Снимок) <> Тип("Соответствие") Тогда
		Снимок = Новый Соответствие;
	КонецЕсли;
	Для Каждого Ключ Из СтрРазделить("profiles,classification,tools", ",") Цикл
		Если ТипЗнч(Снимок.Получить(Ключ)) <> Тип("Соответствие") Тогда
			Снимок.Вставить(Ключ, Новый Соответствие);
		КонецЕсли;
	КонецЦикла;
	Для Каждого КлючИЗначение Из Снимок.Получить("profiles") Цикл
		Если ТипЗнч(КлючИЗначение.Значение.Получить("rules")) <> Тип("Соответствие") Тогда
			КлючИЗначение.Значение.Вставить("rules", Новый Соответствие);
		КонецЕсли;
		// Версии до правил счетов: правил счетов нет.
		Если ТипЗнч(КлючИЗначение.Значение.Получить("accounts")) <> Тип("Соответствие") Тогда
			КлючИЗначение.Значение.Вставить("accounts", Новый Соответствие);
		КонецЕсли;
		// Версии до typed-write: разрешений «Запись данных» нет.
		Если ТипЗнч(КлючИЗначение.Значение.Получить("write")) <> Тип("Соответствие") Тогда
			КлючИЗначение.Значение.Вставить("write", Новый Соответствие);
		КонецЕсли;
	КонецЦикла;
	Возврат Снимок;

КонецФункции

Функция ОбъектРазрешенСнимком(Снимок, Профиль, ПолноеИмя)

	Если ПустаяСтрока(Профиль) Тогда
		Возврат Истина; // профиль не назначен - действует только периметр этапа
	КонецЕсли;
	Описание = Снимок.Получить("profiles").Получить(Профиль);
	Если Описание = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Разрешено = Описание.Получить("rules").Получить(ВРег(ПолноеИмя));
	Если Разрешено = Неопределено Тогда
		Разрешено = Описание.Получить("default_allowed") = Истина;
	КонецЕсли;
	Возврат Разрешено = Истина;

КонецФункции

// Таблицы метаданных запроса из аргументов вызова run_query (JSON с полем query).
Функция ТаблицыЗапроса(АргументыJSON)

	Таблицы = Новый Массив;
	Попытка
		Аргументы = ОбщегоНазначения.JSONВЗначение(АргументыJSON, , Истина);
		Схема = Новый СхемаЗапроса;
		Схема.УстановитьТекстЗапроса(Аргументы.Получить("query"));
	// Неразборчивые аргументы или текст запроса: таблиц для сухого прогона нет.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат Таблицы;
	КонецПопытки;
	Для Каждого ЗапросПакета Из Схема.ПакетЗапросов Цикл
		Если ТипЗнч(ЗапросПакета) <> Тип("ЗапросВыбораСхемыЗапроса") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Оператор Из ЗапросПакета.Операторы Цикл
			Для Каждого Источник Из Оператор.Источники Цикл
				Если ТипЗнч(Источник.Источник) <> Тип("ТаблицаСхемыЗапроса") Тогда
					Продолжить;
				КонецЕсли;
				Части = СтрРазделить(Источник.Источник.ИмяТаблицы, ".");
				Если Части.Количество() >= 2 Тогда
					Имя = Части[0] + "." + Части[1];
					Если Таблицы.Найти(Имя) = Неопределено Тогда
						Таблицы.Добавить(Имя);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Таблицы;

КонецФункции

Функция ОписаниеСчетчиков(Заголовок, Счетчики)

	Если Счетчики.Количество() = 0 Тогда
		Возврат Заголовок + ": " + НСтр("ru = 'нет'");
	КонецЕсли;
	Части = Новый Массив;
	Для Каждого КлючИЗначение Из Счетчики Цикл
		Части.Добавить(СтрШаблон("%1 (%2)", КлючИЗначение.Ключ, КлючИЗначение.Значение));
	КонецЦикла;
	Возврат Заголовок + ": " + СтрСоединить(Части, ", ");

КонецФункции

Процедура СравнитьФлаг(Изменения, ИмяПрофиля, Что, Было, Стало)

	Если (Было = Истина) = (Стало = Истина) Тогда
		Возврат;
	КонецЕсли;
	Добавить(Изменения, ?(Стало = Истина, "Ослабление", "Усиление"),
		СтрШаблон(НСтр("ru = '«%1»: %2 - %3'"), ИмяПрофиля, Что, ?(Стало = Истина, НСтр("ru = 'да'"), НСтр("ru = 'нет'"))));

КонецПроцедуры

// Изменения правил счетов профиля. Разрешённые счета включают белый список: первый разрешённый сужает набор профиля
// с разрешением по умолчанию (усиление), а профилю с запретом по умолчанию открывает бухгалтерские инструменты
// (ослабление); удаление последнего - наоборот. Смена флага счёта раскладывается на удаление из одного списка
// и добавление в другой, итог - худший вид (ослабление важнее усиления).
Процедура СравнитьСчета(Изменения, ИмяПрофиля, СтарыйПрофиль, НовыйПрофиль)

	Старые = СтарыйПрофиль.Получить("accounts");
	Новые = НовыйПрофиль.Получить("accounts");
	ПоУмолчанию = НовыйПрофиль.Получить("default_allowed") = Истина;
	БылиРазрешенные = ЕстьРазрешенныеСчета(Старые);
	ЕстьРазрешенные = ЕстьРазрешенныеСчета(Новые);
	Ключи = Новый Соответствие;
	Для Каждого Элемент Из Старые Цикл
		Ключи.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	Для Каждого Элемент Из Новые Цикл
		Ключи.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;

	Для Каждого Элемент Из Ключи Цикл
		Было = ФлагСчета(Старые, Элемент.Ключ);
		Стало = ФлагСчета(Новые, Элемент.Ключ);
		Если Было = Стало Тогда
			Продолжить;
		КонецЕсли;
		Виды = Новый Массив;
		Если Было = Ложь Тогда
			Виды.Добавить("Ослабление");
		ИначеЕсли Было = Истина Тогда
			// Удалён разрешённый: при оставшихся других - усиление, последний - выключение белого списка.
			Виды.Добавить(?(ЕстьРазрешенные Или Не ПоУмолчанию, "Усиление", "Ослабление"));
		КонецЕсли;
		Если Стало = Ложь Тогда
			Виды.Добавить("Усиление");
		ИначеЕсли Стало = Истина Тогда
			// Добавлен разрешённый: при включённом белом списке - ослабление, первый - включение белого списка.
			Виды.Добавить(?(БылиРазрешенные Или Не ПоУмолчанию, "Ослабление", "Усиление"));
		КонецЕсли;
		Вид = ?(Виды.Найти("Ослабление") = Неопределено, "Усиление", "Ослабление");
		Если Стало = Неопределено Тогда
			Состояние = НСтр("ru = 'правило удалено'");
		Иначе
			Состояние = ?(Стало, НСтр("ru = 'разрешён'"), НСтр("ru = 'запрещён'"));
		КонецЕсли;
		Код = ?(ТипЗнч(Элемент.Значение) = Тип("Соответствие"), Элемент.Значение.Получить("code"), Элемент.Ключ);
		Добавить(Изменения, Вид, СтрШаблон(НСтр("ru = '«%1»: счёт %2 - %3'"), ИмяПрофиля, Код, Состояние));
	КонецЦикла;

	// Профиль без разрешённых счетов: режим по умолчанию открывает или закрывает бухгалтерские инструменты.
	Если Не ЕстьРазрешенные И (СтарыйПрофиль.Получить("default_allowed") = Истина) <> ПоУмолчанию Тогда
		Добавить(Изменения, ?(ПоУмолчанию, "Ослабление", "Усиление"), СтрШаблон(?(ПоУмолчанию,
			НСтр("ru = '«%1»: открыты бухгалтерские инструменты'"), НСтр("ru = '«%1»: закрыты бухгалтерские инструменты'")),
			ИмяПрофиля));
	КонецЕсли;

КонецПроцедуры

// Разрешение записи в снимке: {"edit","post","unpost","mark","fields":[...],"no_dry_run"}.
Функция СнимокРазрешенияЗаписи(Разрешение)

	Описание = Новый Соответствие;
	Описание.Вставить("edit", Разрешение.Изменение);
	Описание.Вставить("post", Разрешение.Проведение);
	Описание.Вставить("unpost", Разрешение.ОтменаПроведения);
	Описание.Вставить("mark", Разрешение.ПометкаУдаления);
	Поля = Новый Массив;
	Для Каждого Имя Из Разрешение.Реквизиты Цикл
		Поля.Добавить(Имя);
	КонецЦикла;
	Описание.Вставить("fields", Поля);
	Описание.Вставить("no_dry_run", Разрешение.ПробныйПрогонЗапрещен);
	Возврат Описание;

КонецФункции

Функция РазрешениеЗаписиИзСнимка(ПолноеИмя, Описание)

	Поля = Описание.Получить("fields");
	Возврат ИИА_ПрофилиДоступа.РазрешениеЗаписи(ПолноеИмя, Описание.Получить("edit"), Описание.Получить("post"),
		Описание.Получить("unpost"), Описание.Получить("mark"), ?(ТипЗнч(Поля) = Тип("Массив"), Поля, Новый Массив),
		Описание.Получить("no_dry_run"));

КонецФункции

// Изменения разрешений «Запись данных»: новая операция или вид - ослабление, снятая операция или удалённый вид -
// усиление; расширение реквизитов (в том числе переход к пустому списку = все допустимые) - ослабление, сужение -
// усиление; флаг пробного прогона на доступ модели не влияет - нейтральное.
Процедура СравнитьЗаписьДанных(Изменения, ИмяПрофиля, СтарыеВиды, НовыеВиды)

	Старые = ?(ТипЗнч(СтарыеВиды) = Тип("Соответствие"), СтарыеВиды, Новый Соответствие);
	Новые = ?(ТипЗнч(НовыеВиды) = Тип("Соответствие"), НовыеВиды, Новый Соответствие);
	Ключи = Новый Соответствие;
	Для Каждого Элемент Из Старые Цикл
		Ключи.Вставить(Элемент.Ключ, Истина);
	КонецЦикла;
	Для Каждого Элемент Из Новые Цикл
		Ключи.Вставить(Элемент.Ключ, Истина);
	КонецЦикла;
	Для Каждого Элемент Из Ключи Цикл
		Было = Старые.Получить(Элемент.Ключ);
		Стало = Новые.Получить(Элемент.Ключ);
		ЕстьБыло = ТипЗнч(Было) = Тип("Соответствие");
		ЕстьСтало = ТипЗнч(Стало) = Тип("Соответствие");
		Было = ?(ЕстьБыло, Было, Новый Соответствие);
		Стало = ?(ЕстьСтало, Стало, Новый Соответствие);
		Для Каждого Операция Из СтрРазделить("edit,post,unpost,mark", ",") Цикл
			Разрешено = Стало.Получить(Операция) = Истина;
			Если (Было.Получить(Операция) = Истина) <> Разрешено Тогда
				Добавить(Изменения, ?(Разрешено, "Ослабление", "Усиление"),
					СтрШаблон(НСтр("ru = '«%1»: %2 - %3 %4'"), ИмяПрофиля, Элемент.Ключ, ПредставлениеОперацииЗаписи(Операция),
					?(Разрешено, НСтр("ru = 'разрешено'"), НСтр("ru = 'запрещено'"))));
			КонецЕсли;
		КонецЦикла;
		Если Было.Получить("edit") = Истина И Стало.Получить("edit") = Истина Тогда
			СравнитьРеквизитыЗаписи(Изменения, ИмяПрофиля, Элемент.Ключ, Было.Получить("fields"), Стало.Получить("fields"));
		КонецЕсли;
		Если ЕстьБыло И ЕстьСтало И (Было.Получить("no_dry_run") = Истина) <> (Стало.Получить("no_dry_run") = Истина) Тогда
			Добавить(Изменения, "Нейтральное", СтрШаблон(НСтр("ru = '«%1»: %2 - пробный прогон %3'"), ИмяПрофиля,
				Элемент.Ключ, ?(Стало.Получить("no_dry_run") = Истина, НСтр("ru = 'выключен'"), НСтр("ru = 'включён'"))));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура СравнитьРеквизитыЗаписи(Изменения, ИмяПрофиля, Вид, СтарыеПоля, НовыеПоля)

	Старые = ?(ТипЗнч(СтарыеПоля) = Тип("Массив"), СтарыеПоля, Новый Массив);
	Новые = ?(ТипЗнч(НовыеПоля) = Тип("Массив"), НовыеПоля, Новый Массив);
	Если Старые.Количество() > 0 И Новые.Количество() = 0 Тогда
		Добавить(Изменения, "Ослабление", СтрШаблон(НСтр("ru = '«%1»: %2 - разрешено изменять все допустимые реквизиты'"),
			ИмяПрофиля, Вид));
		Возврат;
	ИначеЕсли Старые.Количество() = 0 И Новые.Количество() > 0 Тогда
		Добавить(Изменения, "Усиление", СтрШаблон(НСтр("ru = '«%1»: %2 - разрешено изменять только реквизиты %3'"),
			ИмяПрофиля, Вид, СтрСоединить(Новые, ", ")));
		Возврат;
	КонецЕсли;
	Добавленные = Новый Массив;
	Для Каждого Имя Из Новые Цикл
		Если Старые.Найти(Имя) = Неопределено Тогда
			Добавленные.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Удаленные = Новый Массив;
	Для Каждого Имя Из Старые Цикл
		Если Новые.Найти(Имя) = Неопределено Тогда
			Удаленные.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Если Добавленные.Количество() > 0 Тогда
		Добавить(Изменения, "Ослабление", СтрШаблон(НСтр("ru = '«%1»: %2 - разрешено изменять реквизиты %3'"),
			ИмяПрофиля, Вид, СтрСоединить(Добавленные, ", ")));
	КонецЕсли;
	Если Удаленные.Количество() > 0 Тогда
		Добавить(Изменения, "Усиление", СтрШаблон(НСтр("ru = '«%1»: %2 - запрещено изменять реквизиты %3'"),
			ИмяПрофиля, Вид, СтрСоединить(Удаленные, ", ")));
	КонецЕсли;

КонецПроцедуры

Функция ПредставлениеОперацииЗаписи(Операция)

	Если Операция = "edit" Тогда
		Возврат НСтр("ru = 'изменение реквизитов'");
	ИначеЕсли Операция = "post" Тогда
		Возврат НСтр("ru = 'проведение'");
	ИначеЕсли Операция = "unpost" Тогда
		Возврат НСтр("ru = 'отмена проведения'");
	КонецЕсли;
	Возврат НСтр("ru = 'пометка удаления'");

КонецФункции

Функция ФлагСчета(Счета, Ключ)

	Описание = Счета.Получить(Ключ);
	Если ТипЗнч(Описание) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Описание.Получить("allowed") = Истина;

КонецФункции

Функция ЕстьРазрешенныеСчета(Счета)

	Для Каждого Элемент Из Счета Цикл
		Если ФлагСчета(Счета, Элемент.Ключ) = Истина Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Процедура Добавить(Изменения, Вид, Описание)

	Изменения.Добавить(Новый Структура("Вид, Описание", Вид, Лев(Описание, 500)));

КонецПроцедуры

Функция ЧислоИлиНоль(Значение)

	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, 0);

КонецФункции

Процедура ПроверитьПраваАдминистратора()

	Если Не РольДоступна("ИИА_Администратор") И Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для изменения политик ИИ-ассистента.'");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
