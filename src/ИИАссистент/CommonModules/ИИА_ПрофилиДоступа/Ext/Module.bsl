///////////////////////////////////////////////////////////////////////////////////////////////////////
// ИИ-ассистент: профили доступа к объектам в разрезе пользователей (план, раздел 4.4).
// Профиль только сужает периметр этапа: то, что запрещено в коде (ИИА_Периметр), профилем не открывается.
// Правила проверяются там же, где периметр, поэтому действуют на каждую таблицу, поле, условие и ссылочный
// тип в запросе агента (ИИА_ГраницаЗапроса), на поиск и описание метаданных, отчёты и контекст объекта.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Действующий профиль пользователя: явное участие пользователя или его группы; при нескольких -
// профиль с большим приоритетом; если нет ни одного - профиль по умолчанию (константа).
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи
//
// Возвращаемое значение:
//  СправочникСсылка.ИИА_ПрофилиДоступа, Неопределено
//
Функция ЭффективныйПрофиль(Пользователь) Экспорт

	Описание = ОписаниеВыбораПрофиля(Пользователь);
	Если Описание.Конфликт Тогда
		ВызватьИсключение Описание.Причина;
	КонецЕсли;
	Возврат Описание.Профиль;

КонецФункции

// Объясняет выбор без чтения моделей, ключей и персональных данных.
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи.
// Возвращаемое значение:
//  Структура - Профиль, Конфликт, Профили (максимальный приоритет), Причина.
Функция ОписаниеВыбораПрофиля(Пользователь) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	| Участники.Ссылка КАК Профиль,
	| Участники.Ссылка.Приоритет КАК Приоритет
	|ИЗ Справочник.ИИА_ПрофилиДоступа.Участники КАК Участники
	|ГДЕ НЕ Участники.Ссылка.ПометкаУдаления
	| И (Участники.Участник = &Пользователь
	| ИЛИ Участники.Участник В
	| (ВЫБРАТЬ Составы.ГруппаПользователей КАК ГруппаПользователей
	| ИЗ РегистрСведений.СоставыГруппПользователей КАК Составы
	| ГДЕ Составы.Пользователь = &Пользователь И Составы.Используется))";
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Возврат ОписаниеВыбораИзКандидатов(Запрос.Выполнить().Выгрузить(),
		Константы.ИИА_ПрофильПоУмолчанию.Получить());

КонецФункции

// Выбирает уникальный профиль максимального приоритета независимо от порядка кандидатов.
// Параметры:
//  Кандидаты - ТаблицаЗначений, Массив из Структура - Профиль, Приоритет.
//  ПрофильПоУмолчанию - СправочникСсылка.ИИА_ПрофилиДоступа, Неопределено.
// Возвращаемое значение:
//  Структура - Профиль, Конфликт, Профили, Причина.
Функция ОписаниеВыбораИзКандидатов(Кандидаты, ПрофильПоУмолчанию) Экспорт

	Результат = Новый Структура("Профиль, Конфликт, Профили, Причина",
		Неопределено, Ложь, Новый Массив, "");
	МаксимальныйПриоритет = Неопределено;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если МаксимальныйПриоритет = Неопределено Или Кандидат.Приоритет > МаксимальныйПриоритет Тогда
			МаксимальныйПриоритет = Кандидат.Приоритет;
			Результат.Профили.Очистить();
		КонецЕсли;
		Если Кандидат.Приоритет = МаксимальныйПриоритет
			И Результат.Профили.Найти(Кандидат.Профиль) = Неопределено Тогда
			Результат.Профили.Добавить(Кандидат.Профиль);
		КонецЕсли;
	КонецЦикла;
	Если Результат.Профили.Количество() > 1 Тогда
		Результат.Конфликт = Истина;
		Результат.Причина = НСтр("ru = 'Назначено несколько профилей с одинаковым максимальным приоритетом. Обратитесь к администратору: он должен изменить назначения или приоритеты. Вопрос не отправлен.'");
	ИначеЕсли Результат.Профили.Количество() = 1 Тогда
		Результат.Профиль = Результат.Профили[0];
		Результат.Причина = НСтр("ru = 'Выбран назначенный профиль с максимальным приоритетом.'");
	ИначеЕсли ЗначениеЗаполнено(ПрофильПоУмолчанию) Тогда
		Результат.Профиль = ПрофильПоУмолчанию;
		Результат.Причина = НСтр("ru = 'Нет назначений пользователю или его группам: выбран профиль по умолчанию.'");
	Иначе
		Результат.Причина = НСтр("ru = 'Профиль не назначен: действует базовый периметр ассистента.'");
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Правила действующего профиля текущего пользователя (без кэша; см. ИИА_ПериметрПовтИсп.ПравилаПрофиля).
//
// Параметры:
//  БезКэша - Булево - в режиме версий политик читать снимок действующей версии без кэша сеанса
//    (выполнение изменения данных: снятое разрешение действует сразу).
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура, Неопределено - Неопределено, если профиль не назначен:
//   * Профиль - СправочникСсылка.ИИА_ПрофилиДоступа
//   * Наименование - Строка
//   * ПоУмолчаниюРазрешено - Булево
//   * ИсходныйКод - Булево - разрешён доступ к исходному коду (инструменты code_*).
//   * ЗапрещенныеИнструменты - ФиксированныйМассив из Строка - имена инструментов, выключенных профилем.
//   * Правила - ФиксированноеСоответствие из КлючИЗначение:
//      ** Ключ - Строка - полное имя объекта или поля в верхнем регистре.
//      ** Значение - Булево - Истина, если разрешено.
//   * Счета - ФиксированнаяСтруктура - правила счетов бухучёта (корни, действуют с субсчетами):
//      ** Разрешенные - ФиксированныйМассив из ПланСчетовСсылка.Хозрасчетный
//      ** Запрещенные - ФиксированныйМассив из ПланСчетовСсылка.Хозрасчетный
//   * ПрофильНайден - Булево - Ложь, если в режиме версий политик профиля нет в снимке действующей версии.
//   * ЗаписьДанных - ФиксированноеСоответствие из КлючИЗначение - разрешения «Запись данных» (propose_change):
//      ** Ключ - Строка - полное имя вида в верхнем регистре.
//      ** Значение - ФиксированнаяСтруктура - см. РазрешениеЗаписи.
//
Функция ПостроитьПравилаТекущегоПользователя(БезКэша = Ложь) Экспорт

	Профиль = ЭффективныйПрофиль(Пользователи.ТекущийПользователь());
	Если Профиль = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	// Режим версий политик (план, 4.12): правила берутся из действующей версии, правки профиля - после активации.
	Если ИИА_Политики.ПолитикиЧерезВерсии() Тогда
		Возврат ИИА_Политики.ПравилаПрофиляИзДействующейВерсии(Профиль, БезКэша);
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Профиль,
		"Наименование, ПоУмолчаниюРазрешено, ИсходныйКод, Правила, Инструменты, Счета, ЗаписьДанных");
	Правила = Новый Соответствие;
	Для Каждого Строка Из Реквизиты.Правила.Выгрузить() Цикл
		Если ЗначениеЗаполнено(Строка.ПолноеИмя) Тогда
			Правила.Вставить(ВРег(СокрЛП(Строка.ПолноеИмя)), Строка.Разрешено);
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Профиль", Профиль);
	Результат.Вставить("Наименование", Реквизиты.Наименование);
	Результат.Вставить("ПоУмолчаниюРазрешено", Реквизиты.ПоУмолчаниюРазрешено);
	Результат.Вставить("ИсходныйКод", Реквизиты.ИсходныйКод);
	ЗапрещенныеИнструменты = Новый Массив;
	Для Каждого Строка Из Реквизиты.Инструменты.Выгрузить() Цикл
		Если Строка.Запрещен И ЗначениеЗаполнено(Строка.Имя) Тогда
			ЗапрещенныеИнструменты.Добавить(НРег(СокрЛП(Строка.Имя)));
		КонецЕсли;
	КонецЦикла;
	Результат.Вставить("ЗапрещенныеИнструменты", Новый ФиксированныйМассив(ЗапрещенныеИнструменты));
	Результат.Вставить("Правила", Новый ФиксированноеСоответствие(Правила));
	РазрешенныеСчета = Новый Массив;
	ЗапрещенныеСчета = Новый Массив;
	Для Каждого Строка Из Реквизиты.Счета.Выгрузить() Цикл
		Если ЗначениеЗаполнено(Строка.Счет) Тогда
			Счета = ?(Строка.Разрешен, РазрешенныеСчета, ЗапрещенныеСчета);
			Счета.Добавить(Строка.Счет);
		КонецЕсли;
	КонецЦикла;
	Результат.Вставить("Счета", Новый ФиксированнаяСтруктура("Разрешенные, Запрещенные",
		Новый ФиксированныйМассив(РазрешенныеСчета), Новый ФиксированныйМассив(ЗапрещенныеСчета)));
	ЗаписьДанных = Новый Соответствие;
	Для Каждого Строка Из Реквизиты.ЗаписьДанных.Выгрузить() Цикл
		Если ЗначениеЗаполнено(Строка.ПолноеИмя) Тогда
			ЗаписьДанных.Вставить(ВРег(СокрЛП(Строка.ПолноеИмя)), РазрешениеЗаписи(Строка.ПолноеИмя, Строка.Изменение,
				Строка.Проведение, Строка.ОтменаПроведения, Строка.ПометкаУдаления, Строка.Реквизиты,
				Строка.ПробныйПрогонЗапрещен));
		КонецЕсли;
	КонецЦикла;
	Результат.Вставить("ЗаписьДанных", Новый ФиксированноеСоответствие(ЗаписьДанных));
	Результат.Вставить("ПрофильНайден", Истина);
	Возврат Новый ФиксированнаяСтруктура(Результат);

КонецФункции

// Разрешение «Запись данных» одного вида объектов в формате правил профиля (живой профиль и снимок версии политик).
//
// Параметры:
//  ПолноеИмя - Строка
//  Изменение - Булево
//  Проведение - Булево
//  ОтменаПроведения - Булево
//  ПометкаУдаления - Булево
//  Реквизиты - Строка, Массив из Строка - имена через запятую или массив; пусто - все допустимые реквизиты шапки.
//  ПробныйПрогонЗапрещен - Булево
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура - ПолноеИмя, Изменение, Проведение, ОтменаПроведения, ПометкаУдаления,
//    ПробныйПрогонЗапрещен, Реквизиты (ФиксированныйМассив из Строка - имена в верхнем регистре).
//
Функция РазрешениеЗаписи(ПолноеИмя, Изменение, Проведение, ОтменаПроведения, ПометкаУдаления, Реквизиты,
	ПробныйПрогонЗапрещен) Экспорт

	Имена = Новый Массив;
	Для Каждого Имя Из ?(ТипЗнч(Реквизиты) = Тип("Строка"), СтрРазделить(Реквизиты, ",", Ложь), Реквизиты) Цикл
		Имя = ВРег(СокрЛП(Строка(Имя)));
		Если Не ПустаяСтрока(Имя) И Имена.Найти(Имя) = Неопределено Тогда
			Имена.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый ФиксированнаяСтруктура("ПолноеИмя, Изменение, Проведение, ОтменаПроведения, ПометкаУдаления, "
		+ "ПробныйПрогонЗапрещен, Реквизиты", СокрЛП(ПолноеИмя), Изменение = Истина, Проведение = Истина,
		ОтменаПроведения = Истина, ПометкаУдаления = Истина, ПробныйПрогонЗапрещен = Истина,
		Новый ФиксированныйМассив(Имена));

КонецФункции

// Выключен ли инструмент профилем текущего пользователя.
//
// Параметры:
//  ИмяИнструмента - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция ИнструментЗапрещенПрофилем(ИмяИнструмента) Экспорт

	Профиль = ИИА_ПериметрПовтИсп.ПравилаПрофиля();
	Если Профиль = Неопределено Или Не Профиль.Свойство("ЗапрещенныеИнструменты") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Профиль.ЗапрещенныеИнструменты.Найти(НРег(ИмяИнструмента)) <> Неопределено;

КонецФункции

// Запрещает ли профиль текущего пользователя объект метаданных.
//
// Параметры:
//  ПолноеИмяОбъекта - Строка - "Справочник.Контрагенты".
//  Причина - Строка - возвращаемый параметр.
//  ПравилаПрофиля - ФиксированнаяСтруктура, Неопределено - правила вместо кэша сеанса (см. ПостроитьПравилаТекущегоПользователя).
//
// Возвращаемое значение:
//  Булево
//
Функция ОбъектЗапрещенПрофилем(ПолноеИмяОбъекта, Причина = "", ПравилаПрофиля = Неопределено) Экспорт

	Профиль = ?(ПравилаПрофиля = Неопределено, ИИА_ПериметрПовтИсп.ПравилаПрофиля(), ПравилаПрофиля);
	Если Профиль = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Разрешено = Профиль.Правила.Получить(ВРег(ПолноеИмяОбъекта));
	Если Разрешено = Неопределено Тогда
		Разрешено = Профиль.ПоУмолчаниюРазрешено;
	КонецЕсли;
	Если Разрешено Тогда
		Возврат Ложь;
	КонецЕсли;
	Причина = ПричинаПрофиля(Профиль);
	Возврат Истина;

КонецФункции

// Запрещает ли профиль отчёт явным правилом (Разрешено = Ложь). Режим «по умолчанию запрещено» не учитывается.
//
// Параметры:
//  ПолноеИмяОтчета - Строка - "Отчет.ОборотноСальдоваяВедомость".
//
// Возвращаемое значение:
//  Булево
//
Функция ОтчетЗапрещенПрофилемЯвно(ПолноеИмяОтчета) Экспорт

	Профиль = ИИА_ПериметрПовтИсп.ПравилаПрофиля();
	Если Профиль = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Профиль.Правила.Получить(ВРег(ПолноеИмяОтчета)) = Ложь;

КонецФункции

// Запрещает ли профиль поле объекта. Правило ищется от самого точного: поле табличной части,
// табличная часть, объект, режим по умолчанию.
//
// Параметры:
//  ПолноеИмяОбъекта - Строка
//  ПутьПоля - Строка - "Поле" или "ТабличнаяЧасть.Поле".
//  Причина - Строка - возвращаемый параметр.
//  ПравилаПрофиля - ФиксированнаяСтруктура, Неопределено - см. ОбъектЗапрещенПрофилем.
//
// Возвращаемое значение:
//  Булево
//
Функция ПолеЗапрещеноПрофилем(ПолноеИмяОбъекта, ПутьПоля, Причина = "", ПравилаПрофиля = Неопределено) Экспорт

	Профиль = ?(ПравилаПрофиля = Неопределено, ИИА_ПериметрПовтИсп.ПравилаПрофиля(), ПравилаПрофиля);
	Если Профиль = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ОбъектЗапрещенПрофилем(ПолноеИмяОбъекта, Причина, Профиль) Тогда
		Возврат Истина;
	КонецЕсли;

	Сегменты = СтрРазделить(ПутьПоля, ".", Ложь);
	Для Количество = 1 По Сегменты.Количество() Цикл
		Путь = ВРег(ПолноеИмяОбъекта);
		Для Индекс = 0 По Сегменты.Количество() - Количество Цикл
			Путь = Путь + "." + ВРег(Сегменты[Индекс]);
		КонецЦикла;
		Разрешено = Профиль.Правила.Получить(Путь);
		Если Разрешено <> Неопределено Тогда
			Если Не Разрешено Тогда
				Причина = ПричинаПрофиля(Профиль);
			КонецЕсли;
			Возврат Не Разрешено;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Запрещает ли профиль ссылочный тип (поле, ссылающееся на закрытый профилем объект, тоже закрыто).
//
// Параметры:
//  ПроверяемыйТип - Тип
//  Причина - Строка - возвращаемый параметр.
//  ПравилаПрофиля - ФиксированнаяСтруктура, Неопределено - см. ОбъектЗапрещенПрофилем.
//
// Возвращаемое значение:
//  Булево
//
Функция ТипЗапрещенПрофилем(ПроверяемыйТип, Причина = "", ПравилаПрофиля = Неопределено) Экспорт

	Профиль = ?(ПравилаПрофиля = Неопределено, ИИА_ПериметрПовтИсп.ПравилаПрофиля(), ПравилаПрофиля);
	Если Профиль = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ПроверяемыйТип);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ОбъектЗапрещенПрофилем(ОбъектМетаданных.ПолноеИмя(), Причина, Профиль);

КонецФункции

// Объекты метаданных для дерева настройки профиля, сгруппированные по видам.
// Ограничение периметра этапа (в коде) показывается, профиль его не снимает.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Представление - Строка - вид объектов.
//   * Объекты - Массив из Структура - ПолноеИмя, Представление, ВнеПериметра, Ограничение.
//
Функция ОбъектыДляНастройки() Экспорт

	Периметр = ИИА_Периметр.ОписаниеПериметра();
	Результат = Новый Массив;
	Для Каждого Вид Из ВидыОбъектов() Цикл
		Объекты = Новый Массив;
		Для Каждого ОбъектМетаданных Из Метаданные[Вид.Коллекция] Цикл
			ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
			Причина = Периметр.ЗапрещенныеОбъекты.Получить(ВРег(ПолноеИмя));
			Объекты.Добавить(Новый Структура("ПолноеИмя, Представление, ВнеПериметра, Ограничение",
				ПолноеИмя, ОбъектМетаданных.Представление(), Причина <> Неопределено,
				?(Причина = Неопределено, "", СтрШаблон(НСтр("ru = 'вне периметра: %1'"), Причина))));
		КонецЦикла;
		Если Объекты.Количество() > 0 Тогда
			Результат.Добавить(Новый Структура("Представление, Объекты", Вид.Представление, Объекты));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Поля объекта для настройки профиля: реквизиты, измерения, ресурсы, табличные части и их реквизиты.
//
// Параметры:
//  ПолноеИмяОбъекта - Строка
//
// Возвращаемое значение:
//  Массив из Структура - ПолноеИмя ("Вид.Объект.Поле"), Представление, ВнеПериметра, Ограничение.
//
Функция ПоляДляНастройки(ПолноеИмяОбъекта) Экспорт

	Результат = Новый Массив;
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмяОбъекта);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Периметр = ИИА_Периметр.ОписаниеПериметра();
	Для Каждого ИмяКоллекции Из СтрРазделить("Измерения,Ресурсы,Реквизиты", ",") Цикл
		Коллекция = КоллекцияОбъекта(ОбъектМетаданных, ИмяКоллекции);
		Если Коллекция = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Поле Из Коллекция Цикл
			ДобавитьПолеДляНастройки(Результат, Периметр, ПолноеИмяОбъекта, Поле.Имя, Поле.Представление());
		КонецЦикла;
	КонецЦикла;
	ТабличныеЧасти = КоллекцияОбъекта(ОбъектМетаданных, "ТабличныеЧасти");
	Если ТабличныеЧасти <> Неопределено Тогда
		Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
			ДобавитьПолеДляНастройки(Результат, Периметр, ПолноеИмяОбъекта, ТабличнаяЧасть.Имя,
				СтрШаблон(НСтр("ru = '%1 (табличная часть)'"), ТабличнаяЧасть.Представление()));
			Для Каждого Поле Из ТабличнаяЧасть.Реквизиты Цикл
				ДобавитьПолеДляНастройки(Результат, Периметр, ПолноеИмяОбъекта, ТабличнаяЧасть.Имя + "." + Поле.Имя,
					ТабличнаяЧасть.Представление() + ". " + Поле.Представление());
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВидыОбъектов()

	Виды = Новый Массив;
	Для Каждого Описание Из СтрРазделить(
		"Справочники:Справочники;Документы:Документы;ЖурналыДокументов:Журналы документов;"
		+ "РегистрыСведений:Регистры сведений;РегистрыНакопления:Регистры накопления;"
		+ "ПланыВидовХарактеристик:Планы видов характеристик;БизнесПроцессы:Бизнес-процессы;Задачи:Задачи;"
		+ "Отчеты:Отчёты", ";") Цикл
		Части = СтрРазделить(Описание, ":");
		Виды.Добавить(Новый Структура("Коллекция, Представление", Части[0], Части[1]));
	КонецЦикла;
	Возврат Виды;

КонецФункции

Процедура ДобавитьПолеДляНастройки(Результат, Периметр, ПолноеИмяОбъекта, ПутьПоля, Представление)

	Причина = Периметр.ЗапрещенныеПоля.Получить(ВРег(ПолноеИмяОбъекта + "." + ПутьПоля));
	Если Причина = Неопределено И ИИА_Периметр.ЭтоИмяСекрета(ПутьПоля) Тогда
		Причина = НСтр("ru = 'секрет'");
	КонецЕсли;
	Результат.Добавить(Новый Структура("ПолноеИмя, Представление, ВнеПериметра, Ограничение",
		ПолноеИмяОбъекта + "." + ПутьПоля, Представление, Причина <> Неопределено,
		?(Причина = Неопределено, "", СтрШаблон(НСтр("ru = 'вне периметра: %1'"), Причина))));

КонецПроцедуры

Функция КоллекцияОбъекта(ОбъектМетаданных, ИмяКоллекции)

	Попытка
		Возврат ОбъектМетаданных[ИмяКоллекции];
	// У объекта метаданных такой коллекции нет.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ПричинаПрофиля(Профиль)

	Возврат СтрШаблон(НСтр("ru = 'профиль доступа «%1»'"), Профиль.Наименование);

КонецФункции

#КонецОбласти
