#Область ФайлыВопроса

// Разрешены ли файлы в вопросах (настройка администратора; хранится признак запрета).
//
// Возвращаемое значение:
//  Булево
//
Функция ФайлыРазрешены() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Возврат Константы.ИИА_ЗапретитьФайлы.Получить() <> Истина;

КонецФункции

// Расширения, которые уходят модели текстом и не требуют флажка подключения «Принимает документы».
//
// Возвращаемое значение:
//  Массив из Строка - без точки, нижний регистр.
//
Функция ТекстовыеРасширения() Экспорт

	Возврат СтрРазделить("txt,md,csv,json,xml,log,xlsx,xls", ",");

КонецФункции

// Все расширения файлов вопроса: текстовые и PDF.
//
// Возвращаемое значение:
//  Массив из Строка - без точки, нижний регистр.
//
Функция РасширенияДокументов() Экспорт

	Расширения = ТекстовыеРасширения();
	Расширения.Вставить(0, "pdf");
	Возврат Расширения;

КонецФункции

// Читает файл вопроса: проверка формата и размера, извлечение текста, маскирование имени.
//
// Параметры:
//  Имя - Строка - исходное имя файла с расширением.
//  ДвоичныеДанные - ДвоичныеДанные
//  Источник - Строка - "computer" или "base".
//
// Возвращаемое значение:
//  Структура, Строка - файл вопроса или текст ошибки для пользователя:
//   * Ид - Строка - f1..f5, назначает НазначитьИдентификаторы.
//   * Имя - Строка - имя после текстового слоя (для истории, журнала и модели).
//   * ИмяПоказа - Строка - исходное имя, только для страницы автора.
//   * Формат - Строка - расширение.
//   * Источник - Строка
//   * Ссылка - Строка - навигационная ссылка файла базы; пусто для файла с компьютера.
//   * Размер - Число - байт.
//   * Вид - Строка - "text" или "pdf".
//   * Данные - Строка - извлечённый текст (до ПределТекстаФайла) или data URL PDF.
//   * Символов - Число - длина извлечённого текста до обрезки.
//   * Строк - Число
//   * Листы - Массив из Строка - имена листов xlsx.
//   * Класс - Число - класс данных: 1 для файла с компьютера, класс владельца для файла базы.
//   * Обрезан - Булево - текст длиннее ПределТекстаФайла.
//   * ДвоичныеДанные - ДвоичныеДанные - исходный файл для хранения с репликой (удаляется до запуска хода).
//
Функция ПрочитатьФайл(Знач Имя, ДвоичныеДанные, Источник = "computer") Экспорт

	Ошибка = НСтр("ru = 'Файл не поддерживается: допустимы PDF, текстовые файлы (TXT, MD, CSV, JSON, XML, LOG) и Excel до 10 МБ.'");
	Если ТипЗнч(Имя) <> Тип("Строка") Или ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		Возврат Ошибка;
	КонецЕсли;
	Имя = Лев(СокрЛП(ИИА_ЗащитаОтИнъекций.ОчиститьНевидимыеСимволы(Имя)), 200);
	Расширение = РасширениеИмени(Имя);
	Размер = ДвоичныеДанные.Размер();
	Если РасширенияДокументов().Найти(Расширение) = Неопределено Или Размер = 0 Тогда
		Возврат Ошибка;
	КонецЕсли;
	Если Размер > МаксимумРазмераФайла() Тогда
		Возврат СтрШаблон(НСтр("ru = 'Файл «%1» больше 10 МБ.'"), Имя);
	КонецЕсли;

	Файл = НовыйФайлВопроса();
	Файл.ИмяПоказа = Имя;
	// Расширение - не часть слова: иначе последнее слово названия («... Ииат.csv») не находится текстовым слоем.
	Точка = СтрНайти(Имя, ".", НаправлениеПоиска.СКонца);
	Файл.Имя = ТекстДляМодели(Лев(Имя, Точка - 1)).Текст + Сред(Имя, Точка);
	Файл.Формат = Расширение;
	Файл.Источник = ?(Источник = "base", "base", "computer");
	Файл.Размер = Размер;
	Файл.ДвоичныеДанные = ДвоичныеДанные;
	Если Расширение = "pdf" Тогда
		Файл.Вид = "pdf";
		Файл.Данные = "data:application/pdf;base64,"
			+ СтрЗаменить(СтрЗаменить(Base64Строка(ДвоичныеДанные), Символы.ВК, ""), Символы.ПС, "");
		Возврат Файл;
	КонецЕсли;

	Если Расширение = "xlsx" Или Расширение = "xls" Тогда
		Текст = ТекстТаблицы(ДвоичныеДанные, Расширение);
		Если Расширение = "xlsx" Тогда
			Файл.Листы = ЛистыКниги(ДвоичныеДанные);
		КонецЕсли;
	Иначе
		Текст = ТекстФайла(ДвоичныеДанные);
	КонецЕсли;
	Текст = ИИА_ЗащитаОтИнъекций.ОчиститьНевидимыеСимволы(Текст);
	Если ПустаяСтрока(Текст) Тогда
		Возврат СтрШаблон(НСтр("ru = 'Не удалось прочитать файл «%1».'"), Имя);
	КонецЕсли;
	Файл.Символов = СтрДлина(Текст);
	Если Файл.Символов > ПределТекстаФайла() Тогда
		Текст = Лев(Текст, ПределТекстаФайла());
		Файл.Обрезан = Истина;
	КонецЕсли;
	Файл.Данные = Текст;
	Файл.Строк = СтрЧислоСтрок(Текст);
	Возврат Файл;

КонецФункции

// Проверяет лимиты файлов сообщения: число и общий размер (защита от подделанного сообщения страницы).
//
// Параметры:
//  Файлы - Массив из Структура - см. ПрочитатьФайл.
//
// Возвращаемое значение:
//  Строка - текст ошибки; пусто - лимиты соблюдены.
//
Функция ОшибкаЛимитов(Файлы) Экспорт

	Если Файлы.Количество() > МаксимумФайлов() Тогда
		Возврат СтрШаблон(НСтр("ru = 'Не больше %1 файлов в сообщении.'"), МаксимумФайлов());
	КонецЕсли;
	Всего = 0;
	Для Каждого Файл Из Файлы Цикл
		Всего = Всего + Файл.Размер;
	КонецЦикла;
	Если Всего > МаксимумРазмераСообщения() Тогда
		Возврат НСтр("ru = 'Файлы сообщения вместе больше 20 МБ.'");
	КонецЕсли;
	Возврат "";

КонецФункции

// Назначает файлам вопроса идентификаторы f1, f2, ... по порядку.
//
// Параметры:
//  Файлы - Массив из Структура - см. ПрочитатьФайл.
//
Процедура НазначитьИдентификаторы(Файлы) Экспорт

	Для Номер = 1 По Файлы.Количество() Цикл
		Файлы[Номер - 1].Ид = "f" + Формат(Номер, "ЧГ=");
	КонецЦикла;

КонецПроцедуры

// Пометка о файлах для текста реплики, истории модели и журнала: Ид, имя после текстового слоя, формат, размер.
//
// Параметры:
//  Файлы - Массив из Структура - см. ПрочитатьФайл.
//
// Возвращаемое значение:
//  Строка - « [приложены файлы: f1 «имя» (xlsx, 1,2 МБ)]» или пусто.
//
Функция ПометкаФайлов(Файлы) Экспорт

	Если Файлы.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Описания = Новый Массив;
	Для Каждого Файл Из Файлы Цикл
		Описания.Добавить(СтрШаблон("%1 «%2» (%3, %4)", Файл.Ид, Файл.Имя, Файл.Формат,
			ПредставлениеРазмера(Файл.Размер)));
	КонецЦикла;
	Возврат СтрШаблон(НСтр("ru = ' [приложены файлы: %1]'"), СтрСоединить(Описания, ", "));

КонецФункции

// Текстовый слой для текста из файла пользователя - тот же, что для текста вопроса: ФИО пользователей ->
// псевдонимы (ИИА_Периметр.ЗамаскироватьИмена), детекторы ПДн и секретов (ПроверитьСообщениеПользователя) и, если
// действует коммерческое маскирование, коммерческий текстовый слой (ИИА_Маскирование.ЗамаскироватьТексты).
//
// Параметры:
//  Текст - Строка
//  Кэш - Структура, Неопределено - см. ИИА_Маскирование.НовыйКэш.
//
// Возвращаемое значение:
//  Структура:
//   * Текст - Строка
//   * Категории - Массив из Строка - названия находок без значений.
//   * Успех - Булево - Ложь, если коммерческий слой превысил лимит и текст заменён заглушкой.
//
Функция ТекстДляМодели(Знач Текст, Кэш = Неопределено) Экспорт

	Результат = Новый Структура("Текст, Категории, Успех", "", Новый Массив, Истина);
	Если ТипЗнч(Текст) <> Тип("Строка") Или ПустаяСтрока(Текст) Тогда
		Возврат Результат;
	КонецЕсли;
	Проверка = ИИА_ЗащитаОтИнъекций.ПроверитьСообщениеПользователя(ИИА_Периметр.ЗамаскироватьИмена(Текст));
	Результат.Текст = Проверка.Текст;
	Результат.Категории = Проверка.Категории;
	Канал = ?(Кэш = Неопределено, "", Кэш.Канал);
	Если ИИА_Маскирование.ДействуетКоммерческоеМаскирование(Канал) Тогда
		Тексты = Новый Массив;
		Тексты.Добавить(Результат.Текст);
		Маскирование = ИИА_Маскирование.ЗамаскироватьТексты(Тексты, Кэш);
		Если Маскирование.Успех Тогда
			Результат.Текст = Маскирование.Тексты[0];
		Иначе
			Результат.Текст = ИИА_Периметр.ЗаглушкаСкрыто();
			Результат.Успех = Ложь;
			Результат.Категории.Добавить(Маскирование.КодОшибки);
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Добавляет файлы вопроса в части мультимодального сообщения модели. Текстовые файлы - заголовок и начало текста
// в пределах БюджетТекстаСообщения (через ТекстДляМодели и конверт), PDF - частью file с замаскированным именем.
//
// Параметры:
//  Части - Массив из Соответствие - части сообщения OpenAI; дополняется.
//  Файлы - Массив из Структура - см. ПрочитатьФайл (с Ид).
//  Граница - Строка - см. ИИА_ЗащитаОтИнъекций.НоваяГраница.
//  Итог - Структура - накапливается:
//   * Срабатывания - Число - фрагменты, похожие на инструкции.
//   * Категории - Массив из Строка - находки текстового слоя (без значений).
//   * Обрезанные - Число - файлов, показанных не полностью (модели нужен read_attachment).
//
Процедура ДобавитьФайлыВСообщение(Части, Файлы, Граница, Итог) Экспорт

	Доли = ДолиБюджета(Файлы);
	// Один кэш текстового слоя на все файлы сообщения: одинаковые названия маскируются один раз.
	Кэш = ИИА_Маскирование.НовыйКэш();
	Для Каждого Файл Из Файлы Цикл
		Если Файл.Вид = "pdf" Тогда
			ОписаниеФайла = Новый Соответствие;
			ОписаниеФайла.Вставить("filename", Файл.Имя);
			ОписаниеФайла.Вставить("file_data", Файл.Данные);
			Часть = Новый Соответствие;
			Часть.Вставить("type", "file");
			Часть.Вставить("file", ОписаниеФайла);
			Части.Добавить(Часть);
			Продолжить;
		КонецЕсли;
		Доля = Доли.Получить(Файл.Ид);
		Фрагмент = ФрагментПоГраницеСтроки(Файл.Данные, 0, ?(Доля = Неопределено, 0, Доля));
		Слой = ТекстДляМодели(Фрагмент, Кэш);
		ДобавитьКатегории(Итог.Категории, Слой.Категории);
		Заголовок = ЗаголовокФайла(Файл, Кэш);
		Показано = СтрДлина(Фрагмент);
		Если Показано < СтрДлина(Файл.Данные) Или Файл.Обрезан Тогда
			Итог.Обрезанные = Итог.Обрезанные + 1;
			Заголовок = Заголовок + Символы.ПС + СтрШаблон(
				НСтр("ru = 'Показано %1 из %2 символов. Остальное читай инструментом read_attachment (file_id ""%3"", offset %1).'"),
				Формат(Показано, "ЧН=0; ЧГ="), Формат(СтрДлина(Файл.Данные), "ЧН=0; ЧГ="), Файл.Ид);
		КонецЕсли;
		Срабатывания = 0;
		Части.Добавить(ТекстоваяЧасть(Заголовок + Символы.ПС
			+ ИИА_ЗащитаОтИнъекций.ДанныеВКонверте(Слой.Текст, Граница, Срабатывания)));
		Итог.Срабатывания = Итог.Срабатывания + Срабатывания;
	КонецЦикла;

КонецПроцедуры

// Новый итог для ДобавитьФайлыВСообщение.
//
// Возвращаемое значение:
//  Структура - Срабатывания, Категории, Обрезанные.
//
Функция НовыйИтогФайлов() Экспорт

	Возврат Новый Структура("Срабатывания, Категории, Обрезанные", 0, Новый Массив, 0);

КонецФункции

// Описание файлов хода для журнала «Документы»: формат, размер, источник по каждому файлу, без имён и содержимого.
//
// Параметры:
//  Файлы - Массив из Структура - см. ПрочитатьФайл.
//  Итог - Структура - см. НовыйИтогФайлов.
//
// Возвращаемое значение:
//  Строка
//
Функция ПодробностиЖурнала(Файлы, Итог) Экспорт

	Описания = Новый Массив;
	Для Каждого Файл Из Файлы Цикл
		Описания.Добавить(СтрШаблон("%1:%2:%3:%4", Файл.Ид, Файл.Формат, Формат(Файл.Размер, "ЧН=0; ЧГ="), Файл.Источник));
	КонецЦикла;
	Возврат СтрШаблон("files=%1; findings=%2; truncated=%3; injection_hits=%4", СтрСоединить(Описания, ","),
		СтрСоединить(Итог.Категории, ","), Формат(Итог.Обрезанные, "ЧН=0; ЧГ="),
		Формат(Итог.Срабатывания, "ЧН=0; ЧГ="));

КонецФункции

#КонецОбласти

#Область ФайлыБазы

// Есть ли в конфигурации подсистема БСП «Работа с файлами».
//
// Возвращаемое значение:
//  Булево
//
Функция ФайлыБазыДоступны() Экспорт

	Возврат ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.РаботаСФайлами")
		И Метаданные.ОпределяемыеТипы.Найти("ПрисоединенныйФайл") <> Неопределено;

КонецФункции

// Является ли значение присоединённым файлом БСП (тип входит в ОпределяемыйТип.ПрисоединенныйФайл).
//
// Параметры:
//  Значение - Произвольный
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоПрисоединенныйФайл(Значение) Экспорт

	Если Не ФайлыБазыДоступны() Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Метаданные.ОпределяемыеТипы.Найти("ПрисоединенныйФайл").Тип.СодержитТип(ТипЗнч(Значение));

КонецФункции

// Присоединённые файлы объектов, которые пользователь может приложить к вопросу: владелец проходит периметр,
// права и профиль (ИИА_Инструменты.ОписаниеКонтекста), файл читается запросом РАЗРЕШЕННЫЕ, не помечен
// на удаление, не зашифрован, формат поддерживается, размер в пределах лимита.
//
// Параметры:
//  Владельцы - Массив из ЛюбаяСсылка - объект-контекст чата и объекты из ссылок вопроса.
//
// Возвращаемое значение:
//  Массив из Структура - Ссылка (ЛюбаяСсылка), Имя (Строка с расширением), Размер (Число), Владелец (Строка -
//    представление).
//
Функция ФайлыОбъектов(Владельцы) Экспорт

	Результат = Новый Массив;
	Если Не ФайлыБазыДоступны() Или Не ФайлыРазрешены() Тогда
		Возврат Результат;
	КонецЕсли;
	МодульРаботаСФайлами = ОбщегоНазначения.ОбщийМодуль("РаботаСФайлами");
	Для Каждого Владелец Из Владельцы Цикл
		Описание = ИИА_Инструменты.ОписаниеКонтекста(Владелец);
		Если Не Описание.Успех Тогда
			Продолжить;
		КонецЕсли;
		// Список БСП строится в привилегированном режиме: доступ проверяет СведенияФайлов (РАЗРЕШЕННЫЕ).
		Файлы = Новый Массив;
		МодульРаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(Владелец, Файлы);
		Для Каждого Сведения Из СведенияФайлов(Файлы) Цикл
			Если ОшибкаФайлаБазы(Сведения) = "" Тогда
				Результат.Добавить(Новый Структура("Ссылка, Имя, Размер, Владелец", Сведения.Ссылка,
					Сведения.Имя, Сведения.Размер, Описание.Представление));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Читает присоединённый файл базы для вопроса. Проверки выполняются при каждом чтении (отправка, перегенерация):
// подсистема есть; запрос РАЗРЕШЕННЫЕ под правами пользователя находит файл (не помечен на удаление, не зашифрован);
// справочник файлов не запрещён периметром; владелец проходит ИИА_Инструменты.ОписаниеКонтекста (периметр, права,
// профиль, класс); формат и размер в пределах лимитов. Только затем - РаботаСФайлами.ДвоичныеДанныеФайла
// (БСП читает данные в привилегированном режиме, поэтому права проверены явно до вызова).
//
// Параметры:
//  Ссылка - ЛюбаяСсылка - присоединённый файл.
//
// Возвращаемое значение:
//  Структура, Строка - файл вопроса (см. ПрочитатьФайл; Источник "base", Ссылка - навигационная ссылка, Класс -
//    класс владельца) или текст ошибки для пользователя.
//
Функция ПрочитатьФайлБазы(Ссылка) Экспорт

	Недоступен = НСтр("ru = 'Файл из базы недоступен: нет прав, файл удалён или закрыт для ассистента.'");
	Если Не ФайлыРазрешены() Тогда
		Возврат НСтр("ru = 'Файлы в вопросах отключены администратором.'");
	КонецЕсли;
	Если Не ЭтоПрисоединенныйФайл(Ссылка) Тогда
		Возврат Недоступен;
	КонецЕсли;
	Если ИИА_Периметр.ОбъектЗапрещен(Ссылка.Метаданные().ПолноеИмя()) Тогда
		Возврат Недоступен;
	КонецЕсли;
	Ссылки = Новый Массив;
	Ссылки.Добавить(Ссылка);
	Сведения = СведенияФайлов(Ссылки);
	Если Сведения.Количество() = 0 Тогда
		Возврат Недоступен;
	КонецЕсли;
	Сведения = Сведения[0];
	Ошибка = ОшибкаФайлаБазы(Сведения);
	Если Не ПустаяСтрока(Ошибка) Тогда
		Возврат Ошибка;
	КонецЕсли;
	Описание = ИИА_Инструменты.ОписаниеКонтекста(Сведения.Владелец);
	Если Не Описание.Успех Тогда
		Возврат Недоступен;
	КонецЕсли;

	МодульРаботаСФайлами = ОбщегоНазначения.ОбщийМодуль("РаботаСФайлами");
	ДвоичныеДанные = МодульРаботаСФайлами.ДвоичныеДанныеФайла(Ссылка, Ложь);
	Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		Возврат Недоступен;
	КонецЕсли;
	Файл = ПрочитатьФайл(Сведения.Имя, ДвоичныеДанные, "base");
	Если ТипЗнч(Файл) = Тип("Структура") Тогда
		Файл.Ссылка = ПолучитьНавигационнуюСсылку(Ссылка);
		Файл.Класс = ИИА_КлассыДанных.ПодтвержденныйКласс(Описание.Класс);
		// Файл базы хранится ссылкой, а не копией.
		Файл.ДвоичныеДанные = Неопределено;
	КонецЕсли;
	Возврат Файл;

КонецФункции

#КонецОбласти

#Область Инструменты

// Описания инструментов файлов в формате OpenAI tools: read_attachment и, для канала chat, make_file.
// read_attachment модель видит, только если в ходе есть обрезанные файлы (лишнее убирает ИИА_Агент).
//
// Параметры:
//  Канал - Строка - "chat" или "http".
//
// Возвращаемое значение:
//  Массив из Соответствие
//
Функция ОписанияИнструментов(Канал) Экспорт

	Инструменты = Новый Массив;
	Свойства = Новый Соответствие;
	Свойства.Вставить("file_id", СвойствоПараметра("string", НСтр("ru = 'Идентификатор файла текущего вопроса: f1, f2, ...'")));
	Свойства.Вставить("offset", СвойствоПараметра("integer", НСтр("ru = 'С какого символа читать (0 - с начала).'")));
	Свойства.Вставить("limit", СвойствоПараметра("integer",
		СтрШаблон(НСтр("ru = 'Сколько символов прочитать, не больше %1.'"), Формат(ПорцияЧтения(), "ЧГ="))));
	Инструменты.Добавить(ОписаниеИнструмента("read_attachment",
		СтрШаблон(НСтр("ru = 'Читает продолжение большого файла, приложенного к текущему вопросу: порция с номерами строк. Не больше %1 вызовов за ход.'"),
			МаксимумЧтений()), Свойства, "file_id"));

	Если Канал = "chat" Тогда
		Свойства = Новый Соответствие;
		Формат_ = СвойствоПараметра("string", НСтр("ru = 'md, csv или xlsx.'"));
		Формат_.Вставить("enum", СтрРазделить("md,csv,xlsx", ","));
		Свойства.Вставить("format", Формат_);
		Свойства.Вставить("title", СвойствоПараметра("string", НСтр("ru = 'Название файла без расширения.'")));
		Свойства.Вставить("table_id", СвойствоПараметра("string",
			НСтр("ru = 'Таблица хода (t1, t2, ...) - источник для csv и xlsx.'")));
		Свойства.Вставить("content", СвойствоПараметра("string",
			НСтр("ru = 'Текст файла для md или csv (разделитель ;), до 100000 символов. Указывай либо table_id, либо content.'")));
		Инструменты.Добавить(ОписаниеИнструмента("make_file",
			НСтр("ru = 'Создаёт файл для пользователя (md, csv, xlsx) из таблицы хода или текста: под ответом появится карточка «Сохранить / Открыть». Возвращает file_id; маркер [[file:<file_id>]] в ответе ставит карточку в это место. Данные файла тебе не возвращаются.'"),
			Свойства, "format,title"));
	КонецЕсли;
	Возврат Инструменты;

КонецФункции

// Инструмент read_attachment: порция текста файла текущего хода с номерами строк. Порция проходит ТекстДляМодели;
// если коммерческий слой превысил лимит, порция сокращается, ход не отменяется.
//
// Параметры:
//  АргументыJSON - Строка
//  Состояние - Структура - состояние хода (сохраняется и на паузе):
//   * ФайлыХода - Массив из Структура - файлы текущего вопроса (см. ПрочитатьФайл).
//   * ЧтенийФайлов - Число - вызовов read_attachment в ходе; увеличивается.
//
// Возвращаемое значение:
//  Структура - Успех, Данные, Таблица, Строк, Скрыто, Итог, Класс (см. ИИА_Инструменты.ВыполнитьИнструмент).
//
Функция ПрочитатьФрагмент(АргументыJSON, Состояние) Экспорт

	ФайлыХода = Неопределено;
	Чтений = 0;
	Состояние.Свойство("ФайлыХода", ФайлыХода);
	Состояние.Свойство("ЧтенийФайлов", Чтений);
	Чтений = ?(ТипЗнч(Чтений) = Тип("Число"), Чтений, 0);
	// Инструменты файлов вызываются агентом напрямую, не через ИИА_Инструменты.ВыполнитьИнструмент: запрет профилем
	// проверяется здесь (модель может вызвать инструмент, которого нет в её списке).
	Если ИИА_ПрофилиДоступа.ИнструментЗапрещенПрофилем("read_attachment") Тогда
		Возврат ОтказИнструмента("TOOL_DISABLED", НСтр("ru = 'Инструмент read_attachment выключен профилем доступа.'"));
	КонецЕсли;
	Аргументы = АргументыИнструмента(АргументыJSON);
	Если Аргументы = Неопределено Тогда
		Возврат ОтказИнструмента("BAD_ARGUMENTS", НСтр("ru = 'Аргументы инструмента должны быть JSON-объектом.'"));
	КонецЕсли;
	Если Чтений >= МаксимумЧтений() Тогда
		Возврат ОтказИнструмента("READ_LIMIT", СтрШаблон(НСтр("ru = 'За ход можно прочитать не больше %1 порций. Ответь по прочитанному.'"),
			МаксимумЧтений()));
	КонецЕсли;
	Ид = Аргументы.Получить("file_id");
	Файл = Неопределено;
	Для Каждого Кандидат Из ?(ФайлыХода = Неопределено, Новый Массив, ФайлыХода) Цикл
		Если Кандидат.Ид = Ид И Кандидат.Вид = "text" Тогда
			Файл = Кандидат;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Файл = Неопределено Тогда
		Возврат ОтказИнструмента("FILE_NOT_FOUND",
			НСтр("ru = 'Такого текстового файла нет в текущем вопросе. Читаются только файлы текущего вопроса.'"));
	КонецЕсли;
	Состояние.Вставить("ЧтенийФайлов", Чтений + 1);
	Смещение = ЦелоеАргумента(Аргументы.Получить("offset"), 0);
	Лимит = ЦелоеАргумента(Аргументы.Получить("limit"), ПорцияЧтения());
	Лимит = Макс(1, Мин(Лимит, ПорцияЧтения()));
	Всего = СтрДлина(Файл.Данные);
	Смещение = Мин(Макс(0, Смещение), Всего);

	Кэш = Неопределено;
	КэшПроверок = Неопределено;
	Если Состояние.Свойство("КэшПроверок", КэшПроверок) И ТипЗнч(КэшПроверок) = Тип("Структура") Тогда
		КэшПроверок.Свойство("Маскирование", Кэш);
	КонецЕсли;
	// Файл после паузы хода уже прошёл текстовый слой (см. ПодготовитьКПаузе).
	Обработан = Ложь;
	Файл.Свойство("Обработан", Обработан);
	Фрагмент = "";
	Слой = Неопределено;
	// Коммерческий слой может отказать на большом тексте: порция сокращается вдвое (до трёх раз), ход продолжается.
	Сокращений = 0;
	Пока Истина Цикл
		Фрагмент = ФрагментПоГраницеСтроки(Файл.Данные, Смещение, Лимит);
		Нумерованный = СНомерамиСтрок(Фрагмент, СтрЧислоВхождений(Лев(Файл.Данные, Смещение), Символы.ПС) + 1);
		Если Обработан = Истина Тогда
			Слой = Новый Структура("Текст, Категории, Успех", Нумерованный, Новый Массив, Истина);
		Иначе
			Слой = ТекстДляМодели(Нумерованный, Кэш);
		КонецЕсли;
		Сокращений = Сокращений + 1;
		Если Слой.Успех Или СтрДлина(Фрагмент) <= 1000 Или Сокращений >= 3 Тогда
			Прервать;
		КонецЕсли;
		Лимит = Цел(Лимит / 2);
	КонецЦикла;
	Следующее = Смещение + СтрДлина(Фрагмент);
	Данные = Новый Структура("file_id, name, offset, returned, total, next_offset, truncated_file, text", Файл.Ид,
		Файл.Имя, Смещение, СтрДлина(Фрагмент), Всего, ?(Следующее < Всего, Следующее, Неопределено), Файл.Обрезан,
		Слой.Текст);
	Результат = Новый Структура("Успех, Данные, Таблица, Строк, Скрыто, Итог, Класс", Истина, Данные, Неопределено,
		СтрЧислоСтрок(Фрагмент), Слой.Категории.Количество(), "OK", Макс(1, Файл.Класс));
	Возврат Результат;

КонецФункции

// Готовит состояние хода к записи паузы (регистр состояний ходов): файлы текущего вопроса хранятся только после
// текстового слоя (ТекстДляМодели, порциями) и с признаком Обработан, без исходного имени и двоичных данных; PDF
// и изображения в состоянии не хранятся - ни в файлах хода, ни в частях сообщений модели (модель получила их до
// паузы, после паузы они повторно не отправляются).
//
// Параметры:
//  ПараметрыШагов - Структура - см. ИИА_Агент; ФайлыХода заменяется обработанными копиями.
//  Сообщения - Массив из Соответствие - сообщения модели хода; части file и image_url заменяются пометкой.
//
Процедура ПодготовитьКПаузе(ПараметрыШагов, Сообщения) Экспорт

	ФайлыХода = Неопределено;
	Если ПараметрыШагов.Свойство("ФайлыХода", ФайлыХода) И ТипЗнч(ФайлыХода) = Тип("Массив") Тогда
		Кэш = ИИА_Маскирование.НовыйКэш();
		Обработанные = Новый Массив;
		Для Каждого Файл Из ФайлыХода Цикл
			Обработан = Ложь;
			Файл.Свойство("Обработан", Обработан);
			Если Файл.Вид <> "text" Тогда
				Продолжить;
			ИначеЕсли Обработан = Истина Тогда
				Обработанные.Добавить(Файл);
				Продолжить;
			КонецЕсли;
			Копия = НовыйФайлВопроса();
			ЗаполнитьЗначенияСвойств(Копия, Файл, "Ид, Имя, Формат, Источник, Ссылка, Размер, Вид, Символов, Строк, Класс, Обрезан");
			Копия.ИмяПоказа = Копия.Имя;
			Копия.Данные = ОбработанныйТекст(Файл.Данные, Кэш);
			Копия.Вставить("Обработан", Истина);
			Обработанные.Добавить(Копия);
		КонецЦикла;
		ПараметрыШагов.ФайлыХода = Обработанные;
	КонецЕсли;
	Пометка = НСтр("ru = '[файл или изображение передано модели до паузы и не хранится]'");
	Для Каждого Сообщение Из ?(ТипЗнч(Сообщения) = Тип("Массив"), Сообщения, Новый Массив) Цикл
		Части = ?(ТипЗнч(Сообщение) = Тип("Соответствие"), Сообщение.Получить("content"), Неопределено);
		Если ТипЗнч(Части) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		Для Индекс = 0 По Части.ВГраница() Цикл
			Часть = Части[Индекс];
			Вид = ?(ТипЗнч(Часть) = Тип("Соответствие"), Часть.Получить("type"), "");
			Если Вид = "file" Или Вид = "image_url" Тогда
				Части[Индекс] = ТекстоваяЧасть(Пометка);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Инструмент make_file: проверяет аргументы и добавляет рецепт файла ответа (данные с псевдонимами, без
// двоичных данных). Таблица - из таблиц хода, текст - от модели (секреты и ПДн скрываются, как в тексте ответа).
//
// Параметры:
//  АргументыJSON - Строка
//  ТаблицыХода - Массив из Структура - Заголовок, Колонки, Строки (см. ИИА_Агент).
//  РезультатХода - Структура - результат хода: ФайлыОтвета (рецепты, дополняется), Таблицы (таблицы ответа). Таблица,
//    показанная в ответе, хранится в рецепте номером (table), а не копией строк.
//  Канал - Строка - "chat"; для другого канала инструмент недоступен.
//
// Возвращаемое значение:
//  Структура - Успех, Данные, Таблица, Строк, Скрыто, Итог, Класс.
//
Функция СоздатьФайлОтвета(АргументыJSON, ТаблицыХода, РезультатХода, Канал) Экспорт

	ФайлыОтвета = РезультатХода.ФайлыОтвета;
	Если Канал <> "chat" Тогда
		Возврат ОтказИнструмента("TOOL_DISABLED", НСтр("ru = 'Файлы ответа доступны только в окне чата.'"));
	ИначеЕсли ИИА_ПрофилиДоступа.ИнструментЗапрещенПрофилем("make_file") Тогда
		Возврат ОтказИнструмента("TOOL_DISABLED", НСтр("ru = 'Инструмент make_file выключен профилем доступа.'"));
	КонецЕсли;
	Аргументы = АргументыИнструмента(АргументыJSON);
	Если Аргументы = Неопределено Тогда
		Возврат ОтказИнструмента("BAD_ARGUMENTS", НСтр("ru = 'Аргументы инструмента должны быть JSON-объектом.'"));
	КонецЕсли;
	Если ФайлыОтвета.Количество() >= МаксимумФайловОтвета() Тогда
		Возврат ОтказИнструмента("FILE_LIMIT", СтрШаблон(НСтр("ru = 'В ответе не больше %1 файлов.'"), МаксимумФайловОтвета()));
	КонецЕсли;
	ФорматФайла = НРег(СтрокаАргумента(Аргументы, "format"));
	Заголовок = Лев(СокрЛП(ИИА_Периметр.ОчиститьТекст(СтрокаАргумента(Аргументы, "title"))), 100);
	ИдТаблицы = СтрокаАргумента(Аргументы, "table_id");
	Содержимое = СтрокаАргумента(Аргументы, "content");
	Если СтрРазделить("md,csv,xlsx", ",").Найти(ФорматФайла) = Неопределено Тогда
		Возврат ОтказИнструмента("BAD_ARGUMENTS", НСтр("ru = 'format: md, csv или xlsx.'"));
	ИначеЕсли ПустаяСтрока(ИдТаблицы) = ПустаяСтрока(Содержимое) Тогда
		Возврат ОтказИнструмента("BAD_ARGUMENTS", НСтр("ru = 'Укажи ровно один источник: table_id или content.'"));
	ИначеЕсли Не ПустаяСтрока(ИдТаблицы) И ФорматФайла = "md" Тогда
		Возврат ОтказИнструмента("BAD_ARGUMENTS", НСтр("ru = 'Из таблицы хода создаются csv и xlsx.'"));
	ИначеЕсли Не ПустаяСтрока(Содержимое) И ФорматФайла = "xlsx" Тогда
		Возврат ОтказИнструмента("BAD_ARGUMENTS", НСтр("ru = 'xlsx создаётся только из таблицы хода (table_id).'"));
	ИначеЕсли СтрДлина(Содержимое) > 100000 Тогда
		Возврат ОтказИнструмента("BAD_ARGUMENTS", НСтр("ru = 'content длиннее 100000 символов.'"));
	КонецЕсли;

	Рецепт = Новый Структура("id, format, title, columns, rows, content, size, table", "a"
		+ Формат(ФайлыОтвета.Количество() + 1, "ЧГ="), ФорматФайла, ?(ПустаяСтрока(Заголовок), НСтр("ru = 'Файл'"), Заголовок),
		Новый Массив, Новый Массив, "", 0, -1);
	Строк = 0;
	Если Не ПустаяСтрока(ИдТаблицы) Тогда
		Номер = ?(СтрНачинаетсяС(ИдТаблицы, "t"), ЦелоеАргумента(Сред(ИдТаблицы, 2), 0), 0);
		Если Номер < 1 Или ТаблицыХода = Неопределено Или Номер > ТаблицыХода.Количество() Тогда
			Возврат ОтказИнструмента("TABLE_NOT_FOUND", НСтр("ru = 'Таблица хода не найдена: нужен table_id из результата инструмента этого хода.'"));
		КонецЕсли;
		Таблица = ТаблицыХода[Номер - 1];
		ТаблицыОтвета = Неопределено;
		Если РезультатХода.Свойство("Таблицы", ТаблицыОтвета) И ТипЗнч(ТаблицыОтвета) = Тип("Массив") Тогда
			Рецепт.table = ТаблицыОтвета.Найти(Таблица);
			Рецепт.table = ?(Рецепт.table = Неопределено, -1, Рецепт.table);
		КонецЕсли;
		// Скрытая таблица хода (не показана в ответе) копируется в рецепт: иначе её не из чего собрать.
		Если Рецепт.table < 0 Тогда
			Рецепт.columns = Таблица.Колонки;
			Рецепт.rows = Таблица.Строки;
		КонецЕсли;
		Строк = Таблица.Строки.Количество();
	Иначе
		// Текст файла - не больше того, что пользователь увидел бы в ответе: детекторы, как для текста ответа.
		Рецепт.content = ИИА_Периметр.ОчиститьТекст(Содержимое);
		Рецепт.size = СтрДлина(Рецепт.content);
		Строк = СтрЧислоСтрок(Рецепт.content);
	КонецЕсли;
	Рецепт.Вставить("lines", Строк);
	ФайлыОтвета.Добавить(Рецепт);
	Данные = Новый Структура("file_id, format, title, rows, marker", Рецепт.id, ФорматФайла, Рецепт.title, Строк,
		"[[file:" + Рецепт.id + "]]");
	Возврат Новый Структура("Успех, Данные, Таблица, Строк, Скрыто, Итог, Класс", Истина, Данные, Неопределено, Строк,
		0, "OK", 1);

КонецФункции

#КонецОбласти

#Область ФайлыОтвета

// Собирает файл ответа по рецепту для «Сохранить» или «Открыть»: раскрытие псевдонимов только через
// ИИА_Маскирование.ДляПользователя(..., Ложь) в правах пользователя; значения, скрытые периметром, остаются
// заглушкой. В журнал - событие «ФайлОтвета» без содержимого и имени.
//
// Параметры:
//  Рецепт - Структура, Соответствие - id, format, title, columns, rows, content.
//  Диалог - СправочникСсылка.ИИА_Диалоги, Неопределено
//  ИдентификаторФормы - УникальныйИдентификатор
//  КлассДанных - ПеречислениеСсылка.ИИА_КлассыДанных, Неопределено - класс данных ответа для журнала.
//
// Возвращаемое значение:
//  Структура:
//   * Адрес - Строка - временное хранилище; пусто - ошибка.
//   * ИмяФайла - Строка
//   * Ошибка - Строка
//
Функция СобратьФайлОтвета(Рецепт, Диалог, ИдентификаторФормы, КлассДанных = Неопределено) Экспорт

	Результат = Новый Структура("Адрес, ИмяФайла, Ошибка", "", "", "");
	ФорматФайла = Строка(ЗначениеРецепта(Рецепт, "format"));
	Данные = Новый Структура("Заголовок, Колонки, Строки, Содержимое", Строка(ЗначениеРецепта(Рецепт, "title")),
		МассивРецепта(Рецепт, "columns"), МассивРецепта(Рецепт, "rows"), Строка(ЗначениеРецепта(Рецепт, "content")));
	Данные = ИИА_Маскирование.ДляПользователя(Данные, Диалог, Ложь);
	Результат.ИмяФайла = ИмяФайла(Данные.Заголовок, ФорматФайла);

	ДвоичныеДанные = Неопределено;
	Если ФорматФайла = "xlsx" Тогда
		Сборка = ДвоичныеДанныеXLSX(Данные.Колонки, Данные.Строки, Ложь, Истина);
		Результат.Ошибка = Сборка.Ошибка;
		ДвоичныеДанные = Сборка.ДвоичныеДанные;
	ИначеЕсли ФорматФайла = "csv" Тогда
		Если Данные.Колонки.Количество() > 0 Тогда
			Таблица = Новый Массив;
			Таблица.Добавить(Данные.Колонки);
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Таблица, Данные.Строки);
		Иначе
			Таблица = СтрокиCSV(Данные.Содержимое);
		КонецЕсли;
		ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(ТекстCSV(Таблица), КодировкаТекста.UTF8, Истина);
	ИначеЕсли ФорматФайла = "md" Тогда
		ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Данные.Содержимое, КодировкаТекста.UTF8, Ложь);
	Иначе
		Результат.Ошибка = НСтр("ru = 'Формат файла не поддерживается.'");
	КонецЕсли;
	Если ДвоичныеДанные = Неопределено Тогда
		Если ПустаяСтрока(Результат.Ошибка) Тогда
			Результат.Ошибка = НСтр("ru = 'Не удалось собрать файл.'");
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	Результат.Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанные, ИдентификаторФормы);
	ЗаписатьЖурналФайла(Диалог, СтрШаблон("format=%1; size=%2; rows=%3", ФорматФайла,
		Формат(ДвоичныеДанные.Размер(), "ЧН=0; ЧГ="), Формат(Данные.Строки.Количество(), "ЧН=0; ЧГ=")), КлассДанных);
	Возврат Результат;

КонецФункции

// Рецепт файла ответа из вложений сохранённой реплики диалога текущего пользователя (реестр формы хранит только
// номер реплики и id файла). Рецепт с номером таблицы получает колонки и строки этой таблицы ответа.
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги
//  НомерСообщения - Число
//  ИдФайла - Строка - a1, a2, ...
//
// Возвращаемое значение:
//  Структура, Неопределено - Рецепт (Соответствие), КлассДанных (ПеречислениеСсылка.ИИА_КлассыДанных);
//    Неопределено - реплики или файла нет.
//
Функция РецептФайлаОтвета(Диалог, НомерСообщения, ИдФайла) Экспорт

	Если Не ЗначениеЗаполнено(Диалог) Или ТипЗнч(НомерСообщения) <> Тип("Число") Или ТипЗнч(ИдФайла) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	С.Вложения КАК Вложения,
	|	С.КлассДанных КАК КлассДанных
	|ИЗ
	|	РегистрСведений.ИИА_СообщенияДиалогов КАК С
	|ГДЕ
	|	С.Диалог = &Диалог
	|	И С.НомерСообщения = &НомерСообщения
	|	И С.Роль = ""assistant""
	|	И С.Диалог.Пользователь = &Пользователь");
	Запрос.УстановитьПараметр("Диалог", Диалог);
	Запрос.УстановитьПараметр("НомерСообщения", НомерСообщения);
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	// Регистр реплик закрыт ролями; доступ - только к диалогу текущего пользователя (условие запроса).
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	Если Не Выборка.Следующий() Или ПустаяСтрока(Выборка.Вложения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Вложения = АргументыИнструмента(Выборка.Вложения);
	Если Вложения = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Рецепт = Неопределено;
	Для Каждого Кандидат Из МассивРецепта(Вложения, "afiles") Цикл
		Если ТипЗнч(Кандидат) = Тип("Соответствие") И Кандидат.Получить("id") = ИдФайла Тогда
			Рецепт = Кандидат;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Рецепт = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	НомерТаблицы = Рецепт.Получить("table");
	Таблицы = МассивРецепта(Вложения, "tables");
	Если ТипЗнч(НомерТаблицы) = Тип("Число") И НомерТаблицы >= 0 Тогда
		Если НомерТаблицы > Таблицы.ВГраница() Или ТипЗнч(Таблицы[НомерТаблицы]) <> Тип("Соответствие") Тогда
			Возврат Неопределено;
		КонецЕсли;
		Рецепт.Вставить("columns", МассивРецепта(Таблицы[НомерТаблицы], "columns"));
		Рецепт.Вставить("rows", МассивРецепта(Таблицы[НомерТаблицы], "rows"));
	КонецЕсли;
	Возврат Новый Структура("Рецепт, КлассДанных", Рецепт, Выборка.КлассДанных);

КонецФункции

// Двоичные данные xlsx таблицы: числа - числами, даты - текстом ДД.ММ.ГГГГ (ячейку-дату платформа всё равно пишет
// в xlsx строкой), шапка - полужирная с фоном. Общий построитель для «Открыть в Excel» и файлов ответа.
//
// Параметры:
//  Колонки - Массив из Строка
//  Строки - Массив из Массив
//  ИзТекста - Булево - ячейки из текста ответа: числа в формате ленты распознаются.
//  ЗащитаОтФормул - Булево - строковым ячейкам, начинающимся с = или @, добавляется префикс «'» (ячейку xlsx
//    с текстом «-5» или «+7…» Excel формулой не считает; для CSV - полная защита, см. БезФормулы).
//
// Возвращаемое значение:
//  Структура - ДвоичныеДанные (ДвоичныеДанные, Неопределено), Ошибка (Строка).
//
Функция ДвоичныеДанныеXLSX(Колонки, Строки, ИзТекста, ЗащитаОтФормул = Истина) Экспорт

	Результат = Новый Структура("ДвоичныеДанные, Ошибка", Неопределено, "");
	Если Колонки.Количество() = 0 Тогда
		Результат.Ошибка = НСтр("ru = 'В таблице нет данных для выгрузки.'");
		Возврат Результат;
	ИначеЕсли Колонки.Количество() > 50 Или Строки.Количество() > 2000 Тогда
		Результат.Ошибка = НСтр("ru = 'Таблица слишком большая для выгрузки.'");
		Возврат Результат;
	КонецЕсли;

	Документ = Новый ТабличныйДокумент;
	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	Ширины = Новый Массив;
	Для НомерКолонки = 1 По Колонки.Количество() Цикл
		Область = Документ.Область(1, НомерКолонки);
		Область.Текст = ?(ЗащитаОтФормул, БезФормулыXLSX(Строка(Колонки[НомерКолонки - 1])), Строка(Колонки[НомерКолонки - 1]));
		// BSLLS:StyleElementConstructors-off
		// Файл xlsx для внешнего приложения: элементы стиля 1С в нём не действуют.
		Область.Шрифт = Новый Шрифт(, , , Истина);
		Область.ЦветФона = Новый Цвет(242, 242, 242);
		// BSLLS:StyleElementConstructors-on
		Область.Обвести(Линия, Линия, Линия, Линия);
		Ширины.Добавить(СтрДлина(Область.Текст));
	КонецЦикла;
	Для НомерСтроки = 1 По Строки.Количество() Цикл
		Значения = Строки[НомерСтроки - 1];
		Значения = ?(ТипЗнч(Значения) = Тип("Массив"), Значения, Новый Массив);
		Для НомерКолонки = 1 По Мин(Значения.Количество(), Колонки.Количество()) Цикл
			Значение = Значения[НомерКолонки - 1];
			Если ТипЗнч(Значение) = Тип("Строка") Тогда
				Значение = ЗначениеЯчейки(Значение, ИзТекста);
			КонецЕсли;
			Область = Документ.Область(НомерСтроки + 1, НомерКолонки);
			Если ТипЗнч(Значение) = Тип("Число") Тогда
				Область.СодержитЗначение = Истина;
				Область.ТипЗначения = Новый ОписаниеТипов("Число");
				Область.Значение = Значение;
				Область.Формат = "ЧДЦ=" + Формат(ДробныхЗнаков(Значение), "ЧН=0");
				Текст = Формат(Значение, Область.Формат);
			ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
				Текст = Формат(Значение, "ДФ=dd.MM.yyyy");
				Область.Текст = Текст;
			Иначе
				Текст = ?(Значение = Неопределено Или Значение = Null, "", Строка(Значение));
				Если ЗащитаОтФормул Тогда
					Текст = БезФормулыXLSX(Текст);
				КонецЕсли;
				Область.Текст = Текст;
			КонецЕсли;
			Ширины[НомерКолонки - 1] = Макс(Ширины[НомерКолонки - 1], СтрДлина(Текст));
		КонецЦикла;
	КонецЦикла;
	Для НомерКолонки = 1 По Ширины.Количество() Цикл
		Документ.Область("C" + Формат(НомерКолонки, "ЧГ=")).ШиринаКолонки = Мин(60, Макс(8, Ширины[НомерКолонки - 1] + 2));
	КонецЦикла;
	Документ.ПовторятьПриПечатиСтроки = Документ.Область("R1");
	Документ.ФиксацияСверху = 1;

	// BSLLS:MissingTemporaryFileDeletion-off
	// Временный файл удаляется ниже через ФайловаяСистема.УдалитьВременныйФайл (в том числе после ошибки записи).
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
	// BSLLS:MissingTemporaryFileDeletion-on
	Попытка
		Документ.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.XLSX);
		Результат.ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Результат.Ошибка = НСтр("ru = 'Не удалось записать файл Excel.'");
	КонецПопытки;
	ФайловаяСистема.УдалитьВременныйФайл(ИмяВременногоФайла);
	Возврат Результат;

КонецФункции

// Текст CSV: разделитель «;», значения с разделителем, кавычкой или переводом строки - в кавычках, кавычки
// удваиваются; ячейки, начинающиеся с = + - @, получают префикс «'» (защита от формул).
//
// Параметры:
//  Строки - Массив из Массив - первая строка - шапка.
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстCSV(Строки) Экспорт

	Результат = Новый Массив;
	Для Каждого Значения Из Строки Цикл
		Ячейки = Новый Массив;
		Для Каждого Значение Из ?(ТипЗнч(Значения) = Тип("Массив"), Значения, Новый Массив) Цикл
			Если ТипЗнч(Значение) = Тип("Число") Тогда
				Текст = Формат(Значение, "ЧРД=,; ЧГ=; ЧН=0");
			ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
				Текст = Формат(Значение, "ДФ=dd.MM.yyyy");
			Иначе
				Текст = БезФормулы(?(Значение = Неопределено Или Значение = Null, "", Строка(Значение)));
			КонецЕсли;
			Если СтрНайти(Текст, ";") > 0 Или СтрНайти(Текст, """") > 0 Или СтрНайти(Текст, Символы.ПС) > 0
				Или СтрНайти(Текст, Символы.ВК) > 0 Тогда
				Текст = """" + СтрЗаменить(Текст, """", """""") + """";
			КонецЕсли;
			Ячейки.Добавить(Текст);
		КонецЦикла;
		Результат.Добавить(СтрСоединить(Ячейки, ";"));
	КонецЦикла;
	Возврат СтрСоединить(Результат, Символы.ВК + Символы.ПС);

КонецФункции

// Значение ячейки без исполнения формулы: строка, начинающаяся с = + - @ (а также табуляции и возврата каретки),
// получает префикс «'».
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция БезФормулы(Знач Текст) Экспорт

	Если ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	Первый = Лев(Текст, 1);
	Если СтрНайти("=+-@", Первый) > 0 Или Первый = Символы.Таб Или Первый = Символы.ВК Тогда
		Возврат "'" + Текст;
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Защита текстовой ячейки xlsx: префикс «'» для текста, начинающегося с = или @.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция БезФормулыXLSX(Знач Текст) Экспорт

	Первый = Лев(Текст, 1);
	Возврат ?(Первый = "=" Или Первый = "@", "'" + Текст, Текст);

КонецФункции

// Значение ячейки Excel по тексту: дата ДД.ММ.ГГГГ, ГГГГ-ММ-ДД или ГГГГ-ММ-ДДTчч:мм:сс; для таблицы из текста
// ответа - ещё число в формате ленты (пробелы - разделители разрядов, запятая или точка - дробная часть; ведущий
// ноль и больше 15 цифр целой части - текст: коды, номера счетов).
//
// Параметры:
//  Текст - Строка
//  РаспознатьЧисло - Булево
//
// Возвращаемое значение:
//  Строка, Число, Дата
//
Функция ЗначениеЯчейки(Текст, РаспознатьЧисло) Экспорт

	Значение = СокрЛП(Текст);
	Длина = СтрДлина(Значение);
	Цифры = "";
	Если Длина = 10 И Сред(Значение, 3, 1) = "." И Сред(Значение, 6, 1) = "." Тогда
		Цифры = Сред(Значение, 7, 4) + Сред(Значение, 4, 2) + Лев(Значение, 2);
	ИначеЕсли (Длина = 10 Или Длина = 19 И Сред(Значение, 11, 1) = "T") И Сред(Значение, 5, 1) = "-" И Сред(Значение, 8, 1) = "-" Тогда
		Цифры = СтрЗаменить(СтрЗаменить(СтрЗаменить(Значение, "-", ""), "T", ""), ":", "");
	КонецЕсли;
	Если СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Цифры) И (СтрДлина(Цифры) = 8 Или СтрДлина(Цифры) = 14) Тогда
		Попытка
			Возврат Дата(Цифры);
		Исключение // BSLLS:MissingCodeTryCatchEx-off
			// Несуществующая дата (31.02) - не ошибка, а текст ячейки.
			Возврат Текст;
		КонецПопытки;
	КонецЕсли;
	Если Не РаспознатьЧисло Тогда
		Возврат Текст;
	КонецЕсли;

	ТекстЧисла = СтрЗаменить(СтрЗаменить(СтрЗаменить(Значение, " ", ""), Символы.НПП, ""), Символ(8239), "");
	Знак = "";
	Если СтрНачинаетсяС(ТекстЧисла, "-") Тогда
		Знак = "-";
		ТекстЧисла = Сред(ТекстЧисла, 2);
	КонецЕсли;
	Части = СтрРазделить(СтрЗаменить(ТекстЧисла, ",", "."), ".", Истина);
	Если Части.Количество() > 2 Или ПустаяСтрока(Части[0]) Или Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Части[0])
		Или СтрДлина(Части[0]) > 15 Или СтрДлина(Части[0]) > 1 И Лев(Части[0], 1) = "0"
		Или Части.Количество() = 2 И (ПустаяСтрока(Части[1]) Или Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Части[1])) Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Число(Знак + СтрСоединить(Части, "."));

КонецФункции

// Имя файла по заголовку: без недопустимых в имени файла и управляющих символов, до 80 символов.
//
// Параметры:
//  Заголовок - Строка
//  Расширение - Строка - без точки.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяФайла(Заголовок, Расширение) Экспорт

	Знаки = Новый Массив;
	Для Номер = 1 По СтрДлина(Заголовок) Цикл
		Знак = Сред(Заголовок, Номер, 1);
		// BSLLS:UsingHardcodePath-off
		// Не путь, а символы, недопустимые в имени файла Windows.
		Знаки.Добавить(?(КодСимвола(Знак) < 32 Или СтрНайти("\/:*?""<>|", Знак) > 0, "_", Знак));
		// BSLLS:UsingHardcodePath-on
	КонецЦикла;
	Имя = Лев(СокрЛП(СтрСоединить(Знаки, "")), 80);
	// Windows отбрасывает конечные точки и пробелы; «..» без них - пустое имя.
	Пока СтрЗаканчиваетсяНа(Имя, ".") Или СтрЗаканчиваетсяНа(Имя, " ") Цикл
		Имя = Лев(Имя, СтрДлина(Имя) - 1);
	КонецЦикла;
	Если ПустаяСтрока(Имя) Тогда
		Имя = НСтр("ru = 'Таблица'");
	КонецЕсли;
	// Зарезервированные имена устройств Windows (CON, NUL, COM1, LPT1...) - и с любым расширением.
	Основа = ВРег(СокрЛП(СтрРазделить(Имя, ".")[0]));
	Если СтрРазделить("CON,PRN,AUX,NUL,COM1,COM2,COM3,COM4,COM5,COM6,COM7,COM8,COM9,LPT1,LPT2,LPT3,LPT4,LPT5,LPT6,LPT7,LPT8,LPT9",
		",").Найти(Основа) <> Неопределено Тогда
		Имя = "_" + Имя;
	КонецЕсли;
	Возврат Имя + "." + Расширение;

КонецФункции

// Описание файла ответа для карточки на странице: только id, формат, название и размер, без данных.
//
// Параметры:
//  Рецепт - Структура, Соответствие
//
// Возвращаемое значение:
//  Структура - format, title, rows, size.
//
Функция ОписаниеКарточки(Рецепт) Экспорт

	Строк = ЗначениеРецепта(Рецепт, "lines");
	Размер = ЗначениеРецепта(Рецепт, "size");
	Возврат Новый Структура("format, title, rows, size", Строка(ЗначениеРецепта(Рецепт, "format")),
		Строка(ЗначениеРецепта(Рецепт, "title")), ?(ТипЗнч(Строк) = Тип("Число"), Строк, 0),
		?(ТипЗнч(Размер) = Тип("Число"), Размер, 0));

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйФайлВопроса()

	Возврат Новый Структура("Ид, Имя, ИмяПоказа, Формат, Источник, Ссылка, Размер, Вид, Данные, Символов, Строк, Листы, Класс, Обрезан, ДвоичныеДанные",
		"", "", "", "", "computer", "", 0, "text", "", 0, 0, Новый Массив, 1, Ложь, Неопределено);

КонецФункции

Функция РасширениеИмени(Имя)

	Части = СтрРазделить(Имя, ".");
	Возврат ?(Части.Количество() > 1, НРег(СокрЛП(Части[Части.ВГраница()])), "");

КонецФункции

// Текст файла: UTF-8 (с BOM или без), иначе Windows-1251.
Функция ТекстФайла(ДвоичныеДанные)

	Текст = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, КодировкаТекста.UTF8);
	Если СтрНайти(Текст, Символ(65533)) > 0 Тогда
		Текст = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, "windows-1251");
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Первый лист Excel как текст с табуляцией: не больше 2000 строк и 50 колонок.
Функция ТекстТаблицы(ДвоичныеДанные, Расширение)

	// BSLLS:MissingTemporaryFileDeletion-off
	// Временный файл удаляется ниже через ФайловаяСистема.УдалитьВременныйФайл (в том числе после ошибки чтения).
	ИмяФайла = ПолучитьИмяВременногоФайла(Расширение);
	// BSLLS:MissingTemporaryFileDeletion-on
	Строки = Новый Массив;
	Попытка
		ДвоичныеДанные.Записать(ИмяФайла);
		Таблица = Новый ТабличныйДокумент;
		Таблица.Прочитать(ИмяФайла);
		Высота = Мин(Таблица.ВысотаТаблицы, 2000);
		Ширина = Мин(Таблица.ШиринаТаблицы, 50);
		Для НомерСтроки = 1 По Высота Цикл
			Ячейки = Новый Массив;
			Для НомерКолонки = 1 По Ширина Цикл
				Ячейки.Добавить(СтрЗаменить(Таблица.Область(НомерСтроки, НомерКолонки).Текст, Символы.Таб, " "));
			КонецЦикла;
			Строки.Добавить(СокрП(СтрСоединить(Ячейки, Символы.Таб)));
		КонецЦикла;
		Если Таблица.ВысотаТаблицы > Высота Тогда
			Строки.Добавить(СтрШаблон(НСтр("ru = '[таблица обрезана: показаны первые %1 строк]'"), Высота));
		КонецЕсли;
	Исключение
		// Повреждённый или неподдерживаемый файл: пустой текст даёт пользователю ошибку чтения.
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Строки.Очистить();
	КонецПопытки;
	ФайловаяСистема.УдалитьВременныйФайл(ИмяФайла);
	Возврат СокрЛП(СтрСоединить(Строки, Символы.ПС));

КонецФункции

// Имена листов книги xlsx из xl/workbook.xml (только имена; описание книги больше 2 МБ не читается - и по
// заявленному, и по фактическому размеру извлечённого файла).
Функция ЛистыКниги(ДвоичныеДанные)

	Предел = 2 * 1024 * 1024;
	Листы = Новый Массив;
	// BSLLS:MissingTemporaryFileDeletion-off
	// Временные файл и каталог удаляются ниже через ФайловаяСистема (в том числе после ошибки разбора).
	ИмяФайла = ПолучитьИмяВременногоФайла("xlsx");
	// BSLLS:MissingTemporaryFileDeletion-on
	Каталог = ФайловаяСистема.СоздатьВременныйКаталог("iia");
	Архив = Неопределено;
	Чтение = Неопределено;
	Попытка
		ДвоичныеДанные.Записать(ИмяФайла);
		Архив = Новый ЧтениеZipФайла(ИмяФайла);
		Элемент = Архив.Элементы.Найти("xl/workbook.xml");
		Если Элемент <> Неопределено И Элемент.РазмерНесжатого <= Предел Тогда
			Архив.Извлечь(Элемент, Каталог, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
			ИмяОписания = Каталог + ПолучитьРазделительПути() + "workbook.xml";
			Описание = Новый Файл(ИмяОписания);
			Если Описание.Существует() И Описание.Размер() <= Предел Тогда
				Чтение = Новый ЧтениеXML;
				Чтение.ОткрытьФайл(ИмяОписания);
				Пока Чтение.Прочитать() И Листы.Количество() < 100 Цикл
					Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И Чтение.ЛокальноеИмя = "sheet" Тогда
						Имя = Чтение.ЗначениеАтрибута("name");
						Если ТипЗнч(Имя) = Тип("Строка") Тогда
							Листы.Добавить(Лев(Имя, 100));
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	Исключение
		// Список листов - подсказка модели: при ошибке разбора остаётся текст первого листа.
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Листы.Очистить();
	КонецПопытки;
	ЗакрытьЧтение(Чтение);
	ЗакрытьЧтение(Архив);
	ФайловаяСистема.УдалитьВременныйФайл(ИмяФайла);
	ФайловаяСистема.УдалитьВременныйКаталог(Каталог);
	Возврат Листы;

КонецФункции

// Закрывает ЧтениеXML или ЧтениеZipФайла; ошибка закрытия уже закрытого объекта не важна.
Процедура ЗакрытьЧтение(Чтение)

	Если Чтение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Чтение.Закрыть();
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		// Объект уже закрыт или не открыт: освобождать нечего.
		Чтение = Неопределено;
	КонецПопытки;

КонецПроцедуры

Функция ПредставлениеРазмера(Размер)

	Если Размер < 1024 Тогда
		Возврат СтрШаблон(НСтр("ru = '%1 Б'"), Формат(Размер, "ЧН=0; ЧГ="));
	ИначеЕсли Размер < 1024 * 1024 Тогда
		Возврат СтрШаблон(НСтр("ru = '%1 КБ'"), Формат(Окр(Размер / 1024), "ЧН=0; ЧГ="));
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = '%1 МБ'"), Формат(Окр(Размер / 1024 / 1024, 1), "ЧДЦ=1; ЧН=0; ЧГ="));

КонецФункции

Функция ЗаголовокФайла(Файл, Кэш)

	Описание = СтрШаблон(НСтр("ru = 'Файл %1 «%2» (%3, %4 строк, %5 символов)'"), Файл.Ид, Файл.Имя, Файл.Формат,
		Формат(Файл.Строк, "ЧН=0; ЧГ="), Формат(Файл.Символов, "ЧН=0; ЧГ="));
	Если Файл.Листы.Количество() > 0 Тогда
		Слой = ТекстДляМодели(СтрСоединить(Файл.Листы, "; "), Кэш);
		Описание = Описание + Символы.ПС + СтрШаблон(НСтр("ru = 'Листы книги: %1. Прочитан только первый лист.'"), Слой.Текст);
	КонецЕсли;
	Если Файл.Обрезан Тогда
		Описание = Описание + Символы.ПС + СтрШаблон(НСтр("ru = 'Файл длиннее %1 символов: дальше этого предела текст недоступен.'"),
			Формат(ПределТекстаФайла(), "ЧГ="));
	КонецЕсли;
	Если Файл.Источник = "base" Тогда
		Описание = Описание + Символы.ПС + НСтр("ru = 'Присоединённый файл объекта базы.'");
	КонецЕсли;
	Возврат Описание;

КонецФункции

// Доли бюджета текста сообщения по текстовым файлам: короткие файлы берут свою длину, остаток делится поровну.
Функция ДолиБюджета(Файлы)

	Длины = Новый ТаблицаЗначений;
	Длины.Колонки.Добавить("Ид");
	Длины.Колонки.Добавить("Длина");
	Для Каждого Файл Из Файлы Цикл
		Если Файл.Вид = "text" Тогда
			Строка_ = Длины.Добавить();
			Строка_.Ид = Файл.Ид;
			Строка_.Длина = СтрДлина(Файл.Данные);
		КонецЕсли;
	КонецЦикла;
	Длины.Сортировать("Длина");
	Доли = Новый Соответствие;
	Остаток = БюджетТекстаСообщения();
	Ожидают = Длины.Количество();
	Для Каждого Строка_ Из Длины Цикл
		Доля = Мин(Строка_.Длина, Цел(Остаток / Ожидают));
		Доли.Вставить(Строка_.Ид, Доля);
		Остаток = Остаток - Доля;
		Ожидают = Ожидают - 1;
	КонецЦикла;
	Возврат Доли;

КонецФункции

// Фрагмент текста с позиции Смещение (0 - начало) длиной до Лимит; неполный фрагмент обрывается на последнем
// переводе строки, если он не в первой половине.
Функция ФрагментПоГраницеСтроки(Текст, Смещение, Лимит)

	Если Лимит <= 0 Тогда
		Возврат "";
	КонецЕсли;
	Фрагмент = Сред(Текст, Смещение + 1, Лимит);
	Если Смещение + СтрДлина(Фрагмент) >= СтрДлина(Текст) Тогда
		Возврат Фрагмент;
	КонецЕсли;
	Позиция = СтрНайти(Фрагмент, Символы.ПС, НаправлениеПоиска.СКонца);
	Если Позиция > СтрДлина(Фрагмент) / 2 Тогда
		Фрагмент = Лев(Фрагмент, Позиция);
	КонецЕсли;
	Возврат Фрагмент;

КонецФункции

// Текст файла после текстового слоя целиком, порциями по ПорцияЧтения (порция, на которой коммерческий слой
// отказал, заменяется заглушкой).
Функция ОбработанныйТекст(Текст, Кэш)

	Части = Новый Массив;
	Смещение = 0;
	Всего = СтрДлина(Текст);
	Пока Смещение < Всего Цикл
		Фрагмент = ФрагментПоГраницеСтроки(Текст, Смещение, ПорцияЧтения());
		Если Фрагмент = "" Тогда
			Прервать;
		КонецЕсли;
		Части.Добавить(ТекстДляМодели(Фрагмент, Кэш).Текст);
		Смещение = Смещение + СтрДлина(Фрагмент);
	КонецЦикла;
	Возврат СтрСоединить(Части, "");

КонецФункции

// Строки фрагмента с номерами: «N| текст»; первая строка фрагмента имеет номер ПервыйНомер (может быть неполной).
Функция СНомерамиСтрок(Фрагмент, ПервыйНомер)

	Номер = Макс(1, ПервыйНомер);
	Строки = СтрРазделить(Фрагмент, Символы.ПС, Истина);
	Для Индекс = 0 По Строки.ВГраница() Цикл
		Строки[Индекс] = Формат(Номер + Индекс, "ЧГ=") + "| " + Строки[Индекс];
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Строки CSV из текста модели: разделитель «;», кавычки по RFC 4180.
Функция СтрокиCSV(Текст)

	Строки = Новый Массив;
	Ячейки = Новый Массив;
	Ячейка = "";
	ВКавычках = Ложь;
	Номер = 1;
	Длина = СтрДлина(Текст);
	Пока Номер <= Длина Цикл
		Знак = Сред(Текст, Номер, 1);
		Если ВКавычках Тогда
			Если Знак = """" И Сред(Текст, Номер + 1, 1) = """" Тогда
				Ячейка = Ячейка + """";
				Номер = Номер + 1;
			ИначеЕсли Знак = """" Тогда
				ВКавычках = Ложь;
			Иначе
				Ячейка = Ячейка + Знак;
			КонецЕсли;
		ИначеЕсли Знак = """" И Ячейка = "" Тогда
			ВКавычках = Истина;
		ИначеЕсли Знак = ";" Тогда
			Ячейки.Добавить(Ячейка);
			Ячейка = "";
		ИначеЕсли Знак = Символы.ПС Тогда
			Ячейки.Добавить(Ячейка);
			Строки.Добавить(Ячейки);
			Ячейки = Новый Массив;
			Ячейка = "";
		ИначеЕсли Знак <> Символы.ВК Тогда
			Ячейка = Ячейка + Знак;
		КонецЕсли;
		Номер = Номер + 1;
	КонецЦикла;
	Если Ячейка <> "" Или Ячейки.Количество() > 0 Тогда
		Ячейки.Добавить(Ячейка);
		Строки.Добавить(Ячейки);
	КонецЕсли;
	Возврат Строки;

КонецФункции

Функция ДробныхЗнаков(Значение)

	Знаков = 0;
	Пока Знаков < 6 И Значение * Pow(10, Знаков) <> Цел(Значение * Pow(10, Знаков)) Цикл
		Знаков = Знаков + 1;
	КонецЦикла;
	Возврат Знаков;

КонецФункции

// Сведения присоединённых файлов, видимых пользователю: запрос РАЗРЕШЕННЫЕ по каждому справочнику файлов.
Функция СведенияФайлов(Файлы)

	Результат = Новый Массив;
	ПоСправочникам = Новый Соответствие;
	Для Каждого Файл Из Файлы Цикл
		Если Не ЭтоПрисоединенныйФайл(Файл) Тогда
			Продолжить;
		КонецЕсли;
		ПолноеИмя = Файл.Метаданные().ПолноеИмя();
		Если ИИА_Периметр.ОбъектЗапрещен(ПолноеИмя) Или Не ПравоДоступа("Чтение", Файл.Метаданные()) Тогда
			Продолжить;
		КонецЕсли;
		Ссылки = ПоСправочникам.Получить(ПолноеИмя);
		Если Ссылки = Неопределено Тогда
			Ссылки = Новый Массив;
			ПоСправочникам.Вставить(ПолноеИмя, Ссылки);
		КонецЕсли;
		Ссылки.Добавить(Файл);
	КонецЦикла;
	Для Каждого Элемент Из ПоСправочникам Цикл
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Элемент.Ключ);
		Условие = "";
		Если ОбъектМетаданных.Иерархический Тогда
			Условие = " И НЕ Ф.ЭтоГруппа";
		КонецЕсли;
		// Имя справочника - из метаданных присоединённого файла, а не из ввода пользователя. Один запрос на
		// справочник файлов (обычно один-два): у справочников разные поля иерархии, общий ОБЪЕДИНИТЬ не строится.
		// BSLLS:CreateQueryInCycle-off
		// BSLLS:QueryParseError-off
		Запрос = Новый Запрос(СтрШаблон(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ Ф.Ссылка КАК Ссылка, Ф.Наименование КАК Наименование, Ф.Расширение КАК Расширение,
			|	Ф.Размер КАК Размер, Ф.Зашифрован КАК Зашифрован, Ф.ВладелецФайла КАК Владелец
			|ИЗ %1 КАК Ф
			|ГДЕ Ф.Ссылка В (&Ссылки) И НЕ Ф.ПометкаУдаления%2", Элемент.Ключ, Условие));
		// BSLLS:QueryParseError-on
		Запрос.УстановитьПараметр("Ссылки", Элемент.Значение);
		Выборка = Запрос.Выполнить().Выбрать();
		// BSLLS:CreateQueryInCycle-on
		Пока Выборка.Следующий() Цикл
			Расширение = НРег(СокрЛП(Выборка.Расширение));
			Результат.Добавить(Новый Структура("Ссылка, Имя, Расширение, Размер, Зашифрован, Владелец", Выборка.Ссылка,
				СокрЛП(Выборка.Наименование) + ?(ПустаяСтрока(Расширение), "", "." + Расширение), Расширение,
				Выборка.Размер, Выборка.Зашифрован, Выборка.Владелец));
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ОшибкаФайлаБазы(Сведения)

	Если Сведения.Зашифрован = Истина Тогда
		Возврат НСтр("ru = 'Зашифрованный файл нельзя приложить к вопросу.'");
	ИначеЕсли РасширенияДокументов().Найти(Сведения.Расширение) = Неопределено Тогда
		Возврат НСтр("ru = 'Формат файла не поддерживается: допустимы PDF, текстовые файлы и Excel.'");
	ИначеЕсли Сведения.Размер > МаксимумРазмераФайла() Тогда
		Возврат НСтр("ru = 'Файл больше 10 МБ.'");
	КонецЕсли;
	Возврат "";

КонецФункции

Процедура ДобавитьКатегории(Категории, Новые)

	Для Каждого Категория Из Новые Цикл
		Если Категории.Найти(Категория) = Неопределено Тогда
			Категории.Добавить(Категория);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ТекстоваяЧасть(Текст)

	Часть = Новый Соответствие;
	Часть.Вставить("type", "text");
	Часть.Вставить("text", Текст);
	Возврат Часть;

КонецФункции

Функция ОписаниеИнструмента(Имя, Описание, Свойства, Обязательные)

	Параметры = Новый Соответствие;
	Параметры.Вставить("type", "object");
	Параметры.Вставить("properties", Свойства);
	Параметры.Вставить("required", СтрРазделить(Обязательные, ",", Ложь));
	Функция_ = Новый Соответствие;
	Функция_.Вставить("name", Имя);
	Функция_.Вставить("description", Описание);
	Функция_.Вставить("parameters", Параметры);
	Инструмент = Новый Соответствие;
	Инструмент.Вставить("type", "function");
	Инструмент.Вставить("function", Функция_);
	Возврат Инструмент;

КонецФункции

Функция СвойствоПараметра(Тип, Описание)

	Свойство = Новый Соответствие;
	Свойство.Вставить("type", Тип);
	Свойство.Вставить("description", Описание);
	Возврат Свойство;

КонецФункции

Функция АргументыИнструмента(АргументыJSON)

	Попытка
		Аргументы = ОбщегоНазначения.JSONВЗначение(АргументыJSON, , Истина);
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат Неопределено;
	КонецПопытки;
	Возврат ?(ТипЗнч(Аргументы) = Тип("Соответствие"), Аргументы, Неопределено);

КонецФункции

Функция СтрокаАргумента(Аргументы, Имя)

	Значение = Аргументы.Получить(Имя);
	Возврат ?(ТипЗнч(Значение) = Тип("Строка"), Значение, "");

КонецФункции

Функция ЦелоеАргумента(Значение, ПоУмолчанию)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Цел(Значение);
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") И Не ПустаяСтрока(Значение) И СтрДлина(Значение) <= 9
		И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Значение) Тогда
		Возврат Число(Значение);
	КонецЕсли;
	Возврат ПоУмолчанию;

КонецФункции

Функция ОтказИнструмента(Код, Сообщение)

	Возврат Новый Структура("Успех, Данные, Таблица, Строк, Скрыто, Итог, Класс", Ложь,
		Новый Структура("error, message", Код, Сообщение), Неопределено, 0, 0, Код, 1);

КонецФункции

Функция ЗначениеРецепта(Рецепт, Имя)

	Значение = Неопределено;
	Если ТипЗнч(Рецепт) = Тип("Соответствие") Тогда
		Значение = Рецепт.Получить(Имя);
	ИначеЕсли ТипЗнч(Рецепт) = Тип("Структура") Тогда
		Рецепт.Свойство(Имя, Значение);
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция МассивРецепта(Рецепт, Имя)

	Значение = ЗначениеРецепта(Рецепт, Имя);
	Возврат ?(ТипЗнч(Значение) = Тип("Массив"), Значение, Новый Массив);

КонецФункции

Процедура ЗаписатьЖурналФайла(Диалог, Подробности, КлассДанных)

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запись = РегистрыСведений.ИИА_ЖурналВызовов.СоздатьМенеджерЗаписи();
		Запись.ИдентификаторЗаписи = Строка(Новый УникальныйИдентификатор);
		Запись.МоментВызова = ТекущаяУниверсальнаяДата();
		Запись.Пользователь = Пользователи.ТекущийПользователь();
		Запись.Диалог = ?(ЗначениеЗаполнено(Диалог), Диалог, Неопределено);
		Запись.Событие = "ФайлОтвета";
		Если ЗначениеЗаполнено(КлассДанных) Тогда
			Запись.КлассДанных = КлассДанных;
		КонецЕсли;
		Запись.Итог = "OK";
		Запись.Подробности = Подробности;
		Запись.Записать();
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Функция ИмяСобытияЖурнала()

	Возврат НСтр("ru = 'ИИАссистент.Файлы'", ОбщегоНазначения.КодОсновногоЯзыка());

КонецФункции

