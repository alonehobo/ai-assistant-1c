// BSLLS:CommonModuleInvalidType-off
// Только сервер: вызов с клиента и внешнее соединение намеренно отключены.
// BSLLS:CommonModuleInvalidType-on
///////////////////////////////////////////////////////////////////////////////////////////////////////
// ИИ-ассистент: фоновый ход чата и серверная очередь сообщений (change 2026-10-13-iia-background-turn).
// Долговременное состояние хода - регистр ИИА_СостоянияХодов, очередь - ИИА_ОчередьСообщений. Прав на регистры
// нет ни у одной роли: модуль читает и пишет их в привилегированном режиме, только записи текущего пользователя.
// Ход канала "chat" сам сохраняет ответ в диалог (ЗавершитьХодДиалога) и отправляет очередь в том же задании.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

#Область СостояниеХода

// Создаёт состояние хода чата текущего пользователя (статус running).
//
// Параметры:
//  ИдентификаторХода - Строка - идентификатор хода (он же ход журнала вызовов).
//  Диалог - СправочникСсылка.ИИА_Диалоги
//  ИдентификаторЗадания - Строка - пусто, если задание ещё не запущено (см. ЗаписатьЗадание).
//  НомерЗаменяемогоОтвета - Число - перегенерация или продолжение ответа с этим номером; 0 - новый ответ.
//  ЭтоПродолжение - Булево
//  ХодовПодряд - Число - номер хода подряд в одном фоновом задании (см. РешениеЦиклаОчереди).
//
Процедура НачатьХод(ИдентификаторХода, Диалог, ИдентификаторЗадания = "", НомерЗаменяемогоОтвета = 0,
	ЭтоПродолжение = Ложь, ХодовПодряд = 1) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Запись = РегистрыСведений.ИИА_СостоянияХодов.СоздатьМенеджерЗаписи();
	Запись.Пользователь = Пользователи.ТекущийПользователь();
	Запись.ИдентификаторХода = ИдентификаторХода;
	Запись.Диалог = Диалог;
	Запись.ИдентификаторЗадания = ИдентификаторЗадания;
	Запись.Статус = СтатусВыполняется();
	Запись.Канал = КаналЧата();
	Запись.Начало = ТекущаяУниверсальнаяДата();
	Запись.Обновлено = Запись.Начало;
	Запись.НомерЗаменяемогоОтвета = НомерЗаменяемогоОтвета;
	Запись.ЭтоПродолжение = ЭтоПродолжение;
	Запись.ХодовПодряд = ХодовПодряд;
	Запись.ПромежуточныйРезультат = Новый ХранилищеЗначения(Неопределено);
	Запись.Пауза = Новый ХранилищеЗначения(Неопределено);
	Запись.Записать();

КонецПроцедуры

// Запоминает фоновое задание хода: по нему восстановление находит осиротевшие ходы.
//
// Параметры:
//  ИдентификаторХода - Строка
//  ИдентификаторЗадания - УникальныйИдентификатор, Строка
//
Процедура ЗаписатьЗадание(ИдентификаторХода, ИдентификаторЗадания) Экспорт

	ИзменитьСостояние(ИдентификаторХода, Новый Структура("ИдентификаторЗадания", Строка(ИдентификаторЗадания)));

КонецПроцедуры

// Удаляет состояние хода, задание которого не запустилось.
//
// Параметры:
//  ИдентификаторХода - Строка
//
Процедура УдалитьСостояние(ИдентификаторХода) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Набор = РегистрыСведений.ИИА_СостоянияХодов.СоздатьНаборЗаписей();
	Набор.Отбор.Пользователь.Установить(Пользователи.ТекущийПользователь());
	Набор.Отбор.ИдентификаторХода.Установить(ИдентификаторХода);
	Набор.Записать();

КонецПроцедуры

// Записывает шаг хода: шаги (не больше 30, detail уже замаскирован), промежуточный результат и отложенный статус.
// Сбой записи не прерывает ход: ошибка - в журнал регистрации.
//
// Параметры:
//  ИдентификаторХода - Строка
//  Результат - Структура - промежуточный результат хода (см. ИИА_Агент.ВыполнитьХод).
//  ПараметрыШагов - Структура - параметры шагов хода; ОтложенныйСтатус после записи очищается.
//
Процедура ЗаписатьШаг(ИдентификаторХода, Результат, ПараметрыШагов) Экспорт

	Изменения = Новый Структура;
	Изменения.Вставить("Шаги", ОбщегоНазначения.ЗначениеВJSON(Результат.Шаги));
	Изменения.Вставить("ПромежуточныйРезультат", Новый ХранилищеЗначения(Результат));
	Отложенный = "";
	Если ПараметрыШагов.Свойство("ОтложенныйСтатус", Отложенный) И Не ПустаяСтрока(Отложенный) Тогда
		Изменения.Вставить("ПоследнийСтатус", Лев(Отложенный, 300));
		ПараметрыШагов.ОтложенныйСтатус = "";
	КонецЕсли;
	Попытка
		ИзменитьСостояние(ИдентификаторХода, Изменения);
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Записывает текущий статус хода не чаще раза в секунду: более частый статус откладывается до следующей записи
// статуса или шага. Первый статус пишется сразу.
//
// Параметры:
//  ИдентификаторХода - Строка
//  Текст - Строка
//  ПараметрыШагов - Структура - хранит момент последней записи (МоментСтатуса) и ОтложенныйСтатус.
//
Процедура ЗаписатьСтатус(ИдентификаторХода, Текст, ПараметрыШагов) Экспорт

	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Момент = 0;
	ПараметрыШагов.Свойство("МоментСтатуса", Момент);
	Если ТипЗнч(Момент) = Тип("Число") И Момент > 0 И Сейчас - Момент < 1000 Тогда
		ПараметрыШагов.Вставить("ОтложенныйСтатус", Текст);
		Возврат;
	КонецЕсли;
	ПараметрыШагов.Вставить("МоментСтатуса", Сейчас);
	ПараметрыШагов.Вставить("ОтложенныйСтатус", "");
	Попытка
		ИзменитьСостояние(ИдентификаторХода, Новый Структура("ПоследнийСтатус", Лев(Текст, 300)));
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Первая фаза «Стоп»: флаг остановки, который агент проверяет перед вызовом модели и инструментом. Ход на паузе
// задания не имеет и завершается сразу частичным ответом с обрывом stopped.
//
// Параметры:
//  ИдентификаторХода - Строка
//
// Возвращаемое значение:
//  Булево - Истина, если ход был активен.
//
Функция ЗапроситьОстановку(ИдентификаторХода) Экспорт

	Изменено = ИзменитьСостояние(ИдентификаторХода, Новый Структура("ЗапросОстановки, ПоследнийСтатус", Истина,
		НСтр("ru = 'Останавливаю'")), СтатусВыполняется() + "," + СтатусПауза() + "," + СтатусЗавершается(), Ложь);
	Если Изменено Тогда
		Пауза = ЗахватитьПаузу(ИдентификаторХода);
		// Захват running -> finishing под блокировкой, как в ВосстановитьХод: ход финализирует только один участник.
		Если Пауза <> Неопределено И ИзменитьСостояние(ИдентификаторХода,
			Новый Структура("Статус", СтатусЗавершается()), СтатусВыполняется()) Тогда
			// Без результата в состоянии паузы берётся промежуточный из регистра.
			Результат = Неопределено;
			Если ТипЗнч(Пауза.Состояние) = Тип("Структура") Тогда
				Пауза.Состояние.Свойство("Результат", Результат);
			КонецЕсли;
			ЗавершитьПрерванныйХод(ИдентификаторХода, Результат, Истина);
		КонецЕсли;
	КонецЕсли;
	Возврат Изменено;

КонецФункции

// Запрошена ли остановка хода.
//
// Параметры:
//  ИдентификаторХода - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция ОстановкаЗапрошена(ИдентификаторХода) Экспорт

	// Чтение под разделяемой блокировкой записи: флаг, записанный окном, виден без грязного чтения.
	Пользователь = Пользователи.ТекущийПользователь();
	УстановитьПривилегированныйРежим(Истина);
	Запрошена = Ложь;
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.ИИА_СостоянияХодов");
		Элемент.Режим = РежимБлокировкиДанных.Разделяемый;
		Элемент.УстановитьЗначение("Пользователь", Пользователь);
		Элемент.УстановитьЗначение("ИдентификаторХода", ИдентификаторХода);
		Блокировка.Заблокировать();
		Запись = МенеджерСостояния(Пользователь, ИдентификаторХода);
		Запрошена = Запись.Выбран() И Запись.ЗапросОстановки;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Запрошена;

КонецФункции

// Вторая фаза «Стоп»: отменяет фоновое задание хода, если оно ещё работает (например, ждёт ответа модели).
// Частичный ответ затем сохраняет восстановление по промежуточному результату (см. ВосстановитьОсиротевшие).
//
// Параметры:
//  ИдентификаторХода - Строка
//
Процедура ПрерватьЗадание(ИдентификаторХода) Экспорт

	Данные = ДанныеСостояния(ИдентификаторХода, Ложь);
	Если Данные = Неопределено Или Не Данные.ЗапросОстановки Тогда
		Возврат;
	КонецЕсли;
	Задание = ЗаданиеПоИдентификатору(Данные.ИдентификаторЗадания);
	Если Задание <> Неопределено И Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Задание.Отменить();
	КонецЕсли;

КонецПроцедуры

// Записывает итог хода после сохранения ответа: статус finishing, номер реплики с ответом, ошибку и то, что
// окно должно открыть после ответа. Окончательный статус ставит выборка очереди (см. СледующийХодОчереди).
//
// Параметры:
//  ИдентификаторХода - Строка
//  Итог - Структура - см. ЗавершитьХодДиалога.
//
Процедура ЗаписатьИтог(ИдентификаторХода, Итог) Экспорт

	ИзменитьСостояние(ИдентификаторХода, Новый Структура("Статус, НомерОтвета, Ошибка, ОткрытьПослеОтвета, ПоследнийСтатус",
		СтатусЗавершается(), Итог.НомерСообщения, Лев(Итог.Ошибка, 1000), Итог.ОткрытьПослеОтвета, ""));

КонецПроцедуры

// Завершает ход окончательным статусом (done, stopped, error).
//
// Параметры:
//  ИдентификаторХода - Строка
//  Статус - Строка
//
Процедура ЗавершитьХод(ИдентификаторХода, Статус) Экспорт

	ИзменитьСостояние(ИдентификаторХода, Новый Структура("Статус", Статус));

КонецПроцедуры

// Состояние показанного диалога для опроса окна чата. Заодно отмечает опрос окна для активных ходов
// пользователя и восстанавливает осиротевшие ходы.
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги, Неопределено - диалог на странице.
//  ИдентификаторХода - Строка - ход, шаги которого уже показаны; другой ход - шаги с начала.
//  ПоказаноШагов - Число - сколько шагов этого хода уже показано.
//
// Возвращаемое значение:
//  Структура:
//   * Ход - Структура, Неопределено - ход диалога: сначала неполученный итог, затем активный ход:
//     ** ИдентификаторХода - Строка
//     ** Статус - Строка
//     ** Шаги - Массив из Соответствие - шаги после уже показанных (detail - с псевдонимами).
//     ** ВсегоШагов - Число
//     ** ПоследнийСтатус - Строка
//     ** ИтогГотов - Булево - ответ сохранён или ход завершился ошибкой.
//     ** НомерОтвета - Число - реплика с ответом; 0 - ответ не сохранён.
//     ** НомерЗаменяемогоОтвета - Число
//     ** Ошибка - Строка
//     ** ЗапросОстановки - Булево
//   * Ожидающие - Массив из Структура - см. ОжидающиеДиалога.
//   * ЕстьАктивныйХод - Булево - у пользователя есть активный ход в любом диалоге.
//   * ЕстьЖдущие - Булево - у пользователя есть ждущие сообщения (waiting).
//   * ДиалогДругогоХода - Строка - наименование диалога, в котором идёт ход, если не в показанном.
//   * ГотовыеДругих - Массив из Структура - ИдентификаторХода, Наименование, Ошибка - неполученные итоги
//       других диалогов.
//   * Пауза - Структура, Неопределено - ход пользователя (в любом диалоге) на паузе ждёт структуру формы:
//       ИдентификаторХода, Форма, КлючОбъекта. Её строит любое открытое окно чата.
//   * АктивныйХод - Строка - идентификатор активного хода пользователя (для «Стоп»); пусто - нет.
//
Функция СостояниеДиалога(Диалог, ИдентификаторХода = "", ПоказаноШагов = 0) Экспорт

	Результат = Новый Структура("Ход, Ожидающие, ЕстьАктивныйХод, ЕстьЖдущие, ДиалогДругогоХода, ГотовыеДругих, Пауза, "
		+ "АктивныйХод", Неопределено, Новый Массив, Ложь, Ложь, "", Новый Массив, Неопределено, "");
	// Одно чтение состояний на опрос; повторное - только если восстановление что-то изменило.
	Записи = ЗаписиПользователя();
	Если ВосстановитьОсиротевшие(Записи) Тогда
		Записи = ЗаписиПользователя();
	КонецЕсли;
	Записи.Сортировать("Начало");
	ЗаписьДиалога = Неопределено;
	Для Каждого Запись Из Записи Цикл
		Активен = ХодАктивен(Запись.Статус);
		Готов = ИтогГотов(Запись);
		Если Активен Тогда
			Результат.ЕстьАктивныйХод = Истина;
			Результат.АктивныйХод = Запись.ИдентификаторХода;
			ОтметитьОпросОкна(Запись);
		КонецЕсли;
		Если Запись.Статус = СтатусПауза() Тогда
			Пауза = ПаузаХода(Запись.ИдентификаторХода);
			Если Пауза <> Неопределено Тогда
				Результат.Пауза = Новый Структура("ИдентификаторХода, Форма, КлючОбъекта", Запись.ИдентификаторХода,
					Пауза.Форма, Пауза.КлючОбъекта);
			КонецЕсли;
		КонецЕсли;
		ЭтотДиалог = ЗначениеЗаполнено(Диалог) И Запись.Диалог = Диалог;
		Если ЭтотДиалог И Готов Тогда
			Если ЗаписьДиалога = Неопределено Или Не ИтогГотов(ЗаписьДиалога) Тогда
				ЗаписьДиалога = Запись;
			КонецЕсли;
		ИначеЕсли ЭтотДиалог И Активен Тогда
			Если ЗаписьДиалога = Неопределено Тогда
				ЗаписьДиалога = Запись;
			КонецЕсли;
		ИначеЕсли Готов Тогда
			Результат.ГотовыеДругих.Добавить(Новый Структура("ИдентификаторХода, Наименование, Ошибка",
				Запись.ИдентификаторХода, НаименованиеДиалога(Запись.Диалог), Запись.Ошибка));
		ИначеЕсли Активен И ПустаяСтрока(Результат.ДиалогДругогоХода) Тогда
			Результат.ДиалогДругогоХода = НаименованиеДиалога(Запись.Диалог);
		КонецЕсли;
	КонецЦикла;
	Если ЗаписьДиалога <> Неопределено Тогда
		Результат.Ход = ОписаниеХода(ЗаписьДиалога, ИдентификаторХода, ПоказаноШагов);
	КонецЕсли;
	Если ЗначениеЗаполнено(Диалог) Тогда
		Результат.Ожидающие = ОжидающиеДиалога(Диалог);
	КонецЕсли;
	Результат.ЕстьЖдущие = ЕстьЖдущиеПользователя();
	Возврат Результат;

КонецФункции

// Забирает итог хода окном: завершённое состояние удаляется, у хода, который ещё выбирает очередь, итог
// помечается полученным. Автооткрытие после ответа поэтому выполняется один раз.
//
// Параметры:
//  ИдентификаторХода - Строка
//
// Возвращаемое значение:
//  Строка - JSON ОткрытьПослеОтвета; пусто, если итог уже забран.
//
Функция ЗабратьИтог(ИдентификаторХода) Экспорт

	Пользователь = Пользователи.ТекущийПользователь();
	УстановитьПривилегированныйРежим(Истина);
	ОткрытьПослеОтвета = "";
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьСостояние(Пользователь, ИдентификаторХода);
		Запись = МенеджерСостояния(Пользователь, ИдентификаторХода);
		Если Запись.Выбран() И Не Запись.ИтогПоказан Тогда
			ОткрытьПослеОтвета = Запись.ОткрытьПослеОтвета;
			Если ХодЗавершен(Запись.Статус) Тогда
				Запись.Удалить();
			Иначе
				Запись.ИтогПоказан = Истина;
				Запись.ОткрытьПослеОтвета = "";
				Запись.Записать();
			КонецЕсли;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат ОткрытьПослеОтвета;

КонецФункции

// Есть ли у текущего пользователя активный ход (running, paused, finishing) в любом диалоге.
//
// Возвращаемое значение:
//  Булево
//
Функция ЕстьАктивныйХод() Экспорт

	Для Каждого Запись Из ЗаписиПользователя() Цикл
		Если ХодАктивен(Запись.Статус) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Занят ли диалог: в нём идёт ход или есть ждущие сообщения. Такой диалог удалять нельзя.
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги
//
// Возвращаемое значение:
//  Булево
//
Функция ДиалогЗанят(Диалог) Экспорт

	Если Не ЗначениеЗаполнено(Диалог) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Запись Из ЗаписиПользователя() Цикл
		Если Запись.Диалог = Диалог И ХодАктивен(Запись.Статус) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат ОжидающиеДиалога(Диалог).Количество() > 0;

КонецФункции

// Отмечает опрос окна чата: пока окно опрашивает ход не реже раза в 5 с, клиент считается присоединённым.
//
// Параметры:
//  ИдентификаторХода - Строка
//
Процедура ПрисоединитьОкно(ИдентификаторХода) Экспорт

	ИзменитьСостояние(ИдентификаторХода, Новый Структура("ОкноОпрос, ОкноОтсоединено", ТекущаяУниверсальнаяДата(), Ложь), ,
		Ложь);

КонецПроцедуры

// Окно чата закрывается: активные ходы пользователя продолжаются без клиента, ход на паузе сразу
// возобновляется с причиной «окно чата закрыто».
//
Процедура ОтсоединитьОкно() Экспорт

	Для Каждого Запись Из ЗаписиПользователя() Цикл
		Если Не ХодАктивен(Запись.Статус) Тогда
			Продолжить;
		КонецЕсли;
		ИзменитьСостояние(Запись.ИдентификаторХода, Новый Структура("ОкноОтсоединено", Истина), , Ложь);
		Если Запись.Статус = СтатусПауза() Тогда
			ПродолжитьПаузу(Запись.ИдентификаторХода, Неопределено, Ложь);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Присоединён ли клиент к ходу: канал chat, окно опрашивало состояние не дольше 5 с назад и не закрывалось.
//
// Параметры:
//  ИдентификаторХода - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция КлиентПрисоединён(ИдентификаторХода) Экспорт

	Данные = ДанныеСостояния(ИдентификаторХода, Ложь);
	Если Данные = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ОкноПрисоединено(Данные.Канал, Данные.ОкноОпрос, Данные.ОкноОтсоединено, ТекущаяУниверсальнаяДата());

КонецФункции

// Правило присоединения окна (см. КлиентПрисоединён): для http всегда Ложь.
//
// Параметры:
//  Канал - Строка - "chat" или "http".
//  ОкноОпрос - Дата - последний опрос окна (UTC).
//  ОкноОтсоединено - Булево
//  Сейчас - Дата - текущее время (UTC).
//
// Возвращаемое значение:
//  Булево
//
Функция ОкноПрисоединено(Канал, ОкноОпрос, ОкноОтсоединено, Сейчас) Экспорт

	Возврат Канал = КаналЧата() И Не ОкноОтсоединено И ЗначениеЗаполнено(ОкноОпрос) И Сейчас - ОкноОпрос <= 5;

КонецФункции

// Причина отсутствия структуры формы, когда окно чата не присоединено к ходу: инструмент получает её вместо
// структуры и идёт по серверному пути.
//
// Возвращаемое значение:
//  Строка
//
Функция ПричинаОкноЗакрыто() Экспорт

	Возврат НСтр("ru = 'Окно чата закрыто: структуру формы на клиенте построить нельзя. Ответь по уже известным сведениям или предложи пользователю открыть чат и повторить вопрос.'");

КонецФункции

// Ставит ход на паузу ради структуры формы: состояние возобновления хранится в регистре, поэтому продолжить ход
// может любой экземпляр окна чата пользователя. Задание после этого завершается.
//
// Параметры:
//  ИдентификаторХода - Строка
//  ИмяФормы - Строка - полное имя формы.
//  КлючОбъекта - Произвольный - объект, с которым нужна форма; Неопределено - без объекта.
//  Состояние - Структура - состояние хода для возобновления (см. ИИА_Агент.ВыполнитьХод).
//
Процедура ЗаписатьПаузу(ИдентификаторХода, ИмяФормы, КлючОбъекта, Состояние) Экспорт

	ИзменитьСостояние(ИдентификаторХода, Новый Структура("Статус, Пауза, ПоследнийСтатус", СтатусПауза(),
		Новый ХранилищеЗначения(Новый Структура("Форма, КлючОбъекта, Состояние", ИмяФормы, КлючОбъекта, Состояние)),
		НСтр("ru = 'Смотрю форму'")));

КонецПроцедуры

// Под блокировкой переводит ход paused -> running и забирает состояние паузы: второй вызов получает
// Неопределено, поэтому два окна не запустят возобновление дважды.
//
// Параметры:
//  ИдентификаторХода - Строка
//
// Возвращаемое значение:
//  Структура, Неопределено - Форма, КлючОбъекта, Состояние; Неопределено - ход не на паузе.
//
Функция ЗахватитьПаузу(ИдентификаторХода) Экспорт

	Пользователь = Пользователи.ТекущийПользователь();
	УстановитьПривилегированныйРежим(Истина);
	Пауза = Неопределено;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьСостояние(Пользователь, ИдентификаторХода);
		Запись = МенеджерСостояния(Пользователь, ИдентификаторХода);
		Если Запись.Выбран() И Запись.Статус = СтатусПауза() Тогда
			Пауза = Запись.Пауза.Получить();
			Если ТипЗнч(Пауза) = Тип("Структура") Тогда
				Пауза.Вставить("Канал", ?(ЗначениеЗаполнено(Запись.Канал), Запись.Канал, КаналЧата()));
			КонецЕсли;
			Запись.Статус = СтатусВыполняется();
			Запись.Пауза = Новый ХранилищеЗначения(Неопределено);
			Запись.Обновлено = ТекущаяУниверсальнаяДата();
			Запись.ИдентификаторЗадания = "";
			Запись.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат ?(ТипЗнч(Пауза) = Тип("Структура"), Пауза, Неопределено);

КонецФункции

// Продолжает ход с паузы новым фоновым заданием: структура формы (или причина её отсутствия) добавляется
// к состоянию хода, ход продолжается с того же вызова инструмента. Слоты лимита ответов не проверяются.
//
// Параметры:
//  ИдентификаторХода - Строка
//  Структура - Массив, Строка, Неопределено - см. ИИА_ЧатКлиент.СтруктураФормы; Неопределено - окна нет.
//  КлиентПрисоединён - Булево - Ложь: структуру строить некому, инструмент получит причину.
//
// Возвращаемое значение:
//  Структура - Запущено (Булево), Ошибка (Строка).
//
Функция ПродолжитьПаузу(ИдентификаторХода, Структура, КлиентПрисоединён) Экспорт

	Результат = Новый Структура("Запущено, Ошибка", Ложь, "");
	Пауза = ЗахватитьПаузу(ИдентификаторХода);
	Если Пауза = Неопределено Тогда
		Результат.Ошибка = НСтр("ru = 'Ход не ожидает структуру формы.'");
		Возврат Результат;
	КонецЕсли;
	Состояние = Пауза.Состояние;
	Если ТипЗнч(Структура) = Тип("Массив") Или ТипЗнч(Структура) = Тип("Строка") Тогда
		ЗначениеСтруктуры = Структура;
	ИначеЕсли КлиентПрисоединён Тогда
		ЗначениеСтруктуры = НСтр("ru = 'Структура формы не получена.'");
	Иначе
		ЗначениеСтруктуры = ПричинаОкноЗакрыто();
	КонецЕсли;
	// Ключ ставится всегда (структура или причина её отсутствия): повторной паузы на той же форме не будет.
	Состояние.СтруктурыФорм.Вставить(Пауза.Форма, ЗначениеСтруктуры);
	// Канал продолжения - из состояния хода (см. ЗахватитьПаузу): метка канала в задании не теряется после паузы.
	ПараметрыХода = Новый Структура("Канал, ИдентификаторХода, Возобновление", Пауза.Канал, ИдентификаторХода, Состояние);
	Попытка
		Задание = ЗапуститьЗадание(ПараметрыХода);
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		// Ход возвращается на паузу: его продолжит следующий опрос или открытие чата.
		ИзменитьСостояние(ИдентификаторХода, Новый Структура("Статус, Пауза", СтатусПауза(), Новый ХранилищеЗначения(Пауза)));
		Результат.Ошибка = НСтр("ru = 'Не удалось продолжить ответ ассистента. Подробности - в журнале регистрации.'");
		Возврат Результат;
	КонецПопытки;
	// Идентификатор пишется и здесь: задание, упавшее до своей записи, иначе осталось бы без идентификатора.
	// Повторная запись из задания безвредна.
	ЗаписатьЗадание(ИдентификаторХода, Задание.УникальныйИдентификатор);
	Результат.Запущено = Истина;
	Возврат Результат;

КонецФункции

// Восстанавливает осиротевшие ходы текущего пользователя:
//  - running или finishing без активного задания (аварийный выход из программы в файловой базе, жёсткая отмена,
//    падение) - финализируется частичным результатом из регистра с кнопкой «Продолжить»;
//  - paused, окно которого не опрашивало состояние дольше 60 с, - возобновляется без клиента;
//  - ждущие сообщения (waiting) без активного хода и задания - переводятся в отложенные «Ответ прерван».
// Вызывают опрос окна, открытие чата и запуск хода; регламентное задание ход не возобновляет.
//
// Параметры:
//  Записи - ТаблицаЗначений, Неопределено - уже прочитанные состояния пользователя (см. СостояниеДиалога),
//           без них состояния читаются заново.
//
// Возвращаемое значение:
//  Булево - Истина, если состояние какого-либо хода или очереди изменено.
//
Функция ВосстановитьОсиротевшие(Записи = Неопределено) Экспорт

	Если Записи = Неопределено Тогда
		Записи = ЗаписиПользователя();
	КонецЕсли;
	Изменено = Ложь;
	ЕстьАктивные = Ложь;
	Сейчас = ТекущаяУниверсальнаяДата();
	Для Каждого Запись Из Записи Цикл
		ЕстьАктивные = ЕстьАктивные Или ХодАктивен(Запись.Статус);
		Если Запись.Статус = СтатусПауза() И Сейчас - Макс(Запись.ОкноОпрос, Запись.Обновлено) > 60 Тогда
			ПродолжитьПаузу(Запись.ИдентификаторХода, Неопределено, Ложь);
			Изменено = Истина;
		ИначеЕсли ХодОсиротел(Запись, Сейчас) Тогда
			ВосстановитьХод(Запись);
			Изменено = Истина;
		КонецЕсли;
	КонецЦикла;
	Если Не ЕстьАктивные И ЕстьЖдущиеПользователя() Тогда
		Изменено = ОтложитьЖдущиеБезХода() Или Изменено;
	КонецЕсли;
	Возврат Изменено;

КонецФункции

#КонецОбласти

#Область Очередь

// Ставит сообщение в очередь, если у пользователя идёт ход. Проверка и запись - под блокировкой очереди
// пользователя, той же, под которой задание выбирает очередь: сообщение не теряется между концом хода и
// выборкой очереди.
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги - диалог текущего пользователя.
//  Текст - Строка - текст в том виде, в каком сохраняется реплика (после проверки ПДн, ссылки - маркерами объектов).
//  Объекты - Массив из Структура - Текст, Ссылка (навигационная), Класс - объекты ссылок вопроса.
//  КлассДанных - Число
//  ВсегдаВОчередь - Булево - записать и без активного хода: новое сообщение уходит вместе с отложенными
//    сообщениями диалога (см. ЗапуститьОчередьДиалога).
//
// Возвращаемое значение:
//  Структура:
//   * ЗапускатьСразу - Булево - активного хода нет: запись не создана, ход надо запускать сразу.
//   * Идентификатор - Строка - идентификатор записи очереди.
//
Функция ПоставитьВОчередь(Диалог, Текст, Объекты, КлассДанных, ВсегдаВОчередь = Ложь) Экспорт

	Результат = Новый Структура("ЗапускатьСразу, Идентификатор", Истина, "");
	Пользователь = Пользователи.ТекущийПользователь();
	УстановитьПривилегированныйРежим(Истина);
	Если Не ЗначениеЗаполнено(Диалог)
		Или ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Диалог, "Пользователь") <> Пользователь Тогда
		ВызватьИсключение НСтр("ru = 'Диалог недоступен.'");
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьОчередь(Пользователь);
		Если ВсегдаВОчередь Или ЕстьАктивныйХод() Тогда
			Запись = РегистрыСведений.ИИА_ОчередьСообщений.СоздатьМенеджерЗаписи();
			Запись.Пользователь = Пользователь;
			Запись.ИдентификаторЗаписи = Строка(Новый УникальныйИдентификатор);
			Запись.Диалог = Диалог;
			Запись.ДатаПостановки = ТекущаяУниверсальнаяДата();
			Запись.Текст = Лев(Текст, 8000);
			Запись.Объекты = ОбщегоНазначения.ЗначениеВJSON(?(Объекты = Неопределено, Новый Массив, Объекты));
			Запись.КлассДанных = ИИА_КлассыДанных.ПодтвержденныйКласс(КлассДанных);
			Запись.Статус = СтатусОжидает();
			Запись.Записать();
			Результат.ЗапускатьСразу = Ложь;
			Результат.Идентификатор = Запись.ИдентификаторЗаписи;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Отменяет ждущее сообщение: запись удаляется, текст возвращается для поля ввода.
//
// Параметры:
//  Идентификатор - Строка - идентификатор записи очереди.
//
// Возвращаемое значение:
//  Строка, Неопределено - текст для показа (псевдонимы раскрыты); Неопределено - сообщение уже отправляется
//    или отправлено.
//
Функция ОтменитьОжидающее(Идентификатор) Экспорт

	Пользователь = Пользователи.ТекущийПользователь();
	УстановитьПривилегированныйРежим(Истина);
	Текст = Неопределено;
	Диалог = Неопределено;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьОчередь(Пользователь);
		Запись = РегистрыСведений.ИИА_ОчередьСообщений.СоздатьМенеджерЗаписи();
		Запись.Пользователь = Пользователь;
		Запись.ИдентификаторЗаписи = Идентификатор;
		Запись.Прочитать();
		Если Запись.Выбран() И Запись.Статус <> СтатусОтправляется() Тогда
			Текст = Запись.Текст;
			Диалог = Запись.Диалог;
			Запись.Удалить();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат ?(Текст = Неопределено, Неопределено, ИИА_Маскирование.ДляПользователя(Текст, Диалог));

КонецФункции

// Есть ли у диалога отложенные (held) сообщения: новое сообщение отправляется вместе с ними.
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги
//
// Возвращаемое значение:
//  Булево
//
Функция ЕстьОтложенные(Диалог) Экспорт

	Если Не ЗначениеЗаполнено(Диалог) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Ожидающее Из ОжидающиеДиалога(Диалог) Цикл
		Если Ожидающее.Статус = СтатусОтложено() Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Возвращает в ожидание отложенные сообщения диалога ждущего сообщения (кнопка «Отправить» на ждущем).
//
// Параметры:
//  Идентификатор - Строка - идентификатор записи очереди.
//  Диалог - СправочникСсылка.ИИА_Диалоги, Неопределено - диалог показанного окна: сообщение другого диалога
//    не трогается; Неопределено - без проверки.
//
// Возвращаемое значение:
//  СправочникСсылка.ИИА_Диалоги, Неопределено - диалог сообщения; Неопределено - записи нет или она другого диалога.
//
Функция ОтправитьОжидающее(Идентификатор, Диалог = Неопределено) Экспорт

	Пользователь = Пользователи.ТекущийПользователь();
	УстановитьПривилегированныйРежим(Истина);
	Запись = РегистрыСведений.ИИА_ОчередьСообщений.СоздатьМенеджерЗаписи();
	Запись.Пользователь = Пользователь;
	Запись.ИдентификаторЗаписи = Идентификатор;
	Запись.Прочитать();
	Если Не Запись.Выбран() Или Диалог <> Неопределено И Запись.Диалог <> Диалог Тогда
		Возврат Неопределено;
	КонецЕсли;
	ДиалогЗаписи = Запись.Диалог;
	ИзменитьСтатусОчереди(Пользователь, ДиалогЗаписи, СтатусОтложено(), СтатусОжидает(), "");
	Возврат ДиалогЗаписи;

КонецФункции

// Ждущие и отложенные сообщения диалога текущего пользователя по порядку постановки.
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги
//
// Возвращаемое значение:
//  Массив из Структура - Идентификатор, Текст (с псевдонимами), Статус (waiting, held), Причина, ДатаПостановки.
//
Функция ОжидающиеДиалога(Диалог) Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	О.ИдентификаторЗаписи КАК Идентификатор,
	|	О.Текст КАК Текст,
	|	О.Статус КАК Статус,
	|	О.Причина КАК Причина,
	|	О.ДатаПостановки КАК ДатаПостановки
	|ИЗ
	|	РегистрСведений.ИИА_ОчередьСообщений КАК О
	|ГДЕ
	|	О.Пользователь = &Пользователь
	|	И О.Диалог = &Диалог
	|	И О.Статус В (&Статусы)
	|
	|УПОРЯДОЧИТЬ ПО
	|	О.ДатаПостановки");
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	Запрос.УстановитьПараметр("Диалог", Диалог);
	Запрос.УстановитьПараметр("Статусы", СтрРазделить(СтатусОжидает() + "," + СтатусОтложено(), ","));
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	Ожидающие = Новый Массив;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Ожидающие.Добавить(Новый Структура("Идентификатор, Текст, Статус, Причина, ДатаПостановки", Выборка.Идентификатор,
			Выборка.Текст, Выборка.Статус, Выборка.Причина, Выборка.ДатаПостановки));
	КонецЦикла;
	Возврат Ожидающие;

КонецФункции

// Атомарно забирает очередь диалога: ждущие записи (и отложенные, если указано) переводятся в sending и
// склеиваются в одно сообщение: тексты через пустую строку по порядку постановки, объекты объединяются, класс -
// максимальный. Повторный вызов возвращает Неопределено.
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги
//  ВключаяОтложенные - Булево - забрать и отложенные (held): отправка вместе с новым сообщением или по «Отправить».
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено - забирать нечего:
//   * Текст - Строка
//   * Объекты - Массив из Структура - Текст, Ссылка, Класс.
//   * КлассДанных - Число
//   * Идентификаторы - Массив из Строка - записи очереди в статусе sending.
//
Функция ВзятьОчередьДиалога(Диалог, ВключаяОтложенные = Ложь) Экспорт

	Пользователь = Пользователи.ТекущийПользователь();
	УстановитьПривилегированныйРежим(Истина);
	Статусы = СтатусОжидает() + ?(ВключаяОтложенные, "," + СтатусОтложено(), "");
	Сообщение = Неопределено;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьОчередь(Пользователь);
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	О.ИдентификаторЗаписи КАК ИдентификаторЗаписи
		|ИЗ
		|	РегистрСведений.ИИА_ОчередьСообщений КАК О
		|ГДЕ
		|	О.Пользователь = &Пользователь
		|	И О.Диалог = &Диалог
		|	И О.Статус В (&Статусы)
		|
		|УПОРЯДОЧИТЬ ПО
		|	О.ДатаПостановки");
		Запрос.УстановитьПараметр("Пользователь", Пользователь);
		Запрос.УстановитьПараметр("Диалог", Диалог);
		Запрос.УстановитьПараметр("Статусы", СтрРазделить(Статусы, ","));
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Тексты = Новый Массив;
		Пока Выборка.Следующий() Цикл
			Запись = РегистрыСведений.ИИА_ОчередьСообщений.СоздатьМенеджерЗаписи();
			Запись.Пользователь = Пользователь;
			Запись.ИдентификаторЗаписи = Выборка.ИдентификаторЗаписи;
			Запись.Прочитать();
			Если Сообщение = Неопределено Тогда
				Сообщение = Новый Структура("Текст, Объекты, КлассДанных, Идентификаторы", "", Новый Массив, 1, Новый Массив);
			КонецЕсли;
			Тексты.Добавить(Запись.Текст);
			ДобавитьОбъектыОчереди(Сообщение.Объекты, Запись.Объекты);
			Сообщение.КлассДанных = Макс(Сообщение.КлассДанных, Запись.КлассДанных);
			Сообщение.Идентификаторы.Добавить(Запись.ИдентификаторЗаписи);
			Запись.Статус = СтатусОтправляется();
			Запись.Причина = "";
			Запись.Записать();
		КонецЦикла;
		Если Сообщение <> Неопределено Тогда
			Сообщение.Текст = СтрСоединить(Тексты, Символы.ПС + Символы.ПС);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Сообщение;

КонецФункции

// Диалог, очередь которого отправляется следующей: сначала диалог только что завершённого хода, затем диалог
// самого старого ждущего сообщения.
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги, Неопределено - диалог завершённого хода.
//
// Возвращаемое значение:
//  СправочникСсылка.ИИА_Диалоги, Неопределено - ждущих сообщений нет.
//
Функция СледующийДиалогОчереди(Диалог = Неопределено) Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	О.Диалог КАК Диалог
	|ИЗ
	|	РегистрСведений.ИИА_ОчередьСообщений КАК О
	|ГДЕ
	|	О.Пользователь = &Пользователь
	|	И О.Статус = &Статус
	|
	|УПОРЯДОЧИТЬ ПО
	|	О.ДатаПостановки");
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	Запрос.УстановитьПараметр("Статус", СтатусОжидает());
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	Диалоги = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Диалог");
	Если Диалоги.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ?(ЗначениеЗаполнено(Диалог) И Диалоги.Найти(Диалог) <> Неопределено, Диалог, Диалоги[0]);

КонецФункции

// Переводит ждущие сообщения пользователя в отложенные (held) с причиной: отправить их можно кнопкой
// «Отправить» на ждущем или вместе с новым сообщением.
//
// Параметры:
//  Причина - Строка
//  ВключаяОтправляемые - Булево - и сообщения в статусе sending (ход прерван до отправки).
//
Процедура ПеревестиВОтложенные(Причина, ВключаяОтправляемые = Ложь) Экспорт

	Пользователь = Пользователи.ТекущийПользователь();
	ИзменитьСтатусОчереди(Пользователь, Неопределено, СтатусОжидает(), СтатусОтложено(), Причина);
	Если ВключаяОтправляемые Тогда
		ИзменитьСтатусОчереди(Пользователь, Неопределено, СтатусОтправляется(), СтатусОтложено(), Причина);
	КонецЕсли;

КонецПроцедуры

// Возвращает забранные записи очереди (sending) в ожидание или в отложенные: сообщение не сохранено.
//
// Параметры:
//  Идентификаторы - Массив из Строка
//  Статус - Строка - waiting или held.
//  Причина - Строка
//
Процедура ВернутьВОчередь(Идентификаторы, Статус, Причина = "") Экспорт

	Пользователь = Пользователи.ТекущийПользователь();
	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьОчередь(Пользователь);
		Для Каждого Идентификатор Из Идентификаторы Цикл
			Запись = РегистрыСведений.ИИА_ОчередьСообщений.СоздатьМенеджерЗаписи();
			Запись.Пользователь = Пользователь;
			Запись.ИдентификаторЗаписи = Идентификатор;
			Запись.Прочитать();
			Если Запись.Выбран() Тогда
				Запись.Статус = Статус;
				Запись.Причина = Лев(Причина, 300);
				Запись.Записать();
			КонецЕсли;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Удаляет отправленные записи очереди: сообщение сохранено репликой диалога.
//
// Параметры:
//  Идентификаторы - Массив из Строка
//
Процедура УдалитьОтправленные(Идентификаторы) Экспорт

	Пользователь = Пользователи.ТекущийПользователь();
	УстановитьПривилегированныйРежим(Истина);
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Набор = РегистрыСведений.ИИА_ОчередьСообщений.СоздатьНаборЗаписей();
		Набор.Отбор.Пользователь.Установить(Пользователь);
		Набор.Отбор.ИдентификаторЗаписи.Установить(Идентификатор);
		Набор.Записать();
	КонецЦикла;

КонецПроцедуры

// Решение цикла очереди в одном задании: продолжать ли отправку следующего сообщения.
//
// Параметры:
//  ХодовПодряд - Число - сколько ходов уже выполнено подряд в этом задании.
//  ОстановкаЗапрошена - Булево - пользователь нажал «Стоп».
//  ПричинаОтказаЛимитов - Строка - отказ выключателя, профиля или дневных лимитов; пусто - лимиты не мешают.
//  СлотыЗаняты - Булево - достигнут лимит одновременных ответов без учёта своего задания.
//
// Возвращаемое значение:
//  Структура - Продолжать (Булево), Причина (Строка - причина перевода очереди в held).
//
Функция РешениеЦиклаОчереди(ХодовПодряд, ОстановкаЗапрошена, ПричинаОтказаЛимитов, СлотыЗаняты) Экспорт

	Решение = Новый Структура("Продолжать, Причина", Ложь, "");
	Если ОстановкаЗапрошена Тогда
		Решение.Причина = НСтр("ru = 'Отправка приостановлена'");
	ИначеЕсли ХодовПодряд >= МаксимумХодовПодряд() Тогда
		Решение.Причина = СтрШаблон(НСтр("ru = 'Отправлено %1 сообщений подряд: нажмите «Отправить», чтобы продолжить'"),
			МаксимумХодовПодряд());
	ИначеЕсли Не ПустаяСтрока(ПричинаОтказаЛимитов) Тогда
		Решение.Причина = ПричинаОтказаЛимитов;
	ИначеЕсли СлотыЗаняты Тогда
		Решение.Причина = НСтр("ru = 'Ассистент занят ответами другим пользователям'");
	Иначе
		Решение.Продолжать = Истина;
	КонецЕсли;
	Возврат Решение;

КонецФункции

// Сколько ходов подряд выполняет одно фоновое задание.
//
// Возвращаемое значение:
//  Число
//
Функция МаксимумХодовПодряд() Экспорт

	Возврат 5;

КонецФункции

// Запускает ход по очереди диалога, когда активного хода нет: отправка отложенных сообщений кнопкой
// «Отправить» или вместе с новым сообщением. Ход запускается обычным путём со всеми лимитами; при отказе
// сообщения возвращаются в отложенные с причиной.
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги
//  ИдентификаторФормы - УникальныйИдентификатор
//  СтруктурыФорм - Соответствие, Неопределено - кэш структур форм окна.
//
// Возвращаемое значение:
//  Структура:
//   * Запущено - Булево
//   * ВОчереди - Булево - ход уже идёт: сообщения остались ждать.
//   * Ошибка - Строка
//   * ИдентификаторХода - Строка
//   * НомерСообщения - Число - сохранённая реплика пользователя.
//
Функция ЗапуститьОчередьДиалога(Диалог, ИдентификаторФормы, СтруктурыФорм = Неопределено) Экспорт

	Результат = Новый Структура("Запущено, ВОчереди, Ошибка, ИдентификаторХода, НомерСообщения", Ложь, Ложь, "", "", 0);
	Пользователь = Пользователи.ТекущийПользователь();
	УстановитьПривилегированныйРежим(Истина);
	Сообщение = Неопределено;
	// Проверка активного хода и перевод held -> waiting - под той же блокировкой очереди, под которой завершающийся
	// ход выбирает очередь: ждущие не остаются без хода.
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьОчередь(Пользователь);
		Если ЕстьАктивныйХод() Тогда
			ИзменитьСтатусОчереди(Пользователь, Диалог, СтатусОтложено(), СтатусОжидает(), "");
			Результат.ВОчереди = Истина;
		Иначе
			Сообщение = ВзятьОчередьДиалога(Диалог, Истина);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Если Сообщение = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Вопрос = СохранитьВопросОчереди(Диалог, Сообщение);
	Запуск = ИИА_ЧатВызовСервера.ЗапуститьХод(Вопрос.История, Сообщение.Текст, ИдентификаторФормы, Вопрос.Контекст,
		Неопределено, Диалог, Неопределено, Вопрос.ОбъектыВопроса, , СтруктурыФорм, КаналЧата());
	Если Не Запуск.Запущено Тогда
		// Записи очереди ещё в статусе sending: пустой диалог при удалении вопроса не удаляется.
		ИИА_ЧатВызовСервера.УдалитьСообщение(Диалог, Вопрос.НомерСообщения);
		// И занятый ключ задания (ход другого окна), и отказ лимитов - в отложенные с причиной: ход, занявший
		// ключ, мог уже выбрать очередь, ждущие тогда остались бы без хода.
		ВернутьВОчередь(Сообщение.Идентификаторы, СтатусОтложено(), Запуск.Ошибка);
		Результат.Ошибка = Запуск.Ошибка;
		Возврат Результат;
	КонецЕсли;
	УдалитьОтправленные(Сообщение.Идентификаторы);
	Результат.Запущено = Истина;
	Результат.ИдентификаторХода = Запуск.ИдентификаторХода;
	Результат.НомерСообщения = Вопрос.НомерСообщения;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ФоновоеЗадание

// Ход канала chat в фоновом задании: ход агента, сохранение ответа в диалог и отправка очереди - не больше
// пяти ходов подряд, с перепроверкой лимитов и слотов между ходами. Пауза завершает задание; цикл продолжает
// задание возобновления.
//
// Параметры:
//  ПараметрыХода - Структура - см. ИИА_ЧатВызовСервера.ЗапуститьХод; обязательно ИдентификаторХода, при
//    возобновлении также Возобновление.
//
Процедура ВыполнитьХодЧата(ПараметрыХода) Экспорт

	ИдентификаторХода = ПараметрыХода.ИдентификаторХода;
	Данные = ДанныеСостояния(ИдентификаторХода, Ложь);
	Если Данные = Неопределено Тогда
		Возврат; // состояние удалено: ход отменён до старта
	КонецЕсли;
	Если Данные.Статус <> СтатусВыполняется() Тогда
		// Ход до старта задания уже финализировал другой участник (восстановление, «Стоп» на паузе).
		Возврат;
	КонецЕсли;
	// Задание записывает себя и само: запускающий код мог не успеть (повторная запись безвредна).
	Задание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	Если Задание <> Неопределено Тогда
		ЗаписатьЗадание(ИдентификаторХода, Задание.УникальныйИдентификатор);
	КонецЕсли;
	Диалог = Данные.Диалог;
	НомерЗаменяемогоОтвета = Данные.НомерЗаменяемогоОтвета;
	ЭтоПродолжение = Данные.ЭтоПродолжение;
	ХодовПодряд = Макс(1, Данные.ХодовПодряд);
	ТекущиеПараметры = ПараметрыХода;

	Пока Истина Цикл
		Попытка
			Результат = ВыполнитьОдинХод(ТекущиеПараметры, ИдентификаторХода);
		Исключение
			ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Результат = ПрерванныйРезультат(ИдентификаторХода,
				НСтр("ru = 'Ошибка при выполнении хода. Подробности - в журнале регистрации.'"), "error");
		КонецПопытки;
		Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("Пауза") Тогда
			КлючОбъекта = Неопределено;
			Результат.Свойство("КлючОбъекта", КлючОбъекта);
			Попытка
				ЗаписатьПаузу(ИдентификаторХода, Результат.Форма, КлючОбъекта, Результат.Состояние);
				Возврат;
			Исключение
				// Состояние паузы не сохранилось (например, не сериализуется): ход завершается частичным ответом.
				ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
					ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				Результат = ПрерванныйРезультат(ИдентификаторХода,
					НСтр("ru = 'Ошибка при выполнении хода. Подробности - в журнале регистрации.'"), "error");
			КонецПопытки;
		КонецЕсли;
		Итог = ЗавершитьХодДиалогаБезопасно(Результат, Диалог, НомерЗаменяемогоОтвета, ЭтоПродолжение,
			КлиентПрисоединён(ИдентификаторХода));
		ЗаписатьИтог(ИдентификаторХода, Итог);
		Следующий = СледующийХодОчереди(ИдентификаторХода, Диалог, ХодовПодряд, ИтоговыйСтатус(Результат, Итог));
		Если Следующий = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ИдентификаторХода = Следующий.ИдентификаторХода;
		Диалог = Следующий.Диалог;
		НомерЗаменяемогоОтвета = 0;
		ЭтоПродолжение = Ложь;
		ХодовПодряд = ХодовПодряд + 1;
		ТекущиеПараметры = Следующий.ПараметрыХода;
	КонецЦикла;

КонецПроцедуры

// Сохраняет ответ хода в диалог - единственный путь записи ответа чата (перенос из формы ИИА_Чат):
// предупреждения, ссылки на объекты в тексте, сноски источников, продолжение оборванного ответа, вложения,
// сохранение новой реплики или замена последнего ответа, выбор ответившей модели.
//
// Параметры:
//  ХодАгента - Структура - результат ИИА_Агент.ВыполнитьХод (меняется: текст оформляется).
//  Диалог - СправочникСсылка.ИИА_Диалоги
//  НомерОтвета - Число - заменяемый ответ (перегенерация, продолжение); 0 - новая реплика.
//  ЭтоПродолжение - Булево
//  КлиентПрисоединён - Булево - окно присоединено: ему записывается автооткрытие отчёта и объектов.
//
// Возвращаемое значение:
//  Структура:
//   * НомерСообщения - Число - реплика с ответом; 0 - ответ не сохранён.
//   * Ошибка - Строка - ответ не сохранён или ход завершился ошибкой.
//   * Заменен - Булево - заменён ответ НомерОтвета.
//   * ОткрытьПослеОтвета - Строка - JSON {report: индекс отчёта хода или -1, objects: индексы объектов, model}.
//
Функция ЗавершитьХодДиалога(ХодАгента, Диалог, НомерОтвета = 0, ЭтоПродолжение = Ложь, КлиентПрисоединён = Ложь) Экспорт

	Итог = Новый Структура("НомерСообщения, Ошибка, Заменен, ОткрытьПослеОтвета", 0, "", Ложь, "");
	// Остановленный или упавший ход с выполненными шагами сохраняется ответом с кнопкой «Продолжить». Неудачная
	// перегенерация или продолжение старый ответ не меняют.
	Если Не ХодАгента.Успех И (НомерОтвета > 0 Или ХодАгента.Шаги.Количество() = 0 Или Не ЗначениеЗаполнено(Диалог)) Тогда
		Итог.Ошибка = ХодАгента.Ошибка;
		Возврат Итог;
	КонецЕсли;

	Предупреждения = Новый Массив;
	Если Не ХодАгента.Успех Тогда
		Предупреждения.Добавить(ХодАгента.Ошибка);
		Итог.Ошибка = ХодАгента.Ошибка;
	КонецЕсли;
	Если ХодАгента.ЕстьЧужойТекст Тогда
		Предупреждения.Добавить(НСтр("ru = 'Ответ основан в том числе на тексте из данных базы: в нём найден фрагмент, похожий на инструкцию, он скрыт.'"));
	КонецЕсли;
	Если ХодАгента.Скрыто > 0 Тогда
		Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'Скрыто значений вне периметра (персональные, кадровые, зарплатные данные, секреты): %1.'"), ХодАгента.Скрыто));
	КонецЕсли;
	Если СвойствоХода(ХодАгента, "НаходкиФайлов").Количество() > 0 Тогда
		Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'В приложенных файлах скрыто перед отправкой модели: %1.'"),
			СтрСоединить(ХодАгента.НаходкиФайлов, ", ")));
	КонецЕсли;
	ХодАгента.Вставить("Предупреждение", СтрСоединить(Предупреждения, " "));
	// Навигационные ссылки, написанные в ответе: представления доступных объектов вместо адресов.
	РазборСсылок = ИИА_Инструменты.РазобратьНавигационныеСсылки(ХодАгента.Текст);
	ХодАгента.Текст = ИИА_Инструменты.ПодставитьОбъектыСсылок(РазборСсылок.Текст, РазборСсылок);
	КлассОтвета = ХодАгента.КлассДанных;
	Для Каждого Объект Из РазборСсылок.Объекты Цикл
		ХодАгента.Объекты.Добавить(Объект);
		КлассОтвета = Макс(КлассОтвета, Объект.Класс);
	КонецЦикла;

	// Продолжение дописывается к оборванному ответу: шаги, источники, ссылки объединяются, сноски продолжают нумерацию.
	Цитаты = Неопределено;
	ТекстДо = "";
	Если ЭтоПродолжение Тогда
		Ответ = ПоследнийОтветДиалога(Диалог, НомерОтвета);
		Если Ответ = Неопределено Тогда
			Итог.Ошибка = НСтр("ru = 'Продолжение не сохранено: в диалоге уже есть более новые реплики.'");
			Возврат Итог;
		КонецЕсли;
		Старый = ХодИзВложений(Ответ.Вложения);
		ОформитьСсылкиОбъектовХода(ХодАгента, Старый.СсылкиТекста.Количество());
		ДополнитьПродолжением(ХодАгента, Старый);
		Цитаты = Старый.Цитаты;
		ТекстДо = Ответ.Текст;
		КлассОтвета = Макс(КлассОтвета, Ответ.КлассДанных);
	Иначе
		ОформитьСсылкиОбъектовХода(ХодАгента, 0);
	КонецЕсли;
	Оформление = ИИА_ЧатВызовСервера.ОформитьСсылкиИсточников(ХодАгента.Текст, ХодАгента.Источники, Цитаты);
	ХодАгента.Текст = ТекстДо + Оформление.Текст;
	ХодАгента.Вставить("Цитаты", Оформление.Цитаты);
	ИдентификаторХода = "";
	ХодАгента.Свойство("ИдентификаторХода", ИдентификаторХода);

	// Ссылки, отчёты, таблицы, графики, черновики, формы, ход работы и источники хранятся с ответом: окно и история
	// показывают ответ таким же интерактивным.
	Вложения = ВложенияСообщения(ХодАгента);
	Открыть = Новый Структура("report, objects, model", -1, Новый Массив, "");
	ПрименитьЗаменуМодели(ХодАгента, Открыть);
	Если ХодАгента.Успех И КлиентПрисоединён Тогда
		Если ХодАгента.Свойство("Отчеты") И ХодАгента.Отчеты.Количество() > 0 Тогда
			Открыть.report = ХодАгента.Отчеты.ВГраница();
		КонецЕсли;
		Если ХодАгента.Свойство("ОткрытьОбъекты") Тогда
			Открыть.objects = ХодАгента.ОткрытьОбъекты;
		КонецЕсли;
	КонецЕсли;
	Итог.ОткрытьПослеОтвета = ОбщегоНазначения.ЗначениеВJSON(Открыть);
	Если НомерОтвета > 0 Тогда
		Попытка
			Обновлено = ИИА_Обслуживание.ОбновитьСообщение(Диалог, НомерОтвета, ХодАгента.Текст, ИдентификаторХода,
				КлассОтвета, Вложения);
		Исключение
			ЗаписьЖурналаРегистрации("ИИАссистент.Диалоги", УровеньЖурналаРегистрации.Ошибка, , ,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Обновлено = Ложь;
		КонецПопытки;
		Если Не Обновлено Тогда
			Итог.Ошибка = НСтр("ru = 'Ответ не заменён: он больше не последний в диалоге или диалог недоступен.'");
			Возврат Итог;
		КонецЕсли;
		Итог.НомерСообщения = НомерОтвета;
		Итог.Заменен = Истина;
	Иначе
		НомерСообщения = 0;
		ИИА_ЧатВызовСервера.СохранитьСообщение(Диалог, "assistant", ХодАгента.Текст, ИдентификаторХода,
			Неопределено, КлассОтвета, Вложения, , НомерСообщения);
		Итог.НомерСообщения = НомерСообщения;
		Если НомерСообщения = 0 Тогда
			Итог.Ошибка = НСтр("ru = 'Ответ не сохранён в диалоге. Подробности - в журнале регистрации.'");
		КонецЕсли;
	КонецЕсли;
	// Номер ответа и статус finishing - сразу после сохранения: ход, прерванный после этого, восстановление
	// не сохранит повторно частичным ответом.
	Если Итог.НомерСообщения > 0 И ЗначениеЗаполнено(ИдентификаторХода) Тогда
		ЗаписатьИтог(ИдентификаторХода, Итог);
	КонецЕсли;
	Возврат Итог;

КонецФункции

// История диалога для модели: текстовые реплики сохранённого диалога (ответы - без сносок, пустые ответы
// остановленных ходов пропускаются), последние десять - как у окна чата (см. ИИА_Обслуживание.ИсторияИзJSON).
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги
//
// Возвращаемое значение:
//  Массив из Структура - Роль, Текст, КлассДанных.
//
Функция ИсторияДиалогаДляМодели(Диалог) Экспорт

	Возврат ИИА_Обслуживание.ИсторияИзJSON(ИсторияДиалогаJSON(Диалог));

КонецФункции

// История диалога в JSON окна чата: массив role, text, class (см. ИсторияДиалогаДляМодели).
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги
//
// Возвращаемое значение:
//  Строка
//
Функция ИсторияДиалогаJSON(Диалог) Экспорт

	Записи = Новый Массив;
	Если ЗначениеЗаполнено(Диалог) Тогда
		Для Каждого Сообщение Из ИИА_Обслуживание.СообщенияДиалога(Диалог) Цикл
			Если Сообщение.Роль = "assistant" Тогда
				ТекстДляМодели = ИИА_ЧатВызовСервера.ТекстБезСносок(Сообщение.Текст);
				Если Не ПустаяСтрока(ТекстДляМодели) Тогда
					Записи.Добавить(Новый Структура("role, text, class", "assistant", ТекстДляМодели, Сообщение.КлассДанных));
				КонецЕсли;
			Иначе
				Записи.Добавить(Новый Структура("role, text, class", "user", Сообщение.Текст, Сообщение.КлассДанных));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат ОбщегоНазначения.ЗначениеВJSON(Записи);

КонецФункции

// Запускает фоновое задание хода с ключом пользователя: у пользователя одновременно только один ход.
// Канал хода ставится меткой в наименование задания (см. ИИА_Маскирование.КаналСеанса): без метки - http.
//
// Параметры:
//  ПараметрыХода - Структура - Канал ("chat" или "http", по умолчанию "http") и параметры хода.
//  АдресРезультата - Строка - адрес временного хранилища (канал http); пусто для chat.
//
// Возвращаемое значение:
//  ФоновоеЗадание - исключение, если задание не запущено.
//
Функция ЗапуститьЗадание(ПараметрыХода, АдресРезультата = "") Экспорт

	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(ПараметрыХода);
	ПараметрыЗадания.Добавить(АдресРезультата);
	Канал = "http";
	Если ПараметрыХода.Свойство("Канал") И ЗначениеЗаполнено(ПараметрыХода.Канал) Тогда
		Канал = ПараметрыХода.Канал;
	КонецЕсли;
	Возврат ФоновыеЗадания.Выполнить("ИИА_Агент.ВыполнитьХодВФоне", ПараметрыЗадания, КлючЗаданияПользователя(),
		НСтр("ru = 'ИИ-ассистент: ход агента'") + ИИА_Маскирование.МеткаКаналаЗадания(Канал));

КонецФункции

// Ключ фонового задания хода текущего пользователя.
//
// Возвращаемое значение:
//  Строка
//
Функция КлючЗаданияПользователя() Экспорт

	Возврат "ИИА_Ход_" + Строка(ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор);

КонецФункции

// Есть ли активное фоновое задание с ключом хода текущего пользователя.
//
// Возвращаемое значение:
//  Булево
//
Функция АктивноеЗаданиеКлюча() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Отбор = Новый Структура("Ключ, Состояние", КлючЗаданияПользователя(), СостояниеФоновогоЗадания.Активно);
	Возврат ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор).Количество() > 0;

КонецФункции

#КонецОбласти

#Область Обслуживание

// Удаляет завершённые состояния текущего пользователя, итог которых забран, и завершённые старше суток.
//
Процедура ОчиститьЗавершенные() Экспорт

	Граница = ТекущаяУниверсальнаяДата() - 86400;
	Для Каждого Запись Из ЗаписиПользователя() Цикл
		Если ХодЗавершен(Запись.Статус) И (Запись.ИтогПоказан Или Запись.Обновлено < Граница) Тогда
			УдалитьСостояние(Запись.ИдентификаторХода);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Очистка регистров ходов и очереди для регламентного задания ИИА_Очистка: состояния и очередь удаляемых
// диалогов и завершённые состояния всех пользователей старше суток.
//
// Параметры:
//  Диалоги - Массив из СправочникСсылка.ИИА_Диалоги - удаляемые диалоги.
//
Процедура ОчиститьРегистры(Диалоги) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	С.Пользователь КАК Пользователь,
	|	С.ИдентификаторХода КАК Идентификатор
	|ИЗ
	|	РегистрСведений.ИИА_СостоянияХодов КАК С
	|ГДЕ
	|	С.Диалог В(&Диалоги)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	С.Пользователь,
	|	С.ИдентификаторХода
	|ИЗ
	|	РегистрСведений.ИИА_СостоянияХодов КАК С
	|ГДЕ
	|	С.Статус В(&Завершенные)
	|	И С.Обновлено < &Граница
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	О.Пользователь КАК Пользователь,
	|	О.ИдентификаторЗаписи КАК Идентификатор
	|ИЗ
	|	РегистрСведений.ИИА_ОчередьСообщений КАК О
	|ГДЕ
	|	О.Диалог В (&Диалоги)");
	Запрос.УстановитьПараметр("Диалоги", Диалоги);
	Запрос.УстановитьПараметр("Завершенные", СтрРазделить(СтатусГотово() + "," + СтатусОстановлен() + "," + СтатусОшибка(), ","));
	Запрос.УстановитьПараметр("Граница", ТекущаяУниверсальнаяДата() - 86400);
	Пакет = Запрос.ВыполнитьПакет();
	Выборка = Пакет[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Набор = РегистрыСведений.ИИА_СостоянияХодов.СоздатьНаборЗаписей();
		Набор.Отбор.Пользователь.Установить(Выборка.Пользователь);
		Набор.Отбор.ИдентификаторХода.Установить(Выборка.Идентификатор);
		Набор.Записать();
	КонецЦикла;
	Выборка = Пакет[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Набор = РегистрыСведений.ИИА_ОчередьСообщений.СоздатьНаборЗаписей();
		Набор.Отбор.Пользователь.Установить(Выборка.Пользователь);
		Набор.Отбор.ИдентификаторЗаписи.Установить(Выборка.Идентификатор);
		Набор.Записать();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ВложенияОтвета

// Интерактивные части реплики для хранения с ней (ресурс Вложения): ссылки на объекты, отчёты, черновики,
// формы, таблицы, графики, предупреждение, файлы вопроса (docs - имена после текстового слоя, bfiles - ссылки на
// файлы базы), рецепты файлов ответа (afiles: данные с псевдонимами, без двоичных данных), ход работы (steps),
// источники (sources, cites), признак обрыва (stop), сохранённые варианты отчётов (configs). Значения уже прошли периметр; имена сотрудников -
// псевдонимами, как в тексте реплики. См. ХодИзВложений.
//
// Параметры:
//  Ход - Структура - ход агента (см. ИИА_Агент.ВыполнитьХод) или вложения вопроса: Объекты, Документы, Изображений,
//         ФайлыСохранены.
//  ТекстПоказа - Строка, Неопределено - текст вопроса для показа, если он отличается от сохраняемого.
//
// Возвращаемое значение:
//  Строка - JSON, пусто - хранить нечего.
//
Функция ВложенияСообщения(Ход, ТекстПоказа = Неопределено) Экспорт

	Данные = Новый Структура;
	Объекты = Новый Массив;
	Для Каждого Объект Из СвойствоХода(Ход, "Объекты") Цикл
		Объекты.Добавить(Новый Структура("text, link", Объект.Текст, Объект.Ссылка));
	КонецЦикла;
	ДобавитьВложение(Данные, "objects", Объекты);
	ДобавитьВложение(Данные, "reports", СвойствоХода(Ход, "Отчеты"));
	Черновики = Новый Массив;
	Изменения = Новый Массив;
	Для Каждого Действие Из СвойствоХода(Ход, "Действия") Цикл
		Если ЗначениеСвойства(Действие, "Вид") = "change" Тогда
			// Изменение: только идентификатор и заголовок с псевдонимами, строки «было/стало» - из регистра при показе.
			Изменения.Добавить(Новый Структура("action, title", Действие.Идентификатор, Действие.Заголовок));
			Продолжить;
		КонецЕсли;
		Черновики.Добавить(Новый Структура("action, title, lines, warning", Действие.Идентификатор, Действие.Заголовок,
			Действие.Строки, Действие.Предупреждение));
	КонецЦикла;
	ДобавитьВложение(Данные, "drafts", Черновики);
	ДобавитьВложение(Данные, "changes", Изменения);
	ДобавитьВложение(Данные, "forms", СвойствоХода(Ход, "Формы"));
	Таблицы = Новый Массив;
	Для Каждого Таблица Из СвойствоХода(Ход, "Таблицы") Цикл
		Таблицы.Добавить(Новый Структура("title, columns, rows, cells", Таблица.Заголовок, Таблица.Колонки,
			Таблица.Строки, ?(Таблица.Свойство("ОбъектыЯчеек"), Таблица.ОбъектыЯчеек, Новый Массив)));
	КонецЦикла;
	ДобавитьВложение(Данные, "tables", Таблицы);
	ДобавитьВложение(Данные, "charts", СвойствоХода(Ход, "Графики"));
	ДобавитьВложение(Данные, "docs", СвойствоХода(Ход, "Документы"));
	ДобавитьВложение(Данные, "bfiles", СвойствоХода(Ход, "ФайлыБазы"));
	ДобавитьВложение(Данные, "afiles", СвойствоХода(Ход, "ФайлыОтвета"));
	ДобавитьВложение(Данные, "steps", СвойствоХода(Ход, "Шаги"));
	ДобавитьВложение(Данные, "sources", СвойствоХода(Ход, "Источники"));
	ДобавитьВложение(Данные, "cites", СвойствоХода(Ход, "Цитаты"));
	ДобавитьВложение(Данные, "configs", СвойствоХода(Ход, "НастроенныеВарианты"));
	ДобавитьВложение(Данные, "links", СвойствоХода(Ход, "СсылкиТекста"));
	ДобавитьВложение(Данные, "meta", СвойствоХода(Ход, "МетаданныеХода"));
	Если Ход.Свойство("Обрыв") И Не ПустаяСтрока(Ход.Обрыв) Тогда
		Данные.Вставить("stop", Ход.Обрыв);
	КонецЕсли;
	Если Ход.Свойство("Предупреждение") И Не ПустаяСтрока(Ход.Предупреждение) Тогда
		Данные.Вставить("warning", Ход.Предупреждение);
	КонецЕсли;
	Если Ход.Свойство("Изображений") И Ход.Изображений > 0 Тогда
		Данные.Вставить("shots", Ход.Изображений);
	КонецЕсли;
	Если Ход.Свойство("ФайлыСохранены") И Ход.ФайлыСохранены Тогда
		Данные.Вставить("files", Истина);
	КонецЕсли;
	Если ТекстПоказа <> Неопределено Тогда
		Данные.Вставить("text", ТекстПоказа);
	КонецЕсли;
	Возврат ?(Данные.Количество() = 0, "", ОбщегоНазначения.ЗначениеВJSON(Данные));

КонецФункции

// Ход из сохранённых вложений реплики в том виде, который возвращает ход агента (см. ВложенияСообщения).
//
// Параметры:
//  Вложения - Строка - JSON ресурса Вложения.
//
// Возвращаемое значение:
//  Структура - Объекты, Отчеты, Действия, Формы, Таблицы, Графики, Предупреждение, Документы, Изображений,
//              Текст (Неопределено - текст показа не хранился), ФайлыСохранены (Ложь - реплика сохранена без файлов,
//              в том числе до их хранения), Шаги, Источники (Массив из Соответствие), Цитаты (Массив из Строка),
//              Обрыв (Строка), НастроенныеВарианты (Массив из Соответствие), СсылкиТекста, МетаданныеХода,
//              ФайлыБазы (Массив из Соответствие - name, link), ФайлыОтвета (Массив из Соответствие - рецепты).
//              Записи без новых ключей - пустые значения.
//
Функция ХодИзВложений(Вложения) Экспорт

	Ход = Новый Структура("Объекты, Отчеты, Действия, Формы, Таблицы, Графики, Предупреждение, Документы, Изображений, "
		+ "Текст, ФайлыСохранены, Шаги, Источники, Цитаты, Обрыв, НастроенныеВарианты, СсылкиТекста, МетаданныеХода, "
		+ "ФайлыБазы, ФайлыОтвета",
		Новый Массив, Новый Массив, Новый Массив, Новый Массив, Новый Массив, Новый Массив, "", Новый Массив, 0,
		Неопределено, Ложь, Новый Массив, Новый Массив, Новый Массив, "", Новый Массив, Новый Массив, Новый Массив,
		Новый Массив, Новый Массив);
	Если ПустаяСтрока(Вложения) Тогда
		Возврат Ход;
	КонецЕсли;
	Попытка
		Данные = ОбщегоНазначения.JSONВЗначение(Вложения);
	Исключение
		// Повреждённые вложения: реплика показывается без интерактивных частей.
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ход;
	КонецПопытки;
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Ход;
	КонецЕсли;

	Для Каждого Объект Из МассивВложения(Данные, "objects") Цикл
		Ход.Объекты.Добавить(Новый Структура("Текст, Ссылка", Строка(Объект.Получить("text")),
			Строка(Объект.Получить("link"))));
	КонецЦикла;
	Для Каждого Отчет Из МассивВложения(Данные, "reports") Цикл
		Запись = Новый Структура;
		Для Каждого Свойство Из Отчет Цикл
			Попытка
				Запись.Вставить(Свойство.Ключ, Свойство.Значение);
			// Ключ не может быть именем свойства структуры - отчёт его не использует.
			Исключение // BSLLS:MissingCodeTryCatchEx-off
				Продолжить;
			КонецПопытки;
		КонецЦикла;
		Для Каждого Имя Из СтрРазделить("НачалоПериода,КонецПериода", ",") Цикл
			Если Запись.Свойство(Имя) Тогда
				Запись[Имя] = ДатаВложения(Запись[Имя]);
			КонецЕсли;
		КонецЦикла;
		Если Запись.Свойство("Вид") И Запись.Свойство("Заголовок") Тогда
			Ход.Отчеты.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Черновик Из МассивВложения(Данные, "drafts") Цикл
		Строки = Черновик.Получить("lines");
		Ход.Действия.Добавить(Новый Структура("Идентификатор, Заголовок, Строки, Предупреждение",
			Строка(Черновик.Получить("action")), Строка(Черновик.Получить("title")),
			?(ТипЗнч(Строки) = Тип("Массив"), Строки, Новый Массив), Строка(Черновик.Получить("warning"))));
	КонецЦикла;
	Для Каждого Изменение Из МассивВложения(Данные, "changes") Цикл
		Ход.Действия.Добавить(Новый Структура("Идентификатор, Заголовок, Строки, Предупреждение, Вид",
			Строка(Изменение.Получить("action")), Строка(Изменение.Получить("title")), Новый Массив, "", "change"));
	КонецЦикла;
	Для Каждого Форма Из МассивВложения(Данные, "forms") Цикл
		Шаги = Форма.Получить("Шаги");
		Ход.Формы.Добавить(Новый Структура("ПолноеИмяФормы, Элемент, ДанныеXML, Заголовок, Шаги",
			Строка(Форма.Получить("ПолноеИмяФормы")), Строка(Форма.Получить("Элемент")),
			Строка(Форма.Получить("ДанныеXML")), Строка(Форма.Получить("Заголовок")),
			?(ТипЗнч(Шаги) = Тип("Массив"), Шаги, Новый Массив)));
	КонецЦикла;
	Для Каждого Таблица Из МассивВложения(Данные, "tables") Цикл
		Колонки = Таблица.Получить("columns");
		Строки = Таблица.Получить("rows");
		Ячейки = Таблица.Получить("cells");
		Ход.Таблицы.Добавить(Новый Структура("Заголовок, Колонки, Строки, ОбъектыЯчеек", Строка(Таблица.Получить("title")),
			?(ТипЗнч(Колонки) = Тип("Массив"), Колонки, Новый Массив), ?(ТипЗнч(Строки) = Тип("Массив"), Строки, Новый Массив),
			?(ТипЗнч(Ячейки) = Тип("Массив"), Ячейки, Новый Массив)));
	КонецЦикла;
	Ход.Графики = МассивВложения(Данные, "charts");
	Для Каждого Имя Из МассивВложения(Данные, "docs", Ложь) Цикл
		Ход.Документы.Добавить(Строка(Имя));
	КонецЦикла;
	Ход.Предупреждение = Строка(Данные.Получить("warning"));
	Если ТипЗнч(Данные.Получить("shots")) = Тип("Число") Тогда
		Ход.Изображений = Данные.Получить("shots");
	КонецЕсли;
	Ход.ФайлыСохранены = Данные.Получить("files") = Истина;
	Если ТипЗнч(Данные.Получить("text")) = Тип("Строка") Тогда
		Ход.Текст = Данные.Получить("text");
	КонецЕсли;
	Ход.Шаги = МассивВложения(Данные, "steps");
	Ход.Источники = МассивВложения(Данные, "sources");
	Для Каждого Ключ Из МассивВложения(Данные, "cites", Ложь) Цикл
		Ход.Цитаты.Добавить(Строка(Ключ));
	КонецЦикла;
	Если ТипЗнч(Данные.Получить("stop")) = Тип("Строка") Тогда
		Ход.Обрыв = Данные.Получить("stop");
	КонецЕсли;
	Ход.НастроенныеВарианты = МассивВложения(Данные, "configs");
	// Цели ссылок перепроверяются при регистрации; здесь только восстанавливается их вид.
	Для Каждого Ссылка Из МассивВложения(Данные, "links") Цикл
		Ход.СсылкиТекста.Добавить(Новый Структура("kind, ref, name, field, text", Строка(Ссылка.Получить("kind")),
			Ссылка.Получить("ref"), Строка(Ссылка.Получить("name")), Строка(Ссылка.Получить("field")),
			Строка(Ссылка.Получить("text"))));
	КонецЦикла;
	Ход.ФайлыБазы = МассивВложения(Данные, "bfiles");
	Ход.ФайлыОтвета = МассивВложения(Данные, "afiles");
	Для Каждого Запись Из МассивВложения(Данные, "meta") Цикл
		Ход.МетаданныеХода.Добавить(Новый Структура("name, text", Строка(Запись.Получить("name")),
			Строка(Запись.Получить("text"))));
	КонецЦикла;
	Возврат Ход;

КонецФункции

// Дописывает к ходу продолжения части оборванного ответа (ход старого ответа - первым): индексы объектов и отчётов
// в источниках, ячейках таблиц и открываемых объектах продолжения сдвигаются на длину старых массивов.
//
// Параметры:
//  Ход - Структура - ход агента (см. ИИА_Агент.ВыполнитьХод).
//  Старый - Структура - см. ХодИзВложений.
//
Процедура ДополнитьПродолжением(Ход, Старый) Экспорт

	СдвигОбъектов = Старый.Объекты.Количество();
	СдвигОтчетов = Старый.Отчеты.Количество();
	Источники = Новый Массив;
	Для Каждого Источник Из Ход.Источники Цикл
		Вид = ЗначениеСвойства(Источник, "kind");
		Ссылка = ЗначениеСвойства(Источник, "ref");
		Если (Вид = "object" Или Вид = "report") И ТипЗнч(Ссылка) = Тип("Число") Тогда
			Источники.Добавить(Новый Структура("key, kind, ref", ЗначениеСвойства(Источник, "key"), Вид,
				Ссылка + ?(Вид = "object", СдвигОбъектов, СдвигОтчетов)));
		Иначе
			Источники.Добавить(Источник);
		КонецЕсли;
	КонецЦикла;
	Ход.Источники = Источники;
	Для Каждого Таблица Из Ход.Таблицы Цикл
		Если Не Таблица.Свойство("ОбъектыЯчеек") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ИндексыСтроки Из Таблица.ОбъектыЯчеек Цикл
			Для Номер = 0 По ИндексыСтроки.ВГраница() Цикл
				Если ТипЗнч(ИндексыСтроки[Номер]) = Тип("Число") Тогда
					ИндексыСтроки[Номер] = ИндексыСтроки[Номер] + СдвигОбъектов;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Если Ход.Свойство("ОткрытьОбъекты") Тогда
		Для Номер = 0 По Ход.ОткрытьОбъекты.ВГраница() Цикл
			Ход.ОткрытьОбъекты[Номер] = Ход.ОткрытьОбъекты[Номер] + СдвигОбъектов;
		КонецЦикла;
	КонецЕсли;
	Для Каждого Ссылка Из СвойствоХода(Ход, "СсылкиТекста") Цикл
		Если ТипЗнч(ЗначениеСвойства(Ссылка, "ref")) = Тип("Число") Тогда
			Ссылка.ref = Ссылка.ref + СдвигОбъектов;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("Объекты,Отчеты,Действия,Формы,Таблицы,Графики,Шаги,Источники,НастроенныеВарианты", ",") Цикл
		Объединение = Новый Массив;
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Объединение, Старый[Имя]);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Объединение, Ход[Имя]);
		Ход[Имя] = Объединение;
	КонецЦикла;
	// Файлы ответа продолжения нумеруются после файлов оборванного ответа: маркеры [[file:aN]] - тоже; номер
	// таблицы ответа в рецепте сдвигается на таблицы оборванного ответа (таблицы уже объединены выше).
	СдвигТаблиц = Старый.Таблицы.Количество();
	ФайлыПродолжения = СвойствоХода(Ход, "ФайлыОтвета");
	Для Индекс = -ФайлыПродолжения.ВГраница() По 0 Цикл
		Рецепт = ФайлыПродолжения[-Индекс];
		НомерТаблицы = ЗначениеСвойства(Рецепт, "table");
		Если ТипЗнч(НомерТаблицы) = Тип("Число") И НомерТаблицы >= 0 Тогда
			Рецепт.table = НомерТаблицы + СдвигТаблиц;
		КонецЕсли;
		Ид = "a" + Формат(Старый.ФайлыОтвета.Количество() - Индекс + 1, "ЧГ=");
		Ход.Текст = СтрЗаменить(Ход.Текст, "[[file:" + Рецепт.id + "]]", "[[file:" + Ид + "]]");
		Рецепт.id = Ид;
	КонецЦикла;
	// Ссылок текста, метаданных и файлов ответа может не быть у прерванного хода.
	Для Каждого Имя Из СтрРазделить("СсылкиТекста,МетаданныеХода,ФайлыОтвета", ",") Цикл
		Объединение = Новый Массив;
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Объединение, Старый[Имя]);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Объединение, СвойствоХода(Ход, Имя));
		Ход.Вставить(Имя, Объединение);
	КонецЦикла;

КонецПроцедуры

// Оформляет разметку ссылок модели в тексте хода (см. ИИА_ЧатВызовСервера.ОформитьСсылкиОбъектов): текст получает
// ссылки [текст](#k), ход - свойство СсылкиТекста.
//
// Параметры:
//  ХодАгента - Структура
//  Начало - Число - число ссылок уже сохранённой части ответа.
//
Процедура ОформитьСсылкиОбъектовХода(ХодАгента, Начало) Экспорт

	Оформление = ИИА_ЧатВызовСервера.ОформитьСсылкиОбъектов(ХодАгента.Текст, ХодАгента.Объекты, Начало);
	ХодАгента.Текст = Оформление.Текст;
	ХодАгента.Вставить("СсылкиТекста", Оформление.Ссылки);

КонецПроцедуры


// Последняя реплика диалога, если это ответ ассистента с номером НомерОтвета.
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги
//  НомерОтвета - Число
//
// Возвращаемое значение:
//  Структура, Неопределено - реплика (см. ИИА_Обслуживание.СообщенияДиалога); Неопределено - последняя реплика другая.
//
Функция ПоследнийОтветДиалога(Диалог, НомерОтвета) Экспорт

	Если Не ЗначениеЗаполнено(Диалог) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Сообщения = ИИА_Обслуживание.СообщенияДиалога(Диалог);
	Если Сообщения.Количество() = 0 Или Сообщения[Сообщения.ВГраница()].НомерСообщения <> НомерОтвета
		Или Сообщения[Сообщения.ВГраница()].Роль <> "assistant" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Сообщения[Сообщения.ВГраница()];

КонецФункции

// Массив-свойство хода агента; нет свойства или оно не массив - пустой массив.
//
// Параметры:
//  Ход - Структура
//  Имя - Строка
//
// Возвращаемое значение:
//  Массив
//
Функция СвойствоХода(Ход, Имя) Экспорт

	Значение = Неопределено;
	Если Ход.Свойство(Имя, Значение) И ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Новый Массив;

КонецФункции

// Свойство элемента вложений: Структура (ход агента) или Соответствие (прочитанный JSON).
//
// Параметры:
//  Значение - Структура, Соответствие, Произвольный
//  Имя - Строка
//
// Возвращаемое значение:
//  Произвольный - Неопределено, если свойства нет.
//
Функция ЗначениеСвойства(Значение, Имя) Экспорт

	Результат = Неопределено;
	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Результат = Значение.Получить(Имя);
	ИначеЕсли ТипЗнч(Значение) = Тип("Структура") Тогда
		Значение.Свойство(Имя, Результат);
	КонецЕсли;
	Возврат Результат;

КонецФункции

