#Область Регистры

Процедура ЗаблокироватьСостояние(Пользователь, ИдентификаторХода)

	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.ИИА_СостоянияХодов");
	Элемент.УстановитьЗначение("Пользователь", Пользователь);
	Элемент.УстановитьЗначение("ИдентификаторХода", ИдентификаторХода);
	Блокировка.Заблокировать();

КонецПроцедуры

Процедура ЗаблокироватьОчередь(Пользователь)

	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.ИИА_ОчередьСообщений");
	Элемент.УстановитьЗначение("Пользователь", Пользователь);
	Блокировка.Заблокировать();

КонецПроцедуры

Функция МенеджерСостояния(Пользователь, ИдентификаторХода)

	Запись = РегистрыСведений.ИИА_СостоянияХодов.СоздатьМенеджерЗаписи();
	Запись.Пользователь = Пользователь;
	Запись.ИдентификаторХода = ИдентификаторХода;
	Запись.Прочитать();
	Возврат Запись;

КонецФункции

// Меняет поля состояния хода текущего пользователя под управляемой блокировкой записи: запись шагов заданием
// и отметка опроса окном не теряют изменения друг друга.
//  ТолькоСтатусы - Строка, Неопределено - менять, только если текущий статус в списке через запятую.
//  ОтметитьИзменение - Булево - обновить Обновлено. Ложь - для отметок окна и флага остановки: по Обновлено
//    ход без идентификатора задания признаётся осиротевшим, опрос окна не должен продлевать ему жизнь.
// Возвращает Истина, если запись изменена.
Функция ИзменитьСостояние(ИдентификаторХода, Изменения, ТолькоСтатусы = Неопределено, ОтметитьИзменение = Истина)

	Пользователь = Пользователи.ТекущийПользователь();
	УстановитьПривилегированныйРежим(Истина);
	Изменено = Ложь;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьСостояние(Пользователь, ИдентификаторХода);
		Запись = МенеджерСостояния(Пользователь, ИдентификаторХода);
		Изменено = Запись.Выбран() И (ТолькоСтатусы = Неопределено
			Или СтрРазделить(ТолькоСтатусы, ",").Найти(Запись.Статус) <> Неопределено);
		Если Изменено Тогда
			ЗаполнитьЗначенияСвойств(Запись, Изменения);
			Если ОтметитьИзменение Тогда
				Запись.Обновлено = ТекущаяУниверсальнаяДата();
			КонецЕсли;
			Запись.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Изменено;

КонецФункции

// Поля состояния хода текущего пользователя; Неопределено - записи нет.
//  СПромежуточным - Булево - прочитать промежуточный результат (ХранилищеЗначения).
Функция ДанныеСостояния(ИдентификаторХода, СПромежуточным = Истина)

	УстановитьПривилегированныйРежим(Истина);
	Запись = МенеджерСостояния(Пользователи.ТекущийПользователь(), ИдентификаторХода);
	Если Не Запись.Выбран() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Данные = Новый Структура("Диалог, ИдентификаторЗадания, Статус, Канал, ЗапросОстановки, ОкноОпрос, ОкноОтсоединено, "
		+ "НомерЗаменяемогоОтвета, ЭтоПродолжение, ХодовПодряд, НомерОтвета, Ошибка, Начало, Обновлено");
	ЗаполнитьЗначенияСвойств(Данные, Запись);
	Если СПромежуточным Тогда
		Данные.Вставить("ПромежуточныйРезультат", Запись.ПромежуточныйРезультат.Получить());
	КонецЕсли;
	Возврат Данные;

КонецФункции

// Состояния ходов текущего пользователя без хранилищ значений.
Функция ЗаписиПользователя()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	С.ИдентификаторХода КАК ИдентификаторХода,
	|	С.Диалог КАК Диалог,
	|	С.ИдентификаторЗадания КАК ИдентификаторЗадания,
	|	С.Статус КАК Статус,
	|	С.Начало КАК Начало,
	|	С.Обновлено КАК Обновлено,
	|	С.ПоследнийСтатус КАК ПоследнийСтатус,
	|	С.Шаги КАК Шаги,
	|	С.Канал КАК Канал,
	|	С.ЗапросОстановки КАК ЗапросОстановки,
	|	С.ОкноОпрос КАК ОкноОпрос,
	|	С.ОкноОтсоединено КАК ОкноОтсоединено,
	|	С.НомерЗаменяемогоОтвета КАК НомерЗаменяемогоОтвета,
	|	С.ЭтоПродолжение КАК ЭтоПродолжение,
	|	С.НомерОтвета КАК НомерОтвета,
	|	С.Ошибка КАК Ошибка,
	|	С.ИтогПоказан КАК ИтогПоказан
	|ИЗ
	|	РегистрСведений.ИИА_СостоянияХодов КАК С
	|ГДЕ
	|	С.Пользователь = &Пользователь");
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выгрузить();

КонецФункции

Функция ЕстьЖдущиеПользователя()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	О.ИдентификаторЗаписи КАК ИдентификаторЗаписи
	|ИЗ
	|	РегистрСведений.ИИА_ОчередьСообщений КАК О
	|ГДЕ
	|	О.Пользователь = &Пользователь
	|	И О.Статус = &Статус");
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	Запрос.УстановитьПараметр("Статус", СтатусОжидает());
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	Возврат Не РезультатЗапроса.Пустой();

КонецФункции

// Ждущие сообщения без активного хода и задания пользователя никто не отправит: под блокировкой очереди они
// переводятся в отложенные «Ответ прерван». Возвращает Истина, если перевод выполнен.
Функция ОтложитьЖдущиеБезХода()

	Пользователь = Пользователи.ТекущийПользователь();
	УстановитьПривилегированныйРежим(Истина);
	Отложено = Ложь;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьОчередь(Пользователь);
		Если Не ЕстьАктивныйХод() И Не АктивноеЗаданиеКлюча() Тогда
			ПеревестиВОтложенные(НСтр("ru = 'Ответ прерван'"));
			Отложено = Истина;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Отложено;

КонецФункции

// Меняет статус записей очереди пользователя (диалога, если задан) со СтатусБыл на СтатусСтал.
Процедура ИзменитьСтатусОчереди(Пользователь, Диалог, СтатусБыл, СтатусСтал, Причина)

	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьОчередь(Пользователь);
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	О.ИдентификаторЗаписи КАК ИдентификаторЗаписи
		|ИЗ
		|	РегистрСведений.ИИА_ОчередьСообщений КАК О
		|ГДЕ
		|	О.Пользователь = &Пользователь
		|	И О.Статус = &Статус");
		Если ЗначениеЗаполнено(Диалог) Тогда
			Запрос.Текст = Запрос.Текст + "
			|	И О.Диалог = &Диалог";
			Запрос.УстановитьПараметр("Диалог", Диалог);
		КонецЕсли;
		Запрос.УстановитьПараметр("Пользователь", Пользователь);
		Запрос.УстановитьПараметр("Статус", СтатусБыл);
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Запись = РегистрыСведений.ИИА_ОчередьСообщений.СоздатьМенеджерЗаписи();
			Запись.Пользователь = Пользователь;
			Запись.ИдентификаторЗаписи = Выборка.ИдентификаторЗаписи;
			Запись.Прочитать();
			Если Запись.Выбран() Тогда
				Запись.Статус = СтатусСтал;
				Запись.Причина = Лев(Причина, 300);
				Запись.Записать();
			КонецЕсли;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Объекты ссылок записи очереди (JSON) дописываются в Объекты без повторов по навигационной ссылке.
Процедура ДобавитьОбъектыОчереди(Объекты, ОбъектыJSON)

	Если ПустаяСтрока(ОбъектыJSON) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Данные = ОбщегоНазначения.JSONВЗначение(ОбъектыJSON);
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Объект Из Данные Цикл
		Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Ссылка = Строка(Объект.Получить("Ссылка"));
		Повтор = Ложь;
		Для Каждого Добавленный Из Объекты Цикл
			Если Добавленный.Ссылка = Ссылка Тогда
				Повтор = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не Повтор Тогда
			Класс = Объект.Получить("Класс");
			Объекты.Добавить(Новый Структура("Текст, Ссылка, Класс", Строка(Объект.Получить("Текст")), Ссылка,
				?(ТипЗнч(Класс) = Тип("Число"), Класс, 1)));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Опрос

// Описание хода для окна (см. СостояниеДиалога, свойство Ход).
Функция ОписаниеХода(Запись, ИдентификаторХода, ПоказаноШагов)

	Ход = Новый Структура("ИдентификаторХода, Статус, Шаги, ВсегоШагов, ПоследнийСтатус, ИтогГотов, НомерОтвета, "
		+ "НомерЗаменяемогоОтвета, Ошибка, ЗапросОстановки",
		Запись.ИдентификаторХода, Запись.Статус, Новый Массив, 0, Запись.ПоследнийСтатус, ИтогГотов(Запись),
		Запись.НомерОтвета, Запись.НомерЗаменяемогоОтвета, Запись.Ошибка, Запись.ЗапросОстановки);
	Шаги = Неопределено;
	Если Не ПустаяСтрока(Запись.Шаги) Тогда
		Попытка
			Шаги = ОбщегоНазначения.JSONВЗначение(Запись.Шаги);
		Исключение
			// Повреждённые шаги не показываются, ход продолжается.
			ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Шаги = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если ТипЗнч(Шаги) = Тип("Массив") Тогда
		Ход.ВсегоШагов = Шаги.Количество();
		Начало = ?(Запись.ИдентификаторХода = ИдентификаторХода, ПоказаноШагов, 0);
		Для Индекс = Начало По Шаги.ВГраница() Цикл
			Ход.Шаги.Добавить(Шаги[Индекс]);
		КонецЦикла;
	КонецЕсли;
	Возврат Ход;

КонецФункции

// Состояние паузы хода текущего пользователя; Неопределено - паузы нет.
Функция ПаузаХода(ИдентификаторХода)

	УстановитьПривилегированныйРежим(Истина);
	Менеджер = МенеджерСостояния(Пользователи.ТекущийПользователь(), ИдентификаторХода);
	Пауза = ?(Менеджер.Выбран(), Менеджер.Пауза.Получить(), Неопределено);
	Возврат ?(ТипЗнч(Пауза) = Тип("Структура"), Пауза, Неопределено);

КонецФункции

Процедура ОтметитьОпросОкна(Запись)

	// Отметка не чаще раза в 3 с: окно считается присоединённым, пока опрос был не дольше 5 с назад.
	Если Запись.ОкноОтсоединено Или ТекущаяУниверсальнаяДата() - Запись.ОкноОпрос >= 3 Тогда
		ПрисоединитьОкно(Запись.ИдентификаторХода);
	КонецЕсли;

КонецПроцедуры

Функция НаименованиеДиалога(Диалог)

	Если Не ЗначениеЗаполнено(Диалог) Тогда
		Возврат "";
	КонецЕсли;
	// Диалог - из своих состояний ходов (отбор по пользователю); справочник диалогов - служебный, без прав у роли
	// ИИА_Пользователь: наименование читается привилегированно.
	УстановитьПривилегированныйРежим(Истина);
	Наименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Диалог, "Наименование");
	УстановитьПривилегированныйРежим(Ложь);
	Возврат ИИА_Маскирование.ДляПользователя(Строка(Наименование), Диалог, Ложь);

КонецФункции

#КонецОбласти

#Область ЦиклОчереди

// Один ход агента по параметрам задания или возобновления.
Функция ВыполнитьОдинХод(ПараметрыХода, ИдентификаторХода)

	СтруктурыФорм = Неопределено;
	ПараметрыХода.Свойство("СтруктурыФорм", СтруктурыФорм);
	Возобновление = Неопределено;
	ПараметрыХода.Свойство("Возобновление", Возобновление);
	Дополнительно = Новый Структура("Канал, ИдентификаторХода, СтруктурыФорм, Возобновление", КаналЧата(),
		ИдентификаторХода, СтруктурыФорм, Возобновление);
	Если Возобновление <> Неопределено Тогда
		Дополнительно.СтруктурыФорм = Возобновление.СтруктурыФорм;
		Возврат ИИА_Агент.ВыполнитьХод(Новый Массив, "", Возобновление.Контекст, , Возобновление.Диалог, ,
			Возобновление.Модель, , , "", Дополнительно);
	КонецЕсли;
	Значения = Новый Структура("История, ТекстПользователя, Контекст, Изображения, Диалог, Документы, Модель, ОбъектыВопроса, Продолжение");
	ЗаполнитьЗначенияСвойств(Значения, ПараметрыХода);
	Возврат ИИА_Агент.ВыполнитьХод(?(Значения.История = Неопределено, Новый Массив, Значения.История),
		Строка(Значения.ТекстПользователя), Значения.Контекст, Значения.Изображения, Значения.Диалог, Значения.Документы,
		Значения.Модель, Значения.ОбъектыВопроса, Значения.Продолжение, "", Дополнительно);

КонецФункции

// Ход завершён: выбирает следующий ход очереди под блокировкой очереди пользователя и ставит окончательный
// статус текущего хода. Отказ (Стоп, лимиты, слоты, пятый ход подряд) переводит ждущие в held с причиной.
// Возвращает Неопределено или Структура - ИдентификаторХода, Диалог, ПараметрыХода.
Функция СледующийХодОчереди(ИдентификаторХода, Диалог, ХодовПодряд, ИтоговыйСтатус)

	Пользователь = Пользователи.ТекущийПользователь();
	Остановка = ИтоговыйСтатус = СтатусОстановлен() Или ОстановкаЗапрошена(ИдентификаторХода);
	Отказ = "";
	Если Не Остановка Тогда
		Отказ = ИИА_ЧатВызовСервера.ПричинаОтказаОчереди();
	КонецЕсли;
	Решение = РешениеЦиклаОчереди(ХодовПодряд, Остановка, Отказ, СлотыЗаняты());
	Задание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();

	УстановитьПривилегированныйРежим(Истина);
	Следующий = Неопределено;
	Сообщение = Неопределено;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьОчередь(Пользователь);
		ИзменитьСостояние(ИдентификаторХода, Новый Структура("Статус", ИтоговыйСтатус));
		// Флаг перечитывается после окончательного статуса под блокировкой: позже «Стоп» его уже не поставит.
		Если Решение.Продолжать И ОстановкаЗапрошена(ИдентификаторХода) Тогда
			Решение = РешениеЦиклаОчереди(ХодовПодряд, Истина, "", Ложь);
		КонецЕсли;
		ДиалогОчереди = СледующийДиалогОчереди(Диалог);
		Если ДиалогОчереди <> Неопределено И Не Решение.Продолжать Тогда
			ПеревестиВОтложенные(Решение.Причина);
		ИначеЕсли ДиалогОчереди <> Неопределено Тогда
			Сообщение = ВзятьОчередьДиалога(ДиалогОчереди);
		КонецЕсли;
		Если Сообщение <> Неопределено Тогда
			Следующий = Новый Структура("ИдентификаторХода, Диалог, ПараметрыХода", Строка(Новый УникальныйИдентификатор),
				ДиалогОчереди, Неопределено);
			НачатьХод(Следующий.ИдентификаторХода, ДиалогОчереди,
				?(Задание = Неопределено, "", Строка(Задание.УникальныйИдентификатор)), 0, Ложь, ХодовПодряд + 1);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Если Следующий = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Вопрос = СохранитьВопросОчереди(ДиалогОчереди, Сообщение);
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВернутьВОчередь(Сообщение.Идентификаторы, СтатусОтложено(),
			НСтр("ru = 'Сообщение не отправлено: ошибка сохранения'"));
		ИзменитьСостояние(Следующий.ИдентификаторХода, Новый Структура("Статус, Ошибка, ИтогПоказан",
			СтатусОшибка(), "", Истина));
		Возврат Неопределено;
	КонецПопытки;
	УдалитьОтправленные(Сообщение.Идентификаторы);
	Следующий.ПараметрыХода = Новый Структура("История, ТекстПользователя, Контекст, Изображения, Диалог, Документы, "
		+ "Модель, ОбъектыВопроса, Продолжение, СтруктурыФорм", Вопрос.История, Лев(Сообщение.Текст, 8000), Вопрос.Контекст,
		Новый Массив, ДиалогОчереди, Новый Массив, ИИА_ЧатВызовСервера.ВыбраннаяМодель(), Вопрос.ОбъектыВопроса,
		Неопределено, Новый Соответствие);
	Возврат Следующий;

КонецФункции

// Сохраняет склеенное сообщение очереди репликой пользователя. История модели берётся до этой реплики.
// Возвращает Структура - История, Контекст, ОбъектыВопроса, НомерСообщения.
Функция СохранитьВопросОчереди(Диалог, Сообщение)

	Вопрос = Новый Структура("История, Контекст, ОбъектыВопроса, НомерСообщения",
		ИсторияДиалогаДляМодели(Диалог), ИИА_ЧатВызовСервера.КонтекстДиалога(Диалог), Новый Массив, 0);
	Объекты = Новый Массив;
	Для Каждого Объект Из Сообщение.Объекты Цикл
		Ссылка = ИИА_Инструменты.СсылкаПоНавигационнойСсылке(Объект.Ссылка);
		Если Ссылка <> Неопределено Тогда
			Вопрос.ОбъектыВопроса.Добавить(Ссылка);
		КонецЕсли;
		Объекты.Добавить(Новый Структура("Текст, Ссылка", Объект.Текст, Объект.Ссылка));
	КонецЦикла;
	ВложенияВопроса = Новый Структура("Объекты, Документы, Изображений, ФайлыСохранены", Объекты, Новый Массив, 0, Ложь);
	НомерСообщения = 0;
	ИИА_Обслуживание.СохранитьСообщение(Диалог, "user", Сообщение.Текст, "", Вопрос.Контекст, Сообщение.КлассДанных,
		ВложенияСообщения(ВложенияВопроса), , НомерСообщения);
	Вопрос.НомерСообщения = НомерСообщения;
	Возврат Вопрос;

КонецФункции

// Лимит одновременных ответов на базу без учёта своего задания.
Функция СлотыЗаняты()

	УстановитьПривилегированныйРежим(Истина);
	Лимит = Константы.ИИА_МаксимумОдновременныхХодов.Получить();
	Если Лимит <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Своё = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	Отбор = Новый Структура("ИмяМетода, Состояние", "ИИА_Агент.ВыполнитьХодВФоне", СостояниеФоновогоЗадания.Активно);
	Количество = 0;
	Для Каждого Задание Из ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор) Цикл
		Если Своё = Неопределено Или Задание.УникальныйИдентификатор <> Своё.УникальныйИдентификатор Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество >= Лимит;

КонецФункции

Функция ЗавершитьХодДиалогаБезопасно(Результат, Диалог, НомерОтвета, ЭтоПродолжение, КлиентПрисоединён)

	Попытка
		Возврат ЗавершитьХодДиалога(Результат, Диалог, НомерОтвета, ЭтоПродолжение, КлиентПрисоединён);
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Новый Структура("НомерСообщения, Ошибка, Заменен, ОткрытьПослеОтвета", 0,
			НСтр("ru = 'Ответ не сохранён в диалоге. Подробности - в журнале регистрации.'"), Ложь, "");
	КонецПопытки;

КонецФункции

// Промежуточный результат хода из регистра с ошибкой и обрывом; без промежуточного - пустой результат.
Функция ПрерванныйРезультат(ИдентификаторХода, Текст, Обрыв)

	Данные = ДанныеСостояния(ИдентификаторХода);
	Результат = ?(Данные = Неопределено, Неопределено, Данные.ПромежуточныйРезультат);
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Результат = Новый Структура("Успех, Текст, Ошибка, Таблицы, ЕстьЧужойТекст, Скрыто, Шаги, Источники, Обрыв, "
			+ "Объекты, Отчеты, КлассДанных", Ложь, "", "", Новый Массив, Ложь, 0, Новый Массив, Новый Массив, "",
			Новый Массив, Новый Массив, 1);
	КонецЕсли;
	Результат.Успех = Ложь;
	Результат.Ошибка = Текст;
	Результат.Обрыв = Обрыв;
	Возврат Результат;

КонецФункции

// Финализирует ход без задания (осиротевший или остановленный на паузе) частичным результатом.
Процедура ЗавершитьПрерванныйХод(ИдентификаторХода, Результат, Остановлен)

	Данные = ДанныеСостояния(ИдентификаторХода, Ложь);
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Результат = ПрерванныйРезультат(ИдентификаторХода, "", "");
	КонецЕсли;
	Результат.Успех = Ложь;
	Результат.Обрыв = ?(Остановлен, "stopped", "error");
	Результат.Ошибка = ?(Остановлен, НСтр("ru = 'Остановлено.'"),
		НСтр("ru = 'Ответ прерван: фоновое задание завершилось аварийно или программа была закрыта.'"));
	Итог = ЗавершитьХодДиалогаБезопасно(Результат, Данные.Диалог, Данные.НомерЗаменяемогоОтвета, Данные.ЭтоПродолжение, Ложь);
	ЗаписатьИтог(ИдентификаторХода, Итог);
	Пользователь = Пользователи.ТекущийПользователь();
	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьОчередь(Пользователь);
		ИзменитьСостояние(ИдентификаторХода, Новый Структура("Статус", ?(Остановлен, СтатусОстановлен(), СтатусОшибка())));
		ПеревестиВОтложенные(?(Остановлен, НСтр("ru = 'Отправка приостановлена'"), НСтр("ru = 'Ответ прерван'")), Истина);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Захватывает осиротевший ход (running или finishing без задания) и финализирует его.
Процедура ВосстановитьХод(Запись)

	Если Запись.Статус = СтатусЗавершается() Тогда
		// Ответ уже сохранён, задание прервалось на выборке очереди.
		Пользователь = Пользователи.ТекущийПользователь();
		УстановитьПривилегированныйРежим(Истина);
		НачатьТранзакцию();
		Попытка
			ЗаблокироватьОчередь(Пользователь);
			ИзменитьСостояние(Запись.ИдентификаторХода, Новый Структура("Статус",
				?(ПустаяСтрока(Запись.Ошибка), СтатусГотово(), СтатусОшибка())), СтатусЗавершается());
			ПеревестиВОтложенные(НСтр("ru = 'Ответ прерван'"), Истина);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
		Возврат;
	КонецЕсли;
	// Захват под блокировкой: два окна не финализируют ход дважды.
	Если Не ИзменитьСостояние(Запись.ИдентификаторХода, Новый Структура("Статус", СтатусЗавершается()),
		СтатусВыполняется()) Тогда
		Возврат;
	КонецЕсли;
	Данные = ДанныеСостояния(Запись.ИдентификаторХода);
	ЗавершитьПрерванныйХод(Запись.ИдентификаторХода, Данные.ПромежуточныйРезультат, Данные.ЗапросОстановки);

КонецПроцедуры

Функция ЗаданиеПоИдентификатору(ИдентификаторЗадания)

	Если Не СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(ИдентификаторЗадания) Тогда
		Возврат Неопределено;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Возврат ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(ИдентификаторЗадания));

КонецФункции


// Ход running или finishing без активного задания. Без идентификатора задания отсчёт - от последнего изменения:
// захват паузы обновляет его, и запускаемое задание возобновления не принимается за осиротевшее.
Функция ХодОсиротел(Запись, Сейчас)

	Если Запись.Статус <> СтатусВыполняется() И Запись.Статус <> СтатусЗавершается() Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ПустаяСтрока(Запись.ИдентификаторЗадания) Тогда
		Возврат Сейчас - Запись.Обновлено >= 120; // до 120 с задание ещё запускается
	КонецЕсли;
	Задание = ЗаданиеПоИдентификатору(Запись.ИдентификаторЗадания);
	Если Задание = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке));
	КонецЕсли;
	Возврат Истина;

КонецФункции

#КонецОбласти

#Область Вложения

// Выбранная пользователем модель не ответила, ход отвечала другая модель цепочки: она становится выбранной
// в чате; окно обновит список моделей и покажет статус.
Процедура ПрименитьЗаменуМодели(ХодАгента, Открыть)

	Если Не ХодАгента.Свойство("ЗаменаМодели") Или Не ЗначениеЗаполнено(ХодАгента.ЗаменаМодели.Выбранная)
		Или Не ЗначениеЗаполнено(ХодАгента.ЗаменаМодели.Подключение) Тогда
		Возврат;
	КонецЕсли;
	ИИА_ЧатВызовСервера.ВыбратьМодель(Строка(ХодАгента.ЗаменаМодели.Подключение.УникальныйИдентификатор()));
	Открыть.model = Строка(ХодАгента.ЗаменаМодели.Наименование);

КонецПроцедуры

Процедура ДобавитьВложение(Данные, Имя, Значения)

	Если Значения.Количество() > 0 Тогда
		Данные.Вставить(Имя, Значения);
	КонецЕсли;

КонецПроцедуры

// Элементы массива вложений; ТолькоОбъекты - только элементы-объекты JSON (Соответствие).
Функция МассивВложения(Данные, Имя, ТолькоОбъекты = Истина)

	Результат = Новый Массив;
	Значения = Данные.Получить(Имя);
	Если ТипЗнч(Значения) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Значение Из Значения Цикл
		Если Не ТолькоОбъекты Или ТипЗнч(Значение) = Тип("Соответствие") Тогда
			Результат.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ДатаВложения(Значение)

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;
	Попытка
		Возврат ПрочитатьДатуJSON(Строка(Значение), ФорматДатыJSON.ISO);
	Исключение
		// Дата не в формате ISO - период отчёта не показывается.
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти

Функция ИмяСобытияЖурнала()

	Возврат НСтр("ru = 'ИИАссистент.ФоновыйХод'", ОбщегоНазначения.КодОсновногоЯзыка());

КонецФункции

#КонецОбласти
