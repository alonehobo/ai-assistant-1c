// Итог хода готов к показу: ответ сохранён или ход завершился, и окно его ещё не забрало.
Функция ИтогГотов(Запись)

	Если Запись.ИтогПоказан Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ХодЗавершен(Запись.Статус) Или Запись.Статус = СтатусЗавершается()
		И (Запись.НомерОтвета > 0 Или Не ПустаяСтрока(Запись.Ошибка));

КонецФункции

// Окончательный статус хода по результату агента и итогу сохранения ответа.
Функция ИтоговыйСтатус(Результат, Итог)

	Обрыв = "";
	Результат.Свойство("Обрыв", Обрыв);
	Если Обрыв = "stopped" Тогда
		Возврат СтатусОстановлен();
	ИначеЕсли Результат.Успех И Итог.НомерСообщения > 0 Тогда
		Возврат СтатусГотово();
	КонецЕсли;
	Возврат СтатусОшибка();

КонецФункции

