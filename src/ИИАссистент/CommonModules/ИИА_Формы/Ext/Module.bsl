///////////////////////////////////////////////////////////////////////////////////////////////////////
// ИИ-ассистент: формы конфигурации по метаданным.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Описание формы объекта: метаданные формы.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - объект или общая форма.
//  ИмяФормы - Строка - пусто: основная форма объекта (записи), «list»: основная форма списка.
//
// Возвращаемое значение:
//  ОбъектМетаданных, Неопределено - форма (ОбъектМетаданных: Форма); Неопределено, если формы нет.
//
Функция ФормаОбъекта(ОбъектМетаданных, ИмяФормы) Экспорт

	Если Метаданные.ОбщиеФормы.Содержит(ОбъектМетаданных) Тогда
		Возврат ОбъектМетаданных;
	КонецЕсли;
	Если ПустаяСтрока(ИмяФормы) Или НРег(ИмяФормы) = "list" Тогда
		Свойства = Новый Массив;
		Если ПустаяСтрока(ИмяФормы) Тогда
			Свойства.Добавить("ОсновнаяФормаОбъекта");
			Свойства.Добавить("ОсновнаяФормаЗаписи");
			Свойства.Добавить("ОсновнаяФорма");
		КонецЕсли;
		Свойства.Добавить("ОсновнаяФормаСписка");
		Для Каждого Свойство Из Свойства Цикл
			Попытка
				Форма = ОбъектМетаданных[Свойство];
			// У объекта метаданных нет такого свойства основной формы: проверяется следующее.
			Исключение // BSLLS:MissingCodeTryCatchEx-off
				Форма = Неопределено;
			КонецПопытки;
			Если Форма <> Неопределено Тогда
				Возврат Форма;
			КонецЕсли;
		КонецЦикла;
		Возврат ?(ОбъектМетаданных.Формы.Количество() > 0, ОбъектМетаданных.Формы[0], Неопределено);
	КонецЕсли;
	Возврат ОбъектМетаданных.Формы.Найти(ИмяФормы);

КонецФункции

#КонецОбласти
