// Сохраняет реплику диалога (см. ИИА_Обслуживание.СохранитьСообщение).
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги, Неопределено
//  Роль - Строка
//  Текст - Строка
//  ИдентификаторХода - Строка
//  Контекст - ЛюбаяСсылка, Неопределено
//  КлассДанных - Число, Неопределено - подтверждённый класс сохраняемой реплики.
//  Вложения - Строка - JSON интерактивных частей реплики.
//  Файлы - Массив из Структура, Неопределено - изображения и файлы вопроса (см. ИИА_Обслуживание.СохранитьСообщение).
//  НомерСообщения - Число - возвращается номер сохранённой реплики, 0 - не сохранена.
//  ФайлыСохранены - Булево - возвращается Истина, если Файлы сохранены с репликой.
//
// Возвращаемое значение:
//  СправочникСсылка.ИИА_Диалоги
//
Функция СохранитьСообщение(Диалог, Роль, Текст, ИдентификаторХода = "", Контекст = Неопределено,
	КлассДанных = Неопределено, Вложения = "", Файлы = Неопределено, НомерСообщения = 0, ФайлыСохранены = Ложь) Экспорт

	Попытка
		Возврат ИИА_Обслуживание.СохранитьСообщение(Диалог, Роль, Текст, ИдентификаторХода, Контекст, КлассДанных,
			Вложения, Файлы, НомерСообщения, ФайлыСохранены);
	Исключение
		// Сбой хранения не должен ломать диалог: ответ пользователь уже получил.
		НомерСообщения = 0;
		ФайлыСохранены = Ложь;
		ЗаписьЖурналаРегистрации("ИИАссистент.Диалоги", УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Диалог;
	КонецПопытки;

КонецФункции

// Удаляет вопрос, ход по которому не запустился, вместе с его файлами (см. ИИА_Обслуживание.УдалитьСообщение).
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги, Неопределено
//  НомерСообщения - Число
//
// Возвращаемое значение:
//  Булево - Истина, если удалён и сам диалог.
//
Функция УдалитьСообщение(Диалог, НомерСообщения) Экспорт

	Попытка
		Возврат ИИА_Обслуживание.УдалитьСообщение(Диалог, НомерСообщения);
	Исключение
		// Неудаление оставляет реплику в истории, как до исправления; ответ об отказе пользователь получит.
		ЗаписьЖурналаРегистрации("ИИАссистент.Диалоги", УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

КонецФункции

