// Текущие настройки ассистента. Подключения к моделям настраиваются в справочнике ИИА_ПодключенияМоделей.
//
// Возвращаемое значение:
//  Структура:
//   * Использовать - Булево
//   * ЛимитХодов - Число - вопросов в день на пользователя, 0 - без лимита.
//   * РазрешитьИзображения - Булево
//   * РазрешитьФайлы - Булево - файлы в вопросах (с компьютера и из базы).
//   * ПрофильПоУмолчанию - СправочникСсылка.ИИА_ПрофилиДоступа
//
Функция ПрочитатьНастройки() Экспорт

	ПроверитьПраваАдминистратора();
	ОбновлениеИнформационнойБазыИИА.ЗаполнитьПоставляемыеДанныеПриНеобходимости();
	ИИА_LLM.ПеренестиПодключениеИзНастроек();
	Настройки = Новый Структура;
	Настройки.Вставить("Использовать", Константы.ИИА_ИспользоватьАссистента.Получить());
	Настройки.Вставить("ЛимитХодов", Константы.ИИА_ЛимитХодовВДень.Получить());
	Настройки.Вставить("РазрешитьИзображения", Константы.ИИА_РазрешитьИзображения.Получить());
	// Хранится признак запрета: у константы нет значения по умолчанию, а файлы по умолчанию разрешены.
	Настройки.Вставить("РазрешитьФайлы", Не Константы.ИИА_ЗапретитьФайлы.Получить());
	Настройки.Вставить("ПрофильПоУмолчанию", Константы.ИИА_ПрофильПоУмолчанию.Получить());
	Настройки.Вставить("КаталогИсходников", Константы.ИИА_КаталогИсходников.Получить());
	Настройки.Вставить("АдресRLM", Константы.ИИА_АдресRLM.Получить());
	Настройки.Вставить("СрокХраненияДней", Константы.ИИА_СрокХраненияДней.Получить());
	Настройки.Вставить("МаксимумОдновременныхХодов", Константы.ИИА_МаксимумОдновременныхХодов.Получить());
	Настройки.Вставить("ОбщийМостОтчетов", Константы.ИИА_ОбщийМостОтчетов.Получить());
	Настройки.Вставить("ПолитикиЧерезВерсии", Константы.ИИА_ПолитикиЧерезВерсии.Получить());
	Настройки.Вставить("ДовериеВнешнегоКанала", Константы.ИИА_ДовериеВнешнегоКанала.Получить());
	Настройки.Вставить("КлючПодписиJWTЗаполнен", ИИА_ВнешнийДоступ.КлючПодписиЗаполнен());
	Настройки.Вставить("РежимПрокси", Константы.ИИА_РежимПрокси.Получить());
	Настройки.Вставить("АдресПрокси", Константы.ИИА_АдресПрокси.Получить());
	УчетныеДанныеПрокси = ИИА_HTTPКлиент.ОписаниеУчетныхДанныхПрокси();
	Настройки.Вставить("ПользовательПрокси", УчетныеДанныеПрокси.Пользователь);
	Настройки.Вставить("ПарольПроксиЗаполнен", УчетныеДанныеПрокси.ПарольЗаполнен);
	Возврат Настройки;

КонецФункции

// Записывает настройки ассистента.
//
// Параметры:
//  Использовать - Булево
//  ЛимитХодов - Число - вопросов в день на пользователя.
//  РазрешитьИзображения - Булево
//  ПрофильПоУмолчанию - СправочникСсылка.ИИА_ПрофилиДоступа
//
Процедура ЗаписатьНастройки(Использовать, ЛимитХодов, РазрешитьИзображения, ПрофильПоУмолчанию) Экспорт

	ПроверитьПраваАдминистратора();
	Константы.ИИА_ИспользоватьАссистента.Установить(Использовать);
	Константы.ИИА_ЛимитХодовВДень.Установить(Макс(0, Цел(ЛимитХодов)));
	Константы.ИИА_РазрешитьИзображения.Установить(РазрешитьИзображения);
	Константы.ИИА_ПрофильПоУмолчанию.Установить(ПрофильПоУмолчанию);

КонецПроцедуры

// Записывает настройки доступа к исходному коду через rlm-tools-bsl. При смене проекта или адреса
// сохранённая сессия rlm сбрасывается.
//
// Параметры:
//  Проект - Строка - имя проекта из реестра rlm; путь к выгрузке отклоняется исключением.
//  Адрес - Строка - адрес MCP-сервиса rlm-tools-bsl.
//
Процедура ЗаписатьНастройкиИсходников(Проект, Адрес) Экспорт

	ПроверитьПраваАдминистратора();
	Проект = СокрЛП(Проект);
	Адрес = СокрЛП(Адрес);
	Если ИИА_ИсходныйКод.ПроектЗаданПутем(Проект) Тогда
		ВызватьИсключение ИИА_ИсходныйКод.ТекстОшибкиПроектаПутем();
	КонецЕсли;
	Если Проект <> Константы.ИИА_КаталогИсходников.Получить() Или Адрес <> Константы.ИИА_АдресRLM.Получить() Тогда
		Константы.ИИА_КаталогИсходников.Установить(Проект);
		Константы.ИИА_АдресRLM.Установить(Адрес);
		Константы.ИИА_СессияRLM.Установить("");
	КонецЕсли;

КонецПроцедуры

// Записывает дополнительные настройки ассистента.
//
// Параметры:
//  Настройки - Структура - СрокХраненияДней и другие ключи из ПрочитатьНастройки.
//
Процедура ЗаписатьДополнительныеНастройки(Настройки) Экспорт

	ПроверитьПраваАдминистратора();
	Если Настройки.Свойство("СрокХраненияДней") Тогда
		Константы.ИИА_СрокХраненияДней.Установить(Макс(0, Цел(Настройки.СрокХраненияДней)));
	КонецЕсли;
	Если Настройки.Свойство("ОбщийМостОтчетов") Тогда
		Константы.ИИА_ОбщийМостОтчетов.Установить(Настройки.ОбщийМостОтчетов);
	КонецЕсли;
	Если Настройки.Свойство("МаксимумОдновременныхХодов") Тогда
		Константы.ИИА_МаксимумОдновременныхХодов.Установить(Макс(0, Цел(Настройки.МаксимумОдновременныхХодов)));
	КонецЕсли;
	Если Настройки.Свойство("ПолитикиЧерезВерсии") Тогда
		Если Настройки.ПолитикиЧерезВерсии <> Константы.ИИА_ПолитикиЧерезВерсии.Получить() Тогда
			ИИА_Политики.ЗаписатьЖурналНастройки(?(Настройки.ПолитикиЧерезВерсии, "РежимВерсийВключен", "РежимВерсийВыключен"), "");
		КонецЕсли;
		Константы.ИИА_ПолитикиЧерезВерсии.Установить(Настройки.ПолитикиЧерезВерсии);
	КонецЕсли;
	Если Настройки.Свойство("ДовериеВнешнегоКанала") Тогда
		Константы.ИИА_ДовериеВнешнегоКанала.Установить(Настройки.ДовериеВнешнегоКанала);
	КонецЕсли;
	Если Настройки.Свойство("РазрешитьФайлы") Тогда
		Константы.ИИА_ЗапретитьФайлы.Установить(Настройки.РазрешитьФайлы <> Истина);
	КонецЕсли;
	Если Настройки.Свойство("КлючПодписиJWT") И ЗначениеЗаполнено(Настройки.КлючПодписиJWT) Тогда
		ИИА_ВнешнийДоступ.СохранитьКлючПодписи(Настройки.КлючПодписиJWT);
	КонецЕсли;
	Если Настройки.Свойство("РежимПрокси") Тогда
		ЗаписатьНастройкиПрокси(Настройки);
	КонецЕсли;

КонецПроцедуры

