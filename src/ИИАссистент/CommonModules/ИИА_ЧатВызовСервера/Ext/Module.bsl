// Параметры открытия штатной формы отчёта, сформированного агентом, с теми же настройками. Доступ перепроверяется
// при каждом открытии, в том числе из восстановленного диалога.
//
// Параметры:
//  Запись - Соответствие - запись реестра ссылок диалога (kind = "report"), см. ИИА_Инструменты, свойство Отчет.
//           Вид: "variant" - вариант отчёта с пользовательскими настройками, "saved_variant" - личный вариант,
//           сохранённый configure_report, "osv" и "accounting" - бухгалтерские отчёты адаптера.
//  Причина - Строка - возвращается причина, по которой отчёт не открывается.
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если отчёт больше недоступен:
//   * Вид - Строка - "report" (ИмяФормы, ПараметрыФормы) или "saved_variant" (Вариант, ПараметрыФормы -
//       открыть ВариантыОтчетовКлиент.ОткрытьФормуОтчета).
//   * ИмяФормы - Строка
//   * Вариант - СправочникСсылка.ВариантыОтчетов
//   * ПараметрыФормы - Структура
//   * НеПрименено - Строка - что из настроек ассистента в ссылку не перенесено (для предупреждения).
//
Функция ОписаниеОткрытияОтчета(Запись, Причина = "") Экспорт

	Вид = Запись.Получить("Вид");
	ПараметрыФормы = Новый Структура;
	Если Вид = "variant" Или Вид = "saved_variant" Тогда
		ОбъектМетаданных = Метаданные.Отчеты.Найти(Строка(Запись.Получить("ИмяОтчета")));
		ТекстОтказа = НСтр("ru = 'Отчёт удалён из программы.'");
		Если ОбъектМетаданных = Неопределено
			Или ЗначениеЗаполнено(ИИА_Инструменты.ОтказДоступаКОтчету(ОбъектМетаданных, ТекстОтказа)) Тогда
			Причина = СтрШаблон(НСтр("ru = 'Отчёт больше недоступен. %1'"), ТекстОтказа);
			Возврат Неопределено;
		КонецЕсли;
		// Записи до изменения хранят только ключ варианта.
		Вариант = Неопределено;
		Если ТипЗнч(Запись.Получить("Вариант")) = Тип("Строка") Тогда
			Вариант = ДоступныйВариантОтчета(Запись.Получить("Вариант"), Вид = "saved_variant", Причина);
			Если Вариант = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
		КонецЕсли;
		ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
		Если Вид = "saved_variant" Тогда
			Возврат Новый Структура("Вид, Вариант, ПараметрыФормы, НеПрименено", Вид, Вариант, ПараметрыФормы, "");
		КонецЕсли;
		ПараметрыФормы.Вставить("КлючВарианта", Запись.Получить("КлючВарианта"));
		НастройкиXML = Запись.Получить("Настройки");
		Если ЗначениеЗаполнено(НастройкиXML) Тогда
			Попытка
				Настройки = ОбщегоНазначения.ЗначениеИзСтрокиXML(НастройкиXML);
			// Нечитаемые настройки обрабатываются ниже: ссылка считается недоступной.
			Исключение // BSLLS:MissingCodeTryCatchEx-off
				Настройки = Неопределено;
			КонецПопытки;
			Если ТипЗнч(Настройки) <> Тип("ПользовательскиеНастройкиКомпоновкиДанных") Тогда
				Причина = НСтр("ru = 'Отчёт больше недоступен: настройки ссылки не читаются.'");
				Возврат Неопределено;
			КонецЕсли;
			ПараметрыФормы.Вставить("ПользовательскиеНастройки", Настройки);
		КонецЕсли;
		НеПрименено = Запись.Получить("НеПрименено");
		Возврат Новый Структура("Вид, ИмяФормы, ПараметрыФормы, НеПрименено", "report",
			"Отчет." + ОбъектМетаданных.Имя + ".Форма", ПараметрыФормы,
			?(ТипЗнч(НеПрименено) = Тип("Массив"), СтрСоединить(НеПрименено, ", "), ""));

	ИначеЕсли Вид = "osv" Или Вид = "accounting" Тогда
		// Бухгалтерский отчёт открывается пользователю в его правах, без отбора профиля ассистента: профиль
		// ограничивает только модель. Организация и счёт из сохранённой записи перепроверяются запросом РАЗРЕШЕННЫЕ.
		ИмяОтчета = ?(Вид = "osv", "ОборотноСальдоваяВедомость", Строка(Запись.Получить("ИмяОтчета")));
		ОтчетыБухучета = Новый Массив;
		Для Каждого КлючИЗначение Из ИИА_БухгалтерскийДоступ.ВидыБухгалтерскихОтчетов() Цикл
			ОтчетыБухучета.Добавить(КлючИЗначение.Значение.ИмяОтчета);
		КонецЦикла;
		Если ОтчетыБухучета.Найти(ИмяОтчета) = Неопределено
			Или Метаданные.Отчеты.Найти(ИмяОтчета) = Неопределено
			Или Не ПравоДоступа("Использование", Метаданные.Отчеты[ИмяОтчета])
			Или ИИА_ПрофилиДоступа.ОтчетЗапрещенПрофилемЯвно(Метаданные.Отчеты[ИмяОтчета].ПолноеИмя()) Тогда
			Причина = НСтр("ru = 'Отчёт больше недоступен: нет права на отчёт или он запрещён профилем ассистента.'");
			Возврат Неопределено;
		КонецЕсли;
		Организация = ДоступнаяСсылкаИзXML(Запись.Получить("Организация"), "Справочник.Организации");
		Если Организация = Неопределено Тогда
			Причина = НСтр("ru = 'Отчёт больше недоступен: организация недоступна.'");
			Возврат Неопределено;
		КонецЕсли;
		// Как в штатном открытии ОСВ из ERP (помощник декларации по налогу на прибыль): ВидРасшифровки = 2 -
		// настройки берутся из дополнительных свойств пользовательских настроек.
		Настройки = Новый ПользовательскиеНастройкиКомпоновкиДанных;
		Настройки.ДополнительныеСвойства.Вставить("Организация", Организация);
		Настройки.ДополнительныеСвойства.Вставить("НачалоПериода", ДатаИзJSON(Запись.Получить("НачалоПериода")));
		Настройки.ДополнительныеСвойства.Вставить("КонецПериода", ДатаИзJSON(Запись.Получить("КонецПериода")));
		Настройки.ДополнительныеСвойства.Вставить("ПоСубсчетам", Истина);
		Настройки.ДополнительныеСвойства.Вставить("ПоказательБУ", Истина);
		Если Вид = "accounting" Тогда
			Счет = ДоступнаяСсылкаИзXML(Запись.Получить("Счет"), "ПланСчетов.Хозрасчетный");
			Если Счет = Неопределено Тогда
				Причина = НСтр("ru = 'Отчёт больше недоступен: счёт недоступен.'");
				Возврат Неопределено;
			КонецЕсли;
			Настройки.ДополнительныеСвойства.Вставить("Счет", Счет);
		КонецЕсли;
		ЗаполняемыеНастройки = Новый Структура("Отбор, Группировка, ВыводимыеДанные, Показатели", Истина, Истина, Истина, Ложь);
		ПараметрыФормы.Вставить("ВидРасшифровки", 2);
		ПараметрыФормы.Вставить("ПользовательскиеНастройки", Настройки);
		ПараметрыФормы.Вставить("ЗаполняемыеНастройки", ЗаполняемыеНастройки);
		ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
		Возврат Новый Структура("Вид, ИмяФормы, ПараметрыФормы, НеПрименено", "report",
			"Отчет." + ИмяОтчета + ".Форма.ФормаОтчета", ПараметрыФормы, "");
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

// Навигационная ссылка списка таблицы - источника ответа (вид «list»): объект в периметре, есть право просмотра.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта метаданных.
//  Причина - Строка - возвращается причина, по которой список не открывается.
//
// Возвращаемое значение:
//  Строка - e1cib/list/<ПолноеИмя>; пусто - список недоступен.
//
Функция СсылкаСпискаИсточника(ПолноеИмя, Причина = "") Экспорт

	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Строка(ПолноеИмя));
	Если ОбъектМетаданных = Неопределено Или ИИА_Периметр.ОбъектЗапрещен(ОбъектМетаданных.ПолноеИмя())
		Или Не ПравоДоступа("Просмотр", ОбъектМетаданных) Тогда
		Причина = НСтр("ru = 'Список больше недоступен: он вне периметра ассистента или нет права просмотра.'");
		Возврат "";
	КонецЕсли;
	Возврат "e1cib/list/" + ОбъектМетаданных.ПолноеИмя();

КонецФункции

// Файл Excel по таблице ответа: шапка, числа и даты - типизированными ячейками. Файл пишется во временный файл
// сервера, который сразу удаляется, и передаётся клиенту через временное хранилище.
//
// Параметры:
//  Данные - Структура:
//   * Заголовок - Строка - для имени файла (пусто - «Таблица»).
//   * Колонки - Массив из Строка
//   * Строки - Массив из Массив - значения ячеек.
//   * ИзТекста - Булево - таблица из текста ответа (markdown): ячейки - текст как на странице, числа и даты
//       распознаются; Ложь - таблица данных инструмента: значения с псевдонимами, они раскрываются.
//  ИдентификаторФормы - УникальныйИдентификатор
//
// Возвращаемое значение:
//  Структура:
//   * Адрес - Строка - адрес двоичных данных xlsx во временном хранилище; пусто - ошибка.
//   * ИмяФайла - Строка
//   * Ошибка - Строка
//
Функция ФайлExcelТаблицы(Знач Данные, ИдентификаторФормы) Экспорт

	Результат = Новый Структура("Адрес, ИмяФайла, Ошибка", "", "", "");
	Если Не Данные.ИзТекста Тогда
		// Файл уходит за пределы чата: раскрытие с учётом прав пользователя, без номеров диалога.
		Данные = ИИА_Маскирование.ДляПользователя(Данные, , Ложь);
	КонецЕсли;
	Сборка = ИИА_Файлы.ДвоичныеДанныеXLSX(Данные.Колонки, Данные.Строки, Данные.ИзТекста);
	Если Не ПустаяСтрока(Сборка.Ошибка) Тогда
		Результат.Ошибка = Сборка.Ошибка;
		Возврат Результат;
	КонецЕсли;
	Результат.Адрес = ПоместитьВоВременноеХранилище(Сборка.ДвоичныеДанные, ИдентификаторФормы);
	Результат.ИмяФайла = ИИА_Файлы.ИмяФайла(Данные.Заголовок, "xlsx");
	Возврат Результат;

КонецФункции

// Команда страницы чата из канала data-cmd (JSON {cmd, ...}), строго по схеме:
//  rename {id: целое >= 0, title: строка до 150}, search {text: строка до 200},
//  excel {title: строка до 150, columns: до 50 строк, rows: до 2000 массивов до 50 строк; ячейка до 1000 символов},
//  pref {sidebar: булево}. JSON - не больше 2 МБ.
//
// Параметры:
//  ДанныеJSON - Строка
//
// Возвращаемое значение:
//  Структура, Неопределено - поля команды с ключами JSON (cmd, id, title, text, columns, rows, sidebar);
//    Неопределено - неизвестная команда, лишние поля или неверные типы и размеры (в журнал - предупреждение).
//
Функция КомандаСтраницы(ДанныеJSON) Экспорт

	Схемы = Новый Соответствие;
	Схемы.Вставить("rename", "id,title");
	Схемы.Вставить("search", "text");
	Схемы.Вставить("excel", "title,columns,rows");
	Схемы.Вставить("pref", "sidebar");
	Данные = Неопределено;
	Если ТипЗнч(ДанныеJSON) = Тип("Строка") И СтрДлина(ДанныеJSON) <= 2097152 Тогда
		Попытка
			Данные = ОбщегоНазначения.JSONВЗначение(ДанныеJSON);
		// Невалидный JSON команды страницы отклоняется проверкой ниже.
		Исключение // BSLLS:MissingCodeTryCatchEx-off
			Данные = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Поля = Неопределено;
	Если ТипЗнч(Данные) = Тип("Соответствие") И ТипЗнч(Данные.Получить("cmd")) = Тип("Строка") Тогда
		Поля = Схемы.Получить(Данные.Получить("cmd"));
	КонецЕсли;
	Команда = Неопределено;
	Если Поля <> Неопределено И Данные.Количество() = СтрРазделить(Поля, ",").Количество() + 1 Тогда
		Команда = Новый Структура("cmd", Данные.Получить("cmd"));
		Для Каждого Поле Из СтрРазделить(Поля, ",") Цикл
			Если Не ПолеКомандыВерно(Поле, Данные.Получить(Поле)) Тогда
				Команда = Неопределено;
				Прервать;
			КонецЕсли;
			Команда.Вставить(Поле, Данные.Получить(Поле));
		КонецЦикла;
	КонецЕсли;
	Если Команда = Неопределено Тогда
		ЗаписьЖурналаРегистрации("ИИАссистент.Чат", УровеньЖурналаРегистрации.Предупреждение, , ,
			НСтр("ru = 'Команда страницы чата отклонена: она не соответствует схеме.'"));
	КонецЕсли;
	Возврат Команда;

КонецФункции

// Запоминает, открыта ли боковая панель истории чата (настройка пользователя).
//
// Параметры:
//  Открыта - Булево
//
Процедура СохранитьСостояниеПанели(Открыта) Экспорт

	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(КлючНастроекЧата(), "ПанельИстории", Открыта = Истина);

КонецПроцедуры

// Открыта ли боковая панель истории чата; по умолчанию - открыта.
//
// Возвращаемое значение:
//  Булево
//
Функция ПанельИсторииОткрыта() Экспорт

	Возврат ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(КлючНастроекЧата(), "ПанельИстории", Истина) <> Ложь;

КонецФункции

// Периметр данных текстом для просмотра администратором и службой безопасности.
//
// Возвращаемое значение:
//  Строка
//
Функция ПериметрТекстом() Экспорт

	ПроверитьПраваАдминистратора();
	Строки = Новый Массив;
	Для Каждого Строка Из ИИА_Периметр.ПериметрДляПросмотра() Цикл
		Строки.Добавить(СтрШаблон("%1	%2	%3", Строка.Вид, Строка.Имя, Строка.Причина));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Общий текст до подтверждения возможностей; не зависит от холодного периметра.
// Возвращаемое значение:
//  Строка - JSON capabilities с пустым массивом questions.
Функция БазовыйПакетВозможностейЧата() Экспорт

	Текст = НСтр("ru = 'Задайте вопрос по работе в базе. Ассистент проверяет права и разрешённые данные.'")
		+ " " + НСтр("ru = 'Персональные сведения и секреты отправлять нельзя.'");
	Возврат ОбщегоНазначения.ЗначениеВJSON(Новый Структура("type, text, questions", "capabilities", Текст, Новый Массив));

КонецФункции

// Число сохранённых видимых диалогов: обучение завершается после четвёртого.
// Параметры:
//  КоличествоДиалогов - Число - число диалогов без фильтра поиска.
// Возвращаемое значение:
//  Булево - разрешены примеры вопросов.
Функция НачальныеПодсказкиРазрешены(КоличествоДиалогов) Экспорт

	Возврат КоличествоДиалогов >= 0 И КоличествоДиалогов < 4;

КонецФункции

// Только история текущего пользователя, без помеченных диалогов и поиска.
// Возвращаемое значение:
//  Булево - текущая доступность примеров вопросов.
Функция НачальныеПодсказкиДоступны() Экспорт

	Возврат НачальныеПодсказкиРазрешены(ИИА_Обслуживание.ДиалогиДляПанели("").Количество());

КонецФункции

// Внутренняя метка настроек, влияющих на примеры вопросов. Полный периметр не строится.
// Возвращаемое значение:
//  Строка - XML только ссылок, версий данных, ролей и выбранной модели; не для модели или журнала.
Функция МеткаВозможностейЧата() Экспорт

	ПодсказкиДоступны = НачальныеПодсказкиДоступны();
	УстановитьПривилегированныйРежим(Истина);
	СобственныйПривилегированныйРежим = Истина;
	Попытка
		Пользователь = Пользователи.ТекущийПользователь();
		Выбор = ИИА_ПрофилиДоступа.ОписаниеВыбораПрофиля(Пользователь);
		Метка = Новый Структура("Пользователь, Профиль, Конфликт, АссистентВключен, РежимВерсий, Политика",
			Пользователь, Выбор.Профиль, Выбор.Конфликт, АссистентВключен(),
			Константы.ИИА_ПолитикиЧерезВерсии.Получить(), Константы.ИИА_ДействующаяВерсияПолитик.Получить());
		// Переходы 0-3 не отменяют уже подтверждённые примеры; четвёртый меняет метку.
		Метка.Вставить("ПодсказкиДоступны", ПодсказкиДоступны);
		Метка.Вставить("ВерсияПользователя", Пользователь.ПолучитьОбъект().ВерсияДанных);
		Метка.Вставить("ВерсияПрофиля", "");
		Подключения = Новый Массив;
		Если ЗначениеЗаполнено(Выбор.Профиль) Тогда
			Профиль = Выбор.Профиль.ПолучитьОбъект();
			Метка.ВерсияПрофиля = Профиль.ВерсияДанных;
			Подключения = Профиль.Модели.Выгрузить().ВыгрузитьКолонку("Подключение");
		КонецЕсли;
		Метка.Вставить("ВерсияПолитики", "");
		Если Метка.РежимВерсий И ЗначениеЗаполнено(Метка.Политика) Тогда
			Метка.ВерсияПолитики = Метка.Политика.ПолучитьОбъект().ВерсияДанных;
		КонецЕсли;
		Метка.Вставить("Модель", ВыбраннаяМодель());
		Если Не Метка.РежимВерсий Тогда
			// Свежая SQL-карта, без ПовтИсп и полного периметра: классы только трёх существующих примеров.
			КартаКлассификации = ИИА_КлассыДанных.ПостроитьКлассификацию();
			КлассыПримеров = Новый Массив;
			Для Каждого Имя Из СтрРазделить("РегистрНакопления.ТоварыНаСкладах,"
				+ "РегистрНакопления.ВыручкаИСебестоимостьПродаж,РегистрНакопления.РасчетыСКлиентами", ",") Цикл
				КлассыПримеров.Добавить(ИИА_КлассыДанных.ЭффективныйКласс(Имя, КартаКлассификации));
			КонецЦикла;
			Метка.Вставить("КлассыПримеров", КлассыПримеров);
		КонецЕсли;
		// Версии подключений учитывают изменение доверия/доступности без чтения ключей и адресов в результат.
		Запрос = Новый Запрос("ВЫБРАТЬ П.Ссылка КАК Подключение, П.ВерсияДанных КАК Версия
		|ИЗ Справочник.ИИА_ПодключенияМоделей КАК П
		|ГДЕ (&ВсеИспользуемые И П.Используется И НЕ П.ПометкаУдаления) ИЛИ П.Ссылка В (&Подключения)
		|УПОРЯДОЧИТЬ ПО П.Ссылка");
		Запрос.УстановитьПараметр("ВсеИспользуемые", Подключения.Количество() = 0);
		Запрос.УстановитьПараметр("Подключения", Подключения);
		РезультатЗапроса = Запрос.Выполнить();
		Метка.Вставить("ВерсииПодключений", РезультатЗапроса.Выгрузить());
		УстановитьПривилегированныйРежим(Ложь);
		СобственныйПривилегированныйРежим = Ложь;
		РолиСеанса = Новый ТаблицаЗначений;
		РолиСеанса.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
		Для Каждого Роль Из Метаданные.Роли Цикл
			Если РольДоступна(Роль.Имя) Тогда
				РолиСеанса.Добавить().Имя = Роль.Имя;
			КонецЕсли;
		КонецЦикла;
		РолиСеанса.Сортировать("Имя");
		Метка.Вставить("Роли", РолиСеанса.ВыгрузитьКолонку("Имя"));
		Результат = ОбщегоНазначения.ЗначениеВСтрокуXML(Метка);
	Исключение
		Если СобственныйПривилегированныйРежим Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ЗаписьЖурналаРегистрации("ИИАссистент.ВозможностиЧата", УровеньЖурналаРегистрации.Ошибка, , ,
			"CHAT_CAPABILITIES_STAMP_ERROR");
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Результат фонового расчёта, привязанный к одному запросу и неизменившимся настройкам доступа.
// Параметры:
//  Запрос - Структура - Идентификатор, Метка.
// Возвращаемое значение:
//  Структура - Идентификатор, Метка, Пакет.
Функция ПодготовитьВозможностиЧата(Запрос) Экспорт

	Результат = Новый Структура("Идентификатор, Метка, Пакет", Запрос.Идентификатор, Запрос.Метка,
		БазовыйПакетВозможностейЧата());
	Если Не НачальныеПодсказкиДоступны() Или Запрос.Метка <> МеткаВозможностейЧата() Тогда
		Возврат Результат;
	КонецЕсли;
	Возможности = ОписаниеВозможностейЧата();
	Если Запрос.Метка = МеткаВозможностейЧата() Тогда
		Результат.Пакет = ОбщегоНазначения.ЗначениеВJSON(
			Новый Структура("type, text, questions", "capabilities", Возможности.Текст, Возможности.Вопросы));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Принимает подготовленные подсказки только для актуального запроса и метки сервера.
// Параметры:
//  Подготовленные - Структура, Неопределено - результат ПодготовитьВозможностиЧата.
//  Идентификатор - Строка - текущий запрос экземпляра формы.
//  Метка - Строка - актуальная метка, вычисленная сервером при приёме.
//  ПодсказкиДоступны - Булево - актуальная доступность по истории текущего пользователя.
// Возвращаемое значение:
//  Строка - capabilities JSON; при устаревшем результате общий текст и questions=[].
Функция ПринятьВозможностиЧата(Подготовленные, Идентификатор, Метка, ПодсказкиДоступны = Истина) Экспорт

	Если Не ПодсказкиДоступны Или ТипЗнч(Подготовленные) <> Тип("Структура")
		Или ПустаяСтрока(Идентификатор) Или ПустаяСтрока(Метка) Тогда
		Возврат БазовыйПакетВозможностейЧата();
	КонецЕсли;
	ИдентификаторРезультата = Неопределено;
	МеткаРезультата = Неопределено;
	ПакетРезультата = Неопределено;
	Если Не Подготовленные.Свойство("Идентификатор", ИдентификаторРезультата)
		Или Не Подготовленные.Свойство("Метка", МеткаРезультата)
		Или Не Подготовленные.Свойство("Пакет", ПакетРезультата)
		Или ТипЗнч(ПакетРезультата) <> Тип("Строка") Тогда
		Возврат БазовыйПакетВозможностейЧата();
	КонецЕсли;
	Если ИдентификаторРезультата <> Идентификатор Или МеткаРезультата <> Метка Тогда
		Возврат БазовыйПакетВозможностейЧата();
	КонецЕсли;
	Попытка
		Пакет = ОбщегоНазначения.JSONВЗначение(ПакетРезультата);
	Исключение
		ЗаписьЖурналаРегистрации("ИИАссистент.ВозможностиЧата", УровеньЖурналаРегистрации.Ошибка, , ,
			"CHAT_CAPABILITIES_PACKET_ERROR");
		Возврат БазовыйПакетВозможностейЧата();
	КонецПопытки;
	Если ТипЗнч(Пакет) <> Тип("Соответствие") Или Пакет.Количество() <> 3
		Или Пакет.Получить("type") <> "capabilities" Или ТипЗнч(Пакет.Получить("text")) <> Тип("Строка")
		Или ТипЗнч(Пакет.Получить("questions")) <> Тип("Массив") Тогда
		Возврат БазовыйПакетВозможностейЧата();
	КонецЕсли;
	Вопросы = Пакет.Получить("questions");
	Если Вопросы.Количество() > 3 Тогда
		Возврат БазовыйПакетВозможностейЧата();
	КонецЕсли;
	Для Каждого Вопрос Из Вопросы Цикл
		Если ТипЗнч(Вопрос) <> Тип("Строка") Тогда
			Возврат БазовыйПакетВозможностейЧата();
		КонецЕсли;
	КонецЦикла;
	Возврат ПакетРезультата;

КонецФункции
// Возможности текущего пользователя. Не обращается к модели и не обещает результат вопроса.
// Возвращаемое значение:
//  Структура - Текст, Вопросы (Массив из Строка, не более трёх).
Функция ОписаниеВозможностейЧата() Экспорт

	Результат = Новый Структура("Текст, Вопросы", "", Новый Массив);
	Если Не АссистентВключен() Тогда
		Результат.Текст = НСтр("ru = 'Ассистент отключён. Обратитесь к администратору.'");
		Возврат Результат;
	КонецЕсли;
	Выбор = ИИА_ПрофилиДоступа.ОписаниеВыбораПрофиля(Пользователи.ТекущийПользователь());
	Если Выбор.Конфликт Тогда
		Результат.Текст = Выбор.Причина;
		Возврат Результат;
	КонецЕсли;
	Модели = ИИА_LLM.ДиагностикаМоделейПрофиля(Выбор.Профиль);
	Если Не Модели.Готово Тогда
		Результат.Текст = Модели.Текст;
		Возврат Результат;
	КонецЕсли;
	Результат.Текст = НСтр("ru = 'Можно задавать вопросы по доступным данным и структуре базы. Ассистент соблюдает ваши права и профиль; полнота ответа зависит от разрешённых данных и модели. Персональные сведения и секреты в вопросе отправлять нельзя.'");
	Если ИИА_ПрофилиДоступа.ИнструментЗапрещенПрофилем("run_query") Тогда
		Возврат Результат;
	КонецЕсли;
	Кандидаты = Новый Массив;
	Кандидаты.Добавить(Новый Структура("Объект, Вопрос, КлассДанных", "РегистрНакопления.ТоварыНаСкладах", "Какие остатки товаров доступны на складах?",
		ИИА_КлассыДанных.КлассОбъекта("РегистрНакопления.ТоварыНаСкладах")));
	Кандидаты.Добавить(Новый Структура("Объект, Вопрос, КлассДанных", "РегистрНакопления.ВыручкаИСебестоимостьПродаж", "Как изменились продажи за текущий месяц?",
		ИИА_КлассыДанных.КлассОбъекта("РегистрНакопления.ВыручкаИСебестоимостьПродаж")));
	Кандидаты.Добавить(Новый Структура("Объект, Вопрос, КлассДанных", "РегистрНакопления.РасчетыСКлиентами", "Какова общая задолженность клиентов?",
		ИИА_КлассыДанных.КлассОбъекта("РегистрНакопления.РасчетыСКлиентами")));
	Для Каждого Кандидат Из Кандидаты Цикл
		ИмяРегистра = Сред(Кандидат.Объект, СтрДлина("РегистрНакопления.") + 1);
		МетаданныеИсточника = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
		Если МетаданныеИсточника = Неопределено Или ИИА_Периметр.ОбъектЗапрещен(Кандидат.Объект) Тогда
			Продолжить;
		КонецЕсли;
		КлассИсточника = Кандидат.КлассДанных;
		Если Модели.ДопустимыеКлассы.Найти(КлассИсточника) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		// Права проверяются по ролям пользователя ИБ: результат не зависит от привилегированного режима,
		// который могли включить читающие служебные API. ПравоДоступа с явным пользователем требует права
		// «Администрирование», поэтому вызывается привилегированно; проверяются роли самого пользователя.
		УстановитьПривилегированныйРежим(Истина);
		ЧтениеРазрешено = ПравоДоступа("Чтение", МетаданныеИсточника, ПользователиИнформационнойБазы.ТекущийПользователь());
		УстановитьПривилегированныйРежим(Ложь);
		Если ЧтениеРазрешено Тогда
			Результат.Вопросы.Добавить(Кандидат.Вопрос);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Только администратору: настройки указанного пользователя без impersonation и сетевых запросов.
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи, Неопределено - пустое значение означает текущего пользователя.
// Возвращаемое значение:
//  Структура - Текст. Не содержит ключей и персональных данных пользователя.
Функция ДиагностикаДоступа(Пользователь = Неопределено) Экспорт

	ПроверитьПраваАдминистратора();
	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		Пользователь = Пользователи.ТекущийПользователь();
	КонецЕсли;
	Выбор = ИИА_ПрофилиДоступа.ОписаниеВыбораПрофиля(Пользователь);
	Строки = Новый Массив;
	Строки.Добавить(?(АссистентВключен(), "Ассистент включён.", "Ассистент отключён: включите его в настройках."));
	Строки.Добавить(Выбор.Причина);
	Если ЗначениеЗаполнено(Выбор.Профиль) Тогда
		Строки.Добавить("Эффективный профиль: " + Строка(Выбор.Профиль));
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	ЧерезВерсии = Константы.ИИА_ПолитикиЧерезВерсии.Получить();
	Версия = Константы.ИИА_ДействующаяВерсияПолитик.Получить();
	Строки.Добавить(?(ЧерезВерсии, "Режим политик: версии.", "Режим политик: текущие настройки."));
	Если ЧерезВерсии Тогда
		Строки.Добавить(?(ЗначениеЗаполнено(Версия), "Активная версия: " + Строка(Версия),
			"Активной версии нет: пока действуют текущие настройки. Создайте и активируйте проверенную версию."));
	КонецЕсли;
	Если Не Выбор.Конфликт И ЗначениеЗаполнено(Выбор.Профиль) Тогда
		Настройки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Выбор.Профиль,
			"ПоУмолчаниюРазрешено, ИсходныйКод, ЛимитТокеновВДень, НеХранитьТекстыДиалогов");
		Правила = ?(ИИА_Политики.ПолитикиЧерезВерсии(),
			ИИА_Политики.ПравилаПрофиляИзДействующейВерсии(Выбор.Профиль), Настройки);
		Строки.Добавить(?(Правила.ПоУмолчаниюРазрешено,
			"Объекты без отдельного правила: разрешены в базовом периметре.",
			"Объекты без отдельного правила: запрещены профилем."));
		Строки.Добавить(?(Правила.ИсходныйКод, "Исходный код: разрешён профилем.", "Исходный код: запрещён профилем."));
		Строки.Добавить(?(Настройки.ЛимитТокеновВДень > 0,
			"Лимит токенов в день: " + Строка(Настройки.ЛимитТокеновВДень), "Лимит токенов профиля не задан."));
		Строки.Добавить(?(Настройки.НеХранитьТекстыДиалогов,
			"Тексты диалогов: не сохраняются.", "Тексты диалогов: сохраняются по настройкам хранения."));
	КонецЕсли;
	Если Не Выбор.Конфликт Тогда
		Модели = ИИА_LLM.ДиагностикаМоделейПрофиля(Выбор.Профиль);
		Строки.Добавить(Модели.Текст);
		Если Модели.Модели.Количество() > 0 Тогда
			Строки.Добавить("Назначенная цепочка моделей: " + СтрСоединить(Модели.Модели, "; "));
		КонецЕсли;
	КонецЕсли;
	Строки.Добавить("Профиль только сужает базовый периметр. Права на данные и RLS нужно проверить в сеансе этого пользователя. Доступность HTTP не проверялась; секреты и персональные сведения не отправляются.");
	Возврат Новый Структура("Текст", СтрСоединить(Строки, Символы.ПС));

КонецФункции

// Скрипт локального моста ACP, который клиент записывает и запускает на компьютере пользователя.
//
// Возвращаемое значение:
//  Структура:
//   * Данные - ДвоичныеДанные - текст скрипта в UTF-8 без BOM.
//   * Версия - Строка - SHA-256 скрипта в нижнем регистре: так же мост называет свою версию.
//
Функция СкриптМостаACP() Экспорт

	Данные = ПолучитьДвоичныеДанныеИзСтроки(ПолучитьОбщийМакет("ИИА_МостACP").ПолучитьТекст(),
		КодировкаТекста.UTF8, Ложь);
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Данные);
	Возврат Новый Структура("Данные, Версия", Данные,
		НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма)));

КонецФункции

// Адреса используемых подключений через локальный мост ACP: клиент чата запускает мост до первого вопроса.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция АдресаМостовACP() Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Подключения.АдресAPI КАК АдресAPI
	|ИЗ
	|	Справочник.ИИА_ПодключенияМоделей КАК Подключения
	|ГДЕ
	|	Подключения.Используется
	|	И НЕ Подключения.ПометкаУдаления
	|	И Подключения.Протокол = ЗНАЧЕНИЕ(Перечисление.ИИА_ПротоколыAPI.ACP)");
	УстановитьПривилегированныйРежим(Истина);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("АдресAPI");

КонецФункции

#КонецОбласти

