//  ИдентификаторХода - Строка - ход оцениваемого ответа.
//
Процедура ЗаписатьОтзыв(Оценка, Диалог = Неопределено, ИдентификаторХода = "") Экспорт

	ИИА_Обслуживание.ЗаписатьОтзыв(Диалог, ИдентификаторХода, Оценка);

