#Область СсылкиОтвета

Функция МаксимумСсылокОтвета()

	Возврат 50;

КонецФункции

// Проверенная цель ссылки ответа (см. ОформитьСсылкиОбъектов); Неопределено - ссылки не будет.
Функция ЦельСсылкиОтвета(Знач Цель, Объекты)

	Если Не СтрНачинаетсяС(Цель, "m:") Тогда
		Индекс = ИндексОбъектаХода(Цель, Объекты);
		Возврат ?(Индекс = Неопределено, Неопределено, Новый Структура("kind, ref", "object", Индекс));
	КонецЕсли;
	Цель = Сред(Цель, 3);
	ИндексОбъекта = Неопределено;
	Позиция = СтрНайти(Цель, "@");
	Если Позиция > 0 Тогда
		ИндексОбъекта = ИндексОбъектаХода(Сред(Цель, Позиция + 1), Объекты);
		Цель = Лев(Цель, Позиция - 1);
	КонецЕсли;
	Части = СтрРазделить(Цель, ".", Ложь);
	Если Части.Количество() < 2 Или Части.Количество() > 4 Тогда
		Возврат Неопределено;
	КонецЕсли;
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Части[0] + "." + Части[1]);
	Если ОбъектМетаданных = Неопределено Или ПустаяСтрока(СсылкаСпискаИсточника(ОбъектМетаданных.ПолноеИмя())) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	Если Части.Количество() = 2 Тогда
		Возврат Новый Структура("kind, name", "metadata", ПолноеИмя);
	КонецЕсли;
	Поле = ПутьРеквизитаОбъекта(ОбъектМетаданных, Части);
	Если ПустаяСтрока(Поле) Или ИИА_Периметр.ПолеЗапрещено(ПолноеИмя, Поле) Тогда
		Возврат Неопределено;
	КонецЕсли;
	// У регистров и других нессылочных объектов нет формы объекта: реквизит ведёт к списку.
	Если Не ОбщегоНазначения.ЭтоОбъектСсылочногоТипа(ОбъектМетаданных) Тогда
		Возврат Новый Структура("kind, name", "metadata", ПолноеИмя);
	КонецЕсли;
	Если ИндексОбъекта <> Неопределено
		И Не СтрНачинаетсяС(Объекты[ИндексОбъекта].Ссылка, "e1cib/data/" + ПолноеИмя + "?") Тогда
		ИндексОбъекта = Неопределено;
	КонецЕсли;
	Возврат Новый Структура("kind, name, field, ref", "attribute", ПолноеИмя, Поле, ИндексОбъекта);

КонецФункции

// Индекс объекта хода по идентификатору oN; Неопределено - нет такого объекта или у него нет навигационной ссылки.
Функция ИндексОбъектаХода(Идентификатор, Объекты)

	Если Не СтрНачинаетсяС(Идентификатор, "o") Или СтрДлина(Идентификатор) > 4 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Номер = Сред(Идентификатор, 2);
	Если СтрНайтиВсеПоРегулярномуВыражению(Номер, "^[1-9][0-9]{0,2}$").Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Индекс = Число(Номер) - 1;
	Если Индекс < 0 Или Индекс >= Объекты.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ссылка = Объекты[Индекс].Ссылка;
	Если ТипЗнч(Ссылка) <> Тип("Строка") Или Не СтрНачинаетсяС(Ссылка, "e1cib/data/") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Индекс;

КонецФункции

// Путь реквизита от объекта: "Реквизит" или "ТабличнаяЧасть.Реквизит" с именами из метаданных; пусто - не найден.
//  Части - Массив из Строка - вид, имя объекта, затем реквизит или табличная часть и её реквизит.
Функция ПутьРеквизитаОбъекта(ОбъектМетаданных, Части)

	Если Части.Количество() = 3 Тогда
		Для Каждого ИмяКоллекции Из СтрРазделить("Реквизиты,СтандартныеРеквизиты,Измерения,Ресурсы", ",") Цикл
			Реквизит = РеквизитКоллекции(ОбъектМетаданных, ИмяКоллекции, Части[2]);
			Если Реквизит <> Неопределено Тогда
				Возврат Реквизит.Имя;
			КонецЕсли;
		КонецЦикла;
		Возврат "";
	КонецЕсли;
	ТабличнаяЧасть = РеквизитКоллекции(ОбъектМетаданных, "ТабличныеЧасти", Части[2]);
	Если ТабличнаяЧасть = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Реквизит = РеквизитКоллекции(ТабличнаяЧасть, "Реквизиты", Части[3]);
	Возврат ?(Реквизит = Неопределено, "", ТабличнаяЧасть.Имя + "." + Реквизит.Имя);

КонецФункции

// Элемент коллекции метаданных по имени без учёта регистра; Неопределено - нет коллекции или элемента.
Функция РеквизитКоллекции(Владелец, ИмяКоллекции, Имя)

	Попытка
		Коллекция = Владелец[ИмяКоллекции];
	// У объекта этого вида нет такой коллекции - реквизита в ней нет.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат Неопределено;
	КонецПопытки;
	Для Каждого Элемент Из Коллекция Цикл
		Если НРег(Элемент.Имя) = НРег(Имя) Тогда
			Возврат Элемент;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

#КонецОбласти

// Разбирает сообщение, отправленное страницей чата: JSON {text, images, docs, bfiles}.
// Изображения допускаются только как data URL JPEG/PNG, не больше шести (широкий снимок нескольких мониторов
// страница режет по экранам) и не больше 1,5 млн символов каждое.
// Файлы с компьютера docs - {name, url}: PDF передаётся модели как файл, текстовые файлы и Excel - извлечённым
// текстом (см. ИИА_Файлы.ПрочитатьФайл). Файлы из базы bfiles - идентификаторы токенов base_file реестра ссылок
// формы; файл перечитывается с проверкой прав, периметра и класса (ИИА_Файлы.ПрочитатьФайлБазы). Навигационная
// ссылка на присоединённый файл в тексте вопроса прикладывается как файл из базы.
// Сервер сам проверяет настройку файлов, лимиты и технические возможности модели: подделанное сообщение страницы
// с лишними или неподдерживаемыми вложениями отклоняется.
//
// Параметры:
//  ДанныеJSON - Строка
//  РеестрСсылок - Массив, Неопределено - реестр ссылок диалога формы (СсылкиДиалога) для токенов bfiles.
//
// Возвращаемое значение:
//  Структура:
//   * Текст - Строка
//   * Изображения - Массив из Строка
//   * Документы - Массив из Структура - см. ИИА_Файлы.ПрочитатьФайл; у файлов с компьютера есть ДвоичныеДанные -
//                 исходный файл для хранения с репликой.
//   * Ошибка - Строка
//
Функция РазобратьСообщениеСтраницы(ДанныеJSON, РеестрСсылок = Неопределено) Экспорт

	Результат = Новый Структура("Текст, Изображения, Документы, Ошибка", "", Новый Массив, Новый Массив, "");
	Попытка
		Данные = ОбщегоНазначения.JSONВЗначение(ДанныеJSON);
	// Невалидный JSON сообщения отклоняется проверкой ниже с понятной ошибкой.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Данные = Неопределено;
	КонецПопытки;
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Результат.Ошибка = НСтр("ru = 'Не удалось прочитать сообщение.'");
		Возврат Результат;
	КонецЕсли;
	Текст = Данные.Получить("text");
	Результат.Текст = СокрЛП(?(ТипЗнч(Текст) = Тип("Строка"), Текст, ""));

	ФайлыВопроса = Данные.Получить("docs");
	ФайлыВопроса = ?(ТипЗнч(ФайлыВопроса) = Тип("Массив"), ФайлыВопроса, Новый Массив);
	ФайлыБазы = Данные.Получить("bfiles");
	ФайлыБазы = ?(ТипЗнч(ФайлыБазы) = Тип("Массив"), ФайлыБазы, Новый Массив);
	ФайлыСсылок = ПрисоединенныеФайлыТекста(Результат.Текст);
	Если ФайлыВопроса.Количество() + ФайлыБазы.Количество() + ФайлыСсылок.Количество() > 0 Тогда
		Если Не ИИА_Файлы.ФайлыРазрешены() Тогда
			Результат.Ошибка = НСтр("ru = 'Файлы в вопросах отключены администратором.'");
			Возврат Результат;
		КонецЕсли;
		// До чтения - грубая граница (повторы токенов убраны, ссылка в тексте может повторять выбранный файл);
		// точный лимит - после удаления повторов файлов базы (ОшибкаЛимитов ниже).
		ФайлыБазы = УникальныеЗначения(ФайлыБазы);
		Если ФайлыВопроса.Количество() + ФайлыБазы.Количество() > ИИА_Файлы.МаксимумФайлов()
			Или ФайлыСсылок.Количество() > ИИА_Файлы.МаксимумФайлов() Тогда
			Результат.Ошибка = СтрШаблон(НСтр("ru = 'Не больше %1 файлов в сообщении.'"), ИИА_Файлы.МаксимумФайлов());
			Возврат Результат;
		КонецЕсли;
		Для Каждого Документ Из ФайлыВопроса Цикл
			Прочитанный = ПрочитатьДокументСтраницы(Документ);
			Если ТипЗнч(Прочитанный) = Тип("Строка") Тогда
				Результат.Ошибка = Прочитанный;
				Возврат Результат;
			КонецЕсли;
			Результат.Документы.Добавить(Прочитанный);
		КонецЦикла;
		Для Каждого Идентификатор Из ФайлыБазы Цикл
			Прочитанный = ПрочитатьФайлБазыСтраницы(Идентификатор, РеестрСсылок);
			Если ТипЗнч(Прочитанный) = Тип("Строка") Тогда
				Результат.Ошибка = Прочитанный;
				Возврат Результат;
			КонецЕсли;
			Результат.Документы.Добавить(Прочитанный);
		КонецЦикла;
		Для Каждого Ссылка Из ФайлыСсылок Цикл
			Прочитанный = ИИА_Файлы.ПрочитатьФайлБазы(Ссылка);
			Если ТипЗнч(Прочитанный) = Тип("Строка") Тогда
				Результат.Ошибка = Прочитанный;
				Возврат Результат;
			КонецЕсли;
			Результат.Документы.Добавить(Прочитанный);
		КонецЦикла;
		УдалитьПовторыФайловБазы(Результат.Документы);
		Результат.Ошибка = ИИА_Файлы.ОшибкаЛимитов(Результат.Документы);
		Если Не ПустаяСтрока(Результат.Ошибка) Тогда
			Возврат Результат;
		КонецЕсли;
		Для Каждого Документ Из Результат.Документы Цикл
			Если Документ.Вид = "pdf" И Не ЕстьМодельДляДокументов() Тогда
				Результат.Ошибка = НСтр("ru = 'Выбранная модель не принимает документы PDF: выберите модель с документами или уберите PDF.'");
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;
		ИИА_Файлы.НазначитьИдентификаторы(Результат.Документы);
	КонецЕсли;

	Изображения = Данные.Получить("images");
	Если ТипЗнч(Изображения) <> Тип("Массив") Или Изображения.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Если Не ИзображенияРазрешены() Тогда
		Результат.Ошибка = НСтр("ru = 'Отправка изображений отключена администратором.'");
		Возврат Результат;
	КонецЕсли;
	Если Изображения.Количество() > МаксимумИзображений() Тогда
		Результат.Ошибка = СтрШаблон(НСтр("ru = 'Не больше %1 изображений в сообщении.'"), МаксимумИзображений());
		Возврат Результат;
	КонецЕсли;
	Для Каждого Изображение Из Изображения Цикл
		Если ТипЗнч(Изображение) <> Тип("Строка") Или СтрДлина(Изображение) > 1500000
			Или Не (СтрНачинаетсяС(Изображение, "data:image/jpeg;base64,") Или СтрНачинаетсяС(Изображение, "data:image/png;base64,")) Тогда
			Результат.Ошибка = НСтр("ru = 'Изображение не поддерживается: допустимы JPEG и PNG до 1 МБ.'");
			Возврат Результат;
		КонецЕсли;
		Результат.Изображения.Добавить(Изображение);
	КонецЦикла;
	Если Не ЕстьМодельДляИзображений() Тогда
		Результат.Ошибка = НСтр("ru = 'Выбранная модель не принимает изображения: выберите модель с изображениями или уберите скриншоты.'");
		Результат.Изображения.Очистить();
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Разрешена ли отправка изображений модели (модель должна их поддерживать; скриншоты не проверяются
// детекторами персональных данных, поэтому по умолчанию выключено).
//
// Возвращаемое значение:
//  Булево
//
Функция ИзображенияРазрешены() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Возврат Константы.ИИА_РазрешитьИзображения.Получить() = Истина;

КонецФункции

// Можно ли отправить скриншот: выбранная в чате модель его принимает, а при автовыборе - любая модель цепочки.
//
// Возвращаемое значение:
//  Булево
//
Функция ЕстьМодельДляИзображений() Экспорт

	Возврат ВозможностьМодели("Изображения");

КонецФункции

// Можно ли отправить документ PDF: выбранная в чате модель его принимает, а при автовыборе - любая модель цепочки.
//
// Возвращаемое значение:
//  Булево
//
Функция ЕстьМодельДляДокументов() Экспорт

	Возврат ВозможностьМодели("Документы");

КонецФункции

// Модели для выбора в чате и текущий выбор пользователя.
//
// Возвращаемое значение:
//  Структура:
//   * Модели - Массив из Структура - id (уникальный идентификатор подключения), title, images, docs.
//   * Выбрана - Строка - id выбранной модели; пусто - автовыбор по цепочке профиля.
//
Функция МоделиЧата() Экспорт

	Результат = Новый Структура("Модели, Выбрана", Новый Массив, "");
	Для Каждого Модель Из ИИА_LLM.ДоступныеМодели() Цикл
		Результат.Модели.Добавить(Новый Структура("id, title, images, docs", Строка(Модель.Подключение.УникальныйИдентификатор()),
			Модель.Наименование, Модель.Изображения, Модель.Документы));
	КонецЦикла;
	Выбрана = ВыбраннаяМодель();
	Если Выбрана <> Неопределено Тогда
		Результат.Выбрана = Строка(Выбрана.УникальныйИдентификатор());
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Запоминает модель, выбранную пользователем в чате (настройка пользователя).
//
// Параметры:
//  Идентификатор - Строка - уникальный идентификатор подключения; пусто - автовыбор.
//
Процедура ВыбратьМодель(Идентификатор) Экспорт

	Значение = "";
	Для Каждого Модель Из ИИА_LLM.ДоступныеМодели() Цикл
		Если Строка(Модель.Подключение.УникальныйИдентификатор()) = Идентификатор Тогда
			Значение = Идентификатор;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(КлючНастроекЧата(), "Модель", Значение);

КонецПроцедуры

// Модель, выбранная пользователем в чате, если она ещё доступна ему.
//
// Возвращаемое значение:
//  СправочникСсылка.ИИА_ПодключенияМоделей, Неопределено - автовыбор.
//
Функция ВыбраннаяМодель() Экспорт

	Идентификатор = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(КлючНастроекЧата(), "Модель", "");
	Если ТипЗнч(Идентификатор) <> Тип("Строка") Или ПустаяСтрока(Идентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Модель Из ИИА_LLM.ДоступныеМодели() Цикл
		Если Строка(Модель.Подключение.УникальныйИдентификатор()) = Идентификатор Тогда
			Возврат Модель.Подключение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Текст библиотеки для страницы чата (только из белого списка общих макетов расширения).
//
// Параметры:
//  ИмяБиблиотеки - Строка - "mermaid".
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстБиблиотекиСтраницы(ИмяБиблиотеки) Экспорт

	Если ИмяБиблиотеки = "mermaid" Тогда
		Возврат ПолучитьОбщийМакет("ИИА_Mermaid").ПолучитьТекст();
	КонецЕсли;
	Возврат "";

КонецФункции

// Сколько изображений можно приложить к одному сообщению.
//
// Возвращаемое значение:
//  Число
//
Функция МаксимумИзображений() Экспорт

	Возврат 6;

КонецФункции

// Доступен ли ассистент текущему пользователю: включён и есть право на команду чата.
//
// Возвращаемое значение:
//  Булево
//
Функция АссистентДоступенПользователю() Экспорт

	Возврат АссистентВключен() И ПравоДоступа("Просмотр", Метаданные.ОбщиеКоманды.ИИА_ОткрытьЧат);

КонецФункции

// Безопасное представление объекта контекста для заголовка чата.
//
// Параметры:
//  Контекст - ЛюбаяСсылка
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * Текст - Строка - представление или причина недоступности.
//
Функция ПредставлениеКонтекста(Контекст) Экспорт

	Описание = ИИА_Инструменты.ОписаниеКонтекста(Контекст);
	Если Не Описание.Успех Тогда
		Возврат Новый Структура("Успех, Текст", Ложь, Описание.Ошибка);
	КонецЕсли;
	Возврат Новый Структура("Успех, Текст", Истина,
		СтрШаблон("%1: %2", Контекст.Метаданные().Представление(), Описание.Представление));

КонецФункции

Функция АссистентВключен()

	УстановитьПривилегированныйРежим(Истина);
	Возврат Константы.ИИА_ИспользоватьАссистента.Получить() = Истина;

КонецФункции

// Число ходов текущего пользователя с начала текущих суток (по вызовам модели в журнале).
//
// Возвращаемое значение:
//  Число
//
Функция ХодовЗаСегодня() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Журнал.ИдентификаторХода) КАК Ходов
	|ИЗ
	|	РегистрСведений.ИИА_ЖурналВызовов КАК Журнал
	|ГДЕ
	|	Журнал.Пользователь = &Пользователь
	|	И Журнал.Событие = ""ВызовМодели""
	|	И Журнал.МоментВызова >= &Начало";
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	// Журнал хранит универсальное время; сутки считаем по времени сеанса пользователя.
	Запрос.УстановитьПараметр("Начало", УниверсальноеВремя(НачалоДня(ТекущаяДатаСеанса()), ЧасовойПоясСеанса()));
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ходов, 0);

КонецФункции

// Общий лимит фоновых заданий агента на базу (план, раздел 4.9).
Функция ДостигнутЛимитОдновременныхХодов()

	УстановитьПривилегированныйРежим(Истина);
	Лимит = Константы.ИИА_МаксимумОдновременныхХодов.Получить();
	Если Лимит <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Отбор = Новый Структура("ИмяМетода, Состояние", "ИИА_Агент.ВыполнитьХодВФоне", СостояниеФоновогоЗадания.Активно);
	Возврат ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор).Количество() >= Лимит;

КонецФункции

Функция ЛимитХодовИсчерпан()

	УстановитьПривилегированныйРежим(Истина);
	Лимит = Константы.ИИА_ЛимитХодовВДень.Получить();
	Возврат Лимит > 0 И ХодовЗаСегодня() >= Лимит;

КонецФункции

// Ссылка из XML сохранённой записи, если пользователь её видит (чтение с РАЗРЕШЕННЫЕ); иначе Неопределено.
//
// Параметры:
//  ЗначениеXML - Строка
//  ИмяТаблицы - Строка - ожидаемый объект метаданных, задаётся кодом, а не записью.
//
Функция ДоступнаяСсылкаИзXML(ЗначениеXML, ИмяТаблицы)

	Попытка
		Ссылка = ОбщегоНазначения.ЗначениеИзСтрокиXML(ЗначениеXML);
	Исключение
		// Повреждённая запись диалога: кнопку открытия не показываем.
		ЗаписьЖурналаРегистрации("ИИАссистент.Чат", УровеньЖурналаРегистрации.Предупреждение, , ,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	Если Не ЗначениеЗаполнено(Ссылка) Или Не ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Ссылка))
		Или Ссылка.Метаданные().ПолноеИмя() <> ИмяТаблицы Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ?(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Ссылка", Истина) = Ссылка, Ссылка, Неопределено);

КонецФункции

Функция ДатаИзJSON(Значение)

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;
	Попытка
		Возврат ПрочитатьДатуJSON(Строка(Значение), ФорматДатыJSON.ISO);
	// Нераспознанная дата заменяется пустой.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат Дата(1, 1, 1);
	КонецПопытки;

КонецФункции


// Запускает фоновое задание хода с ключом пользователя: у пользователя одновременно только один ход.
// Результат - структура ЗапуститьХод, заполняется и возвращается.
Функция ЗапуститьЗаданиеХода(ПараметрыХода, ИдентификаторФормы, Результат)

	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, ИдентификаторФормы);
	Попытка
		Задание = ИИА_ФоновыйХод.ЗапуститьЗадание(ПараметрыХода, АдресРезультата);
	Исключение
		УдалитьИзВременногоХранилища(АдресРезультата);
		ЗаписьЖурналаРегистрации(НСтр("ru = 'ИИАссистент.Агент'", ОбщегоНазначения.КодОсновногоЯзыка()),
			ОтказЗапуска(Результат), , , ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Результат;
	КонецПопытки;

	Результат.Запущено = Истина;
	Результат.ИдентификаторЗадания = Задание.УникальныйИдентификатор;
	Результат.АдресРезультата = АдресРезультата;
	Возврат Результат;

КонецФункции

// Запускает ход чата: состояние хода создаётся до задания, поэтому опрос окна и восстановление видят ход сразу.
// Идентификатор задания пишут и запуск, и само задание (см. ИИА_ФоновыйХод.ВыполнитьХодЧата).
Функция ЗапуститьХодЧата(ПараметрыХода, Диалог, ПараметрыЧата, Результат)

	Если Не ЗначениеЗаполнено(Диалог) Тогда
		Результат.Ошибка = НСтр("ru = 'Диалог не задан.'");
		Результат.КодОшибки = "BAD_REQUEST";
		Возврат Результат;
	КонецЕсли;
	// Ответ задание пишет в диалог привилегированно: чужой диалог отклоняется до создания состояния. Владелец
	// читается привилегированно: у роли ИИА_Пользователь нет права на справочник диалогов.
	УстановитьПривилегированныйРежим(Истина);
	ВладелецДиалога = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Диалог, "Пользователь");
	УстановитьПривилегированныйРежим(Ложь);
	Если ВладелецДиалога <> Пользователи.ТекущийПользователь() Тогда
		Результат.Ошибка = НСтр("ru = 'Диалог недоступен.'");
		Результат.КодОшибки = "ACCESS_DENIED";
		Возврат Результат;
	КонецЕсли;
	ИИА_ФоновыйХод.ВосстановитьОсиротевшие();
	ИИА_ФоновыйХод.ОчиститьЗавершенные();
	Чат = Новый Структура("НомерЗаменяемогоОтвета, ЭтоПродолжение", 0, Ложь);
	Если ТипЗнч(ПараметрыЧата) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Чат, ПараметрыЧата);
	КонецЕсли;
	ИдентификаторХода = Строка(Новый УникальныйИдентификатор);
	ПараметрыХода.Вставить("Канал", "chat");
	ПараметрыХода.Вставить("ИдентификаторХода", ИдентификаторХода);
	ИИА_ФоновыйХод.НачатьХод(ИдентификаторХода, Диалог, "", Чат.НомерЗаменяемогоОтвета, Чат.ЭтоПродолжение);
	Попытка
		Задание = ИИА_ФоновыйХод.ЗапуститьЗадание(ПараметрыХода);
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'ИИАссистент.Агент'", ОбщегоНазначения.КодОсновногоЯзыка()),
			ОтказЗапуска(Результат), , , ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ИИА_ФоновыйХод.УдалитьСостояние(ИдентификаторХода);
		Возврат Результат;
	КонецПопытки;
	// Задание, упавшее до своей записи идентификатора, иначе осталось бы без него; повторная запись безвредна.
	ИИА_ФоновыйХод.ЗаписатьЗадание(ИдентификаторХода, Задание.УникальныйИдентификатор);
	Результат.Запущено = Истина;
	Результат.ИдентификаторЗадания = Задание.УникальныйИдентификатор;
	Результат.ИдентификаторХода = ИдентификаторХода;
	Возврат Результат;

КонецФункции

// Классифицирует исключение запуска задания: занятый ключ пользователя - TURN_BUSY (сообщение чата ставится
// в очередь), иное - START_ERROR. Синхронного выполнения без задания нет. Возвращает уровень журнала для записи
// исключения: TURN_BUSY - ожидаемая ситуация (ход другого окна занял ключ), фиксируется информацией.
Функция ОтказЗапуска(Результат)

	Если ИИА_ФоновыйХод.АктивноеЗаданиеКлюча() Тогда
		Результат.Ошибка = НСтр("ru = 'Предыдущий вопрос ещё обрабатывается. Дождитесь ответа или нажмите «Стоп».'");
		Результат.КодОшибки = "TURN_BUSY";
		Возврат УровеньЖурналаРегистрации.Информация;
	КонецЕсли;
	Результат.Ошибка = НСтр("ru = 'Не удалось запустить ответ ассистента. Повторите позже; подробности - в журнале регистрации.'");
	Результат.КодОшибки = "START_ERROR";
	Возврат УровеньЖурналаРегистрации.Ошибка;

КонецФункции


// Общие проверки запуска хода и отправки очереди: выключатель, конфликт профилей, дневные лимиты вопросов и токенов.
// Возвращает Структура - КодОшибки, Ошибка (пусто - запуск разрешён).
Функция ОтказЛимитов()

	Отказ = Новый Структура("КодОшибки, Ошибка", "", "");
	Если Не АссистентВключен() Тогда
		Отказ.Ошибка = НСтр("ru = 'ИИ-ассистент отключён администратором.'");
		Отказ.КодОшибки = "ASSISTANT_DISABLED";
		Возврат Отказ;
	КонецЕсли;
	ОбновлениеИнформационнойБазыИИА.ЗаполнитьПоставляемыеДанныеПриНеобходимости();
	Выбор = ИИА_ПрофилиДоступа.ОписаниеВыбораПрофиля(Пользователи.ТекущийПользователь());
	Если Выбор.Конфликт Тогда
		Отказ.Ошибка = Выбор.Причина;
		Отказ.КодОшибки = "PROFILE_CONFLICT";
	ИначеЕсли ЛимитХодовИсчерпан() Тогда
		Отказ.Ошибка = НСтр("ru = 'Исчерпан дневной лимит вопросов к ИИ-ассистенту. Попробуйте завтра или обратитесь к администратору.'");
		Отказ.КодОшибки = "DAILY_LIMIT";
	Иначе
		ЛимитТокенов = ИИА_Обслуживание.ЛимитТокеновВДень();
		Если ЛимитТокенов > 0 И ИИА_Обслуживание.ТокеновЗаСегодня() >= ЛимитТокенов Тогда
			Отказ.Ошибка = НСтр("ru = 'Исчерпан дневной лимит токенов вашего профиля. Попробуйте завтра или обратитесь к администратору.'");
			Отказ.КодОшибки = "TOKEN_LIMIT";
		КонецЕсли;
	КонецЕсли;
	Возврат Отказ;

КонецФункции

Функция РезультатОшибки(Текст, Обрыв = "error")

	Возврат Новый Структура("Успех, Текст, Ошибка, Таблицы, ЕстьЧужойТекст, Скрыто, Шаги, Источники, Обрыв", Ложь, "", Текст,
		Новый Массив, Ложь, 0, Новый Массив, Новый Массив, Обрыв);

КонецФункции

// Выполненная часть остановленного или упавшего хода (промежуточный результат агента) с текстом ошибки.
Функция ПрерванныйХод(АдресРезультата, Текст, Обрыв)

	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат РезультатОшибки(Текст, Обрыв);
	КонецЕсли;
	Результат.Успех = Ложь;
	Результат.Ошибка = Текст;
	Результат.Обрыв = Обрыв;
	Возврат Результат;

КонецФункции

// Вариант отчёта ссылки диалога, если он не удалён (и, для личного варианта ассистента, принадлежит пользователю).
Функция ДоступныйВариантОтчета(Идентификатор, ТолькоСвой, Причина)

	Попытка
		Ссылка = Справочники.ВариантыОтчетов.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
	// Неверный идентификатор варианта: проверка ниже вернёт причину недоступности.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Ссылка = Справочники.ВариантыОтчетов.ПустаяСсылка();
	КонецПопытки;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "ПометкаУдаления, Автор", Истина);
	Если Реквизиты = Неопределено Или Реквизиты.ПометкаУдаления <> Ложь Тогда
		Причина = НСтр("ru = 'Отчёт больше недоступен: вариант отчёта удалён.'");
		Возврат Неопределено;
	ИначеЕсли ТолькоСвой И Реквизиты.Автор <> Пользователи.ТекущийПользователь() Тогда
		Причина = НСтр("ru = 'Отчёт больше недоступен: вариант принадлежит другому пользователю.'");
		Возврат Неопределено;
	Иначе
		Возврат Ссылка;
	КонецЕсли;

КонецФункции

// Значение поля команды страницы соответствует схеме (см. КомандаСтраницы).
Функция ПолеКомандыВерно(Поле, Значение)

	Если Поле = "id" Тогда
		Возврат ТипЗнч(Значение) = Тип("Число") И Значение >= 0 И Значение = Цел(Значение);
	ИначеЕсли Поле = "title" Или Поле = "text" Тогда
		Возврат ТипЗнч(Значение) = Тип("Строка") И СтрДлина(Значение) <= ?(Поле = "title", 150, 200);
	ИначеЕсли Поле = "sidebar" Тогда
		Возврат ТипЗнч(Значение) = Тип("Булево");
	ИначеЕсли Поле = "columns" Тогда
		Возврат МассивСтрокКоманды(Значение);
	ИначеЕсли Поле = "rows" И ТипЗнч(Значение) = Тип("Массив") И Значение.Количество() <= 2000 Тогда
		Для Каждого СтрокаТаблицы Из Значение Цикл
			Если Не МассивСтрокКоманды(СтрокаТаблицы) Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции

Функция МассивСтрокКоманды(Значение)

	Если ТипЗнч(Значение) <> Тип("Массив") Или Значение.Количество() > 50 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Элемент Из Значение Цикл
		Если ТипЗнч(Элемент) <> Тип("Строка") Или СтрДлина(Элемент) > 1000 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Режим и адрес прокси ассистента; пароль меняется, только если введён в форме.
Процедура ЗаписатьНастройкиПрокси(Настройки)

	АдресПрокси = ?(Настройки.Свойство("АдресПрокси"), СокрЛП(Настройки.АдресПрокси), "");
	Если Настройки.РежимПрокси = Перечисления.ИИА_РежимыПрокси.СвойПрокси
		И ПустаяСтрока(ИИА_HTTPКлиент.РазобратьАдресПрокси(АдресПрокси).Сервер) Тогда
		ВызватьИсключение НСтр("ru = 'Укажите адрес своего прокси в виде «сервер:порт», например 127.0.0.1:10809.'");
	КонецЕсли;
	Константы.ИИА_РежимПрокси.Установить(Настройки.РежимПрокси);
	Константы.ИИА_АдресПрокси.Установить(АдресПрокси);
	Если Настройки.Свойство("ПользовательПрокси") Тогда
		Пароль = Неопределено;
		Если Настройки.Свойство("ПарольПрокси") И ЗначениеЗаполнено(Настройки.ПарольПрокси) Тогда
			Пароль = Настройки.ПарольПрокси;
		КонецЕсли;
		ИИА_HTTPКлиент.СохранитьУчетныеДанныеПрокси(Настройки.ПользовательПрокси, Пароль);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПраваАдминистратора()

	Если Не Пользователи.РолиДоступны("ИИА_Администратор") И Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для настройки ИИ-ассистента.'");
	КонецЕсли;

КонецПроцедуры

Функция КлючНастроекЧата()

	Возврат "ИИАссистент.Чат";

КонецФункции

Функция ВозможностьМодели(Свойство)

	Выбрана = ВыбраннаяМодель();
	Для Каждого Модель Из ИИА_LLM.ДоступныеМодели() Цикл
		Если (Выбрана = Неопределено Или Модель.Подключение = Выбрана) И Модель[Свойство] Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Документ со страницы чата {name, url}: файл вопроса (см. ИИА_Файлы.ПрочитатьФайл) или текст ошибки.
Функция ПрочитатьДокументСтраницы(Документ)

	Ошибка = НСтр("ru = 'Файл не поддерживается: допустимы PDF, текстовые файлы (TXT, MD, CSV, JSON, XML) и Excel до 10 МБ.'");
	Если ТипЗнч(Документ) <> Тип("Соответствие") Тогда
		Возврат Ошибка;
	КонецЕсли;
	Имя = Документ.Получить("name");
	Адрес = Документ.Получить("url");
	Если ТипЗнч(Имя) <> Тип("Строка") Или ТипЗнч(Адрес) <> Тип("Строка") Или СтрДлина(Адрес) > 14000000 Тогда
		Возврат Ошибка;
	КонецЕсли;
	Позиция = СтрНайти(Адрес, ";base64,");
	Если Не СтрНачинаетсяС(Адрес, "data:") Или Позиция = 0 Тогда
		Возврат Ошибка;
	КонецЕсли;
	ДвоичныеДанные = Base64Значение(Сред(Адрес, Позиция + 8));
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;
	Возврат ИИА_Файлы.ПрочитатьФайл(Имя, ДвоичныеДанные, "computer");

КонецФункции

// Присоединённые файлы из навигационных ссылок текста вопроса (только при разрешённых файлах и подсистеме БСП).
Функция ПрисоединенныеФайлыТекста(Текст)

	Результат = Новый Массив;
	Если СтрНайти(Текст, "e1cib/data/") = 0 Или Не ИИА_Файлы.ФайлыБазыДоступны() Или Не ИИА_Файлы.ФайлыРазрешены() Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Объект Из ИИА_Инструменты.РазобратьНавигационныеСсылки(Текст).Объекты Цикл
		Если Объект.Значение <> Неопределено И ИИА_Файлы.ЭтоПрисоединенныйФайл(Объект.Значение)
			И Результат.Найти(Объект.Значение) = Неопределено Тогда
			Результат.Добавить(Объект.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция УникальныеЗначения(Значения)

	Результат = Новый Массив;
	Для Каждого Значение Из Значения Цикл
		Если Результат.Найти(Значение) = Неопределено Тогда
			Результат.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Один и тот же файл базы, выбранный кнопкой и вставленный ссылкой, прикладывается один раз.
Процедура УдалитьПовторыФайловБазы(Документы)

	Ссылки = Новый Соответствие;
	Для Индекс = -Документы.ВГраница() По 0 Цикл
		Документ = Документы[-Индекс];
		Если Документ.Источник <> "base" Тогда
			Продолжить;
		КонецЕсли;
		Если Ссылки.Получить(Документ.Ссылка) <> Неопределено Тогда
			Документы.Удалить(-Индекс);
		Иначе
			Ссылки.Вставить(Документ.Ссылка, Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Файл из базы по токену страницы (целый индекс реестра ссылок формы, kind = base_file) или текст ошибки.
Функция ПрочитатьФайлБазыСтраницы(Идентификатор, РеестрСсылок)

	Недоступен = НСтр("ru = 'Файл из базы не найден: выберите его заново кнопкой «Файл из базы».'");
	Если ТипЗнч(Идентификатор) <> Тип("Число") Или Идентификатор < 0 Или Идентификатор <> Цел(Идентификатор)
		Или ТипЗнч(РеестрСсылок) <> Тип("Массив") Или Идентификатор > РеестрСсылок.ВГраница() Тогда
		Возврат Недоступен;
	КонецЕсли;
	Запись = РеестрСсылок[Идентификатор];
	Если ТипЗнч(Запись) <> Тип("Соответствие") Или Запись.Получить("kind") <> "base_file" Тогда
		Возврат Недоступен;
	КонецЕсли;
	Ссылка = ИИА_Инструменты.СсылкаПоНавигационнойСсылке(Строка(Запись.Получить("link")));
	Если Ссылка = Неопределено Тогда
		Возврат Недоступен;
	КонецЕсли;
	Возврат ИИА_Файлы.ПрочитатьФайлБазы(Ссылка);

КонецФункции

#КонецОбласти
