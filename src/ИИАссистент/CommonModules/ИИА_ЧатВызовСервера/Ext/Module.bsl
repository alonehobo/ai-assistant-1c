///////////////////////////////////////////////////////////////////////////////////////////////////////
// ИИ-ассистент: серверные вызовы форм чата и настроек.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Запускает ход агента в фоновом задании текущего пользователя.
// У пользователя одновременно может быть только один активный ход.
//
// Параметры:
//  История - Массив из Структура - Роль, Текст.
//  ТекстПользователя - Строка
//  ИдентификаторФормы - УникальныйИдентификатор
//  Контекст - ЛюбаяСсылка, Неопределено - объект, из которого открыт чат.
//  Изображения - Массив из Строка - data URL изображений (см. РазобратьСообщениеСтраницы).
//  Диалог - СправочникСсылка.ИИА_Диалоги, Неопределено
//  ФайлыВопроса - Массив из Структура - файлы пользователя (см. РазобратьСообщениеСтраницы).
//  ОбъектыВопроса - Массив из ЛюбаяСсылка - объекты из навигационных ссылок вопроса.
//  Продолжение - Структура, Неопределено - продолжить оборванный ответ (ТекстПользователя не используется):
//   * Текст - Строка - сохранённый текст оборванного ответа (со сносками [k]).
//   * Шаги - Массив - шаги оборванного хода (Вложения.steps).
//   * Источников - Число - сколько источников у оборванного ответа (Вложения.sources).
//   * КлассДанных - Число - класс оборванного ответа.
//  СтруктурыФорм - Соответствие, Неопределено - кэш структур форм, уже построенных окном чата.
//  Канал - Строка - "chat": ход окна чата - состояние хода создаётся до запуска задания (ИИА_СостоянияХодов), ответ
//    сохраняет в диалог само задание, временного хранилища нет; "http" - внешний API, как раньше.
//  ПараметрыЧата - Структура, Неопределено - для chat:
//   * НомерЗаменяемогоОтвета - Число - перегенерация или продолжение этого ответа; 0 - новый ответ.
//   * ЭтоПродолжение - Булево
//
// Возвращаемое значение:
//  Структура:
//   * Запущено - Булево
//   * Ошибка - Строка
//   * ИдентификаторЗадания - УникальныйИдентификатор
//   * АдресРезультата - Строка - только http.
//   * КодОшибки - Строка - причина отказа запуска: TURN_BUSY - у пользователя уже идёт ход (сообщение чата
//       ставится в очередь), START_ERROR - задание не запустилось, ACCESS_DENIED - диалог чата чужой.
//   * ИдентификаторХода - Строка - только chat.
//
Функция ЗапуститьХод(История, ТекстПользователя, ИдентификаторФормы, Контекст = Неопределено,
	Изображения = Неопределено, Диалог = Неопределено, ФайлыВопроса = Неопределено, ОбъектыВопроса = Неопределено,
	Продолжение = Неопределено, СтруктурыФорм = Неопределено, Канал = "http", ПараметрыЧата = Неопределено) Экспорт

	Результат = Новый Структура("Запущено, Ошибка, ИдентификаторЗадания, АдресРезультата, КодОшибки, ИдентификаторХода",
		Ложь, "", Неопределено, "", "", "");

	// Продолжение: частичный ответ - в историю модели, вместо вопроса - служебная инструкция с перечнем шагов.
	ПараметрыПродолжения = Неопределено;
	Если Продолжение <> Неопределено Тогда
		Если Не ПустаяСтрока(Продолжение.Текст) Тогда
			История.Добавить(Новый Структура("Роль, Текст, КлассДанных", "assistant", ТекстБезСносок(Продолжение.Текст),
				Продолжение.КлассДанных));
		КонецЕсли;
		ТекстПользователя = ИИА_Агент.ИнструкцияПродолжения(Продолжение.Шаги);
		ПараметрыПродолжения = Новый Структура("Шагов, Источников", Продолжение.Шаги.Количество(), Продолжение.Источников);
	КонецЕсли;
	Отказ = ОтказЛимитов();
	Если Не ПустаяСтрока(Отказ.КодОшибки) Тогда
		ЗаполнитьЗначенияСвойств(Результат, Отказ);
		Возврат Результат;
	КонецЕсли;
	ЕстьИзображения = Изображения <> Неопределено И Изображения.Количество() > 0;
	ЕстьДокументы = ФайлыВопроса <> Неопределено И ФайлыВопроса.Количество() > 0;
	Если ПустаяСтрока(ТекстПользователя) И Не ЕстьИзображения И Не ЕстьДокументы Тогда
		Результат.Ошибка = НСтр("ru = 'Введите вопрос.'");
		Результат.КодОшибки = "BAD_REQUEST";
		Возврат Результат;
	КонецЕсли;
	Если ЕстьИзображения И Не ИзображенияРазрешены() Тогда
		Результат.Ошибка = НСтр("ru = 'Отправка изображений отключена администратором.'");
		Результат.КодОшибки = "IMAGES_DISABLED";
		Возврат Результат;
	КонецЕсли;
	Если ДостигнутЛимитОдновременныхХодов() Тогда
		Результат.Ошибка = НСтр("ru = 'Ассистент сейчас занят ответами другим пользователям. Повторите вопрос через минуту.'");
		Результат.КодОшибки = "CONCURRENT_LIMIT";
		Возврат Результат;
	КонецЕсли;

	ПараметрыХода = Новый Структура("История, ТекстПользователя, Контекст, Изображения, Диалог, Документы, Модель, ОбъектыВопроса, Продолжение, СтруктурыФорм",
		История, Лев(ТекстПользователя, 8000), Контекст, ?(ЕстьИзображения, Изображения, Новый Массив), Диалог,
		?(ЕстьДокументы, ФайлыВопроса, Новый Массив), ВыбраннаяМодель(),
		?(ОбъектыВопроса = Неопределено, Новый Массив, ОбъектыВопроса), ПараметрыПродолжения,
		?(ТипЗнч(СтруктурыФорм) = Тип("Соответствие"), СтруктурыФорм, Новый Соответствие));
	Если Канал = "chat" Тогда
		Возврат ЗапуститьХодЧата(ПараметрыХода, Диалог, ПараметрыЧата, Результат);
	КонецЕсли;
	Возврат ЗапуститьЗаданиеХода(ПараметрыХода, ИдентификаторФормы, Результат);

КонецФункции

// Продолжает ход чата, вставший на паузу ради структуры формы (см. ИИА_ФоновыйХод.ПродолжитьПаузу): структура,
// построенная окном, добавляется к состоянию хода из регистра, и ход продолжается новым фоновым заданием.
//
// Параметры:
//  ИдентификаторХода - Строка
//  Структура - Массив, Строка - см. ИИА_ЧатКлиент.СтруктураФормы.
//
// Возвращаемое значение:
//  Структура - Запущено (Булево), Ошибка (Строка); повторный вызов для того же хода вернёт Запущено = Ложь.
//
Функция ПродолжитьПаузуХода(ИдентификаторХода, Структура) Экспорт

	Возврат ИИА_ФоновыйХод.ПродолжитьПаузу(ИдентификаторХода, Структура, Истина);

КонецФункции

// Окно чата закрывается: ходы пользователя продолжаются без клиента (см. ИИА_ФоновыйХод.ОтсоединитьОкно).
//
Процедура ОтсоединитьОкноЧата() Экспорт

	ИИА_ФоновыйХод.ОтсоединитьОкно();

КонецПроцедуры

// Причина, по которой задание не отправляет очередь следующим ходом: выключатель ассистента, конфликт профилей,
// дневные лимиты вопросов и токенов - те же проверки и тексты, что у ЗапуститьХод (см. ОтказЛимитов).
//
// Возвращаемое значение:
//  Строка - пусто, если отправлять можно.
//
Функция ПричинаОтказаОчереди() Экспорт

	Возврат ОтказЛимитов().Ошибка;

КонецФункции

// Состояние хода: новые статусы и шаги, результат, если ход завершён.
//
// Параметры:
//  ИдентификаторЗадания - УникальныйИдентификатор
//  АдресРезультата - Строка
//
// Возвращаемое значение:
//  Структура:
//   * Завершено - Булево
//   * Статусы - Массив из Строка
//   * Шаги - Массив из Соответствие - шаги хода, выполненные с прошлого опроса (см. ИИА_Агент.ВыполнитьХод,
//       свойство Шаги; detail - с псевдонимами).
//   * Результат - Структура, Неопределено - см. ИИА_Агент.ВыполнитьХод. При остановке и ошибке - выполненная часть
//       хода (Шаги, Источники, Объекты, ...) с Успех = Ложь, Ошибка и Обрыв "stopped" или "error".
//   * Пауза - Строка - всегда пусто: ход внешнего API на паузу не встаёт (пауза - только у хода чата).
//
Функция СостояниеХода(ИдентификаторЗадания, АдресРезультата) Экспорт

	Состояние = Новый Структура("Завершено, Статусы, Шаги, Результат, Пауза", Ложь, Новый Массив, Новый Массив, Неопределено, "");
	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	Если Задание = Неопределено Тогда
		Состояние.Завершено = Истина;
		Состояние.Результат = РезультатОшибки(НСтр("ru = 'Задание не найдено.'"));
		Возврат Состояние;
	КонецЕсли;

	Префикс = ИИА_Агент.ПрефиксСтатуса();
	ПрефиксШага = ИИА_Агент.ПрефиксШага();
	Для Каждого Сообщение Из Задание.ПолучитьСообщенияПользователю(Истина) Цикл
		Если СтрНачинаетсяС(Сообщение.Текст, Префикс) Тогда
			Состояние.Статусы.Добавить(Сред(Сообщение.Текст, СтрДлина(Префикс) + 1));
		ИначеЕсли СтрНачинаетсяС(Сообщение.Текст, ПрефиксШага) Тогда
			Состояние.Шаги.Добавить(ОбщегоНазначения.JSONВЗначение(Сред(Сообщение.Текст, СтрДлина(ПрефиксШага) + 1)));
		КонецЕсли;
	КонецЦикла;

	Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Возврат Состояние;
	КонецЕсли;

	Если Задание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
		Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	КонецЕсли;
	Состояние.Завершено = Истина;
	Если Задание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
		Состояние.Результат = ?(ТипЗнч(Результат) = Тип("Структура"), Результат,
			РезультатОшибки(НСтр("ru = 'Ход завершился без результата.'")));
		Если Не Состояние.Результат.Успех И ПустаяСтрока(Состояние.Результат.Обрыв) Тогда
			Состояние.Результат.Обрыв = "error";
		КонецЕсли;
	ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Отменено Тогда
		Состояние.Результат = ПрерванныйХод(АдресРезультата, НСтр("ru = 'Остановлено.'"), "stopped");
	Иначе
		Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
			ЗаписьЖурналаРегистрации(НСтр("ru = 'ИИАссистент.Агент'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка, , ,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке));
		КонецЕсли;
		Состояние.Результат = ПрерванныйХод(АдресРезультата,
			НСтр("ru = 'Ошибка при выполнении хода. Подробности - в журнале регистрации.'"), "error");
	КонецЕсли;
	Возврат Состояние;

КонецФункции

// Перенумеровывает маркеры источников ответа: [sN] -> [k] по порядку первого упоминания; маркеры неизвестных
// источников удаляются. Маркеры вида [s1, s3] разбиваются на [1][2].
//
// Параметры:
//  Текст - Строка - ответ модели.
//  Источники - Массив из Структура, Соответствие - источники хода (key, ...), см. ИИА_Агент.ВыполнитьХод.
//  Цитаты - Массив из Строка, Неопределено - ключи уже пронумерованных источников (продолжение ответа: номера
//    продолжения идут после них).
//
// Возвращаемое значение:
//  Структура:
//   * Текст - Строка - текст со сносками [k] (так он хранится в диалоге).
//   * Цитаты - Массив из Строка - ключ источника для сноски k (элемент k - 1); неупомянутые источники -
//       «Также использовано».
//
Функция ОформитьСсылкиИсточников(Текст, Источники, Цитаты = Неопределено) Экспорт

	Результат = Новый Структура("Текст, Цитаты", "", Новый Массив);
	Если Цитаты <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат.Цитаты, Цитаты);
	КонецЕсли;
	Известные = Новый Соответствие;
	Для Каждого Источник Из Источники Цикл
		Известные.Вставить(Источник["key"], Истина);
	КонецЦикла;
	Части = Новый Массив;
	Позиция = 1;
	Для Каждого Совпадение Из СтрНайтиВсеПоРегулярномуВыражению(Текст, "\[[sS][0-9]+( *, *[sS][0-9]+)*\]") Цикл
		Части.Добавить(Сред(Текст, Позиция, Совпадение.НачальнаяПозиция - Позиция));
		Позиция = Совпадение.НачальнаяПозиция + Совпадение.Длина;
		Для Каждого Маркер Из СтрРазделить(Сред(Совпадение.Значение, 2, Совпадение.Длина - 2), ", ", Ложь) Цикл
			Ключ = НРег(Маркер);
			Если Известные.Получить(Ключ) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Номер = Результат.Цитаты.Найти(Ключ);
			Если Номер = Неопределено Тогда
				Результат.Цитаты.Добавить(Ключ);
				Номер = Результат.Цитаты.ВГраница();
			КонецЕсли;
			Части.Добавить("[" + Формат(Номер + 1, "ЧГ=") + "]");
		КонецЦикла;
	КонецЦикла;
	Части.Добавить(Сред(Текст, Позиция));
	Результат.Текст = СтрСоединить(Части, "");
	Возврат Результат;

КонецФункции

// Превращает разметку модели [текст](цель) в ссылки ответа [текст](#k). Цель проверяется: объект хода (oN) должен
// иметь навигационную ссылку; объект метаданных и реквизит - существовать, быть в периметре и с правом просмотра.
// Непроверенная цель, внешний адрес и ссылки сверх лимита превращаются в текст без разметки.
//
// Параметры:
//  Текст - Строка - ответ модели.
//  Объекты - Массив из Структура - объекты хода (Текст, Ссылка): oN - элемент N - 1.
//  Начало - Число - число ссылок уже оформленной части ответа (продолжение нумерует ссылки после них).
//
// Возвращаемое значение:
//  Структура:
//   * Текст - Строка - текст со ссылками [текст](#k); k - номер ссылки ответа, начиная с Начало + 1.
//   * Ссылки - Массив из Структура - kind ("object" - ref: индекс объекта хода; "metadata" - name; "attribute" -
//       name, field - путь реквизита от объекта (Реквизит или ТЧ.Реквизит), ref - индекс объекта хода или
//       Неопределено), text - подпись.
//
Функция ОформитьСсылкиОбъектов(Текст, Объекты, Начало = 0) Экспорт

	Результат = Новый Структура("Текст, Ссылки", "", Новый Массив);
	Части = Новый Массив;
	Позиция = 1;
	Для Каждого Совпадение Из СтрНайтиВсеПоРегулярномуВыражению(Текст, "\[[^\[\]\n]{1,200}\]\([^()\s]{1,300}\)") Цикл
		Части.Добавить(Сред(Текст, Позиция, Совпадение.НачальнаяПозиция - Позиция));
		Позиция = Совпадение.НачальнаяПозиция + Совпадение.Длина;
		Разделитель = СтрНайти(Совпадение.Значение, "](");
		Подпись = Сред(Совпадение.Значение, 2, Разделитель - 2);
		Цель = Сред(Совпадение.Значение, Разделитель + 2, Совпадение.Длина - Разделитель - 2);
		Ссылка = ?(Результат.Ссылки.Количество() < МаксимумСсылокОтвета(), ЦельСсылкиОтвета(Цель, Объекты), Неопределено);
		Если Ссылка = Неопределено Тогда
			Части.Добавить(Подпись);
			Продолжить;
		КонецЕсли;
		Ссылка.Вставить("text", Подпись);
		Результат.Ссылки.Добавить(Ссылка);
		Части.Добавить(СтрШаблон("[%1](#%2)", Подпись, Формат(Начало + Результат.Ссылки.Количество(), "ЧГ=")));
	КонецЦикла;
	Части.Добавить(Сред(Текст, Позиция));
	Результат.Текст = СтрСоединить(Части, "");
	Возврат Результат;

КонецФункции

// Текст ответа без сносок [k] - для истории модели: следующий ход не должен путать их с маркерами [sN].
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстБезСносок(Знач Текст) Экспорт

	Совпадения = СтрНайтиВсеПоРегулярномуВыражению(Текст, " ?\[[0-9]{1,3}\]");
	Для Индекс = -Совпадения.ВГраница() По 0 Цикл
		Совпадение = Совпадения[-Индекс];
		Текст = Лев(Текст, Совпадение.НачальнаяПозиция - 1) + Сред(Текст, Совпадение.НачальнаяПозиция + Совпадение.Длина);
	КонецЦикла;
	// Ссылки ответа [текст](#k) - только подпись: номера ссылок действуют в своём ответе.
	Совпадения = СтрНайтиВсеПоРегулярномуВыражению(Текст, "\[[^\[\]\n]{1,200}\]\(#[0-9]{1,3}\)");
	Для Индекс = -Совпадения.ВГраница() По 0 Цикл
		Совпадение = Совпадения[-Индекс];
		Подпись = Сред(Совпадение.Значение, 2, СтрНайти(Совпадение.Значение, "](") - 2);
		Текст = Лев(Текст, Совпадение.НачальнаяПозиция - 1) + Подпись
			+ Сред(Текст, Совпадение.НачальнаяПозиция + Совпадение.Длина);
	КонецЦикла;
	Возврат Текст;

КонецФункции

// Вопрос, на который дан последний ответ диалога, - для перегенерации ответа без повторного сохранения вопроса.
// Изображения и файлы берутся из сохранённых с вопросом.
//
// Параметры:
//  Диалог - СправочникСсылка.ИИА_Диалоги
//  НомерОтвета - Число - номер реплики ассистента; она должна быть последней в диалоге.
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если реплика не последний ответ диалога текущего пользователя:
//   * Текст - Строка - текст вопроса для модели.
//   * КлассДанных - Число
//   * Изображения - Массив из Строка - data URL.
//   * Документы - Массив из Структура - см. ИИА_Файлы.ПрочитатьФайл; файлы из базы перечитаны с проверкой.
//   * ОбъектыВопроса - Массив из ЛюбаяСсылка
//   * Предупреждение - Строка - вложения вопроса не сохранены, ответ будет без них.
//
Функция ВопросДляПерегенерации(Диалог, НомерОтвета) Экспорт

	Сообщения = ИИА_Обслуживание.СообщенияДиалога(Диалог);
	Если Сообщения.Количество() < 2 Или Сообщения[Сообщения.ВГраница()].НомерСообщения <> НомерОтвета
		Или Сообщения[Сообщения.ВГраница()].Роль <> "assistant" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Вопрос = Неопределено;
	Для Индекс = -(Сообщения.ВГраница() - 1) По 0 Цикл
		Если Сообщения[-Индекс].Роль = "user" Тогда
			Вопрос = Сообщения[-Индекс];
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Вопрос = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура("Текст, КлассДанных, Изображения, Документы, ОбъектыВопроса, Предупреждение",
		Вопрос.Текст, Вопрос.КлассДанных, Новый Массив, Новый Массив, Новый Массив, "");
	Попытка
		Вложения = ОбщегоНазначения.JSONВЗначение(Вопрос.Вложения);
	// Повреждённые вложения вопроса не мешают: используется пустое соответствие.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Вложения = Неопределено;
	КонецПопытки;
	Если ТипЗнч(Вложения) <> Тип("Соответствие") Тогда
		Вложения = Новый Соответствие;
	КонецЕсли;
	Если ТипЗнч(Вложения.Получить("text")) = Тип("Строка") Тогда
		Результат.Текст = Вложения.Получить("text");
	КонецЕсли;
	Объекты = Вложения.Получить("objects");
	Для Каждого Объект Из ?(ТипЗнч(Объекты) = Тип("Массив"), Объекты, Новый Массив) Цикл
		Ссылка = ?(ТипЗнч(Объект) = Тип("Соответствие"), ИИА_Инструменты.СсылкаПоНавигационнойСсылке(Строка(Объект.Получить("link"))),
			Неопределено);
		Если Ссылка <> Неопределено Тогда
			Результат.ОбъектыВопроса.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;
	// Администратор запретил файлы после вопроса: файлы (с компьютера и из базы) в перегенерацию не идут.
	ФайлыРазрешены = ИИА_Файлы.ФайлыРазрешены();
	ПропущеноФайлов = 0;
	Для Каждого Файл Из ИИА_Обслуживание.ФайлыСообщения(Диалог, Вопрос.НомерСообщения) Цикл
		Если Файл.Вид <> "image" И Не ФайлыРазрешены Тогда
			ПропущеноФайлов = ПропущеноФайлов + 1;
			Продолжить;
		КонецЕсли;
		Если Файл.Вид = "image" Тогда
			Base64 = СтрЗаменить(СтрЗаменить(Base64Строка(Файл.ДвоичныеДанные), Символы.ВК, ""), Символы.ПС, "");
			Результат.Изображения.Добавить("data:" + Файл.ТипMIME + ";base64," + Base64);
			Продолжить;
		КонецЕсли;
		Прочитанный = ИИА_Файлы.ПрочитатьФайл(Файл.Имя, Файл.ДвоичныеДанные, "computer");
		Если ТипЗнч(Прочитанный) = Тип("Структура") Тогда
			Прочитанный.ДвоичныеДанные = Неопределено;
			Результат.Документы.Добавить(Прочитанный);
		КонецЕсли;
	КонецЦикла;
	// Файлы из базы хранятся ссылкой и перечитываются с повторной проверкой прав, периметра и класса владельца.
	ФайлыБазы = Вложения.Получить("bfiles");
	НедоступноФайловБазы = 0;
	ФайлыБазы = ?(ТипЗнч(ФайлыБазы) = Тип("Массив"), ФайлыБазы, Новый Массив);
	Если Не ФайлыРазрешены Тогда
		ПропущеноФайлов = ПропущеноФайлов + ФайлыБазы.Количество();
		ФайлыБазы = Новый Массив;
	КонецЕсли;
	Для Каждого ФайлБазы Из ФайлыБазы Цикл
		Ссылка = ?(ТипЗнч(ФайлБазы) = Тип("Соответствие"),
			ИИА_Инструменты.СсылкаПоНавигационнойСсылке(Строка(ФайлБазы.Получить("link"))), Неопределено);
		Прочитанный = ?(Ссылка = Неопределено, "", ИИА_Файлы.ПрочитатьФайлБазы(Ссылка));
		Если ТипЗнч(Прочитанный) = Тип("Структура") Тогда
			Результат.Документы.Добавить(Прочитанный);
			Результат.КлассДанных = Макс(Результат.КлассДанных, Прочитанный.Класс);
		Иначе
			НедоступноФайловБазы = НедоступноФайловБазы + 1;
		КонецЕсли;
	КонецЦикла;
	ИИА_Файлы.НазначитьИдентификаторы(Результат.Документы);
	ИменаФайлов = Вложения.Получить("docs");
	Если ТипЗнч(Вложения.Получить("shots")) = Тип("Число") И Вложения.Получить("shots") > Результат.Изображения.Количество()
		Или ТипЗнч(ИменаФайлов) = Тип("Массив")
		И ИменаФайлов.Количество() > Результат.Документы.Количество() + НедоступноФайловБазы + ПропущеноФайлов Тогда
		Результат.Предупреждение = НСтр("ru = 'Изображения и файлы вопроса не сохранены: ответ перегенерирован без них.'");
	КонецЕсли;
	Если НедоступноФайловБазы > 0 Тогда
		Результат.Предупреждение = СокрЛП(Результат.Предупреждение + " "
			+ НСтр("ru = 'Файл из базы недоступен: ответ перегенерирован без него.'"));
	КонецЕсли;
	Если ПропущеноФайлов > 0 Тогда
		Результат.Предупреждение = СокрЛП(Результат.Предупреждение + " "
			+ НСтр("ru = 'Файлы в вопросах отключены администратором: ответ перегенерирован без файлов вопроса.'"));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Останавливает ход.
//
// Параметры:
//  Идентификатор - Строка, УникальныйИдентификатор - Строка: идентификатор хода чата - двухфазная остановка
//    (флаг остановки; с Принудительно - отмена задания, если флаг не сработал); УникальныйИдентификатор: задание
//    хода внешнего API - отмена задания.
//  Принудительно - Булево - вторая фаза «Стоп» хода чата.
//
Процедура ОтменитьХод(Идентификатор, Принудительно = Ложь) Экспорт

	Если ТипЗнч(Идентификатор) = Тип("Строка") Тогда
		Если Принудительно Тогда
			ИИА_ФоновыйХод.ПрерватьЗадание(Идентификатор);
		Иначе
			ИИА_ФоновыйХод.ЗапроситьОстановку(Идентификатор);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Идентификатор);
	Если Задание <> Неопределено И Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Задание.Отменить();
	КонецЕсли;

КонецПроцедуры

