///////////////////////////////////////////////////////////////////////////////////////////////////////
// ИИ-ассистент: клиентские обработчики подключаемых команд и структура форм для модели.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Обработчик подключаемой команды «Спросить ИИ»: открывает чат с объектом в контексте.
// Для каждого объекта - своё окно чата.
//
// Параметры:
//  ПараметрКоманды - ЛюбаяСсылка, Массив из ЛюбаяСсылка
//  ПараметрыВыполнения - см. ПодключаемыеКомандыКлиент.ПараметрыВыполненияКоманды
//
Процедура СпроситьОбОбъекте(ПараметрКоманды, ПараметрыВыполнения) Экспорт

	Объект = ПараметрКоманды;
	Если ТипЗнч(ПараметрКоманды) = Тип("Массив") Тогда
		Если ПараметрКоманды.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		Объект = ПараметрКоманды[0];
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала запишите объект.'"));
		Возврат;
	КонецЕсли;

	ОткрытьФорму("ОбщаяФорма.ИИА_Чат", Новый Структура("Контекст", Объект), , Объект);

КонецПроцедуры

// Структура формы для инструментов модели form_layout и field_visibility. Форма создаётся без открытия
// (ПолучитьФорму): выполняется её ПриСозданииНаСервере и код расширений; без ключа видимость элементов - как у нового
// объекта, с ключом - с данными этого объекта (форма не открывается, объект не блокируется). На сервере ПолучитьФорму
// недоступна, а в тонком клиенте у элементов нет ПутьКДанным - поэтому только имена, виды, заголовки и состояние.
//
// Параметры:
//  ПолноеИмяФормы - Строка - например «Документ.ЗаказКлиента.Форма.ФормаДокумента».
//  КлючОбъекта - ЛюбаяСсылка, Неопределено - объект, с данными которого создаётся форма.
//
// Возвращаемое значение:
//  Массив из Структура - элементы в порядке обхода (командная панель формы первой): не больше 2000 видимых
//    и отдельно не больше 1000 потомков скрытых групп (без кнопок и командных панелей - только для field_visibility):
//   * Глубина - Число
//   * Вид - Строка - UsualGroup, Pages, Page, InputField, CheckBoxField, Button, Popup, Table и т.п.
//   * Имя - Строка
//   * Заголовок - Строка - пусто, если у элемента нет своего заголовка.
//   * Видим - Булево
//   * Доступность - Булево
//   * ТолькоПросмотр - Булево - Ложь, если у элемента нет такого свойства.
//   * ВидимРодитель - Булево - Ложь у потомков скрытого элемента (form_layout их не выводит).
//   * Таблица - Строка - имя таблицы, в которой лежит колонка.
//   * Команда - Строка - имя команды кнопки: заголовок команды формы на клиенте недоступен, его подбирает сервер.
//  Строка - причина, почему форму создать не удалось.
//
Функция СтруктураФормы(ПолноеИмяФормы, КлючОбъекта = Неопределено) Экспорт

	// Форма создаётся только ради чтения структуры и не открывается: ПолучитьФорму здесь намеренно.
	Попытка
		Если КлючОбъекта = Неопределено Тогда
			Форма = ПолучитьФорму(ПолноеИмяФормы); // BSLLS:GetFormMethod-off
		Иначе
			Форма = ПолучитьФорму(ПолноеИмяФормы, Новый Структура("Ключ", КлючОбъекта)); // BSLLS:GetFormMethod-off
		КонецЕсли;
	Исключение
		Возврат НСтр("ru = 'Форму не удалось создать: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Если Форма = Неопределено Тогда
		Возврат НСтр("ru = 'Форму не удалось создать.'");
	КонецЕсли;
	Сбор = Новый Структура("Элементы, Видимых, Скрытых", Новый Массив, 0, 0);
	Попытка
		ДобавитьЭлементСтруктуры(Форма, Форма.КоманднаяПанель, 0, "", Истина, Сбор);
		ДобавитьПодчиненныеСтруктуры(Форма, Форма, 0, "", Истина, Сбор);
	Исключение
		Возврат НСтр("ru = 'Структуру формы не удалось прочитать: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Сбор.Элементы;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьПодчиненныеСтруктуры(Форма, Родитель, Глубина, Таблица, ВидимРодитель, Сбор)

	Для Каждого Элемент Из Родитель.ПодчиненныеЭлементы Цикл
		ДобавитьЭлементСтруктуры(Форма, Элемент, Глубина, Таблица, ВидимРодитель, Сбор);
	КонецЦикла;

КонецПроцедуры

// Элемент и вложенные; потомки скрытого элемента выводятся с ВидимРодитель = Ложь из отдельного бюджета, чтобы
// не вытеснять видимые элементы (вывод form_layout для видимых не зависит от скрытых групп).
Процедура ДобавитьЭлементСтруктуры(Форма, Элемент, Глубина, Таблица, ВидимРодитель, Сбор)

	Если Элемент = Неопределено
		Или ВидимРодитель И Сбор.Видимых >= МаксимумВидимыхЭлементов()
		Или Не ВидимРодитель И Сбор.Скрытых >= МаксимумСкрытыхЭлементов() Тогда
		Возврат;
	КонецЕсли;
	// Часть свойств элементов на клиенте недоступна («Свойство недоступно на клиенте»): такой элемент пропускается,
	// а не обрывает структуру всей формы.
	Попытка
		Вид = ВидЭлементаСтруктуры(Элемент);
		Если ПустаяСтрока(Вид) Или Не ВидимРодитель И ЭтоКомандныйЭлемент(Вид) Тогда
			// Кнопки и командные панели под скрытой группой не нужны ни form_layout, ни field_visibility.
			Возврат;
		КонецЕсли;
		Видим = Элемент.Видимость;
		Описание = Новый Структура("Глубина, Вид, Имя, Заголовок, Видим, Доступность, ТолькоПросмотр, ВидимРодитель, Таблица, Команда",
			Глубина, Вид, Элемент.Имя, ЗаголовокЭлементаСтруктуры(Элемент), Видим, Истина, Ложь, ВидимРодитель, Таблица, "");
		Если Вид = "Button" Тогда
			Описание.Команда = Строка(Элемент.ИмяКоманды);
		КонецЕсли;
	Исключение
		Возврат;
	КонецПопытки;
	Описание.Доступность = СвойствоЭлемента(Элемент, "Доступность", Истина);
	Описание.ТолькоПросмотр = СвойствоЭлемента(Элемент, "ТолькоПросмотр", Ложь);
	Сбор.Элементы.Добавить(Описание);
	Если ВидимРодитель Тогда
		Сбор.Видимых = Сбор.Видимых + 1;
	Иначе
		Сбор.Скрытых = Сбор.Скрытых + 1;
	КонецЕсли;
	ВидимыеПотомки = ВидимРодитель И Видим;
	Если Вид = "Table" Тогда
		ДобавитьЭлементСтруктуры(Форма, Элемент.КоманднаяПанель, Глубина + 1, "", ВидимыеПотомки, Сбор);
		ДобавитьПодчиненныеСтруктуры(Форма, Элемент, Глубина + 1, Элемент.Имя, ВидимыеПотомки, Сбор);
	ИначеЕсли ТипЗнч(Элемент) = Тип("ГруппаФормы") Тогда
		ДобавитьПодчиненныеСтруктуры(Форма, Элемент, Глубина + 1, Таблица, ВидимыеПотомки, Сбор);
	КонецЕсли;

КонецПроцедуры

Функция ЭтоКомандныйЭлемент(Вид)

	Возврат Вид = "Button" Или Вид = "CommandBar" Или Вид = "ButtonGroup" Или Вид = "Popup";

КонецФункции

Функция МаксимумВидимыхЭлементов()

	Возврат 2000;

КонецФункции

Функция МаксимумСкрытыхЭлементов()

	Возврат 1000;

КонецФункции

// Булево свойство элемента; у части видов элементов свойства нет или оно недоступно на клиенте.
Функция СвойствоЭлемента(Элемент, Имя, ПоУмолчанию)

	Свойства = Новый Структура(Имя, ПоУмолчанию);
	Попытка
		ЗаполнитьЗначенияСвойств(Свойства, Элемент, Имя);
	// Свойства нет у этого вида элемента или оно недоступно на клиенте.
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат ПоУмолчанию;
	КонецПопытки;
	Возврат ?(ТипЗнч(Свойства[Имя]) = Тип("Булево"), Свойства[Имя], ПоУмолчанию);

КонецФункции

// Вид элемента в терминах XML-выгрузки формы; пусто - элемент в структуру не попадает (контекстные меню,
// картинки-декорации и т.п.).
Функция ВидЭлементаСтруктуры(Элемент)

	ТипЭлемента = ТипЗнч(Элемент);
	Если ТипЭлемента = Тип("ТаблицаФормы") Тогда
		Возврат "Table";
	ИначеЕсли ТипЭлемента = Тип("КнопкаФормы") Тогда
		Возврат "Button";
	ИначеЕсли ТипЭлемента = Тип("ДекорацияФормы") Тогда
		Возврат ?(Элемент.Вид = ВидДекорацииФормы.Надпись, "LabelDecoration", "");
	ИначеЕсли ТипЭлемента = Тип("ГруппаФормы") Тогда
		Если Элемент.Вид = ВидГруппыФормы.ОбычнаяГруппа Тогда
			Возврат "UsualGroup";
		ИначеЕсли Элемент.Вид = ВидГруппыФормы.Страницы Тогда
			Возврат "Pages";
		ИначеЕсли Элемент.Вид = ВидГруппыФормы.Страница Тогда
			Возврат "Page";
		ИначеЕсли Элемент.Вид = ВидГруппыФормы.КоманднаяПанель Тогда
			Возврат "CommandBar";
		ИначеЕсли Элемент.Вид = ВидГруппыФормы.ГруппаКнопок Тогда
			Возврат "ButtonGroup";
		ИначеЕсли Элемент.Вид = ВидГруппыФормы.Подменю Тогда
			Возврат "Popup";
		ИначеЕсли Элемент.Вид = ВидГруппыФормы.ГруппаКолонок Тогда
			Возврат "ColumnGroup";
		КонецЕсли;
		Возврат "";
	ИначеЕсли ТипЭлемента = Тип("ПолеФормы") Тогда
		Если Элемент.Вид = ВидПоляФормы.ПолеФлажка Тогда
			Возврат "CheckBoxField";
		ИначеЕсли Элемент.Вид = ВидПоляФормы.ПолеПереключателя Тогда
			Возврат "RadioButtonField";
		ИначеЕсли Элемент.Вид = ВидПоляФормы.ПолеНадписи Тогда
			Возврат "LabelField";
		ИначеЕсли Элемент.Вид = ВидПоляФормы.ПолеКартинки Тогда
			Возврат "PictureField";
		ИначеЕсли Элемент.Вид = ВидПоляФормы.ПолеТабличногоДокумента Тогда
			Возврат "SpreadSheetDocumentField";
		ИначеЕсли Элемент.Вид = ВидПоляФормы.ПолеHTMLДокумента Тогда
			Возврат "HTMLDocumentField";
		ИначеЕсли Элемент.Вид = ВидПоляФормы.ПолеТекстовогоДокумента Тогда
			Возврат "TextDocumentField";
		ИначеЕсли Элемент.Вид = ВидПоляФормы.ПолеКалендаря Тогда
			Возврат "CalendarField";
		КонецЕсли;
		Возврат "InputField";
	КонецЕсли;
	Возврат "";

КонецФункции

// Собственный заголовок элемента. Заголовок и подсказка команды формы на клиенте недоступны («Свойство недоступно
// на клиенте»): у кнопки без своего заголовка он пустой, сервер подбирает его по имени команды.
Функция ЗаголовокЭлементаСтруктуры(Элемент)

	Попытка
		Возврат СокрЛП(СтрЗаменить(Строка(Элемент.Заголовок), "&", ""));
	Исключение
		// У части видов элементов заголовка нет.
		Возврат "";
	КонецПопытки;

КонецФункции

#КонецОбласти
