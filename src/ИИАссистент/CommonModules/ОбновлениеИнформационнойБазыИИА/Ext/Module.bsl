///////////////////////////////////////////////////////////////////////////////////////////////////////
// ИИ-ассистент: подсистема расширения в механизме обновления ИБ БСП.
// Подключается в ПодсистемыКонфигурацииПереопределяемый.ПриДобавленииПодсистем (заимствование в расширении).
// При первом запуске после установки расширения и при каждом обновлении его версии заполняет поставляемые
// данные: подключения к моделям (без ключей, выключены), базовые профили доступа, карточки отчётов для ИИ
// и глоссарий. Заполнение только добавляет недостающее: правки администратора не перезаписываются.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// См. ОбновлениеИнформационнойБазыБСП.ПриДобавленииПодсистемы.
Процедура ПриДобавленииПодсистемы(Описание) Экспорт

	Описание.Имя = "ИИАссистент";
	Описание.Версия = ВерсияПоставляемыхДанных();
	Описание.ТребуемыеПодсистемы.Добавить("СтандартныеПодсистемы");
	Описание.РежимВыполненияОтложенныхОбработчиков = "Последовательно";

КонецПроцедуры

// См. ОбновлениеИнформационнойБазыБСП.ПриДобавленииОбработчиковОбновления.
Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт

	Обработчик = Обработчики.Добавить();
	Обработчик.НачальноеЗаполнение = Истина;
	Обработчик.Процедура = "ОбновлениеИнформационнойБазыИИА.ЗаполнитьПоставляемыеДанные";
	Обработчик.РежимВыполнения = "Оперативно";

	// При каждом обновлении версии расширения добавляются новые поставляемые записи.
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "*";
	Обработчик.Процедура = "ОбновлениеИнформационнойБазыИИА.ЗаполнитьПоставляемыеДанные";
	Обработчик.РежимВыполнения = "Оперативно";

КонецПроцедуры

// См. ОбновлениеИнформационнойБазыБСП.ПередОбновлениемИнформационнойБазы.
Процедура ПередОбновлениемИнформационнойБазы() Экспорт

КонецПроцедуры

// См. ОбновлениеИнформационнойБазыБСП.ПослеОбновленияИнформационнойБазы.
Процедура ПослеОбновленияИнформационнойБазы(Знач ПредыдущаяВерсия, Знач ТекущаяВерсия,
		Знач ВыполненныеОбработчики, ВыводитьОписаниеОбновлений, Знач МонопольныйРежим) Экспорт

КонецПроцедуры

// См. ОбновлениеИнформационнойБазыБСП.ПриПодготовкеМакетаОписанияОбновлений.
Процедура ПриПодготовкеМакетаОписанияОбновлений(Знач Макет) Экспорт

КонецПроцедуры

// См. ОбновлениеИнформационнойБазыБСП.ПриОпределенииРежимаОбновленияДанных.
Процедура ПриОпределенииРежимаОбновленияДанных(РежимОбновленияДанных, СтандартнаяОбработка) Экспорт

КонецПроцедуры

// См. ОбновлениеИнформационнойБазыБСП.ПриДобавленииОбработчиковПереходаСДругойПрограммы.
Процедура ПриДобавленииОбработчиковПереходаСДругойПрограммы(Обработчики) Экспорт

КонецПроцедуры

// См. ОбновлениеИнформационнойБазыБСП.ПриЗавершенииПереходаСДругойПрограммы.
Процедура ПриЗавершенииПереходаСДругойПрограммы(Знач ПредыдущееИмяКонфигурации,
		Знач ПредыдущаяВерсияКонфигурации, Параметры) Экспорт

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Версия поставляемых данных расширения (совпадает с версией подсистемы и расширения).
//
// Возвращаемое значение:
//  Строка
//
Функция ВерсияПоставляемыхДанных() Экспорт

	Возврат "0.2.0.5";

КонецФункции

// Заполняет поставляемые данные один раз на версию расширения при первом обращении к ассистенту.
// Механизм обновления ИБ БСП запускается только при смене версии основной конфигурации, поэтому после
// установки или обновления расширения данные заполняются здесь; проверка - чтение одной константы.
//
Процедура ЗаполнитьПоставляемыеДанныеПриНеобходимости() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	// Классификация зависит и от метаданных конфигурации, поэтому проверяется отдельно от версии расширения.
	ИИА_КлассыДанных.ОбновитьАвтоматическуюКлассификациюПриНеобходимости();
	Версия = ВерсияПоставляемыхДанных();
	Если Константы.ИИА_ВерсияПоставляемыхДанных.Получить() = Версия Тогда
		Возврат;
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Блокировка.Добавить("Константа.ИИА_ВерсияПоставляемыхДанных");
		Блокировка.Заблокировать();
		// Другой сеанс мог заполнить данные, пока ждали блокировку.
		Если Константы.ИИА_ВерсияПоставляемыхДанных.Получить() <> Версия Тогда
			ЗаполнитьПоставляемыеДанные();
			Константы.ИИА_ВерсияПоставляемыхДанных.Установить(Версия);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'ИИАссистент.ПоставляемыеДанные'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка, , , ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Заполняет поставляемые данные ассистента. Добавляет только отсутствующие записи (по наименованию или
// имени отчёта), существующие не меняет. Объекты метаданных, которых нет в конфигурации, пропускаются.
//
Процедура ЗаполнитьПоставляемыеДанные() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	// Прежнее подключение из констант переносится раньше поставляемых: перенос выполняется в пустой справочник.
	ИИА_LLM.ПеренестиПодключениеИзНастроек();
	ЗаполнитьПодключенияМоделей();
	ПеренестиПоляПодключений();
	ЗаполнитьПрофилиДоступа();
	ЗаполнитьКарточкиОтчетов();
	ЗаполнитьГлоссарий();
	// Список коммерческого маскирования по умолчанию - только в пустой регистр.
	ИИА_Маскирование.ЗаполнитьНастройкиПоУмолчанию();
	// После карточек: класс отчёта учитывает класс карточки.
	ИИА_КлассыДанных.СинхронизироватьАвтоматическуюКлассификацию();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПодключенияМоделей()

	Комментарий = НСтр("ru = 'Поставляемое подключение: укажите ключ API и модель, проверьте уровень доверия по договору с провайдером, затем включите «Используется».'");
	Поставляемые = Новый Массив;
	Поставляемые.Добавить(ОписаниеПодключения(НСтр("ru = 'Локальная модель (Ollama)'"), "http://localhost:11434/v1", "",
		"OpenAI", "Т1", Ложь, НСтр("ru = 'Модель в контуре компании: данные не покидают сеть. Укажите модель, загруженную в Ollama (например, qwen3).'")));
	Поставляемые.Добавить(ОписаниеПодключения("Anthropic Claude", "https://api.anthropic.com/v1", "claude-sonnet-5-5",
		"Anthropic", "Т3", Истина, Комментарий));
	Поставляемые.Добавить(ОписаниеПодключения("OpenAI", "https://api.openai.com/v1", "",
		"OpenAI", "Т3", Истина, Комментарий));
	Поставляемые.Добавить(ОписаниеПодключения("DeepSeek", "https://api.deepseek.com/v1", "deepseek-chat",
		"OpenAI", "Т3", Ложь, Комментарий));
	Поставляемые.Добавить(ОписаниеПодключения("Yandex AI Studio", "https://llm.api.cloud.yandex.net/v1", "",
		"OpenAI", "Т3", Ложь, НСтр("ru = 'OpenAI-совместимый API. Модель указывается с каталогом облака: gpt://<идентификатор каталога>/yandexgpt/latest.'")));
	Поставляемые.Добавить(ОписаниеПодключения("OpenRouter", "https://openrouter.ai/api/v1", "",
		"OpenAI", "Т3", Истина, Комментарий));
	Поставляемые.Добавить(ОписаниеПодключения("GigaChat", "https://gigachat.devices.sberbank.ru/api/v1", "GigaChat-2-Max",
		"GigaChat", "Т3", Ложь, НСтр("ru = 'Поставляемое подключение: в «Ключ API» укажите ключ авторизации (Authorization key) из личного кабинета, проверьте область доступа и уровень доверия по договору со Сбером, затем включите «Используется». Серверу 1С нужен корневой сертификат НУЦ Минцифры.'")));

	Порядок = МаксимальныйПорядокПодключений();
	Для Каждого Описание Из Поставляемые Цикл
		Если ЗначениеЗаполнено(Справочники.ИИА_ПодключенияМоделей.НайтиПоНаименованию(Описание.Наименование, Истина)) Тогда
			Продолжить;
		КонецЕсли;
		Порядок = Порядок + 10;
		Элемент = Справочники.ИИА_ПодключенияМоделей.СоздатьЭлемент();
		ЗаполнитьЗначенияСвойств(Элемент, Описание);
		Элемент.Протокол = Перечисления.ИИА_ПротоколыAPI[Описание.ИмяПротокола];
		Элемент.Доверие = Перечисления.ИИА_УровниДоверия[Описание.ИмяДоверия];
		Элемент.Провайдер = ИИА_LLM.ПровайдерПоАдресу(Элемент.АдресAPI, Элемент.Протокол);
		Элемент.ЗадатьТемпературу = ИИА_LLM.НастройкиПровайдера(Элемент.Провайдер).Температура;
		Элемент.Температура = ?(Элемент.ЗадатьТемпературу, 0.1, 0);
		Если Элемент.Провайдер = Перечисления.ИИА_ПровайдерыМоделей.GigaChat Тогда
			Элемент.ОбластьДоступа = "GIGACHAT_API_PERS";
		КонецЕсли;
		Элемент.Используется = Ложь;
		Элемент.Порядок = Порядок;
		Элемент.ТаймаутСекунд = 180;
		Элемент.Записать();
	КонецЦикла;

КонецПроцедуры

// Прежние подключения без провайдера: провайдер по адресу, известные поля строки параметров запроса - в реквизиты.
Процедура ПеренестиПоляПодключений()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	П.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИИА_ПодключенияМоделей КАК П
	|ГДЕ
	|	П.Провайдер = ЗНАЧЕНИЕ(Перечисление.ИИА_ПровайдерыМоделей.ПустаяСсылка)");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Выборка.Ссылка.ПолучитьОбъект();
		ИИА_LLM.ПеренестиПоляПодключения(Элемент);
		Элемент.Записать();
	КонецЦикла;

КонецПроцедуры

Функция ОписаниеПодключения(Наименование, АдресAPI, Модель, ИмяПротокола, ИмяДоверия, ПоддерживаетИзображения, Комментарий)

	Возврат Новый Структура("Наименование, АдресAPI, Модель, ИмяПротокола, ИмяДоверия, ПоддерживаетИзображения, Комментарий",
		Наименование, АдресAPI, Модель, ИмяПротокола, ИмяДоверия, ПоддерживаетИзображения, Комментарий);

КонецФункции

Функция МаксимальныйПорядокПодключений()

	Запрос = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(МАКСИМУМ(П.Порядок), 0) КАК Порядок ИЗ Справочник.ИИА_ПодключенияМоделей КАК П");
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Порядок;

КонецФункции

Процедура ЗаполнитьПрофилиДоступа()

	Для Каждого Описание Из ДанныеМакета("ИИА_ПоставляемыеПрофили") Цикл
		Наименование = СтрокаЗначения(Описание, "name");
		Если ПустаяСтрока(Наименование)
			Или ЗначениеЗаполнено(Справочники.ИИА_ПрофилиДоступа.НайтиПоНаименованию(Наименование, Истина)) Тогда
			Продолжить;
		КонецЕсли;
		Профиль = Справочники.ИИА_ПрофилиДоступа.СоздатьЭлемент();
		Профиль.Наименование = Наименование;
		Профиль.Описание = СтрокаЗначения(Описание, "description");
		Профиль.ПоУмолчаниюРазрешено = Описание.Получить("default_allowed") = Истина;
		Профиль.ИсходныйКод = Описание.Получить("source_code") = Истина;
		Приоритет = Описание.Получить("priority");
		Профиль.Приоритет = ?(ТипЗнч(Приоритет) = Тип("Число"), Приоритет, 50);
		Правила = Описание.Получить("rules");
		Если ТипЗнч(Правила) = Тип("Массив") Тогда
			Для Каждого Правило Из Правила Цикл
				ПолноеИмя = СтрокаЗначения(Правило, "full_name");
				Если Не ОбъектСуществует(ПолноеИмя) Тогда
					Продолжить;
				КонецЕсли;
				НоваяСтрока = Профиль.Правила.Добавить();
				НоваяСтрока.ПолноеИмя = ПолноеИмя;
				НоваяСтрока.Разрешено = Правило.Получить("allowed") = Истина;
			КонецЦикла;
		КонецЕсли;
		Профиль.Записать();
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьКарточкиОтчетов()

	Для Каждого Описание Из ДанныеМакета("ИИА_КарточкиОтчетов") Цикл
		ИмяОтчета = СтрокаЗначения(Описание, "report");
		ОбъектМетаданных = ?(ПустаяСтрока(ИмяОтчета), Неопределено, Метаданные.Отчеты.Найти(ИмяОтчета));
		Если ОбъектМетаданных = Неопределено
			Или ЗначениеЗаполнено(Справочники.ИИА_КарточкиОтчетов.НайтиПоРеквизиту("ИмяОтчета", ИмяОтчета)) Тогда
			Продолжить;
		КонецЕсли;
		Карточка = Справочники.ИИА_КарточкиОтчетов.СоздатьЭлемент();
		Карточка.Наименование = ?(ПустаяСтрока(СтрокаЗначения(Описание, "title")), ОбъектМетаданных.Представление(),
			СтрокаЗначения(Описание, "title"));
		Карточка.ИмяОтчета = ИмяОтчета;
		Карточка.Назначение = СтрокаЗначения(Описание, "when");
		Карточка.Раздел = СтрокаЗначения(Описание, "section");
		Класс = СтрокаЗначения(Описание, "class");
		Карточка.Класс = ?(Класс = "К2", Перечисления.ИИА_КлассыДанных.К2, Перечисления.ИИА_КлассыДанных.К1);
		Карточка.РежимДанных = Описание.Получить("data_mode") = Истина;
		Карточка.Используется = Истина;
		Карточка.Поставляемый = Истина;
		Карточка.Записать();
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьГлоссарий()

	Версия = Метаданные.Версия;
	Для Каждого Описание Из ДанныеМакета("ИИА_ПоставляемыйГлоссарий") Цикл
		Термин = СтрокаЗначения(Описание, "term");
		Если ПустаяСтрока(Термин)
			Или ЗначениеЗаполнено(Справочники.ИИА_Глоссарий.НайтиПоНаименованию(Термин, Истина)) Тогда
			Продолжить;
		КонецЕсли;
		Элемент = Справочники.ИИА_Глоссарий.СоздатьЭлемент();
		Элемент.Наименование = Термин;
		Элемент.Синонимы = СтрокаЗначения(Описание, "synonyms");
		Элемент.Описание = СтрокаЗначения(Описание, "description");
		Элемент.ВерсияКонфигурации = Версия;
		Объекты = Описание.Получить("objects");
		Если ТипЗнч(Объекты) = Тип("Массив") Тогда
			Для Каждого Объект Из Объекты Цикл
				ПолноеИмя = СтрокаЗначения(Объект, "full_name");
				Если Не ОбъектСуществует(ПолноеИмя) Тогда
					Продолжить;
				КонецЕсли;
				НоваяСтрока = Элемент.Объекты.Добавить();
				НоваяСтрока.ПолноеИмя = ПолноеИмя;
				НоваяСтрока.Пояснение = СтрокаЗначения(Объект, "note");
			КонецЦикла;
		КонецЕсли;
		Если Элемент.Объекты.Количество() > 0 Тогда
			Элемент.Записать();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Массив описаний из общего макета (текст JSON); пустой массив, если макет пуст или повреждён.
Функция ДанныеМакета(ИмяМакета)

	Попытка
		Данные = ОбщегоНазначения.JSONВЗначение(ПолучитьОбщийМакет(ИмяМакета).ПолучитьТекст());
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'ИИАссистент.ПоставляемыеДанные'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка, , , ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Новый Массив;
	КонецПопытки;
	Возврат ?(ТипЗнч(Данные) = Тип("Массив"), Данные, Новый Массив);

КонецФункции

Функция ОбъектСуществует(ПолноеИмя)

	Возврат Не ПустаяСтрока(ПолноеИмя) И Метаданные.НайтиПоПолномуИмени(ПолноеИмя) <> Неопределено;

КонецФункции

Функция СтрокаЗначения(Описание, Ключ)

	Значение = ?(ТипЗнч(Описание) = Тип("Соответствие"), Описание.Получить(Ключ), Неопределено);
	Возврат ?(ТипЗнч(Значение) = Тип("Строка"), СокрЛП(Значение), "");

КонецФункции

