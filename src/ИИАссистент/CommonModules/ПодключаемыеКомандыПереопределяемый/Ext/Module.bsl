#Область СлужебныеПроцедурыИФункции

// Свой вид подключаемых команд: подменю с одной командой БСП выводит отдельной кнопкой на панели формы.
&После("ПриОпределенииВидовПодключаемыхКоманд")
Процедура ИИА_ПриОпределенииВидовПодключаемыхКоманд(ВидыПодключаемыхКоманд)

	Вид = ВидыПодключаемыхКоманд.Добавить();
	Вид.Имя = "ИИАссистент";
	Вид.ИмяПодменю = "ПодменюИИАссистент";
	Вид.Заголовок = НСтр("ru = 'ИИ-ассистент'");
	Вид.Картинка = БиблиотекаКартинок.ИИА_Ассистент;
	Вид.Отображение = ОтображениеКнопки.КартинкаИТекст;
	Вид.Порядок = 1; // первым из подменю подключаемых команд: на переполненной панели не уходит в «Ещё»

КонецПроцедуры

// Команда «Спросить ИИ» в формах объектов и списков, которые разрешены периметром ассистента (план, раздел 3).
&После("ПриОпределенииКомандПодключенныхКОбъекту")
Процедура ИИА_ПриОпределенииКомандПодключенныхКОбъекту(НастройкиФормы, Источники, ПодключенныеОтчетыИОбработки, Команды)

	Если Не ИИА_ЧатВызовСервера.АссистентДоступенПользователю() Тогда
		Возврат;
	КонецЕсли;
	Типы = Новый Массив;
	ИИА_ДобавитьРазрешенныеТипы(Источники.Строки, Типы);
	Если Типы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Команда = Команды.Добавить();
	Команда.Вид = "ИИАссистент";
	Команда.Идентификатор = "ИИА_СпроситьАссистента";
	Команда.Представление = НСтр("ru = 'Спросить ИИ'");
	Команда.Важность = "Важное";
	Команда.Порядок = 1;
	Команда.ТипПараметра = Новый ОписаниеТипов(Типы);
	Команда.МножественныйВыбор = Ложь;
	Команда.РежимЗаписи = "ЗаписыватьТолькоНовые";
	Команда.Обработчик = "ИИА_ЧатКлиент.СпроситьОбОбъекте";

КонецПроцедуры

Процедура ИИА_ДобавитьРазрешенныеТипы(СтрокиИсточников, Типы)

	Для Каждого Источник Из СтрокиИсточников Цикл
		Если ЗначениеЗаполнено(Источник.ПолноеИмя) И Не ИИА_Периметр.ОбъектЗапрещен(Источник.ПолноеИмя)
			И Источник.ТипСсылкиДанных <> Неопределено Тогда
			ТипыИсточника = ?(ТипЗнч(Источник.ТипСсылкиДанных) = Тип("ОписаниеТипов"),
				Источник.ТипСсылкиДанных.Типы(), ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Источник.ТипСсылкиДанных));
			Для Каждого ТипИсточника Из ТипыИсточника Цикл
				Если ТипЗнч(ТипИсточника) = Тип("Тип") И Типы.Найти(ТипИсточника) = Неопределено Тогда
					Типы.Добавить(ТипИсточника);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ИИА_ДобавитьРазрешенныеТипы(Источник.Строки, Типы);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
