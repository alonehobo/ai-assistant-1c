#Область СлужебныеПроцедурыИФункции

// Поставляемые профили «ИИ-ассистент: пользователь / администратор / аудитор» (план, раздел 4.3).
// Профили дополнительные: назначаются вместе с основным профилем пользователя.
&После("ПриЗаполненииПоставляемыхПрофилейГруппДоступа")
Процедура ИИА_ПриЗаполненииПоставляемыхПрофилейГруппДоступа(ОписанияПрофилей, ПараметрыОбновления)

	ИИА_ДобавитьПрофиль(ОписанияПрофилей, "ИИА_Пользователь", "e9e7f7a7-6a0a-436f-bc2b-6e17c96fc23f",
		НСтр("ru = 'ИИ-ассистент: пользователь'", ОбщегоНазначения.КодОсновногоЯзыка()),
		НСтр("ru = 'Чат с ИИ-ассистентом в режиме только чтения. Персональные, кадровые и зарплатные данные ассистенту недоступны.'",
			ОбщегоНазначения.КодОсновногоЯзыка()),
		"ИИА_Пользователь");

	ИИА_ДобавитьПрофиль(ОписанияПрофилей, "ИИА_Администратор", "b858f58b-18d8-4be7-ba5b-c856d3145529",
		НСтр("ru = 'ИИ-ассистент: администратор'", ОбщегоНазначения.КодОсновногоЯзыка()),
		НСтр("ru = 'Настройка подключения к модели, лимитов и просмотр периметра данных. Не даёт чтения журнала вызовов.'",
			ОбщегоНазначения.КодОсновногоЯзыка()),
		"ИИА_Администратор,ИИА_Пользователь");

	ИИА_ДобавитьПрофиль(ОписанияПрофилей, "ИИА_Аудитор", "50090074-9f57-40a0-a910-27795f3ec96d",
		НСтр("ru = 'ИИ-ассистент: аудитор'", ОбщегоНазначения.КодОсновногоЯзыка()),
		НСтр("ru = 'Просмотр журнала вызовов, диалогов и версий политик ИИ-ассистента. Не даёт изменения настроек.'",
			ОбщегоНазначения.КодОсновногоЯзыка()),
		"ИИА_Аудитор");

	ИИА_ДобавитьПрофиль(ОписанияПрофилей, "ИИА_ИсходныйКод", "a351a362-8f72-4903-8e6a-9f1188330e60",
		НСтр("ru = 'ИИ-ассистент: исходный код'", ОбщегоНазначения.КодОсновногоЯзыка()),
		НСтр("ru = 'Вопросы ассистенту по исходному коду конфигурации (инструменты code_*). Для ИТ-ролей; дополнительно нужен флаг «Исходный код» в профиле доступа ассистента.'",
			ОбщегоНазначения.КодОсновногоЯзыка()),
		"ИИА_ИсходныйКод");

	ИИА_ДобавитьПрофиль(ОписанияПрофилей, "ИИА_ВнешнийДоступ", "9fdbe0da-875a-49c6-94c8-cac22b03d893",
		НСтр("ru = 'ИИ-ассистент: внешний доступ'", ОбщегоНазначения.КодОсновногоЯзыка()),
		НСтр("ru = 'Доступ к инструментам ассистента через HTTP-сервис по JWT (MCP, боты). Действуют те же права и политики, что в чате.'",
			ОбщегоНазначения.КодОсновногоЯзыка()),
		"ИИА_ВнешнийДоступ");

КонецПроцедуры

Процедура ИИА_ДобавитьПрофиль(ОписанияПрофилей, Имя, Идентификатор, Наименование, Описание, Роли)

	ОписаниеПрофиля = УправлениеДоступом.НовоеОписаниеПрофиляГруппДоступа();
	ОписаниеПрофиля.Имя = Имя;
	ОписаниеПрофиля.Идентификатор = Идентификатор;
	ОписаниеПрофиля.Наименование = Наименование;
	ОписаниеПрофиля.Описание = Описание;
	Для Каждого Роль Из СтрРазделить(Роли, ",", Ложь) Цикл
		ОписаниеПрофиля.Роли.Добавить(Роль);
	КонецЦикла;
	ОписаниеПрофиля.Назначение.Добавить(Тип("СправочникСсылка.Пользователи"));
	ОписанияПрофилей.Добавить(ОписаниеПрофиля);

КонецПроцедуры

#КонецОбласти
