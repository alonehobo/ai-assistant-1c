///////////////////////////////////////////////////////////////////////////////////////////////////////
// ИИ-ассистент: внешний доступ к инструментам (план, раздел 4.11, этап 4).
// Аутентификацию выполняет платформа по JWT (accessTokenAuthentication в default.vrd): сеанс работает
// от имени пользователя из токена, поэтому действуют его роли, RLS, профиль доступа и периметр.
// Логика - в ИИА_ВнешнийДоступ.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытий

Функция ИнструментыСписок(Запрос)

	Возврат ИИА_ВнешнийДоступ.ОбработатьЗапрос("tools", "", Запрос.ПолучитьТелоКакСтроку());

КонецФункции

Функция ИнструментВыполнить(Запрос)

	Возврат ИИА_ВнешнийДоступ.ОбработатьЗапрос("tool", Запрос.ПараметрыURL.Получить("name"), Запрос.ПолучитьТелоКакСтроку());

КонецФункции

Функция ВопросЗадать(Запрос)

	Возврат ИИА_ВнешнийДоступ.ОбработатьЗапрос("chat", "", Запрос.ПолучитьТелоКакСтроку());

КонецФункции

#КонецОбласти
