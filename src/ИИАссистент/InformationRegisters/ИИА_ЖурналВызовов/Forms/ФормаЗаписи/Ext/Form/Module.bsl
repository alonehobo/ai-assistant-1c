#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Журнал - след работы ассистента для разбора инцидентов: записи только просматриваются.
	ТолькоПросмотр = Истина;
	// В регистре время UTC (общее для всех часовых поясов); на форме - время сеанса пользователя.
	Если ЗначениеЗаполнено(Запись.МоментВызова) Тогда
		ВремяВызова = Запись.МоментВызова + Окр((ТекущаяДатаСеанса() - ТекущаяУниверсальнаяДата()) / 60) * 60;
	КонецЕсли;
	АргументыТекст = ЧитаемыйJSON(Запись.Аргументы);
	Заголовок = СтрШаблон(НСтр("ru = 'Журнал: %1 %2'"), Запись.Событие,
		?(ПустаяСтрока(Запись.Инструмент), "", "(" + Запись.Инструмент + ")"));
	Элементы.ФормаПерепискаДиалога.Доступность = ЗначениеЗаполнено(Запись.Диалог);
	Элементы.ФормаВесьХод.Доступность = Не ПустаяСтрока(Запись.ИдентификаторХода);
	Элементы.Аргументы.Видимость = Не ПустаяСтрока(АргументыТекст);
	Элементы.ГруппаХод.Видимость = ЗначениеЗаполнено(Запись.Диалог) Или Не ПустаяСтрока(Запись.ИдентификаторХода);
	Элементы.ГруппаМодель.Видимость = ЗначениеЗаполнено(Запись.Подключение) Или Запись.ТокеныВход > 0
		Или Запись.Длительность > 0;
	Если Запись.Инцидент Тогда
		Элементы.Итог.ЦветТекста = WebЦвета.Красный;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПерепискаДиалога(Команда)

	Если ЗначениеЗаполнено(Запись.Диалог) Тогда
		ПоказатьЗначение(, Запись.Диалог);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВесьХод(Команда)

	Если ПустаяСтрока(Запись.ИдентификаторХода) Тогда
		Возврат;
	КонецЕсли;
	ОткрытьФорму("РегистрСведений.ИИА_ЖурналВызовов.ФормаСписка",
		Новый Структура("Отбор", Новый Структура("ИдентификаторХода", Запись.ИдентификаторХода)), ЭтотОбъект,
		Запись.ИдентификаторХода);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// JSON с отступами для чтения; не JSON - как есть.
&НаСервереБезКонтекста
Функция ЧитаемыйJSON(Текст)

	Если ПустаяСтрока(Текст) Или Не (СтрНачинаетсяС(СокрЛ(Текст), "{") Или СтрНачинаетсяС(СокрЛ(Текст), "[")) Тогда
		Возврат Текст;
	КонецЕсли;
	Попытка
		Значение = ОбщегоНазначения.JSONВЗначение(Текст, , Истина);
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  ", , ЭкранированиеСимволовJSON.Нет));
		ЗаписатьJSON(ЗаписьJSON, Значение);
		Возврат ЗаписьJSON.Закрыть();
	Исключение
		Возврат Текст;
	КонецПопытки;

КонецФункции

#КонецОбласти
