#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// В регистре время UTC (общее для всех часовых поясов); в списке - время сеанса пользователя.
	СмещениеСекунд = Окр((ТекущаяДатаСеанса() - ТекущаяУниверсальнаяДата()) / 60) * 60;
	Список.Параметры.УстановитьЗначениеПараметра("СмещениеСекунд", СмещениеСекунд);
	// Журнал - след работы ассистента: записи не создаются и не правятся вручную.
	Элементы.Список.ТолькоПросмотр = Истина;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПерепискаДиалога(Команда)

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или Не ЗначениеЗаполнено(ТекущиеДанные.Диалог) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'У записи нет диалога.'"));
		Возврат;
	КонецЕсли;
	ПоказатьЗначение(, ТекущиеДанные.Диалог);

КонецПроцедуры

&НаКлиенте
Процедура ВесьХод(Команда)

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или ПустаяСтрока(ТекущиеДанные.ИдентификаторХода) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Запись не относится к ходу агента.'"));
		Возврат;
	КонецЕсли;
	ОткрытьФорму("РегистрСведений.ИИА_ЖурналВызовов.ФормаСписка",
		Новый Структура("Отбор", Новый Структура("ИдентификаторХода", ТекущиеДанные.ИдентификаторХода)), ЭтотОбъект,
		ТекущиеДанные.ИдентификаторХода);

КонецПроцедуры

#КонецОбласти
